				<SpriteAnimation sprite="WingSprite">
					<Frame>10,16</Frame>
				</SpriteAnimation>
				<DelayAnimation delayTime="100" />
			</SequenceAnimation>
			<SpriteAnimation name="ShardsAnimation" sprite="ShardsSprite" animTime="200">
				<Frame>8,21</Frame>
				<Frame>9,21</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="SmokeAnimation" sprite="SmokeSprite" animTime="800">
				<Frame>10,21</Frame>
				<Frame>11,21</Frame>
				<Frame>12,21</Frame>
				<Frame>13,21</Frame>
				<Frame>14,21</Frame>
				<Frame>15,21</Frame>
				<Frame>16,21</Frame>
				<Frame>17,21</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="multiColourAnim" sprite="ColorWingSprite" animTime="400" autoPlay="true" isLoop="true">
				<Frame>4,16</Frame>
				<Frame>5,16</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
