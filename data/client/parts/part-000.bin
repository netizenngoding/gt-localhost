		<SpriteAnimation name="luffy_Idle_Animation" playOnState="Motion.Idle" sprite="luffy_idle" animTime="1000" isLoop="true">
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>0,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Punch_Animation" playOnState="Motion.Punch" sprite="luffy_punch" animTime="500" isLoop="true">
				<Frame>4,3</Frame>
				<Frame>3,3</Frame>
				<Frame>2,3</Frame>
				<Frame>1,3</Frame>
				<Frame>0,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Jump_Animation" playOnState="Motion.Jump" sprite="luffy_idle" animTime="300">
				<Frame>1,2</Frame>
				<Frame>0,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Fall_Animation" playOnState="Motion.Fall" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>3,2</Frame>
				<Frame>2,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Walk_Animation" playOnState="Motion.Move" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>5,1</Frame>
				<Frame>4,1</Frame>
				<Frame>3,1</Frame>
				<Frame>2,1</Frame>
				<Frame>1,1</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
		<SpriteAnimation name="luffy_Respawn_Animation" sprite="luffy_respawn" animTime="1200" isLoop="false">
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
		</SpriteAnimation>
	</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="offset">8, -60</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<!-- <Set name="offset">0, -10</Set> -->
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.0</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 2,2</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_Right" updateStage="OnPunchStart" updateState="Facing.Right">
				<Emitter>
					<Set name="offset">60, -10010</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_left" updateStage="OnPunchStart" updateState="Facing.Left">
				<Emitter>
					<Set name="offset">60, -10010</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipY">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">8, -50</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">2.0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.1</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_respawn</Set>
					<Set name="offset">0,-70</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.1</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">20</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="luffy_idle" offset="0,-10084" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Dance" scale="1.4,1.4"/>
			<SpriteRender name="luffy_punch" offset="0,-10084" drawShadow="true" onState="Motion.Punch" scale="1.4,1.4"/>
			<SpriteRender name="luffy_sleep" offset="0,-10084" drawShadow="true" onState="Motion.Sleep" scale="1.4,1.4"/>
			<!-- <SpriteRender name="luffy_respawn" offset="0,-10160" drawShadow="true" onState="IsDying.True" scale="1.4,1.4"/>DOESNT WORK-STILLUNDERGROUND -->
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
	<!-- DM reeel. for animation like this :) -->
		<Sprite name="luffy_idle" fileName="game/UGCSpritesheet2v0.rttex" textureSize="128"/>
		<Sprite name="luffy_punch" fileName="game/UGCSpritesheet2v0.rttex" textureSize="128"/>

		<Sprite name="s_tileHit" fileName="game/UGCSpritesheet2v1.rttex" textureSize="128"/>
		<Sprite name="s_DestroyImpact" fileName="game/UGCSpritesheet2v1.rttex" textureSize="128" />
		<Sprite name="luffy_respawn" fileName="game/UGCSpritesheet2v1.rttex" textureSize="128"/>
		<Sprite name="luffy_sleep" fileName="game/UGCSpritesheet2v1.rttex" textureSize="128"/>

		<Sprite name="luffy_bubbles" fileName="game/UGCSpritesheet2v2.rttex" textureSize="128" frame="0,0"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Dance"/>
				<State name="Sleep"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|Sleep">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Sleep" from="Idle|Move|Fall|Jump|Punch|Dance">
					<Condition>
					<IsAction>SLEEP</IsAction>
					</Condition>
				</Transition>
				<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
					<Condition>
						<IsAction>DANCE</IsAction>
						<IsAction>DANCE_DAB</IsAction>
						<IsAction>DANCE_FLOSS</IsAction>
						<IsAction>DANCE_MARCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		<StateMachine name="IsDying">
			<States>
				<State name="False" />
				<State name="True" />
			</States>
			<Transitions>
				<Transition from="False" to="True">
					<Condition>
						<IsAction>DIE</IsAction>
					</Condition>
				</Transition>
				<Transition from="True" to="False">
					<Condition>
						<IsAction operatorType="NotEqual">DIE</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

		</StateMachines>
	<Animations>
		<SpriteAnimation name="luffy_sleep_animation" sprite="luffy_sleep" animTime="600" isLoop="true" playOnState="Motion.Sleep">
			<Frame>0,1</Frame>
			<Frame>1,1</Frame> 
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Dance_Animation" playOnState="Motion.Dance" sprite="luffy_idle" animTime="1000" isLoop="true">
			<Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
			<Frame>2,2</Frame>
			<Frame>5,2</Frame>
			<Frame>6,2</Frame>
			<Frame>7,2</Frame>
			<Frame>8,2</Frame>
			<Frame>9,2</Frame>
			<Frame>10,2</Frame>
			<Frame>11,2</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_DestroyImpact" sprite="s_DestroyImpact" animTime="1000">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
			<Frame>8,0</Frame>
			<Frame>9,0</Frame>
			<Frame>10,0</Frame>
			<Frame>11,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_hit_particle" sprite="s_tileHit" animTime="700" isLoop="false">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
			<Frame>8,0</Frame>
			<Frame>9,0</Frame>
			<Frame>10,0</Frame>
			<Frame>11,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Idle_Animation" playOnState="Motion.Idle" sprite="luffy_idle" animTime="1000" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Punch_Animation" playOnState="Motion.Punch" sprite="luffy_punch" animTime="500" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Jump_Animation" playOnState="Motion.Jump" sprite="luffy_idle" animTime="300">
				<Frame>8,0</Frame>
				<Frame>9,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Fall_Animation" playOnState="Motion.Fall" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Walk_Animation" playOnState="Motion.Move" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
		<SpriteAnimation name="luffy_Respawn_Animation" sprite="luffy_respawn" animTime="1200" isLoop="false">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
		</SpriteAnimation>
	</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="offset">8, -60</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<!-- <Set name="offset">0, -10</Set> -->
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.0</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 2,2</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_Right" updateStage="OnPunchStart" updateState="Facing.Right">
				<Emitter>
					<Set name="offset">8, -10085</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_left" updateStage="OnPunchStart" updateState="Facing.Left">
				<Emitter>
					<Set name="offset">8, -10085</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipY">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">8, -60</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.1</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_respawn</Set>
					<Set name="offset">0,-75</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.1</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">20</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="luffy_idle" offset="0,-10085" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Dance" scale="1.4,1.4"/>
			<SpriteRender name="luffy_punch" offset="0,-10085" drawShadow="true" onState="Motion.Punch" scale="1.4,1.4"/>
			<SpriteRender name="luffy_sleep" offset="0,-10095" drawShadow="true" onState="Motion.Sleep" scale="1.4,1.4"/>
			<!-- <SpriteRender name="luffy_respawn" offset="0,-10160" drawShadow="true" onState="IsDying.True" scale="1.4,1.4"/>DOESNT WORK-STILLUNDERGROUND -->
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
	<!-- 0idle -->
		<Sprite name="luffy_idle" fileName="game/UGCSpritesheet22v0.rttex" textureSize="128"/>
		<Sprite name="luffy_punch" fileName="game/UGCSpritesheet22v0.rttex" textureSize="128"/>
<!-- 1bubble -->
		<Sprite name="luffy_bubbles" fileName="game/UGCSpritesheet22v1.rttex" textureSize="64" frame="0,0"/>
		<!-- 2explode -->
		<Sprite name="s_tileHit" fileName="game/UGCSpritesheet22v2.rttex" textureSize="128"/>
		<Sprite name="s_DestroyImpact" fileName="game/UGCSpritesheet22v2.rttex" textureSize="128" />
		<!-- 3effect -->
		<Sprite name="luffy_respawn" fileName="game/UGCSpritesheet22v3.rttex" textureSize="128"/>
		<Sprite name="luffy_sleep" fileName="game/UGCSpritesheet22v3.rttex" textureSize="128"/>
		<Sprite name="luffy_dance" fileName="game/UGCSpritesheet22v3.rttex" textureSize="128"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Dance"/>
				<State name="Sleep"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|Sleep">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Sleep" from="Idle|Move|Fall|Jump|Punch|Dance">
					<Condition>
					<IsAction>SLEEP</IsAction>
					</Condition>
				</Transition>
				<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
					<Condition>
						<IsAction>DANCE</IsAction>
						<IsAction>DANCE_DAB</IsAction>
						<IsAction>DANCE_FLOSS</IsAction>
						<IsAction>DANCE_MARCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		<StateMachine name="IsDying">
			<States>
				<State name="False" />
				<State name="True" />
			</States>
			<Transitions>
				<Transition from="False" to="True">
					<Condition>
						<IsAction>DIE</IsAction>
					</Condition>
				</Transition>
				<Transition from="True" to="False">
					<Condition>
						<IsAction operatorType="NotEqual">DIE</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

		</StateMachines>
	<Animations>
		<SpriteAnimation name="luffy_sleep_animation" sprite="luffy_sleep" animTime="1000" isLoop="true" playOnState="Motion.Sleep">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
			<Frame>6,0</Frame>
			<Frame>5,0</Frame>
			<Frame>4,0</Frame>
			<Frame>3,0</Frame>
			<Frame>2,0</Frame>
			<Frame>1,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Dance_Animation" playOnState="Motion.Dance" sprite="luffy_dance" animTime="1000" isLoop="true">
			<Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
			<Frame>4,1</Frame>
			<Frame>5,1</Frame>
			<Frame>6,1</Frame>
			<Frame>7,1</Frame>
			<Frame>6,1</Frame>
			<Frame>5,1</Frame>
			<Frame>4,1</Frame>
			<Frame>3,1</Frame>
			<Frame>2,1</Frame>
			<Frame>1,1</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_DestroyImpact" sprite="s_DestroyImpact" animTime="1000">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_hit_particle" sprite="s_tileHit" animTime="700" isLoop="false">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Idle_Animation" playOnState="Motion.Idle" sprite="luffy_idle" animTime="1000" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>0,0</Frame>
				<Frame>2,0</Frame>
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Punch_Animation" playOnState="Motion.Punch" sprite="luffy_punch" animTime="500" isLoop="true">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>7,4</Frame>
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Jump_Animation" playOnState="Motion.Jump" sprite="luffy_idle" animTime="300">
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Fall_Animation" playOnState="Motion.Fall" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Walk_Animation" playOnState="Motion.Move" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
		<SpriteAnimation name="luffy_Respawn_Animation" sprite="luffy_respawn" animTime="1200" isLoop="false">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
		</SpriteAnimation>
	</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="offset">8, -60</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<!-- <Set name="offset">0, -10</Set> -->
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.0</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 2,2</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_Right" updateStage="OnPunchStart" updateState="Facing.Right">
				<Emitter>
					<Set name="offset">8, -10045</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Set name="frame">0,0</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_left" updateStage="OnPunchStart" updateState="Facing.Left">
				<Emitter>
					<Set name="offset">8, -10045</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipY">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">8, -60</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.1</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_respawn</Set>
					<Set name="offset">0,-60</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.1</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">20</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<!-- <IsVariableBool name="isMannequin">true</IsVariableBool> use this if you want to hide it from mannequin  -->
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="luffy_idle" offset="0,-10050" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall" scale="1.0,1.0"/>
			<SpriteRender name="luffy_dance" offset="0,-10050" drawShadow="true" onState="Motion.Dance" scale="1.0,1.0"/>
			<SpriteRender name="luffy_punch" offset="0,-10050" drawShadow="true" onState="Motion.Punch" scale="1.0,1.0"/>
			<SpriteRender name="luffy_sleep" offset="0,-10010" drawShadow="true" onState="Motion.Sleep" scale="1.0,1.0"/>
			<!-- <SpriteRender name="luffy_respawn" offset="0,-10160" drawShadow="true" onState="IsDying.True" scale="1.4,1.4"/>DOESNT WORK-STILLUNDERGROUND -->
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="luffy_idle" fileName="game/UGCSpritesheet23v0.rttex" textureSize="256"/>
		<Sprite name="luffy_punch" fileName="game/UGCSpritesheet23v0.rttex" textureSize="256"/>

		<Sprite name="luffy_bubbles" fileName="game/UGCSpritesheet23v0.rttex" textureSize="256" frame="0,6"/>
		
		<Sprite name="s_tileHit" fileName="game/UGCSpritesheet23v0.rttex" textureSize="256"/>
		<Sprite name="s_DestroyImpact" fileName="game/UGCSpritesheet23v0.rttex" textureSize="256" />
		<Sprite name="luffy_respawn" fileName="game/UGCSpritesheet23v1.rttex" textureSize="256"/>
		<Sprite name="luffy_sleep" fileName="game/UGCSpritesheet23v1.rttex" textureSize="256"/>
		<Sprite name="luffy_dance" fileName="game/UGCSpritesheet23v1.rttex" textureSize="256"/>
		<Sprite name="luffy_furious" fileName="game/UGCSpritesheet23v1.rttex" textureSize="256"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Dance"/>
				<State name="Sleep"/>
				<State name="Furious"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|Sleep">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Sleep" from="Idle|Move|Fall|Jump|Punch|Dance">
					<Condition>
					<IsAction>SLEEP</IsAction>
					</Condition>
				</Transition>
				<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
					<Condition>
						<IsAction>DANCE</IsAction>
						<IsAction>DANCE_DAB</IsAction>
						<IsAction>DANCE_FLOSS</IsAction>
						<IsAction>DANCE_MARCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Furious" from="Idle|Move|Jump|Fall|Punch|Sleep">
					<Condition>
						<IsAction>FURIOUS</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		<StateMachine name="IsDying">
			<States>
				<State name="False" />
				<State name="True" />
			</States>
			<Transitions>
				<Transition from="False" to="True">
					<Condition>
						<IsAction>DIE</IsAction>
					</Condition>
				</Transition>
				<Transition from="True" to="False">
					<Condition>
						<IsAction operatorType="NotEqual">DIE</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

		</StateMachines>
	<Animations>
		<SpriteAnimation name="luffy_sleep_animation" sprite="luffy_sleep" animTime="1000" isLoop="true" playOnState="Motion.Sleep">
			<Frame>0,3</Frame>
			<Frame>1,3</Frame>
			<Frame>2,3</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Dance_Animation" playOnState="Motion.Dance" sprite="luffy_dance" animTime="1000" isLoop="true">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
			<Frame>0,1</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Furious_Animation" playOnState="Motion.Furious" sprite="luffy_furious" animTime="1000" isLoop="true">
			<Frame>0,4</Frame>
			<Frame>1,4</Frame>
			<Frame>2,4</Frame>
			<Frame>3,4</Frame>
			<Frame>4,4</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_DestroyImpact" sprite="s_DestroyImpact" animTime="1000">
			<Frame>0,7</Frame>
			<Frame>1,7</Frame>
			<Frame>2,7</Frame>
			<Frame>3,7</Frame>
			<Frame>4,7</Frame>
			<Frame>5,7</Frame>
			<Frame>6,7</Frame>
			<Frame>7,7</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_hit_particle" sprite="s_tileHit" animTime="700" isLoop="false">
			<Frame>0,5</Frame>
			<Frame>1,5</Frame>
			<Frame>2,5</Frame>
			<Frame>3,5</Frame>
			<Frame>4,5</Frame>
			<Frame>5,5</Frame>
			<Frame>6,5</Frame>
			<Frame>7,5</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Idle_Animation" playOnState="Motion.Idle" sprite="luffy_idle" animTime="1000" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Punch_Animation" playOnState="Motion.Punch" sprite="luffy_punch" animTime="500" isLoop="true">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Jump_Animation" playOnState="Motion.Jump" sprite="luffy_idle" animTime="300">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Fall_Animation" playOnState="Motion.Fall" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Walk_Animation" playOnState="Motion.Move" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
		<SpriteAnimation name="luffy_Respawn_Animation" sprite="luffy_respawn" animTime="1200" isLoop="false">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
		</SpriteAnimation>
	</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="offset">8, -60</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<!-- <Set name="offset">0, -10</Set> -->
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.0</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 2,2</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_Right" updateStage="OnPunchStart" updateState="Facing.Right">
				<Emitter>
					<Set name="offset">8, -10045</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Set name="frame">0,0</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_left" updateStage="OnPunchStart" updateState="Facing.Left">
				<Emitter>
					<Set name="offset">8, -10045</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipY">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">8, -60</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.1</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_respawn</Set>
					<Set name="offset">0,-90</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.1</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">25</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<!-- <IsVariableBool name="isMannequin">true</IsVariableBool> use this if you want to hide it from mannequin  -->
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="luffy_idle" offset="0,-10120" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall" scale="1.0,1.0"/>
			<SpriteRender name="luffy_dance" offset="0,-10120" drawShadow="true" onState="Motion.Dance" scale="1.0,1.0"/>
			<SpriteRender name="luffy_punch" offset="0,-10120" drawShadow="true" onState="Motion.Punch" scale="1.0,1.0"/>
			<SpriteRender name="luffy_sleep" offset="0,-10090" drawShadow="true" onState="Motion.Sleep" scale="0.8,0.8"/>
			<SpriteRender name="luffy_furious" offset="0,-10120" drawShadow="true" onState="Motion.Furious" scale="1.0,1.0"/>
			<!-- <SpriteRender name="luffy_respawn" offset="0,-10160" drawShadow="true" onState="IsDying.True" scale="1.4,1.4"/>DOESNT WORK-STILLUNDERGROUND -->
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="playerState">
				<States>
					<State name="Idle" />
					<State name="Punch" />
					<State name="ZombiePunch" />
				</States>
				<Transitions>
					<Transition from="ZombiePunch|Punch" to="Idle">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="ZombiePunch|Idle" to="Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Idle|Punch" to="ZombiePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="Ucjue_0" fileName="game/UGCSpritesheet24v0.rttex" textureSize="64" frame="0,0" />
		<Sprite name="Ucjue_1" fileName="game/UGCSpritesheet24v0.rttex" textureSize="64"
			frame="1,0" />
		<Sprite name="Ucjue_2" fileName="game/UGCSpritesheet24v0.rttex" textureSize="64" frame="4,0" />

		<Sprite name="Ucjue_3" fileName="game/UGCSpritesheet24v1.rttex" textureSize="32" frame="3,0" />
		<Sprite name="Ucjue_4" fileName="game/UGCSpritesheet24v1.rttex" textureSize="32"
			frame="1,0" />
		<Sprite name="Ucjue_5" fileName="game/UGCSpritesheet24v1.rttex" textureSize="32" frame="4,0" />
		<Sprite name="Ucjue_6" fileName="game/UGCSpritesheet24v1.rttex" textureSize="32" />
		<Sprite name="Ucjue_7" fileName="game/UGCSpritesheet24v1.rttex" textureSize="32" />

		<Sprite name="Ucjue_8" fileName="game/particles.rttex" textureSize="32" frame="4,0" />
		<Sprite name="Ucjue_9" fileName="game/particles.rttex" textureSize="32" />

		<Animations>
			<SpriteAnimation name="sword_idle_anim" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch" useFacing="RIGHT"
				sprite="Ucjue_1" animTime="600">
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_idle_anim_left" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch" useFacing="LEFT"
				sprite="Ucjue_1" animTime="600">
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="Ucjue_2_idle_anim" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch|playerState.Punch"
				useFacing="RIGHT" sprite="Ucjue_2" animTime="600">
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="Ucjue_2_idle_anim_left" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch|playerState.Punch"
				useFacing="LEFT" sprite="Ucjue_2" animTime="600">
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_idle" autoPlay="false" sprite="Ucjue_1"
				playOnState="playerState.Idle" animTime="50">
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_slash_frame" animTime="400" sprite="Ucjue_4">
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="auraAnimation" isLoop="true" autoPlay="false"
				sprite="Ucjue_6" animTime="400">
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="deathAnimation" sprite="Ucjue_7" animTime="450"
				isLoop="true" playOnAction="DIE">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="slash_particle">
				<Emitter>
					<Random name="offset" min="10, -18" max="11, -21" />
					<Set name="emissionInterval">2</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">Ucjue_4</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialScale">1.5,1.5</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8"
						angle="0" />
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="0.8"
						angle="0" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="TileHitFire">
				<Emitter>
					<Random name="emissionInterval" min="0.05" max="0.1" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">false</Set>
					<Set name="lifeTime">3</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">Ucjue_5</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="initialVelocity">0,-32</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.4" max="1.2" />
					<Random name="offset" min="-8, -7" max="8, 7" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hitSpark_particle" updateStage="OnDestroyedTile"
				secondary="trail_particle">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">Ucjue_9</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">2,2</Set>
					<Random name="finalScale" min="0.1, 0.1" max="0.4, 0.4" />
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200" />
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300" />
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">80</Set>
					<Set name="emissionInterval">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">Ucjue_8</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="initialRotationRate">150</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 0</KeyFrame>
						<KeyFrame>0.4, 1, 1</KeyFrame>
						<KeyFrame>0.8, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.4</KeyFrame>
						<KeyFrame>0.8, 0.3</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialVelocity">0,0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="auraParticle">
				<Emitter>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.1</Set>
					<Set name="intervalMax">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">Ucjue_6</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.4, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.6" max="0.8" />
					<Random name="initialVelocity" min="-10,-60" max="10,-70" />
					<Random name="offset" min="-18,0" max="18,0" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.5</Set>
					<Set name="emissionInterval">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">6</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">Ucjue_7</Set>
					<Random name="offset" min="-30, -31" max="30, 31" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 2, 2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
					<Random name="initialVelocity" min="-25, -75" max="25, 20" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">600</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">600</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
		</Update>

		<RenderHandItem>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="Ucjue_0" offset="18,4" blend="PREMULTIPLIED_ALPHA"
				rotateOffset="true" onState="playerState.Punch" />
		</RenderHandItem>

		<RenderFrontArm>
			<SpriteRender name="Ucjue_3" alignment="DOWN_CENTER" useFixedRotation="true"
				fixedRotation="0" />
		</RenderFrontArm>

		<OnPunchUpdate>
			<AvatarTransform class="Emotion">
				<Set name="emotion">ANGRY</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderBackArm value="playerCenter">
			<StopIf type="or">
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<SpriteRender name="Ucjue_1" offset="0.5, -30.5"
				onState="playerState.Idle|playerState.ZombiePunch" useFixedRotation="true"
				fixedRotation="0" />
			<SpriteRender name="Ucjue_2" offset="0.5, -30.5"
				onAction="JUMP|JUMPSTART|FALL|IDLE|WALK|PUNCH|SWIM" useFixedRotation="true"
				fixedRotation="0" />
		</RenderBackArm>

		<OnPunchStart>
			<ParticleSystemUpdate name="slash_particle" />
		</OnPunchStart>

		<AddClothingParticles>
			<ParticleSystemUpdate name="auraParticle" />
		</AddClothingParticles>

		<RenderInFront>
			<ParticleSystemRender name="auraParticle" />
		</RenderInFront>

		<OnDamagedTile>
			<ParticleSystemUpdate name="TileHitFire" />
		</OnDamagedTile>

		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="slash_particle" />
			<ParticleSystemOff name="TileHitFire" />
			<ParticleSystemOff name="auraParticle" />
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
<!-- dm reeel. for items like this :) -->
  <Data>
    <Sprite name="iniWingnya" fileName="game/UGCSpritesheet25v0.rttex" textureSize="96,96"/>
    <Sprite name="iniParticlenya" fileName="game/UGCSpritesheet25v1.rttex" textureSize="128" frame="0,0"/>
    <Sprite name="iniTrail" fileName="game/UGCSpritesheet25v2.rttex" textureSize="64" frame="0,0"/>

    <Animations>
      <SpriteAnimation name="Jump" playOnAction="JUMP|JUMPDOUBLE" sprite="iniWingnya" animTime="200" autoPlay="true" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Fall" playOnAction="FALL" sprite="iniWingnya" animTime="200" autoPlay="true" isLoop="true">
        <Frame>3,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="iniWingnya" tintOverride="0,127,236,255">
        <Frame>0,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="iniParticlenya_jump">
        <Emitter>
          <Random name="offset" min="0, 40" max="0, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">1.1, 1.1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_left">
        <Emitter>
          <Random name="offset" min="40, 40" max="32, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_right">
        <Emitter>
          <Random name="offset" min="-32, 40" max="-40, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">iniTrail</Set> 
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">iniTrail</Set> 
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <!-- <Set name="HideAvatarOnDeath">true</Set>
        <Set name="HideAngelOnDeath">true</Set> -->
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>

    <RenderBackpack>
      <SpriteRender name="iniWingnya" offset="6,-35" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="iniWingnya" offset="-6,-35" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
    </RenderBackpack>
    
    <RenderInFront>
      <ParticleSystemRender name="ps_trail"/>
      <ParticleSystemRender name="ps_trail1 "/>
    </RenderInFront>

    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_trail" onAction="WALK" drawShadow="false"/>
      <ParticleSystemUpdate name="ps_trail1" onAction="WALK" drawShadow="false"/>
      <!-- donotremoveS -->
      <ParticleSystemUpdate name="iniParticlenya_jump" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_left" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_right" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_trail" />
      <ParticleSystemOff name="ps_trail1" />
      <ParticleSystemOff name="iniParticlenya_jump" />
      <ParticleSystemOff name="bloody_jump_left" />
      <ParticleSystemOff name="bloody_jump_right" />
    </SwitchOffClothingParticles>
  
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="item_Sprite_1" fileName="game/UGCSpritesheet26v0.rttex" textureSize="64" frame="0,0" />
    <Sprite name="double_jump_particle_Sprite_left" fileName="game/UGCSpritesheet26v1.rttex" textureSize="32"
      frame="0,0" />
    <Sprite name="double_jump_particle_Sprite_right" fileName="game/UGCSpritesheet26v1.rttex" textureSize="32"
      frame="1,0" />
    <Sprite name="dj_up" fileName="game/UGCSpritesheet26v1.rttex" textureSize="32"
      frame="2,0" />


    <Animations>
      <SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="item_Sprite_1">
        <Frame>0,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="be_idle3" playOnAction="FALL" sprite="item_Sprite_1">
        <Frame>3,0</Frame>
      </SpriteAnimation>      
      <SpriteAnimation name="wingFlexJump2" playOnAction="JUMP|JUMPEND" sprite="item_Sprite_1"
        animTime="250" autoPlay="true" isLoop="true">
        <Frame>3,0</Frame>
        <Frame>2,0</Frame>
        <Frame>1,0</Frame>
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>

      <SpriteAnimation name="dj_up"
				playOnState="playerState.DoubleJump" autoPlay="false" isLoop="false"
				sprite="dj_up" animTime="100">
				<Frame>2,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="double_jump_particle_Sprite_left"
				playOnState="playerState.DoubleJump" autoPlay="false" isLoop="false"
				sprite="double_jump_particle_Sprite_left" animTime="100">
				<Frame>1,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="double_jump_particle_Sprite_right"
				playOnState="playerState.DoubleJump" autoPlay="false" isLoop="false"
				sprite="double_jump_particle_Sprite_right" animTime="100">
				<Frame>0,0</Frame>
			</SpriteAnimation>
    </Animations>

    <ParticleSystems>

			
			<ParticleSystem name="dj_up_up">
				<Emitter>
					<Random name="offset" min="0, -5" max="0, -5"/>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">dj_up</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">0.9, 0.9</Set>
					<Set name="finalScale">0.9, 0.9</Set>
				</Particle>
			</ParticleSystem>


			<ParticleSystem name="double_jump_particle_left">
				<Emitter>
					<Random name="offset" min="20, 0" max="16, 0"/>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">double_jump_particle_Sprite_left</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1.5, 1.5</Set>
					<Set name="finalScale">2.3, 2.3</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="double_jump_particle_right">
				<Emitter>
					<Random name="offset" min="-16, 0" max="-20, 0"/>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">double_jump_particle_Sprite_right</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1.5, 1.5</Set>
					<Set name="finalScale">2.3, 2.3</Set>
				</Particle>
			</ParticleSystem>

		</ParticleSystems>
  </Data>
  <RenderRules>
    <RenderBackpack>
    <SpriteRender name="item_Sprite_1" offset="-6,-21" alignmentLeft="LEFT_CENTER"
        alignmentRight="RIGHT_CENTER" />
      <SpriteRender name="item_Sprite_1" offset="6,-21" flip="1,0" alignmentLeft="RIGHT_CENTER"
        alignmentRight="LEFT_CENTER" />
    </RenderBackpack>
    
		<AddClothingParticles>				
			<ParticleSystemUpdate name="dj_up_up" onAction="JUMPDOUBLE"
			drawShadow="false" align="RIGHT_CENTER"/>
			<ParticleSystemUpdate name="double_jump_particle_left" onAction="JUMPDOUBLE"
				drawShadow="false" align="LEFT_CENTER" />
			<ParticleSystemUpdate name="double_jump_particle_right" onAction="JUMPDOUBLE"
				drawShadow="false" align="RIGHT_CENTER" />
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="dj_up_up" />
			<ParticleSystemOff name="double_jump_particle_left" />
			<ParticleSystemOff name="double_jump_particle_right" />
		</SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="azure_blue" fileName="game/UGCSpritesheet27v0.rttex" textureSize="256"/>
		<Sprite name="azure_blue_effect" fileName="game/UGCSpritesheet27v2.rttex" textureSize="512"/>
		<Sprite name="azure_blue_projectile" fileName="game/UGCSpritesheet27v0.rttex" textureSize="256"/>
		<Sprite name="azure_blue_destroy_impact" fileName="game/UGCSpritesheet27v1.rttex" textureSize="256"/>
		<Sprite name="azure_blue_break_flame" fileName="game/UGCSpritesheet27v1.rttex" textureSize="256"/>
		<Animations>
			<SpriteAnimation name="azure_blue_projectile_animation" sprite="azure_blue_projectile" animTime="700" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="azure_blue_punch_effect_animation" sprite="azure_blue_effect" animTime="400" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="azure_blue_break_flame_animation" sprite="azure_blue_break_flame" animTime="300" >
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>8,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="azure_blue_destroy_impact_animation" sprite="azure_blue_destroy_impact" animTime="400" >
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>8,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="azure_blue_animation" sprite="azure_blue" animTime="1000" isLoop="true" autoPlay="true" >
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<InterpolationVec4Animation name="azure_blue_rotation_animation" variableName="azure_blue_rotation" targetValue="90, 0, 0, 1" animTime="2000" playOnState="Punch.False"/>
		</Animations>
			<ParticleSystems>
				<ParticleSystem name="azure_blue_break_flame_particle" updateStage="OnDamagedTile">
					<Emitter>
						<Set name="particlesPerEmission">1</Set>
						<Set name="offset">0,0</Set>
						<Set name="emissionInterval">0.5</Set>
						<Set name="infParticles">true</Set>
						<Set name="particlesPerEmission">1</Set>
					</Emitter>
					<Particle>
						<Set name="sprite">azure_blue_break_flame</Set>
						<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
						<Curve name="initialScale">
							<KeyFrame>0, 1.5,1.5</KeyFrame>
							<KeyFrame>1, 1.5,1.5</KeyFrame>
						</Curve>
						<Curve name="initialAlpha">
							<KeyFrame>0, 1</KeyFrame>
							<KeyFrame>0.65, 1</KeyFrame>
							<KeyFrame>1, 0</KeyFrame>
						</Curve>
						<Set name="lifeTime">0.3</Set>
						<Random name="initialAngle" min="0" max="0" />
					</Particle>
				</ParticleSystem>
				<ParticleSystem name="azure_blue_destroy_impact_particle">
					<Emitter>
						<Set name="particlesPerEmission">1</Set>
					</Emitter>
					<Particle>
						<Set name="sprite">azure_blue_destroy_impact</Set>
						<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
						<Set name="lifeTime">0.3</Set>
						<Random name="initialAngle" min="0" max="0" />
						<Curve name="initialScale">
							<KeyFrame>0, 3,3</KeyFrame>
							<KeyFrame>1, 3,3</KeyFrame>
						</Curve>
					</Particle>
				</ParticleSystem>
				<ParticleSystem name="azure_blue_projectile_right" updateStage="OnPunchStart" updateState="Facing.Right">
					<Emitter>
						<Set name="offset">5, -18</Set>
						<Set name="particlesPerEmission">1</Set>
					</Emitter>
					<Particle>
						<Set name="sprite">azure_blue_projectile</Set>
						<Select name="offset" input="punchCount">
							<Item>-8, 0</Item>
							<Item>8, 0</Item>
						</Select>
						<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
						<Set name="rotateWithVelocity">true</Set>
						<Curve name="initialAlpha">
							<KeyFrame>0, 1</KeyFrame>
							<KeyFrame>1, 1</KeyFrame>
						</Curve>
						<Curve name="initialScale">
							<KeyFrame>0, 2, 2</KeyFrame>
							<KeyFrame>1, 2, 2</KeyFrame>
						</Curve>
						<Set name="lifeTime">0.3</Set>
						<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
						<OnFinish>
							<ParticleSystemName>azure_blue_destroy_impact_particle</ParticleSystemName>
						</OnFinish>
					</Particle>
				</ParticleSystem>
				<ParticleSystem name="azure_blue_projectile_left" updateStage="OnPunchStart" updateState="Facing.Left">
					<Emitter>
						<Set name="offset">5, -18</Set>
						<Set name="particlesPerEmission">1</Set>
					</Emitter>
					<Particle>
						<Set name="sprite">azure_blue_projectile</Set>
						<Select name="offset" input="punchCount">
							<Item>-8, 0</Item>
							<Item>8, 0</Item>
						</Select>
						<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
						<Set name="flipY">true</Set>
						<Set name="rotateWithVelocity">true</Set>
						<Curve name="initialAlpha">
							<KeyFrame>0, 1</KeyFrame>
							<KeyFrame>1, 1</KeyFrame>
						</Curve>
						<Curve name="initialScale">
							<KeyFrame>0, 2, 2</KeyFrame>
							<KeyFrame>0, 2, 2</KeyFrame>
						</Curve>
						<Set name="lifeTime">0.3</Set>
						<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
						<OnFinish>
							<ParticleSystemName>azure_blue_destroy_impact_particle</ParticleSystemName>
						</OnFinish>
					</Particle>
				</ParticleSystem>
			</ParticleSystems>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="azure_blue_rotation">0, 0, 0, 1</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
                <Set name="ShouldHover">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="UserNameOffset">5</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="DefaultPunchSound">audio/droar.wav</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">29,19</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
	</Data>
	<RenderRules>
		<Update>
		</Update>
		<RenderInFront>
			<SpriteRender name="azure_blue_effect" offset="0,0" alignment="CENTER" rotateOffset="true" rotateToTarget="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="1.5,1.5" onAction="PUNCH" />
		</RenderInFront>
		<RenderBehind>
			<StopIf >
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<Group>
				<Rotate>azure_blue_rotation</Rotate>
				<SpriteRender name="azure_blue" offset="-35,-45" alignment="CENTER" rotateOffset="false" blend="PREMULTIPLIED_ALPHA" scale="1,1" />
			</Group>
		</RenderBehind>
		<RenderBackHandItem>
				<SpriteRender name="azure_blue" offset="33,3" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="1,1" onAction="PUNCH" />
		</RenderBackHandItem>
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="azure_blue_destroy_impact_particle" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="nami_sprite" fileName="game/UGCSpritesheet28v0.rttex" textureSize="256"/>
		<Sprite name="nami_dance" fileName="game/UGCSpritesheet28v0.rttex" textureSize="256"/>
		<Sprite name="nami_respawn" fileName="game/UGCSpritesheet28v0.rttex" textureSize="256"/>
		<Sprite name="nami_sleep" fileName="game/UGCSpritesheet28v1.rttex" textureSize="256"/>
		<Sprite name="nami_bubble" fileName="game/UGCSpritesheet28v1.rttex" textureSize="256"/>
		<Sprite name="nami_destroy_impact" fileName="game/UGCSpritesheet28v1.rttex" textureSize="256"/>
		<Sprite name="nami_tile_hit" fileName="game/UGCSpritesheet28v1.rttex" textureSize="256"/>
		<Sprite name="nami_explosion" fileName="game/UGCSpritesheet28v2.rttex" textureSize="128"/>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Jump"/>
					<State name="Fall"/>
					<State name="Punch"/>
					<State name="Sleep"/>
					<State name="Dance"/>
					<State name="DanceLoop"/>
					<State name="Respawn"/>
					<State name="PostRespawn"/>
				</States>

				<Transitions>
					<Transition to="Respawn" from="Idle|Move|Jump|Fall|Punch|Sleep|Dance|DanceLoop">
						<Condition><IsAction>DIE</IsAction></Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall|Sleep|Dance|DanceLoop">
						<Condition><IsAction>PUNCH</IsAction></Condition>
					</Transition>
					<Transition to="Sleep" from="Idle|Move|Jump|Fall|Punch|Dance|DanceLoop">
						<Condition><IsAction>SLEEP</IsAction></Condition>
					</Transition>
					<Transition to="Dance" from="Idle|Move|Jump|Fall|Punch|Sleep">
						<Condition type="or">
							<IsAction>DANCE</IsAction>
							<IsAction>DANCE_DAB</IsAction>
							<IsAction>DANCE_FLOSS</IsAction>
							<IsAction>DANCE_MARCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="DanceLoop" from="Dance">
						<Condition><IsAnimationFinished>nami_Dance_Animation</IsAnimationFinished></Condition>
					</Transition>
					<Transition to="Idle" from="Dance|DanceLoop">
						<Condition type="and">
							<IsAction operatorType="NotEqual">DANCE</IsAction>
							<IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
							<IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch|Sleep|Dance|DanceLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Idle|Move|Jump|Punch|Sleep|Dance|DanceLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|Jump|Fall|Punch|Sleep|Dance|DanceLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Idle" from="Move|Jump|Fall|Punch|Sleep">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="PostRespawn" from="Respawn">
						<Condition><IsAnimationFinished>nami_Respawn_Animation</IsAnimationFinished></Condition>
					</Transition>
					<Transition to="Idle" from="PostRespawn">
						<Condition><IsAnimationFinished>nami_PostRespawn_Animation</IsAnimationFinished></Condition>
					</Transition>
				</Transitions>
			</StateMachine>

			<StateMachine name="Facing">
				<States><State name="Right"/><State name="Left"/></States>
				<Transitions>
					<Transition to="Left" from="Right"><Condition><IsFacingLeft>true</IsFacingLeft></Condition></Transition>
					<Transition to="Right" from="Left"><Condition><IsFacingLeft>false</IsFacingLeft></Condition></Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Animations>
			<SpriteAnimation name="nami_Idle_Animation" playOnState="Motion.Idle" sprite="nami_sprite" animTime="800" isLoop="true">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame><Frame>2,0</Frame><Frame>1,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_Move_Animation" playOnState="Motion.Move" sprite="nami_sprite" animTime="480" isLoop="true">
				<Frame>5,0</Frame><Frame>6,0</Frame><Frame>7,0</Frame>
				<Frame>0,1</Frame><Frame>1,1</Frame><Frame>2,1</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_Jump_Animation" playOnState="Motion.Jump" sprite="nami_sprite" animTime="600" isLoop="true">
				<Frame>0,3</Frame><Frame>1,3</Frame><Frame>2,3</Frame><Frame>3,3</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_Fall_Animation" playOnState="Motion.Fall" sprite="nami_sprite" animTime="360" isLoop="false">
				<Frame>4,3</Frame><Frame>5,3</Frame><Frame>6,3</Frame><Frame>7,3</Frame><Frame>0,4</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_Punch_Animation" playOnState="Motion.Punch" sprite="nami_sprite" animTime="400" isLoop="true">
				<Frame>0,2</Frame><Frame>1,2</Frame><Frame>2,2</Frame><Frame>3,2</Frame><Frame>4,2</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_Dance_Animation" playOnState="Motion.Dance" sprite="nami_dance" animTime="800" isLoop="false">
				<Frame>3,4</Frame><Frame>4,4</Frame><Frame>5,4</Frame><Frame>6,4</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_DanceLoop_Animation" playOnState="Motion.DanceLoop" sprite="nami_dance" animTime="400" isLoop="true">
				<Frame>5,4</Frame><Frame>6,4</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_Sleep_Animation" playOnState="Motion.Sleep" sprite="nami_sleep" animTime="1000" isLoop="false">
				<Frame>2,4</Frame><Frame>3,4</Frame><Frame>4,4</Frame><Frame>1,4</Frame><Frame>0,4</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_Respawn_Animation" playOnState="Motion.Respawn" sprite="nami_respawn" animTime="2000" isLoop="false">
				<Frame>4,1</Frame><Frame>5,1</Frame><Frame>6,1</Frame>
				<Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame>
				<Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_PostRespawn_Animation" playOnState="Motion.PostRespawn" sprite="nami_respawn" animTime="3000" isLoop="false">
				<Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame><Frame>7,1</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_Bubble_Animation" sprite="nami_bubble" animTime="300" isLoop="true">
				<Frame>0,3</Frame><Frame>1,3</Frame><Frame>2,3</Frame><Frame>3,3</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_DestroyImpact_Animation" sprite="nami_destroy_impact" animTime="400" isLoop="false">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_Explosion_Animation" sprite="nami_explosion" animTime="400" isLoop="false">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame><Frame>4,0</Frame><Frame>5,0</Frame>
				<Frame>6,0</Frame><Frame>7,0</Frame><Frame>8,0</Frame><Frame>9,0</Frame><Frame>10,0</Frame><Frame>11,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nami_TileHit_Animation" sprite="nami_tile_hit" animTime="400" isLoop="false">
				<Frame>4,0</Frame><Frame>5,0</Frame><Frame>6,0</Frame><Frame>7,0</Frame>
				<Frame>0,1</Frame><Frame>1,1</Frame><Frame>2,1</Frame><Frame>3,1</Frame><Frame>4,1</Frame><Frame>5,1</Frame><Frame>6,1</Frame><Frame>7,1</Frame>
				<Frame>0,2</Frame><Frame>1,2</Frame><Frame>2,2</Frame><Frame>3,2</Frame><Frame>4,2</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="ps_NamiBubble" updateStage="OnPunchStart" updateState="Motion.Punch">
				<Emitter>
					<Set name="offset">45,-10055</Set><Set name="offsetFacing">true</Set>
					<Set name="particlesPerEmission">1</Set><Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">nami_bubble</Set><Set name="rotateWithVelocity">true</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="initialScale">1.6,1.6</Set><Set name="finalScale">1.6,1.6</Set><Set name="interpolateScale">true</Set>
					<Curve name="initialAlpha"><KeyFrame>0,1</KeyFrame><KeyFrame>1,1</KeyFrame></Curve>
					<Set name="lifeTime">0.45</Set><VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<OnFinish><ParticleSystemName>ps_NamiExplosion</ParticleSystemName></OnFinish>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_NamiExplosion">
				<Emitter><Set name="offset">0,0</Set><Set name="particlesPerEmission">1</Set><Set name="particlesToEmit">1</Set></Emitter>
				<Particle>
					<Set name="sprite">nami_destroy_impact</Set><Set name="renderAlignment">CENTER</Set>
					<Curve name="initialScale"><KeyFrame>0,1.6,1.6</KeyFrame><KeyFrame>1,1.6,1.6</KeyFrame></Curve>
					<Curve name="initialAlpha"><KeyFrame>0,1</KeyFrame><KeyFrame>0.65,1</KeyFrame><KeyFrame>1,0</KeyFrame></Curve>
					<Set name="lifeTime">0.35</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_NamiTileHit" updateStage="OnDamagedTile" updateState="Motion.Punch">
				<Emitter><Set name="offset">0,0</Set><Set name="particlesPerEmission">1</Set><Set name="particlesToEmit">1</Set></Emitter>
				<Particle>
					<Set name="sprite">nami_tile_hit</Set><Set name="renderAlignment">CENTER</Set>
					<Curve name="initialScale"><KeyFrame>0,3.2,3.2</KeyFrame><KeyFrame>1,3.2,3.2</KeyFrame></Curve>
					<Curve name="initialAlpha"><KeyFrame>0,1</KeyFrame><KeyFrame>0.7,1</KeyFrame><KeyFrame>1,0</KeyFrame></Curve>
					<Set name="lifeTime">0.35</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_NamiDestroyBurst">
				<Emitter><Set name="offset">0,0</Set><Set name="particlesPerEmission">1</Set><Set name="particlesToEmit">1</Set></Emitter>
				<Particle>
					<Set name="sprite">nami_explosion</Set><Set name="renderAlignment">CENTER</Set>
					<Curve name="initialScale"><KeyFrame>0,3.2,3.2</KeyFrame><KeyFrame>0.45,3.2,3.2</KeyFrame><KeyFrame>1,3.2,3.2</KeyFrame></Curve>
					<Curve name="initialAlpha"><KeyFrame>0,1</KeyFrame><KeyFrame>0.75,1</KeyFrame><KeyFrame>1,0</KeyFrame></Curve>
					<Set name="lifeTime">0.65</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">2</Set><Set name="emissionInterval">0</Set><Set name="infParticles">false</Set><Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">nami_respawn</Set><Set name="offset">0,-85</Set><Set name="renderAlignment">CENTER</Set><Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha"><KeyFrame>0,1</KeyFrame><KeyFrame>1,1</KeyFrame></Curve>
					<Curve name="initialScale"><KeyFrame>0,0.8,0.8</KeyFrame><KeyFrame>1,0.8,0.8</KeyFrame></Curve>
					<Set name="lifeTime">2</Set>
				</Particle>
			</ParticleSystem>

		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">SHOES</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">75</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
                <Set name="DefaultPunchSound">audio/lightning.wav</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance|Motion.DanceLoop|Motion.Sleep|Motion.Respawn|Motion.PostRespawn">
				<Set name="foot1dy">0</Set><Set name="foot2dy">0</Set><Set name="foot1y">0</Set><Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance|Motion.DanceLoop">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf><IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod></StopIf>
			<SpriteRender name="nami_sprite" offset="0,-10095" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch" scale="0.8,0.8"/>
			<SpriteRender name="nami_dance" offset="0,-10095" drawShadow="true" onState="Motion.Dance|Motion.DanceLoop" scale="0.8,0.8"/>
			<SpriteRender name="nami_sleep" offset="0,-10090" drawShadow="true" onState="Motion.Sleep" scale="0.8,0.8"/>
			<SpriteRender name="nami_respawn" offset="0,-10095" drawShadow="true" onState="Motion.Respawn|Motion.PostRespawn" scale="0.8,0.8"/>
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_NamiDestroyBurst"/>
		</OnDestroyedTile>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle"/>
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="md_sprite" fileName="game/UGCSpritesheet3v0.rttex" textureSize="64,96"/>
        <Sprite name="md_eff" fileName="game/UGCSpritesheet3v1.rttex" textureSize="64"/>
        <Sprite name="md_eff2" fileName="game/UGCSpritesheet3v1.rttex" textureSize="64" frame="7,4"/>
        <Sprite name="md_eff3" fileName="game/UGCSpritesheet3v1.rttex" textureSize="32"/>
		<Sprite name="md_punch" fileName="game/UGCSpritesheet3v2.rttex" textureSize="32"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="ge_eff" sprite="md_eff" animTime="9250" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
            <Frame>2,0</Frame>
            <Frame>3,0</Frame>
            <Frame>4,0</Frame>
            <Frame>5,0</Frame>
            <Frame>6,0</Frame>
            <Frame>7,0</Frame>
            <Frame>8,0</Frame>
            <Frame>9,0</Frame>
            <Frame>10,0</Frame>
            <Frame>11,0</Frame>
            <Frame>12,0</Frame>
            <Frame>13,0</Frame>
            <Frame>14,0</Frame>
            <Frame>15,0</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
            <Frame>2,1</Frame>
            <Frame>3,1</Frame>
			</SpriteAnimation>
            <SpriteAnimation name="ge_eff2" sprite="md_eff2" animTime="400" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
			<Frame>7,4</Frame>
			<Frame>8,4</Frame>
            <Frame>9,4</Frame>
            <Frame>10,4</Frame>
            <Frame>11,4</Frame>
			</SpriteAnimation>
            <SpriteAnimation name="ge_eff3" sprite="md_eff3" animTime="400" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
			<Frame>4,30</Frame>
			<Frame>5,30</Frame>
            <Frame>6,30</Frame>
            <Frame>7,30</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="ge_punch_eff" sprite="md_punch" animTime="400" isLoop="true" playOnState="Motion.Punch">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Idle_Animation" playOnState="Motion.Idle" sprite="md_sprite" animTime="7500" isLoop="true">
            <Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
            
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Punch_Animation" playOnState="Motion.Punch" sprite="md_sprite" animTime="7500">
			<Frame>0,3</Frame>
			<Frame>1,3</Frame>
			<Frame>2,3</Frame>
            <Frame>3,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Jump_Animation" playOnState="Motion.Jump" sprite="md_sprite" animTime="7000">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Fall_Animation" playOnState="Motion.Fall" sprite="md_sprite" animTime="7000">
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Walk_Animation" playOnState="Motion.Move" sprite="md_sprite" animTime="7000" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>

			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">30</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
                <Set name="ShouldHover">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
            <SpriteRender name="md_punch" offset="23,-10025" onState="Motion.Punch" blend="ADDITIVE" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0" scale="1,1"/>
            <SpriteRender name="md_eff" offset="0,-10060" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff" offset="0,-10060" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff" offset="0,-10060" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff3" offset="0,-10035" drawShadow="false" blend="ADDITIVE" flip="1,0" scale="1.5,2" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_sprite" offset="0,-10045" drawShadow="true" scale="1,1" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff" offset="0,-10050" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff" offset="0,-10045" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff2" offset="0,-10060" drawShadow="false" blend="ADDITIVE" scale="1.5,2" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>\
            <SpriteRender name="md_eff3" offset="0,-10035" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnPunchStart>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_mist" fileName="game/UGCSpritesheet32v3.rttex" textureSize="32" frame="10,0" />
		<Sprite name="s_snowflakes" fileName="game/UGCSpritesheet32v3.rttex" textureSize="32" frame="0,0"/>
		<Sprite name="s_hit_fire" fileName="game/UGCSpritesheet32v3.rttex" textureSize="32" frame="0,2" />
		<Sprite name="s_scythe" fileName="game/UGCSpritesheet32v0.rttex" textureSize="256"/>
		<Sprite name="s_punchCurve" fileName="game/UGCSpritesheet32v3.rttex" textureSize="32" frame="4,0" />
		<Sprite name="s_punchStraight" fileName="game/UGCSpritesheet32v3.rttex" textureSize="32" frame="2,0" />
		<Sprite name="s_punch_eff" fileName="game/UGCSpritesheet32v2.rttex" textureSize="512" frame="0,0"/>
		<Sprite name="s_pet" fileName="game/UGCSpritesheet32v1.rttex" textureSize="256"/>
		<Sprite name="s_gacor_projectile" fileName="game/UGCSpritesheet32v0.rttex" textureSize="256"/>
		<Sprite name="s_gacor_destroy_impact" fileName="game/UGCSpritesheet32v0.rttex" textureSize="256"/>
		<Sprite name="s_pet_fireball" fileName="game/UGCSpritesheet32v0.rttex" textureSize="256"/>
		<Sprite name="s_pet_tornado" fileName="game/UGCSpritesheet32v1.rttex" textureSize="256"/>
		<Animations>
			<SpriteAnimation name="a_pet_before" sprite="s_pet" autoPlay="true" animTime="800" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_after" sprite="s_pet" animTime="600" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_punch" sprite="s_pet" animTime="400" isLoop="true" playOnState="Pet.Punch">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="s_snowflakes">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_punch" sprite="s_punch_eff" animTime="400" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_projectile" sprite="s_gacor_projectile" animTime="300" isLoop="true">
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_destroy_impact" sprite="s_gacor_destroy_impact" animTime="400" isLoop="false">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>7,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_fireball" sprite="s_pet_fireball" animTime="400" isLoop="true">
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_tornado" sprite="s_pet_tornado" animTime="800" isLoop="true">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>7,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_before" sprite="s_scythe" animTime="1500" autoPlay="true" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_scythe" animTime="750" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hit_fire" sprite="s_hit_fire" animTime="400" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>
            <InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-95, 0, 0, 1" animTime="1000" playOnState="Punch.False"/>
		</Animations>
        <TileStampData>
            <Set name="FileName">game/UGCSpritesheet32v3.rttex</Set>
            <Set name="EndFrame">3,1</Set>
            <Set name="FrameCount">4</Set>
        </TileStampData>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
    <StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ScytheAnimation">
				<States>
					<State name="Before" />
					<State name="Idle" />
				</States>
				<Transitions>
					<Transition from="Before" to="Idle">
						<Condition>
							<IsAnimationFinished>a_hell_before</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_gacor_projectile</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_gacor_destroy_impact</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-300</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_pet_fireball</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_pet_tornado</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">5</Set>
          <Curve name="initialScale">
            <KeyFrame>0,1,1</KeyFrame>
            <KeyFrame>1,10,10</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
        <Emitter>
          <Random name="offset" min="-20, -30" max="20, -70" />
          <Random name="emissionInterval" min="0.28" max="0.56" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.8" max="1.4" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">16,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit_fire</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">60</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">-16,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit_fire</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">60</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_mist</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
			<KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_snowflakes</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
				<Emitter>
          <Random name="offset" min="-300, -150" max="110, 30" />
					<Random name="emissionInterval" min="0.010" max="0.02" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakes</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    				<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.7" max="1.8" />
					<Set name="lifeTime">1.5</Set>
					<Random name="initialVelocity" min="-20, 40" max="30, 60" />
					<Random name="initialAngle" min="0" max="-360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
	<RenderOptions>
		<Default>
			<Set name="ShouldHover">true</Set>
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">false</Set>
			<Set name="IncludeAllActions">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>
			<Set name="RenderBackArmBuild">false</Set>
			<Set name="RenderFrontArmInfected">true</Set>
			<Set name="RenderBackArmInfected">true</Set>
			<Set name="UserNameOffset">15</Set>
			<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
		</Default>
	</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-160</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Jump">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-210</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Fall">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-135</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="s_punch_eff" offset="10,-10" alignment="CENTER" rotateOffset="true" rotateToTarget="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="2,2" onAction="PUNCH" />
			<SpriteRender name="s_pet" offset="0,-330" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle" />
		</RenderInFront>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
            <Group onState="ScytheAnimation.Before">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_scythe" offset="65,133" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="2.6,2.6" />
            </Group>
			<Group onState="ScytheAnimation.Idle">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_scythe" offset="65,133" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="2.6,2.6" />
			</Group>
		</RenderBackHandItem>

		
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
	<StateMachines>
		<StateMachine name="playerState">
			<States>
				<State name="Idle"/>
				<State name="Punch"/>
				<State name="ZombiePunch"/>
			</States>
			<Transitions>
				<Transition from="ZombiePunch|Punch" to="Idle" >
					<Condition>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition from="ZombiePunch|Idle" to="Punch">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
						<IsZombified>false</IsZombified>
					</Condition>
				</Transition>
				<Transition from="Idle|Punch" to="ZombiePunch">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
						<IsZombified>true</IsZombified>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
	</StateMachines>
	<Sprite name="item_Sprite_1" fileName="game/UGCSpritesheet4v0.rttex" textureSize="64" frame="0,0"/>
	<Sprite name="item_Particle" fileName="game/UGCSpritesheet4v1.rttex" textureSize="32" frame="0,0"/>
	<Sprite name="item_Slash" fileName="game/UGCSpritesheet4v2.rttex" textureSize="64" frame="0,0"/>
	<Animations>

		<SpriteAnimation name="wingFlexJump2" playOnAction="JUMP|FALL|IDLE|WALK" sprite="item_Sprite_1" animTime="700" autoPlay="true" isLoop="true">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>4,0</Frame>
			<Frame>3,0</Frame>
			<Frame>2,0</Frame>
		</SpriteAnimation>
    </Animations>
	<ParticleSystems>
		<ParticleSystem name="smoke_particle">
			<Emitter>
				<Random name="offset" min="-20,-3" max="20,1"/>
				<Random name="emissionInterval" min="0.5" max="0.6"/>
				<Set name="infParticles">true</Set>
				<Set name="infLifeTime">true</Set>
				<Set name="particlesPerEmission">3</Set>
			</Emitter>
			<Particle>
				<Set name="sprite">item_Particle</Set>
				<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				<Set name="isBackgroundParticle">false</Set>
				<Set name="initalRGB">1, 1, 1</Set>
				<Set name="initialAlpha">1</Set>
				<Set name="finalAlpha">0</Set>
				<Set name="interpolateAlpha">true</Set>
				<Set name="interpolateScale">true</Set>
				<Set name="initialScale">1, 1</Set>
				<Set name="finalScale">1, 1</Set>
				<Set name="lifeTime">3</Set>
				<Random name="initialVelocity" min="-10, 20" max="10, 30"/>
				<Random name="initialAngle" min="0" max="271"/>
			</Particle>
		</ParticleSystem>
		<ParticleSystem name="yellow_slash_particle">
			<Emitter>
				<Set name="offset">0,-18</Set>
				<Set name="emissionInterval">0.25</Set>
				<Set name="lifeTime">0.25</Set>
				<Set name="particlesPerEmission">1</Set>
				<Set name="particlesToEmit">1</Set>
			</Emitter>
			<Particle>
				<Set name="sprite">item_Slash</Set>
				<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				<Set name="lifeTime">0.4</Set>
				<Set name="rotateWithVelocity">true</Set>
				<Set name="interpolateAlpha">false</Set>
				<Set name="initialAlpha">1</Set>
				<Set name="finalAlpha">1</Set>
				<Set name="interpolateVelocity">true</Set>
				<Set name="initialScale">2,2</Set>
				<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
			</Particle>
		</ParticleSystem>
	</ParticleSystems>
  </Data>

  <RenderRules>
    <RenderHandItem>
	  <SpriteRender name="item_Sprite_1" rotateOffset="true" offset="18,4" alignment="CENTER"/>
    </RenderHandItem>
	<OnPunchUpdate>
		<AvatarTransform class="Face">
			<Set name="face">MAD</Set>
		</AvatarTransform>
		<AvatarTransform class="ArmAngle">
			<Set name="armName">arm2Angle</Set>
			<Set name="armAngle">800</Set>
			<Set name="isAdditive">true</Set>
			<Set name="pointTowardsPunchTarget">false</Set>
		</AvatarTransform>
	</OnPunchUpdate>
	<OnPunchStart>
		<ParticleSystemUpdate name="yellow_slash_particle"/>
	</OnPunchStart>
	<AddClothingParticles>
		<ParticleSystemUpdate name="smoke_particle" onAction="JUMP|WALK|IDLE|FALL"/>
	</AddClothingParticles>
	<SwitchOffClothingParticles>
		<ParticleSystemOff name="yellow_slash_particle"/>
		<ParticleSystemOff name="smoke_particle"/>
	</SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
<!-- dm reeel. for items like this :) -->
  <Data>
    <Sprite name="iniWingnya" fileName="game/UGCSpritesheet5v0.rttex" textureSize="128"/>
    <Sprite name="iniParticlenya" fileName="game/UGCSpritesheet5v1.rttex" textureSize="128" frame="0,0"/>
    <!-- <Sprite name="death" fileName="game/flamingssSplash.rttex" textureSize="128"/> -->
    <Sprite name="iniTrail" fileName="game/UGCSpritesheet5v2.rttex" textureSize="64" frame="0,0"/>

    <Animations>
      <SpriteAnimation name="Jump" playOnAction="JUMP|JUMPDOUBLE" sprite="iniWingnya" animTime="200" autoPlay="true" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Fall" playOnAction="FALL" sprite="iniWingnya" animTime="200" autoPlay="true" isLoop="true">
        <Frame>3,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="iniWingnya" tintOverride="0,127,236,255">
        <Frame>0,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="iniParticlenya_jump">
        <Emitter>
          <Random name="offset" min="0, 40" max="0, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">1.1, 1.1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_left">
        <Emitter>
          <Random name="offset" min="40, 40" max="32, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_right">
        <Emitter>
          <Random name="offset" min="-32, 40" max="-40, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">iniTrail</Set> 
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">iniTrail</Set> 
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <!-- <Set name="HideAvatarOnDeath">true</Set>
        <Set name="HideAngelOnDeath">true</Set> -->
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>

    <RenderBackpack>
      <SpriteRender name="iniWingnya" offset="9,-35" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="iniWingnya" offset="-9,-35" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
    </RenderBackpack>
    
    <RenderInFront>
      <ParticleSystemRender name="ps_trail"/>
      <ParticleSystemRender name="ps_trail1 "/>
    </RenderInFront>

    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_trail" onAction="WALK" drawShadow="false"/>
      <ParticleSystemUpdate name="ps_trail1" onAction="WALK" drawShadow="false"/>
      <!-- donotremoveS -->
      <ParticleSystemUpdate name="iniParticlenya_jump" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_left" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_right" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_trail" />
      <ParticleSystemOff name="ps_trail1" />
      <ParticleSystemOff name="iniParticlenya_jump" />
      <ParticleSystemOff name="bloody_jump_left" />
      <ParticleSystemOff name="bloody_jump_right" />
    </SwitchOffClothingParticles>
  
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
	<!-- MAIN0 -->
		<Sprite name="s_buddha" fileName="game/UGCSpritesheet57v0.rttex" textureSize="256"/>
		<Sprite name="s_buddha_earth" fileName="game/UGCSpritesheet57v0.rttex" textureSize="256"/>
<!-- EFFECTS1 -->
		<Sprite name="s_debu" fileName="game/UGCSpritesheet57v1.rttex" textureSize="32" frame="10,0" />
		<Sprite name="s_debuWinter" fileName="game/UGCSpritesheet57v1.rttex" textureSize="32" frame="0,0"/>
		<Sprite name="s_flameHit" fileName="game/UGCSpritesheet57v1.rttex" textureSize="32" frame="0,2" />
		<Sprite name="s_flameCurve" fileName="game/UGCSpritesheet57v1.rttex" textureSize="32" frame="4,0" />
<!-- SLASH2 -->
		<Sprite name="s_punchEfek" fileName="game/UGCSpritesheet57v2.rttex" textureSize="512" frame="0,0"/>
<!-- HAND3 -->
		<Sprite name="s_iniSword" fileName="game/UGCSpritesheet57v3.rttex" textureSize="256"/>
		<Sprite name="s_ProjectileIni" fileName="game/UGCSpritesheet57v3.rttex" textureSize="256"/>
		<Sprite name="s_meledakDuar" fileName="game/UGCSpritesheet57v3.rttex" textureSize="256"/>
		<Sprite name="s_buddha_fire" fileName="game/UGCSpritesheet57v3.rttex" textureSize="256"/>

		<Animations>
			<SpriteAnimation name="a_buddha_earth_before" sprite="s_buddha" autoPlay="true" animTime="800" playerState="ScytheAnimation.Before">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_buddha_earth_after" sprite="s_buddha" animTime="600" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_punch" sprite="s_buddha" animTime="400" isLoop="true" playOnState="Pet.Punch" playOnAction="PUNCH">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="s_debuWinter">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_punch" sprite="s_punchEfek" animTime="400" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_projectile" sprite="s_ProjectileIni" animTime="300" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_destroy_impact" sprite="s_meledakDuar" animTime="400" isLoop="false">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_fireball" sprite="s_buddha_fire" animTime="400" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_buddha_earth" sprite="s_buddha_earth" animTime="800" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_before" sprite="s_iniSword" animTime="1500" autoPlay="true" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_iniSword" animTime="750" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hit_fire" sprite="s_flameHit" animTime="400" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
            <InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-190, 0, 180, 1" animTime="1000" playOnState="Punch.False"/>
		</Animations>
        <TileStampData>
            <Set name="FileName">game/UGCSpritesheet57v1.rttex</Set>
            <Set name="EndFrame">3,1</Set>
            <Set name="FrameCount">4</Set>
        </TileStampData>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
    <StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ScytheAnimation">
				<States>
					<State name="Before" />
					<State name="Idle" />
				</States>
				<Transitions>
					<Transition from="Before" to="Idle">
						<Condition>
							<IsAnimationFinished>a_hell_before</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileIni</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_meledakDuar</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-300</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_buddha_fire</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_buddha_earth</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">5</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,10,10</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
        <Emitter>
          <Random name="offset" min="-20, -30" max="20, -70" />
          <Random name="emissionInterval" min="0.28" max="0.56" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.8" max="1.4" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">16,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">60</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">-16,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">60</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
			<KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_debuWinter</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
				<Emitter>
          <Random name="offset" min="-300, -150" max="110, 30" />
					<Random name="emissionInterval" min="0.010" max="0.02" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_debuWinter</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    				<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.7" max="1.8" />
					<Set name="lifeTime">1.5</Set>
					<Random name="initialVelocity" min="-20, 40" max="30, 60" />
					<Random name="initialAngle" min="0" max="-360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
	<RenderOptions>
		<Default>
			<Set name="ShouldHover">true</Set>
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">false</Set>
			<Set name="IncludeAllActions">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>
			<Set name="RenderBackArmBuild">false</Set>
			<Set name="RenderFrontArmInfected">true</Set>
			<Set name="RenderBackArmInfected">true</Set>
			<Set name="UserNameOffset">15</Set>
			<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
		</Default>
	</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-160</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Jump">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-210</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Fall">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-135</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="s_punchEfek" offset="10,-10" alignment="CENTER" rotateOffset="true" rotateToTarget="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="2,2" onAction="PUNCH" />
			<SpriteRender name="s_buddha" offset="0,-360" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle|Pet.Punch" />
		</RenderInFront>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
            <Group onState="ScytheAnimation.Before">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_iniSword" offset="-210,-5" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="-2.6,2.6" />
            </Group>
			<Group onState="ScytheAnimation.Idle">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_iniSword" offset="-210,-5" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="-2.6,2.6" />
			</Group>
		</RenderBackHandItem>

		
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<!-- 0main -->
		<Sprite name="s_scythe" fileName="game/UGCSpritesheet58v0.rttex" textureSize="128,180"/>
		<!-- 1effMain -->
		<Sprite name="s_punch_eff" fileName="game/UGCSpritesheet58v1.rttex" textureSize="400,333" frame="0,0"/>
		<!-- 2effSmall -->
		<Sprite name="s_snowflakes" fileName="game/UGCSpritesheet58v2.rttex" textureSize="32"/>
		<Sprite name="s_mist" fileName="game/UGCSpritesheet58v2.rttex" textureSize="32" frame="10,0" />
		<Sprite name="s_snowflakesHit" fileName="game/UGCSpritesheet58v2.rttex" textureSize="32" frame="13,28" />
		<Sprite name="s_punchStraight" fileName="game/UGCSpritesheet58v2.rttex" textureSize="32" frame="16,28" />
		<!-- 3effLarge -->
		<Sprite name="s_punchCurve" fileName="game/UGCSpritesheet58v3.rttex" textureSize="64" frame="15,9" />
		
		
		<!-- <Sprite name="s_pet" fileName="game/hell_monster" textureSize="308,256"/> -->
		
		<Animations>
			<SpriteAnimation name="a_pet_before" sprite="s_pet" autoPlay="true" animTime="800" playerState="ScytheAnimation.Before">
				<Frame>1,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_after" sprite="s_pet" animTime="600" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_punch" sprite="s_pet" animTime="400" isLoop="true" playOnState="Pet.Punch">
				<Frame>8,0</Frame>
				<Frame>9,0</Frame>
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="s_snowflakes">
				<Frame>4,14</Frame>
				<Frame>5,14</Frame>
			</SpriteAnimation>
            <SpriteAnimation name="a_hell_punch" sprite="s_punch_eff" animTime="400" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_before" sprite="s_scythe" animTime="1500" autoPlay="true" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_scythe" animTime="600" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>8,0</Frame>
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
				<Frame>12,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakesHit" sprite="s_snowflakesHit">
				<Frame>13,28</Frame>
				<Frame>14,28</Frame>
				<Frame>15,28</Frame>
			</SpriteAnimation>
            <InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-95, 0, 0, 1" animTime="1000" playOnState="Punch.False"/>
		</Animations>
        <TileStampData>
            <Set name="FileName">game/server_3920/particles9.rttex</Set>
            <Set name="EndFrame">28,17</Set>
            <Set name="FrameCount">4</Set>
        </TileStampData>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
    <StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ScytheAnimation">
				<States>
					<State name="Before" />
					<State name="Idle" />
				</States>
				<Transitions>
					<Transition from="Before" to="Idle">
						<Condition>
							<IsAnimationFinished>a_hell_before</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
      <ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
        <Emitter>
          <Random name="offset" min="-20, -30" max="20, -70" />
          <Random name="emissionInterval" min="0.28" max="0.56" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.4" max="0.7" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_snowflakes</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_mist</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>0.5, 1.5,1.5</KeyFrame>
			<KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_snowflakes</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 0.25, 0.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
				<Emitter>
          <Random name="offset" min="-50, -70" max="30, -80" />
					<Random name="emissionInterval" min="0.07" max="0.14" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakes</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    				<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.35" max="0.90" />
					<Set name="lifeTime">1.5</Set>
					<Random name="initialVelocity" min="-20, 40" max="30, 60" />
					<Random name="initialAngle" min="0" max="-360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
	<RenderOptions>
		<Default>
			<Set name="NeedRenderPet">true</Set>
			<Set name="PetOffsetDuplication">-48,0</Set>
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">false</Set>
			<Set name="IncludeAllActions">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>
			<Set name="RenderBackArmBuild">false</Set>
			<Set name="RenderFrontArmInfected">true</Set>
			<Set name="RenderBackArmInfected">true</Set>
			<Set name="UserNameOffset">15</Set>
			<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
		</Default>
	</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-120</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="s_punch_eff" offset="10,-10" alignment="CENTER" rotateOffset="true" rotateToTarget="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="1,1" onAction="PUNCH" />
		</RenderInFront>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
            <Group onState="ScytheAnimation.Before">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_scythe" offset="15.5,30" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="0.7,0.7" />
            </Group>
			<Group onState="ScytheAnimation.Idle">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_scythe" offset="15.5,30" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="0.7,0.7" />
            </Group>
		</RenderBackHandItem>
		<RenderPet>
			<SpriteRender name="s_pet" scale="1,1" alignment="CENTER" offset="-100,-120" onState="ScytheAnimation.Before|ScytheAnimation.Idle"/>			
		</RenderPet>

		
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitSparkles" />
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<TileStampData>
			<Set name="FileName">game/UGCSpritesheet59v1.rttex</Set>
			<Set name="EndFrame">3,0</Set>
			<Set name="FrameCount">3</Set>
		</TileStampData>
		<StateMachines>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="playerState">
				<States>
					<State name="Idle" />
					<State name="Punch" />
					<State name="ZombiePunch" />
				</States>
				<Transitions>
					<Transition from="ZombiePunch|Punch" to="Idle">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="ZombiePunch|Idle" to="Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Idle|Punch" to="ZombiePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
					 </Transitions>
      </StateMachine>
		</StateMachines>
<!-- back0 -->
		<Sprite name="Sword_Sprite_Idle" fileName="game/UGCSpritesheet59v0.rttex" textureSize="640" />
		<Sprite name="BackPack" fileName="game/UGCSpritesheet59v0.rttex" textureSize="640"/>
<!-- particles1 -->
		<Sprite name="back_Sprite" fileName="game/UGCSpritesheet59v1.rttex" textureSize="32" frame="6,0" />
		<Sprite name="sword_slash_Sprite" fileName="game/UGCSpritesheet59v1.rttex" textureSize="32" frame="4,0" />
<!-- sbks2 -->
		<Sprite name="Sword_Sprite" fileName="game/UGCSpritesheet59v2.rttex" textureSize="1024" frame="0,0" />
<!-- punch3 -->
		<Sprite name="rapsaura1" fileName="game/UGCSpritesheet59v3.rttex" textureSize="64" frame="1,1" />
		<Sprite name="res" fileName="game/UGCSpritesheet59v3.rttex" textureSize="64" frame="0,0" />
		<Sprite name="fire_Sprite" fileName="game/UGCSpritesheet59v3.rttex" textureSize="64" frame="0,1" />

		<Animations>
			<SpriteAnimation name="sword_idle_anim" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch" useFacing="RIGHT"
				sprite="Sword_Sprite_Idle" animTime="400">
					<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_idle_anim_left" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch" useFacing="LEFT"
				sprite="Sword_Sprite_Idle" animTime="600">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="backpack_idle_anim" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch|playerState.Punch"
				useFacing="RIGHT" sprite="BackPack" animTime="600">
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="backpack_idle_anim_left" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch|playerState.Punch"
				useFacing="LEFT" sprite="BackPack" animTime="600">
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_idle" autoPlay="false" sprite="Sword_Sprite_Idle"
				playOnState="playerState.Idle" animTime="50">
				<Frame>0,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_slash_frame" animTime="400" sprite="sword_slash_Sprite">
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			 <SpriteAnimation name="rapsRespawn" sprite="res" animTime="1200" isLoop="true">
		    	<Frame>7,0</Frame>
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>7,0</Frame>
           </SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="slash_particle">
				<Emitter>
					<Random name="offset" min="10, -18" max="11, -21" />
					<Set name="emissionInterval">2</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">sword_slash_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialScale">2.5,2.5</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8"
						angle="0" />
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="0.8"
						angle="0" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ABC" updateStage="OnKilled">
				<Emitter>
					<Set name="lifeTime">0.9</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">res</Set>
					<Set name="offset">0,-10</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1,1</KeyFrame>
						<KeyFrame>1, 1,1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hitSpark_particle" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">false</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">fire_Sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.8,0.8</Set>
					<Random name="finalScale" min="0.1, 0.1" max="0.4, 0.4" />
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200" />
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300" />
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_aura" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -15</Set>
					<Set name="emissionInterval">0.8</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">rapsaura1</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0.5, 1.1, 1.1</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialVelocity">0, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_aura2" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -15</Set>
					<Set name="emissionInterval">0.8</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">rapsaura1</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipX">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0.5, 1.1, 1.1</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialVelocity">0, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="smoke_particle" updateStage="AddClothingParticles">
			<Emitter>
				<Random name="offset" min="-10,-20" max="15,-25"/>
				<Random name="emissionInterval" min="0.5" max="0.6"/>
				<Set name="infParticles">true</Set>
				<Set name="infLifeTime">true</Set>
				<Set name="particlesPerEmission">2</Set>
			</Emitter>
			<Particle>
				<Set name="sprite">fire_Sprite</Set>
				<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				<Set name="isBackgroundParticle">false</Set>
				<Set name="initalRGB">1, 1, 1</Set>
				<Set name="initialAlpha">1</Set>
				<Set name="finalAlpha">0</Set>
				<Set name="interpolateAlpha">true</Set>
				<Set name="interpolateScale">true</Set>
				<Set name="initialScale">0.3,0.3</Set>
				<Set name="finalScale">0.1,0.1</Set>
				<Set name="lifeTime">3</Set>
				<Random name="initialVelocity" min="-10, 20" max="10, 30"/>
				<Random name="initialAngle" min="0" max="271"/>
				<Select name="initialRotationRate" input="randomNumber">
                        <Item>340</Item>
                        <Item>360</Item>
                    </Select>
			</Particle>
		</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="HasDeathParticles">true</Set>
			    <Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">600</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">600</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
		</Update>

		<RenderHandItem>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="Sword_Sprite" offset="17,4" scale="0.12,0.12" blend="PREMULTIPLIED_ALPHA"
				rotateOffset="true" onState="playerState.Punch" />
		</RenderHandItem>

		<RenderFrontArm>
			<SpriteRender name="back_Sprite" alignment="DOWN_CENTER" useFixedRotation="true" fixedRotation="0" />
		</RenderFrontArm>

		<OnPunchUpdate>
			<AvatarTransform class="Emotion">
				<Set name="emotion">TROLL</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderBackArm value="playerCenter">
			<StopIf type="or">
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<SpriteRender name="Sword_Sprite_Idle" scale="0.11,0.11" offset="-8, -19"
				onState="playerState.Idle|playerState.ZombiePunch" useFixedRotation="true"
				fixedRotation="0" />
			<SpriteRender name="BackPack" scale="0.11,0.11" offset="-8, -19"
				onAction="JUMP|JUMPSTART|FALL|IDLE|WALK|PUNCH|SWIM" useFixedRotation="true"
				fixedRotation="0" />
		</RenderBackArm>

		<OnPunchStart>
			<ParticleSystemUpdate name="slash_particle" />
		</OnPunchStart>

		<RenderBehind>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_aura" onState="Facing.Right" />
			<ParticleSystemRender name="ps_aura2" onState="Facing.Left" />
		</RenderBehind>

		<RenderInFront>
			<ParticleSystemRender name="smoke_particle" />
		</RenderInFront>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="slash_particle" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="badan_ninetails" fileName="game/UGCSpritesheet6v0.rttex.rttex" textureSize="192"/>
		<Sprite name="s_punchBubbles" fileName="game/UGCSpritesheet6v1.rttex" textureSize="256" frame="0,0"/>
    	<Sprite name="s_explosion" fileName="game/UGCSpritesheet6v2.rttex" textureSize="256" />
    	<Sprite name="s_punchSplash" fileName="game/particles11.rttex" textureSize="32" frame="23,26"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="kyub_bjdama" sprite="s_punchBubbles" animTime="800" isLoop="false">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
			<Frame>0,2</Frame>
			<Frame>0,2</Frame>
			<Frame>0,2</Frame>
			<Frame>0,2</Frame>
			<Frame>0,2</Frame>
			<Frame>0,2</Frame>
			<Frame>0,2</Frame>
			<Frame>0,2</Frame>
			<Frame>0,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_explosion" sprite="s_explosion" animTime="400" isLoop="false">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="kyub_Idle_Animation" playOnState="Motion.Idle" sprite="badan_ninetails" animTime="600" isLoop="true">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame> 
			</SpriteAnimation>
			<SpriteAnimation name="kyub_Punch_Animation" playOnState="Motion.Punch" sprite="badan_ninetails" animTime="300">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kyub_Jump_Animation" playOnState="Motion.Jump" sprite="badan_ninetails" animTime="300">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kyub_Fall_Animation" playOnState="Motion.Fall" sprite="badan_ninetails" animTime="300">
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kyub_Walk_Animation" playOnState="Motion.Move" sprite="badan_ninetails" animTime="600" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="dasdasdas" updateStage="AddClothingParticles" updateState="Motion.Punch">
			<Emitter>
			<Set name="offset">15, -10150</Set>
			<Set name="offsetFacing">true</Set>
			<Random name="emissionInterval" min="12" max="12" />
			<Set name="infParticles">true</Set>
			<Set name="infLifeTime">true</Set>
			<Set name="particlesPerEmission">1</Set>
			</Emitter>
			<Particle>
			<Set name="sprite">s_punchBubbles</Set>
			<Set name="frame">0,0</Set>
			<Set name="renderAlignment">CENTER</Set>
			<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
			<Set name="initialScale">0.1,0.1</Set>
			<Random name="finalScale" min="0" max="6"/>
			<Set name="interpolateScale">true</Set>
			<Set name="lifeTime">3.4</Set>
			<Random name="targetPosOffset" min="-12,-11" max="12,11"/>
			<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="2" angleOutVar="projectile_angle"/>
			<VectorTo name="finalVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.1" angleOutVar="projectile_angle"/>
			<Set name="interpolateVelocity">true</Set>
			<OnFinish>
				<ParticleSystemName>ps_explosion</ParticleSystemName>
			</OnFinish>
			</Particle>
		</ParticleSystem>
		<ParticleSystem name="ps_explosion">
			<Emitter>
			<Set name="lifeTime">0.4</Set>
			<Set name="particlesPerEmission">1</Set>
			<Set name="offset">0,0</Set>
			<Set name="particlesToEmit">1</Set>
			<Set name="checkParticleNumToEmit">true</Set>
			</Emitter>
			<Particle>
			<Set name="initialScale">6,6</Set>
			<Set name="sprite">s_explosion</Set>
			<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
			<Set name="lifeTime">0.4</Set>
			</Particle>
		</ParticleSystem>
			
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">SHOES</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="JumpEndStateRange">1000</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">200</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="badan_ninetails" offset="-50,-10250" drawShadow="true" scale="3,3"/>
			
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnPunchStart>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
<!-- dm reeel. for items like this :) -->
  <Data>
  <!-- blue0 -->
    <Sprite name="iniWingnya" fileName="game/UGCSpritesheet60v0.rttex" textureSize="128,128"/>
  <!-- eff1 -->
    <Sprite name="iniParticlenya" fileName="game/UGCSpritesheet60v1.rttex" textureSize="128" frame="0,0"/>
    <!-- <Sprite name="death" fileName="game/flamingssSplash.rttex" textureSize="128"/> -->
    <!-- <Sprite name="iniTrail" fileName="game/negroFet.rttex" textureSize="64" frame="0,0"/> -->

    <Animations>
      <SpriteAnimation name="Jump" playOnAction="JUMP|JUMPDOUBLE" sprite="iniWingnya" animTime="200" autoPlay="true" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Fall" playOnAction="FALL" sprite="iniWingnya" animTime="200" autoPlay="true" isLoop="true">
        <Frame>3,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="iniWingnya" tintOverride="0,127,236,255">
        <Frame>0,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="iniParticlenya_jump">
        <Emitter>
          <Random name="offset" min="0, 40" max="0, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">1.1, 1.1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_left">
        <Emitter>
          <Random name="offset" min="40, 40" max="32, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_right">
        <Emitter>
          <Random name="offset" min="-32, 40" max="-40, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <!-- <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">iniTrail</Set> 
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">iniTrail</Set> 
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem> -->

      
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <!-- <Set name="HideAvatarOnDeath">true</Set>
        <Set name="HideAngelOnDeath">true</Set> -->
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>

    <RenderBackpack>
      <SpriteRender name="iniWingnya" offset="3,-25" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"  scale="0.6,0.5"/>
      <SpriteRender name="iniWingnya" offset="-3,-25" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"  scale="0.6,0.5"/>
      
    </RenderBackpack>
    
    <RenderInFront>
      <!-- <ParticleSystemRender name="ps_trail"/>
      <ParticleSystemRender name="ps_trail1 "/> -->
    </RenderInFront>

    <AddClothingParticles>
      <!-- <ParticleSystemUpdate name="ps_trail" onAction="WALK" drawShadow="false"/>
      <ParticleSystemUpdate name="ps_trail1" onAction="WALK" drawShadow="false"/> -->
      <!-- donotremoveS -->
      <ParticleSystemUpdate name="iniParticlenya_jump" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_left" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_right" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <!-- <ParticleSystemOff name="ps_trail" />
      <ParticleSystemOff name="ps_trail1" /> -->
      <ParticleSystemOff name="iniParticlenya_jump" />
      <ParticleSystemOff name="bloody_jump_left" />
      <ParticleSystemOff name="bloody_jump_right" />
    </SwitchOffClothingParticles>
  
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="Win_Pet" fileName="game/UGCSpritesheet61v0.rttex" textureSize="128,32" frame="0,0"/>
    <Sprite name="Win_PetParts" fileName="game/UGCSpritesheet61v1.rttex" textureSize="40,32" frame="0,0"/>
    <Sprite name="Win_Hand" fileName="game/UGCSpritesheet61v2.rttex" textureSize="128,64" frame="0,0"/>
    <Sprite name="Win_Punch" fileName="game/UGCSpritesheet61v3.rttex" textureSize="32" frame="0,0" />

    <Animations>
      <SpriteAnimation name="Win_PetIdle" sprite="Win_Pet" animTime="800" isLoop="true" autoPlay="true" playOnState="Pet.Idle">
        <Frame>0,0</Frame>
        <Frame>0,1</Frame>
        <Frame>1,0</Frame>
      </SpriteAnimation>
      
      <SpriteAnimation name="Win_PetPartsIdle" sprite="Win_PetParts" animTime="800" isLoop="true" playOnState="Pet.Idle">
        <Frame>0,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Win_PetPunch" sprite="Win_Pet" animTime="800" isLoop="false" playOnState="Pet.Punch">
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Win_PetPartsPunch" sprite="Win_PetParts" animTime="800" isLoop="false" playOnState="Pet.Punch">
        <Frame>1,0</Frame>
      </SpriteAnimation>
    </Animations>
    
    <StateMachines>
      <StateMachine name="Pet">
        <States>
          <State name="Idle" />
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition to="Punch" from="Idle">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Idle" from="Punch" >
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Move|Jump" >
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Jump|Fall|Idle" >
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall" >
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move" >
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <ParticleSystems>
      <ParticleSystem name="pWin_Punch_projectile" updateStage="OnPunchStart" updateState="Pet.Punch">
        <Emitter>
          <Set name="offset">110, -22</Set>
          <Random name="emissionInterval" min="0.001" max="0.005" />
          <Set name="particlesPerEmission">4</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
        </Emitter>
        
        <Particle autoLifeTimeToTarget="true">
          <Set name="sprite">Win_Punch</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="rotateWithVelocity">true</Set>
          
          <Set name="renderAlignment">CENTER</Set>
          
          <Random name="offset" min="0,0" max="0,0" />
          
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          
          <Curve name="initialScale">
            <KeyFrame>0, 0.2, 0.2</KeyFrame>
            <KeyFrame>0.2, 2.0, 2.0</KeyFrame>
            <KeyFrame>1, 5.0, 5.0</KeyFrame>
          </Curve>
          
          <Set name="lifeTime">0.2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          
          <RandomRadial name="initialVelocity" angleRange="-20,20" radiusRange="50,150" />
          
          <Set name="flipX">false</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="SpawnParticleRabbits">
        <Emitter>
          <Set name="offset">0, -500</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">Win_Pet</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 3, 3</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="SpawnSparkle">
        <Emitter>
          <Set name="offset">0, -900</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">Win_Punch</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Random name="offset" min="-8, -8" max="8, 8" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="1" max="1.5" />
          <Increment name="finalScale" source="initialScale" multiplier="2.5,2.5"/>
          <Set name="interpolateScale">true</Set>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <RenderOptions>
      <Default>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">0,0</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShouldHover">false</Set>
        <Set name="UsePetForceFaceTime">true</Set>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="DefaultPunchSound">audio/droar.wav</Set>
        <Set name="PlayDefaultPunchAudio">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderPet>
      <SpriteRender name="Win_Pet" alignment="DOWN_CENTER" scale="2,2"/>
      <SpriteRender name="Win_PetParts" alignment="DOWN_CENTER" offset="2,-38" onState="Pet.Idle" scale="2,2"/>
      <SpriteRender name="Win_PetParts" alignment="DOWN_CENTER" offset="-8,34" onState="Pet.Punch" scale="2,2"/>
      
      <ParticleSystemUpdate name="pWin_Punch_projectile" offset="160,-22" scale="2.5,1.5" onState="Pet.Punch" blend="PREMULTIPLIED_ALPHA" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" />
    </RenderPet>
    
    <RenderHandItem>
      <SpriteRender name="Win_Hand" offset="10,10" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="0.8,0.8" />
    </RenderHandItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="Win_Wing" fileName="game/UGCSpritesheet62v0.rttex" textureSize="96,96"/>
    <Sprite name="Win_Particle" fileName="game/UGCSpritesheet62v1.rttex" textureSize="128" frame="0,0"/>
    <Sprite name="Win_Trail" fileName="game/UGCSpritesheet62v2.rttex" textureSize="64" frame="0,0"/>
    
    <Sprite name="Win_LandingFront" fileName="game/UGCSpritesheet62v2.rttex" textureSize="64" frame="5,0"/>
    <Sprite name="Win_LandingBG" fileName="game/UGCSpritesheet62v2.rttex" textureSize="64" frame="6,0"/>
    <Sprite name="Win_LandingShard" fileName="game/UGCSpritesheet62v2.rttex" textureSize="64" frame="7,0"/>

    <StateMachines>
      <StateMachine name="Win_WingMotion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
          <State name="LandedTrigger" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall|LandedTrigger">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.0</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="LandedTrigger" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Idle" from="LandedTrigger" />
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="Win_Anim_Jump" playOnState="Win_WingMotion.Jump" sprite="Win_Wing" animTime="200" autoPlay="true" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Win_Anim_Fall" playOnState="Win_WingMotion.Fall" sprite="Win_Wing" animTime="200" autoPlay="true" isLoop="true">
        <Frame>3,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Win_Anim_Idle" playOnState="Win_WingMotion.Idle|Win_WingMotion.Move|Win_WingMotion.LandedTrigger" sprite="Win_Wing" tintOverride="0,127,236,255">
        <Frame>0,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="Win_Particle_Jump">
        <Emitter>
          <Random name="offset" min="0, 40" max="0, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">Win_Particle</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">1.1, 1.1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="Win_Jump_Left">
        <Emitter>
          <Random name="offset" min="40, 40" max="32, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">Win_Particle</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="Win_Jump_Right">
        <Emitter>
          <Random name="offset" min="-32, 40" max="-40, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">Win_Particle</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="Win_PS_Trail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">Win_Trail</Set> 
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="Win_Crystal_BG">
        <Emitter>
          <Set name="offset">0, -45</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">false</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">Win_LandingBG</Set>
          <Set name="isBackgroundParticle">true</Set> 
          <Set name="relativeToEmitter">false</Set> 
          <Set name="rotateWithVelocity">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.2, 0.2</KeyFrame>
            <KeyFrame>0.2, 1.4, 1.4</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="Win_Crystal_Front">
        <Emitter>
          <Set name="offset">0, -45</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">false</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">Win_LandingFront</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="relativeToEmitter">false</Set>
          <Set name="rotateWithVelocity">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.2, 0.2</KeyFrame>
            <KeyFrame>0.2, 1.4, 1.4</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="Win_Shards">
        <Emitter>
          <Random name="offset" min="-32, -24" max="32, -8"/>
          <Set name="particlesPerEmission">15</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">false</Set>
          <Set name="particlesToEmit">15</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">Win_LandingShard</Set> 
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="relativeToEmitter">false</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 80</Set>
          <RandomRadial name="initialVelocity" angleRange="180,360" radiusRange="100,220"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1.0, 1.0</KeyFrame> 
            <KeyFrame>1, 0.2, 0.2</KeyFrame>
          </Curve>
          <Random name="lifeTime" min="0.4" max="0.7"/>
        </Particle>
      </ParticleSystem>

    </ParticleSystems>
    
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IncludeAllActions">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="Win_Wing" offset="6,-35" scale="0.85,0.85" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="Win_Wing" offset="-6,-35" scale="0.85,0.85" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
    </RenderBackpack>
    
    <RenderInFront>
      <ParticleSystemRender name="Win_PS_Trail"/>
      
      <ParticleSystemRender name="Win_Crystal_BG"/>
      <ParticleSystemRender name="Win_Crystal_Front"/>
      <ParticleSystemRender name="Win_Shards"/>
    </RenderInFront>

    <AddClothingParticles>
      <ParticleSystemUpdate name="Win_PS_Trail" onAction="WALK" drawShadow="false"/>
      
      <ParticleSystemUpdate name="Win_Crystal_BG" onState="Win_WingMotion.LandedTrigger" drawShadow="false"/>
      <ParticleSystemUpdate name="Win_Crystal_Front" onState="Win_WingMotion.LandedTrigger" drawShadow="false"/>
      <ParticleSystemUpdate name="Win_Shards" onState="Win_WingMotion.LandedTrigger" drawShadow="false"/>
      
      <ParticleSystemUpdate name="Win_Particle_Jump" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
      <ParticleSystemUpdate name="Win_Jump_Left" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
      <ParticleSystemUpdate name="Win_Jump_Right" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <ParticleSystemOff name="Win_PS_Trail" />
      <ParticleSystemOff name="Win_Particle_Jump" />
      <ParticleSystemOff name="Win_Jump_Left" />
      <ParticleSystemOff name="Win_Jump_Right" />
    </SwitchOffClothingParticles>
  
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
