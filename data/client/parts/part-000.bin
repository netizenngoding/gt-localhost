						<KeyFrame>0.5, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.4" max="0.5"/>
					<Random name="initialVelocity" min="0,-35" max="0,-45"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="windBackParticle">
				<Emitter>
					<Set name="offset">0,-24</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.3</Set>
					<Set name="intervalMax">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="false">
					<Set name="sprite">windBackSprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.8" max="1"/>
					<Random name="initialVelocity" min="0,-40" max="0,-50"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="windFrontParticle">
				<Emitter>
					<Set name="offset">0,-21</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.15</Set>
					<Set name="intervalMax">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="false">
					<Set name="sprite">windFrontSprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.8" max="1"/>
					<Random name="initialVelocity" min="0,-40" max="0,-50"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="windFeetLeftParticle">
				<Emitter>
					<Set name="offset">-18,-14</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.2</Set>
					<Set name="intervalMax">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">windFeetSprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1,1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.2, 0.5</KeyFrame>
						<KeyFrame>0.6, 0.2</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.2" max="0.3"/>
					<Random name="initialVelocity" min="-10,0" max="-30,0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="windFeetRightParticle">
				<Emitter>
					<Set name="offset">18,-14</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.2</Set>
					<Set name="intervalMax">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">windFeetSprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1,1</Set>
					<Set name="flipX">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.2" max="0.3"/>
					<Random name="initialVelocity" min="10,0" max="30,0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="rocksParticle">
				<Emitter>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.1</Set>
					<Set name="intervalMax">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">rocksSprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_NORMAL</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.4, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="-30" max="30"/>
					<Random name="lifeTime" min="0.6" max="0.8"/>
					<Random name="initialVelocity" min="-10,-60" max="10,-70"/>
					<Random name="offset" min="-18,0" max="18,0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="speedLinesParticle">
				<Emitter>
					<Set name="offset">0,-4</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.05</Set>
					<Set name="intervalMax">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">speedLinesSprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0,0,0</KeyFrame>
						<KeyFrame>0.2,1,0.3</KeyFrame>
						<KeyFrame>1,2,0.3</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.2" max="0.3"/>
					<RandomRadial name="initialVelocity" angleRange="230,310" radiusRange="150,200"/>
					<Multiply name="offset" source="initialVelocity" scale="0.1,0"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

	</Data>

	<RenderRules>
		<AddClothingParticles>
			<ParticleSystemUpdate name="fireParticle1"/>
			<ParticleSystemUpdate name="fireParticle2"/>
			<ParticleSystemUpdate name="windBackParticle"/>
			<ParticleSystemUpdate name="rocksParticle"/>
			<ParticleSystemUpdate name="windFrontParticle"/>
			<ParticleSystemUpdate name="speedLinesParticle"/>
			<ParticleSystemUpdate name="windFeetLeftParticle"/>
			<ParticleSystemUpdate name="windFeetRightParticle"/>
		</AddClothingParticles>
		<RenderAura>
			<ParticleSystemRender name="fireParticle1"/>
			<ParticleSystemRender name="fireParticle2"/>
			<ParticleSystemRender name="windBackParticle"/>
		</RenderAura>
		<RenderInFront>
			<SpriteRender name="lightningSprite" scale="1.3,0.7" offset="0,-12" blend="PREMULTIPLIED_ALPHA"/>
			<SpriteRender name="timeDilation" offset="0,-24"/>
			<ParticleSystemRender name="rocksParticle"/>
			<ParticleSystemRender name="speedLinesParticle"/>
			<ParticleSystemRender name="windFrontParticle"/>
			<ParticleSystemRender name="windFeetLeftParticle"/>
			<ParticleSystemRender name="windFeetRightParticle"/>
		</RenderInFront>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="fireParticle1"/>
			<ParticleSystemOff name="fireParticle2"/>
			<ParticleSystemOff name="windBackParticle"/>	
			<ParticleSystemOff name="rocksParticle"/>
			<ParticleSystemOff name="speedLinesParticle"/>
			<ParticleSystemOff name="windFrontParticle"/>
			<ParticleSystemOff name="windFeetLeftParticle"/>
			<ParticleSystemOff name="windFeetRightParticle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_JADE_DAJIO_STAFF">
	<Data>
		<StateMachines>
			<StateMachine name="playerState">
				<States>
					<State name="Idle"/>
					<State name="Punch"/>
					<State name="ZombiePunch"/>
				</States>
				<Transitions>
					<Transition from="ZombiePunch|Punch" to="Idle" >
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="ZombiePunch|Idle" to="Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Idle|Punch" to="ZombiePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="Staff_Sprite" fileName="game/particles_large12.rttex" textureSize="64" frame="15,1"/>
		<Sprite name="Staff_Sprite_Idle" fileName="game/particles_large12.rttex" textureSize="64" frame="15,1"/>
		<Sprite name="Strap" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="27,13"/>
		<Sprite name="BackPack" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="28,13"/>
		<Sprite name="sword_slash_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="31,18"/>
		<Sprite name="hit_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="31,17"/>
		<Sprite name="smoke_sprite" fileName="game/particles11.rttex" textureSize="32" frame="9,17"/>

		<Animations>
			<SpriteCurveAnimation name="staff_rotation_anim" isLoop="true" playOnState="playerState.Punch"  useFacing="RIGHT" sprite="Staff_Sprite" animTime="500">
				<Curve name="rotation">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 360</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="staff_rotation_anim_left" isLoop="true" playOnState="playerState.Punch"  useFacing="LEFT" sprite="Staff_Sprite" animTime="500">
				<Curve name="rotation">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, -360</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="staff_idle_anim" isLoop="true" playOnState="playerState.Idle|playerState.ZombiePunch" useFacing="RIGHT" sprite="Staff_Sprite_Idle" animTime="100">
				<Curve name="rotation">
					<KeyFrame>0, 20</KeyFrame>
					<KeyFrame>1, 20</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="staff_idle_anim_left" isLoop="true" playOnState="playerState.Idle|playerState.ZombiePunch" useFacing="LEFT" sprite="Staff_Sprite_Idle" animTime="100">
				<Curve name="rotation">
					<KeyFrame>0, -20</KeyFrame>
					<KeyFrame>1, -20</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="staff_punch_anim" autoPlay="false" sprite="Staff_Sprite" playOnState="playerState.Punch" animTime="50">
				<Frame>15,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="staff_idle" autoPlay="false" sprite="Staff_Sprite_Idle" playOnState="playerState.Idle" animTime="50">
				<Frame>15,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="smoke_anim" autoPlay="false" sprite="smoke_sprite" animTime="500">
				<Frame>9,19</Frame>
				<Frame>10,19</Frame>
				<Frame>11,19</Frame>
				<Frame>12,19</Frame>
				<Frame>13,19</Frame>
				<Frame>14,19</Frame>
				<Frame>15,19</Frame>
				<Frame>16,19</Frame>
				<Frame>17,19</Frame>
				<Frame>18,19</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="slash_particle">
				<Emitter>
					<Set name="offset">0,-16</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">sword_slash_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initialScale">0.3,0.3</Set>
					<Set name="finalScale">2,2.5</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Random name="particlesPerEmission" min="6" max="8"/>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="finalRotationRate">5</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1,1</Set>
					<Random name="finalScale" min="0.2" max="0.5"/>
					<Set name="interpolateAngle">true</Set>
					<Random name="initialAngle" min="-360" max="360"/>
					<Random name="finalAngle" min="-360" max="360"/>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,80"/>
					<Random name="posOffset" min="0, 0" max="16,16"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="smoke_particle">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">smoke_sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="finalScale">1.3,1.3</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Set name="initialRotationRate">360</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1280</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-60</Set>
			</AvatarTransform>
		</Update>
		<RenderHandItem>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="Staff_Sprite" offset="-0.1,8.3" blend="PREMULTIPLIED_ALPHA" rotateOffset="true" onState="playerState.Punch" />
		</RenderHandItem>
		<RenderFrontArm>
			<SpriteRender name="Strap" alignment="DOWN_CENTER" useFixedRotation="true" fixedRotation="0"/>
		</RenderFrontArm>
		<RenderInFront>
		</RenderInFront>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderBackArm value="playerCenter">
			<StopIf type="or">
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<SpriteRender name="Staff_Sprite_Idle" offset="0, -12" onState="playerState.Idle|playerState.ZombiePunch" useFixedRotation="true" fixedRotation="0"/>
			<SpriteRender name="BackPack" offset="0.5, -16" onAction="JUMP|JUMPSTART|FALL|IDLE|WALK|PUNCH|SWIM" useFixedRotation="true" fixedRotation="0"/>
		</RenderBackArm>
		<OnPunchStart>
			<ParticleSystemUpdate name="slash_particle"/>
		</OnPunchStart>
		<OnDamagedTile>
			<ParticleSystemUpdate name="smoke_particle"/>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="smoke_particle"/>
		</OnDestroyedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="slash_particle"/>
			<ParticleSystemOff name="hit_particle"/>
			<ParticleSystemOff name="smoke_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="Sprite27" textureSize="128,128" frame="0,0" />
        <Animations/>
        <ParticleSystems />
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
        <RenderOptions>
            <Default>

            </Default>
        </RenderOptions>
        <VariableMap>
	        <Set name="saturationValue">0.5</Set>
	        <Set name="brightnessValue">4</Set>
	        <Set name="contrastValue">-0.75</Set>
	        <Set name="sittingOffset">0, 0, 0</Set>
	        <Set name="sittingOffsetTemp">-1, -1, -1</Set>
        </VariableMap>
    </Data>
    <RenderRules>
	    <RenderInFront value="playerCenter">
		    <StopIf type="or">
			    <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
			    <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
			    <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
			    <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			    <IsRenderMod>RENDER_MOD_COLORED_SHADOW</IsRenderMod>
			    <IsRenderMod>RENDER_MOD_RENDER_TARGET</IsRenderMod>
			    <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			    <IsWearing slot="SHIRT">ITEM_ID_ENCHANTED_ROBE</IsWearing>
			    <IsWearing slot="BACKPACK">ITEM_ID_WINGS_OF_INFINITY</IsWearing>
			    <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
			    <IsZombified>true</IsZombified>
			    <IsVariableBool name="isMannequin">true</IsVariableBool>
		    </StopIf>
		    <AvatarTransform class="RenderData">
			    <Set name="saturation">saturationValue</Set>
			    <Set name="brightness">brightnessValue</Set>
			    <Set name="contrast">contrastValue</Set>
		    </AvatarTransform>

	    </RenderInFront>
        <RenderBehind value="playerCenter">
	        <StopIf type="or">
		        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
		        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
		        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
		        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
		        <IsRenderMod>RENDER_MOD_COLORED_SHADOW</IsRenderMod>
		        <IsRenderMod>RENDER_MOD_RENDER_TARGET</IsRenderMod>
		        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
		        <IsWearing slot="SHIRT">ITEM_ID_ENCHANTED_ROBE</IsWearing>
		        <IsWearing slot="BACKPACK">ITEM_ID_WINGS_OF_INFINITY</IsWearing>
		        <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
		        <IsZombified>true</IsZombified>
		        <IsVariableBool name="isMannequin">true</IsVariableBool>
	        </StopIf>

	        <ContextUpdate type="SetTintFromSlot">
		        <Set name="slot">CHESTITEM</Set>
		        <Set name="seedFG">false</Set>
	        </ContextUpdate>

	        <ContextUpdate type="SetTintFromSlot">
		        <Set name="slot">SHIRT</Set>
		        <Set name="seedFG">false</Set>
	        </ContextUpdate>	       

        </RenderBehind>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="Sprite9" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="3,1" />
        <Sprite name="Sprite32" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="2,1" />
        <Sprite name="Sprite185" fileName="game/particles12.rttex" textureSize="32,32" frame="0,14" />
        <Animations>
