    <RenderBackpack>
      <SpriteRender name="vow" offset="0,-32" scale="0.50,0.50" drawShadow="false" />
    </RenderBackpack>
    
    <RenderInFront>
        <ParticleSystemRender name="ps_snowflake" />
        <ParticleSystemRender name="ps_trail"/>
        <ParticleSystemRender name="ps_snowflake1"/>
        <ParticleSystemRender name="ps_trail1"/>
    </RenderInFront>

    <AddClothingParticles>
        <ParticleSystemUpdate name="ps_trail" onAction="WALK|IDLE|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_snowflake" onAction="IDLE|WALK|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_trail1" onAction="WALK|IDLE|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_snowflake1" onAction="IDLE|WALK|JUMP|FALL" drawShadow="false"/>
        <!-- donotremoveS -->
        <ParticleSystemUpdate name="iniParticlenya_jump" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
        <ParticleSystemUpdate name="bloody_jump_left" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
        <ParticleSystemUpdate name="bloody_jump_right" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_trail" />
      <ParticleSystemOff name="ps_trail1" />
      <ParticleSystemOff name="iniParticlenya_jump" />
      <ParticleSystemOff name="bloody_jump_left" />
      <ParticleSystemOff name="bloody_jump_right" />
    </SwitchOffClothingParticles>
  
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_GROWTRONIC_GLIDER">
    <Data>
        <!-- satu -->
        <Sprite name="vow" fileName="game/UGCSpritesheet91v0.rttex" textureSize="256" frame="0,0" />
        <Sprite name="voww" fileName="game/UGCSpritesheet91v0.rttex" textureSize="256" frame="5,0" />
        <Sprite name="vowww" fileName="game/UGCSpritesheet91v0.rttex" textureSize="256" frame="0,0" />
        <Sprite name="reel" fileName="game/UGCSpritesheet91v0.rttex" textureSize="256" frame="0,0" />
<!-- dua -->
        <Sprite name="reeel" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="0,0" />
        <Sprite name="dmVowForThis" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="1,0" />
        <Sprite name="vowwww" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="2,0" />
        <Sprite name="reeeel" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="3,0" />
        <Sprite name="vowwwww" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="4,0" />
        <Sprite name="reeeeel" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="11,0"/>
        <Sprite name="dmVowHere" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="6,0"/>
        <Sprite name="vowReel" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32"/> 
        <Sprite name="reelVow" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="9,0" />
        <Sprite name="vowwwwww" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="11,0" />
        <Sprite name="reeeeeeel" fileName="game/UGCSpritesheet91v1.rttex" textureSize="32" frame="0,1" />
<!-- tiga -->
        <Sprite name="dmVowNow" fileName="game/UGCSpritesheet91v2.rttex" textureSize="64" frame="0,0" />
        <Sprite name="vowwwwwww" fileName="game/UGCSpritesheet91v2.rttex" textureSize="64" frame="1,0" />
        <Sprite name="reeeeeeeel" fileName="game/UGCSpritesheet91v2.rttex" textureSize="64" frame="2,0" />
        <Sprite name="vowReeel" fileName="game/UGCSpritesheet91v2.rttex" textureSize="64" frame="3,0" />
<!-- empat -->
        <Sprite name="reelVowww" fileName="game/UGCSpritesheet91v3.rttex" textureSize="256" frame="0,1" />
        <Sprite name="dmVowAgain" fileName="game/UGCSpritesheet91v3.rttex" textureSize="256" frame="0,0" />
        <StateMachines>
            <StateMachine name="Punch">
                <States>
                    <State name="False" />
                    <State name="True" />
                </States>
                <Transitions>
                    <Transition from="False" to="True">
                        <Condition>
                            <IsAction>PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition from="True" to="False">
                        <Condition>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
            <StateMachine name="Motion">
                <States>
                    <State name="Idle" />
                    <State name="Move" />
                    <State name="Jump" />
                    <State name="Fall" />
                    <State name="Punch"/>
                    <State name="Respawn"/>
                </States>
                <Transitions>
                    <Transition to="Idle" from="Fall|Move|Jump|Punch">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                            <IsVariableBool name="isAttacking">false</IsVariableBool>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Move" from="Jump|Fall|Idle|Punch">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Jump" from="Idle|Move|Fall|Punch">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Fall" from="Jump|Idle|Move|Punch">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Punch" from="Idle|Move|Jump|Fall">
                        <Condition type="and">
                            <IsAction>PUNCH</IsAction>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
            <StateMachine name="Mobility">
                <States>
                    <State name="Stationary" />
                    <State name="Moving" />
                </States>
                <Transitions>
                    <Transition to="Stationary" from="Moving">
                        <Condition>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Moving" from="Stationary">
                        <Condition>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
            <StateMachine name="Reveal">
                <States>
                    <State name="No" />
                    <State name="Done" />
                </States>
                <Transitions>
                    <Transition to="Done" from="No">
                        <Condition>
                            <IsAnimationFinished>a_reveal_left</IsAnimationFinished>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
            <StateMachine name="Trail">
                <States>
                    <State name="Off" />
                    <State name="On" />
                </States>
                <Transitions>
                    <Transition to="On" from="Off">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                            <IsAnimationFinished>a_reveal_left</IsAnimationFinished>
                        </Condition>
                    </Transition>
                    <Transition to="Off" from="On">
                        <Condition>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Off" from="On">
                        <Condition>
                            <IsVariableBool name="onGround">false</IsVariableBool>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
            <StateMachine name="Grounded">
                <States>
                    <State name="Off" />
                    <State name="On" />
                </States>
                <Transitions>
                    <Transition to="On" from="Off">
                        <Condition>
                            <IsVariableBool name="onGround">true</IsVariableBool>
                        </Condition>
                    </Transition>
                    <Transition to="Off" from="On">
                        <Condition>
                            <IsVariableBool name="onGround">false</IsVariableBool>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
            <StateMachine name="Facing">
                <States>
                    <State name="Left"/>
                    <State name="Right"/>
                </States>
                <Transitions>
                    <Transition to="Left" from="Right">
                        <Condition>
                            <IsFacingLeft>true</IsFacingLeft>
                        </Condition>
                    </Transition>
                    <Transition to="Right" from="Left">
                        <Condition>
                            <IsFacingLeft>false</IsFacingLeft>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>
        <Animations>
            <SpriteAnimation name="a_trail" sprite="reeeeeeel" isLoop="true" autoPlay="true" animTime="800">
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
                <Frame>4,1</Frame>
                <Frame>5,1</Frame>
                <Frame>6,1</Frame>
                <Frame>7,1</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_prodragon_tile_impact" sprite="reelVowww" animTime="400" isLoop="false">
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>0,2</Frame>
                <Frame>1,2</Frame>
                <Frame>2,2</Frame>
                <Frame>3,2</Frame>
                <Frame>4,2</Frame>
                <Frame>5,2</Frame>
                <Frame>6,2</Frame>
                <Frame>7,2</Frame>
            </SpriteAnimation>
            <SpriteCurveAnimation name="a_reveal_left" autoPlay="true" sprite="vowww" animTime="3000" playOnState="Reveal.No">
                <Curve name="pos">
                    <KeyFrame>0, -384,-99.5</KeyFrame>
                    <KeyFrame>1, -99,-99.5</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>
            <SpriteCurveAnimation name="a_reveal_Portal_Rotate" autoPlay="true" sprite="vowwww" isLoop="true" animTime="1200" playOnState="Reveal.No">
                <Curve name="rotation">
                    <KeyFrame>0, 0</KeyFrame>
                    <KeyFrame>1, 360</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>
            <SpriteCurveAnimation name="a_reveal_Portal_Scale" autoPlay="true" sprite="vowwww" animTime="1000" playOnState="Reveal.No">
                <Curve name="scale">
                    <KeyFrame>0.f, 0f, 0f</KeyFrame>
                    <KeyFrame>1.f, 4f, 4f</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>
            <SpriteCurveAnimation name="a_reveal_Portal_pos" autoPlay="true" sprite="vowwww" animTime="500" playOnState="Reveal.No">
                <Curve name="pos">
                    <KeyFrame>0, -255,-55.5</KeyFrame>
                    <KeyFrame>0, -255,-55.5</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>
            <SpriteCurveAnimation name="a_reveal_portal_alpha" autoPlay="true" sprite="vowwww" animTime="2100" playOnState="Reveal.No">
                <Curve name="alpha">
                    <KeyFrame>0.f, 0.f</KeyFrame>
                    <KeyFrame>0.5.f, 1.f</KeyFrame>
                    <KeyFrame>0..f, 1.f</KeyFrame>
                    <KeyFrame>1.f, 0.f</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>

            <SpriteCurveAnimation name="a_reveal_Portal1_Rotate" autoPlay="true" sprite="reeeel" isLoop="true" animTime="800" playOnState="Reveal.No">
                <Curve name="rotation">
                    <KeyFrame>0, 0</KeyFrame>
                    <KeyFrame>1, 360</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>
            <SpriteCurveAnimation name="a_reveal_Portal1_Scale" autoPlay="true" sprite="reeeel" animTime="1000" playOnState="Reveal.No">
                <Curve name="scale">
                    <KeyFrame>0.f, 0f, 0f</KeyFrame>
                    <KeyFrame>1.f, 7f, 7f</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>
            <SpriteCurveAnimation name="a_reveal_Portal1_pos" autoPlay="true" sprite="reeeel" animTime="500" playOnState="Reveal.No">
                <Curve name="pos">
                    <KeyFrame>0, -255,-55.5</KeyFrame>
                    <KeyFrame>0, -255,-55.5</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>
            <SpriteCurveAnimation name="a_reveal_portal1_alpha" autoPlay="true" sprite="reeeel" animTime="2100" playOnState="Reveal.No">
                <Curve name="alpha">
                    <KeyFrame>0.f, 0.f</KeyFrame>
                    <KeyFrame>0.5.f, 1.f</KeyFrame>
                    <KeyFrame>0..f, 1.f</KeyFrame>
                    <KeyFrame>1.f, 0.f</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>

            <SpriteCurveAnimation name="a_reveal_alpha" autoPlay="true" sprite="vowww" animTime="2000" playOnState="Reveal.No">
                <Curve name="alpha">
                    <KeyFrame>0.f, 0.f</KeyFrame>
                    <KeyFrame>0.5.f, 0.f</KeyFrame>
                    <KeyFrame>1.f, 1.f</KeyFrame>
                </Curve>
            </SpriteCurveAnimation>

            <SpriteAnimation name="a_ray_idle" sprite="vow" animTime="800" isLoop="true" playOnState="Reveal.Done">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_snowflakes" sprite="vowReel">
                <Frame>7,0</Frame>
                <Frame>8,0</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_ray_move" sprite="voww" animTime="800" isLoop="true" playOnState="Motion.Move|Motion.Jump">
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_ray_punch" sprite="voww" animTime="800" isLoop="true" playOnState="Motion.Punch">
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_ray_extra" sprite="dmVowAgain" animTime="800" isLoop="true" playOnState="Motion.Move|Motion.Jump|Motion.Punch">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
                <Frame>5,0</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_ray_fall" sprite="reel" animTime="300" playOnState="Motion.Fall">
                <Frame>0,1</Frame>
                <Frame>7,0</Frame>
                <Frame>6,0</Frame>
                <Frame>5,0</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_ray_walk" sprite="vowww" animTime="800" autoPlay="true" isLoop="true">
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
            </SpriteAnimation>
        </Animations>
        <RenderOptions>
            <Default>
                <Set name="ClothingOffsetFromShoes">0</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="UserNameOffset">50</Set>
                <Set name="IncludeAllActions">false</Set>
                <Set name="HasDeathParticles">true</Set>
                <Set name="HideAngelOnDeath">true</Set>
                <Set name="HideAvatarOnDeath">true</Set>
                <Set name="IgnorePunchTypeCheck">true</Set>
                <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
                <Set name="PlayDefaultPunchAudio">true</Set>
            </Default>
            <Override overrideOnState="Mobility.Moving|Punch.True">
                <Set name="ClothingOffsetFromShoes">-92</Set>
            </Override>
            <Override overrideOnState="Reveal.Done">
                <Set name="ClothingOffsetFromShoes">-73.2</Set>
            </Override>
        </RenderOptions>
        <ParticleSystems>
        </ParticleSystems>
        <VariableMap>
        </VariableMap>
        <ParticleSystems>
            <ParticleSystem name="DeathParticle" updateStage="OnKilled" renderStage="RenderBehind">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">vowwwwww</Set>
					<Random name="offset" min="-30, -31" max="30, 31" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.5, 1.5</KeyFrame>
						<KeyFrame>1, 6, 6</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
					<Random name="initialVelocity" min="-25, -75" max="25, 20" />
				</Particle>
			</ParticleSystem>
            <ParticleSystem name="ps_RespawnBack" updateStage="OnKilled" renderStage="RenderBehind">
                <Emitter>
                    <Set name="offset">-5, 50</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">5</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle usePlayerFacing="true">
                    <Set name="sprite">reeeeeeeel</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="initialVelocity">0,-80</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 15,1.5</KeyFrame>
                        <KeyFrame>1, 3,1.5</KeyFrame>
                    </Curve>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.7, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_RespawnBack2" updateStage="OnKilled" renderStage="RenderBehind">
                <Emitter>
                    <Set name="offset">-5, -50</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">5</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle usePlayerFacing="true">
                    <Set name="sprite">reeeeeeeel</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="initialVelocity">0,80</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 15,1.5</KeyFrame>
                        <KeyFrame>1, 3,1.5</KeyFrame>
                    </Curve>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.7, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_RespawnAura" updateStage="OnKilled" renderStage="RenderBehind">
                <Emitter>
                    <Set name="offset">0, -45</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle usePlayerFacing="true">
                    <Set name="sprite">reeeel</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="initialRotationRate">360</Set>
                    <Set name="lifeTime">1</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 15, 15</KeyFrame>
                        <KeyFrame>0.7, 30, 30</KeyFrame>
                        <KeyFrame>1, 3, 3</KeyFrame>
                    </Curve>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.9, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_punchAuraBehind" updateStage="AddClothingParticles" renderStage="RenderBehind" updateState="Punch.True">
                <Emitter>
                    <Set name="offset">0, -45</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle usePlayerFacing="true">
                    <Set name="sprite">reeeeeeeel</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="initialRotationRate">360</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 4, 4</KeyFrame>
                        <KeyFrame>1, 4, 4</KeyFrame>
                    </Curve>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.7, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_punchAuraBehind1" updateStage="AddClothingParticles" renderStage="RenderBehind" updateState="Punch.True">
                <Emitter>
                    <Set name="offset">0, -60</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle usePlayerFacing="true">
                    <Set name="sprite">vowReeel</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 7, 7</KeyFrame>
                        <KeyFrame>1, 7, 7</KeyFrame>
                    </Curve>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.9, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="PunchParticle" updateStage="AddClothingParticles" updateState="Punch.True">
                <Emitter>
                    <Set name="offset">130, -35</Set>
                    <Random name="emissionInterval" min="0.001" max="0.005" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Particle usePlayerFacing="true"></Particle>
                    <Set name="sprite">reelVow</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 4, 4</KeyFrame>
                        <KeyFrame>1, 10, 10</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">0.35</Set>
                    <Random name="targetPosOffset" min="-12,-8" max="12,8"/>
                    <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.7" angleOutVar="projectile_angle"/>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_rain">
                <Emitter>
                    <Random name="offset" min="-120, -110" max="80, -100" />
                    <Random name="emissionInterval" min="0.035" max="0.07" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle randomSpriteFrame="true">
                    <Set name="sprite">vowReel</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0.8</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Random name="initialScale" min="0.7" max="1.8" />
                    <Set name="lifeTime">1.5</Set>
                    <Random name="initialVelocity" min="-20, 40" max="30, 60" />
                    <Random name="initialAngle" min="0" max="-360" />
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_smoke">
                <Emitter>
                    <Random name="offset" min="0, 45" max="0, 45" />
                    <Random name="emissionInterval" min="0.2" max="0.5" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">2</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">dmVowHere</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">2</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0</KeyFrame>
                        <KeyFrame>0.5, 0.8</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Random name="initialVelocity" min="-30,0" max="30,0"/>
                    <Random name="initialScale" min="6" max="8" />
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_shieldFlames_left">
                <Emitter>
                    <Random name="offset" min="55, -20" max="60, -25" />
                    <Random name="emissionInterval" min="0.05" max="0.1" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">reeeeel</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="lifeTime">1.2</Set>
                    <Set name="initialVelocity">0,-3</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0</KeyFrame>
                        <KeyFrame>0.5, 0.4</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Random name="initialScale" min="0.6" max="1.2" />
                    <Random name="initialAngle" min="40" max="40" />
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_shieldFlames_right">
                <Emitter>
                    <Random name="offset" min="55, -20" max="60, -25" />
                    <Random name="emissionInterval" min="0.05" max="0.1" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">reeeeel</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="lifeTime">1.2</Set>
                    <Set name="initialVelocity">0,-3</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0</KeyFrame>
                        <KeyFrame>0.5, 0.4</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Random name="initialScale" min="0.6" max="1.2" />
                    <Random name="initialAngle" min="-40" max="-40" />
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_jump_prop1_left" updateStage="AddClothingParticles" updateState="Motion.Jump">
                <Emitter>
                    <Set name="offset">-30, 50</Set>
                    <Random name="emissionInterval" min="5" max="5" />
                    <Set name="infParticles">true</Set>
                    <Set name="offsetFacing">false</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">vowwwww</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.5, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Curve name="initialScale">
                        <KeyFrame>0, 0,0</KeyFrame>
                        <KeyFrame>1, 11,11</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">1</Set>
                    <Random name="initialVelocity" min="-15, 10" max="-15, 10" />
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_jump_prop1_right" updateStage="AddClothingParticles" updateState="Motion.Jump">
                <Emitter>
                    <Set name="offset">30, 50</Set>
                    <Random name="emissionInterval" min="5" max="5" />
                    <Set name="infParticles">true</Set>
                    <Set name="offsetFacing">false</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">vowwwww</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.5, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Curve name="initialScale">
                        <KeyFrame>0, 0,0</KeyFrame>
                        <KeyFrame>1, 11,11</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">1</Set>
                    <Set name="flipX">true</Set>
                    <Random name="initialVelocity" min="15, 10" max="15, 10" />
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_Aura">
                <Emitter>
                    <Set name="offset">0, -75</Set>
                    <Set name="emissionInterval">0.15</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">dmVowNow</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.4, 0.75</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Set name="isBackgroundParticle">true</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 4, 5</KeyFrame>
                        <KeyFrame>1, 4, 6</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">0.8</Set>
                    <Set name="initialVelocity">0, -15</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_Aura_fire" updateStage="AddClothingParticles" updateState="Punch.True">
                <Emitter>
                    <Set name="offset">-10, 2</Set>
                    <Set name="emissionInterval">0.15</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">3</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">vowwwwwww</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.4, 0.75</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Set name="isBackgroundParticle">true</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 2, 2</KeyFrame>
                        <KeyFrame>1, 8, 8</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">0.3</Set>
                    <Set name="initialVelocity">0, -60</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_trail">
                <Emitter>
                    <Set name="particlesPerEmission">4</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Random name="emissionInterval" min="0.1" max="0.2" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="useCharacterPos">true</Set>
                    <Set name="offset">-32,10</Set>
                </Emitter>
                <Particle usePlayerFacing="true">
                    <Set name="sprite">reeeeeeel</Set>
                    <Set name="lifeTime">3</Set>
                    <Set name="initalRGB">0.63, 0.13, 0.94</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="renderAlignment">DOWN_CENTER</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0.8</KeyFrame>
                        <KeyFrame>0.2, 1</KeyFrame>
                        <KeyFrame>0.6, 0.8</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Curve name="initialScale">
                        <KeyFrame>0, 2, 2</KeyFrame>
                        <KeyFrame>0.2, 4, 4</KeyFrame>
                        <KeyFrame>1, 2, 2</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_prodragon_tile_hit" updateStage="OnDamagedTile">
                <Emitter>
                    <Set name="offset">0,0</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">reelVowww</Set>
                    <Set name="renderAlignment">CENTER</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">0.4</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0,3,3</KeyFrame>
                        <KeyFrame>1,3,3</KeyFrame>
                    </Curve>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>0.75,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_prodragon_tile_destroy">
                <Emitter>
                    <Set name="offset">0,0</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">reelVowww</Set>
                    <Set name="renderAlignment">CENTER</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">0.4</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0,15,15</KeyFrame>
                        <KeyFrame>1,15,15</KeyFrame>
                    </Curve>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>0.75,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>
    </Data>
    <RenderRules>
        <OnDrawCustomOutline>
            <AvatarTransform class="RenderData">
                <Set name="saturation">getCurrent</Set>
                <Set name="brightness">getCurrent</Set>
                <Set name="contrast">getCurrent</Set>
            </AvatarTransform>
            <AvatarTransform class="Scale">
                <Set name="targetScale">getCurrent</Set>
            </AvatarTransform>
            <AvatarTransform class="RenderData">
                <Set name="saturation">10</Set>
                <Set name="brightness">getCurrent</Set>
                <Set name="contrast">getCurrent</Set>
            </AvatarTransform>
            <AvatarOutline duration="1500" startScale="1,1" endScale="1.0.5,1.0.5">
                <Colours>
                    <Colour>160,32,240,255</Colour>
                    <Colour>186,85,211,255</Colour>
                    <Colour>216,191,216,255</Colour>
                </Colours>
            </AvatarOutline>
            <AvatarTransform class="RenderData">
                <Set name="saturation">10</Set>
                <Set name="brightness">getCurrent</Set>
                <Set name="contrast">getCurrent</Set>
            </AvatarTransform>
            <AvatarOutline duration="1500" startScale="1,1" endScale="1.05,1.05">
                <Colours>
                    <Colour>147,112,219,255</Colour>
                </Colours>
            </AvatarOutline>
            <AvatarTransform class="RenderData">
                <Set name="saturation">reset</Set>
                <Set name="brightness">reset</Set>
                <Set name="contrast">reset</Set>
            </AvatarTransform>
            <AvatarTransform class="Scale">
                <Set name="targetScale">reset</Set>
            </AvatarTransform>
        </OnDrawCustomOutline>
        <Update>
            <StopIf>
                <IsZombified>true</IsZombified>
            </StopIf>
            <AvatarTransform class="FootPosition">
                <Set name="foot1dy">0</Set>
                <Set name="foot2dy">0</Set>
                <Set name="foot1y">0</Set>
                <Set name="foot2y">0</Set>
            </AvatarTransform>
            <AvatarTransform class="ArmAngle" onState="Motion.Move">
                <Set name="armName">arm2Angle</Set>
                <Set name="armAngle">-45</Set>
            </AvatarTransform>
            <AvatarTransform class="ArmAngle" onState="Motion.Move">
                <Set name="armName">arm1Angle</Set>
                <Set name="armAngle">-45</Set>
            </AvatarTransform>
            <AvatarTransform class="ArmAngle" onState="Motion.Fall">
                <Set name="armName">arm2Angle</Set>
                <Set name="armAngle">-180</Set>
            </AvatarTransform>
            <AvatarTransform class="ArmAngle" onState="Motion.Fall">
                <Set name="armName">arm1Angle</Set>
                <Set name="armAngle">-180</Set>
            </AvatarTransform>
            <StopIf type="or">
                <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
                <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
            </StopIf>
        </Update>
        <AddClothingParticles>
            <ParticleSystemUpdate name="ps_Aura"/>
            <ParticleSystemUpdate name="ps_trail" onState="Trail.On"/>
            <ParticleSystemUpdate name="ps_smoke"/>
            <ParticleSystemUpdate name="ps_rain"/>
            <ParticleSystemUpdate name="ps_shieldFlames_left" onState="Grounded.On"/>
            <ParticleSystemUpdate name="ps_shieldFlames_right" onState="Grounded.On"/>
        </AddClothingParticles>
        <RenderInFront>
            <MusicSource onState="Motion.Idle">
                <Set name="MusicFile">audio/oracle.wav</Set>
            </MusicSource>
            <ParticleSystemRender name="ps_Aura"/>
            <Group onState="Reveal.Done">
                <SpriteRender name="dmVowAgain" offset="-99,-14" alignment="CENTER" scale="2,2" onState="Punch.True" />
            </Group>
        </RenderInFront>
        <RenderBehind>
        </RenderBehind>
        <RenderShoes >
            <Group onState="Reveal.No">
                <SpriteRender name="reeel" offset="0,0" flip="1,0" drawShadow="false" onState="Reveal.No" tintOverride="128,0,128,255"/>
                <Group onState="Facing.Right">
                    <SpriteRender name="reeel" offset="0.5,-16.5" tintOverride="SKIN" />
                    <SpriteRender name="dmVowForThis" offset="0.5,-16.5" tintOverride="SKIN"/>
                    <SpriteRender name="vowww" offset="0,0" scale="2,2" onState="Reveal.No"/>
                </Group>
                <Group onState="Facing.Left">
                    <SpriteRender name="reeel" offset="-0.5,-16.5" tintOverride="SKIN" />
                    <SpriteRender name="dmVowForThis" offset="-0.5,-16.5" tintOverride="SKIN"/>
                    <SpriteRender name="vowww" offset="0,0" scale="2,2" flip="1,0" onState="Reveal.No"/>
                </Group>
                <SpriteRender name="vowwww" offset="0,0" flip="1,0" drawShadow="false" onState="Reveal.No" tintOverride="160,32,240,255"/>
            </Group>
            <Group onState="Reveal.Done">
                <SpriteRender name="reeeeeeeel" offset="-5,82" scale="7,0.7" alignment="CENTER" onState="Motion.Idle|Motion.Punch|Motion.Move|Motion.Jump|Motion.Fall" tintOverride="128,0,128,255"/>
                <SpriteRender name="reeeeeeeel" offset="-5,82" scale="5,0.56" alignment="CENTER" onState="Motion.Idle|Motion.Punch|Motion.Move|Motion.Jump|Motion.Fall" tintOverride="216,191,216,255"/>
                <AvatarSilhouetteRender color="128,0,128,100" offset ="0,30" emissionInterval="0.10" onState="Mobility.Moving"/>
                <Group onState="Facing.Left">
                    <SpriteRender name="reeel" offset="0.5,-16.5" tintOverride="SKIN" />
                    <SpriteRender name="dmVowForThis" offset="0.5,-16.5" tintOverride="SKIN"/>
                    <SpriteRender name="vow" offset="-99,-17.8" alignment="CENTER" scale="2,2" onState="Motion.Idle" />
                    <SpriteRender name="reel" offset="-99,-18.8" alignment="CENTER" scale="2,2" onState="Motion.Fall" />
                    <SpriteRender name="voww" offset="-99,-22.8" alignment="CENTER" scale="2,2" onState="Motion.Move"/>
                    <SpriteRender name="voww" offset="-99,-22.8" alignment="CENTER" scale="2,2" onState="Motion.Jump|Punch.True"/>
                    <ParticleSystemRender name="ps_shieldFlames_left"/>
                </Group>
                <Group onState="Facing.Right">
                    <SpriteRender name="reeel" offset="0.5,-16.5" tintOverride="SKIN" />
                    <SpriteRender name="dmVowForThis" offset="0.5,-16.5" tintOverride="SKIN"/>
                    <SpriteRender name="vow" offset="-99,-18.8" alignment="CENTER" scale="2,2" onState="Motion.Idle" />
                    <SpriteRender name="reel" offset="-99,-22.8" alignment="CENTER" scale="2,2" onState="Motion.Fall" />
                    <SpriteRender name="voww" offset="-99,-22.8" alignment="CENTER" scale="2,2" onState="Motion.Move"/>
                    <SpriteRender name="voww" offset="-99,-22.8" alignment="CENTER" scale="2,2" onState="Motion.Jump|Motion.Punch"/>
                    <ParticleSystemRender name="ps_shieldFlames_right"/>
                </Group>
                <ParticleSystemRender name="ps_smoke"/>
                <ParticleSystemRender name="ps_trail"/>
                <ParticleSystemRender name="ps_rain"/>
            </Group>
        </RenderShoes>
        <OnDestroyedTile>
            <ParticleSystemUpdate name="ps_prodragon_tile_destroy"/>
        </OnDestroyedTile>
    </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<!-- bart -->
		<Sprite name="s_mist" fileName="game/UGCSpritesheet92v0.rttex" textureSize="32" frame="10,0" />
		<Sprite name="s_snowflakes" fileName="game/UGCSpritesheet92v0.rttex" textureSize="32" frame="0,0"/>
		<Sprite name="s_hit_fire" fileName="game/UGCSpritesheet92v0.rttex" textureSize="32" frame="0,2" />
		<Sprite name="s_punchCurve" fileName="game/UGCSpritesheet92v0.rttex" textureSize="32" frame="4,0" />
		<Sprite name="s_punchStraight" fileName="game/UGCSpritesheet92v0.rttex" textureSize="32" frame="2,0" />
		<!-- bar -->
		<Sprite name="s_punch_eff" fileName="game/UGCSpritesheet92v1.rttex" textureSize="512" frame="0,0"/>
		<!-- b -->
		<Sprite name="s_scythe" fileName="game/UGCSpritesheet92v2.rttex" textureSize="256"/>
		<Sprite name="s_gacor_projectile" fileName="game/UGCSpritesheet92v2.rttex" textureSize="256"/>
		<Sprite name="s_gacor_destroy_impact" fileName="game/UGCSpritesheet92v2.rttex" textureSize="256"/>
		<Sprite name="s_pet_fireball" fileName="game/UGCSpritesheet92v2.rttex" textureSize="256"/>
		<!-- ba -->
		<Sprite name="s_pet" fileName="game/UGCSpritesheet92v3.rttex" textureSize="273"/>
		<Sprite name="s_pet_tornado" fileName="game/UGCSpritesheet92v3.rttex" textureSize="273"/>
		<Animations>
			<SpriteAnimation name="a_pet_before" sprite="s_pet" autoPlay="true" animTime="800" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_after" sprite="s_pet" animTime="600" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>6,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_punch" sprite="s_pet" animTime="400" isLoop="true" playOnState="Pet.Punch">
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="s_snowflakes">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_punch" sprite="s_punch_eff" animTime="400" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_projectile" sprite="s_gacor_projectile" animTime="100" isLoop="true">
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_destroy_impact" sprite="s_gacor_destroy_impact" animTime="400" isLoop="false">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>7,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_fireball" sprite="s_pet_fireball" animTime="400" isLoop="true">
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_tornado" sprite="s_pet_tornado" animTime="800" isLoop="true">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>0,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_before" sprite="s_scythe" animTime="1500" autoPlay="true" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_scythe" animTime="750" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hit_fire" sprite="s_hit_fire" animTime="400" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>
            <InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-95, 0, 0, 1" animTime="1000" playOnState="Punch.False"/>
		</Animations>
        <TileStampData>
            <Set name="FileName">game/UGCSpritesheet92v0.rttex</Set>
            <Set name="EndFrame">3,1</Set>
            <Set name="FrameCount">4</Set>
        </TileStampData>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
    <StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ScytheAnimation">
				<States>
					<State name="Before" />
					<State name="Idle" />
				</States>
				<Transitions>
					<Transition from="Before" to="Idle">
						<Condition>
							<IsAnimationFinished>a_hell_before</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_gacor_projectile</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_gacor_destroy_impact</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-300</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_pet_fireball</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_pet_tornado</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0,1,1</KeyFrame>
            <KeyFrame>1,2,2</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
        <Emitter>
          <Random name="offset" min="-20, -30" max="20, -70" />
          <Random name="emissionInterval" min="0.28" max="0.56" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.8" max="1.4" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">16,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit_fire</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">-16,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit_fire</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">60</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_mist</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
			<KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_snowflakes</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
				<Emitter>
          <Random name="offset" min="-300, -150" max="110, 30" />
					<Random name="emissionInterval" min="0.010" max="0.02" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakes</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    				<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.7" max="1.8" />
					<Set name="lifeTime">1.5</Set>
					<Random name="initialVelocity" min="-20, 40" max="30, 60" />
					<Random name="initialAngle" min="0" max="-360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
	<RenderOptions>
		<Default>
			<Set name="ShouldHover">true</Set>
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">false</Set>
			<Set name="IncludeAllActions">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>
			<Set name="RenderBackArmBuild">false</Set>
			<Set name="RenderFrontArmInfected">true</Set>
			<Set name="RenderBackArmInfected">true</Set>
			<Set name="UserNameOffset">15</Set>
			<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
		</Default>
	</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-160</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Jump">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-210</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Fall">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-135</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="s_punch_eff" offset="10,-10" alignment="CENTER" rotateOffset="true" rotateToTarget="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="2,2" onAction="PUNCH" />
			<SpriteRender name="s_pet" offset="0,-330" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle" />
		</RenderInFront>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
            <Group onState="ScytheAnimation.Before">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_scythe" offset="65,133" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="2.6,2.6" />
            </Group>
			<Group onState="ScytheAnimation.Idle">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_scythe" offset="65,133" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="2.6,2.6" />
			</Group>
		</RenderBackHandItem>

		
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <StateMachines>
      <StateMachine name="playerState">
        <States>
          <State name="Equip"/>
          <State name="Fall"/>
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition from="Equip" to="Fall" >
            <Condition>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Fall" to="Equip">
            <Condition>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Equip|Fall" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Equip">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Fall">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="trailParticleState">
        <States>
          <State name="Equip"/>
          <State name="HorizontalMove"/>
          <State name="Punch"/>
          <State name="Sleep"/>
        </States>
        <Transitions>
          <Transition from="Equip|HorizontalMove|Punch" to="Sleep" >
            <Condition>
              <IsSleepingOnaBed>true</IsSleepingOnaBed>
            </Condition>
          </Transition>
          <Transition from="Equip|HorizontalMove|Sleep" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch|HorizontalMove|Sleep" to="Equip">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Punch|Equip|Sleep" to="HorizontalMove">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Facing">
        <States>
          <State name="Left" />
          <State name="Right" />
        </States>
        <Transitions>
          <Transition to="Left" from="Right">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition to="Right" from="Left">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="ScytheAnimation">
        <States>
          <State name="Before" />
          <State name="Idle" />
        </States>
        <Transitions>
          <Transition from="Before" to="Idle">
            <Condition>
              <IsAnimationFinished>a_buddha_earth_before</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <!-- scy0 -->
    <Sprite name="equip_sprite" fileName="game/UGCSpritesheet93v0.rttex" textureSize="192,192" frame="0,0" />
    <!-- sw1 -->
    <Sprite name="slash_sprite" fileName="game/UGCSpritesheet93v1.rttex" textureSize="64"/>
    <Sprite name="s_raygun_smoke" fileName="game/UGCSpritesheet93v1.rttex" textureSize="64"/>
    <Sprite name="s_ProjectileIni" fileName="game/UGCSpritesheet93v1.rttex" textureSize="64"/>

    <!-- slash_godly2 -->
    <Sprite name="punch_projectile_sprite" fileName="game/UGCSpritesheet93v2.rttex" textureSize="240,142"/>
    <Sprite name="s_meledakDuar" fileName="game/UGCSpritesheet93v2.rttex" textureSize="240,142"/>
    <Sprite name="s_buddha_fire" fileName="game/UGCSpritesheet93v2.rttex" textureSize="240,142"/>

    <!--particles3  -->
    <Sprite name="particle_1" fileName="game/UGCSpritesheet93v3.rttex" textureSize="32" frame="1,0"/>
    <Sprite name="s_debu" fileName="game/UGCSpritesheet93v3.rttex" textureSize="32" frame="10,0" />
    <Sprite name="s_debuWinter" fileName="game/UGCSpritesheet93v3.rttex" textureSize="32" frame="0,0"/>
    <Sprite name="s_flameHit" fileName="game/UGCSpritesheet93v3.rttex" textureSize="32" frame="0,2" />
    <Sprite name="s_flameCurve" fileName="game/UGCSpritesheet93v3.rttex" textureSize="32" frame="20,0" />

    <!-- remove=error so dont touch this
         -vow :)
    -->
    <Sprite name="s_buddha" fileName="game/itemsLikeThisDMVOW.rttex" textureSize="64"/>


    <Animations>
      <SpriteAnimation name="a_hit_fire" sprite="s_flameHit" animTime="400" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>8,0</Frame>
        <Frame>9,0</Frame>
        <Frame>10,0</Frame>
        <Frame>11,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_snowflakes" sprite="s_debuWinter">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_raps_equip" playOnState="playerState.Equip|playerState.Fall|playerState.Punch" sprite="equip_sprite" animTime="400" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <!-- <Frame>3,0</Frame> -->
        <!-- <Frame>4,0</Frame> -->
      </SpriteAnimation>
      <SpriteAnimation name="a_raps_p" playOnState="playerState.Punch" sprite="punch_projectile_sprite" animTime="400" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="slash_animation" sprite="slash_sprite" animTime="175" isLoop="true" playOnState="playerState.Punch">
        <Frame>0,8</Frame>
        <Frame>8,8</Frame>
        <Frame>2,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="particle_animation" sprite="particle_1" animTime="500" isLoop="true">
        <!-- <Frame>1,0</Frame> -->
        <Frame>20,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_earth_before" sprite="s_buddha" autoPlay="true" animTime="800" playerState="ScytheAnimation.Before">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
        <Frame>4,1</Frame>
        <Frame>5,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_earth_after" sprite="s_buddha" animTime="600" isLoop="true" playOnState="ScytheAnimation.Idle">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_punch" sprite="s_buddha" animTime="400" isLoop="true" playOnAction="PUNCH">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
        <Frame>4,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_gacor_projectile" sprite="s_ProjectileIni" animTime="300" isLoop="false">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_gacor_destroy_impact" sprite="s_meledakDuar" animTime="400" isLoop="false">
        <Frame>0,3</Frame>
        <Frame>1,3</Frame>
        <Frame>0,5</Frame>
        <Frame>1,5</Frame>
        <Frame>2,5</Frame>
        <Frame>3,5</Frame>
        <Frame>4,5</Frame>
        <Frame>5,5</Frame>
        <Frame>6,5</Frame>
        <Frame>7,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_pet_fireball" sprite="s_buddha_fire" animTime="400" isLoop="true">
        <Frame>0,6</Frame>
        <Frame>1,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_earth" sprite="s_raygun_smoke" animTime="800" isLoop="false">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="UserNameOffset">15</Set>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
      </Default>
    </RenderOptions>
    <ParticleSystems>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileIni</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Random name="finalScale" min="2" max="4"/>
          <Set name="interpolateScale">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_meledakDuar</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-300</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_buddha_fire</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <!-- <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_raygun_smoke</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.8</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem> -->
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_raygun_smoke</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,10,10</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
            <KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <!-- <Set name="sprite">s_debuWinter</Set> -->
          <Set name="sprite">s_flameHit</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_crack">
        <Emitter>
          <Set name="offset">-20, -16</Set>
          <Set name="emissionInterval">0.15</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">particle_1</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Set name="relativeToEmitter">true</Set>
          <Random name="initialAngle" min="190" max="-190" />
          <Set name="initialScale">0.68,0.68</Set>
          <Random name="offset" min="-2,-7" max="2,7" />
          <Set name="lifeTime">0.3</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="equip_sprite" offset="17,20" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" drawShadow="true" onState="playerState.Equip|playerState.Fall|playerState.Punch" />
    </RenderBackHandItem>
    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="punch_projectile_sprite" offset="50,-55" alignment="CENTER" rotateOffset="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="1,1" onAction="PUNCH" />
      <SpriteRender name="slash_sprite" offset="12,-20" scale="1.25,1.25" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="playerState.Punch" drawShadow="false" tintOverride="255,255,255,255"/>
      <SpriteRender name="s_buddha" offset="0,-360" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle" />
    </RenderInFront>
    <AddClothingParticles>
      <StopIf type="or">
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <ParticleSystemUpdate name="ps_crack"/>
    </AddClothingParticles>
    <OnPunchStart>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <ParticleSystemUpdate name="ps_gacorProjectile"/>
      <ParticleSystemUpdate name="ps_petFireball"/>
    </OnPunchStart>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1200</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_crack"/>
    </SwitchOffClothingParticles>
    <RenderFrontpack>
      <ParticleSystemRender name="ps_crack" />
    </RenderFrontpack>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Mobility">
				<States>
					<State name="OnGround"/>
					<State name="InAir"/>
				</States>
				<Transitions>
					<Transition to="OnGround" from="InAir">
						<Condition>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="InAir" from="OnGround">
						<Condition>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="s_jetpack" fileName="game/UGCSpritesheet94v0.rttex" textureSize="64" frame="0,0"/>
		<Sprite name="s_strap" fileName="game/UGCSpritesheet94v1.rttex" textureSize="32" frame="0,0"/>
		<Sprite name="s_particle" fileName="game/UGCSpritesheet94v1.rttex" textureSize="32" frame="1,0"/>
		<Sprite name="jumpeffect" fileName="game/UGCSpritesheet94v0.rttex" textureSize="64" frame="1,0"/>
		
		<ParticleSystems>
			<ParticleSystem name="JuiceDrop1" updateStage="AddClothingParticles" renderStage="RenderBackpack">
				<Emitter>
					<Set name="offset">-15, 8</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_particle</Set>
					<Random name="offset" min="-5, 0" max="5, 0"/>
					<Set name="inSpecificOrder">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1.0, 1.0</Set>
					<Set name="lifeTime">1</Set>
					<Random name="initialVelocity" min="10, 10" max="-10, 30"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="double_jump_particle">
				<Emitter>
					<Set name="offset">-16,42</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">jumpeffect</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="finalScale">3.5, 3.5</Set>
					<Set name="initaaqialVelocity">2,2</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="ShouldHover">false</Set>
				<Set name="HideParticlesOnTheaterSeat">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="FootPosition" onState="Mobility.OnGround">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<ParticleSystemUpdate name="double_jump_particle" onAction="JUMPDOUBLE" drawShadow="false"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="double_jump_particle"/>
		</SwitchOffClothingParticles>
		<RenderFrontpack>
			<SpriteRender name="s_strap" offset="0,0" alignment="DOWN_CENTER"/>
		</RenderFrontpack>
		<RenderBackpack>
			<SpriteRender name="s_jetpack" offset="-15,19" scale="1.9,1.9" alignment="DOWN_CENTER"/>
		</RenderBackpack>
		<ParticleSystemRender>
			<ParticleSystemRenderer name="double_jump_particle" onAction="JUMPDOUBLE" drawShadow="false"/>
		</ParticleSystemRender>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
