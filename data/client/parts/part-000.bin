			</SpriteAnimation>
			<SpriteAnimation name="a_land_foot2_punch_anim" sprite="s_land_foot2" animTime="1200" isLoop="true" playOnState="Land.Punch">
				<Frame>0, 5</Frame>
				<Frame>1, 5</Frame>
				<Frame>2, 5</Frame>
