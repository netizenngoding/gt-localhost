			</SpriteAnimation>
			<SpriteAnimation name="a_trail_Sprites" autoPlay="false" sprite="s_trail_sprite">
				<Frame>22,17</Frame>
				<Frame>23,17</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punch_laser_Sprites" autoPlay="false" sprite="s_punch_laser_sprite" animTime="200" isLoop="true" playOnState="Land.Punch">
				<Frame>18,17</Frame>
				<Frame>19,17</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="ps_trail">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.033</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="offset">-28,-7</Set>
					<Set name="lifeTime">0.06</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_trail_sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">0,0</Set>
					<Random name="offset" min="-10,-8" max="10,8"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5,0.5</KeyFrame>
						<KeyFrame>1, 3,3</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_punch">
				<Emitter attachment="contextRotation">
					<Set name="offset">14,11</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch_laser_sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
					<Set name="relativeToEmitter">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_death">
				<Emitter>
					<Set name="offset">14,13</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch_laser_sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_SpawnParticleR1">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_spawn_foot1</Set>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="lifeTime">0.6</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_SpawnParticleR2">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_spawn_foot2</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<Set name="lifeTime">0.6</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_SpawnParticleL1">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_spawn_foot2</Set>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_SpawnParticleL2">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_spawn_foot1</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_DeathParticleR1">
				<Emitter>
					<Set name="offset">0,-16</Set>
					<Set name="lifeTime">2</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_dead_foot1</Set>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="lifeTime">0.6</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_DeathParticleR2">
				<Emitter>
					<Set name="offset">0,-16</Set>
					<Set name="lifeTime">2</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_dead_foot2</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<Set name="lifeTime">0.6</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_DeathParticleL1">
				<Emitter>
					<Set name="offset">0,-16</Set>
					<Set name="lifeTime">2</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_dead_foot2</Set>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_DeathParticleL2">
				<Emitter>
					<Set name="offset">0,-16</Set>
					<Set name="lifeTime">2</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_dead_foot1</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">SHOES</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="IsSurfboard">true</Set>
				<Set name="IsVehicle">false</Set>
				<Set name="IsRidingBird">false</Set>
				<Set name="ClothingOffsetFromShoes">-20</Set>
				<Set name="UserNameOffset">24</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">false</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">false</Set>
				<Set name="AllowChangePunchType">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">false</Set>
				<Set name="HasDeathParticles">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">45</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemUpdate name="ps_trail" onState="trailParticleState.Move"/>
			
		</RenderShoes>
		<RenderInFront value="playerCenter">
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Group onState="Health.Alive">
				<Group onState="Swim.No">
					<SpriteRender name="s_land_foot1" offset="-0,-12" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
					<SpriteRender name="s_land_foot2" offset="-0,-12" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
				</Group>
				<Group onState="Swim.Yes">
					<SpriteRender name="s_water_foot1" offset="-0,-12" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
					<SpriteRender name="s_water_foot2" offset="-0,-12" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
				</Group>
				<StopIf>
					<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				</StopIf>
				<SpriteRender name="s_plasma_sprite" offset="14,7" onState="Punch.Yes" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0"/>
			</Group>
			<Group onState="Health.SpawnR">
				<ParticleSystemUpdate name="p_SpawnParticleR1"/>
				<ParticleSystemUpdate name="p_SpawnParticleR2"/>
			</Group>
			<Group onState="Health.SpawnL">
				<ParticleSystemUpdate name="p_SpawnParticleL1"/>
				<ParticleSystemUpdate name="p_SpawnParticleL2"/>
			</Group>
		</RenderInFront>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnPunchStart>
			<ParticleSystemUpdate name="p_punch"/>
		</OnPunchStart>
		<OnKilled>
			<ParticleSystemUpdate name="p_DeathParticleL1" onState="Facing.Left"/>
			<ParticleSystemUpdate name="p_DeathParticleL2" onState="Facing.Left"/>
			<ParticleSystemUpdate name="p_DeathParticleR1" onState="Facing.Right"/>
			<ParticleSystemUpdate name="p_DeathParticleR2" onState="Facing.Right"/>
		</OnKilled>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_chair" fileName="game/particles_large15.rttex" textureSize="64" frame="13,0" />
		<Sprite name="s_backLayer" fileName="game/particles_large15.rttex" textureSize="64" frame="15,1" />
		<Sprite name="s_backLayer_hair" fileName="game/particles_large15.rttex" textureSize="64" frame="15,0" />
		<Sprite name="s_frontLayer" fileName="game/particles_large15.rttex" textureSize="64" frame="14,1" />
		<Sprite name="s_frontLayer_hair" fileName="game/particles_large15.rttex" textureSize="64" frame="14,0" />
		<Sprite name="s_legs" fileName="game/player_sit.rttex" textureSize="32" frame="1,0" />		
		<Animations>
			<SpriteAnimation name="a_backLayer_idle" sprite="s_backLayer" animTime="200" isLoop="true" playOnState="Motion.Idle">
				<Frame>15,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer_idle" sprite="s_frontLayer" animTime="200" isLoop="true" playOnState="Motion.Idle">
				<Frame>14,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_backLayer_hair_idle" sprite="s_backLayer_hair" animTime="200" isLoop="true" playOnState="Action.None">
				<Frame>15,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer_hair_idle" sprite="s_frontLayer_hair" animTime="200" isLoop="true" playOnState="Action.None">
				<Frame>14,0</Frame>
			</SpriteAnimation>
			
			<SpriteAnimation name="a_backLayer_move" sprite="s_backLayer" animTime="200" isLoop="true" playOnState="Motion.Move">
				<Frame>11,11</Frame>
				<Frame>11,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer_move" sprite="s_frontLayer" animTime="200" isLoop="true" playOnState="Motion.Move">
				<Frame>9,11</Frame>
				<Frame>9,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_backLayer_hair_move" sprite="s_backLayer_hair" animTime="200" isLoop="true" playOnState="Action.Move">
				<Frame>10,11</Frame>
				<Frame>10,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer_hair_move" sprite="s_frontLayer_hair" animTime="200" isLoop="true" playOnState="Action.Move">
				<Frame>8,11</Frame>
				<Frame>8,15</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="a_backLayer_jump" sprite="s_backLayer" animTime="200" isLoop="true" playOnState="Motion.Jump">
				<Frame>15,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer_jump" sprite="s_frontLayer" animTime="200" isLoop="true" playOnState="Motion.Jump">
				<Frame>14,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_backLayer_hair_jump" sprite="s_backLayer_hair" animTime="200" isLoop="true" playOnState="Action.Jump">
				<Frame>15,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer_hair_jump" sprite="s_frontLayer_hair" animTime="200" isLoop="true" playOnState="Action.Jump">
				<Frame>14,2</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="a_backLayer_fall" sprite="s_backLayer" animTime="200" isLoop="true" playOnState="Motion.Fall">
				<Frame>12,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer_fall" sprite="s_frontLayer" animTime="200" isLoop="true" playOnState="Motion.Fall">
				<Frame>11,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_backLayer_hair_fall" sprite="s_backLayer_hair" animTime="200" isLoop="true" playOnState="Action.Fall">
				<Frame>12,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer_hair_fall" sprite="s_frontLayer_hair" animTime="200" isLoop="true" playOnState="Action.Fall">
				<Frame>11,7</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="a_backLayer_hair_punch" sprite="s_backLayer_hair" animTime="200" isLoop="true" playOnState="Action.Punch">
				<Frame>14,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer_hair_punch" sprite="s_frontLayer_hair" animTime="200" isLoop="true" playOnState="Action.Punch">
				<Frame>13,7</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Move|Jump|Fall">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Move|Jump|Fall">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|None|Punch">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="None|Move|Punch">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|None|Move|Punch">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="ClothingOffsetFromShoes">-9</Set>
				<Set name="UserNameOffset">12</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<Group onState="Motion.Move">
				<AvatarTransform class="ArmAngle" onState="Action.None|Action.Move">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Action.None|Action.Move">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
			</Group>
		</Update>
		<RenderBehind value="playerCenter">
			<Group>
				<StopIf>
					<IsVariableBool name="isMannequin">false</IsVariableBool>
				</StopIf>
				<Translate>0,-9,0</Translate>
				<SpriteRender name="s_backLayer" offset="3,-23" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>
				<SpriteRender name="s_backLayer_hair" drawShadow="false" offset="3,-23" blend="PREMULTIPLIED_ALPHA"/>
				<SpriteRender name="s_chair" offset="1,-9" blend="PREMULTIPLIED_ALPHA"/>
			</Group>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
			</StopIf>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_backLayer" offset="3,-23" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>
			<SpriteRender name="s_backLayer_hair" drawShadow="false" offset="3,-23" blend="PREMULTIPLIED_ALPHA"/>
			<SpriteRender name="s_chair" offset="1,-9" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBehind>
		<RenderShoes>
			<SpriteRender name="s_legs" offset="1,-7" tintOverride="SKINORPANTS" />
		</RenderShoes>
		<RenderInFront>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_frontLayer" offset="3,-23" tintOverride="SKIN"/>
			<SpriteRender name="s_frontLayer_hair" drawShadow="false" offset="3,-23" blend="PREMULTIPLIED_ALPHA"/>
		</RenderInFront>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1500</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_backClaw" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="3,11"/>
    <Sprite name="s_frontClaw" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="2,11"/>
    <Sprite name="s_aura" fileName="game/particles_large18.rttex" textureSize="64" frame="11,15"/>
    <Sprite name="s_speed_lines" fileName="game/particles12.rttex" textureSize="32" frame="8,22"/>
    <Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32,32" frame="2,22" />
    <Sprite name="s_chunks" fileName="game/particles12.rttex" textureSize="32,32" frame="5,22" />

    <Animations>
      <SpriteAnimation name="a_speed_lines" autoPlay="false" sprite="s_speed_lines">
        <Frame>8,22</Frame>
        <Frame>9,22</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_slash" autoPlay="false" sprite="s_slash">
        <Frame>2,22</Frame>
        <Frame>3,22</Frame>
        <Frame>4,22</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_chunks" autoPlay="false" sprite="s_chunks">
        <Frame>5,22</Frame>
        <Frame>6,22</Frame>
        <Frame>7,22</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_Aura" updateStage="AddClothingParticles" renderStage="RenderHandItem">
        <Emitter>
          <Set name="offset">0, -12</Set>
          <Set name="emissionInterval">0.15</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_aura</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-3, 3" max="0, 0" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.4, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 1, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <Set name="initialVelocity">0, -100</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_SpeedLines" updateStage="AddClothingParticles" renderStage="RenderHandItem">
        <Emitter>
          <Set name="offset">0, -10</Set>
          <Set name="offsetFacing">false</Set>
          <Random name="emissionInterval" min="0.15" max="0.25" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle  randomSpriteFrame="true">
          <Set name="sprite">s_speed_lines</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Random name="offset" min="-8, 0" max="8, 0" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 1,2</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <Random name="initialVelocity" min="0, -50" max="0, -80" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_slash" updateStage="OnPunchUpdate">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="lifeTime">0.3</Set>
          <Set name="sprite">s_slash</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Random name="offset" min="-8,-8" max="8,8"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tile_fx">
        <Emitter>
          <Set name="lifeTime">2</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="offset">0,0</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_chunks</Set>
          <RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200"/>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <Set name="initialScale">1,1</Set>
          <Random name="finalScale" min="0.1" max="0.4"/>
          <Set name="interpolateScale">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360"/>
          <Random name="offset" min="0,0" max="16,16"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, 360</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 180</KeyFrame>
          <KeyFrame>1, 540</KeyFrame>
        </Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <Update type="or">
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <StopIf>
        <IsAction>PUNCH</IsAction>
        <IsVariableBool name="onGround">false</IsVariableBool>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">45</Set>
      </AvatarTransform>
      <StopIf type="or">
        <IsAction>BUILD</IsAction>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
    </Update>
    <RenderHandItem>
      <SpriteRender name="s_frontClaw" offset="0,1" rotateOffset="true" rotationPoint="0,1" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" drawShadow="true" />
    </RenderHandItem>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_backClaw" offset="-4,6" rotateOffset="true" rotationPoint="1,1" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" drawShadow="true" />
    </RenderBackHandItem>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_tile_fx"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_tile_fx"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_BIOLOGICAL_BLADE">
    <Data>
      <Sprite name="s_FrontArm" fileName="game/particles_large11.rttex" textureSize="64" frame="13,13"/>
      <Sprite name="s_PunchSlash" fileName="game/particles_large11.rttex" textureSize="64" frame="15,11"/>

      <StateMachines>
        <StateMachine name="Punch">
          <States>
            <State name="True"/>
            <State name="False"/>
          </States>
          <Transitions>
            <Transition from="False" to="True">
              <Condition type="and">
                <IsAction>PUNCH</IsAction>
                <IsZombified>false</IsZombified>
              </Condition>
            </Transition>
            <Transition from="True" to="False">
              <Condition>
                <IsAction operatorType="NotEqual">PUNCH</IsAction>
              </Condition>
            </Transition>
          </Transitions>
        </StateMachine>
      </StateMachines>

      <Animations>
        <SpriteAnimation name="a_PunchArm" sprite="s_FrontArm" animTime="700" isLoop="true" playOnState="Punch.False">
          <Frame>13,13</Frame>
          <Frame>14,13</Frame>
          <Frame>15,13</Frame>
          <Frame>8,13</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_NonPunchArm" sprite="s_FrontArm" animTime="100" isLoop="true" playOnState="Punch.True">
          <Frame>15,10</Frame>
        </SpriteAnimation>
      </Animations>

      <RenderOptions>
        <Default>
          <Set name="PunchSoundOverride">HAND</Set>
          <Set name="PlayDefaultPunchAudio">false</Set>
          <Set name="DefaultRenderMannequinHandItem">false</Set>
          <Set name="RenderFrontArmInfected">true</Set>
        </Default>
      </RenderOptions>

      <TileStampData>
        <Set name="FileName">game/particles11.rttex</Set>
        <Set name="EndFrame">17,23</Set>
        <Set name="FrameCount">4</Set>
      </TileStampData>
    
  <ParticleSystems>
			<ParticleSystem name="slash_particle">
				<Emitter>
					<Set name="offset">0,-16</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_PunchSlash</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
    </Data>

    <RenderRules>
      <RenderHandItem>
        <SpriteRender name="s_FrontArm" offset="0,0" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
      </RenderHandItem>
      <OnPunchStart>
        <ParticleSystemUpdate name="slash_particle"/>
      </OnPunchStart>
      <OnPunchUpdate>
        <StopIf>
          <IsZombified>true</IsZombified>
        </StopIf>
        <AvatarTransform class="Emotion">
          <Set name="emotion">ANGRY</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="armAngle">1200</Set>
          <Set name="isAdditive">true</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm1Angle</Set>
          <Set name="armAngle">0</Set>
        </AvatarTransform>
      </OnPunchUpdate>
    </RenderRules>
  </ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_brain" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="18,18"/>
    <Sprite name="s_punchStart" fileName="game/particles12.rttex" textureSize="32" frame="8,12"/>
    <Sprite name="s_punchContinue" fileName="game/particles12.rttex" textureSize="32" frame="8,13"/>
    <Sprite name="s_punchEnd" fileName="game/particles12.rttex" textureSize="32" frame="8,12"/>
    <Sprite name="s_projectile" fileName="game/particles11.rttex" textureSize="32" frame="10,23"/>

    <Animations>
      <SpriteAnimation name="a_brainNonPunch" sprite="s_brain" animTime="2600" isLoop="true" playOnState="Punch.False">
        <Frame>0,4</Frame>
        <Frame>1,4</Frame>
        <Frame>2,4</Frame>
        <Frame>3,4</Frame>
        <Frame>4,4</Frame>
        <Frame>5,4</Frame>
        <Frame>6,4</Frame>
        <Frame>7,4</Frame>
        <Frame>8,4</Frame>
        <Frame>9,4</Frame>
        <Frame>10,4</Frame>
        <Frame>11,4</Frame>
        <Frame>12,4</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_brainPunch" sprite="s_brain" animTime="1300" isLoop="true" playOnState="Punch.True">
	      <Frame>0,5</Frame>
	      <Frame>1,5</Frame>
	      <Frame>2,5</Frame>
	      <Frame>3,5</Frame>
	      <Frame>4,5</Frame>
	      <Frame>5,5</Frame>
	      <Frame>6,5</Frame>
	      <Frame>7,5</Frame>
	      <Frame>8,5</Frame>
	      <Frame>9,5</Frame>
	      <Frame>10,5</Frame>
	      <Frame>11,5</Frame>
	      <Frame>12,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchContinue" sprite="s_punchContinue" animTime="500" isLoop="true" playOnState="PunchAnim.Continue">
        <Frame>8,13</Frame>
        <Frame>9,13</Frame>
        <Frame>10,13</Frame>
        <Frame>11,13</Frame>
        <Frame>12,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchEnd" sprite="s_punchEnd" animTime="500" playOnState="PunchAnim.End">
        <Frame>8,12</Frame>
        <Frame>12,12</Frame>
        <Frame>11,12</Frame>
        <Frame>10,12</Frame>
        <Frame>9,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchStart" sprite="s_punchStart" animTime="500" playOnState="PunchAnim.Start">
        <Frame>12,12</Frame>
        <Frame>8,12</Frame>
        <Frame>9,12</Frame>
        <Frame>10,12</Frame>
        <Frame>11,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_projectile" sprite="s_projectile">
        <Frame>10,23</Frame>
        <Frame>11,23</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="PunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start"/>
          <State name="Continue"/>
          <State name="End"/>
        </States>
        <Transitions>
          <Transition from="Off|End" to="Start">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsAnimationFinished>a_punchStart</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="Continue|Start" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAnimationFinished>a_punchEnd</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>


    <ParticleSystems>
      <ParticleSystem name="punch_start_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-64</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchStart</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">1.5,1.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_continue_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-64</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="delayTimer">0.24</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchContinue</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="initialScale">1.5,1.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_end_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-64</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchEnd</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">1.5,1.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchProjectile" updateStage="OnDamagedTile" updateState="Punch.True">
        <Emitter>
          <Random name="emissionInterval" min="0.1" max="0.2" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="useTargetTileColorForTint">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="initialVelocity">0,-220</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-10, -8" max="10, 8" />
          <Random name="initialRotationRate" min="50" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <Update>
      <ParticleSystemUpdate name="punch_continue_particle" />
    </Update>
    <OnPunchBegin>
      <ParticleSystemOff name="punch_continue_particle" />
      <ParticleSystemOff name="punch_end_particle" />
      <ParticleSystemUpdate name="punch_start_particle" />
    </OnPunchBegin>
    <OnPunchStop>
      <ParticleSystemOff name="punch_continue_particle" />
      <ParticleSystemOff name="punch_start_particle" />
      <ParticleSystemUpdate name="punch_end_particle" />
    </OnPunchStop>
    <RenderHair>
      <SpriteRender name="s_brain" alignment="DOWN_CENTER" offset="0,-16"/>
    </RenderHair>
    <RenderInFront>
      <ParticleSystemRender name="punch_start_particle" onState="PunchAnim.Start" />
      <ParticleSystemRender name="punch_continue_particle" onState="PunchAnim.Continue" />
      <ParticleSystemRender name="punch_end_particle" onState="PunchAnim.End" />
    </RenderInFront>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="ColorWingSprite" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="27,2" />
		<Sprite name="ShardsSprite" fileName="game/particles12.rttex" textureSize="32" frame="11,11" />
		<Sprite name="SmokeSprite" fileName="game/particles12.rttex" textureSize="32" frame="13,11" />
		<Sprite name="TrailSprite" fileName="game/particles12.rttex" textureSize="32" frame="10,11" />
		<Sprite name="WingSprite" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="19,2" />
		<StateMachines>
			<StateMachine name="FallState">
				<States>
					<State name="Fall" />
					<State name="NotFall" />
				</States>
				<Transitions>
					<Transition from="Fall" to="NotFall">
						<Condition>
							<IsVariableFloat name="speed.y" operator="LessOrEqual">0</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="NotFall" to="Fall">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="IdleState">
				<States>
					<State name="Idle" />
					<State name="NotIdle" />
				</States>
				<Transitions>
					<Transition from="Idle" to="NotIdle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="NotIdle" to="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteCurveAnimation name="randomPosAnim" sprite="ColorWingSprite" autoPlay="true" isLoop="true" animTime="1000">
				<Curve name="pos">
					<KeyFrame>0.f, 1.5f, 1.5f</KeyFrame>
					<KeyFrame>0.2f, 1.5f, 1.5f</KeyFrame>
					<KeyFrame>0.2f, -1.5f, -1.5f</KeyFrame>
					<KeyFrame>0.4f, -1.5f, -1.5f</KeyFrame>
					<KeyFrame>0.4f, 1.5f, -1.5f</KeyFrame>
					<KeyFrame>0.6f, 1.5f, -1.5f</KeyFrame>
					<KeyFrame>0.6f, -1.5f, 1.5f</KeyFrame>
					<KeyFrame>0.8f, -1.5f, 1.5f</KeyFrame>
					<KeyFrame>0.8f, 1.5f, -1.5f</KeyFrame>
					<KeyFrame>1.0f, 1.5f, -1.5f</KeyFrame>
					<KeyFrame>1.0f, 1.5f, 1.5f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SequenceAnimation name="glitch_sequence" autoPlay="true" isLoop="true">
				<SpriteAnimation sprite="WingSprite">
					<Frame>19,2</Frame>
				</SpriteAnimation>
				<DelayAnimation delayTime="1000" />
				<SpriteAnimation sprite="WingSprite" animTime="200">
					<Frame>20,2</Frame>
					<Frame>21,2</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="WingSprite">
					<Frame>19,2</Frame>
				</SpriteAnimation>
				<DelayAnimation delayTime="500" />
				<SpriteAnimation sprite="WingSprite">
					<Frame>22,2</Frame>
				</SpriteAnimation>
				<DelayAnimation delayTime="100" />
			</SequenceAnimation>
			<SpriteAnimation name="ShardsAnimation" sprite="ShardsSprite" animTime="200">
				<Frame>11,11</Frame>
				<Frame>12,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="SmokeAnimation" sprite="SmokeSprite" animTime="800">
				<Frame>13,11</Frame>
				<Frame>14,11</Frame>
				<Frame>15,11</Frame>
				<Frame>16,11</Frame>
				<Frame>17,11</Frame>
				<Frame>18,11</Frame>
				<Frame>19,11</Frame>
				<Frame>20,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="multiColourAnim" sprite="ColorWingSprite" animTime="400" autoPlay="true" isLoop="true">
				<Frame>27,2</Frame>
				<Frame>28,2</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="LeftWingAnimatedSmokeStatic">
				<Emitter>
					<Set name="offset">-22, -15</Set>
					<Set name="emissionInterval">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">SmokeSprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="LeftWingShards">
				<Emitter>
					<Set name="offset">-20, -20</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">ShardsSprite</Set>
					<Set name="relativeToEmitter">false</Set>
					<Random name="offset" min="-7, -4" max="7, 4" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5, 0.5</Set>
					<Set name="lifeTime">0.75</Set>
					<Set name="initialVelocity">0, 20</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="LeftWingStaticSmoke">
				<Emitter>
					<Set name="offset">-20, -10</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">TrailSprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.5, 0.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.2</Set>
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="LeftWingTrailSmoke">
				<Emitter>
					<Set name="offset">-20, -15</Set>
					<Set name="emissionInterval">0.025</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle angleRelativeToPlayerSpeed="true">
					<Set name="sprite">TrailSprite</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.3, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1, 0.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="RightWingAnimatedSmokeStatic">
				<Emitter>
					<Set name="offset">22, -15</Set>
					<Set name="emissionInterval">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">SmokeSprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="RightWingShards">
				<Emitter>
					<Set name="offset">20, -20</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">ShardsSprite</Set>
					<Set name="relativeToEmitter">false</Set>
					<Random name="offset" min="-7, -4" max="7, 4" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5, 0.5</Set>
					<Set name="lifeTime">0.75</Set>
					<Set name="initialVelocity">0, 20</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="RightWingStaticSmoke">
				<Emitter>
					<Set name="offset">20, -10</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">TrailSprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.5, 0.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.2</Set>
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="RightWingTrailSmoke">
				<Emitter>
					<Set name="offset">20, -15</Set>
					<Set name="emissionInterval">0.025</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle angleRelativeToPlayerSpeed="true">
					<Set name="sprite">TrailSprite</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.3, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1, 0.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="HideParticlesOnTransform">true</Set>
				<Set name="HideParticlesOnTheaterSeat">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
	<OnDrawCustomOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">getCurrent</Set>
        <Set name="brightness">getCurrent</Set>
        <Set name="contrast">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">getCurrent</Set>
      </AvatarTransform>
		<AvatarTransform class="RenderData">
			<Set name="saturation">1.5</Set>
			<Set name="brightness">0.8</Set>
			<Set name="contrast">0.15</Set>
		</AvatarTransform>
		<ContextUpdate type="SetTintFromSlot">
			<Set name="slot">BACKPACK</Set>
			<Set name="seedFG">false</Set>
		</ContextUpdate>
		<AvatarOutline startScale="1,1" endScale="1.1,1.1" duration="1500" contextColor="true">
			<Colours />
		</AvatarOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">reset</Set>
        <Set name="brightness">reset</Set>
        <Set name="contrast">reset</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">reset</Set>
      </AvatarTransform>
    </OnDrawCustomOutline>
    <RenderBackpack>
			<SpriteRender name="ColorWingSprite" offset="-4,-16" alignmentLeft="LEFT_CENTER" drawShadow="false" alignmentRight="RIGHT_CENTER" />
			<SpriteRender name="ColorWingSprite" offset="4,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" drawShadow="false" alignmentRight="LEFT_CENTER" />
			<SpriteRender name="WingSprite" offset="-4,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" />
			<SpriteRender name="WingSprite" offset="4,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" />
		</RenderBackpack>
		<AddClothingParticles>
			<ParticleSystemUpdate name="LeftWingTrailSmoke" onState="IdleState.NotIdle"/>
			<ParticleSystemUpdate name="RightWingTrailSmoke"  onState="IdleState.NotIdle"/>
			<ParticleSystemUpdate name="LeftWingShards" />
			<ParticleSystemUpdate name="RightWingShards" />
			<ParticleSystemUpdate name="LeftWingStaticSmoke" onState="IdleState.Idle" />
			<ParticleSystemUpdate name="RightWingStaticSmoke" onState="IdleState.Idle" />
			<ParticleSystemUpdate name="LeftWingAnimatedSmokeStatic" />
			<ParticleSystemUpdate name="RightWingAnimatedSmokeStatic" />
		</AddClothingParticles>
		<RenderBehind>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="LeftWingTrailSmoke" />
			<ParticleSystemRender name="RightWingTrailSmoke" />
			<ParticleSystemRender name="LeftWingStaticSmoke" />
			<ParticleSystemRender name="RightWingStaticSmoke" />
			<ParticleSystemRender name="LeftWingAnimatedSmokeStatic" />
			<ParticleSystemRender name="RightWingAnimatedSmokeStatic" />
			<ParticleSystemRender name="LeftWingShards" />
			<ParticleSystemRender name="RightWingShards" />
		</RenderBehind>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="RightWingAnimatedSmokeStatic" />
			<ParticleSystemOff name="LeftWingAnimatedSmokeStatic" />
			<ParticleSystemOff name="LeftWingTrailSmoke" />
			<ParticleSystemOff name="RightWingTrailSmoke" />
			<ParticleSystemOff name="LeftWingStaticSmoke" />
			<ParticleSystemOff name="RightWingStaticSmoke" />
			<ParticleSystemOff name="LeftWingShards" />
			<ParticleSystemOff name="RightWingShards" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_hatForeground" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="8,14"/>
    <Sprite name="s_Punch_aura" fileName="game/particles_large16.rttex" textureSize="64" frame="14,3"/>
    <Sprite name="s_Punch_speed_lines" fileName="game/particles12.rttex" textureSize="32" frame="30,9"/>
    <Sprite name="s_Jump_stars1" fileName="game/particles12.rttex" textureSize="32" frame="28,10"/>
    <Sprite name="s_Jump_stars2" fileName="game/particles12.rttex" textureSize="32" frame="29,10"/>
    <Sprite name="s_Jump_stars3" fileName="game/particles12.rttex" textureSize="32" frame="30,10"/>
    <Sprite name="s_Jump_stars4" fileName="game/particles12.rttex" textureSize="32" frame="31,10"/>
    <StateMachines>
	    <StateMachine name="Action">
		    <States>
			    <State name="None" />
			    <State name="Punch" />
		    </States>
		    <Transitions>
			    <Transition to="None" from="Punch">
				    <Condition>
					    <IsAction operatorType="NotEqual">PUNCH</IsAction>
				    </Condition>
			    </Transition>
			    <Transition to="Punch" from="None">
				    <Condition>
					    <IsAction>PUNCH</IsAction>
				    </Condition>
			    </Transition>
		    </Transitions>
	    </StateMachine>
	    <StateMachine name="DoDoubleJump">
		    <States>
			    <State name="No" />
			    <State name="Yes" ExitTime="0.1" />
		    </States>
		    <Transitions>
			    <Transition to="Yes" from="No">
				    <Condition>
					    <IsAction>JUMPDOUBLE</IsAction>
				    </Condition>
			    </Transition>
			    <Transition to="No" from="Yes" />
		    </Transitions>
	    </StateMachine>
    </StateMachines>
    <Animations>
	    <SpriteAnimation name="s_hatForeground_Anim" autoPlay="true" isLoop="true" sprite="s_hatForeground"  animTime="1000">
		    <Frame>19, 1</Frame>
		    <Frame>20, 1</Frame>
		    <Frame>21, 1</Frame>
		    <Frame>22, 1</Frame>
		    <Frame>23, 1</Frame>
		    <Frame>24, 1</Frame>
		    <Frame>25, 1</Frame>
		    <Frame>26, 1</Frame>
		    <Frame>27, 1</Frame>
		    <Frame>28, 1</Frame>
	    </SpriteAnimation>

	    <SpriteAnimation name="double_jump_particle_Sprite_frames"  autoPlay="false" isLoop="false" sprite="s_Jump_stars">
		    <Frame>28,10</Frame>
		    <Frame>29,10</Frame>
		    <Frame>30,10</Frame>
		    <Frame>31,10</Frame>
	    </SpriteAnimation>
	    <SpriteAnimation name="Punch_speed_lines_anim" autoPlay="false" sprite="s_Punch_speed_lines">
		    <Frame>30, 9</Frame>
		    <Frame>31, 9</Frame>
	    </SpriteAnimation>	    
		
    </Animations>
    <ParticleSystems>
		<ParticleSystem name="double_jump_particle" updateStage="AddClothingParticles" updateState="DoDoubleJump.Yes">
			<Emitter>
				<Set name="lifeTime">0.4</Set>
				<Set name="particlesPerEmission">12</Set>
				<Set name="particlesToEmit">1</Set>
