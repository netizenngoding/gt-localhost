			<SpriteAnimation name="a_pet_fireball" sprite="s_buddha_fire" animTime="400" isLoop="true">
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_buddha_earth" sprite="s_raygun_smoke" animTime="800" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
