				<Set name="armAngle">-90</Set>
			</AvatarTransform>
		</Update>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_BALLOON_BACKPACK">
	<Data>
		<StateMachines>
			<StateMachine name="Mobility">
				<States>
					<State name="OnGround"/>
					<State name="InAir"/>
				</States>
				<Transitions>
					<Transition to="OnGround" from="InAir">
						<Condition>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="InAir" from="OnGround">
						<Condition>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="Punch"/>
					<State name="Sleep"/>
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Sleep">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Sleep">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Sleep" from="None|Punch">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Sprite name="s_ballons" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="23,13"/>
		<Sprite name="s_ballons_pop" fileName="game/particles_large12.rttex" textureSize="64"/>
		
		<Animations>
			<CurveAnimationVec3 name="BalloonPosMove" autoPlay="true" isLoop="true" animTime="8000">
				<Curve name="BalloonPos">
          <KeyFrame>0, 0, 0,0</KeyFrame>
          <KeyFrame>0.25, -4, 0,0</KeyFrame>
          <KeyFrame>0.5, 0, 0,0</KeyFrame>
          <KeyFrame>0.75, 4, 0,0</KeyFrame>
          <KeyFrame>1, 0, 0,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>			
			<SpriteAnimation name="a_ballons_pop" sprite="s_ballons_pop" animTime="300">
				<Frame>0,13</Frame>
				<Frame>1,13</Frame>
				<Frame>2,13</Frame>
				<Frame>3,13</Frame>
				<Frame>4,13</Frame>
				<Frame>5,13</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="ps_balloon_pop" updateStage="OnKilled">
				<Emitter>
					<Set name="offset">0, -58</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_ballons_pop</Set>
					<Set name="lifeTime">0.25</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="BaloonOffset1">0,0,0</Set>
			<Set name="BaloonOffset2">0,0,0</Set>
      <Set name="BaloonOffset3">0,0,0</Set>
			<Set name="BaloonOffset">0, -16, 0</Set>
			<Set name="BalloonPos">0, 0, 0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="ShouldHover">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Action.None">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Action.None">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<AvatarTransform class="Face" onState="Action.None">
				<Set name="face">NORMAL</Set>
			</AvatarTransform>
			<AvatarTransform class="FootPosition" onState="Mobility.OnGround">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
		</Update>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsAction>DIE</IsAction>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
      <Translate>BalloonPos</Translate>
      
      <ArithmethicOperation LeftHandVariableName="BaloonOffset1" RightHandVariableName="-9,-45,0" OperationType="Set" />
      <ArithmethicOperation LeftHandVariableName="BaloonOffset2" RightHandVariableName="-1,-60,0" OperationType="Set" />
      <ArithmethicOperation LeftHandVariableName="BaloonOffset3" RightHandVariableName="7,-48,0" OperationType="Set" />
      
			<LineRender color="235,235,235,255" StartPointVariableName="BaloonOffset" EndPointVariableName="BaloonOffset1" />
			<LineRender color="235,235,235,255" StartPointVariableName="BaloonOffset" EndPointVariableName="BaloonOffset2" />
			<LineRender color="235,235,235,255" StartPointVariableName="BaloonOffset" EndPointVariableName="BaloonOffset3" />
			<SpriteRender name="s_ballons" offset="0,-44" alignment="DOWN_CENTER"/>
		</RenderBehind>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_cannon" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="7,7"/>
    <Sprite name="s_MuzzleFlash" fileName="game/particles12.rttex" textureSize="32" frame="0,18"/>
    <Sprite name="s_Projectile" fileName="game/particles12.rttex" textureSize="32" frame="1,18"/>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
      </Default>
    </RenderOptions>

    <ParticleSystems>
      <ParticleSystem name="MuzzleFlash" updateStage="RenderHandItem" updateState="Punch.True">
        <Emitter>
          <Set name="offset">38, 6</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_MuzzleFlash</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.15</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="Punch" updateStage="RenderHandItem" updateState="Punch.True">
        <Emitter>
          <Set name="offset">24, 6</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <TileStampData>
      <Set name="FileName">game/particles12.rttex</Set>
      <Set name="EndFrame">6,18</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>
  </Data>

  <RenderRules>
    <RenderHandItem>
      <SpriteRender name="s_cannon" offset="-4,8" useFixedRotation="true" fixedRotation="0" blend="PREMULTIPLIED_ALPHA"/>
    </RenderHandItem>
    <Update>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">30</Set>
      </AvatarTransform>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
    </Update>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
