    	<Sprite name="UCJUESTUDIO_6" fileName="game/particles11.rttex" textureSize="32,32" frame="17,13" />

		<Sprite name="UCJUESTUDIO_7" fileName="game/UGCSpritesheet107v2.rttex" textureSize="128" />

		<Animations>
			<SpriteAnimation name="UCJUESTUDIO_8" sprite="UCJUESTUDIO_2" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>1,1</Frame>
				<Frame>3,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="UCJUESTUDIO_9" sprite="UCJUESTUDIO_3" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>0,1</Frame>
				<Frame>2,1</Frame>
