<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Bike1" fileName="game/player_feet16.rttex" textureSize="32" frame="13,18" />
		<Sprite name="s_Bike2" fileName="game/player_feet16.rttex" textureSize="32" frame="13,19" />
		<Sprite name="s_Hit" fileName="game/particles_large14.rttex" textureSize="64" frame="14,0" />
		<Sprite name="s_Muzzle" fileName="game/particles11.rttex" textureSize="32" frame="6,24" />
		<Sprite name="s_Projectile" fileName="game/particles11.rttex" textureSize="32" frame="7,24" />
		<Sprite name="s_Shoes1" fileName="game/player_feet16.rttex" textureSize="32" frame="12,18" />
		<Sprite name="s_Shoes2" fileName="game/player_feet16.rttex" textureSize="32" frame="12,19" />
		<Animations>
			<SpriteAnimation name="a_BikeIdle1" sprite="s_Bike1" animTime="400" isLoop="true" playOnState="Motion.Idle">
				<Frame>13,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_BikeIdle2" sprite="s_Bike2" animTime="400" isLoop="true" playOnState="Motion.Idle">
				<Frame>13,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_BikeInAir1" sprite="s_Bike1" animTime="400" isLoop="true" playOnState="Motion.Fall|Motion.Jump">
				<Frame>17,18</Frame>
				<Frame>18,18</Frame>
				<Frame>19,18</Frame>
				<Frame>20,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_BikeInAir2" sprite="s_Bike2" animTime="400" isLoop="true" playOnState="Motion.Fall|Motion.Jump">
				<Frame>17,19</Frame>
				<Frame>18,19</Frame>
				<Frame>19,19</Frame>
				<Frame>20,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_BikeMove1" sprite="s_Bike1" animTime="400" isLoop="true" playOnState="Motion.Move">
				<Frame>13,18</Frame>
				<Frame>14,18</Frame>
				<Frame>15,18</Frame>
				<Frame>16,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_BikeMove2" sprite="s_Bike2" animTime="400" isLoop="true" playOnState="Motion.Move">
				<Frame>13,19</Frame>
				<Frame>14,19</Frame>
				<Frame>15,19</Frame>
				<Frame>16,19</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_Hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.25, 0.25</KeyFrame>
						<KeyFrame>1, 0.75, 0.75</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_MuzzleFlash" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">2.5, -6</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Muzzle</Set>
					<Select name="offset" input="punchCount">
						<Item>-4, 0</Item>
						<Item>4, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">0, -6</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Projectile</Set>
					<Select name="offset" input="punchCount">
						<Item>-4, 0</Item>
						<Item>4, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="ClothingOffsetFromShoes">-10</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="IsSurfboard">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<SpriteRender name="s_Bike1" offset="0,10" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
			<SpriteRender name="s_Shoes2" alignment="DOWN_CENTER" />
			<SpriteRender name="s_Bike2" offset="0,10" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />
			<SpriteRender name="s_Shoes1" alignment="DOWN_CENTER" />
		</RenderShoes>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_Hit" />
		</OnDestroyedTile>
		<OnPunchStart>
			<AvatarTransform class="Face">
				<Set name="face">NORMAL</Set>
			</AvatarTransform>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Pants" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="23,30" />
		<Sprite name="s_Pants_deck" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="24,30" />
		<Sprite name="s_card" fileName="game/particles12.rttex" textureSize="32"/>
		<Sprite name="s_card_particle_front" fileName="game/particles12.rttex" textureSize="32"/>
		<Sprite name="s_card_particle_back" fileName="game/particles12.rttex" textureSize="32"/>
		<Animations>
			<SpriteAnimation name="a_card" sprite="s_card" isLoop="true" animTime="6000">	
				<Frame>10,6</Frame>
				<Frame>10,6</Frame>
				<Frame>9,6</Frame>
				<Frame>7,6</Frame>
				<Frame>4,6</Frame>
				<Frame>5,6</Frame>
				<Frame>5,6</Frame>
				<Frame>5,6</Frame>
				<Frame>5,6</Frame>
				<Frame>6,6</Frame>
				<Frame>8,6</Frame>
				<Frame>11,6</Frame>
				<Frame>10,6</Frame>
				<Frame>10,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_card_particle_front" sprite="s_card_particle_front" isLoop="true" animTime="100">
				<Frame>4,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_card_particle_back" sprite="s_card_particle_back" isLoop="true" animTime="100">
				<Frame>5,4</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">false</Set>
				<Set name="IgnorePunchTypeDamagedTileCheck">false</Set>
				<Set name="IsToRenderParticlesWhenShrunken">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="Arc1" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.75</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_card</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart">-0.2</Set>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="lifeTime">5.9</Set>
					<Set name="orbitPeriod">5.8</Set>
					<Set name="initialRotationRate">0</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="orbit">-24, 3</Set>
					<Set name="orbitScaleVariation">0.08</Set>
					<Set name="orbitSkew">0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchProjectile" updateStage="AddClothingParticles" updateState="Action.Punch">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Random name="variantId" min="0" max="4" />
					<Select name="sprite" input="variantId">
						<Item>"s_card_particle_front"</Item>
						<Item>"s_card_particle_back"</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="initialAngle">0</Set>
					<Random name="targetPosOffset" min="-12,-11" max="12,11"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angleOutVar="projectile_angle"/>
					<Set name="rotateWithVelocity">true</Set>
					<SetVar name="projectile_offset" source="targetPosOffset"/>
					<SetVar name="variantIdVar" source="variantId"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileCard">
				<Emitter>
					<Set name="infParticles">false</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.3</Set>
				</Emitter>
				<Particle>
					<Set name="variantId" source="variantIdVar"/>
					<Select name="sprite" input="variantId">
						<Item>"s_card_particle_front"</Item>
						<Item>"s_card_particle_back"</Item>
					</Select>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="interpolateScale">true</Set>
					<Random name="finalScale" min="0.5" max="0.7"/>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="offset" source="projectile_offset"/>
					<Set name="initialAngle" source="projectile_angle"/>
					<Random name="finalAngle" min="-360" max="360" />
					<Set name="interpolateAngle">true</Set>
					<RandomRadial name="initialVelocity" angleRange="210,330" radiusRange="35,85" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="projectile_offset">0, 0</Set>
			<Set name="projectile_angle">0</Set>
			<Set name="variantIdVar" ForceFloats="false">0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderPants>
			<SpriteRender name="s_Pants" alignment="DOWN_CENTER" />
			<SpriteRender name="s_Pants_deck" alignment="DOWN_CENTER" />
		</RenderPants>
		<RenderInFront>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>

		</RenderInFront>
		<OnDamagedTile>
			<StopIf type="or">
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
			</StopIf>
			<ParticleSystemUpdate name="ps_tileCard" />
		</OnDamagedTile>
		<OnDestroyedTile>

		</OnDestroyedTile>
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Action.Punch">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Action.Punch">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_DIAMOND_SPARKLING_SNEAKERS">
	<Data>
		<Sprite name="s_foot1" fileName="game/player_feet16.rttex" textureSize="32" frame="30,14" />
		<Sprite name="s_foot2" fileName="game/player_feet16.rttex" textureSize="32" frame="30,15" />
		<Sprite name="s_godRays" fileName="game/particles_large11.rttex" textureSize="64" frame="5,15" />
		<Sprite name="s_sparks" fileName="game/particles11.rttex" textureSize="32" frame="18,28" />
		<VariableMap>
			<Set name="leftFootYPos">0,0,0</Set>
			<Set name="rightFootYPos">0,0,0</Set>
		</VariableMap>
		<Animations>
			<SpriteAnimation name="a_godRays" sprite="s_godRays">
        <Frame>5,15</Frame>
				<Frame>8,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sparks" sprite="s_sparks" animTime="600" >
				<Frame>18,28</Frame>
				<Frame>19,29</Frame>
				<Frame>20,28</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_godRays" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="emissionInterval">0.7</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_godRays</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0.7, 1.75, 1.75</KeyFrame>
						<KeyFrame>1, 1.75, 1.75</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_sparkles" updateStage="AddClothingParticles">
				<Emitter>
					<Random name="emissionInterval" min="0.2" max="0.4" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_sparks</Set>
					<Random name="offset" min="-8, 0" max="8, 0" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.7</Set>
					<Random name="initialVelocity" min="-55, -30" max="55, -30" />
					<Set name="finalVelocity">0, 0</Set>
          <Set name="interpolateVelocity">true</Set>
					<Random name="initialAngle" min="-75" max="75" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="HideParticlesOnTransform">true</Set>
        <Set name="RenderShoesWithMermaidTail">false</Set>
      </Default>
    </RenderOptions>
	</Data>
	<RenderRules>
		<RenderShoes>
      <StopIf type="or">
        <IsWearing slot="PANTS">ITEM_ID_RAPTOR_LEGS</IsWearing>
        <IsRenderObjectFlag>RENDER_OBJECT_FLAG_NO_FEET</IsRenderObjectFlag>
        <IsVariableBool name="isInvisible">true</IsVariableBool>
      </StopIf>
			<Group>
				<Translate>leftFootYPos</Translate>
				<SpriteRender name="s_foot1" alignment="DOWN_CENTER" />
			</Group>
			<Group>
				<Translate>rightFootYPos</Translate>
				<SpriteRender name="s_foot2" alignment="DOWN_CENTER" />
			</Group>
		</RenderShoes>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_DIRT_AURA">
  <Data>

    <Sprite name="dirtSprite1" fileName="game/particles11.rttex" textureSize="32" frame="0,19"/>
    <Sprite name="dirtSprite2" fileName="game/particles11.rttex" textureSize="32" frame="1,19"/>
    <Sprite name="dirtSprite3" fileName="game/particles11.rttex" textureSize="32" frame="2,19"/>
    <Sprite name="dirtSpriteMannequin1" fileName="game/particles11.rttex" textureSize="32" frame="0,19"/>
    <Sprite name="dirtSpriteMannequin2" fileName="game/particles11.rttex" textureSize="32" frame="1,19"/>
    <Sprite name="dirtSpriteMannequin3" fileName="game/particles11.rttex" textureSize="32" frame="2,19"/>

    <Animations>
      <SpriteAnimation name="dirt1" sprite="dirtSprite1" animTime="800">
        <Frame>0,19</Frame>
        <Frame>0,20</Frame>
        <Frame>0,21</Frame>
        <Frame>0,22</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="dirt2" sprite="dirtSprite2" animTime="800">
        <Frame>1,19</Frame>
        <Frame>1,20</Frame>
        <Frame>1,21</Frame>
        <Frame>1,22</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="dirt3" sprite="dirtSprite3" animTime="600">
        <Frame>2,19</Frame>
        <Frame>2,20</Frame>
        <Frame>2,21</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="dirtMannequin1" sprite="dirtSpriteMannequin1" animTime="800" autoPlay="true" isLoop="true" >
        <Frame>0,19</Frame>
        <Frame>0,20</Frame>
        <Frame>0,21</Frame>
        <Frame>0,22</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="dirtMannequin2" sprite="dirtSpriteMannequin2" animTime="800" autoPlay="true" isLoop="true" >
        <Frame>1,19</Frame>
        <Frame>1,20</Frame>
        <Frame>1,21</Frame>
        <Frame>1,22</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="dirtMannequin3" sprite="dirtSpriteMannequin3" animTime="600" autoPlay="true" isLoop="true" >
        <Frame>2,19</Frame>
        <Frame>2,20</Frame>
        <Frame>2,21</Frame>
        <Frame>2,22</Frame>
      </SpriteAnimation>
      <SpriteSinPulseAnimation name="floatAnim1" sprite="dirtSpriteMannequin1" autoPlay="true">
        <Parameter name="pos">
          <Set name="period">2000</Set>
          <Set name="scale">3</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteSinPulseAnimation name="floatAnim2" sprite="dirtSpriteMannequin2" autoPlay="true">
        <Parameter name="pos">
          <Set name="period">2000</Set>
          <Set name="scale">-2</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteSinPulseAnimation name="floatAnim3" sprite="dirtSpriteMannequin3" autoPlay="true">
        <Parameter name="pos">
          <Set name="period">4000</Set>
          <Set name="scale">-3</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
    </Animations>

    <ParticleSystems>
			<ParticleSystem name="dirtOrbit1">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.8</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<OrbitOffset>
						<Set name="maxScale">1</Set>
						<Set name="hasOrbit">true</Set>
						<Set name="hOrbitPeriod">6000</Set>
						<Set name="hAmplitude">20</Set>
						<Set name="hTimeOffset">0</Set>
						<Set name="vAmplitude">12</Set>
						<Set name="vOrbitPeriod">4000</Set>
						<Set name="vTimeOffset">0</Set>
						<Set name="minScale">0.5</Set>
					</OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">dirtSprite1</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.9</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="dirtOrbit2">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.8</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<OrbitOffset>
						<Set name="maxScale">1</Set>
						<Set name="hasOrbit">true</Set>
						<Set name="hOrbitPeriod">-6000</Set>
						<Set name="hAmplitude">20</Set>
						<Set name="hTimeOffset">500</Set>
						<Set name="vAmplitude">12</Set>
						<Set name="vOrbitPeriod">4000</Set>
						<Set name="vTimeOffset">1500</Set>
						<Set name="minScale">0.5</Set>
					</OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">dirtSprite2</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.9</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="dirtOrbit3">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.6</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<OrbitOffset>
						<Set name="maxScale">1</Set>
						<Set name="hasOrbit">true</Set>
						<Set name="hOrbitPeriod">-6000</Set>
						<Set name="hAmplitude">20</Set>
						<Set name="hTimeOffset">3000</Set>
						<Set name="vAmplitude">6</Set>
						<Set name="vOrbitPeriod">6000</Set>
						<Set name="vTimeOffset">0</Set>
						<Set name="minScale">0.5</Set>
					</OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">dirtSprite3</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.7</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
  </Data>

  <RenderRules>
    <AddClothingParticles>
      <ParticleSystemUpdate name="dirtOrbit1"/>
      <ParticleSystemUpdate name="dirtOrbit2"/>
      <ParticleSystemUpdate name="dirtOrbit3"/>
    </AddClothingParticles>
    <RenderInFront>
      <ParticleSystemRender name="dirtOrbit1"/>
      <ParticleSystemRender name="dirtOrbit2"/>
      <ParticleSystemRender name="dirtOrbit3"/>
      <StopIf>
        <IsVariableBool name="isMannequin">false</IsVariableBool>
      </StopIf>
      <SpriteRender name="dirtSpriteMannequin1" offset="8,-8"/>
      <SpriteRender name="dirtSpriteMannequin2" offset="-20,-22"/>
    </RenderInFront>
    <RenderBehind>
      <StopIf>
        <IsVariableBool name="isMannequin">false</IsVariableBool>
      </StopIf>
      <SpriteRender name="dirtSpriteMannequin3" offset="10,-4"/>
    </RenderBehind>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="dirtOrbit1"/>
      <ParticleSystemOff name="dirtOrbit2"/>
      <ParticleSystemOff name="dirtOrbit3"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Pet" fileName="game/pets/p_disco.rttex" textureSize="32,32" frame="0,0" />
		<Sprite name="s_luteTrail" fileName="game/particles10.rttex" textureSize="32" frame="7,16"/>
		<Sprite name="s_Hand" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="31,22" />
		<Animations>
			<SpriteAnimation name="a_luteTrail" sprite="s_luteTrail" isLoop="true" animTime="600">
				<Frame>16,12</Frame>
				<Frame>15,12</Frame>
				<Frame>16,15</Frame>
				<Frame>15,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="400" isLoop="true" playOnState="Action.None">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PetPunch" sprite="s_Pet" animTime="200" isLoop="true" playOnState="Action.Punch">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-48,0</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="IsPetWithLight">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_luteTrail">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="emissionInterval">0.04</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_luteTrail</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialRotationRate">
						<KeyFrame>0, 15</KeyFrame>
						<KeyFrame>1, 5</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="0" max="360" />
					<Random name="finalAngle" min="0" max="360" />
					<Set name="interpolateAngle">true</Set>
					<Set name="initialScale">0.6,0.6</Set>
					<Random name="finalScale" min="0.3" max="0.6" />
					<Set name="interpolateScale">true</Set>
					<Random name="offset" min="-4,-6" max="4,6" />
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderHandItem>
			<SpriteRender name="s_Hand" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
		</RenderHandItem>
		<RenderPet>
      <ParticleSystemRender name="ps_luteTrail"/>
			<ParticleSystemUpdate name="ps_luteTrail"/>
			<SpriteRender name="s_Pet" blend="PREMULTIPLIED_ALPHA" drawShadow="false" scale="0.7,0.7"/>
			<StopIf>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">false</IsSitting>
			</StopIf>
			<ParticleSystemRender name="ps_luteTrail"/>
		</RenderPet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_frontSpear" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="5,13"/>
    <Sprite name="s_backSpear" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="6,13"/>
    <Sprite name="hit_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="2,20"/>
    <Sprite name="s_punchStraight" fileName="game/particles12.rttex" textureSize="32" frame="1,20"/>
    <Sprite name="s_punchCurve" fileName="game/particles12.rttex" textureSize="32" frame="0,20"/>
    <Sprite name="s_back_arms" fileName="game/particles_large17.rttex" textureSize="64" frame="14,6"/>
    <Sprite name="s_back_items" fileName="game/particles_large17.rttex" textureSize="64" frame="15,6"/>

    <Animations>
      <SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="hit_Sprite">
        <Frame>2,20</Frame>
        <Frame>3,20</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_punchCurved">
        <Emitter onPunchCount="odd">
          <Set name="offset">0,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchCurve</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">1,1</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchStraight">
        <Emitter onPunchCount="even">
          <Set name="offset">0,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchStraight</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">1,1</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="hit_particle">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">10</Set>
          <Set name="delayTimer">0.0</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">hit_Sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initalRGB">1,1,1</Set>
	      <Set name="initialScale">0.75,0.75</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">true</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
	      <Set name="HideParticlesOnTransform">false</Set>
	      <Set name="PunchSoundOverride">HAND</Set>
	      <Set name="RenderBackArmInfected">true</Set>
	      <Set name="RenderFrontArmInfected">true</Set>
	      <Set name="RenderBackArmBuild">false</Set>
	      <Set name="DefaultRenderMannequinHandItem">false</Set>
	      <Set name="RenderFrontArmInTheFront">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <AddClothingParticles>
      <StopIf>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
    </AddClothingParticles>
	<RenderBehind value="playerCenter">
	  <StopIf>
		  <IsZombified>true</IsZombified>
		  <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
		  <IsTrnsformed>true</IsTrnsformed>
		  <IsSleepingOnaBed>true</IsSleepingOnaBed>
		  <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
	  </StopIf>
	  <SpriteRender name="s_back_arms" alignment="DOWN_CENTER" tintOverride="SKIN"/>
	  <SpriteRender name="s_back_items" alignment="DOWN_CENTER"/>
	</RenderBehind>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>

		<Group>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="s_backSpear" offset="-4,4" rotateOffset="true" useFixedRodtation="true" blend="PREMULTIPLIED_ALPHA" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL|DANCE"/>
			<SpriteRender name="s_backSpear" offset="0,8" rotateOffset="true" rotateToTarget="true" blend="PREMULTIPLIED_ALPHA" onAction="PUNCH"/>
		</Group>
	    <Group>
		    <StopIf>
			    <IsZombified>false</IsZombified>
		    </StopIf>
		    <SpriteRender name="s_backSpear" offset="3,3"  rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
	    </Group>
    </RenderBackHandItem>
    <RenderHandItem>
	    <StopIf type="and">
		    <IsZombified>true</IsZombified>
		    <IsAction>PUNCH</IsAction>
	    </StopIf>
	    <Group>
		    <StopIf>
			    <IsZombified>true</IsZombified>
		    </StopIf>
		    <SpriteRender name="s_frontSpear" offset="0,8" rotateOffset="true" useFixedRotation="true" blend="PREMULTIPLIED_ALPHA" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL|DANCE"/>
		    <SpriteRender name="s_frontSpear" offset="0,8" rotateOffset="true" rotateToTarget="true" blend="PREMULTIPLIED_ALPHA" onAction="PUNCH"/>
	    </Group>
	    <Group>
		    <StopIf>
			    <IsZombified>false</IsZombified>
		    </StopIf>
		    <SpriteRender name="s_frontSpear" offset="7,7" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
	    </Group>
    </RenderHandItem>
    <OnPunchStart>
      <ParticleSystemUpdate name="ps_punchCurved"/>
      <ParticleSystemUpdate name="ps_punchStraight"/>
    </OnPunchStart>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1080</Set>
	      <Set name="angleOffset">-1</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1080</Set>
	     <Set name="angleOffset">1</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="hit_particle"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="hit_particle"/>
    </OnDestroyedTile>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_punchCurved"/>
      <ParticleSystemOff name="ps_punchStraight"/>
      <ParticleSystemOff name="hit_particle"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_shirt" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="23,12"/>
		<Sprite name="s_orbit" fileName="game/particles12.rttex" textureSize="32" frame="10,24"/>
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="12,24" />
		<Sprite name="s_aura" fileName="game/particles_large18.rttex" textureSize="64" frame="12,15" />
		<Sprite name="s_Hit" fileName="game/particles_large18.rttex" textureSize="64" frame="15,13" />
		<Sprite name="s_Sparkle" fileName="game/particles12.rttex" textureSize="32" frame="14,24" />
		<Animations>
			<SpriteAnimation name="a_shirt" sprite="s_shirt" autoPlay="true" animTime="1200" isLoop="true">
				<Frame>23,12</Frame>
				<Frame>24,12</Frame>
				<Frame>25,12</Frame>
				<Frame>26,12</Frame>
				<Frame>27,12</Frame>
				<Frame>28,12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_orbit" sprite="s_orbit">
				<Frame>10,24</Frame>
				<Frame>11,24</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_aura" sprite="s_aura">
				<Frame>12,15</Frame>
				<Frame>13,15</Frame>
				<Frame>14,15</Frame>
				<Frame>15,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Sparkle" sprite="s_Sparkle">
				<Frame>14,24</Frame>
				<Frame>15,24</Frame>
				<Frame>16,24</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_orb1">
				<Emitter>
					<Set name="offset">5, -35</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart" source="posOrb"/>
					<Set name="orbitPeriod">2.4</Set>
					<Set name="orbitScaleVariation">0.2</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="orbit">-30,10</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Random name="initialScale" min="0.7" max="0.9"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_orb2">
				<Emitter>
					<Set name="offset">5, -20</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart" source="posOrb"/>
					<Set name="orbitPeriod">2.2</Set>
					<Set name="orbitScaleVariation">0.1</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="orbit">30,10</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
					<Random name="initialScale" min="0.7" max="0.9"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_orb3">
				<Emitter>
					<Set name="offset">5, -15</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart" source="posOrb"/>
					<Set name="orbitPeriod">2</Set>
					<Set name="orbitSkew">0.5</Set>
					<Set name="orbitScaleVariation">0.1</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="orbit">20,-18</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialScale" min="0.7" max="0.9"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">14,-20</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">false</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Aura" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">0,8</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">false</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" usePlayerFacing="true">
					<Set name="sprite">s_aura</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Hit</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="initialAngle" min="-360" max="360"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4,0.4</KeyFrame>
						<KeyFrame>1, 1.3,1.3</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_HitSparkle" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Sparkle</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,120"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="posOrb">0</Set>
			<Set name="incOrb">0</Set>
			<Set name="DeltaTime">0.0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="ShouldHover">true></Set>
				<Set name="DisableWalkAnimation">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderShirt>
			<SpriteRender name="s_shirt" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" />
		</RenderShirt>
		<RenderInFront>
			<ParticleSystemRender name="ps_orb1" />
			<ParticleSystemRender name="ps_orb2" />
			<ParticleSystemRender name="ps_orb3" />
		</RenderInFront>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_orb1" />
			<ParticleSystemUpdate name="ps_orb2" />
			<ParticleSystemUpdate name="ps_orb3" />
		</AddClothingParticles>
		<Update>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="incOrb" RightHandVariableName="0.4" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="incOrb" RightHandVariableName="DeltaTime" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="posOrb" RightHandVariableName="incOrb" OperationType="Add"/>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">JUMP_UP</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-40</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">40</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_Hit" />
			<ParticleSystemUpdate name="ps_HitSparkle" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_HOLIDAY_LIGHTs_body">
  <Data>
    <Sprite name="s_body" fileName="game/particles_large17.rttex" textureSize="64" frame="10,0" />
    <Sprite name="s_head" fileName="game/particles12.rttex" textureSize="32" frame="3,15" />
    <Sprite name="s_tail" fileName="game/particles12.rttex" textureSize="32" frame="3,17" />
    <Sprite name="s_PunchFireSprite" fileName="game/particles11.rttex" textureSize="32" frame="19,21" />
    
    <Animations>
      <SpriteAnimation name="a_body" sprite="s_body" animTime="600" isLoop="true" autoPlay="true">
        <Frame>10,0</Frame>
        <Frame>11,0</Frame>
        <Frame>12,0</Frame>
        <Frame>13,0</Frame>
        <Frame>14,0</Frame>
        <Frame>15,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_head" sprite="s_head" animTime="600" isLoop="true" autoPlay="true" playOnState="Action.None">
        <Frame>3,15</Frame>
        <Frame>4,15</Frame>
        <Frame>5,15</Frame>
        <Frame>6,15</Frame>
        <Frame>7,15</Frame>
        <Frame>8,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_tail" sprite="s_tail" animTime="600" isLoop="true" autoPlay="true">
        <Frame>3,17</Frame>
        <Frame>4,17</Frame>
        <Frame>5,17</Frame>
        <Frame>6,17</Frame>
        <Frame>7,17</Frame>
        <Frame>8,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_headPunch" sprite="s_head" animTime="600" isLoop="true" playOnState="Action.Punch">
        <Frame>3,16</Frame>
        <Frame>4,16</Frame>
        <Frame>5,16</Frame>
        <Frame>6,16</Frame>
        <Frame>7,16</Frame>
        <Frame>8,16</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None"/>
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Render">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition to="True" from="False">
            <Condition type="and">
              <CompareCustomVariable operatorType="Equal" VariableNameToCompare="chest_is_rendering">true</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="False" from="True">
            <Condition type="and">
              <CompareCustomVariable operatorType="Equal" VariableNameToCompare="chest_is_rendering">false</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <VariableMap>
      <Set name="chest_is_rendering">false</Set>
    </VariableMap>

    <ParticleSystems>
      <ParticleSystem name="ps_PunchFire" updateStage="RenderChestBackItem" updateState="Action.Punch">
        <Emitter attachment="handspotRoot">
          <Set name="offset">-2, -4</Set>
          <Random name="emissionInterval" min="0.001" max="0.005" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_PunchFireSprite</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.8, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 0.3</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Random name="targetPosOffset" min="-12,-8" max="12,8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.8" angleOutVar="projectile_angle"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlame" updateStage="OnPunchStart">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.4</Set>
          <Set name="infParticles">true</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_PunchFireSprite</Set>
          <Random name="offset" min="-4,-8" max="4,0" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="initialAngle">90</Set>
          <Set name="initialScale">2,2</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">false</Set>
        <Set name="PunchSoundOverride">CHESTITEM</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <Update>
      <ArithmethicOperation LeftHandVariableName="chest_is_rendering" RightHandVariableName="false" OperationType="Set" />
    </Update>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderInFront>


      <Group>
        <StopIf>
          <IsZombified>true</IsZombified>
        </StopIf>
      <SpriteRender name="s_head" offset="-16,-16" onState="Render.True"/>
      <SpriteRender name="s_tail" offset="16,-16" onState="Render.True"/>
      </Group>
      
      <Group>
        <StopIf>
          <IsZombified>false</IsZombified>
        </StopIf>
        <SpriteRender name="s_head" offset="-16,-16" onState="Render.True"  tintOverride="111,217,45,255"/>
        <SpriteRender name="s_tail" offset="16,-16" onState="Render.True"  tintOverride="111,217,45,255"/>
      </Group>
    </RenderInFront>
    <RenderChestBackItem>
      <ArithmethicOperation LeftHandVariableName="chest_is_rendering" RightHandVariableName="true" OperationType="Set" />
      <SpriteRender name="s_body" offset="0,-32" />
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
    </RenderChestBackItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_DRACONIC_SPIRIT">
	<Data>
		<Sprite name="foot1_Sprite" fileName="game/player_feet_large1.rttex" textureSize="64"/>
		<Sprite name="foot2_Sprite" fileName="game/player_feet_large1.rttex" textureSize="64"/>
		
		<Animations>
			<SpriteAnimation name="foot1_Idle" playOnAction="IDLE" sprite="foot1_Sprite" animTime="800" isLoop="true">
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Idle" playOnAction="IDLE" sprite="foot2_Sprite" animTime="800" isLoop="true">
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Walk" playOnAction="WALK" sprite="foot1_Sprite" animTime="600" isLoop="true">
				<Frame>7,4</Frame>
				<Frame>8,4</Frame>
				<Frame>9,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Walk" playOnAction="WALK" sprite="foot2_Sprite" animTime="600" isLoop="true">
				<Frame>7,5</Frame>
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Jump" playOnAction="JUMP" sprite="foot1_Sprite">
				<Frame>10,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Jump" playOnAction="JUMP" sprite="foot2_Sprite">
				<Frame>10,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Fall" playOnAction="FALL" sprite="foot1_Sprite">
				<Frame>11,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Fall" playOnAction="FALL" sprite="foot2_Sprite">
				<Frame>11,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Punch" playOnAction="PUNCH|JUMPEND" sprite="foot1_Sprite">
				<Frame>12,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Punch" playOnAction="PUNCH|JUMPEND" sprite="foot2_Sprite">
				<Frame>12,5</Frame>
			</SpriteAnimation>
			<SpriteSinPulseAnimation name="foot1_Stretch" playOnAction="IDLE" sprite="foot1_Sprite">
				<Parameter name="scale.x">
					<Set name="offset">1</Set>
					<Set name="period">3000</Set>
					<Set name="scale">0.05</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="foot2_Stretch" playOnAction="IDLE" sprite="foot2_Sprite">
				<Parameter name="scale.x">
					<Set name="offset">1</Set>
					<Set name="period">3000</Set>
					<Set name="scale">0.05</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
		</Animations>
		
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">-20</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="IsPulseShoes">true</Set>
				<Set name="IsHorse">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="UserNameOffset">23</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
			</Default>
			<Override overrideOnAction="IDLE">
				<Set name="IsPulseShoes">false</Set>
			</Override>
		</RenderOptions>
		
	</Data>

	<RenderRules>
		<RenderShoes>
			<SpriteRender name="foot1_Sprite" offset="0,24" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" blend="ADDITIVE" drawShadow="false"/>
			<SpriteRender name="foot2_Sprite" offset="0,24" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" blend="ADDITIVE" drawShadow="false"/>
		</RenderShoes>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_smoke" fileName="game/particles_large17.rttex" textureSize="64" frame="14,12" />
    <Sprite name="s_shirt" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="15,8" />
    
    <Animations>
      <SpriteAnimation name="a_smoke" sprite="s_smoke">
        <Frame>14,12</Frame>
        <Frame>15,12</Frame>
      </SpriteAnimation>
      <SequenceAnimation name="a_shirtSequence" autoPlay="true" isLoop="true">
        <SpriteAnimation name="a_wait" sprite="s_shirt" animTime="2000">
          <Frame>15,8</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_anim" sprite="s_shirt" animTime="800">
          <Frame>15,8</Frame>
          <Frame>16,8</Frame>
          <Frame>17,8</Frame>
          <Frame>18,8</Frame>
          <Frame>19,8</Frame>
          <Frame>20,8</Frame>
          <Frame>21,8</Frame>
          <Frame>22,8</Frame>
        </SpriteAnimation>
      </SequenceAnimation>
    </Animations>
    <ParticleSystems>
      <ParticleSystem name="ps_smoke">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_smoke</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.7, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.8, 0.8</KeyFrame>
            <KeyFrame>0.7, 1.1, 1.1</KeyFrame>
            <KeyFrame>1, 1.1, 1.1</KeyFrame>
          </Curve>
          <Set name="lifeTime">1.5</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderShirt>
      <SpriteRender name="s_shirt" offset="0,0" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
    </RenderShirt>
    <RenderAura>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="ps_smoke"/>
    </RenderAura>
    <AddClothingParticles>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_smoke"/>
    </AddClothingParticles>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_backLayer" fileName="game/particles_large15.rttex" textureSize="64" frame="11,4" />
		<Sprite name="s_frontLayer" fileName="game/particles_large15.rttex" textureSize="64" frame="11,5" />
		<Sprite name="s_hit" fileName="game/particles10.rttex" textureSize="32" frame="6,24" />
		<Sprite name="s_legs" fileName="game/player_sit.rttex" textureSize="32" frame="1,0" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="22,1" />
		<Animations>
			<SpriteAnimation name="a_backLayer" sprite="s_backLayer" animTime="200" isLoop="true" playOnState="Motion.Fall|Motion.Jump|Motion.Move">
				<Frame>11,4</Frame>
				<Frame>12,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer1" sprite="s_frontLayer" animTime="1000" isLoop="true" playOnState="Action.Punch">
				<Frame>11,5</Frame>
				<Frame>12,5</Frame>
				<Frame>13,5</Frame>
				<Frame>14,5</Frame>
				<Frame>15,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer2" sprite="s_frontLayer" playOnState="Action.None">
				<Frame>11,5</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="ClothingOffsetFromShoes">-14</Set>
				<Set name="UserNameOffset">12</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="DefaultPunchSound">audio/arrow_thwip.wav</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">8</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.75, 0.75</Set>
					<Set name="lifeTime">0.7</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,80" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">8, -14</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<Group onState="Motion.Move">
				<AvatarTransform class="ArmAngle" onState="Action.None">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Action.None">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
			</Group>
		</Update>
		<RenderBehind>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_backLayer" offset="1,6" blend="PREMULTIPLIED_ALPHA" />
		</RenderBehind>
		<RenderShoes>
			<SpriteRender name="s_legs" offset="1,-7" tintOverride="SKINORPANTS" />
		</RenderShoes>
		<RenderInFront>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_frontLayer" offset="3,14" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
		</RenderInFront>
		<OnPunchStart>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1500</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_DRAGON_FRUIT_DRAGON_WINGS">
	<Data>
		<StateMachines>
			<StateMachine name="playerState">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Fall"/>
					<State name="Jump"/>
					<State name="DoubleJump"/>
					<State name="SpiritGuide"/>
				</States>
				<Transitions>
					<Transition from="SpiritGuide|Jump|Fall|Move|DoubleJump" to="Idle" >
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Jump|Fall|Idle|DoubleJump" to="Move">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>WALK</IsAction>
						</Condition>
					</Transition>				
					<Transition from="Move|Jump|Fall|Idle|DoubleJump" to="SpiritGuide">
						<Condition type="and">
							<IsWearing slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0</IsVariableFloat>
							<IsAction operatorType="NotEqual">FALL</IsAction>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Fall|Move|Idle" to="Jump">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition from="Jump|Fall" to="DoubleJump">
						<Condition>
							<IsAction>JUMPDOUBLE</IsAction>
						</Condition>
					</Transition>
					<Transition from="DoubleJump|SpiritGuide|Jump|Idle|Move" to="Fall">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater" abs="false">0.01</IsVariableFloat>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="left_wing_sprite" fileName="game/particles11.rttex" textureSize="32" frame="8,20"/>
		<Sprite name="right_wing_sprite" fileName="game/particles11.rttex" textureSize="32" frame="8,20"/>
	
		<Sprite name="double_jump_particle_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
w
		<Animations>
			<SpriteAnimation name="left_wing_Idle" playOnState="playerState.Idle|playerState.SpiritGuide|playerState.Move" sprite="left_wing_sprite" isLoop="true" animTime="100">
				<Frame>8,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="right_wing_Idle" playOnState="playerState.Idle|playerState.SpiritGuide|playerState.Move" sprite="right_wing_sprite" isLoop="true" animTime="100">
				<Frame>8,20</Frame>
			</SpriteAnimation>
			
			<SpriteAnimation name="left_wing_Fall" playOnState="playerState.Fall|playerState.DoubleJump" sprite="left_wing_sprite" isLoop="true" animTime="100">
				<Frame>11,20</Frame>
			</SpriteAnimation>		
			<SpriteAnimation name="right_wing_Fall" playOnState="playerState.Fall|playerState.DoubleJump" sprite="right_wing_sprite" isLoop="true" animTime="100">
				<Frame>11,20</Frame>
			</SpriteAnimation>			
		
			<SpriteAnimation name="left_wing_Jump" playOnState="playerState.Jump" sprite="left_wing_sprite" isLoop="true" animTime="200">
				<Frame>9,20</Frame>
				<Frame>10,20</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="right_wing_Jump" playOnState="playerState.Jump" sprite="right_wing_sprite" isLoop="true" animTime="200">
				<Frame>9,20</Frame>
				<Frame>10,20</Frame>
			</SpriteAnimation>
			
			<SpriteAnimation name="double_jump_particle_Sprite_frames"  autoPlay="false" isLoop="false" sprite="double_jump_particle_Sprite"  animTime="100">
				<Frame>6,19</Frame>
				<Frame>7,19</Frame>
				<Frame>8,19</Frame>
			</SpriteAnimation>

		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="double_jump_particle">
				<Emitter>
					<Set name="offset">0, -24</Set>
					<Set name="lifeTime">0.75</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">8</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">double_jump_particle_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="lifeTime">0.75</Set>
					<Random name="initialScale" min="0.5" max="1"/>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderBackpack>
			<SpriteRender name="left_wing_sprite" offset="-24,-20"/>
			<SpriteRender name="right_wing_sprite" offset="24,-20" flip="1,0"/>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
		</RenderBackpack>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<AddClothingParticles>
			<ParticleSystemUpdate name="double_jump_particle" onAction="JUMPDOUBLE"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="double_jump_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Wing" fileName="game/particles_large16.rttex" textureSize="64" frame="0,1" />
		<Sprite name="s_spark" fileName="game/particles12.rttex" textureSize="32"/>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="JumpStraight" />
					<State name="FallStraight" />
				</States>
				<Transitions>
					<Transition to="Idle" from="FallStraight|Move">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|FallStraight">
						<Condition type="and">
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>					
					<Transition to="JumpStraight" from="Idle|FallStraight|Move">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>			
					<Transition to="FallStraight" from="JumpStraight|Idle|Move">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>				
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="s_spark_frames" sprite="s_spark">
				<Frame>0,10</Frame>
				<Frame>1,10</Frame>
				<Frame>2,10</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Wing_idle" sprite="s_Wing" animTime="50" isLoop="true" playOnState="Action.Idle" >
				<Frame>0,1</Frame>
			</SpriteAnimation>					
			
			<SpriteAnimation name="s_Wing_walk" sprite="s_Wing" animTime="200" isLoop="true" playOnState="Action.Move" >
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>1,1</Frame>
				<Frame>4,1</Frame>
			</SpriteAnimation>		
			
			<SpriteAnimation name="s_Wing_jump" sprite="s_Wing" animTime="100" isLoop="true" playOnState="Action.JumpStraight">
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
			</SpriteAnimation>			
			
			<SpriteAnimation name="s_Wing_fall" sprite="s_Wing" animTime="100" isLoop="true" playOnState="Action.FallStraight">
				<Frame>7,1</Frame>
				<Frame>8,1</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="HideParticlesOnTransform">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="trail_spark_left" updateStage="AddClothingParticles" updateState="Action.Idle">
				<Emitter>
					<Random name="offset" min="-32, -20" max="-11.5, -10" />
					<Set name="offsetFacing">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.4</Set>
				</Emitter>
				<Particle  usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
			
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_right" updateStage="AddClothingParticles" updateState="Action.Idle">
				<Emitter>
					<Random name="offset" min="11.5, -20" max="32, -10" />
					<Set name="offsetFacing">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.4</Set>
				</Emitter>
				<Particle usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_left_jump" updateStage="AddClothingParticles" updateState="Action.JumpStraight">
				<Emitter>
					<Random name="offset" min="-32, -20" max="-11.5, -10" />
					<Set name="offsetFacing">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_right_jump" updateStage="AddClothingParticles" updateState="Action.JumpStraight">
				<Emitter>
					<Random name="offset" min="11.5, -20" max="32, -10" />
					<Set name="offsetFacing">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_left_walk">
				<Emitter>
					<Random name="offset" min="-32, -28" max="-11.5, 0" />
					<Set name="offsetFacing">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_right_walk">
				<Emitter>
					<Random name="offset" min="11.5, -28" max="32, 0" />
					<Set name="offsetFacing">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<AddClothingParticles>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ParticleSystemUpdate name="trail_spark_left_walk" onState="Action.Move|Action.FallStraight" />
			<ParticleSystemUpdate name="trail_spark_right_walk" onState="Action.Move|Action.FallStraight" />
		</AddClothingParticles>
		<RenderFrontpack>
			<ParticleSystemRender name="trail_spark_left_walk"/>
			<ParticleSystemRender name="trail_spark_right_walk"/>
		</RenderFrontpack>
		<RenderBackpack>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_Wing" offset="0,-16" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackpack>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_emberHit" fileName="game/particles11.rttex" textureSize="32" frame="24,21" />
    <Sprite name="s_sword" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="4,25" />
    <Sprite name="s_punchCurve" fileName="game/particles11.rttex" textureSize="32" frame="24,31" />
    <Sprite name="s_hitFlash" fileName="game/particles_large14.rttex" textureSize="64" frame="11,13" />
    <Animations>
      <SequenceAnimation name="a_swordAnim" isLoop="true" autoPlay="true"  playOnState="Motion.Idle">
        <SpriteAnimation name="a_sword" sprite="s_sword" animTime="700">
          <Frame>4,25</Frame>
          <Frame>5,25</Frame>
          <Frame>6,25</Frame>
          <Frame>7,25</Frame>
          <Frame>8,25</Frame>
          <Frame>9,25</Frame>
          <Frame>10,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_swordBlank" sprite="s_sword" animTime="4000">
          <Frame>4,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_sword" sprite="s_sword" animTime="700">
          <Frame>4,25</Frame>
          <Frame>5,25</Frame>
          <Frame>6,25</Frame>
          <Frame>7,25</Frame>
          <Frame>8,25</Frame>
          <Frame>9,25</Frame>
          <Frame>10,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_swordBlank" sprite="s_sword" animTime="2000">
          <Frame>4,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_sword" sprite="s_sword" animTime="700">
          <Frame>4,25</Frame>
          <Frame>5,25</Frame>
          <Frame>6,25</Frame>
          <Frame>7,25</Frame>
          <Frame>8,25</Frame>
          <Frame>9,25</Frame>
          <Frame>10,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_swordBlank" sprite="s_sword" animTime="1000">
          <Frame>4,25</Frame>
        </SpriteAnimation>
      </SequenceAnimation>
      <SpriteAnimation name="a_swordIdle" sprite="s_sword" animTime="100" playOnState="Motion.Moving">
        <Frame>4,25</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmAfterItem">true</Set>
      </Default>
    </RenderOptions>
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="False" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsAction>IDLE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsAction operatorType="NotEqual">IDLE</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_hitEmbers">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_emberHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="-8" max="8" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_emberHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">16,-18</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="emissionInterval">0.4</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchCurve</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlash">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hitFlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0.7, 0.7</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <TileStampData>
      <Set name="FileName">game/particles11.rttex</Set>
      <Set name="EndFrame">29,18</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>
  </Data>
  <RenderRules>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_sword" offset="8, 1" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
    </RenderBackHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">500</Set>
        <Set name="Curve">
          <KeyFrame>0.0, 215</KeyFrame>
          <KeyFrame>0.3, 360</KeyFrame>
          <KeyFrame>0.8, 360</KeyFrame>
          <KeyFrame>0.81, 215</KeyFrame>
          <KeyFrame>1, 215</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">45</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitEmbers" />
      <ParticleSystemUpdate name="ps_hitFlash"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_emberHit" fileName="game/particles11.rttex" textureSize="32" frame="24,21" />
    <Sprite name="s_sword" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="4,25" />
    <Sprite name="s_punchCurve" fileName="game/particles11.rttex" textureSize="32" frame="24,31" />
    <Sprite name="s_hitFlash" fileName="game/particles_large14.rttex" textureSize="64" frame="11,13" />
    <Sprite name="s_FrontArm" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="10,26"/>
    <Sprite name="s_PunchFireSprite" fileName="game/particles11.rttex" textureSize="32" frame="19,21" />
    <Sprite name="s_idleFlame" fileName="game/particles9.rttex" textureSize="32" frame="0,8"/>
    <Animations>
      <SequenceAnimation name="a_swordAnim" isLoop="true" autoPlay="true"  playOnState="Motion.Idle">
        <SpriteAnimation name="a_sword" sprite="s_sword" animTime="700">
          <Frame>4,25</Frame>
          <Frame>5,25</Frame>
          <Frame>6,25</Frame>
          <Frame>7,25</Frame>
          <Frame>8,25</Frame>
          <Frame>9,25</Frame>
          <Frame>10,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_swordBlank" sprite="s_sword" animTime="4000">
          <Frame>4,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_sword" sprite="s_sword" animTime="700">
          <Frame>4,25</Frame>
          <Frame>5,25</Frame>
          <Frame>6,25</Frame>
          <Frame>7,25</Frame>
          <Frame>8,25</Frame>
          <Frame>9,25</Frame>
          <Frame>10,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_swordBlank" sprite="s_sword" animTime="2000">
          <Frame>4,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_sword" sprite="s_sword" animTime="700">
          <Frame>4,25</Frame>
          <Frame>5,25</Frame>
          <Frame>6,25</Frame>
          <Frame>7,25</Frame>
          <Frame>8,25</Frame>
          <Frame>9,25</Frame>
          <Frame>10,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_swordBlank" sprite="s_sword" animTime="1000">
          <Frame>4,25</Frame>
        </SpriteAnimation>
      </SequenceAnimation>
      <SpriteAnimation name="a_swordIdle" sprite="s_sword" animTime="100" playOnState="Motion.Moving">
        <Frame>4,25</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PunchArm" sprite="s_FrontArm" animTime="100" isLoop="true" playOnState="Punch.False">
        <Frame>10,26</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_NonPunchArm" sprite="s_FrontArm" animTime="100" isLoop="true" playOnState="Punch.True">
        <Frame>11,26</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmAfterItem">true</Set>
      </Default>
    </RenderOptions>
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="False" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsAction>IDLE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsAction operatorType="NotEqual">IDLE</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_PunchFire" updateStage="AddClothingParticles" renderStage="RenderHandItem" updateState="Punch.True">
        <Emitter attachment="handspotRoot">
          <Set name="offset">-8, 2</Set>
          <Random name="emissionInterval" min="0.001" max="0.005" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_PunchFireSprite</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.8, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 0.3</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Random name="targetPosOffset" min="-12,-8" max="12,8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.7" angleOutVar="projectile_angle"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_shieldFlames" updateStage="AddClothingParticles" renderStage="RenderHandItem" updateState="Motion.Idle">
        <Emitter>
          <Random name="offset" min="-8, -2" max="-6, -10" />
          <Random name="emissionInterval" min="0.05" max="0.1" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_idleFlame</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.2</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 0.4</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.1" max="0.3" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitEmbers">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_emberHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="-8" max="8" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_emberHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">16,-18</Set>
          <Set name="lifeTime">0.6</Set>
          <Set name="emissionInterval">0.6</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchCurve</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlash">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hitFlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0.7, 0.7</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <TileStampData>
      <Set name="FileName">game/particles11.rttex</Set>
      <Set name="EndFrame">29,18</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>
  </Data>
  <RenderRules>
    <RenderHandItem>
      <SpriteRender name="s_FrontArm" offset="-4,0" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="Punch.False"/>
      <SpriteRender name="s_FrontArm" offset="-2,0" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="Punch.True"/>
    </RenderHandItem>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_sword" offset="8, 1" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
    </RenderBackHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">700</Set>
        <Set name="Curve">
          <KeyFrame>0.0, 215</KeyFrame>
          <KeyFrame>0.3, 360</KeyFrame>
          <KeyFrame>0.8, 360</KeyFrame>
          <KeyFrame>0.81, 215</KeyFrame>
          <KeyFrame>1, 215</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitEmbers" />
      <ParticleSystemUpdate name="ps_hitFlash"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_FrontArm" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="10,26"/>
    <Sprite name="s_PunchFireSprite" fileName="game/particles11.rttex" textureSize="32" frame="19,21" />
    <Sprite name="s_idleFlame" fileName="game/particles9.rttex" textureSize="32" frame="0,8"/>
    <Sprite name="s_emberHit" fileName="game/particles11.rttex" textureSize="32" frame="24,21" />

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsAction>IDLE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsAction operatorType="NotEqual">IDLE</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_PunchArm" sprite="s_FrontArm" animTime="100" isLoop="true" playOnState="Punch.False">
        <Frame>10,26</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_NonPunchArm" sprite="s_FrontArm" animTime="100" isLoop="true" playOnState="Punch.True">
        <Frame>11,26</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>

    <TileStampData>
      <Set name="FileName">game/particles11.rttex</Set>
      <Set name="EndFrame">29,18</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>

    <ParticleSystems>
      <ParticleSystem name="ps_hitEmbers">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_emberHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="-8" max="8" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_emberHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_PunchFire" updateStage="AddClothingParticles" renderStage="RenderHandItem" updateState="Punch.True">
        <Emitter attachment="handspotRoot">
          <Set name="offset">-8, 2</Set>
          <Random name="emissionInterval" min="0.001" max="0.005" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_PunchFireSprite</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.8, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 0.3</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Random name="targetPosOffset" min="-12,-8" max="12,8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.7" angleOutVar="projectile_angle"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_shieldFlames" updateStage="AddClothingParticles" renderStage="RenderHandItem" updateState="Motion.Idle">
        <Emitter>
          <Random name="offset" min="-8, -2" max="-6, -10" />
          <Random name="emissionInterval" min="0.05" max="0.1" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_idleFlame</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.2</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 0.4</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.1" max="0.3" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>

  <RenderRules>
    <RenderHandItem>
      <SpriteRender name="s_FrontArm" offset="-4,0" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="Punch.False"/>
      <SpriteRender name="s_FrontArm" offset="-2,0" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="Punch.True"/>
    </RenderHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitEmbers" />
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_frontSpear" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="2,6"/>
    <Sprite name="s_backSpear" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="3,6"/>
    <Sprite name="glove" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="18,22"/>
    <Sprite name="hit_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="19,27"/>
    <Sprite name="s_punchStraight" fileName="game/particles11.rttex" textureSize="32" frame="18,27"/>
    <Sprite name="s_punchCurve" fileName="game/particles_large10.rttex" textureSize="64" frame="14,9"/>

    <Animations>
      <SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="hit_Sprite">
        <Frame>19,27</Frame>
        <Frame>20,27</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_punchCurved">
        <Emitter onPunchCount="odd">
          <Set name="offset">0,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchCurve</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchStraight">
        <Emitter onPunchCount="even">
          <Set name="offset">0,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchStraight</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="hit_particle">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">10</Set>
          <Set name="delayTimer">0.0</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">hit_Sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initalRGB">1,1,1</Set>
          <Set name="initialScale">1,1</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">true</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL|DANCE">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-130</Set>
      </AvatarTransform>
    </Update>
    <AddClothingParticles>
      <StopIf>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
    </AddClothingParticles>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="glove" offset="-4.6,11" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_backSpear" offset="8,4" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackHandItem>
    <RenderHandItem>
      <SpriteRender name="glove" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_frontSpear" offset="0,8" rotateOffset="true" useFixedRotation="true" blend="PREMULTIPLIED_ALPHA" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL|DANCE"/>
      <SpriteRender name="s_frontSpear" offset="0,8" rotateOffset="true" rotateToTarget="true" blend="PREMULTIPLIED_ALPHA" onAction="PUNCH"/>
    </RenderHandItem>
    <OnPunchStart>
      <ParticleSystemUpdate name="ps_punchCurved"/>
      <ParticleSystemUpdate name="ps_punchStraight"/>
    </OnPunchStart>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1080</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1080</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="hit_particle"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="hit_particle"/>
    </OnDestroyedTile>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_punchCurved"/>
      <ParticleSystemOff name="ps_punchStraight"/>
      <ParticleSystemOff name="hit_particle"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_DUAL_SPEARS_OF_DIARMUID">
	<Data>
		<Sprite name="red_spear_Sprite" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="5,2"/>
		<Sprite name="yellow_spear_Sprite" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="4,2"/>
		<Sprite name="glove" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="21,11"/>
		<Sprite name="hit_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="particle_red" fileName="game/particles11.rttex" textureSize="32" frame="23,15"/>
		<Sprite name="particle_yellow" fileName="game/particles_large12.rttex" textureSize="64" frame="14,0"/>
		
		<Animations>
			<SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="hit_Sprite">
				<Frame>21,15</Frame>
				<Frame>22,15</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="yellow_slash_particle">
				<Emitter onPunchCount="odd">
					<Set name="offset">0,-18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">particle_yellow</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="initialScale">2,2</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="red_slash_particle">
				<Emitter onPunchCount="even">
					<Set name="offset">0,-18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">particle_red</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="initialScale">2,2</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">10</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL|DANCE">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-130</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</AddClothingParticles>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<SpriteRender name="glove" offset="-4.6,11" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
			<SpriteRender name="yellow_spear_Sprite" offset="8,4" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackHandItem>
		<RenderHandItem>
			<SpriteRender name="glove" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
			<SpriteRender name="red_spear_Sprite" offset="0,8" rotateOffset="true" useFixedRotation="true" blend="PREMULTIPLIED_ALPHA" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL|DANCE"/>
			<SpriteRender name="red_spear_Sprite" offset="0,8" rotateOffset="true" rotateToTarget="true" blend="PREMULTIPLIED_ALPHA" onAction="PUNCH"/>
		</RenderHandItem>
		<OnPunchStart>
			<ParticleSystemUpdate name="yellow_slash_particle"/>
			<ParticleSystemUpdate name="red_slash_particle"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1080</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1080</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDestroyedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="yellow_slash_particle"/>
			<ParticleSystemOff name="red_slash_particle"/>
			<ParticleSystemOff name="hit_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
    <Sprite name="s_hood" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="6,1" />
    <Sprite name="s_wings" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="6,0" />
        <Animations>
      <SpriteAnimation name="a_wings" sprite="s_wings" isLoop="true" autoPlay="true" animTime="600">
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>8,0</Frame>
                <Frame>9,0</Frame>
                <Frame>10,0</Frame>
                <Frame>11,0</Frame>
            </SpriteAnimation>
        </Animations>
        <ParticleSystems />
    </Data>
    <RenderRules>
        <RenderHair>
            <Translate>0,-20,0</Translate>
            <SpriteRender name="s_hood" drawShadow="true" />
        </RenderHair>
        <RenderBackHair>
            <Translate>0,-20,0</Translate>
            <SpriteRender name="s_wings" drawShadow="true" />
        </RenderBackHair>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_clouds" fileName="game/particles12.rttex" textureSize="32" frame="30,15" />
		<Sprite name="s_clouds2" fileName="game/particles12.rttex" textureSize="32" frame="30,15" />
		<Sprite name="s_gardland" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="4, 7" />
		<Animations>
			<SpriteAnimation name="a_clouds" sprite="s_clouds" animTime="200" autoPlay="true" isLoop="true">
				<Frame>30, 15</Frame>
				<Frame>31, 15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_clouds2" sprite="s_clouds2" animTime="200" autoPlay="true" isLoop="true">
				<Frame>31, 15</Frame>
				<Frame>30, 15</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_cloud_1" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -6</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">2.3</Set>
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="-14, -2" max="14, 5" />
					<Set name="sprite">s_clouds</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="lifeTime">5</Set>
					<Random name="initialScale" min="0.75" max="1.25"/>
					<Random name="initialVelocity" min="-5,-1" max="5,1"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 0.9</KeyFrame>
						<KeyFrame>0.7, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_cloud_2" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">2, -16</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">2.6</Set>
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="15, -6" max="-15, 6" />
					<Set name="sprite">s_clouds2</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="lifeTime">5</Set>
					<Random name="initialScale" min="0.75" max="1.25"/>
					<Random name="initialVelocity" min="-5,-1" max="5,1"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 0.9</KeyFrame>
						<KeyFrame>0.7, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
			</StopIf>
			<!--<ParticleSystemRender name="ps_cloud_1" />-->
		</RenderBehind>
		<RenderChestItem>
			<SpriteRender name="s_gardland" offset="0,0" alignment="DOWN_CENTER" />
			<!--<ParticleSystemRender name="ps_cloud_2" />-->
		</RenderChestItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wings" fileName="game/particles_large17.rttex" textureSize="64" frame="4,6" />
    <Sprite name="s_flare" fileName="game/particles_large17.rttex" textureSize="64" frame="8,6" />
    <Sprite name="s_bokeh" fileName="game/particles_large17.rttex" textureSize="64" frame="9,6" />

    <Animations>
      <SpriteAnimation name="a_wings" sprite="s_wings">
        <Frame>4,6</Frame>
        <Frame>5,6</Frame>
        <Frame>6,6</Frame>
        <Frame>7,6</Frame>
      </SpriteAnimation>

      <SequenceAnimation name="flash_sequence" playOnState="SelfieTake.Max">
        
        <InterpolationFloatAnimation name="saturationValueTo" variableName="saturationValue" targetVariableName="saturationValueMax" animTime="0"/>

        <InterpolationFloatAnimation name="contrastValueTo" variableName="contrastValue" targetVariableName="contrastValueMax" animTime="0"/>

        <InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" targetVariableName="brightnessValueWhite" animTime="0"/>

        <DelayAnimation delayTime="200" />

        <InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" targetVariableName="brightnessValueBlack" animTime="0"/>

        <DelayAnimation delayTime="100" />

        <InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" targetVariableName="brightnessValueWhite" animTime="0"/>
        
      </SequenceAnimation>
      
      <InterpolationFloatAnimation name="saturationValueFrom" variableName="saturationValue" playOnState="SelfieTake.Default" targetVariableName="saturationValueDefault" animTime="600"/>

      <InterpolationFloatAnimation name="contrastValueFrom" variableName="contrastValue" playOnState="SelfieTake.Default" targetVariableName="contrastValueDefault" animTime="600"/>

      <InterpolationFloatAnimation name="brightnessValueFrom" variableName="brightnessValue" playOnState="SelfieTake.Default" targetVariableName="brightnessValueDefault" animTime="600"/>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_wingsLeft" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0,-16</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_wings</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="renderAlignment">RIGHT_CENTER</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.45, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.3, 0.3</KeyFrame>
            <KeyFrame>1, 1.1, 1.1</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_wingsRight" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0,-16</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_wings</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="flipX">true</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.45, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.3, 0.3</KeyFrame>
            <KeyFrame>1, 1.1, 1.1</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_flare">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flare</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-10,-10" max="10,10" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 2.6,2.6</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_bokeh" renderStage="RenderInFront">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_bokeh</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-10,-10" max="10,10" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 1.5,1.5</KeyFrame>
          </Curve>
          <Random name="lifeTime" min="0.5" max="2" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <VariableMap>
      <Set name="saturationValue">1</Set>
      <Set name="saturationValueMax">0</Set>
      <Set name="brightnessValue">1</Set>
      <Set name="brightnessValueWhite">100</Set>
      <Set name="brightnessValueBlack">0</Set>
      <Set name="contrastValue">0</Set>
      <Set name="contrastValueMax">0</Set>

      <Set name="saturationValueDefault">1</Set>
      <Set name="contrastValueDefault">0</Set>
      <Set name="brightnessValueDefault">1</Set>

      <Set name="flashTimer">0</Set>
    </VariableMap>
    <StateMachines>
      <StateMachine name="SelfieTake">
        <States>
          <State name="Default" />
          <State name="Max" ExitTime="0.6" />
        </States>
        <Transitions>
          <Transition to="Default" from="Max"/>
          <Transition to="Max" from="Default">
            <Condition  type="and">
              <IsAction>JUMPDOUBLE</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
  </Data>
  <RenderRules>
    <AddClothingParticles>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_flare" onAction="JUMPDOUBLE"/>
      <ParticleSystemUpdate name="ps_bokeh" onAction="JUMPDOUBLE"/>
    </AddClothingParticles>
    <OnDrawCustomOutline>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <AvatarTransform class="RenderData">
        <Set name="saturation">getCurrent</Set>
        <Set name="brightness">getCurrent</Set>
        <Set name="contrast">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="RenderData">
        <Set name="saturation">1.5</Set>
        <Set name="brightness">0.8</Set>
        <Set name="contrast">0.15</Set>
      </AvatarTransform>
      <AvatarOutline duration="1500" startScale="1.1,1.1" endScale="1.1,1.1">
        <Colours>
          <Colour>255,80,0,255</Colour>
        </Colours>
      </AvatarOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">reset</Set>
        <Set name="brightness">reset</Set>
        <Set name="contrast">reset</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">reset</Set>
      </AvatarTransform>
    </OnDrawCustomOutline>
    <RenderBackpack>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="ps_wingsLeft"/>
      <ParticleSystemRender name="ps_wingsRight"/>
      <ParticleSystemRender name="ps_flare"/>
      <AvatarTransform class="RenderData">
        <Set name="saturation">saturationValue</Set>
        <Set name="brightness">brightnessValue</Set>
        <Set name="contrast">contrastValue</Set>
      </AvatarTransform>
      <StopIf>
        <IsVariableBool name="isMannequin">false</IsVariableBool>
      </StopIf>
      <SpriteRender name="s_wings" offset="0,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="ADDITIVE"/>
      <SpriteRender name="s_wings" offset="0,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="ADDITIVE"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_pendant" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="31,26" />
    <Sprite name="s_transform" fileName="game/tf_page4.rttex" textureSize="64" frame="0,3" />
    <Sprite name="s_flash" fileName="game/tf_page4.rttex" textureSize="64" frame="11,4" />
    <Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32" frame="6,4" />
    <Sprite name="s_shard" fileName="game/particles12.rttex" textureSize="32" frame="8,4" />
    <Sprite name="s_hit" fileName="game/particles_large15.rttex" textureSize="64" frame="11,0" />
    <Sprite name="s_break" fileName="game/particles_large15.rttex" textureSize="64" frame="12,0" />

    <StateMachines>
      <StateMachine name="Main">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="Jump" />
          <State name="Fall" />
          <State name="PunchOnGround" />
          <State name="PunchInAir" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|Fall|PunchOnGround|Jump|PunchInAir">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|Fall|PunchOnGround|PunchInAir|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Walk|Fall|PunchInAir|PunchOnGround">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Walk|PunchInAir|PunchOnGround">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="PunchOnGround" from="Idle|Walk|PunchInAir|Jump|Fall">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="PunchInAir" from="Idle|Walk|Jump|Fall|PunchOnGround">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="IsTransformed">
        <States>
          <State name="No" />
          <State name="Transition" />
          <State name="Yes" />
        </States>
        <Transitions>
          <Transition to="Yes" from="Transition">
            <Condition>
              <IsItemTransformed>true</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="No" from="Transition">
            <Condition>
              <IsItemTransformed>false</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="Transition" from="No">
            <Condition>
              <IsItemTransformed>true</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="Transition" from="Yes">
            <Condition>
              <IsItemTransformed>false</IsItemTransformed>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="IncludeAllActions">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="AllowChangePunchType">true</Set>
      </Default>
      <Override overrideOnState="IsTransformed.Yes">
        <Set name="UserNameOffset">16</Set>
      </Override>
    </RenderOptions>
    <TileStampData>
      <Set name="FileName">game/particles12.rttex</Set>
      <Set name="EndFrame">9,5</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>
    <Animations>
      <SpriteAnimation name="a_idle" sprite="s_transform" animTime="800" isLoop="true" playOnState="Main.Idle">
        <Frame>0,3</Frame>
        <Frame>1,3</Frame>
        <Frame>2,3</Frame>
        <Frame>3,3</Frame>
        <Frame>4,3</Frame>
        <Frame>5,3</Frame>
        <Frame>6,3</Frame>
        <Frame>7,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_walk" sprite="s_transform" animTime="600" isLoop="true" playOnState="Main.Walk">
        <Frame>8,3</Frame>
        <Frame>9,3</Frame>
        <Frame>10,3</Frame>
        <Frame>11,3</Frame>
        <Frame>12,3</Frame>
        <Frame>13,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump" sprite="s_transform" animTime="100" isLoop="true" playOnState="Main.Jump">
        <Frame>14,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall" sprite="s_transform" animTime="200" isLoop="true" playOnState="Main.Fall">
        <Frame>15,3</Frame>
        <Frame>15,4</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punch" sprite="s_transform" animTime="1100" isLoop="true" playOnState="Main.PunchOnGround">
        <Frame>0,4</Frame>
        <Frame>1,4</Frame>
        <Frame>2,4</Frame>
        <Frame>3,4</Frame>
        <Frame>4,4</Frame>
        <Frame>5,4</Frame>
        <Frame>6,4</Frame>
        <Frame>7,4</Frame>
        <Frame>8,4</Frame>
        <Frame>9,4</Frame>
        <Frame>10,4</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchFallJump" sprite="s_transform" animTime="400" isLoop="true" playOnState="Main.PunchInAir">
        <Frame>12,4</Frame>
        <Frame>13,4</Frame>
        <Frame>14,4</Frame>
        <Frame>15,4</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shards" sprite="s_shard">
        <Frame>8,4</Frame>
        <Frame>9,4</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchParticles" sprite="s_slash">
        <Frame>6,4</Frame>
        <Frame>7,4</Frame>
      </SpriteAnimation>
    </Animations>
    <ParticleSystems>
      <ParticleSystem name="p_flash" updateStage="AddClothingParticles" updateState="IsTransformed.Transition">
        <Emitter>
          <Set name="offset">0, -32</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_flash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_flashShards" updateStage="AddClothingParticles" updateState="IsTransformed.Transition">
        <Emitter>
          <Set name="offset">0, -32</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true" usePlayerFacing="true">
          <Set name="sprite">s_shard</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.8, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.5,0.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="120,170" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_hit" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="delayTimer">0.1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.8,0.8</KeyFrame>
            <KeyFrame>1, 1.2, 1.2</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_punch" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">10, -26</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle alternateSpriteFrameWithPunch="true" autoLifeTimeToTarget="true" >
          <Set name="sprite">s_slash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="initialScale">2, 2</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <RandomRadial name="initialVelocity" angleRange="0" radiusRange="160,160" baseAnglePosition="targetPos" baseOffset="0,16"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitEmbers" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_shard</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="-4,-3" max="4,3" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="80,200" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakLogo" updateStage="OnDestroyedTile">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_break</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">2</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <RenderChestItem>
      <SpriteRender name="s_pendant" alignment="DOWN_CENTER" />
    </RenderChestItem>
    <RenderTransform>
      <SpriteRender name="s_transform" blend="PREMULTIPLIED_ALPHA" offset="0,-8" />
    </RenderTransform>
	<OnDamagedTile>
		<StopIf>
			<IsItemTransformed>false</IsItemTransformed>
		</StopIf>
	</OnDamagedTile>
    <OnDestroyedTile>
		<StopIf>
			<IsItemTransformed>false</IsItemTransformed>
		</StopIf>
	</OnDestroyedTile>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_tentacle" fileName="game/particles12.rttex" textureSize="32" frame="26,16" />
    <Sprite name="s_mist" fileName="game/particles_large17.rttex" textureSize="64" frame="6,12" />
    <Sprite name="s_tileHit" fileName="game/particles4.rttex" textureSize="32" frame="4,2" />
    <Sprite name="s_eyes" fileName="game/particles_large17.rttex" textureSize="64" frame="15,11" />
    <Sprite name="s_cthulu" fileName="game/particles_large17.rttex" textureSize="64" frame="0,12" />
    <Sprite name="s_chest" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="19,7" />
    <Sprite name="s_pet" fileName="game/pets/p_espawn.rttex" textureSize="32" frame="0,0" />

    <Animations>
      <SpriteAnimation name="a_Attack" sprite="s_tentacle" animTime="500" isLoop="true" playOnState="PunchAnim.Continue">
        <Frame>26,16</Frame>
        <Frame>27,16</Frame>
        <Frame>28,16</Frame>
        <Frame>29,16</Frame>
        <Frame>30,16</Frame>
        <Frame>31,16</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_cthuluAttack" sprite="s_cthulu" animTime="600" isLoop="true" playOnState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End">
        <Frame>0,12</Frame>
        <Frame>1,12</Frame>
        <Frame>2,12</Frame>
        <Frame>3,12</Frame>
        <Frame>4,12</Frame>
        <Frame>5,12</Frame>
      </SpriteAnimation>

      <SpriteCurveAnimation name="a_cthuluStart" isLoop="false" playOnState="PunchAnim.Start" sprite="s_cthulu" animTime="200">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_eyesStart" isLoop="false" playOnState="PunchAnim.Start" sprite="s_eyes" animTime="200">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_cthuluEnd" isLoop="false" playOnState="PunchAnim.End" sprite="s_cthulu" animTime="200">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_eyesEnd" isLoop="false" playOnState="PunchAnim.End" sprite="s_eyes" animTime="200">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_cthuluContinue" isLoop="true" playOnState="PunchAnim.Continue" sprite="s_cthulu" animTime="500">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_eyesContinue" isLoop="true" playOnState="PunchAnim.Continue" sprite="s_eyes" animTime="500">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      
      <SpriteAnimation name="a_Attack" sprite="s_pet" animTime="100" isLoop="true" playOnState="Motion.Punch">
        <Frame>4,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Fall" sprite="s_pet" animTime="100" isLoop="true" playOnState="Motion.Down">
        <Frame>3,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Idle" sprite="s_pet" animTime="400" isLoop="true" playOnState="Motion.None">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Jump" sprite="s_pet" animTime="100" isLoop="true" playOnState="Motion.Up">
        <Frame>2,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Move" sprite="s_pet" animTime="600" isLoop="true" playOnState="Motion.Horizontal">
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="punch_start_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tentacle</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="lifeTime">0.2</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 0</KeyFrame>
            <KeyFrame>1, 1, 3</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_continue_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="delayTimer">0.23</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tentacle</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="initialScale">1,3</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_end_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tentacle</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="lifeTime">0.2</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 3</KeyFrame>
            <KeyFrame>1, 1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_mistBack">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="rgbTint">0, 0, 0, 1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.25</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Set name="initialVelocity">0, 0</Set>
          <Random name="offset" min="20,0" max="-20,0" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_mistFront">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="emissionInterval">0.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.25</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Set name="initialVelocity">0, 0</Set>
          <Random name="offset" min="-16,0" max="16,0" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tileHit">
        <Emitter attachment="targetPos">
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tileHit</Set>
          <Random name="offset" min="-16,-16" max="16,16" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5,0.75" max="0.5,1" />
          <Set name="lifeTime">0.2</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_cthuluMist">
        <Emitter>
          <Set name="offset">-28, -36</Set>
          <Set name="emissionInterval">0.5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">3</Set>
          <Set name="initialVelocity">0, 0</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="None" />
          <State name="Up" />
          <State name="Down" />
          <State name="Horizontal" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch|Up|Down|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Up" from="Punch|None|Down|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Down" from="Punch|None|Up|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Horizontal" from="Punch|None|Down|Up">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None|Up|Down|Horizontal">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="PunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start" ExitTime="0.2"/>
          <State name="Continue"/>
          <State name="End" ExitTime="0.2"/>
        </States>
        <Transitions>
          <Transition from="Off|End" to="Start">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Continue|Start" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-36,0</Set>
        <Set name="UsePetForceFaceTime">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnorePunchTypeCheck">false</Set>
        <Set name="UserNameOffset">16</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <Update>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="punch_continue_particle" />
      <ParticleSystemUpdate name="ps_mistBack" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
      <ParticleSystemUpdate name="ps_mistFront" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
    </Update>
    <AddClothingParticles>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_cthuluMist" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
      <ParticleSystemUpdate name="ps_tileHit" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
    </AddClothingParticles>
    <OnPunchBegin>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemOff name="punch_continue_particle" />
      <ParticleSystemOff name="punch_end_particle" />
      <ParticleSystemUpdate name="punch_start_particle" />
    </OnPunchBegin>
    <OnPunchStop>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemOff name="punch_continue_particle" />
      <ParticleSystemOff name="punch_start_particle" />
      <ParticleSystemUpdate name="punch_end_particle" />
    </OnPunchStop>
    <RenderInFront>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="ps_mistBack"/>
      <ParticleSystemRender name="punch_start_particle" onState="PunchAnim.Start" />
      <ParticleSystemRender name="punch_continue_particle" onState="PunchAnim.Continue" />
      <ParticleSystemRender name="punch_end_particle" onState="PunchAnim.End" />
      <ParticleSystemRender name="ps_mistFront"/>
    </RenderInFront>
    <RenderBehind>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <SpriteRender name="s_cthulu" offset="-16,-16" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
      <ParticleSystemRender name="ps_cthuluMist"/>
      <SpriteRender name="s_eyes" offset="-16,-16" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
    </RenderBehind>
    <RenderChestItem>
      <SpriteRender name="s_chest" offset="0,0" alignment="DOWN_CENTER" />
    </RenderChestItem>
    <RenderPet>
      <SpriteRender name="s_pet" offset="0,0" alignment="DOWN_CENTER" />
    </RenderPet>
    <UpdatePet>
      <ContextUpdate type="SetPetWalkRunJump">
        <Set name="PetWalkRunJump.minSpeed">500</Set>
        <Set name="PetWalkRunJump.distSpeedMult">20</Set>
      </ContextUpdate>
    </UpdatePet>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_ENBARR_THE_FLOWING_MANE">
	<Data>
		<Sprite name="foot1_Sprite" fileName="game/player_feet16.rttex" textureSize="32"/>
		<Sprite name="foot2_Sprite" fileName="game/player_feet16.rttex" textureSize="32"/>
		<Sprite name="splash_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
		
		<Animations>
			<SpriteAnimation name="foot1_Idle" playOnAction="IDLE|PUNCH" sprite="foot1_Sprite" isLoop="true" animTime="800">
				<Frame>1,20</Frame>
				<Frame>2,20</Frame>
				<Frame>3,20</Frame>
				<Frame>4,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Idle" playOnAction="IDLE|PUNCH" sprite="foot2_Sprite" isLoop="true" animTime="800">
				<Frame>1,21</Frame>
				<Frame>2,21</Frame>
				<Frame>3,21</Frame>
				<Frame>4,21</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Move" playOnAction="WALK" sprite="foot1_Sprite" isLoop="true" animTime="400">
				<Frame>1,20</Frame>
				<Frame>1,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Move" playOnAction="WALK" sprite="foot2_Sprite" isLoop="true" animTime="400">
				<Frame>1,21</Frame>
				<Frame>1,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Swim" playOnAction="SWIM" sprite="foot1_Sprite" isLoop="true" animTime="400">
				<Frame>1,20</Frame>
				<Frame>1,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Swim" playOnAction="SWIM" sprite="foot2_Sprite" isLoop="true" animTime="400">
				<Frame>1,21</Frame>
				<Frame>1,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Jump" playOnAction="JUMP" sprite="foot1_Sprite">
				<Frame>2,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Jump" playOnAction="JUMP" sprite="foot2_Sprite">
				<Frame>2,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Fall" playOnAction="FALL" sprite="foot1_Sprite">
				<Frame>3,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Fall" playOnAction="FALL" sprite="foot2_Sprite">
				<Frame>3,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="splash_Sprites" autoPlay="false" sprite="splash_Sprite" animTime="500">
				<Frame>28,16</Frame>
				<Frame>29,16</Frame>
				<Frame>30,16</Frame>
				<Frame>31,16</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="splash_particle">
				<Emitter>
					<Set name="infLifeTime">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">3</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.1</Set>
					<Set name="intervalMax">0.2</Set>
					<Set name="offset">0,-8</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="-15,0" max="15,0"/>
					<Set name="sprite">splash_Sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1,1</Set>
					<Select name="finalAlpha" input="randomNumber">
						<Item>1</Item>
						<Item>0</Item>
						<Item>0</Item>
					</Select>
					<Set name="initialAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>	 
		
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-7</Set>
				<Set name="IsToRenderPants">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="IsHorse">true</Set>
				<Set name="IsSurfboard">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
		
	</Data>

	<RenderRules>
		<RenderShoes>
			<SpriteRender name="foot1_Sprite" offset="2,8" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT"/>
			<SpriteRender name="foot2_Sprite" offset="2,8" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT"/>
		</RenderShoes>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<AddClothingParticles>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ParticleSystemUpdate name="splash_particle" onAction="IDLE|WALK|PUNCH|SWIM"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="splash_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_foot1" fileName="game/player_feet16.rttex" textureSize="32" frame="9,26" />
    <Sprite name="s_foot2" fileName="game/player_feet16.rttex" textureSize="32" frame="9,27" />
    <Sprite name="s_moon" fileName="game/particles12.rttex" textureSize="32" frame="25,16" />
    <Sprite name="s_trees" fileName="game/particles_large17.rttex" textureSize="64" frame="12,10" />
    <Sprite name="s_grass" fileName="game/particles_large17.rttex" textureSize="64" frame="15,9" />
    <Sprite name="s_firefly" fileName="game/particles12.rttex" textureSize="32" frame="24,16" />

    <Animations>
      <SpriteAnimation name="a_trees" autoPlay="true" isLoop="true" sprite="s_trees"  animTime="800">
        <Frame>12,10</Frame>
        <Frame>13,10</Frame>
        <Frame>14,10</Frame>
        <Frame>15,10</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_firefly" autoPlay="true" isLoop="true" sprite="s_firefly"  animTime="600">
        <Frame>23,16</Frame>
        <Frame>24,16</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_grass" isLoop="true" autoPlay="true" sprite="s_grass" animTime="10000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.75f</KeyFrame>
          <KeyFrame>1.f, 0.75f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_fireflies_back">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">2.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
        </Emitter>
        <Particle>
          <Random name="offset" min="-16,-32" max="16,-16" />
          <Set name="sprite">s_firefly</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="lifeTime">5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.25, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="1" max="1.5"/>
          <Select name="initialVelocity" input="randomNumber">
            <Item>5,5</Item>
            <Item>5,-5</Item>
            <Item>-5,5</Item>
            <Item>-5,-5</Item>
          </Select>
          <Select name="finalVelocity" input="randomNumber">
            <Item>5,5</Item>
            <Item>5,-5</Item>
            <Item>-5,5</Item>
            <Item>-5,-5</Item>
          </Select>
          <Set name="interpolateVelocity">true</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_fireflies_front">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">2.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
        </Emitter>
        <Particle>
          <Random name="offset" min="-16,-32" max="16,-16" />
          <Set name="sprite">s_firefly</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="lifeTime">5</Set>
          <Random name="initialScale" min="1" max="1.5"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.25, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Select name="initialVelocity" input="randomNumber">
            <Item>5,5</Item>
            <Item>5,-5</Item>
            <Item>-5,5</Item>
            <Item>-5,-5</Item>
          </Select>
          <Select name="finalVelocity" input="randomNumber">
            <Item>5,5</Item>
            <Item>5,-5</Item>
            <Item>-5,5</Item>
            <Item>-5,-5</Item>
          </Select>
          <Set name="interpolateVelocity">true</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <VariableMap>
      <Set name="leftFootYPos">0,0,0</Set>
      <Set name="rightFootYPos">0,0,0</Set>
    </VariableMap>
    <RenderOptions>
      <Default>
        <Set name="UserNameOffset">20</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_fireflies_back"/>
      <ParticleSystemUpdate name="ps_fireflies_front"/>
    </AddClothingParticles>
    <RenderBehind value="playerGround">
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <ContextUpdate type="SetFlip">
        <Set name="flip">0,0</Set>
      </ContextUpdate>
      <SpriteRender name="s_moon" offset="16,-52" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      <ParticleSystemRender name="ps_fireflies_back"/>
      <SpriteRender name="s_trees" offset="0,-28" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      <ParticleSystemRender name="ps_fireflies_front"/>
    </RenderBehind>
    <RenderShoes>
      <Group>
        <Translate>leftFootYPos</Translate>
        <SpriteRender name="s_foot1" alignment="DOWN_CENTER" />
      </Group>
      <Group>
        <Translate>rightFootYPos</Translate>
        <SpriteRender name="s_foot2" alignment="DOWN_CENTER" />
      </Group>
    </RenderShoes>
    <RenderInFront value="playerGround">
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <ContextUpdate type="SetFlip">
        <Set name="flip">0,0</Set>
      </ContextUpdate>
      <SpriteRender name="s_grass" offset="0,5" blend="PREMULTIPLIED_ALPHA" drawShadow="false" alignment="DOWN_CENTER"/>
    </RenderInFront>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_ERWINHERS_SAIJO_O_WAZAMONO">
	<Data>
		<Sprite name="sword_Sprite" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="6,1"/>
		<Sprite name="sword_glowing_Sprite" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="7,1"/>
		<Sprite name="sword_slash_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="9,14"/>
		<Sprite name="hit_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="12,14"/>
		<Sprite name="break_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="11,14"/>

		<Animations>
			<SpriteCurveAnimation name="sword_glowing_Sprite_idle" isLoop="true" playOnAction="IDLE|WALK|FALL|JUMP" sprite="sword_glowing_Sprite" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="sword_glowing_Sprite_punch" isLoop="true" playOnAction="PUNCH" sprite="sword_glowing_Sprite" animTime="100">
				<Curve name="alpha">
					<KeyFrame>0.f, 1.f</KeyFrame>
					<KeyFrame>1.f, 1.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="sword_slash_frames" autoPlay="false" sprite="sword_slash_Sprite">
				<Frame>10,14</Frame>
				<Frame>9,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="hit_Sprite">
				<Frame>13,14</Frame>
				<Frame>14,14</Frame>
				<Frame>12,14</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="slash_particle">
				<Emitter>
					<Set name="offset">0,-22</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Set name="sprite">sword_slash_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">2</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="gravityVector">0, 100</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialRotationRate">15</Set>
					<Set name="finalRotationRate">5</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1,1</Set>
					<Random name="finalScale" min="0.2" max="0.5"/>
					<Set name="interpolateAngle">true</Set>
					<Random name="initialAngle" min="-360" max="360"/>
					<Random name="finalAngle" min="-360" max="360"/>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="13.5,150"/>
					<Random name="posOffset" min="0, 0" max="16,16"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="break_particle">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">break_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="finalScale">1.3,1.3</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="PunchSoundOverride">HAND</Set>
			</Default>
		</RenderOptions>
		
	</Data>

	<RenderRules>
		<RenderHandItem value="1.23,7.3" >
			<SpriteRender name="sword_Sprite"/>
			<SpriteRender name="sword_glowing_Sprite" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
		</RenderHandItem>
		<RenderInFront>
			<ParticleSystemRender name="break_particle"/>
			<ParticleSystemRender name="hit_particle"/>
		</RenderInFront>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnPunchStart>
			<ParticleSystemUpdate name="slash_particle"/>
		</OnPunchStart>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="break_particle"/>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDestroyedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="slash_particle"/>
			<ParticleSystemOff name="hit_particle"/>
			<ParticleSystemOff name="break_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_glow" fileName="game/particles_large18.rttex" textureSize="64" frame="15,5" />
    <Sprite name="s_wheat" fileName="game/particles_large18.rttex" textureSize="64" frame="13,5" />
    <Sprite name="s_carrot" fileName="game/particles_large18.rttex" textureSize="64" frame="14,5" />
    
    <Animations>
      <SpriteCurveAnimation name="a_glow" isLoop="true" autoPlay="true" sprite="s_glow" animTime="10000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.5f</KeyFrame>
          <KeyFrame>0.45f, 1.f </KeyFrame>
          <KeyFrame>0.55f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.5f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_wheat" autoPlay="true" isLoop="true" sprite="s_wheat" animTime="10000">
        <Curve name="rotation">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, -360</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_carrot" autoPlay="true" isLoop="true" sprite="s_carrot" animTime="10000">
        <Curve name="rotation">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, 360</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>
    <ParticleSystems />
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="DisableDefaultAncestralParticleEffects">true</Set>
        <Set name="UserNameOffset">16</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderBehind value="playerCenter">
      <ContextUpdate type="SetFlip">
        <Set name="flip">0,0</Set>
      </ContextUpdate>
      <Translate>0,-28,0</Translate>
      <SpriteRender name="s_glow" alignment="CENTER" scale="1.5,1.5" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      <Scale>0.9,0.9,1</Scale>
      <SpriteRender name="s_wheat"  alignment="CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      <SpriteRender name="s_carrot" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
    </RenderBehind>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_cape" fileName="game/particles12.rttex" textureSize="32" frame="18,15" />
    <Sprite name="s_mantle" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="22,6" />
    <Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="28,15" />
    <Animations>
      <SpriteAnimation name="a_cape" sprite="s_cape" animTime="1000" autoPlay="true" isLoop="true">
        <Frame>18,15</Frame>
        <Frame>19,15</Frame>
        <Frame>20,15</Frame>
        <Frame>21,15</Frame>
        <Frame>22,15</Frame>
        <Frame>23,15</Frame>
        <Frame>24,15</Frame>
        <Frame>25,15</Frame>
        <Frame>26,15</Frame>
        <Frame>27,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_trail" sprite="s_trail" animTime="200">
        <Frame>28,15</Frame>
        <Frame>29,15</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_trail" updateStage="AddClothingParticles" renderStage="RenderChestItem" updateState="Motion.Moving">
        <Emitter>
          <Set name="offset">0, -8</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="offset">-20,-8</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">true</Set>
          <Random name="offset" min="-8,-8" max="8,8" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="initialScale">0.4, 0.4</Set>
          <Set name="lifeTime">1.5</Set>
          <RandomRadial name="initialVelocity" angleRange="230,310" radiusRange="5,25" />
          <Random name="initialAngle" min="0" max="360" />
          <Random name="gravityVector" min="0, 15" max="0, 30" />
          <Random name="initialRotationRate" min="-60" max="60" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <RenderChestItem>
      <SpriteRender name="s_mantle" offset="0,-16" alignment="CENTER" />
    </RenderChestItem>
    <RenderChestBackItem>
      <SpriteRender name="s_cape" offset="-22,-14" alignment="CENTER" />
    </RenderChestBackItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="item_Sprite" fileName="game/particles_large16.rttex" textureSize="64" frame="10,9"/>
    <Sprite name="sparkle_sprite" fileName="game/particles12.rttex" textureSize="32" frame="31,6"/>
    <Sprite name="jump_trail_sprite" fileName="game/particles12.rttex" textureSize="32" frame="30,7"/>
    <Sprite name="jump_heart_sprite" fileName="game/particles12.rttex" textureSize="32" frame="31,7"/>
    <Sprite name="double_jump_particle_Sprite" fileName="game/particles12.rttex" textureSize="32"/>
    <Animations>
	    <SpriteAnimation name="double_jump_particle_Sprite_frames"  autoPlay="false" isLoop="false" sprite="double_jump_particle_Sprite"  animTime="100">
		    <Frame>29,8</Frame>
		    <Frame>30,8</Frame>
		    <Frame>31,8</Frame>
	    </SpriteAnimation>
	 </Animations>
    <ParticleSystems>
	    <ParticleSystem name="double_jump_particle">
		    <Emitter>
			    <Set name="offset">24, 0</Set>
			    <Set name="lifeTime">0</Set>
			    <Set name="particlesPerEmission">9</Set>
			    <Set name="delayTimer">0.1</Set>
				<Set name="checkParticleNumToEmit">false</Set>
		    </Emitter>
		    <Particle randomSpriteFrame="true">
			    <Set name="offset">0, -16</Set>
			    <Set name="sprite">double_jump_particle_Sprite</Set>
			    <Set name="blendingMode">ADDITIVE</Set>
			    <Set name="isBackgroundParticle">true</Set>
			    <Set name="initalRGB">1, 1, 1</Set>
			    <Set name="relativeToEmitter">false</Set>
			    <Set name="rotateWithVelocity">true</Set>
			    <Set name="lifeTime">0.75</Set>
			    <Random name="initialScale" min="0.2" max="0.5"/>
			    <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,100"/>
		    </Particle>
	    </ParticleSystem>
		<ParticleSystem name="double_jump_particle2">
		    <Emitter>
			    <Set name="offset">-24, 0</Set>
			    <Set name="lifeTime">0</Set>
			    <Set name="particlesPerEmission">9</Set>
			    <Set name="delayTimer">0.1</Set>
				<Set name="checkParticleNumToEmit">false</Set>
		    </Emitter>
		    <Particle randomSpriteFrame="true">
			    <Set name="offset">0, -16</Set>
			    <Set name="sprite">double_jump_particle_Sprite</Set>
			    <Set name="blendingMode">ADDITIVE</Set>
			    <Set name="isBackgroundParticle">true</Set>
			    <Set name="initalRGB">1, 1, 1</Set>
			    <Set name="relativeToEmitter">false</Set>
			    <Set name="rotateWithVelocity">true</Set>
			    <Set name="lifeTime">0.75</Set>
			    <Random name="initialScale" min="0.2" max="0.5"/>
			    <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,100"/>
		    </Particle>
	    </ParticleSystem>
      <ParticleSystem name="sparklesParticle">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
	
          <Set name="particlesPerEmission">5</Set>
	       <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,0</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.15</Set>
	        <Set name="inSpecificOrder">true</Set>
	        <Set name="relativeToEmitter">false</Set>
	        <Select name="offset" input="randomNumber">
		        <Item>-30, -26.5</Item>
		        <Item>-24, -24</Item>
		        <Item>-18, -20</Item>
		        <Item>-12, -15.5</Item>

				<Item>-29.5, -21</Item>
		        <Item>-24, -17.5</Item>
		        <Item>-18, -14.5</Item>
				<Item>-12, -11</Item>

				<Item>-27, -13</Item>
		        <Item>-20.5, -9</Item>
		        <Item>-12, -6</Item>

				<Item>30, -27</Item>
		        <Item>24, -24</Item>
		        <Item>18, -20</Item>
		        <Item>12, -16</Item>

		        <Item>29, -22</Item>
		        <Item>24, -18</Item>
		        <Item>18, -14.5</Item>
		        <Item>12, -12</Item>

		        <Item>28, -14</Item>
		        <Item>20.5, -10</Item>
		        <Item>12, -7</Item>
	        </Select>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
	        <Random name="initialAngle" min="0" max="360" />
          <Set name="initialScale">0.5,0.5</Set>
          <Random name="initialVelocity" min="-10,15" max="10,20"/>
          <Random name="offset" min="-2, 0" max="2,0"/>
        </Particle>
      </ParticleSystem>
      
      <ParticleSystem name="jumpTrailParticle">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.025</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,6</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_trail_sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">1,1</Set>
		    <Set name="initialAngle">-90</Set>
			<Set name="isBackgroundParticle">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 250</Set>
        </Particle>
      </ParticleSystem>
   
      <ParticleSystem name="jumpHeartsParticle">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_heart_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 50</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.4,0.2</Set>
          <Increment name="initialScale" source="particleIndex" multiplier="0.2,0.1"/>
          <Set name="finalScale">1.2,0.6</Set>
          <Increment name="finalScale" source="particleIndex" multiplier="0.4,0.2"/>
          <Set name="offset">0,-30</Set>
          <Increment name="worldPos" source="particleIndex" multiplier="0,12"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="HideParticlesOnTransform">true</Set>
        <Set name="HideParticlesOnTheaterSeat">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
	<OnPunchUpdate>
	    <AvatarTransform class="Face">
	      <Set name="face">MAD</Set>
	    </AvatarTransform>
    </OnPunchUpdate>
    <RenderBackpack>
      <SpriteRender name="item_Sprite" offset="0,-32"/>
      <ParticleSystemRender name="sparklesParticle" />
    </RenderBackpack>
    <AddClothingParticles>
      <ParticleSystemUpdate name="sparklesParticle" onAction="IDLE|FALL|WALK|PUNCH|JUMP"/>
      <ParticleSystemUpdate name="jumpTrailParticle" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpHeartsParticle" onAction="JUMPSTART|JUMPDOUBLE"/>
      <ParticleSystemUpdate name="double_jump_particle" onAction="FALL|JUMPDOUBLE"/>
      <ParticleSystemUpdate name="double_jump_particle2" onAction="FALL|JUMPDOUBLE"/>
    </AddClothingParticles>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="sparklesParticle"/>
      <ParticleSystemOff name="jumpTrailParticle"/>
      <ParticleSystemOff name="jumpHeartsParticle"/>
	  <ParticleSystemOff name="double_jump_particle"/>
	  <ParticleSystemOff name="double_jump_particle2"/>

	</SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle"/>
          <State name="Move"/>
        </States>
        <Transitions>
          <Transition from="Move" to="Idle" >
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Idle" to="Move">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Sprite name="s_cartFront" fileName="game/particles_large14.rttex" textureSize="64" frame="13,10"/>
    <Sprite name="s_cartBack" fileName="game/particles_large14.rttex" textureSize="64" frame="12,10"/>
    <Sprite name="s_trailSpark" fileName="game/particles11.rttex" textureSize="32" frame="24,30"/>
    <Sprite name="s_trailSmoke" fileName="game/particles11.rttex" textureSize="32" frame="25,30"/>
    <Sprite name="s_trailSparks" fileName="game/particles11.rttex" textureSize="32" frame="26,30"/>
    
    <Animations>
      <SpriteAnimation name="a_cartFrontIdle" playOnState="Motion.Idle" sprite="s_cartFront" isLoop="true" animTime="100">
        <Frame>13,10</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_cartFrontMove" playOnState="Motion.Move" sprite="s_cartFront" isLoop="true" animTime="500">
        <Frame>11,11</Frame>
        <Frame>12,11</Frame>
        <Frame>13,11</Frame>
        <Frame>14,11</Frame>
        <Frame>15,11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_trailSparks" sprite="s_trailSparks">
        <Frame>26,30</Frame>
        <Frame>27,30</Frame>
        <Frame>28,30</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_trailFlash" updateStage="AddClothingParticles" renderStage="RenderShoes" updateState="Motion.Move">
        <Emitter>
          <Set name="offset">-30, -6</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="delayTimer">0.25</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_trailSpark</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Random name="offset" min="-8,0" max="8,8" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_trailSmoke" updateStage="AddClothingParticles" renderStage="RenderShoes" updateState="Motion.Move">
        <Emitter>
          <Set name="offset">-30, -6</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="delayTimer">0.25</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_trailSmoke</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Random name="offset" min="-8,0" max="8,8" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_trailSparks" updateStage="AddClothingParticles" renderStage="RenderShoes" updateState="Motion.Move">
        <Emitter>
          <Set name="offset">-24, -4</Set>
          <Set name="emissionInterval">0.04</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_trailSparks</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="initialScale">1,1</Set>
          <Random name="finalScale" min="0.3" max="0.6" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="ClothingOffsetFromShoes">0</Set>
        <Set name="UserNameOffset">11</Set>
        <Set name="RenderShoesWithMermaidTail">true</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="IsRidingBird">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderBehind>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSitting>true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <SpriteRender name="s_cartBack" offset="-6,27" alignment="DOWN_CENTER"/>
    </RenderBehind>
    <RenderShoes>
      <SpriteRender name="s_cartFront" offset="-6,3" alignment="DOWN_CENTER"/>
      <AvatarTransform class="Emotion" onState="Motion.Move">
        <Set name="emotion">SURPRISED</Set>
      </AvatarTransform>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
    </RenderShoes>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_FIREWORKS_MOHAWK">
	<Data>
		<Sprite name="item_Sprite" fileName="game/particles_large12.rttex" textureSize="64"/>
		
		<Animations>
			<SpriteAnimation name="item_animation" autoPlay="true" sprite="item_Sprite" isLoop="true" animTime="600">
				<Frame>0,12</Frame>
				<Frame>1,12</Frame>
				<Frame>2,12</Frame>
				<Frame>3,12</Frame>
				<Frame>4,12</Frame>
				<Frame>5,12</Frame>
			</SpriteAnimation>
		</Animations>
		
	</Data>

	<RenderRules>
		<RenderHair>
			<SpriteRender name="item_Sprite" offset="0,-32" drawShadow="false" blend="PREMULTIPLIED_ALPHA"/>
		</RenderHair>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_INFINITY_WEAPON">
  <Data>

    <Sprite name="s_gauntletBase" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="0,24"/>
    <Sprite name="s_gauntletAccent" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="1,24"/>
    <Sprite name="s_gauntletPower" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="2,24"/>
    <Sprite name="s_timeDilation" fileName="game/particles_large13.rttex" textureSize="64" frame="12,7"/>
    <Sprite name="s_punchLaser" fileName="game/particles11.rttex" textureSize="32" frame="8,30"/>
    <Sprite name="s_punchFire" fileName="game/particles11.rttex" textureSize="32" frame="8,29"/>
    <Sprite name="s_punchSlash" fileName="game/particles_large13.rttex" textureSize="64" frame="13,7"/>
    <Sprite name="s_hitFlash" fileName="game/particles_large13.rttex" textureSize="64" frame="14,7"/>

    <Animations>
      <SpriteAnimation name="a_PunchChains" sprite="s_punchLaser" animTime="400" isLoop="true" autoPlay="true">
        <Frame>8,30</Frame>
        <Frame>9,30</Frame>
        <Frame>10,30</Frame>
        <Frame>11,30</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PunchFire" sprite="s_punchFire" animTime="400">
        <Frame>8,29</Frame>
        <Frame>9,29</Frame>
        <Frame>10,29</Frame>
        <Frame>11,29</Frame>
      </SpriteAnimation>
    </Animations>
    <ParticleSystems>
      <ParticleSystem name="ps_punchFire">
        <Emitter>
          <Set name="offset">-4,-14</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchFire</Set>
          <Random name="offset" min="-2, 0" max="2, 0" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.12, 0</KeyFrame>
            <KeyFrame>0.2, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.25, 0.25</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="targetPosOffset" min="-4,-3" max="4,3"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchSlash">
        <Emitter>
          <Set name="offset">-4,-12</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchSlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 0</KeyFrame>
            <KeyFrame>0.1, 0, 0</KeyFrame>
            <KeyFrame>0.1, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.15</KeyFrame>
            <KeyFrame>0.5, 0.15</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.6</Set>
          <Set name="rotateWithVelocity">true</Set>
          <VectorTo name="initialVelocity" source="targetPos"  duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlash">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hitFlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1.3, 1.3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.75</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IgnoreDefaultDestroyedTileEffect">false</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderHandItem>
      <SpriteRender name="s_gauntletBase" offset="0,-4" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_gauntletAccent" offset="0,-4" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_gauntletPower" offset="0,-4" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <Group>
        <StopIf>
          <IsZombified>true</IsZombified>
        </StopIf>
        <SpriteRender name="s_punchLaser" offset="0,2" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" onAction="PUNCH"/>
      </Group>
    </RenderHandItem>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_punchFire" onAction="PUNCH"/>
      <ParticleSystemUpdate name="ps_punchSlash" onAction="PUNCH"/>
    </AddClothingParticles>
    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="s_timeDilation" offset="0,24" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
    </RenderInFront>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitFlash"/>
    </OnDamagedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="Sprite26_front" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="11,2" />
		<Sprite name="Sprite26_back" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="13,2" />
		<Sprite name="Sprite26_GLOW_front" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="12,2" />
		<Sprite name="s_muzzle" fileName="game/particles12.rttex" textureSize="32" frame="12,9" />
		<Sprite name="s_punch" fileName="game/particles_large16.rttex" textureSize="64" frame="8,9" />
		<Sprite name="s_punch_back" fileName="game/particles_large16.rttex" textureSize="64" frame="9,9" />
		<Sprite name="s_hitFlash" fileName="game/particles12.rttex" textureSize="32" frame="13,9" />
		<Animations>
			<SpriteCurveAnimation name="Sprite26_GLOWAnim" isLoop="true" sprite="Sprite26_GLOW_front" animTime="2000" autoPlay="true">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f</KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_hitFlash" sprite="s_hitFlash" animTime="400" autoPlay="true">
				<Frame>13,9</Frame>
				<Frame>14,9</Frame>
				<Frame>15,9</Frame>
				<Frame>16,9</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="MuzzleFlash1" updateStage="RenderBackHandItem" updateState="Action.Punch" renderStage="RenderBackHandItem">
				<Emitter attachment="handspotRoot" onPunchCount="odd">
					<Set name="offset">-4, 0</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialAngle">90</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="rotateWithVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="-0.1"/>
					<Set name="initialScale">1,1</Set>
					<Set name="finalScale">1.3,1.3</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">0.5</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Punch1" updateStage="RenderBackHandItem" updateState="Action.Punch">
				<Emitter attachment="handspotRoot" onPunchCount="odd">
					<Set name="offset">0, 0</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch_back</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="rotateWithVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.95"/>
					<Set name="initialAngle">90</Set>
					<Set name="flipY" source="punch.flipY"/>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">0.6</Set>
					<Set name="finalAlpha">0.4</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="MuzzleFlash2" updateStage="RenderHandItem" updateState="Action.Punch" renderStage="RenderHandItem">
				<Emitter attachment="handspotRoot" onPunchCount="even">
					<Set name="offset">-2, 4</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialAngle">90</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="rotateWithVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="-0.1"/>
					<Set name="initialScale">1,1</Set>
					<Set name="finalScale">1.3,1.3</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">0.5</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Punch2" updateStage="RenderHandItem" updateState="Action.Punch">
				<Emitter attachment="handspotRoot" onPunchCount="even">
					<Set name="offset">0, 0</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.95"/>
					<Set name="initialAngle">90</Set>
					<Set name="flipY" source="punch.flipY"/>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0.8</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hitFlash">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hitFlash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1.6, 1.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="punch.flipY">false</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<Group onState="Action.None">
				<Translate>0,-7,0</Translate>
				<SpriteRender name="Sprite26_front" drawShadow="true" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
				<SpriteRender name="Sprite26_GLOW_front" drawShadow="true" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
			</Group>
		</RenderHandItem>
		<RenderFrontArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderFrontArm>
		<RenderBackArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">-200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderBackArm>
		<RenderBackHandItem>
			<StopIf>
				<IsAction>BUILD</IsAction>
			</StopIf>
			<Translate>-4,-11.8,0</Translate>
			<Group onState="Action.None">
				<SpriteRender name="Sprite26_back" drawShadow="true" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
			</Group>
		</RenderBackHandItem>
 		<OnPunchStart>
			<ArithmethicOperation LeftHandVariableName="punch.flipY" RightHandVariableName="false" OperationType="Set" />
			<StopIf>
				<IsFacingLeft>false</IsFacingLeft>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="punch.flipY" RightHandVariableName="true" OperationType="Set" />
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_hitFlash"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_hitFlash"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="Sprite26_front" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="0,3" />
		<Sprite name="Sprite26_back" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="1,3" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="14,14" />
		<Sprite name="s_hit" fileName="game/particles12.rttex" textureSize="32" frame="15,14" />
		<Sprite name="s_aura" fileName="game/particles12.rttex" textureSize="32" frame="12,14"/>
		<Sprite name="emberSprite" fileName="game/particles12.rttex" textureSize="32" frame="10,14" />
		<Animations>
			<SpriteAnimation name="a_aura" sprite="s_aura">
				<Frame>12,14</Frame>
				<Frame>13,14</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="a_ember" sprite="emberSprite" isLoop="false" animTime="200" >
				<Frame>10,14</Frame>
				<Frame>11,14</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Move|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="EmberLeftParticle">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.07</Set>
					<Set name="intervalMax">0.14</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">emberSprite</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="offset" min="-3, 0" max="3, 8" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="initialScale" min="0.2" max="0.4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialVelocity" min="0, -16" max="0, -30" />
					<Set name="initialRotationRate">360</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="EmberRightParticle">
				<Emitter>
					<Set name="offset">-2, -5</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.07</Set>
					<Set name="intervalMax">0.14</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">emberSprite</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="offset" min="-3, 0" max="3, 8" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="initialScale" min="0.2" max="0.4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialVelocity" min="0, -16" max="0, -30" />
					<Set name="initialRotationRate">360</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_frontSmoke" updateStage="AddClothingParticles" renderStage="RenderHandItem" updateState="Motion.Idle">
				<Emitter>
					<Random name="emissionInterval" min="0.5" max="1" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Random name="offset" min="-9, -3" max="-6, 2" />
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="inSpecificOrder">true</Set>
					<Set name="sprite">s_aura</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4, 0.4</KeyFrame>
						<KeyFrame>1, 0.4, 0.6</KeyFrame>
					</Curve>
					<Set name="lifeTime">2</Set>
					<Random name="flipX" min="false" max="true"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_backSmoke" updateStage="AddClothingParticles" updateState="Motion.Idle">
				<Emitter>
					<Random name="emissionInterval" min="0.5" max="1" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Random name="offset" min="6, -3" max="9, 2" />
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="inSpecificOrder">true</Set>
					<Set name="sprite">s_aura</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4, 0.4</KeyFrame>
						<KeyFrame>1, 0.4, 0.6</KeyFrame>
					</Curve>
					<Set name="lifeTime">2</Set>
					<Random name="flipX" min="false" max="true"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_frontSmokeMove" updateStage="AddClothingParticles" renderStage="RenderHandItem" updateState="Motion.Move">
				<Emitter>
					<Random name="emissionInterval" min="0.01" max="0.1" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">1</Set>
					<Random name="offset" min="-10, -3" max="-6, 2" />
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="inSpecificOrder">true</Set>
					<Set name="sprite">s_aura</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4, 0.4</KeyFrame>
						<KeyFrame>1, 0.8, 1.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="flipX" min="false" max="true"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_backSmokeMove" updateStage="AddClothingParticles" updateState="Motion.Move">
				<Emitter>
					<Random name="emissionInterval" min="0.01" max="0.1" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">1</Set>
					<Random name="offset" min="6, -3" max="9, 2" />
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="inSpecificOrder">true</Set>
					<Set name="sprite">s_aura</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4, 0.4</KeyFrame>
						<KeyFrame>1, 0.8, 1.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="flipX" min="false" max="true"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hitFlash" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.4, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="offset" source="projectile_offset"/>
					<Set name="initialAngle" source="projectile_angle"/>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Punch1" updateStage="RenderBackHandItem" updateState="Action.Punch">
				<Emitter attachment="handspotRoot" onPunchCount="odd">
					<Set name="offset">-3, -3</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Random name="targetPosOffset" min="-12,-11" max="12,11"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angleOutVar="projectile_angle"/>
					<SetVar name="projectile_offset" source="targetPosOffset"/>
					<Set name="initialAngle">90</Set>
					<Set name="flipY" source="punch.flipY"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Punch2" updateStage="RenderHandItem" updateState="Action.Punch">
				<Emitter attachment="handspotRoot" onPunchCount="even">
					<Set name="offset">-3, -3</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angleOutVar="projectile_angle"/>
					<SetVar name="projectile_offset" source="targetPosOffset"/>
					<Set name="initialAngle">90</Set>
					<Set name="flipY" source="punch.flipY"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="punch.flipY">false</Set>
			<Set name="facingVariable">1, 1, 1</Set>
			<Set name="backArmTranslate">-2.3,11,0</Set>
			<Set name="projectile_offset">0, 0</Set>
			<Set name="projectile_angle">0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<SpriteRender name="Sprite26_front" offset="0.3,16" rotateOffset="true" rotationPoint="0.2,1" blend="NORMAL" alignment="CENTER" drawShadow="true" onState="Facing.Right"/>
			<SpriteRender name="Sprite26_front" offset="0.3,16" rotateOffset="true" rotationPoint="-0.2,1" blend="NORMAL" alignment="CENTER" drawShadow="true" onState="Facing.Left"/>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsRenderMod>RENDER_MOD_MANNEQUIN</IsRenderMod>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>
			<ParticleSystemUpdate name="EmberLeftParticle" onState="Action.None"/>
			<ParticleSystemRender name="EmberLeftParticle" />
		</RenderHandItem>
		<RenderFrontArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderFrontArm>
		<RenderBackArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">-200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderBackArm>
		<RenderBackHandItem>
			<StopIf type="or">
				<IsAction>BUILD</IsAction>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>
			<ParticleSystemRender name="ps_backSmoke"/>
			<ParticleSystemRender name="ps_backSmokeMove"/>
			<Group onState="Action.Punch">
				<StopIf>
					<IsZombified>true</IsZombified>
				</StopIf>
				<SpriteRender name="Sprite26_back" offset="-2.8,11.3" rotateOffset="true" rotationPoint="1,1" blend="NORMAL" alignment="CENTER" drawShadow="true" onState="Facing.Right"/>
				<SpriteRender name="Sprite26_back" offset="-2.8,11.3" rotateOffset="true" rotationPoint="-1,1" blend="NORMAL" alignment="CENTER" drawShadow="true" onState="Facing.Left"/>
			</Group>
			<Group onState="Action.None">
				<SpriteRender name="Sprite26_back" offset="-2.8,11.3" rotateOffset="true" rotationPoint="1,1" blend="NORMAL" alignment="CENTER" drawShadow="true" onState="Facing.Right"/>
				<SpriteRender name="Sprite26_back" offset="-2.8,11.3" rotateOffset="true" rotationPoint="-1,1" blend="NORMAL" alignment="CENTER" drawShadow="true" onState="Facing.Left"/>
			</Group>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsRenderMod>RENDER_MOD_MANNEQUIN</IsRenderMod>
			</StopIf>
			<ParticleSystemUpdate name="EmberRightParticle" onState="Action.None"/>
			<ParticleSystemRender name="EmberRightParticle" />
		</RenderBackHandItem>
 		<OnPunchStart>
			<ArithmethicOperation LeftHandVariableName="punch.flipY" RightHandVariableName="false" OperationType="Set" />
			<StopIf>
				<IsFacingLeft>false</IsFacingLeft>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="punch.flipY" RightHandVariableName="true" OperationType="Set" />
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Basket" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="22,28" />
		<Sprite name="s_Bell" fileName="game/pets/p_bell.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_Crack1" fileName="game/particles12.rttex" textureSize="32" frame="1,4" />
		<Sprite name="s_Crack2" fileName="game/particles12.rttex" textureSize="32" frame="1,5" />
		<Sprite name="s_Crack3" fileName="game/particles12.rttex" textureSize="32" frame="1,6" />
		<Sprite name="s_Crack4" fileName="game/particles12.rttex" textureSize="32" frame="1,7" />
		<Sprite name="s_Egg1" fileName="game/particles12.rttex" textureSize="32" frame="0,4" />
		<Sprite name="s_Egg2" fileName="game/particles12.rttex" textureSize="32" frame="0,5" />
		<Sprite name="s_Egg3" fileName="game/particles12.rttex" textureSize="32" frame="0,6" />
		<Sprite name="s_Egg4" fileName="game/particles12.rttex" textureSize="32" frame="0,7" />
		<Sprite name="s_Splat" fileName="game/particles12.rttex" textureSize="32" frame="0,8" />
		<Animations>
			<SpriteAnimation name="a_Bell" sprite="s_Bell" animTime="400" autoPlay="true" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Crack1" sprite="s_Crack1" animTime="300">
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Crack2" sprite="s_Crack2" animTime="300">
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Crack3" sprite="s_Crack3" animTime="300">
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Crack4" sprite="s_Crack4" animTime="300">
				<Frame>1,7</Frame>
				<Frame>2,7</Frame>
				<Frame>3,7</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_Crack">
				<Emitter>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" UseParentVariantId="true">
					<Select name="sprite" input="variantId">
						<Item>"s_Crack1"</Item>
						<Item>"s_Crack2"</Item>
						<Item>"s_Crack3"</Item>
						<Item>"s_Crack4"</Item>
					</Select>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.9, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.7</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,60" />
					<Random name="initialRotationRate" min="-250" max="250" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_PunchParticle">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Select name="sprite" input="variantId">
						<Item>"s_Egg1"</Item>
						<Item>"s_Egg2"</Item>
						<Item>"s_Egg3"</Item>
						<Item>"s_Egg4"</Item>
					</Select>
					<Random name="offset" min="-10, 0" max="10, 0" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialScale">0.8, 0.8</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
					<Random name="initialRotationRate" min="-300" max="300" />
					<Random name="variantId" min="0" max="4" />
					<OnFinish>
						<ParticleSystemName>ps_Splat</ParticleSystemName>
						<ParticleSystemName>ps_Crack</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Splat">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Splat</Set>
					<Random name="offset" min="-4.01, -4" max="4, 4" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.5, 1.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialAngle" min="0" max="360" />
					<Set name="gravityVector">0, 20</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-48,0</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="HideParticlesOnTransform">false</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="target.angle">0</Set>
			<Set name="target.origin.offset">0,0,0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<OnDamagedTile>
			<StopIf type="or">
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
			</StopIf>
		</OnDamagedTile>
		<OnDestroyedTile>
			<StopIf type="or">
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
			</StopIf>
		</OnDestroyedTile>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderHandItem>
			<SpriteRender name="s_Basket" offset="0,1" alignment="UPPER_CENTER" />
		</RenderHandItem>
		<RenderPet>
			<ContextUpdate type="SetFlip">
				<Set name="flip">0,0</Set>
			</ContextUpdate>
			<Group onState="Action.None">
				<SpriteRender name="s_Bell" scale="0.8,0.8" alignment="DOWN_CENTER" />
			</Group>
			<Group onState="Action.Punch">
				<Group>
					<Rotate forceValue="true">target.angle</Rotate>
					<Rotate>-90,0,0,1</Rotate>
					<Rotate onState="Facing.Left">180,0,0,1</Rotate>
					<SpriteRender name="s_Bell" scale="0.8,0.8" alignment="DOWN_CENTER" />
					<StopIf>
						<IsTrnsformed>true</IsTrnsformed>
					</StopIf>
					<ParticleSystemUpdate name="ps_PunchParticle" onState="Action.Punch" />
				</Group>
			</Group>
		</RenderPet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_foot1" fileName="game/player_feet16.rttex" textureSize="32" frame="29,12" />
    <Sprite name="s_foot2" fileName="game/player_feet16.rttex" textureSize="32" frame="29,13" />
    <Sprite name="s_equipHandBackLeft" fileName="game/player_feet_large1.rttex" textureSize="64" frame="4,10" />
    <Sprite name="s_equipHandBackRight" fileName="game/player_feet_large1.rttex" textureSize="64" frame="4,11" />
    <Sprite name="s_equipFront" fileName="game/particles11.rttex" textureSize="32" frame="3,24" />
    <Sprite name="s_deathHandFront" fileName="game/particles_large13.rttex" textureSize="64" frame="6,9" />
    <Sprite name="s_deathHandBack" fileName="game/particles_large13.rttex" textureSize="64" frame="6,10" />
    <Sprite name="s_deathPlayer" fileName="game/particles10.rttex" textureSize="32" frame="9,3" />
    <Sprite name="s_trail" fileName="game/particles11.rttex" textureSize="32" frame="0,24" />

    <VariableMap>
      <Set name="leftFootYPos">0,0,0</Set>
      <Set name="rightFootYPos">0,0,0</Set>
    </VariableMap>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition type="or">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="IsDying">
        <States>
          <State name="False" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>DIE</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">DIE</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_equipHandBackLeft" sprite="s_equipHandBackLeft" animTime="1200" isLoop="true" playOnState="IsDying.False">
        <Frame>4,10</Frame>
        <Frame>5,10</Frame>
        <Frame>6,10</Frame>
        <Frame>7,10</Frame>
        <Frame>8,10</Frame>
        <Frame>9,10</Frame>
        <Frame>10,10</Frame>
        <Frame>11,10</Frame>
        <Frame>12,10</Frame>
        <Frame>13,10</Frame>
        <Frame>14,10</Frame>
        <Frame>15,10</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_equipHandBackRight" sprite="s_equipHandBackRight" animTime="1200" isLoop="true" playOnState="IsDying.False">
        <Frame>4,11</Frame>
        <Frame>5,11</Frame>
        <Frame>6,11</Frame>
        <Frame>7,11</Frame>
        <Frame>8,11</Frame>
        <Frame>9,11</Frame>
        <Frame>10,11</Frame>
        <Frame>11,11</Frame>
        <Frame>12,11</Frame>
        <Frame>13,11</Frame>
        <Frame>14,11</Frame>
        <Frame>15,11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_deathHandFront" sprite="s_deathHandFront" animTime="800">
        <Frame>13,9</Frame>
        <Frame>6,9</Frame>
        <Frame>7,9</Frame>
        <Frame>8,9</Frame>
        <Frame>9,9</Frame>
        <Frame>10,9</Frame>
        <Frame>11,9</Frame>
        <Frame>12,9</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_deathHandBack" sprite="s_deathHandBack" animTime="800">
        <Frame>13,10</Frame>
        <Frame>6,10</Frame>
        <Frame>7,10</Frame>
        <Frame>8,10</Frame>
        <Frame>9,10</Frame>
        <Frame>10,10</Frame>
        <Frame>11,10</Frame>
        <Frame>12,10</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_trail" sprite="s_trail">
        <Frame>0,24</Frame>
        <Frame>2,24</Frame>
        <Frame>1,24</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_deathHandsBack" updateStage="OnKilled" renderStage="RenderBehind">
        <Emitter>
          <Set name="lifeTime">0.9</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-32</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_deathHandBack</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.8</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_deathPlayer" updateStage="OnKilled" renderStage="RenderBehind">
        <Emitter>
          <Set name="lifeTime">0.9</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_deathPlayer</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_deathHandsFront" updateStage="OnKilled" renderStage="RenderBehind">
        <Emitter>
          <Set name="lifeTime">0.9</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-32</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_deathHandFront</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.8</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_trail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Move">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Random name="emissionInterval" min="0.005" max="0.05" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">-16,0</Set>
        </Emitter>
        <Particle usePlayerFacing="true" randomSpriteFrame="true">
          <Set name="sprite">s_trail</Set>
          <Set name="lifeTime">0.6</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="renderAlignment">DOWN_CENTER</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.7, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>0.2, 1, 1</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="RenderShoesWithMermaidTail">false</Set>
        <Set name="HasDeathParticles">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="HideAngelOnDeath">true</Set>
        <Set name="HideAvatarOnDeath">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBehind value="playerGround">
      <StopIf type="or">
        <IsTrnsformed>true</IsTrnsformed>
        <IsRenderObjectFlag>RENDER_OBJECT_FLAG_NO_FEET</IsRenderObjectFlag>
        <IsVariableBool name="isInvisible">true</IsVariableBool>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="s_equipHandBackLeft" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" onState="IsDying.False"/>
      <SpriteRender name="s_equipHandBackRight" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" onState="IsDying.False"/>
    </RenderBehind>

    <RenderInFront value="playerGround">
      <StopIf type="or">
        <IsTrnsformed>true</IsTrnsformed>
        <IsRenderObjectFlag>RENDER_OBJECT_FLAG_NO_FEET</IsRenderObjectFlag>
        <IsVariableBool name="isInvisible">true</IsVariableBool>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="s_equipFront" alignment="DOWN_CENTER" onState="IsDying.False"/>
    </RenderInFront>

    <RenderShoes>
      <StopIf type="or">
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="PANTS">ITEM_ID_RAPTOR_LEGS</IsWearing>
        <IsRenderObjectFlag>RENDER_OBJECT_FLAG_NO_FEET</IsRenderObjectFlag>
        <IsVariableBool name="isInvisible">true</IsVariableBool>
      </StopIf>
      <Group>
        <Translate>leftFootYPos</Translate>
        <SpriteRender name="s_foot1" alignment="DOWN_CENTER" />
      </Group>
      <Group>
        <Translate>rightFootYPos</Translate>
        <SpriteRender name="s_foot2" alignment="DOWN_CENTER" />
      </Group>
    </RenderShoes>

    <OnDeath>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnDeath>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_GROWTRONIC_GLIDER">
	<Data>
		<Sprite name="s_explosion" fileName="game/particles_large15.rttex" textureSize="64" frame="5,2" />
		<Sprite name="s_fish" fileName="game/particles12.rttex" textureSize="32" frame="14,1" />
		<Sprite name="s_fishTrail" fileName="game/particles12.rttex" textureSize="32" frame="15,1" />
		<Sprite name="s_ray" fileName="game/particles_large15.rttex" textureSize="64" frame="6,1" />
		<Sprite name="s_shoe1" fileName="game/player_feet16.rttex" textureSize="32" frame="30,20" />
		<Sprite name="s_shoe2" fileName="game/player_feet16.rttex" textureSize="32" frame="30,21" />
		<StateMachines>
			<StateMachine name="Mobility">
				<States>
					<State name="Stationary" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Stationary" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Stationary">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Swirl">
				<States>
					<State name="No" />
					<State name="Yes" ExitTime="0.8" />
				</States>
				<Transitions>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsAction>JUMPDOUBLE</IsAction>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="No" from="Yes" />
				</Transitions>
			</StateMachine>
			<StateMachine name="Explosion">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>JUMPDOUBLE</IsAction>
						</Condition>
					</Transition>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">JUMPDOUBLE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Trail">
				<States>
					<State name="No" />
					<State name="Yes" ExitTime="0.8" />
				</States>
				<Transitions>
					<Transition to="Yes" from="No">
						<Condition>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="No" from="Yes">
						<Condition>
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="a_ray" sprite="s_ray" animTime="800" isLoop="true" playOnState="Swirl.No">
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
				<Frame>8,1</Frame>
				<Frame>9,1</Frame>
				<Frame>10,1</Frame>
				<Frame>11,1</Frame>
				<Frame>12,1</Frame>
				<Frame>13,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_raySwirl" sprite="s_ray" animTime="800" isLoop="true" playOnState="Swirl.Yes">
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
				<Frame>9,2</Frame>
				<Frame>10,2</Frame>
				<Frame>11,2</Frame>
				<Frame>12,2</Frame>
				<Frame>13,2</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-18</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="UserNameOffset">22</Set>
				<Set name="ShouldHover">true</Set>
				<Set name="AllowChangePunchType">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="explosion_particle" updateStage="AddClothingParticles" updateState="Explosion.Yes">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">0, 6</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_explosion</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 2, 2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_particle1">
				<Emitter attachment="contextRotation">
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_fishTrail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0</KeyFrame>
						<KeyFrame>0.25, 0.5</KeyFrame>
						<KeyFrame>0.6, 0.3</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 2, 2</KeyFrame>
						<KeyFrame>1, 4, 4</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialVelocity">-20, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_particle2">
				<Emitter attachment="contextRotation">
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_fishTrail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0</KeyFrame>
						<KeyFrame>0.25, 0.5</KeyFrame>
						<KeyFrame>0.6, 0.3</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 2, 2</KeyFrame>
						<KeyFrame>1, 4, 4</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialVelocity">-20, 0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="FishTranslation">40,0,0</Set>
			<Set name="FishRotation">0</Set>
			<Set name="FishRotationRate">0</Set>
			<Set name="FishRotationRateTemp">50</Set>
			<Set name="DeltaTime">1</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<Group>
				<StopIf>
					<IsAction>PUNCH</IsAction>
				</StopIf>
				<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">-45</Set>
				</AvatarTransform>
			</Group>
			<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">45</Set>
			</AvatarTransform>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="FishRotationRate" RightHandVariableName="FishRotationRateTemp" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="FishRotationRate" RightHandVariableName="DeltaTime" OperationType="Multiply" />
			<ArithmethicOperation LeftHandVariableName="FishRotation" RightHandVariableName="FishRotationRate" OperationType="Add" />
		</Update>
		<RenderShoes>
			
			<SpriteRender name="s_ray" offset="-2,31" />
			<Group>
				<StopIf>
					<IsWearing slot="PANTS">ITEM_ID_RAPTOR_LEGS</IsWearing>
					<IsWearing slot="PANTS">ITEM_ID_MERMAID_TAIL</IsWearing>
				</StopIf>
				<SpriteRender name="s_shoe1" offset="0.5,-16.5" />
				<SpriteRender name="s_shoe2" offset="0.5,-16.5" />
			</Group>
			
			<Group>
				<Rotate>FishRotation</Rotate>
				<Translate>FishTranslation</Translate>
				<Rotate>90,0,0,1</Rotate>
				<SpriteRender name="s_fish"  useFixedRotation="true" fixedRotation="0" scale="0.5,0.5"/>
				<Group>
					<StopIf type="or">
						<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
						<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
					</StopIf>
					<ParticleSystemUpdate name="trail_particle1" onState="Trail.Yes" />
				</Group>
			</Group>
			<Group>
				<Rotate>FishRotation</Rotate>
				<Rotate>180,0,0,1</Rotate>
				<Translate>FishTranslation</Translate>
				<Rotate>90,0,0,1</Rotate>
				<SpriteRender name="s_fish"  useFixedRotation="true" fixedRotation="0" scale="0.5,0.5"/>
				<Group>
					<StopIf type="or">
						<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
						<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
					</StopIf>
					<ParticleSystemUpdate name="trail_particle2" onState="Trail.Yes" />
				</Group>
			</Group>
		</RenderShoes>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_eye" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="19,4"/>
    <Sprite name="s_mist" fileName="game/particles_large16.rttex" textureSize="64" frame="14,4" />
    <Sprite name="s_projectile" fileName="game/particles12.rttex" textureSize="32" frame="26,12" />

    <Animations>
      <SpriteAnimation name="a_eye" autoPlay="true" sprite="s_eye" isLoop="true" animTime="400">
        <Frame>19,4</Frame>
        <Frame>20,4</Frame>
        <Frame>21,4</Frame>
        <Frame>22,4</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_mist" updateStage="AddClothingParticles" renderStage="RenderBehind">
        <Emitter>
          <Set name="offset">0, -18</Set>
          <Set name="emissionInterval">0.5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">3</Set>
          <Set name="initialVelocity">0, 0</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchProjectile" updateStage="OnPunchUpdate">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.5</Set>
          <Set name="emissionInterval">0.03</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="targetPos" source="context.pos"/>
          <Random name="offset" min="-3,-3" max="3,3" />
          <Random name="targetPosOffset" min="-4,-30" max="4,-2" />
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.8</KeyFrame>
            <KeyFrame>0.8, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="initialScale" min="0.5" max="1" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <VariableMap>
      <Set name="context.pos">0, 0</Set>
    </VariableMap>

  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderFaceItem>
      <SpriteRender name="s_eye" offset="0.5,-16" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderFaceItem>
    <RenderBehind>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
    </RenderBehind>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_swordBack" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="0,12" />
    <Sprite name="s_swordFront" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="1,12" />
    <Sprite name="s_separateSlash" fileName="game/particles12.rttex" textureSize="32" frame="27,18"/>
    <Sprite name="s_combinedSlash" fileName="game/particles12.rttex" textureSize="32" frame="26,18"/>
    <Sprite name="s_flash" fileName="game/particles_large17.rttex" textureSize="64" frame="12,7" />
    <Sprite name="s_hitSparks" fileName="game/particles12.rttex" textureSize="32" frame="29,18"/>
    <Sprite name="s_hitFlash" fileName="game/particles_large17.rttex" textureSize="64" frame="13,7"/>
    <Animations>
      <SpriteAnimation name="a_swordBackNormalSeparate" sprite="s_swordBack" playOnState="PunchType.NoneSeparate|PunchType.Separate|PunchType.TransitionFromSeparate">
        <Frame>0,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_swordBackNormalCombined" sprite="s_swordBack" playOnState="PunchType.NoneCombined|PunchType.Combined|PunchType.TransitionFromCombine">
        <Frame>2,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_separateSlash" autoPlay="false" sprite="s_separateSlash">
        <Frame>27,18</Frame>
        <Frame>28,18</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="s_hitSparks">
        <Frame>29,18</Frame>
        <Frame>30,18</Frame>
        <Frame>31,18</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="UserNameOffset">15</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="OnEquipTag">COMBINED_BLADE</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
      </Default>
    </RenderOptions>
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="False" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="PunchType">
        <States>
          <State name="NoneSeparate"/>
          <State name="NoneCombined"/>
          <State name="Separate"/>
          <State name="Combined"/>
          <State name="TransitionFromSeparate"/>
          <State name="TransitionFromCombined"/>
        </States>
        <Transitions>
          <Transition to="NoneSeparate" from="NoneCombined|Separate|Combined|TransitionFromSeparate|TransitionFromCombined">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <ItemHasTag operatorType="NotEqual">COMBINED_BLADE</ItemHasTag>
            </Condition>
          </Transition>
          <Transition to="NoneCombined" from="NoneSeparate|Separate|Combined|TransitionFromSeparate|TransitionFromCombined">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <ItemHasTag>COMBINED_BLADE</ItemHasTag>
            </Condition>
          </Transition>
          <Transition to="Separate" from="NoneSeparate|NoneCombined">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Greater" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
              <CheckRandomRangeNumber EndNumber="2">0</CheckRandomRangeNumber>
            </Condition>
          </Transition>
          <Transition to="Combined" from="NoneSeparate|NoneCombined">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Greater" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
              <CheckRandomRangeNumber EndNumber="2">1</CheckRandomRangeNumber>
            </Condition>
          </Transition>
          <Transition to="TransitionFromCombined" from="Combined">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Less" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="TransitionFromSeparate" from="Separate">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Less" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Combined" from="TransitionFromSeparate">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Greater" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Separate" from="TransitionFromCombined">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Greater" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_hitSparks" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">10</Set>
          <Set name="delayTimer">0.0</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_hitSparks</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initalRGB">1,1,1</Set>
          <Set name="initialScale">1,1</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">true</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlash" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Random name="initialAngle" min="-360" max="360"/>
          <Set name="sprite">s_hitFlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.4,0.4</KeyFrame>
            <KeyFrame>1, 1.3,1.3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_flash">
        <Emitter>
          <Set name="offset">6, -14</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_flash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.25, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1.75, 1.75</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_separateSlash">
        <Emitter>
          <Set name="offset">9,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle alternateSpriteFrameWithPunch="true">
          <Set name="sprite">s_separateSlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <Set name="initialAlpha">1</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_combinedSlash">
        <Emitter>
          <Set name="offset">24,-14</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_combinedSlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <Set name="initialAlpha">1</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <VariableMap>
      <Set name="punchDuration" MinValue="2" MaxValue="4">0</Set>
      <Set name="DeltaTime">0.0</Set>
    </VariableMap>
  </Data>
  <RenderRules>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="Punch.False">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>
    <AddClothingParticles>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <ParticleSystemUpdate name="ps_flash" onState="PunchType.Separate|PunchType.Combined"/>
    </AddClothingParticles>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>

      <Group onState="PunchType.NoneSeparate|PunchType.NoneCombined|PunchType.Separate|PunchType.TransitionFromSeparate">
        <SpriteRender name="s_swordBack" offset="18, 2" rotationPoint="0,1" flip="0,0" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
      </Group>

      <Group onState="PunchType.Combined|PunchType.TransitionFromCombine">
        <Rotate forceValue="true">0,0,0,1</Rotate>
        <Translate>-6,2,0</Translate>
        <SpriteRender name="s_swordBack" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" rotateOffset="true" useFixedRotation="true" fixedRotation="0" blend="PREMULTIPLIED_ALPHA" />
      </Group>
      
    </RenderBackHandItem>
    <RenderHandItem>
      <Group onState="PunchType.NoneSeparate|PunchType.Separate|PunchType.TransitionFromSeparate">
        <SpriteRender name="s_swordFront" offset="25, 8" rotationPoint="0,1" flip="0,0" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
      </Group>
    </RenderHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      
      <ArithmethicOperation LeftHandVariableName="punchDuration" RightHandVariableName="punchDuration" OperationType="Randomize" onState="PunchType.NoneSeparate|PunchType.NoneCombined|PunchType.TransitionFromCombined|PunchType.TransitionFromSeparate"/>
      
      <ArithmethicOperation LeftHandVariableName="punchDuration" RightHandVariableName="DeltaTime" OperationType="Substract"/>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <Group onState="PunchType.Separate">
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="animTime">1000</Set>
          <Set name="Curve">
            <KeyFrame>0.0, 0</KeyFrame>
            <KeyFrame>0.3, 0</KeyFrame>
            <KeyFrame>0.60, 360</KeyFrame>
            <KeyFrame>0.99, 720</KeyFrame>
          </Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm1Angle</Set>
          <Set name="animTime">1000</Set>
          <Set name="Curve">
            <KeyFrame>0.0, 60</KeyFrame>
            <KeyFrame>0.3, 360</KeyFrame>
            <KeyFrame>0.60, 360</KeyFrame>
            <KeyFrame>0.99, 720</KeyFrame>
          </Set>
        </AvatarTransform>
      </Group>
      <Group onState="PunchType.Combined">
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm1Angle</Set>
          <Set name="armAngle">1200</Set>
          <Set name="isAdditive">true</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="armAngle">0</Set>
        </AvatarTransform>
      </Group>
    </OnPunchUpdate>
    <OnPunchStart>
      <ParticleSystemUpdate name="ps_separateSlash" onState="PunchType.Separate"/>
      <ParticleSystemUpdate name="ps_combinedSlash" onState="PunchType.Combined"/>
    </OnPunchStart>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_GALAXY_CLOAK">
  <Data>
    <Sprite name="s_capeBack" fileName="game/particles_large13.rttex" textureSize="64"/>
    <Sprite name="s_capeFront" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="1,21" />
    <Sprite name="s_sparkle" fileName="game/particles9.rttex" textureSize="32"/>
    
    <Animations>
      <SpriteAnimation name="a_Sparkles" sprite="s_sparkle" animTime="300" autoPlay="true" isLoop="true">
        <Frame>8,8</Frame>
        <Frame>9,8</Frame>
        <Frame>10,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_cape" sprite="s_capeBack" animTime="600" autoPlay="true" isLoop="true">
        <Frame>0,15</Frame>
        <Frame>1,15</Frame>
        <Frame>2,15</Frame>
        <Frame>3,15</Frame>
        <Frame>4,15</Frame>
        <Frame>5,15</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <ParticleSystems>
      <ParticleSystem name="ps_Sparkles">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.4</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_sparkle</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-24, -12" max="24, -2" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Select name="lifeTime" input="randomNumber">
            <Item>0.3</Item>
            <Item>0.6</Item>
          </Select>
          <Random name="initialScale" min="0.5" max="0.8" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_SparklesTrail">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_sparkle</Set>
          <Random name="offset" min="-28, -16" max="28, 0" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>

          <Select name="lifeTime" input="randomNumber">
            <Item>0.3</Item>
            <Item>0.6</Item>
          </Select>
          <Random name="initialScale" min="0.5" max="0.8" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="ShouldHover">true</Set>
        <Set name="UserNameOffset">6</Set>
      </Default>
    </RenderOptions>
    
  </Data>
  <RenderRules>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_Sparkles" />
      <ParticleSystemUpdate name="ps_SparklesTrail" onState="Motion.Move"/>
    </AddClothingParticles>
    <RenderBackpack>
      <SpriteRender name="s_capeBack" offset="0,-11" alignment="CENTER"/>
      <ParticleSystemRender name="ps_Sparkles" />
      <ParticleSystemRender name="ps_SparklesTrail"/>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="FootPosition">
        <Set name="foot1dy">0</Set>
        <Set name="foot2dy">0</Set>
        <Set name="foot1y">0</Set>
        <Set name="foot2y">0</Set>
      </AvatarTransform>
    </RenderBackpack>
    <RenderFrontpack>
      <SpriteRender name="s_capeFront" offset="0,0" alignment="DOWN_CENTER"/>
    </RenderFrontpack>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_GALAXY_SKIN">
	<Data>
		
		<Sprite name="s_shirt" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="10,9"/>
		<Sprite name="s_skin_dust_blue" fileName="game/particles11.rttex" textureSize="32" frame="23,5"/>
		<Sprite name="s_skin_dust_purple" fileName="game/particles11.rttex" textureSize="32" frame="24,5"/>
		<Sprite name="s_skin_stars_blue" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="s_skin_stars_purple" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="s_skin_trail_blue" fileName="game/particles11.rttex" textureSize="32" frame="30,5"/>
		<Sprite name="s_skin_trail_purple" fileName="game/particles11.rttex" textureSize="32" frame="27,5"/>
		
		<Animations>
			<SpriteAnimation name="a_skin_stars_purple" sprite="s_skin_stars_purple">
				<Frame>25,5</Frame>
				<Frame>26,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_skin_stars_blue" sprite="s_skin_stars_blue" animTime="200">
				<Frame>28,5</Frame>
				<Frame>29,5</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="ps_dust_blue">
				<Emitter>
					<Set name="offset">-3, -11</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_skin_dust_blue</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-3, -3" max="3, 3"/>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialAlpha">0.15</Set>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="lifeTime">2</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_dust_purple">
				<Emitter>
					<Set name="offset">3, -11</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_skin_dust_purple</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-3, -3" max="3, 3"/>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialAlpha">0.15</Set>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="lifeTime">2</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_skin_stars_blue">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>

          <OrbitOffset>
            <Set name="hasOrbit">true</Set>
            <Set name="hAmplitude">20</Set>
            <Set name="hOrbitPeriod">6000</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">12</Set>
            <Set name="vOrbitPeriod">4000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.5</Set>
            <Set name="maxScale">0.9</Set>
          </OrbitOffset>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_skin_trail_blue</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.2, 0.1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_skin_stars_blue2">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>

          <OrbitOffset>
            <Set name="hasOrbit">true</Set>
            <Set name="hAmplitude">20</Set>
            <Set name="hOrbitPeriod">-6000</Set>
            <Set name="hTimeOffset">500</Set>
            <Set name="vAmplitude">12</Set>
            <Set name="vOrbitPeriod">4000</Set>
            <Set name="vTimeOffset">1500</Set>
            <Set name="minScale">0.5</Set>
            <Set name="maxScale">0.9</Set>
          </OrbitOffset>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_skin_trail_blue</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.2, 0.1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_skin_stars_purple">
				<Emitter>
					<Set name="offset">0, -10</Set>
					<Set name="lifeTime">1</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true">
					<Set name="sprite">s_skin_stars_purple</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-6, -4" max="6, 2.5"/>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.25, 0.25</Set>
					<Set name="lifeTime">2.5</Set>
					<Set name="initialVelocity">-1, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_swirl">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>

          <OrbitOffset>
            <Set name="hasOrbit">true</Set>
            <Set name="hAmplitude">20</Set>
            <Set name="hOrbitPeriod">6000</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">12</Set>
            <Set name="vOrbitPeriod">4000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.5</Set>
            <Set name="maxScale">0.9</Set>
          </OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">s_skin_stars_blue</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1.2, 1.2</Set>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_swirl2">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>

          <OrbitOffset>
            <Set name="hasOrbit">true</Set>
            <Set name="hAmplitude">20</Set>
            <Set name="hOrbitPeriod">-6000</Set>
            <Set name="hTimeOffset">500</Set>
            <Set name="vAmplitude">12</Set>
            <Set name="vOrbitPeriod">4000</Set>
            <Set name="vTimeOffset">1500</Set>
            <Set name="minScale">0.5</Set>
            <Set name="maxScale">0.9</Set>
          </OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">s_skin_stars_blue</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1.2, 1.2</Set>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>

	<RenderRules>
    <OnDrawCustomOutline>
      <AvatarTransform class="Scale">
        <Set name="targetScale">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="RenderData">
        <Set name="saturation">3</Set>
        <Set name="brightness">1</Set>
        <Set name="contrast">0.1</Set>
      </AvatarTransform>
      <AvatarOutline duration="1500" startScale="1,1" endScale="1.1,1.1">
        <Colours>
          <Colour>87,30,150,255</Colour>
          <Colour>90,10,90,255</Colour>
        </Colours>
      </AvatarOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">1</Set>
        <Set name="brightness">1</Set>
        <Set name="contrast">0.1</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">reset</Set>
      </AvatarTransform>
    </OnDrawCustomOutline>
    <AddClothingParticles>
			<ParticleSystemUpdate name="ps_dust_blue"/>
			<ParticleSystemUpdate name="ps_dust_purple"/>
			<ParticleSystemUpdate name="ps_skin_stars_blue"/>
			<ParticleSystemUpdate name="ps_skin_stars_blue2"/>
			<ParticleSystemUpdate name="ps_skin_stars_purple"/>
			<ParticleSystemUpdate name="ps_swirl"/>
			<ParticleSystemUpdate name="ps_swirl2"/>
		</AddClothingParticles>
		<RenderShirt>
			<ParticleSystemRender name="s_shirt"/>
			<ParticleSystemRender name="ps_dust_blue"/>
			<ParticleSystemRender name="ps_dust_purple"/>
			<ParticleSystemRender name="ps_skin_stars_purple"/>
			<StopIf>
				<IsVariableBool name="isMannequin">false</IsVariableBool>
			</StopIf>
			<SpriteRender name="s_shirt" offset="0,0" alignment="DOWN_CENTER"/>
		</RenderShirt>
		<RenderInFront>
			<ParticleSystemRender name="ps_skin_stars_blue"/>
			<ParticleSystemRender name="ps_skin_stars_blue2"/>
			<ParticleSystemRender name="ps_swirl"/>
			<ParticleSystemRender name="ps_swirl2"/>
		</RenderInFront>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="ps_dust_blue"/>
			<ParticleSystemOff name="ps_dust_purple"/>
			<ParticleSystemOff name="ps_skin_stars_blue"/>
			<ParticleSystemOff name="ps_skin_stars_blue2"/>
			<ParticleSystemOff name="ps_skin_stars_purple"/>
			<ParticleSystemOff name="ps_swirl"/>
			<ParticleSystemOff name="ps_swirl2"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_foot1" fileName="game/particles_large16.rttex" textureSize="64" frame="0,3"/>
    <Sprite name="s_foot2" fileName="game/particles_large16.rttex" textureSize="64" frame="0,4"/>
    <Sprite name="s_feather" fileName="game/particles12.rttex" textureSize="32"/>
    <Sprite name="s_lines" fileName="game/particles12.rttex" textureSize="32" frame="24,4"/>
    <StateMachines>
	    <StateMachine name="Action">
		    <States>
			    <State name="Idle" />
			    <State name="Walk" />
			    <State name="Jump" />
			    <State name="Fall" />
			    <State name="Attack" />
		    </States>
		    <Transitions>
			    <Transition to="Idle" from="Fall|Walk|Attack">
				    <Condition type="and">
					    <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">true</IsVariableBool>
					    <IsAction operatorType="NotEqual">PUNCH</IsAction>
				    </Condition>
			    </Transition>
			    <Transition to="Walk" from="Fall|Idle|Jump|Attack">
				    <Condition type="and">
					    <IsVariableBool name="onGround">true</IsVariableBool>
					    <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
					    <IsAction operatorType="NotEqual">PUNCH</IsAction>
				    </Condition>
			    </Transition>
			    <Transition to="Jump" from="Idle|Fall|Walk|Attack">
				    <Condition type="and">
					    <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">false</IsVariableBool>
					    <IsAction operatorType="NotEqual">PUNCH</IsAction>
				    </Condition>
			    </Transition>
			    <Transition to="Fall" from="Jump|Idle|Walk|Attack">
				    <Condition type="and">
					    <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">false</IsVariableBool>
					    <IsAction operatorType="NotEqual">PUNCH</IsAction>
				    </Condition>
			    </Transition>			    
				<Transition to="Attack" from="Jump|Idle|Walk|Fall">
				    <Condition>
					    <IsAction>PUNCH</IsAction>
				    </Condition>
			    </Transition>
		    </Transitions>
	    </StateMachine>
	    <StateMachine name="Facing">
		    <States>
			    <State name="Left" />
			    <State name="Right" />
		    </States>
		    <Transitions>
			    <Transition to="Left" from="Right">
				    <Condition>
					    <IsFacingLeft>true</IsFacingLeft>
				    </Condition>
			    </Transition>
			    <Transition to="Right" from="Left">
				    <Condition type="or">
					    <IsVariableBool name="isMannequin">true</IsVariableBool>
					    <IsFacingLeft>false</IsFacingLeft>
				    </Condition>
			    </Transition>
		    </Transitions>
	    </StateMachine>
    </StateMachines>
    <Animations>
	    <SpriteAnimation name="a_feathers" sprite="s_feather">
		    <Frame>22,4</Frame>
		    <Frame>23,4</Frame>
	    </SpriteAnimation>	   
		<SpriteAnimation name="a_lines" sprite="s_lines">
		    <Frame>24,4</Frame>
		    <Frame>25,4</Frame>
	    </SpriteAnimation>
	    <SpriteAnimation name="a_idle_foot_1" sprite="s_foot1" isLoop="true" animTime="800" playOnState="Action.Idle">
		    <Frame>0,3</Frame>
		    <Frame>1,3</Frame>
		    <Frame>2,3</Frame>
		    <Frame>3,3</Frame>
	    </SpriteAnimation>
	    <SpriteAnimation name="a_idle_foot_2" sprite="s_foot2" isLoop="true" animTime="800" playOnState="Action.Idle">
		    <Frame>0,4</Frame>
		    <Frame>1,4</Frame>
		    <Frame>2,4</Frame>
		    <Frame>3,4</Frame>
	    </SpriteAnimation>

	    <SpriteAnimation name="a_move_foot_1" sprite="s_foot1" isLoop="true" animTime="800" playOnState="Action.Walk">
		    <Frame>0,5</Frame>
		    <Frame>1,5</Frame>
		    <Frame>2,5</Frame>
		    <Frame>3,5</Frame>
		    <Frame>4,5</Frame>
		    <Frame>5,5</Frame>
		    <Frame>6,5</Frame>
		    <Frame>7,5</Frame>
	    </SpriteAnimation>
	    <SpriteAnimation name="a_move_foot_2" sprite="s_foot2" isLoop="true" animTime="800" playOnState="Action.Walk">
		    <Frame>0,6</Frame>
		    <Frame>1,6</Frame>
		    <Frame>2,6</Frame>
		    <Frame>3,6</Frame>
		    <Frame>4,6</Frame>
		    <Frame>5,6</Frame>
		    <Frame>6,6</Frame>
		    <Frame>7,6</Frame>
	    </SpriteAnimation>

		<SpriteAnimation name="a_jump_foot_1" sprite="s_foot1" isLoop="false" animTime="200" playOnState="Action.Jump">
			<Frame>4,3</Frame>
			<Frame>5,3</Frame>
		</SpriteAnimation>
	    <SpriteAnimation name="a_jump_foot_2" sprite="s_foot2" isLoop="false" animTime="200" playOnState="Action.Jump">
		    <Frame>4,4</Frame>
		    <Frame>5,4</Frame>
	    </SpriteAnimation>		
		
		<SpriteAnimation name="a_fall_foot_1" sprite="s_foot1" isLoop="true" animTime="200" playOnState="Action.Fall">
			<Frame>6,3</Frame>
			<Frame>7,3</Frame>
		</SpriteAnimation>
	    <SpriteAnimation name="a_fall_foot_2" sprite="s_foot2" isLoop="true" animTime="200" playOnState="Action.Fall">
		    <Frame>6,4</Frame>
		    <Frame>7,4</Frame>
	    </SpriteAnimation>		
		
		<SpriteAnimation name="a_attack_foot_1" sprite="s_foot1" isLoop="true" animTime="400" playOnState="Action.Attack">
			<Frame>8,3</Frame>
			<Frame>9,3</Frame>
			<Frame>10,3</Frame>
			<Frame>11,3</Frame>
		</SpriteAnimation>
	    <SpriteAnimation name="a_attack_foot_2" sprite="s_foot2" isLoop="true" animTime="400" playOnState="Action.Attack">
		    <Frame>8,4</Frame>
		    <Frame>9,4</Frame>
		    <Frame>10,4</Frame>
		    <Frame>11,4</Frame>
	    </SpriteAnimation>
    </Animations>
    <ParticleSystems>
	    <ParticleSystem name="ps_lines">
		    <Emitter>
			    <Set name="offset">22, -10</Set>
			    <Set name="offsetFacing">true</Set>
			    <Set name="infParticles">true</Set>
			    <Set name="infLifeTime">true</Set>
			    <Set name="particlesPerEmission">1</Set>
			    <Set name="randomizeInterval">true</Set>
			    <Set name="intervalMin">0.2</Set>
			    <Set name="intervalMax">0.25</Set>
		    </Emitter>
		    <Particle randomSpriteFrame="true" autoLifeTimeToTarget="true">
			    <Random name="offset" min="-6, 6" max="6, 16" />
			    <Set name="sprite">s_lines</Set>
			    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				<Set name="lifeTime">0.4</Set>
			    <Set name="initialScale">0.75,0.75</Set>
			    <Curve name="initialAlpha">
				    <KeyFrame>0, 1</KeyFrame>
				    <KeyFrame>0.5, 1</KeyFrame>
				    <KeyFrame>1, 0</KeyFrame>
			    </Curve>
			    <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1.5" angle="0" />    
				<Set name="rotateWithVelocity">true</Set>
			    <Set name="flipX" source="featherFlipX" />
		    </Particle>
	    </ParticleSystem>
	    <ParticleSystem name="ps_feathers">
		    <Emitter>
			    <Set name="offset">22, -10</Set>
			    <Set name="offsetFacing">true</Set>
			    <Set name="infParticles">true</Set>
			    <Set name="infLifeTime">true</Set>
			    <Set name="particlesPerEmission">1</Set>
			    <Set name="randomizeInterval">true</Set>
			    <Set name="intervalMin">0.1</Set>
			    <Set name="intervalMax">0.125</Set>
		    </Emitter>
		    <Particle randomSpriteFrame="true" autoLifeTimeToTarget="true">
			    <Set name="sprite">s_feather</Set>
			    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
			    <Random name="offset" min="-6, 6" max="6, 16" />
			    <Curve name="initialAlpha">
				    <KeyFrame>0, 1</KeyFrame>
				    <KeyFrame>0.5, 1</KeyFrame>
				    <KeyFrame>1, 0</KeyFrame>
			    </Curve>
			    <Random name="initialScale" min="0.24" max="0.48"/>
			    <Set name="isBackgroundParticle">false</Set>
			    <Set name="lifeTime">0.4</Set>
			    <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1.5" angle="0" />
			    <Random name="initialAngle" min="0" max="360" />
			    <Random name="initialRotationRate" min="70" max="90" />
			    <Set name="flipX" source="featherFlipX" />
		    </Particle>
	    </ParticleSystem>
	    <ParticleSystem name="ps_destroyFeathers">
		    <Emitter>
			    <Set name="lifeTime">2</Set>
			    <Set name="particlesPerEmission">8</Set>
			    <Set name="particlesToEmit">1</Set>
		    </Emitter>
		    <Particle  randomSpriteFrame="true">
			    <Random name="offset" min="0,0.1" max="16,16.1"/>
			    <Set name="sprite">s_feather</Set>
			    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
			    <Set name="lifeTime">1</Set>
			    <Set name="useGravity">true</Set>
			    <Set name="gravityVector">0, 100</Set>
			    <Random name="initialScale" min="0.2" max="0.4"/>
			    <Random name="initialAngle" min="0" max="360" />
			    <Random name="initialRotationRate" min="70" max="90" />
			    <RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200" />
			    <Curve name="initialAlpha">
				    <KeyFrame>0, 1</KeyFrame>
				    <KeyFrame>0.5, 1</KeyFrame>
				    <KeyFrame>1, 0</KeyFrame>
			    </Curve>
		    </Particle>
	    </ParticleSystem>	   
	</ParticleSystems>
	<RenderOptions>
      <Default>
		  <Set name="ClothingOffsetFromShoes">-14.5</Set>
		  <Set name="IsToRenderPants">true</Set>
		  <Set name="IncludeAllActions">true</Set>
		  <Set name="UserNameOffset">10</Set>
	      <Set name="ShoesShouldIgnoreRaptorLegsOffset">false</Set>
	      <Set name="IsVehicle">true</Set>
		  <Set name="IsHorse">true</Set>
		  <Set name="IsCar">false</Set>
		  <Set name="ShoesHidesBodyLegs">false</Set>
		  <Set name="RenderShoesWithMermaidTail">true</Set>
      </Default>
		<Override overrideOnState="Action.Walk">
			<Set name="IsCar">true</Set>
			<Set name="ClothingOffsetFromShoes">-13.5</Set>
		</Override>
    </RenderOptions>

	  <VariableMap>
		  <Set name="featherFlipX">false</Set>
	  </VariableMap>
  </Data>

	<RenderRules>
		<RenderShoes>
			<StopIf type="or">
				<IsAction>BUILD</IsAction>
				<IsSitting>true</IsSitting>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
		</RenderShoes>
		<Update>
			<AvatarTransform class="Face" onState="Action.Attack">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<StopIf>
				<IsSitting>false</IsSitting>
			</StopIf>
			<ParticleSystemOff name="ps_feathers" />
			<ParticleSystemOff name="ps_lines" />
		</Update>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyFeathers" />
		</OnDestroyedTile>
		<RenderInFront>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_foot2" offset="7,-17"/>
		</RenderInFront>
		<OnPunchStop>
			<ParticleSystemOff name="ps_feathers" />
			<ParticleSystemOff name="ps_lines" />
		</OnPunchStop>
		<OnPunchStart>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="featherFlipX" RightHandVariableName="false" OperationType="Set" onState="Facing.Right" />
			<ArithmethicOperation LeftHandVariableName="featherFlipX" RightHandVariableName="true" OperationType="Set" onState="Facing.Left" />
			<ParticleSystemUpdate name="ps_feathers"/>
			<ParticleSystemUpdate name="ps_lines"/>
		</OnPunchStart>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_foot1" offset="10,-18.5"/>
		</RenderBehind>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_equip" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="22,29" />
		<Sprite name="s_muzzleFlash" fileName="game/particles12.rttex" textureSize="32" frame="31,2" />
		<Sprite name="s_pirate" fileName="game/particles_large15.rttex" textureSize="64" frame="11,6" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="30,2" />
		<VariableMap>
			<Set name="muzzleFlipX">false</Set>
		</VariableMap>
		<Animations>
			<SpriteSinPulseAnimation name="a_pirateIdleStretchX" playOnState="Action1.None" sprite="s_pirate">
				<Parameter name="scale.x">
					<Set name="offset">1</Set>
					<Set name="period">3000</Set>
					<Set name="scale">0.05</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_pirateIdleStretchY" playOnState="Action1.None" sprite="s_pirate">
				<Parameter name="scale.y">
					<Set name="offset">1</Set>
					<Set name="period">2500</Set>
					<Set name="scale">0.05</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_piratePunchStretchX" playOnState="Action1.Punch" sprite="s_pirate">
				<Parameter name="scale.x">
					<Set name="offset">1</Set>
					<Set name="period">3000</Set>
					<Set name="scale">0</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_piratePunchStretchY" playOnState="Action1.Punch" sprite="s_pirate">
				<Parameter name="scale.y">
					<Set name="offset">1</Set>
					<Set name="period">2500</Set>
					<Set name="scale">0</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteAnimation name="s_pirateIdle" sprite="s_pirate" animTime="100" isLoop="true" playOnState="Action1.None">
				<Frame>11,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_piratePunch" sprite="s_pirate" animTime="200" isLoop="true" playOnState="Action1.Punch">
				<Frame>12,6</Frame>
				<Frame>13,6</Frame>
				<Frame>14,6</Frame>
				<Frame>15,6</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action1">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition type="or">
							<IsVariableBool name="isMannequin">true</IsVariableBool>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="DefaultPunchSound">audio/shotgun.wav</Set>
				<Set name="IsToRenderParticlesWhenShrunken">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_muzzleFlash" updateState="Action1.Punch" renderStage="RenderBehind">
				<Emitter>
					<Set name="offset">27, -32</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzleFlash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialVelocity">0, -100</Set>
					<Set name="flipX" source="muzzleFlipX" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punch" updateStage="AddClothingParticles" updateState="Action1.Punch" renderStage="RenderBehind">
				<Emitter>
					<Set name="offset">12, -37</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<AddClothingParticles>
			<Group onState="Action1.Punch">
				<ArithmethicOperation LeftHandVariableName="muzzleFlipX" RightHandVariableName="false" OperationType="Set" onState="Facing.Right" />
				<ArithmethicOperation LeftHandVariableName="muzzleFlipX" RightHandVariableName="true" OperationType="Set" onState="Facing.Left" />
				<ParticleSystemUpdate name="ps_muzzleFlash" />
				<ParticleSystemUpdate name="ps_punch" />
			</Group>
		</AddClothingParticles>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>
			<Translate>-16,-46,0</Translate>
			<SpriteRender name="s_pirate" alignment="CENTER" blend="ADDITIVE" drawShadow="false" />
		</RenderBehind>
		<RenderChestItem>
			<SpriteRender name="s_equip" offset="0,0" alignment="DOWN_CENTER" />
		</RenderChestItem>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">20</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wing" fileName="game/particles_large15.rttex" textureSize="64" frame="0,10"/>
    <Sprite name="s_spark" fileName="game/particles12.rttex" textureSize="32" frame="3,1"/>

	  <StateMachines>
		  <StateMachine name="Action">
			  <States>
				  <State name="Idle" />
				  <State name="JumpStraight" />
				  <State name="FallStraight" />
			  </States>
			  <Transitions>
				  <Transition to="Idle" from="FallStraight">
					  <Condition>
						  <IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
					  </Condition>
				  </Transition>
				  <Transition to="JumpStraight" from="Idle|FallStraight">
					  <Condition>
						  <IsAction>JUMP</IsAction>
					  </Condition>
				  </Transition>
				  <Transition to="FallStraight" from="JumpStraight|Idle">
					  <Condition>
						  <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
					  </Condition>
				  </Transition>
			  </Transitions>
		  </StateMachine>		  
		  <StateMachine name="TrialAnim">
			  <States>
				  <State name="Idle" />
				  <State name="Move" />
			  </States>
			  <Transitions>
				  <Transition to="Idle" from="Move">
					  <Condition>
						  <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
					  </Condition>
				  </Transition>
				  <Transition to="Move" from="Idle">
					  <Condition>
						  <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
					  </Condition>
				  </Transition>
			  </Transitions>
		  </StateMachine>
	  </StateMachines>
	  
    <Animations>
      <SpriteAnimation name="wingEquip" sprite="s_wing" isLoop="true" playOnState="Action.Idle" animTime="1200">
        <Frame>0,10</Frame>
        <Frame>1,10</Frame>
        <Frame>2,10</Frame>
        <Frame>3,10</Frame>
        <Frame>4,10</Frame>
        <Frame>5,10</Frame>
        <Frame>6,10</Frame>
        <Frame>7,10</Frame>
        <Frame>8,10</Frame>
        <Frame>9,10</Frame>
        <Frame>10,10</Frame>
        <Frame>11,10</Frame>
      </SpriteAnimation>      
		
	  <SpriteAnimation name="wingJump" sprite="s_wing" playOnState="Action.JumpStraight" isLoop="false" animTime="300">
        <Frame>15,10</Frame>
        <Frame>14,10</Frame>
        <Frame>12,10</Frame>
        <Frame>13,10</Frame>
      </SpriteAnimation>

		<SpriteAnimation name="wingFall" sprite="s_wing" playOnState="Action.FallStraight" isLoop="false" animTime="100">
			<Frame>13,10</Frame>
			<Frame>12,10</Frame>
			<Frame>14,10</Frame>
			<Frame>15,10</Frame>
		</SpriteAnimation>
    </Animations>

	  <ParticleSystems>
		  <ParticleSystem name="ps_luteTrail">
			  <Emitter>
				  <Set name="offset">-25, -16</Set>
				  <Set name="emissionInterval">0.30</Set>
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="offsetFacing">false</Set>
				  <Set name="particlesPerEmission">1</Set>
				  <OrbitOffset>
					  <Set name="maxScale">0.7f</Set>
					  <Set name="hasOrbit">true</Set>
					  <Set name="hOrbitPeriod">6000</Set>
					  <Set name="hAmplitude">8</Set>
					  <Set name="hTimeOffset">0</Set>
					  <Set name="vAmplitude">6</Set>
					  <Set name="vOrbitPeriod">4000</Set>
					  <Set name="vTimeOffset">0</Set>
					  <Set name="minScale">0.4</Set>
				  </OrbitOffset>
			  </Emitter>
			  <Particle>
				  <Set name="sprite">s_spark</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Curve name="initialAlpha">
					  <KeyFrame>0, 1</KeyFrame>
					  <KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Curve name="initialRotationRate">
					  <KeyFrame>0, 15</KeyFrame>
					  <KeyFrame>1, 5</KeyFrame>
				  </Curve>
				  <Set name="relativeToEmitter">false</Set>
				  <Random name="initialAngle" min="0" max="360" />
				  <Random name="finalAngle" min="0" max="360" />
				  <Set name="interpolateAngle">true</Set>
				  <Set name="initialScale">1,1</Set>
				  <Random name="finalScale" min="0.3" max="0.6" />
				  <Set name="interpolateScale">true</Set>
				  <Random name="offset" min="-2,-3" max="2,3" />
				  <Set name="lifeTime">1</Set>
			  </Particle>
		  </ParticleSystem>
		  <ParticleSystem name="ps_luteTrail2">
			  <Emitter>
				  <Set name="offset">25, -16</Set>
				  <Set name="emissionInterval">0.30</Set>
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="offsetFacing">false</Set>
				  <Set name="particlesPerEmission">1</Set>
				  <OrbitOffset>
					  <Set name="maxScale">0.7f</Set>
					  <Set name="hasOrbit">true</Set>
					  <Set name="hOrbitPeriod">-6000</Set>
					  <Set name="hAmplitude">8</Set>
					  <Set name="hTimeOffset">0</Set>
					  <Set name="vAmplitude">6</Set>
					  <Set name="vOrbitPeriod">4000</Set>
					  <Set name="vTimeOffset">0</Set>
					  <Set name="minScale">0.4</Set>
				  </OrbitOffset>
			  </Emitter>
			  <Particle>
				  <Set name="sprite">s_spark</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Curve name="initialAlpha">
					  <KeyFrame>0, 1</KeyFrame>
					  <KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Curve name="initialRotationRate">
					  <KeyFrame>0, 15</KeyFrame>
					  <KeyFrame>1, 5</KeyFrame>
				  </Curve>
				  <Set name="relativeToEmitter">false</Set>
				  <Random name="initialAngle" min="0" max="360" />
				  <Random name="finalAngle" min="0" max="360" />
				  <Set name="interpolateAngle">true</Set>
				  <Set name="initialScale">1,1</Set>
				  <Random name="finalScale" min="0.3" max="0.6" />
				  <Set name="interpolateScale">true</Set>
				  <Random name="offset" min="-2,-3" max="2,3" />
				  <Set name="lifeTime">1</Set>
			  </Particle>
		  </ParticleSystem>
		  
		  
		  <ParticleSystem name="ps_luteTrailMove">
			  <Emitter>
				  <Set name="offset">-25, -16</Set>
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">1</Set>
				  <Set name="emissionInterval">0.08</Set>
				  <OrbitOffset>
					  <Set name="maxScale">0.7f</Set>
					  <Set name="hasOrbit">true</Set>
					  <Set name="hOrbitPeriod">6000</Set>
					  <Set name="hAmplitude">8</Set>
					  <Set name="hTimeOffset">0</Set>
					  <Set name="vAmplitude">6</Set>
					  <Set name="vOrbitPeriod">4000</Set>
					  <Set name="vTimeOffset">0</Set>
					  <Set name="minScale">0.4</Set>
				  </OrbitOffset>
			  </Emitter>
			  <Particle>
				  <Set name="sprite">s_spark</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Curve name="initialAlpha">
					  <KeyFrame>0, 1</KeyFrame>
					  <KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Curve name="initialRotationRate">
					  <KeyFrame>0, 15</KeyFrame>
					  <KeyFrame>1, 5</KeyFrame>
				  </Curve>
				  <Random name="initialAngle" min="0" max="360" />
				  <Random name="finalAngle" min="0" max="360" />
				  <Set name="interpolateAngle">true</Set>
				  <Set name="initialScale">1,1</Set>
				  <Random name="finalScale" min="0.3" max="0.6" />
				  <Set name="interpolateScale">true</Set>
				  <Random name="offset" min="-2,-3" max="2,3" />
				  <Set name="lifeTime">1</Set>
			  </Particle>
		  </ParticleSystem>
		  <ParticleSystem name="ps_luteTrail2Move">
			  <Emitter>
				  <Set name="offset">25, -16</Set>
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">1</Set>
				  <Set name="emissionInterval">0.08</Set>
				  <OrbitOffset>
					  <Set name="maxScale">0.7f</Set>
					  <Set name="hasOrbit">true</Set>
					  <Set name="hOrbitPeriod">-6000</Set>
					  <Set name="hAmplitude">8</Set>
					  <Set name="hTimeOffset">0</Set>
					  <Set name="vAmplitude">6</Set>
					  <Set name="vOrbitPeriod">4000</Set>
					  <Set name="vTimeOffset">0</Set>
					  <Set name="minScale">0.4</Set>
				  </OrbitOffset>
			  </Emitter>
			  <Particle>
				  <Set name="sprite">s_spark</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Curve name="initialAlpha">
					  <KeyFrame>0, 1</KeyFrame>
					  <KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Curve name="initialRotationRate">
					  <KeyFrame>0, 15</KeyFrame>
					  <KeyFrame>1, 5</KeyFrame>
				  </Curve>
				  <Random name="initialAngle" min="0" max="360" />
				  <Random name="finalAngle" min="0" max="360" />
				  <Set name="interpolateAngle">true</Set>
				  <Set name="initialScale">1,1</Set>
				  <Random name="finalScale" min="0.3" max="0.6" />
				  <Set name="interpolateScale">true</Set>
				  <Random name="offset" min="-2,-3" max="2,3" />
				  <Set name="lifeTime">1</Set>
			  </Particle>
		  </ParticleSystem>
	  </ParticleSystems>

  </Data>

  <RenderRules>
	<AddClothingParticles>
		<ParticleSystemUpdate name="ps_luteTrail" onState="TrialAnim.Idle"/>
		<ParticleSystemUpdate name="ps_luteTrail2" onState="TrialAnim.Idle"/>
		
		<ParticleSystemUpdate name="ps_luteTrailMove" onState="TrialAnim.Move"/>
		<ParticleSystemUpdate name="ps_luteTrail2Move" onState="TrialAnim.Move"/>
	</AddClothingParticles>
	<RenderFrontpack>
		<ParticleSystemRender name="ps_luteTrail"/>
		<ParticleSystemRender name="ps_luteTrail2"/>		
		
		<ParticleSystemRender name="ps_luteTrailMove"/>
		<ParticleSystemRender name="ps_luteTrail2Move"/>
	</RenderFrontpack>
    <RenderBackpack>
      <SpriteRender name="s_wing" offset="0,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="s_wing" offset="0,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Dance" />
					<State name="Vertical" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Dance|Vertical">
						<Condition type="and">
							<IsAction>IDLE</IsAction>
							<IsAction operatorType="NotEqual">FALL</IsAction>
							<IsAction operatorType="NotEqual">JUMP</IsAction>
							<IsDancing>false</IsDancing>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Idle|Vertical">
						<Condition>
							<IsDancing>true</IsDancing>
						</Condition>
					</Transition>
					<Transition to="Vertical" from="Dance|Idle">
						<Condition type="and">
							<IsAction operatorType="NotEqual">IDLE</IsAction>

							<IsVariableFloat name="speed.y" operator="Greater" abs="true">0</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

			<StateMachine name="Movement">
				<States>
					<State name="None"/>
					<State name="Movement" />
				</States>
				<Transitions>
					<Transition to="None" from="Movement">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Movement" from="None">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>


		<Sprite name="s_wing" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="16,3"/>
		<Sprite name="s_wing_right" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="16,3"/>
		<Sprite name="s_back_strap" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="18,3"/>
		<Sprite name="s_mist_particle" fileName="game/particles12.rttex" textureSize="32" frame="23,10"/>
		<Sprite name="s_glitter_particle" fileName="game/particles12.rttex" textureSize="32" frame="24,10"/>
		<Animations>

			<SpriteAnimation name="s_wing_dance_Animation" sprite="s_wing" animTime="400" isLoop="true" playOnState="Motion.Dance">
				<Frame>16,3</Frame>
				<Frame>17,3</Frame>
			</SpriteAnimation>						
			<SpriteAnimation name="s_wing_2_dance_Animation" sprite="s_wing_right" animTime="400" isLoop="true" playOnState="Motion.Dance">
				<Frame>16,3</Frame>
				<Frame>17,3</Frame>
			</SpriteAnimation>			
	

			<SpriteAnimation name="s_wing_idle_Animation" sprite="s_wing" animTime="50" isLoop="true" playOnState="Motion.Idle">
				<Frame>16,3</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="s_wing_2_idle_Animation" sprite="s_wing_right" animTime="50" isLoop="true" playOnState="Motion.Idle">
				<Frame>16,3</Frame>
			</SpriteAnimation>


			<CurveAnimationVec4 name="staff_fixed_rotation" autoPlay="true" isLoop="true" animTime="2110">
				<Curve name="hair_rotation">
					<KeyFrame>0.f, 25,0,0,1</KeyFrame>
					<KeyFrame>0.5f, 15,0,0,1</KeyFrame>
					<KeyFrame>1.f, 25,0,0,1</KeyFrame>
				</Curve>
			</CurveAnimationVec4> 			
			
			
			<CurveAnimationVec4 name="staff_fixed_rotation2" autoPlay="true" isLoop="true" animTime="2110">
				<Curve name="hair_rotation_SECOND">
					<KeyFrame>0.f, -15,0,0,1</KeyFrame>
					<KeyFrame>0.5f, -25,0,0,1</KeyFrame>
					<KeyFrame>1.f, -15,0,0,1</KeyFrame>
				</Curve>
			</CurveAnimationVec4> 
			


		</Animations>
		<ParticleSystems>
			<ParticleSystem name="MistParticles" updateStage="RenderBackpack" updateState="Movement.Movement">
				<Emitter>
					<Set name="offset">0, -15</Set>
					<Set name="emissionInterval">0.025</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">8</Set>
				</Emitter>
				<Particle angleRelativeToPlayerSpeed="true">
					<Select name="offset" input="particleIndex">
						<Item>-24, 0</Item>
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
						<Item>24, 0</Item>
						<Item>-24, 0</Item>
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
						<Item>24, 0</Item>
					</Select>
					<Set name="sprite">s_mist_particle</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="EmberLeftParticleLeft" updateStage="RenderBackpack" updateState="Movement.Movement">
				<Emitter>
					<Set name="offset">-20, -15</Set>
					<Set name="emissionInterval">0.025</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle angleRelativeToPlayerSpeed="true">
					<Set name="sprite">s_glitter_particle</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="relativeToEmitter">false</Set>
					<Random name="offset" min="-8, -8" max="8, 8" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="EmberLeftParticleRight" updateStage="RenderBackpack" updateState="Movement.Movement">
				<Emitter>
					<Set name="offset">20, -15</Set>
					<Set name="emissionInterval">0.025</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle angleRelativeToPlayerSpeed="true">
					<Set name="sprite">s_glitter_particle</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="relativeToEmitter">false</Set>
					<Random name="offset" min="-8, -8" max="8, 8" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		

		<RenderOptions>
			<Default>
				<Set name="ShouldHover">true</Set>
				<Set name="HideParticlesOnTheaterSeat">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="hair_rotation">0, 0, 0, 1</Set>
			<Set name="hair_position">-9, -15, 0</Set>

			<Set name="hair_position_SECOND">9, -15, 0</Set>
			<Set name="hair_rotation_SECOND">0, 0, 0, 1</Set>
		</VariableMap>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
		</AddClothingParticles>
		<RenderBackpack>
			<StopIf>
				<IsAction>DIE</IsAction>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>

			<ParticleSystemRender name="EmberLeftParticleLeft" />
			<ParticleSystemRender name="EmberLeftParticleRight" />
			
			<SpriteRender name="s_back_strap" scale="1,1" offset="0,0" alignment="DOWN_CENTER"/>

			<Group>
				<Translate>hair_position</Translate>
				<Rotate>hair_rotation</Rotate>
				<SpriteRender name="s_wing" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="RIGHT_CENTER"  onState="Facing.Right"/>
				<SpriteRender name="s_wing" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="LEFT_CENTER"  onState="Facing.Left"/>
			</Group>

			<Group>
				<Translate>hair_position_SECOND</Translate>
				<Rotate>hair_rotation_SECOND</Rotate>
				<SpriteRender name="s_wing_right" flip="1,0" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="LEFT_CENTER"  onState="Facing.Right"/>
				<SpriteRender name="s_wing_right" flip="1,0" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="RIGHT_CENTER"  onState="Facing.Left"/>
			</Group>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
		</RenderBackpack>
	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
	<Data>
		<Sprite name="SpriteBack" fileName="game/glb9_back.rttex" textureSize="41,47" frame="0, 0" />
		<Sprite name="SpriteBackOverlay" fileName="game/glb9_back_overlay.rttex" textureSize="41,47" frame="0, 0" />
		<Sprite name="SpriteLeftHand" fileName="game/glb9_parts.rttex" textureSize="32,32" frame="0,0" />
		<Sprite name="SpriteRightHand" fileName="game/glb9_parts.rttex" textureSize="32,32" frame="1,0" />
		<Sprite name="SpriteShoulder" fileName="game/glb9_parts.rttex" textureSize="32,32" frame="0,1" />

		<Animations>
		</Animations>

		<StateMachines>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<VariableMap>
			<Set name="footOffset1">0</Set>
			<Set name="footOffset2">0</Set>
		</VariableMap>

		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderBackArmBuild">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>

		<RenderShirt>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>

			<SpriteRender
				name="SpriteBackOverlay"
				blend="PREMULTIPLIED_ALPHA"
				alignmentLeft="UPPER_LEFT"
				alignmentRight="UPPER_RIGHT"
				drawShadow="false"
				offset="10,-36" />
		</RenderShirt>

		<RenderInFront>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>

			<SpriteRender
				name="SpriteShoulder"
				blend="PREMULTIPLIED_ALPHA"
				alignmentLeft="UPPER_LEFT"
				alignmentRight="UPPER_RIGHT"
				drawShadow="false"
				offset="2,-38"
				useFixedRotation="true"
				fixedRotation="0" />
		</RenderInFront>

		<RenderBackpack>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>

			<Translate>-11,26,0</Translate>

			<SpriteRender
				name="SpriteBack"
				blend="PREMULTIPLIED_ALPHA"
				alignmentLeft="UPPER_LEFT"
				alignmentRight="UPPER_RIGHT"
				drawShadow="true"
				offset="21,-62" />

			<SpriteRender
				name="SpriteShoulder"
				blend="PREMULTIPLIED_ALPHA"
				alignmentLeft="UPPER_LEFT"
				alignmentRight="UPPER_RIGHT"
				drawShadow="true"
				offset="36,-64"
				useFixedRotation="true"
				fixedRotation="0" />
		</RenderBackpack>

		<RenderHandItem>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>

			
			<Group onState="Facing.Left">
				<SpriteRender
					name="SpriteLeftHand"
					blend="PREMULTIPLIED_ALPHA"
					alignmentRight="UPPER_LEFT"
					alignmentLeft="UPPER_RIGHT"
					drawShadow="true"
					offset="-24,-5"
					rotationPoint="-15,6" />
			</Group>

			<Group onState="Facing.Right">
				<SpriteRender
					name="SpriteLeftHand"
					blend="PREMULTIPLIED_ALPHA"
					alignmentRight="UPPER_LEFT"
					alignmentLeft="UPPER_RIGHT"
					drawShadow="true"
					offset="-24,-5"
					rotationPoint="15,6" />
			</Group>
		</RenderHandItem>

		<RenderBackHandItem>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>

			<Group onState="Facing.Left">
				<SpriteRender
					name="SpriteRightHand"
					blend="PREMULTIPLIED_ALPHA"
					alignmentRight="UPPER_LEFT"
					alignmentLeft="UPPER_RIGHT"
					drawShadow="true"
					offset="-15,-10"
					rotationPoint="-19,12" />
			</Group>

			<Group onState="Facing.Right">
				<SpriteRender
					name="SpriteRightHand"
					blend="PREMULTIPLIED_ALPHA"
					alignmentRight="UPPER_LEFT"
					alignmentLeft="UPPER_RIGHT"
					drawShadow="true"
					offset="-15,-10"
					rotationPoint="19,12" />
			</Group>
		</RenderBackHandItem>

	</RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
	<Data>
		<Sprite name="SpriteLeg" fileName="game/glb9_parts.rttex" textureSize="32,32" frame="1,1" />
		
		<Animations>
			<CurveAnimationVec3 name="AnimIdleL" animTime="100" isLoop="true" autoPlay="true" playOnAction="IDLE|PUNCH|JUMPEND">
				<Curve name="leftLegPosition">
					<KeyFrame>0.00,0,0,0</KeyFrame>
					<KeyFrame>1.00,0,0,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="AnimIdleR" animTime="100" isLoop="true" autoPlay="true" playOnAction="IDLE|PUNCH|JUMPEND">
				<Curve name="rightLegPosition">
					<KeyFrame>0.00,0,0,0</KeyFrame>
					<KeyFrame>1.00,0,0,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="AnimJumpL" animTime="100" isLoop="false" autoPlay="true" playOnAction="JUMPSTART|JUMP">
				<Curve name="leftLegPosition">
					<KeyFrame>0.00,0,0,0</KeyFrame>
					<KeyFrame>1.00,0,4,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="AnimJumpR" animTime="100" isLoop="false" autoPlay="true" playOnAction="JUMPSTART|JUMP">
				<Curve name="rightLegPosition">
					<KeyFrame>0.00,0,0,0</KeyFrame>
					<KeyFrame>1.00,0,4,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="AnimFallL" animTime="100" isLoop="false" autoPlay="true" playOnAction="FALL">
				<Curve name="leftLegPosition">
					<KeyFrame>0.00,0,4,0</KeyFrame>
					<KeyFrame>1.00,0,0,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="AnimFallR" animTime="100" isLoop="false" autoPlay="true" playOnAction="FALL">
				<Curve name="rightLegPosition">
					<KeyFrame>0.00,0,4,0</KeyFrame>
					<KeyFrame>1.00,0,0,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="AnimWalkL" animTime="500" isLoop="true" autoPlay="true" playOnAction="WALK">
				<Curve name="leftLegPosition">
					<KeyFrame>0.00,0,0,0</KeyFrame>
					<KeyFrame>0.25,0,2,0</KeyFrame>
					<KeyFrame>0.50,0,0,0</KeyFrame>
					<KeyFrame>0.75,0,-2,0</KeyFrame>
					<KeyFrame>1.00,0,0,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="AnimWalkR" animTime="500" isLoop="true" autoPlay="true" playOnAction="WALK">
				<Curve name="rightLegPosition">
					<KeyFrame>0.00,0,0,0</KeyFrame>
					<KeyFrame>0.25,0,-2,0</KeyFrame>
					<KeyFrame>0.50,0,0,0</KeyFrame>
					<KeyFrame>0.75,0,2,0</KeyFrame>
					<KeyFrame>1.00,0,0,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
		</Animations>
		<ParticleSystems>
		</ParticleSystems>
		<VariableMap>
			<Set name="leftLegPosition">0,0,0</Set>
			<Set name="rightLegPosition">0,0,0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="ClothingOffsetFromShoes">-26</Set>
				<Set name="UserNameOffset">40</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderShoes>
			<Group>
				<Translate>leftLegPosition</Translate>
				<Translate>-11,26,0</Translate>
				<SpriteRender name="SpriteLeg" blend="PREMULTIPLIED_ALPHA" drawShadow="true" offset="8,-16"/>
			</Group>
			<Group>
				<Translate>rightLegPosition</Translate>
				<Translate>-11,26,0</Translate>
				<SpriteRender name="SpriteLeg" blend="PREMULTIPLIED_ALPHA" drawShadow="true" offset="-8,-16"/>
			</Group>
		</RenderShoes>
	</RenderRules>
</ItemRenderer>
