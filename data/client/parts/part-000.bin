																	<SpriteAnimation name="shadowSoulBack" animTime="400" sprite="itisvowygy">
																		<Frame>1,1</Frame>
																		<Frame>2,1</Frame>
																	</SpriteAnimation>
																	<SpriteAnimation name="shadowSoulBack2" animTime="400" sprite="reeelOnDiscord">
																		<Frame>1,2</Frame>
																		<Frame>2,2</Frame>
																	</SpriteAnimation>
			<SpriteAnimation name="sword_idle_anim" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch" useFacing="RIGHT"
				sprite="APAINIVOW" animTime="400">
					<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_idle_anim_left" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch" useFacing="LEFT"
				sprite="APAINIVOW" animTime="600">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="backpack_idle_anim" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch|playerState.Punch"
				useFacing="RIGHT" sprite="BackPack" animTime="600">
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="backpack_idle_anim_left" isLoop="true"
				playOnState="playerState.Idle|playerState.ZombiePunch|playerState.Punch"
				useFacing="LEFT" sprite="BackPack" animTime="600">
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_idle" autoPlay="false" sprite="APAINIVOW"
				playOnState="playerState.Idle" animTime="50">
				<Frame>0,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_slash_frame" animTime="400" sprite="vowdmm">
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
			</SpriteAnimation>
			 <SpriteAnimation name="rapsRespawn" sprite="imreel" animTime="1200" isLoop="true">
