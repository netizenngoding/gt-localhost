					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialVelocity" source="platformVel"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0.5</KeyFrame>
					</Curve>
					<Set name="initalRGB">0.3, 0.94, 1</Set>
					<Set name="finalRGB">0, 0.633, 0.78</Set>
					<Set name="interpolateRGB">true</Set>
					<Random name="initialScale" min="1,1" max="0.8,0.8"/>
					<Set name="lifeTime">0.4</Set>
					<Set name="relativeToEmitter">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail" updateStage="RenderHandItem" renderStage="RenderHandItem" updateState="Horizontal.Yes">
				<Emitter>
					<Set name="offset">5, 19</Set>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.3</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" angleRelativeToPlayerSpeed="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0.5</KeyFrame>
						<KeyFrame>0.3, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,0.9</KeyFrame>
						<KeyFrame>1, 1,0.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">0, 0.633, 0.78</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	
		<TileStampData>
			<Set name="RenderObjectName">AquaticVolcanicGauntletsTileStamp</Set>
			<Set name="RenderDefaultCracks">true</Set>
			<Sprites>
				<Sprite fname="game/particles12.rttex" scale="1.3,1">
					<Animation animTime="100">
						<Frame>7,19</Frame>
						<Frame>8,19</Frame>
						<Frame>9,19</Frame>
						<Frame>10,19</Frame>
					</Animation>
				</Sprite>
				<Sprite fname="game/particles12.rttex" scale="1.3,1">
					<Animation animTime="100">
						<Frame>11,19</Frame>
						<Frame>12,19</Frame>
						<Frame>13,19</Frame>
						<Frame>14,19</Frame>
					</Animation>
				</Sprite>
				<Sprite fname="game/particles12.rttex" scale="1.3,1">
					<Animation animTime="100">
						<Frame>15,19</Frame>
						<Frame>16,19</Frame>
						<Frame>17,19</Frame>
						<Frame>18,19</Frame>
					</Animation>
				</Sprite>
				<Sprite fname="game/particles12.rttex" scale="1.3,1">
					<Animation animTime="100">
						<Frame>19,19</Frame>
						<Frame>20,19</Frame>
						<Frame>21,19</Frame>
						<Frame>22,19</Frame>
					</Animation>
				</Sprite>
			</Sprites>
		</TileStampData>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="RenderBackArmBuild">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="TargetPosUseTileHealth">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="thrustVel">0,0</Set>
			<Set name="platformVel">0,0</Set>
			<Set name="Player.GetFacing">0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<Update>
			<StopIf type="Or">
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="thrustVel" RightHandVariableName="30,20" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="thrustVel.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="platformVel" RightHandVariableName="-95,0" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="platformVel.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<Group onState="Moving.Yes">
				<AvatarTransform class="Face">
					<Set name="face">MAD</Set>
				</AvatarTransform>
				<Group onState="Punch.No">
					<AvatarTransform class="ArmAngle">
						<Set name="armName">arm1Angle</Set>
						<Set name="armAngle">-50</Set>
					</AvatarTransform>
				</Group>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">-50</Set>
				</AvatarTransform>
			</Group>
		</Update>
		<AddClothingParticles>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Group onState="Moving.Yes">
				<Group onState="Punch.No">
					<ParticleSystemUpdate name="ps_thrustBack"/>
				</Group>
				<ParticleSystemUpdate name="ps_thrustFront"/>
			</Group>
		</AddClothingParticles>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<Group onState="Moving.No">
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm2Angle</Set>
					<Set name="pointTowardsPunchTarget">true</Set>
				</AvatarTransform>
			</Group>
		</OnPunchUpdate>
		<RenderHandItem>
			<SpriteRender name="s_gloveFront" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" />
			<SpriteRender name="s_gloveFront_glow" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" />
			<Group onState="Moving.No">
				<ParticleSystemUpdate name="ps_punchFront" onState="Punch.Yes"/>
			</Group>
		</RenderHandItem>
		<RenderBackHandItem>
			<StopIf>
				<IsAction>BUILD</IsAction>
			</StopIf>
			<SpriteRender offset="-2,5" rotateOffset="true" rotationPoint="0,1" name="s_gloveBack" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" />
			<SpriteRender offset="-3,5" rotateOffset="true" rotationPoint="0,1" name="s_gloveBack_glow" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" />
		</RenderBackHandItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="hit_Sprite_circle" fileName="game/particles_large13.rttex" textureSize="64" frame="2,9" />
		<Sprite name="hit_Sprite_spark" fileName="game/particles11.rttex" textureSize="32" frame="30,20" />
		<Sprite name="left_arm" fileName="game/particles_large13.rttex" textureSize="64" frame="0,8" />
		<Sprite name="left_arm_glow" fileName="game/particles_large13.rttex" textureSize="64" frame="0,9" />
		<Sprite name="magic_symbol" fileName="game/particles_large13.rttex" textureSize="64" frame="2,8" />
		<Sprite name="punch_continue_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="6,7" />
		<Sprite name="punch_end_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="5,7" />
		<Sprite name="punch_start_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="2,7" />
		<Sprite name="right_arm" fileName="game/particles_large13.rttex" textureSize="64" frame="1,8" />
		<Sprite name="right_arm_glow" fileName="game/particles_large13.rttex" textureSize="64" frame="1,9" />
		<Sprite name="s_armor" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="0,17" />
		<Sprite name="s_armor_glow" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="1,17" />
		<Sprite name="punch_continue_trail_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="7,7" />
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<CurveAnimationVec3 name="proxy_position_left_hover" autoPlay="t" isLoop="true" animTime="2500">
				<Curve name="proxy_position_left">
					<KeyFrame>0, -31.6, -29.15, 0</KeyFrame>
					<KeyFrame>0.5,  -31.6, -39.15, 0</KeyFrame>
					<KeyFrame>1, -31.6, -29.15, 0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="proxy_position_right_hover" autoPlay="t" isLoop="true" animTime="2500">
				<Curve name="proxy_position_right">
					<KeyFrame>0, 31.6, -29.15, 0</KeyFrame>
					<KeyFrame>0.5, 31.6, -39.15, 0</KeyFrame>
					<KeyFrame>1, 31.6, -29.15, 0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<SpriteCurveAnimation name="s_armor_glowing" isLoop="true" autoPlay="true" sprite="s_armor_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="left_arm_glow_anim" isLoop="true" autoPlay="true" sprite="left_arm_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="right_arm_glow_anim" isLoop="true" autoPlay="true" sprite="right_arm_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="magic_symbol_rotation_anim" autoPlay="true" isLoop="true" useFacing="RIGHT" sprite="magic_symbol" animTime="5000">
				<Curve name="rotation">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 360</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="hit_Sprites" sprite="hit_Sprite_spark">
				<Frame>30,20</Frame>
				<Frame>31,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="punch_continue" sprite="punch_continue_sprite" animTime="200" isLoop="true" playOnAction="PUNCH">
				<Frame>6,7</Frame>
				<Frame>7,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="punch_end" sprite="punch_end_sprite" animTime="220" playOnAction="IDLE">
				<Frame>5,7</Frame>
				<Frame>4,7</Frame>
				<Frame>3,7</Frame>
				<Frame>2,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="punch_start" sprite="punch_start_sprite" animTime="200" playOnAction="PUNCH">
				<Frame>2,7</Frame>
				<Frame>3,7</Frame>
				<Frame>4,7</Frame>
				<Frame>5,7</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">false</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="armor_position">0, -14.85, 0</Set>
			<Set name="magic_position_left">-9.600, -4.150, 0</Set>
			<Set name="magic_position_right">-9.950, -4.150, 0</Set>
			<Set name="proxy_position_left">-31.6, -29.15, 0</Set>
			<Set name="proxy_position_right">31.6, -29.15, 0</Set>
			<Set name="arm_magic_left">-8.75, -12.45, 0</Set>
			<Set name="arm_magic_right">8, -12.45, 0</Set>
		</VariableMap>
		<ParticleSystems>
			<ParticleSystem name="hit_particle_circle">
				<Emitter>
					<Set name="offset">0, -8</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">10</Set>
					<Set name="delayTimer">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">hit_Sprite_circle</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="initialAlpha">0.5</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.7, 0.7</Set>
					<Set name="finalScale">1.5, 1.5</Set>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle_spark">
				<Emitter>
					<Set name="offset">0, -8</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="emissionInterval">0.6</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite_spark</Set>
					<RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="80,200"/>
					<Set name="gravityVector">0, 100</Set>
					<Set name="useGravity">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="initialRotationRate" min="5" max="15"/>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialScale">1, 1</Set>
					<Set name="finalScale">0.25, 0.25</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="posOffset" min="0, 0.1" max="16,16.1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_continue_particle">
				<Emitter attachment="targetPos">
					<Set name="offset">-4, 12</Set>
					<Set name="lifeTime">0</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.24</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_continue_sprite</Set>
					<Set name="offset">0, 0</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_continue_particle_trial">
				<Emitter attachment="targetPos">
					<Set name="offset">-4, 12</Set>
					<Set name="lifeTime">0</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">16</Set>
					<Set name="delayTimer">0.3</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_continue_trail_sprite</Set>
					<Set name="offset">0, 0</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_end_particle">
				<Emitter attachment="targetPos">
					<Set name="offset">-4, 12</Set>
					<Set name="lifeTime">0</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_end_sprite</Set>
					<Set name="offset">0, 0</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.15</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_start_particle">
				<Emitter attachment="targetPos">
					<Set name="offset">-4, 12</Set>
					<Set name="lifeTime">0</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_start_sprite</Set>
					<Set name="offset">0, 0</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.2</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<ParticleSystemUpdate name="punch_continue_particle_trial" onAction="PUNCH"/>
		</OnPunchUpdate>
		<Update>
			<ParticleSystemUpdate name="punch_continue_particle" onAction="PUNCH" />
		</Update>
		<RenderSittingInTheater>
			<Group>
				<Translate>arm_magic_right</Translate>
				<Scale>0.15,0.15,0</Scale>
				<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
			</Group>
			<Group>
				<Translate>0,5,0</Translate>
				<Translate>proxy_position_right</Translate>
				<Group>
					<Translate>magic_position_right</Translate>
					<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
				</Group>
				<SpriteRender name="right_arm" flip="-1,0" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
				<SpriteRender name="right_arm_glow" flip="-1,0" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
			</Group>
		</RenderSittingInTheater>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group>
				<Translate>arm_magic_right</Translate>
				<Scale>0.15,0.15,0</Scale>
				<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
			</Group>
			<Group>
				<Translate>proxy_position_right</Translate>
				<Group>
					<Translate>magic_position_right</Translate>
					<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
				</Group>
				<SpriteRender name="right_arm" flip="-1,0" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
				<SpriteRender name="right_arm_glow" flip="-1,0" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
			</Group>
		</RenderBehind>
		<OnPunchBegin>
			<ParticleSystemOff name="punch_continue_particle_trial" />
			<ParticleSystemOff name="punch_continue_particle" />
			<ParticleSystemOff name="punch_end_particle" />
			<ParticleSystemUpdate name="punch_start_particle" />
		</OnPunchBegin>
		<OnPunchStop>
			<ParticleSystemOff name="punch_continue_particle_trial" />
			<ParticleSystemOff name="punch_continue_particle" />
			<ParticleSystemOff name="punch_start_particle" />
			<ParticleSystemUpdate name="punch_end_particle" />
		</OnPunchStop>
		<RenderInFront>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group>
				<Translate>arm_magic_left</Translate>
				<Scale>0.15,0.15,0</Scale>
				<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
			</Group>
			<Group>
				<Translate>proxy_position_left</Translate>
				<Group>
					<Translate>magic_position_left</Translate>
					<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
				</Group>
				<SpriteRender name="left_arm" flip="-1,0" blend="PREMULTIPLIED_ALPHA" />
				<SpriteRender name="left_arm_glow" flip="-1,0" blend="PREMULTIPLIED_ALPHA" />
			</Group>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="punch_start_particle" />
			<ParticleSystemRender name="punch_continue_particle_trial" onAction="PUNCH"/>
			<ParticleSystemRender name="punch_continue_particle" onAction="PUNCH"/>
			<ParticleSystemRender name="punch_end_particle" onState="Action.None" />
			<ParticleSystemRender name="hit_particle_circle" />
			<ParticleSystemRender name="hit_particle_spark" />
		</RenderInFront>
		<RenderShirt>
			<Group>
				<Translate>armor_position</Translate>
				<SpriteRender name="s_armor" blend="PREMULTIPLIED_ALPHA" />
				<SpriteRender name="s_armor_glow" blend="PREMULTIPLIED_ALPHA" />
			</Group>
		</RenderShirt>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_particle_spark" />
			<ParticleSystemUpdate name="hit_particle_circle" />
		</OnDamagedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="punch_start_particle" />
			<ParticleSystemOff name="punch_continue_particle_trial" />
			<ParticleSystemOff name="punch_continue_particle" />
			<ParticleSystemOff name="punch_end_particle" />
			<ParticleSystemOff name="hit_particle_circle" />
			<ParticleSystemOff name="hit_particle_spark" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_clouds" fileName="game/particles12.rttex" textureSize="32" frame="15,3" />
		<Sprite name="s_clouds2" fileName="game/particles12.rttex" textureSize="32" frame="16,3" />
		<Sprite name="s_pants" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="11, 8" />
		<Sprite name="s_door" fileName="game/particles_large17.rttex" textureSize="64" frame="10, 13" />
		<Sprite name="s_door_glow" fileName="game/particles_large17.rttex" textureSize="64" frame="11, 13" />

		<Sprite name="particle_slash" fileName="game/particles12.rttex" textureSize="32" frame="28,20"/>
		<Sprite name="particle_punch_trail" fileName="game/particles12.rttex" textureSize="32" frame="29,20"/>

		<Animations>
			<SpriteAnimation name="a_particle_punch_trail" sprite="particle_punch_trail">
				<Frame>29, 20</Frame>
				<Frame>30, 20</Frame>
				<Frame>31, 20</Frame>
			</SpriteAnimation>		
			<SpriteAnimation name="a_clouds" sprite="s_clouds" animTime="200">
				<Frame>30, 15</Frame>
				<Frame>31, 15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_clouds2" sprite="s_clouds2" animTime="200">
				<Frame>31, 15</Frame>
				<Frame>30, 15</Frame>
			</SpriteAnimation>
			
			<InterpolationFloatAnimation name="door_glow_punch_inter" variableName="door_alpha_var" playOnState="Punch.Start|Punch.Punching|Punch.PunchStop" targetVariableName="door_alpha_max" animTime="50"/>

			<SpriteAnimation name="s_door_on_punch_start" sprite="s_door_glow" animTime="200" playOnState="Punch.Start">
				<Frame>12, 13</Frame>
				<Frame>13, 13</Frame>
				<Frame>14, 13</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_door_on_punch_continue" sprite="s_door_glow" animTime="50" playOnState="Punch.Punching">
				<Frame>15, 13</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_door_on_punch_end" sprite="s_door_glow" animTime="200" playOnState="Punch.PunchStop">
				<Frame>14, 13</Frame>
				<Frame>13, 13</Frame>
				<Frame>12, 13</Frame>
			</SpriteAnimation>

			<CurveAnimationVec3 name="door_hover" autoPlay="t" isLoop="true" animTime="1250">
				<Curve name="door_hover_position">
					<KeyFrame>0, -13, -3.5, 0</KeyFrame>
					<KeyFrame>0.5, -13, 1, 0</KeyFrame>
					<KeyFrame>1, -13, -3.5, 0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
		</Animations>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Start" ExitTime="0.21"/>
					<State name="Punching" />
					<State name="PunchStop" ExitTime="0.21"/>
				</States>
				<Transitions>
					<Transition to="No" from="PunchStop"/>
					<Transition to="Start" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punching" from="Start"/>
					<Transition to="PunchStop" from="Punching">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>			
			<StateMachine name="Glow">
				<States>
					<State name="Increase"/>
					<State name="Decrease"/>
				</States>
				<Transitions>
					<Transition to="Increase" from="Decrease">
						<Condition>
							<CompareCustomVariable operatorType="Less" VariableNameToCompare="door_alpha_var" RightHSVariableNameToCompare="door_alpha_delta">0.001</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="Decrease" from="Increase">
						<Condition>
							<CompareCustomVariable operatorType="Greater" VariableNameToCompare="door_alpha_var">1.05</CompareCustomVariable>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">16</Set>
					<Set name="emissionInterval">0.035</Set>
					<Set name="checkParticleNumToEmit">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="-4, -2" max="4, 2" />
					<Set name="sprite">particle_punch_trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5" max="1" />
					<Set name="lifeTime">0.3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="slash_particle"  secondary="trail_particle">
				<Emitter>
					<Set name="offset">-13, -18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offsetFacing">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">particle_slash</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Select name="initialAngle" input="punchCount">
						<Item>30</Item>
						<Item>0</Item>
						<Item>-30</Item>
					</Select>
					<Select name="finalAngle" input="punchCount">
						<Item>-30</Item>
						<Item>0</Item>
						<Item>30</Item>
					</Select>
					<Select name="finalAlpha" input="punchCount">
						<Item>1.05f</Item>
						<Item>1.f</Item>
						<Item>1.05f</Item>
					</Select>
					<Set name="lifeTime">0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="finalAlpha" angle="initialAngle" />
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="finalAlpha" angle="finalAngle" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_left_cloud">
				<Emitter>
					<Set name="offset">0, -24</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Random name="emissionInterval" min="2" max="5" />
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="-14, -20" max="-7, 20" />
					<Set name="sprite">s_clouds</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="lifeTime" min="2" max="4"/>
					<Random name="initialScale" min="0.75" max="1"/>
					<Random name="initialVelocity" min="-7,0" max="-5,0"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 0.9</KeyFrame>
						<KeyFrame>0.7, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_right_cloud">
				<Emitter>
					<Set name="offset">0, -24</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Random name="emissionInterval" min="3" max="4" />
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="7, -8" max="14, 16" />
					<Set name="sprite">s_clouds2</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="lifeTime" min="2" max="4"/>
					<Random name="initialScale" min="0.75" max="1"/>
					<Random name="initialVelocity" min="5,0" max="8,0"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 0.9</KeyFrame>
						<KeyFrame>0.7, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<VariableMap>
			<Set name="DeltaTime">0</Set>
			<Set name="door_hover_position">-13, -16, 0</Set>
			<Set name="door_alpha_var">1</Set>
			<Set name="door_alpha_min">0</Set>
			<Set name="door_alpha_max">1</Set>

			<Set name="door_alpha_speed">0.333</Set>
			<Set name="door_alpha_delta">0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<OnPunchStart>
			<Translate>door_hover_position</Translate>
			<ParticleSystemUpdate name="slash_particle"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderPants>
			<SpriteRender name="s_pants" alignment="DOWN_CENTER" />
		</RenderPants>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsZombified>true</IsZombified>
			</StopIf>
			<Translate>door_hover_position</Translate>
			<SpriteRender name="s_door" alignment="DOWN_CENTER"/>

			<Group>
				<Alpha>door_alpha_var</Alpha>
				<SpriteRender name="s_door_glow" alignment="DOWN_CENTER" drawShadow="false"/>
			</Group>

			<ParticleSystemRender name="slash_particle" />			
			<ParticleSystemRender name="ps_left_cloud" />
			<ParticleSystemRender name="ps_right_cloud" />

			<Group onState="Punch.No">
        <StopIf type="or">
          <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
          <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
          <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
          <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
          <IsRenderMod>RENDER_MOD_MANNEQUIN</IsRenderMod>
        </StopIf>
				<ArithmethicOperation
					LeftHandVariableName="door_alpha_delta"
					RightHandVariableName="door_alpha_speed"
					OperationType="Set" />
				<ArithmethicOperation
					LeftHandVariableName="door_alpha_delta"
					RightHandVariableName="DeltaTime"
					OperationType="Multiply" />

				<ArithmethicOperation
					LeftHandVariableName="door_alpha_var"
					RightHandVariableName="door_alpha_delta"
					OperationType="Add"
					onState="Glow.Increase" />

				<ArithmethicOperation
					LeftHandVariableName="door_alpha_var"
					RightHandVariableName="door_alpha_delta"
					OperationType="Substract"
					onState="Glow.Decrease" />
			</Group>

		</RenderBehind>

		<AddClothingParticles>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Translate>door_hover_position</Translate>
			<ParticleSystemUpdate name="ps_left_cloud"/>
			<ParticleSystemUpdate name="ps_right_cloud"/>
		</AddClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_hit" fileName="game/particles_large14.rttex" textureSize="64" frame="11,10" />
    <Sprite name="s_sword" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="2,7" />
    <Sprite name="s_swordGlow" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="1,7" />
    <Sprite name="s_punchCurve" fileName="game/particles_large10.rttex" textureSize="64" frame="15,9" />
    <Animations>
      <SpriteCurveAnimation name="a_glow" isLoop="true" sprite="s_swordGlow" animTime="3000" autoPlay="true">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.2f, 0.f </KeyFrame>
          <KeyFrame>0.4f, 1.f</KeyFrame>
          <KeyFrame>0.8f, 1.f</KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="UserNameOffset">15</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="False" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_hitFlash">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 1,1</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">16,-18</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="emissionInterval">0.4</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchCurve</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="Punch.False">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_sword" offset="13, 2" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
      <SpriteRender name="s_swordGlow" offset="13,2" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
    </RenderBackHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">400</Set>
        <Set name="Curve">
          <KeyFrame>0.0, 215</KeyFrame>
          <KeyFrame>0.3, 360</KeyFrame>
          <KeyFrame>0.8, 360</KeyFrame>
          <KeyFrame>0.81, 215</KeyFrame>
          <KeyFrame>1, 215</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">45</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitFlash"/>
    </OnDamagedTile>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="chestBackgroundSprite" fileName="game/particles_large16.rttex" textureSize="64" frame="0,14" />
		<Sprite name="chestBackgroundSpriteCats" fileName="game/particles_large16.rttex" textureSize="64" frame="0,13" />
		<Sprite name="chestBackgroundSpriteCatsNoAnim" fileName="game/particles_large16.rttex" textureSize="64" frame="0,13" />
		<Sprite name="chestForegroundSprite" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="7,1" />
		<Sprite name="chestForegroundSpriteGlow" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="8,1" />
		<Sprite name="emberSprite" fileName="game/particles12.rttex" textureSize="32" frame="24,8" />
		<Sprite name="flameSprite" fileName="game/particles12.rttex" textureSize="32" frame="27,8" />
		<Sprite name="respawnParticle" fileName="game/particles_large16.rttex" textureSize="64" frame="8,11" />
		<StateMachines>
			<StateMachine name="IsPunching">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="IsDying">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="MantleAnimation" sprite="chestBackgroundSprite" animTime="3200" autoPlay="true" isLoop="true">
				<Frame>0,14</Frame>
				<Frame>1,14</Frame>
				<Frame>2,14</Frame>
				<Frame>3,14</Frame>
				<Frame>4,14</Frame>
				<Frame>5,14</Frame>
				<Frame>6,14</Frame>
				<Frame>7,14</Frame>
				<Frame>8,14</Frame>
				<Frame>9,14</Frame>
				<Frame>10,14</Frame>
				<Frame>11,14</Frame>
				<Frame>12,14</Frame>
				<Frame>13,14</Frame>
				<Frame>14,14</Frame>
				<Frame>15,14</Frame>
			</SpriteAnimation>				
			
			<SpriteAnimation name="MantleAnimationCats" sprite="chestBackgroundSpriteCats" autoPlay="true" animTime="punchAnimTime" isLoop="true">
				<Frame>0,13</Frame>
				<Frame>1,13</Frame>
				<Frame>2,13</Frame>
				<Frame>3,13</Frame>
				<Frame>4,13</Frame>
				<Frame>5,13</Frame>
				<Frame>6,13</Frame>
				<Frame>7,13</Frame>
				<Frame>8,13</Frame>
				<Frame>9,13</Frame>
				<Frame>10,13</Frame>
				<Frame>11,13</Frame>
				<Frame>12,13</Frame>
				<Frame>13,13</Frame>
				<Frame>14,13</Frame>
				<Frame>15,13</Frame>
			</SpriteAnimation>					
			
			<SpriteAnimation name="emberAnimation" sprite="emberSprite" animTime="300">
				<Frame>24,8</Frame>
				<Frame>25,8</Frame>
				<Frame>26,8</Frame>
			</SpriteAnimation>			
			
			<SpriteAnimation name="flameAnimation" sprite="flameSprite" animTime="300">
				<Frame>27,8</Frame>
				<Frame>28,8</Frame>
				<Frame>29,8</Frame>
			</SpriteAnimation>

			<SpriteCurveAnimation name="chestForegroundSpriteGlowAnim" isLoop="true" sprite="chestForegroundSpriteGlow" animTime="5000" autoPlay="true">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f</KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="MistParticles">
				<Emitter>
					<Set name="offset">-16, -16</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.02</Set>
				</Emitter>
				<Particle usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="sprite">flameSprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 4, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
					<Set name="initialVelocity">-50, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="EmberLeftParticle">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" velocityRelativeToPlayerSpeed="true">
					<Set name="sprite">emberSprite</Set>
					<Set name="relativeToEmitter">false</Set>
					<Random name="offset" min="-24, -24" max="24, 8" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="1, 1" max="1.5, 1.5" />
					<Random name="finalScale" min="1.25, 1.25" max="2, 2" />
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="initialVelocity" min="-25, 0" max="-50, 0" />
				</Particle>
			</ParticleSystem>
		
			<ParticleSystem name="SpawnParticle">
				<Emitter>
					<Set name="offset">0, -500</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">respawnParticle</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 3, 3</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="SpawnParticleRabbits">
				<Emitter>
					<Set name="offset">0, -500</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">chestBackgroundSpriteCatsNoAnim</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 3, 3</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="SpawnSparkle">
				<Emitter>
					<Set name="offset">0, -900</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">24</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">emberSprite</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Random name="offset" min="-24, -16" max="24, 16" />
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="relativeToEmitter">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="1" max="1.5" />
					<Increment name="finalScale" source="initialScale" multiplier="2.5,2.5"/>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="HideParticlesOnTransform">true</Set>
				<Set name="HideParticlesOnTheaterSeat">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="punchAnimTime">1600</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="chestForegroundSprite" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" drawShadow="false"/>
			<SpriteRender name="chestForegroundSpriteGlow" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" drawShadow="false"/>
		</RenderChestItem>
		<AddClothingParticles>
			<ParticleSystemUpdate name="MistParticles" onState="Motion.Moving" />
			<ParticleSystemUpdate name="EmberLeftParticle" onState="Motion.Moving" />
		</AddClothingParticles>
		<OnRespawned>
			<ParticleSystemUpdate name="SpawnParticle" />
			<ParticleSystemUpdate name="SpawnParticleRabbits" />
			<ParticleSystemUpdate name="SpawnSparkle" />
		</OnRespawned>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="SpawnParticle" />
			<ParticleSystemOff name="SpawnParticleRabbits" />
			<ParticleSystemOff name="SpawnSparkle" />
		</SwitchOffClothingParticles>
		<RenderInFront value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ContextUpdate type="SetFlip">
				<Set name="flip">0,0</Set>
			</ContextUpdate>
			<Group onState="IsDying.False">
				<SpriteRender name="chestBackgroundSpriteCats" offset="0,6" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" drawShadow="false"/>
			</Group>
		</RenderInFront>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Group onState="IsDying.False">
				<ArithmethicOperation LeftHandVariableName="punchAnimTime" RightHandVariableName="1600" OperationType="Set" onState="IsPunching.False" />
				<ArithmethicOperation LeftHandVariableName="punchAnimTime" RightHandVariableName="800" OperationType="Set" onState="IsPunching.True" />
				<SpriteRender name="chestBackgroundSprite" offset="0,6" drawShadow="false" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
			</Group>
		</RenderBehind>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Orb" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="6,11"/>
		<Sprite name="s_orbGodRays" fileName="game/particles_large13.rttex" textureSize="64" frame="12,13" />
		<Sprite name="s_godRays" fileName="game/particles_large17.rttex" textureSize="64" frame="10,3" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="15,22" />
		<Sprite name="s_punchFrag" fileName="game/particles12.rttex" textureSize="32" frame="17,22" />
		<Animations>
			<SpriteAnimation name="a_godRays" sprite="s_godRays">
				<Frame>10,3</Frame>
				<Frame>11,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punch" sprite="s_punch">
				<Frame>13,22</Frame>
				<Frame>14,22</Frame>
				<Frame>15,22</Frame>
				<Frame>16,22</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punchFrag" sprite="s_punchFrag">
				<Frame>17,22</Frame>
				<Frame>18,22</Frame>
				<Frame>19,22</Frame>
				<Frame>20,22</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_orbGodRays" sprite="s_orbGodRays" animTime="400" autoPlay="true" isLoop="true">
				<Frame>12,13</Frame>
				<Frame>13,13</Frame>
				<Frame>14,13</Frame>
				<Frame>15,13</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_godrays" updateStage="AddClothingParticles" renderStage="RenderBehind">
				<Emitter>
					<Set name="offset">0, -28</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">1.5</Set>
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle particleIndexSpriteFrame="true">
					<Set name="sprite">s_godRays</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="lifeTime">2</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchFrag">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">4</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punchFrag</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,50"/>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 200</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Punch1">
				<Emitter>
					<Set name="offset">25, -25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">true</Set>

					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<OnFinish>
						<ParticleSystemName>ps_punchFrag</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Punch2">
				<Emitter>
					<Set name="offset">-25, -25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">true</Set>

					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<OnFinish>
						<ParticleSystemName>ps_punchFrag</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_orbGodRays1" updateStage="RenderHandItem">
				<Emitter attachment="handspotRoot">
					<Set name="offset">0, 7.5</Set>
					<Set name="lifeTime">15</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" usePlayerFacing="true">
					<Set name="sprite">s_orbGodRays</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.2, 0.2</KeyFrame>
						<KeyFrame>0.5, 0.35, 0.35</KeyFrame>
						<KeyFrame>1, 0.35, 0.35</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialAngle" min="0" max="360"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_orbGodRays2" updateStage="RenderBackHandItem">
				<Emitter attachment="handspotRoot">
					<Set name="offset">-4,4</Set>
					<Set name="lifeTime">15</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" usePlayerFacing="true">
					<Set name="sprite">s_orbGodRays</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.2, 0.2</KeyFrame>
						<KeyFrame>0.5, 0.35, 0.35</KeyFrame>
						<KeyFrame>1, 0.35, 0.35</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialAngle" min="0" max="360"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="Off"/>
					<State name="PunchA" ExitTime="0.25" />
					<State name="PunchB" ExitTime="0.25"/>
				</States>
				<Transitions>
					<Transition to="PunchA" from="Off|PunchB" >
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition to="Off" from="PunchB|PunchA" >
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="PunchB" from="PunchA" />
					
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="ShouldHover">true></Set>
				<Set name="RenderFrontArmInTheFront">false</Set>
				<Set name="RenderBackArmInTheFront">false</Set>
				<Set name="DisableWalkAnimation">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<ParticleSystemRender name="ps_orbGodRays1"/>
			<SpriteRender name="s_Orb" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderHandItem>
		<RenderBackHandItem>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<ParticleSystemRender name="ps_orbGodRays2"/>
			<SpriteRender name="s_Orb" offset="-4,-4" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackHandItem>
		<RenderFrontArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderFrontArm>
		<RenderBackArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">-200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderBackArm>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="s_punch" offset="-25, -25" blend="PREMULTIPLIED_ALPHA" onState="Punch.PunchA|Punch.Off"/>
			<SpriteRender name="s_punch" offset="25, -25" blend="PREMULTIPLIED_ALPHA" onState="Punch.PunchB|Punch.Off"/>
		</RenderBehind>
		<Update>
			<ParticleSystemUpdate name="ps_Punch1" onState="Punch.PunchA"/>
			<ParticleSystemUpdate name="ps_Punch2" onState="Punch.PunchB"/>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group onState="Action.None">
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">45</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">-45</Set>
				</AvatarTransform>
			</Group>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_AUGMENTED_WINGS">
  <Data>
    <Sprite name="s_WingFront" fileName="game/particles_large14.rttex" textureSize="64" frame="0,13"/>
    <Sprite name="s_WingFrontGlow" fileName="game/particles_large14.rttex" textureSize="64" frame="1,13"/>
    <Sprite name="s_WingBack" fileName="game/particles_large14.rttex" textureSize="64" frame="0,14"/>
    <Sprite name="s_WingBackGlow" fileName="game/particles_large14.rttex" textureSize="64" frame="1,14"/>

    <StateMachines>
      <StateMachine name="Movement">
        <States>
          <State name="Idle"/>
          <State name="Walk"/>
          <State name="Jump"/>
          <State name="Fall"/>
          <State name="FallToGround"/>
          <State name="GroundToFall"/>
        </States>
        <Transitions>
          <Transition from="Idle|Jump" to="Walk">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Walk|Jump" to="Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Walk|Idle|Fall|FallToGround" to="Jump">
            <Condition type="and">
              <IsAction>JUMP</IsAction>
            </Condition>
          </Transition>
          <Transition from="Jump|FallToGround" to="Fall">
            <Condition type="and">
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Walk|Idle" to="GroundToFall">
            <Condition type="and">
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="GroundToFall" to="Fall">
            <Condition type="and">
              <IsAction>FALL</IsAction>
              <IsAnimationFinished>a_BackGroundToFall</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="Fall" to="FallToGround">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="FallToGround" to="Walk">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsAnimationFinished>a_BackFallToGround</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="FallToGround" to="Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsAnimationFinished>a_BackFallToGround</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="GroundToFall" to="FallToGround">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsAnimationFinished>a_BackGroundToFall</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_FrontWalk" sprite="s_WingFront" animTime="500" isLoop="true" playOnState="Movement.Walk">
        <Frame>2,13</Frame>
        <Frame>3,13</Frame>
        <Frame>4,13</Frame>
        <Frame>5,13</Frame>
        <Frame>6,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_BackFall" sprite="s_WingBack" animTime="100" isLoop="true" playOnState="Movement.Fall">
        <Frame>10,13</Frame>
      </SpriteAnimation>     
      <SequenceAnimation name="a_BackJump" playOnState="Movement.Jump">
        <SpriteAnimation name="a_BackJump1" sprite="s_WingBack" animTime="200">
          <Frame>7,13</Frame>
          <Frame>8,13</Frame>
          <Frame>7,13</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_BackJump2" sprite="s_WingBack" animTime="200">
          <Frame>7,13</Frame>
          <Frame>8,13</Frame>
          <Frame>9,13</Frame>
          <Frame>10,13</Frame>
        </SpriteAnimation>
      </SequenceAnimation>
      <SpriteAnimation name="a_BackFallToGround" sprite="s_WingBack" animTime="150" playOnState="Movement.FallToGround">
        <Frame>9,13</Frame>
        <Frame>8,13</Frame>
        <Frame>7,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_BackGroundToFall" sprite="s_WingBack" animTime="150" playOnState="Movement.GroundToFall">
        <Frame>7,13</Frame>
        <Frame>8,13</Frame>
        <Frame>9,13</Frame>
        <Frame>10,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_BackWalk" sprite="s_WingBack" animTime="500" isLoop="true" playOnState="Movement.Walk">
        <Frame>6,14</Frame>
        <Frame>2,14</Frame>
        <Frame>3,14</Frame>
        <Frame>4,14</Frame>
        <Frame>5,14</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_wingBackGlow" isLoop="true" playOnState="Movement.Idle" sprite="s_WingBackGlow" animTime="5000">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>0.2f, 0.f </KeyFrame>
          <KeyFrame>0.8f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_wingFrontGlow" isLoop="true" playOnState="Movement.Idle" sprite="s_WingFrontGlow" animTime="5000">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>0.2f, 0.f </KeyFrame>
          <KeyFrame>0.8f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    
      <SpriteAnimation name="a_backIdle" sprite="s_WingBack" animTime="100" playOnState="Movement.Idle">
        <Frame>0,14</Frame>
      </SpriteAnimation>
  
      <SpriteAnimation name="a_frontIdle" sprite="s_WingFront" animTime="100" playOnState="Movement.Idle">
        <Frame>0,13</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="EnableBobbingOffset">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <Update>
      <StopIf  type="or">
        <IsZombified>true</IsZombified>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <AvatarTransform class="FootPosition" onState="Movement.Walk|Movement.Idle">
        <Set name="foot1dy">0</Set>
        <Set name="foot2dy">0</Set>
        <Set name="foot1y">0</Set>
        <Set name="foot2y">0</Set>
      </AvatarTransform>
    </Update>
    
    <RenderBackpack>
      <StopIf>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_WingBack" offset="23,-17" blend="PREMULTIPLIED_ALPHA" onState="Movement.Walk|Movement.Idle"/>

      <SpriteRender name="s_WingBack" offset="0,-17" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"  onState="Movement.Jump|Movement.Fall|Movement.GroundToFall"/>
      <SpriteRender name="s_WingBack" offset="0,-17" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"  onState="Movement.Jump|Movement.Fall|Movement.FallToGround|Movement.GroundToFall"/>
    
      <SpriteRender name="s_WingBackGlow" offset="23,-17" blend="PREMULTIPLIED_ALPHA" drawShadow="false" onState="Movement.Idle"/>
    </RenderBackpack>
    <RenderInFront>
      <StopIf>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_WingFront" offset="-21,-16" blend="PREMULTIPLIED_ALPHA"  onState="Movement.Walk|Movement.Idle"/>
      <SpriteRender name="s_WingFrontGlow" offset="-21,-16" blend="PREMULTIPLIED_ALPHA" drawShadow="false"  onState="Movement.Idle"/>
      <SpriteRender name="s_WingBack" offset="0,-17" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" onState="Movement.FallToGround"/>
      <StopIf>
        <IsZombified>false</IsZombified>
      </StopIf>
      <SpriteRender name="s_WingFront" offset="-21,-16" blend="PREMULTIPLIED_ALPHA"  onState="Movement.Walk|Movement.Idle" tintOverride="111,217,45,255"/>
      <SpriteRender name="s_WingFrontGlow" offset="-21,-16" blend="PREMULTIPLIED_ALPHA"  onState="Movement.Idle" drawShadow="false" tintOverride="111,217,45,255"/>
      <SpriteRender name="s_WingBack" offset="0,-17" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" onState="Movement.FallToGround" tintOverride="111,217,45,255"/>
    </RenderInFront>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Cloth" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="24,16" />
		<Sprite name="s_GodRays" fileName="game/particles_large13.rttex" textureSize="64" frame="14,2" />
		<Sprite name="s_HealthCross" fileName="game/particles11.rttex" textureSize="32" frame="19,20" />
		<Sprite name="s_Pants" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="25,16" />
		<Animations>
			<SpriteAnimation name="a_GodRays" sprite="s_GodRays" animTime="200">
				<Frame>14,2</Frame>
				<Frame>15,2</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="ShouldHover">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_GodRays" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -18</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_GodRays</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>0.5, 1.75, 1.75</KeyFrame>
						<KeyFrame>1, 1.75, 1.75</KeyFrame>
					</Curve>
					<Set name="lifeTime">3</Set>
					<Set name="initialVelocity">0, 0</Set>
					<Random name="initialAngle" min="-75" max="75" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_HealthCross1" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">22, -18</Set>
					<Set name="offsetFacing">false</Set>
					<Random name="emissionInterval" min="0.3" max="0.6" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">s_HealthCross</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-4, -4" max="4, 4.01" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.75" max="1.25" />
					<Random name="lifeTime" min="0.8" max="1.5" />
					<Set name="initialVelocity">0, -30</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_HealthCross2" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">-22, -18</Set>
					<Set name="offsetFacing">false</Set>
					<Random name="emissionInterval" min="0.3" max="0.6" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">s_HealthCross</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-4, -4" max="4, 4.01" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.75" max="1.25" />
					<Random name="lifeTime" min="0.8" max="1.5" />
					<Set name="initialVelocity">0, -30</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_HealthCross3" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -36</Set>
					<Set name="offsetFacing">false</Set>
					<Random name="emissionInterval" min="0.3" max="0.6" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">s_HealthCross</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-4, -4" max="4, 4.01" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.75" max="1.25" />
					<Random name="lifeTime" min="0.8" max="1.5" />
					<Set name="initialVelocity">0, -30</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">45</Set>
			</AvatarTransform>
			<StopIf>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<ContextUpdate type="SetTintFromSlot">
				<Set name="slot">SHOES</Set>
			</ContextUpdate>
			<ContextUpdate type="SetTintFromSlot">
				<Set name="slot">PANTS</Set>
			</ContextUpdate>
			<SpriteRender name="s_Pants" offset="0.5,2" alignment="DOWN_CENTER" />
			<ContextUpdate type="SetTintFromSlot">
				<Set name="slot">SHOES</Set>
				<Set name="seedFG">true</Set>
			</ContextUpdate>
			<ContextUpdate type="SetTintFromSlot">
				<Set name="slot">PANTS</Set>
				<Set name="seedFG">true</Set>
			</ContextUpdate>
			<SpriteRender name="s_Cloth" offset="0.5,2" alignment="DOWN_CENTER" />
		</RenderShoes>
		<RenderBehind>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
			<ParticleSystemRender name="ps_GodRays" />
			<ParticleSystemRender name="ps_HealthCross1" />
			<ParticleSystemRender name="ps_HealthCross2" />
			<ParticleSystemRender name="ps_HealthCross3" />
		</RenderBehind>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_equip" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="3,23"/>
    <Sprite name="s_sparkle" fileName="game/particles11.rttex" textureSize="32" frame="12,29"/>

    <Animations>
      <SpriteAnimation name="a_equip" autoPlay="true" sprite="s_equip" isLoop="true" animTime="1200">
        <Frame>3,23</Frame>
        <Frame>4,23</Frame>
        <Frame>5,23</Frame>
        <Frame>6,23</Frame>
        <Frame>7,23</Frame>
        <Frame>8,23</Frame>
        <Frame>9,23</Frame>
        <Frame>10,23</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_sparkle" sprite="s_sparkle" animTime="300" autoPlay="true" isLoop="true">
        <Frame>12,29</Frame>
        <Frame>13,29</Frame>
        <Frame>14,29</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <ParticleSystems>
      <ParticleSystem name="ps_Sparkles">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Random name="emissionInterval" min="0.4" max="0.8" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_sparkle</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-10, -8" max="10, -2" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.8</KeyFrame>
            <KeyFrame>0.8, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Select name="lifeTime" input="randomNumber">
            <Item>0.3</Item>
            <Item>0.6</Item>
          </Select>
          <Random name="initialScale" min="0.5" max="0.8" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_SparklesTrail">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Random name="emissionInterval" min="0.1" max="0.3" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_sparkle</Set>
          <Random name="offset" min="-18, -8" max="0, 0" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.8</KeyFrame>
            <KeyFrame>0.8, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>

          <Select name="lifeTime" input="randomNumber">
            <Item>0.3</Item>
            <Item>0.6</Item>
          </Select>
          <Random name="initialScale" min="0.5" max="0.8" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

  </Data>

  <RenderRules>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_Sparkles" />
      <ParticleSystemUpdate name="ps_SparklesTrail" onState="Motion.Move"/>
    </AddClothingParticles>
    <RenderShirt>
      <SpriteRender name="s_equip" alignment="DOWN_CENTER"/>
      <ParticleSystemRender name="ps_Sparkles" />
      <ParticleSystemRender name="ps_SparklesTrail"/>
    </RenderShirt>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Car" fileName="game/aventador.rttex" textureSize="128"/>
		<Sprite name="s_Lightbeam" fileName="game/ugc_particles1.rttex" textureSize="64" frame="1,7"/>

		<Animations>
			<SpriteAnimation name="a_Move" sprite="s_Car" animTime="200" isLoop="true" playOnAction="WALK">
				<Frame>10,1</Frame>
				<Frame>11,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Idle" sprite="s_Car" animTime="200" isLoop="true" playOnAction="IDLE">
				<Frame>10,1</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-5</Set>
				<Set name="IsCar">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">false</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="IsRidingBird">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderShoes>
			<SpriteRender name="s_Car" offset="8,8" alignment="DOWN_CENTER"/>
		</RenderShoes>
        <RenderInFront>
            <SpriteRender name="s_Lightbeam" offset="49,8" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
            <SpriteRender name="s_Lightbeam" offset="67,8" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
        </RenderInFront>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_AXED_TREE">
	<Data>
		<Sprite name="s_HandItem" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="31,20" />
		<Sprite name="s_PunchParticle" fileName="game/particles_large13.rttex" textureSize="64" frame="15,11" />
		<Sprite name="s_Sparkles" fileName="game/particles11.rttex" textureSize="32" frame="12,25" />
		<Sprite name="s_Tree" fileName="game/particles_large13.rttex" textureSize="64" frame="8,11" />
		<Sprite name="s_SparkleTrail" fileName="game/particles11.rttex" textureSize="32" frame="9,11" />
		<Sprite name="s_HitStampParticle" fileName="game/particles11.rttex" textureSize="32" frame="7,25" />
		<Animations>
			<SpriteAnimation name="a_Sparkles" sprite="s_Sparkles" animTime="300" autoPlay="true" isLoop="true">
				<Frame>12,25</Frame>
				<Frame>13,25</Frame>
				<Frame>14,25</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_SparkleTrail" sprite="s_SparkleTrail">
				<Frame>12,25</Frame>
				<Frame>13,25</Frame>
				<Frame>14,25</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Tree" sprite="s_Tree" animTime="1400" autoPlay="true" isLoop="true">
				<Frame>8,11</Frame>
				<Frame>9,11</Frame>
				<Frame>10,11</Frame>
				<Frame>11,11</Frame>
				<Frame>12,11</Frame>
				<Frame>13,11</Frame>
				<Frame>14,11</Frame>
			</SpriteAnimation>
      <SpriteCurveAnimation name="a_treeAlpha" sprite="s_Tree" autoPlay="true">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.5f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>
		<RenderOptions>
			<Default>
				<Set name="ShouldHover">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="UserNameOffset">28</Set>
			</Default>
		</RenderOptions>
    <TileStampData>
      <Set name="FileName">game/particles11.rttex</Set>
      <Set name="EndFrame">11,25</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>
		<ParticleSystems>
			<ParticleSystem name="ps_Punch" secondary="trail_particle">
				<Emitter>
          <Random name="offset" min="0, -32" max="-50, -48" />
					<Set name="offsetFacing">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_PunchParticle</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
          <Select name="initialAngle" input="punchCount">
            <Item>45</Item>
            <Item>0</Item>
            <Item>-45</Item>
          </Select>
          <Select name="finalAngle" input="punchCount">
            <Item>-45</Item>
            <Item>0</Item>
            <Item>45</Item>
          </Select>
          <Select name="finalAlpha" input="punchCount">
            <Item>1.4f</Item>
            <Item>1.f</Item>
            <Item>1.4f</Item>
          </Select>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="lifeTime">0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="finalAlpha" angle="initialAngle" />
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="finalAlpha" angle="finalAngle" />
				</Particle>
			</ParticleSystem>
      <ParticleSystem name="trail_particle">
        <Emitter>
          <Set name="lifeTime">0.4</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">15</Set>
          <Set name="emissionInterval">0.035</Set>
          <Set name="checkParticleNumToEmit">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_SparkleTrail</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5" max="1" />
          <Set name="lifeTime">0.3</Set>
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_TreeSparkles" updateStage="AddClothingParticles" renderStage="RenderBehind">
				<Emitter>
					<Set name="offset">-26, -40</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="emissionInterval">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Sparkles</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-32, -18" max="32, 16" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.85</Set>
				</Particle>
			</ParticleSystem>
      <ParticleSystem name="hit_particle_spark">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_SparkleTrail</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="80,200" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="destroy_particle_spark">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_SparkleTrail</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="80,200" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="hit_stamp_particle">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_HitStampParticle</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 1.3,1.3</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">180</Set>
			</AvatarTransform>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderHandItem>
			<SpriteRender name="s_HandItem" offset="8,-2" rotateOffset="true" rotationPoint="0,1" />
		</RenderHandItem>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="s_Tree" offset="-26,-26" drawShadow="false" />
		</RenderBehind>
		<OnPunchStart>
			<ParticleSystemUpdate name="ps_Punch" />
		</OnPunchStart>
    <OnDamagedTile>
      <ParticleSystemUpdate name="hit_particle_spark" />
      <ParticleSystemUpdate name="hit_stamp_particle" />
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="destroy_particle_spark" />
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="item_Sprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="24,28"/>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>

				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
