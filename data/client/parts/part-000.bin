		<Sprite name="animalKingvow" fileName="game/UGCSpritesheet99v3.rttex" textureSize="273"/>
		<Sprite name="vowApalagiya" fileName="game/UGCSpritesheet99v3.rttex" textureSize="273"/>
		<Animations>
			<SpriteAnimation name="a_pet_before" sprite="animalKingvow" autoPlay="true" animTime="1500" playerState="ScytheAnimation.Before">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_after" sprite="animalKingvow" animTime="1000" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_punch" sprite="animalKingvow" animTime="900" isLoop="true" playOnState="Pet.Punch">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="vowflakes">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_punch" sprite="vowBar" animTime="400" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_projectile" sprite="vowIniitu" animTime="100" isLoop="true">
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_destroy_impact" sprite="vowituIni" animTime="400" isLoop="false">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>7,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_fireball" sprite="duar" animTime="400" isLoop="true">
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_tornado" sprite="vowApalagiya" animTime="800" isLoop="true">
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				<Frame>4,6</Frame>
				<Frame>5,6</Frame>
				<Frame>6,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_before" sprite="vowSWORDDD" animTime="1500" autoPlay="true" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="vowSWORDDD" animTime="1500" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hit_fire" sprite="vowtile" animTime="400" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
				<Frame>9,2</Frame>
				<Frame>10,2</Frame>
				<Frame>11,2</Frame>
				<Frame>12,2</Frame>
				<Frame>13,2</Frame>
			</SpriteAnimation>
            <InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-95, 0, 0, 1" animTime="1000" playOnState="Punch.False"/>
		</Animations>
        <!-- <TileStampData>
            <Set name="FileName">game/UGCSpritesheet99v0.rttex</Set>
            <Set name="EndFrame">3,1</Set>
            <Set name="FrameCount">4</Set>
        </TileStampData> -->
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
    <StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ScytheAnimation">
				<States>
					<State name="Before" />
					<State name="Idle" />
				</States>
				<Transitions>
					<Transition from="Before" to="Idle">
						<Condition>
							<IsAnimationFinished>a_hell_before</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vowIniitu</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,5,5</KeyFrame>
            <KeyFrame>1,5,5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vowituIni</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-400</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">duar</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vowApalagiya</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0,5,5</KeyFrame>
            <KeyFrame>1,8,8</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
        <Emitter>
          <Random name="offset" min="-20, -30" max="20, -70" />
          <Random name="emissionInterval" min="0.28" max="0.56" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vowmes</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.8" max="1.4" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">16,-48</Set>
          <Set name="lifeTime">3.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vowtile</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">3.1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 8,8</KeyFrame>
            <KeyFrame>0.5, 15,15</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">-16,-48</Set>
          <Set name="lifeTime">3.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vowtile</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">3.1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 8,8</KeyFrame>
            <KeyFrame>0.5, 15,15</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">vowmes</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
			<KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vowflakes</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="ScytheAnimation.Idle">
				<Emitter>
          <Random name="offset" min="-300, -150" max="110, 30" />
					<Random name="emissionInterval" min="0.010" max="0.02" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">vowflakes</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    				<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.7" max="1.8" />
					<Set name="lifeTime">1.5</Set>
					<Random name="initialVelocity" min="-20, 40" max="30, 60" />
					<Random name="initialAngle" min="0" max="-360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
	<RenderOptions>
		<Default>
			<!-- <Set name="ShouldHover">true</Set> -->
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">false</Set>
			<Set name="IncludeAllActions">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>
			<Set name="RenderBackArmBuild">false</Set>
			<Set name="RenderFrontArmInfected">true</Set>
			<Set name="RenderBackArmInfected">true</Set>
			<Set name="UserNameOffset">15</Set>
			<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
		</Default>
	</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-160</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Jump">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-210</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Fall">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-135</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="vowBar" offset="10,-10" alignment="CENTER" rotateOffset="true" rotateToTarget="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="2,2" onAction="PUNCH" />

		</RenderInFront>
		<RenderBehind>
			<SpriteRender name="animalKingvow" offset="0,-280" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="3,3" onState="ScytheAnimation.Before|ScytheAnimation.Idle" />
		</RenderBehind>		
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
            <Group onState="ScytheAnimation.Before">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="vowSWORDDD" offset="-5,210" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="2.6,2.6" />
            </Group>
			<Group onState="ScytheAnimation.Idle">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="vowSWORDDD" offset="-5,210" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="2.6,2.6" />
			</Group>
		</RenderBackHandItem>

		
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Crown" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="1,10" />
		<Sprite name="s_CrystalSpike" fileName="game/particles_large17.rttex" textureSize="64" frame="0,15" />
		<Sprite name="s_Punch" fileName="game/particles_large17.rttex" textureSize="64" frame="9,15"/>
		<Sprite name="s_Flash" fileName="game/particles_large17.rttex" textureSize="64" frame="10,15"/>
		<Sprite name="s_Shard" fileName="game/particles8.rttex" textureSize="32" frame="8,1" />
		<Animations>
			<SequenceAnimation name="a_Crown" autoPlay="true" isLoop="true">
				<SpriteAnimation sprite="s_Crown" animTime="1000">
					<Frame>1,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>2,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="200">
					<Frame>1,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>3,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>4,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="100">
					<Frame>1,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>5,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="200">
					<Frame>1,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>6,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>7,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>5,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="200">
					<Frame>1,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>2,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="100">
					<Frame>1,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>3,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="100">
					<Frame>1,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>2,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>1,10</Frame>
				</SpriteAnimation>
				<SpriteAnimation sprite="s_Crown" animTime="50">
					<Frame>6,10</Frame>
				</SpriteAnimation>
			</SequenceAnimation>
			<SpriteAnimation name="a_CrystalSpike" sprite="s_CrystalSpike" animTime="600" playOnState="HideBody.Yes" isLoop="true">
				<Frame>0,15</Frame>
				<Frame>1,15</Frame>
				<Frame>2,15</Frame>
				<Frame>3,15</Frame>
				<Frame>4,15</Frame>
				<Frame>5,15</Frame>
				<Frame>6,15</Frame>
				<Frame>7,15</Frame>
				<Frame>8,15</Frame>
				<Frame>9,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Shard" sprite="s_Shard" animTime="300">
				<Frame>8,1</Frame>
				<Frame>10,1</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="HideBody">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition type="or">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_Flash" updateStage="OnPunchBegin">
				<Emitter>
					<Set name="offset">0, -28</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Flash</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.2, 0.2</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" upSpeed="-600"/>
					<Set name="gravityVector">0, 2400</Set>
					<Random name="initialRotationRate" min="400" max="800"/>
					<Set name="initialScale">0.5,0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Shard">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">10</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Shard</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Random name="initialRotationRate" min="400" max="800"/>
					<Set name="initialScale">0.5,0.5</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,150"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="UserNameOffset">6</Set>
				<Set name="TransformOnPunch">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderHat>
			<SpriteRender name="s_Crown" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="DOWN_CENTER" offset="0,-16" />
		</RenderHat>
		<RenderTransform>
			<Group>
				<Scale>0.8,0.8,1</Scale>
				<SpriteRender name="s_CrystalSpike" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="CENTER" onState="HideBody.Yes"/>
			</Group>
		</RenderTransform>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_Shard"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_Shard"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_ULTRAVIOLET_WINGS">
	<Data>
		<Sprite name="ColorWingSprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="4,16" />
		<Sprite name="ShardsSprite" fileName="game/particles11.rttex" textureSize="32" frame="8,21" />
		<Sprite name="SmokeSprite" fileName="game/particles11.rttex" textureSize="32" frame="10,21" />
		<Sprite name="TrailSprite" fileName="game/particles11.rttex" textureSize="32" frame="18,21" />
		<Sprite name="WingSprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="7,16" />
		<StateMachines>
			<StateMachine name="FallState">
				<States>
					<State name="Fall" />
					<State name="NotFall" />
				</States>
				<Transitions>
					<Transition from="Fall" to="NotFall">
						<Condition>
							<IsVariableFloat name="speed.y" operator="LessOrEqual">0</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="NotFall" to="Fall">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="IdleState">
				<States>
					<State name="Idle" />
					<State name="NotIdle" />
				</States>
				<Transitions>
					<Transition from="Idle" to="NotIdle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="NotIdle" to="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteCurveAnimation name="randomPosAnim" sprite="ColorWingSprite" autoPlay="true" isLoop="true" animTime="1000">
				<Curve name="pos">
					<KeyFrame>0.f, 1.5f, 1.5f</KeyFrame>
					<KeyFrame>0.2f, 1.5f, 1.5f</KeyFrame>
					<KeyFrame>0.2f, -1.5f, -1.5f</KeyFrame>
					<KeyFrame>0.4f, -1.5f, -1.5f</KeyFrame>
					<KeyFrame>0.4f, 1.5f, -1.5f</KeyFrame>
					<KeyFrame>0.6f, 1.5f, -1.5f</KeyFrame>
					<KeyFrame>0.6f, -1.5f, 1.5f</KeyFrame>
					<KeyFrame>0.8f, -1.5f, 1.5f</KeyFrame>
					<KeyFrame>0.8f, 1.5f, -1.5f</KeyFrame>
					<KeyFrame>1.0f, 1.5f, -1.5f</KeyFrame>
					<KeyFrame>1.0f, 1.5f, 1.5f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SequenceAnimation name="glitch_sequence" autoPlay="true" isLoop="true">
