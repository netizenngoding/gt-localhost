  <RenderRules>

    <RenderBackpack>
      <SpriteRender name="UCJUESTUDIO_1" offset="0,-48" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" scale="1.5,1.5"/>
      <SpriteRender name="UCJUESTUDIO_1" offset="0,-48" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" scale="1.5,1.5"/>
    </RenderBackpack>

    <RenderInFront>
      <ParticleSystemRender name="UCJUESTUDIO_16"/>
      <ParticleSystemRender name="UCJUESTUDIO_17"/>
    </RenderInFront>

    <AddClothingParticles>
      <ParticleSystemUpdate name="UCJUESTUDIO_16"      onAction="WALK|IDLE|JUMP|JUMPDOUBLE|FALL" drawShadow="false"/>
      <ParticleSystemUpdate name="UCJUESTUDIO_17"     onAction="WALK|IDLE|JUMP|JUMPDOUBLE|FALL" drawShadow="false"/>
      <ParticleSystemUpdate name="UCJUESTUDIO_18" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER"/>
      <ParticleSystemUpdate name="UCJUESTUDIO_19"   onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER"/>
      <ParticleSystemUpdate name="UCJUESTUDIO_20"  onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER"/>
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <ParticleSystemOff name="UCJUESTUDIO_16"/>
