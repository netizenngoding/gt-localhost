<ItemRenderer NPCType="CrystalTurret">
	<Data>
		<Sprite name="s_sprite" fileName="game/tiles_page17.rttex" textureSize="32" frame="8,9"/>
		<StateMachines>
			<StateMachine name="NPC" ServerOnly="true">
				<States start="Stationary">
					<NPCStationary name="Stationary"/>
					<NPCPlatformAttack name="AttackProjectile" ExitTime="1">
						<AttackSpeed>0</AttackSpeed>
						<ProjectileName>"CrystalTurretProjectile"</ProjectileName>
						<MinRangeToAttack>0</MinRangeToAttack>
					</NPCPlatformAttack>
					<NPCAnticipation name="Anticipation" ExitTime="0.5"/>
				</States>
				<Transitions>							
					<Transition to="Stationary" from="AttackProjectile">
						<Condition>
							<IsPlayerDistanceMatching operatorType="Greater">192</IsPlayerDistanceMatching>
						</Condition>
					</Transition>					
					<Transition to="Anticipation" from="AttackProjectile|Stationary">
						<Condition>
							<IsPlayerDistanceMatching operatorType="LessOrEqual">192</IsPlayerDistanceMatching>
						</Condition>
					</Transition>				
					<Transition to="AttackProjectile" from="Anticipation"/>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="a_sprite_static" animTime="100" sprite="s_sprite"  isLoop="true" autoPlay="false" playOnState="NPC.Stationary">
				<Frame>8, 9</Frame>
			</SpriteAnimation>						
			<SpriteAnimation name="a_sprite_ANTICIPATION" animTime="500" sprite="s_sprite"  isLoop="false" autoPlay="false" playOnState="NPC.Anticipation">
				<Frame>8, 9</Frame>
				<Frame>9, 9</Frame>
				<Frame>10, 9</Frame>
				<Frame>11, 9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sprite_ATTACK" animTime="200" sprite="s_sprite"  isLoop="false" autoPlay="false" playOnState="NPC.AttackProjectile">
				<Frame>12, 9</Frame>
				<Frame>8, 9</Frame>
			</SpriteAnimation>
		</Animations>
		<Components>
			<Info/>
			<Enemy>
				<Set name="SoulsReward">0</Set>
				<Set name="destroyTileId">0</Set>
			</Enemy>
			<Movement/>
			<Damage>
				<Set name="damage">0</Set>
			</Damage>
			<StateMachine/>
			<NPCRenderActionCmp/>
			<CollisionBox>
				<Set name="size">32,32</Set>
				<Set name="CollisionFlag">"NO_COLLISION"</Set>
				<Set name="CollisionType">"NO_COLLISION"</Set>
			</CollisionBox>
			<DebugDraw/>
		</Components>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_sprite" blend="PREMULTIPLIED_ALPHA"/>
		</Render>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer NPCType="DiamondDestructoBoss" NPCTypeID="13">
	<Data>
		<Sprite name="iceSpikesSprite" fileName="game/npc1.rttex" textureSize="32" frame="31,8" />
		<Sprite name="slashSprite" fileName="game/npc1.rttex" textureSize="32" frame="29,8"/>
		<Sprite name="destructoSprite" fileName="game/npc2.rttex" textureSize="64" frame="0,2"/>
		<Sprite name="s_HitEffect" fileName="game/particles.rttex" textureSize="32" frame="10,9" />
		<StateMachines>
			<StateMachine name="NPC" ServerOnly="true"> 
				<States start="FlyPatrol">
					<NPCSpawn name="ShieldState" IsTemporary="true">
						<NpcTypeToSpawn>"Shield"</NpcTypeToSpawn>
						<NpcSpawnQuantity>1</NpcSpawnQuantity>
					</NPCSpawn>	
					<NPCFlyingPatrol name="FlyPatrol" ExitTime="5">
						<PatrolSpeed>80</PatrolSpeed>
						<PatrolRange>350</PatrolRange>
						<StayHome>false</StayHome>
					</NPCFlyingPatrol>
					<NPCFlyingDash name="SlamAttack" ExitTime="0.32">
						<DashVelocity>0, 400</DashVelocity>
					</NPCFlyingDash>
					<NPCStationary name="SlamAttackParticle" ExitTime="0.64"/>
					<NPCFlyingAttack name="AttackProjectile" ExitTime="1">
						<AttackTimeoutInSeconds>0</AttackTimeoutInSeconds>
						<ProjectileName>"DiamondDestructoProjectile"</ProjectileName>
					</NPCFlyingAttack>
					<NPCStationary name="SlashWave" ExitTime="1"/>
					<NPCAnticipation name="AnticipationSlam" ExitTime="0.64"/>
					<NPCAnticipation name="AnticipationSlashWave" ExitTime="0.64"/>
					<NPCAnticipation name="AnticipationProjectileAttack" ExitTime="0.64"/>
				</States>
				<Transitions>
					<Transition to="FlyPatrol" from="ShieldState|SlamAttackParticle|AttackProjectile|SlashWave"/>				
					<Transition to="AnticipationSlam" from="FlyPatrol">
						<Condition>
							<CheckRandomRangeNumber EndNumber="4">0</CheckRandomRangeNumber>
						</Condition>
					</Transition>					
					<Transition to="SlamAttack" from="AnticipationSlam"/>							
					<Transition to="SlamAttackParticle" from="SlamAttack">
						<Condition>
							<IsOnGround>true</IsOnGround>
						</Condition>
					</Transition>	
					<Transition to="AnticipationSlashWave" from="FlyPatrol">
						<Condition>
							<CheckRandomRangeNumber EndNumber="4">1</CheckRandomRangeNumber>
						</Condition>
					</Transition>
					<Transition to="SlashWave" from="AnticipationSlashWave"/>					
					<Transition to="AnticipationProjectileAttack" from="FlyPatrol">
						<Condition>
							<CheckRandomRangeNumber EndNumber="4">2</CheckRandomRangeNumber>
						</Condition>
					</Transition>
					<Transition to="AttackProjectile" from="AnticipationProjectileAttack"/>
					<Transition to="ShieldState" from="FlyPatrol">
						<Condition type="and">
							<CheckRandomRangeNumber operatorType="Less" EndNumber="101">30</CheckRandomRangeNumber>
							<CheckNumberAttachedEntities operatorType="Less">1</CheckNumberAttachedEntities>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="a_sprite_default" playOnState="NPC.FlyPatrol" sprite="destructoSprite" isLoop="true" animTime="300">
				<Frame>0, 3</Frame>
				<Frame>1, 3</Frame>
				<Frame>2, 3</Frame>
			</SpriteAnimation>				
			<SpriteAnimation name="c_sprite_AnticipationSlam" playOnState="NPC.AnticipationSlam" sprite="destructoSprite" isLoop="true" animTime="100">
				<Frame>4, 4</Frame>
			</SpriteAnimation>					
			<SpriteAnimation name="e_sprite_AnticipationSlashWave" sprite="destructoSprite" playOnState="NPC.AnticipationSlashWave" isLoop="true" animTime="100">
				<Frame>0, 4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="f_sprite_AnticipationProjectileAttack" playOnState="NPC.AnticipationProjectileAttack" sprite="destructoSprite" isLoop="false" animTime="600">
				<Frame>0, 2</Frame>
				<Frame>1, 2</Frame>
				<Frame>2, 2</Frame>
				<Frame>3, 2</Frame>
				<Frame>4, 2</Frame>
				<Frame>5, 2</Frame>
			</SpriteAnimation>
			
			<SpriteAnimation name="h_sprite_AttackProjectile_attack" playOnState="NPC.AttackProjectile" sprite="destructoSprite" isLoop="false" animTime="50">
				<Frame>4, 4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="h_sprite_SlashWave_attack" playOnState="NPC.SlashWave" sprite="destructoSprite" isLoop="true" animTime="50">
				<Frame>1, 4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="h_sprite_SlamAttack_attack" playOnState="NPC.SlamAttack" sprite="destructoSprite" isLoop="false" animTime="50">
				<Frame>3, 4</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="slash_particle">
				<Emitter>
					<Set name="offset">64,64</Set>
					<Set name="emissionInterval">2.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offsetFacing">true</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="sprite">slashSprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">2</Set>
					<Set name="collisionDamageAmount">100</Set>
					<Set name="destroyOnCollision">false</Set>
					<Set name="collisionSize">64,128</Set>
					<Set name="initialScale">2,4</Set>
					<Set name="initialVelocity">90,0</Set>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
				</Particle>
			</ParticleSystem>	
			<ParticleSystem name="ice_spikes_particle_right">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Select name="offset" input="particleIndex">
						<Item>5,48</Item>
						<Item>15,48</Item>
						<Item>45,48</Item>
						<Item>75,48</Item>
						<Item>90,48</Item>
						<Item>105,48</Item>
					</Select>
					<Set name="sprite">iceSpikesSprite</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">4</Set>
					<Set name="collisionDamageAmount">100</Set>
					<Set name="destroyOnCollision">false</Set>
					<Set name="collisionSize">32,32</Set>
					<Set name="initialScale">1.2,0.15</Set>
					<Set name="finalScale">1.2,0.35</Set>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
					<Increment name="initialScale" source="particleIndex" multiplier="0.05,0.35"/>
				</Particle>
			</ParticleSystem>	
			<ParticleSystem name="ice_spikes_particle_left">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Select name="offset" input="particleIndex">
						<Item>-5,48</Item>
						<Item>-15,48</Item>
						<Item>-45,48</Item>
						<Item>-75,48</Item>
						<Item>-90,48</Item>
						<Item>-105,48</Item>
					</Select>
					<Set name="sprite">iceSpikesSprite</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">4</Set>
					<Set name="collisionDamageAmount">100</Set>
					<Set name="destroyOnCollision">false</Set>
					<Set name="collisionSize">32,32</Set>
					<Set name="initialScale">1.2,0.15</Set>
					<Set name="finalScale">1.2,0.35</Set>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
					<Increment name="initialScale" source="particleIndex" multiplier="0.05,0.35"/>
				</Particle>
			</ParticleSystem>	
			<ParticleSystem name="ps_HitEffect" updateStage="OnDamaged">
				<Emitter>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_HitEffect</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.4, 0</KeyFrame>
						<KeyFrame>0.41, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">0.1,0.27,0.75</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,90" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<Components>
			<Info/>
			<MustKillNPC/>
			<AttachmentSlotsCmp/>
			<TintOverrideCmp/>
			<Enemy>
				<Set name="SoulsReward">0</Set>
				<Set name="destroyTileId">440</Set>
			</Enemy>
			<Movement/>
			<Damage>
				<Set name="damage">20</Set>
			</Damage>
			<IsBossNPC>
				<Set name="displayName">"Diamond Destructor"</Set>
			</IsBossNPC>
			<NPCRenderActionCmp/>
			<StateMachine/>
			<Physics>
				<Set name="acceleration">0, 0</Set>
				<Set name="mass">20</Set>
				<Set name="drag">1.25, 1.25</Set>
			</Physics>
			<Health>
				<Set name="healthAmount">20000</Set>
				<Set name="maxHealth">20000</Set>
			</Health>
			<CollisionBox>
				<Set name="size">80,96</Set>
				<Set name="CollisionFlag">"PLAYERS|PROJECTILES"</Set>
				<Set name="CollisionType">"ENEMY_NPC"</Set>
			</CollisionBox>
			<DebugDraw/>
		</Components>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="destructoSprite" scale="2,2" offset="0,-20"/>
			<Translate>0,-16,0</Translate>
			<NPCHealthBarRender TexturePath="interface/large/gui_event_npchealth_bar.rttex" TextureSize="17,9" TextureCoordinates="0,0" />
		</Render>
		<Update>
			<ParticleSystemUpdate name="slash_particle" onState="NPC.SlashWave"/>
			<ParticleSystemUpdate name="ice_spikes_particle_right" onState="NPC.SlamAttackParticle"/>
			<ParticleSystemUpdate name="ice_spikes_particle_left" onState="NPC.SlamAttackParticle"/>
		</Update>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer NPCType="DragonsBreath" NPCTypeID="11">
	<Data>
		<Sprite name="s_sprite" fileName="game/npc1.rttex" textureSize="32" frame="23,9"/>
		<Sprite name="s_HitEffect" fileName="game/npc1.rttex" textureSize="32" frame="22,8" />
		<Sprite name="s_MuzzleFlash" fileName="game/npc1.rttex" textureSize="32" frame="22,9" />
		<StateMachines>
			<StateMachine name="NPC" ServerOnly="true">
				<States start="Stationary">
					<NPCStationary name="Stationary"/>
					<NPCPlatformAttack name="AttackProjectile" ExitTime="0.5">
						<AttackSpeed>0</AttackSpeed>
						<ProjectileName>"DragonsBreathProjectile"</ProjectileName>
						<MinRangeToAttack>192</MinRangeToAttack>
					</NPCPlatformAttack>	
					<NPCAnticipation name="Anticipation" ExitTime="0.5"/>
				</States>
				<Transitions>							
					<Transition to="Stationary" from="AttackProjectile">
						<Condition>
							<IsPlayerDistanceMatching operatorType="Greater">192</IsPlayerDistanceMatching>
						</Condition>
					</Transition>					
					<Transition to="Anticipation" from="AttackProjectile|Stationary">
						<Condition>
							<IsPlayerDistanceMatching operatorType="LessOrEqual">192</IsPlayerDistanceMatching>
						</Condition>
					</Transition>				
					<Transition to="AttackProjectile" from="Anticipation"/>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="a_sprite_static" playOnState="NPC.Stationary" sprite="s_sprite" isLoop="true">
				<Frame>23, 9</Frame>
			</SpriteAnimation>					
			<SpriteAnimation name="a_sprite_anticipation" playOnState="NPC.Anticipation" sprite="s_sprite" isLoop="false">
				<Frame>24, 9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sprite_attack" playOnState="NPC.AttackProjectile" sprite="s_sprite" isLoop="true">
				<Frame>25, 9</Frame>
			</SpriteAnimation>			
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_HitEffect" updateStage="OnDamaged">
				<Emitter>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_HitEffect</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.4, 0</KeyFrame>
						<KeyFrame>0.41, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">0.8,0.8,0</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,90" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_MuzzleFlash">
				<Emitter>
					<Set name="offset">20, 2</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">s_MuzzleFlash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.15</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<Components>
			<Info/>
			<MustKillNPC/>
			<AttachmentSlotsCmp/>
			<TintOverrideCmp/>
			<Enemy>
				<Set name="SoulsReward">2</Set>
				<Set name="destroyTileId">4344</Set>
			</Enemy>
			<Movement/>
			<Damage>
				<Set name="damage">0</Set>
			</Damage>
			<StateMachine/>
			<NPCRenderActionCmp/>
			<Health>
				<Set name="healthAmount">200</Set>
				<Set name="maxHealth">200</Set>
			</Health>
			<CollisionBox>
				<Set name="size">32,32</Set>
				<Set name="CollisionFlag">"PLAYERS|PROJECTILES"</Set>
				<Set name="CollisionType">"ENEMY_NPC"</Set>
			</CollisionBox>
			<DebugDraw/>
		</Components>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_sprite"/>
		</Render>
		<Update>
			<ParticleSystemUpdate name="ps_MuzzleFlash" onState="NPC.AttackProjectile" />
		</Update>
		<RenderInFront>
			<Translate>0,-4,0</Translate>
			<NPCHealthBarRender TexturePath="interface/large/gui_event_npchealth_bar.rttex" TextureSize="17,9" TextureCoordinates="0,0"/>
		</RenderInFront>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer NPCType="DreadGazerBoss" NPCTypeID="9">
	<Data>
		<Sprite name="s_Muzzle" fileName="game/particles11.rttex" textureSize="32" frame="11,24" />
		<Sprite name="laserBeamSprite" fileName="game/particles11.rttex" textureSize="32" frame="12,24" cullingDisabled="true"/>
		<Sprite name="teleportParticleSprite" fileName="game/bb_page1.rttex" textureSize="128" frame="6,5"/>
		<Sprite name="teleportMuzzleParticleSprite" fileName="game/bb_page1.rttex" textureSize="128" frame="5,5"/>
		<Sprite name="gazerSprite" fileName="game/bb_page1.rttex" textureSize="128" frame="0,3"/>
		<Sprite name="s_HitEffect" fileName="game/particles.rttex" textureSize="32" frame="10,9" />
		<StateMachines>
			<StateMachine name="NPC" ServerOnly="true">
				<States start="FlyPatrol">
					<NPCSpawn name="ShieldState" IsTemporary="true">
						<NpcTypeToSpawn>"Shield"</NpcTypeToSpawn>
						<NpcSpawnQuantity>1</NpcSpawnQuantity>
					</NPCSpawn>			
					<NPCFlyingPatrol name="FlyPatrol" ExitTime="2">
						<PatrolSpeed>80</PatrolSpeed>
						<PatrolRange>350</PatrolRange>
						<StayHome>false</StayHome>
					</NPCFlyingPatrol>
					<NPCStationary name="TeleportAttackParticle"  ExitTime="0.2"/>
					<NPCTeleport name="Teleport" ExitTime="0.64">
						<MinTeleportDistance>-1020, -350</MinTeleportDistance>
						<MaxTeleportDistance>1020, 350</MaxTeleportDistance>
						<PlayerTargetingChance>35</PlayerTargetingChance>
					</NPCTeleport>
					<NPCStationary name="TeleportEnd"/>
					<NPCFlyingAttack name="AttackProjectile" ExitTime="1">
						<AttackTimeoutInSeconds>0</AttackTimeoutInSeconds>
						<ProjectileName>"DreadGazerProjectile"</ProjectileName>
					</NPCFlyingAttack>
					<NPCStationary name="AttackLaserBeam" ExitTime="4"/>
					<NPCAnticipation name="AnticipationTeleport" ExitTime="0.64"/>
					<NPCAnticipation name="AnticipationLaserBeam" ExitTime="0.64"/>
					<NPCAnticipation name="AnticipationFireBall" ExitTime="0.64"/>
				</States>
				<Transitions>
					<Transition to="FlyPatrol" from="ShieldState|TeleportEnd|AttackLaserBeam|AttackProjectile"/>				
					<Transition to="AnticipationTeleport" from="FlyPatrol">
						<Condition>
							<CheckRandomRangeNumber EndNumber="4">0</CheckRandomRangeNumber>
						</Condition>
					</Transition>					
					<Transition to="TeleportAttackParticle" from="AnticipationTeleport"/>							
					<Transition to="Teleport" from="TeleportAttackParticle"/>
					<Transition to="TeleportEnd" from="Teleport"/>
					
					<Transition to="AnticipationLaserBeam" from="FlyPatrol">
						<Condition>
							<CheckRandomRangeNumber EndNumber="4">1</CheckRandomRangeNumber>
						</Condition>
					</Transition>	
					<Transition to="AttackLaserBeam" from="AnticipationLaserBeam"/>							
		
					<Transition to="AnticipationFireBall" from="FlyPatrol">
						<Condition>
							<CheckRandomRangeNumber EndNumber="4">2</CheckRandomRangeNumber>
						</Condition>
					</Transition>	
					<Transition to="AttackProjectile" from="AnticipationFireBall"/>	
					
					<Transition to="ShieldState" from="FlyPatrol">
						<Condition type="and">
							<CheckRandomRangeNumber operatorType="Less" EndNumber="101">10</CheckRandomRangeNumber>
							<CheckNumberAttachedEntities operatorType="Less">1</CheckNumberAttachedEntities>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="a_sprite_default" playOnState="NPC.FlyPatrol" sprite="gazerSprite" isLoop="true" animTime="800">
				<Frame>0, 3</Frame>
				<Frame>1, 3</Frame>
				<Frame>2, 3</Frame>
				<Frame>3, 3</Frame>
				<Frame>4, 3</Frame>
				<Frame>5, 3</Frame>
				<Frame>6, 3</Frame>
				<Frame>7, 3</Frame>
			</SpriteAnimation>				
			<SpriteAnimation name="b_teleport_particle_blast" sprite="teleportParticleSprite" animTime="300">
				<Frame>5, 5</Frame>
				<Frame>6, 5</Frame>
				<Frame>7, 5</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="c_sprite_anticipation_teleport" playOnState="NPC.AnticipationTeleport" sprite="gazerSprite" isLoop="false" animTime="600">
				<Frame>0, 7</Frame>
				<Frame>1, 7</Frame>
				<Frame>2, 7</Frame>
				<Frame>3, 7</Frame>
				<Frame>4, 7</Frame>
				<Frame>5, 7</Frame>
			</SpriteAnimation>				
			<SpriteAnimation name="d_sprite_invisible" playOnState="NPC.Teleport|NPC.TeleportAttackParticle" sprite="gazerSprite" isLoop="true" animTime="1">
				<Frame>4, 2</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="e_sprite_end_teleport" sprite="gazerSprite" playOnState="NPC.TeleportEnd" isLoop="false" animTime="600">
				<Frame>5, 7</Frame>
				<Frame>4, 7</Frame>
				<Frame>3, 7</Frame>
				<Frame>2, 7</Frame>
				<Frame>1, 7</Frame>
				<Frame>0, 7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="f_sprite_anticipation_laser_beam" playOnState="NPC.AnticipationLaserBeam" sprite="gazerSprite" isLoop="false" animTime="500">
				<Frame>0, 5</Frame>
				<Frame>1, 5</Frame>
				<Frame>2, 5</Frame>
				<Frame>3, 5</Frame>
				<Frame>4, 5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="g_sprite_anticipation_fire" playOnState="NPC.AnticipationFireBall" sprite="gazerSprite" isLoop="false" animTime="400">
				<Frame>0, 4</Frame>
				<Frame>1, 4</Frame>
				<Frame>2, 4</Frame>
				<Frame>3, 4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="h_sprite_fire_attack" playOnState="NPC.AttackProjectile" sprite="gazerSprite" isLoop="false" animTime="400">
				<Frame>0, 4</Frame>
				<Frame>1, 4</Frame>
				<Frame>2, 4</Frame>
				<Frame>3, 4</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_MuzzleFlash">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="emissionInterval">3.9</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">4</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="inSpecificOrder">true</Set>
					<Select name="offset" input="particleIndex">
						<Item>44,-22</Item>
						<Item>40,42</Item>
						<Item>-35,44</Item>
						<Item>-39.5,-40</Item>
					</Select>
					<Curve name="initialScale">
						<KeyFrame>0, 2,2</KeyFrame>
						<KeyFrame>0.3, 4,4</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
					<Set name="relativeToEmitter">true</Set>
					<Set name="sprite">s_Muzzle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.95, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">4.1</Set>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="laserbeam_particle" updateState="NPC.AttackLaserBeam">
				<Emitter>
					<Set name="offsetFacing">true</Set>
					<Set name="offset">0, 0</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">4</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="inSpecificOrder">true</Set>
					<Set name="sprite">laserBeamSprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Select name="offset" input="particleIndex">
						<Item>44,-22</Item>
						<Item>40,42</Item>
						<Item>-35,44</Item>
						<Item>-39.5,-40</Item>
					</Select>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">4</Set>
					<Set name="collisionDamageAmount">100</Set>
					<Set name="destroyOnCollision">false</Set>
					<Set name="collisionSize">32,32</Set>
					<Set name="initialAngle">90</Set>
					<Increment name="initialAngle" source="particleIndex" multiplier="90"/>
					<Set name="finalAngle">140</Set>
					<Increment name="finalAngle" source="particleIndex" multiplier="90"/>
					<Set name="interpolateAngle">true</Set>
					<Set name="initialScale">25,1</Set>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="teleportMuzzleParticle" updateStage="Update" updateState="NPC.TeleportAttackParticle">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">teleportParticleSprite</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="collisionDamageAmount">50</Set>
					<Set name="destroyOnCollision">false</Set>
					<Set name="collisionSize">140,140</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 2, 2</KeyFrame>
					</Curve>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
				</Particle>
			</ParticleSystem>		
			<ParticleSystem name="ps_HitEffect" updateStage="OnDamaged">
				<Emitter>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_HitEffect</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.4, 0</KeyFrame>
						<KeyFrame>0.41, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">0.44,0.27,0.48</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,90" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<Components>
			<Info/>
			<MustKillNPC/>
			<TintOverrideCmp/>
			<AttachmentSlotsCmp/>
			<Enemy>
				<Set name="SoulsReward">200</Set>
				<Set name="destroyTileId">3452</Set>
			</Enemy>
			<Movement/>
			<Damage>
				<Set name="damage">20</Set>
			</Damage>
			<IsBossNPC>
				<Set name="displayName">"Dreadgazer"</Set>
			</IsBossNPC>
			<NPCRenderActionCmp/>
			<StateMachine/>
			<Physics>
				<Set name="acceleration">0, 0</Set>
				<Set name="mass">20</Set>
				<Set name="drag">1.25, 1.25</Set>
			</Physics>
			<Health>
				<Set name="healthAmount">20000</Set>
				<Set name="maxHealth">20000</Set>
			</Health>
			<CollisionBox>
				<Set name="size">128,128</Set>
				<Set name="CollisionFlag">"PLAYERS|PROJECTILES"</Set>
				<Set name="CollisionType">"ENEMY_NPC"</Set>
			</CollisionBox>
			<DebugDraw/>
		</Components>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="gazerSprite"/>
			<Translate>0,-16,0</Translate>
			<NPCHealthBarRender TexturePath="interface/large/gui_event_npchealth_bar.rttex" TextureSize="17,9" TextureCoordinates="0,0" onState="NPC.FlyPatrol|NPC.AnticipationLaserBeam|NPC.AnticipationFireBall|NPC.AttackProjectile|NPC.AttackLaserBeam"/>
			<ParticleSystemRender name="laserbeam_particle"/>
			<ParticleSystemRender name="ps_MuzzleFlash"/>
		</Render>
		<Update>
			<ParticleSystemUpdate name="laserbeam_particle" onState="NPC.AttackLaserBeam"/>
			<ParticleSystemUpdate name="ps_MuzzleFlash" onState="NPC.AttackLaserBeam"/>
		</Update>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer NPCType="FlippingSpikesHorizontal">
	<Data>
		<Sprite name="s_sprite" fileName="game/tiles_page17.rttex" textureSize="32" frame="8,11" />
		<Sprite name="s_sprite_temp" fileName="game/tiles_page17.rttex" textureSize="32" frame="8,11" />
		<Animations>
			<SpriteAnimation name="a_to_up_active" sprite="s_sprite" playOnState="NPC.Up" isLoop="false" animTime="400">
				<Frame>9,11</Frame>
				<Frame>8,11</Frame>
				<Frame>10,11</Frame>
				<Frame>11,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_to_down_active" sprite="s_sprite" playOnState="NPC.Down" isLoop="false" animTime="400">
				<Frame>11,11</Frame>
				<Frame>10,11</Frame>
				<Frame>8,11</Frame>
				<Frame>9,11</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="NPC" ServerOnly="true">
				<States start="Up">
					<NPCStationary name="Up" ExitTime="2"/>
					<NPCStationary name="Down" ExitTime="2"/>
				</States>
				<Transitions>
					<Transition to="Up" from="Down"/>
					<Transition to="Down" from="Up"/>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Components>
			<Info/>
			<Enemy>
				<Set name="SoulsReward">0</Set>
				<Set name="destroyTileId">0</Set>
			</Enemy>
			<Movement>
				<Set name="IsStatic">true</Set>
			</Movement>
			<StateMachine/>
			<NPCRenderActionCmp/>
			<CollisionBox>
				<Set name="size">32,31</Set>
				<Set name="CollisionFlag">"PLAYERS|PROJECTILES|PROJECTILES_ENEMY"</Set>
				<Set name="CollisionType">"WORLD_TILES"</Set>
			</CollisionBox>
			<DebugDraw/>
		</Components>
		<ParticleSystems>
			<ParticleSystem name="fireParticle1_up">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="delayTimer">0.1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_sprite_temp</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="collisionDamageAmount">40</Set>
					<Set name="destroyOnCollision">false</Set>
					<Set name="collisionSize">31.5,17</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="lifeTime">1.9</Set>
					<Set name="initialAlpha">0</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
				</Particle>
			</ParticleSystem>			
			<ParticleSystem name="fireParticle1_down">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="delayTimer">0.1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_sprite_temp</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="collisionDamageAmount">40</Set>
					<Set name="destroyOnCollision">false</Set>
					<Set name="initialAlpha">0</Set>
					<Set name="collisionSize">31.5,17</Set>
					<Set name="lifeTime">1.9</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_sprite"/>
		</Render>
		<Update>
			<ParticleSystemUpdate name="fireParticle1_up" onState="NPC.Up" />
			<ParticleSystemUpdate name="fireParticle1_down" onState="NPC.Down" />
		</Update>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="fireParticle1_up"/>
			<ParticleSystemOff name="fireParticle1_down"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer NPCType="FlippingSpikesHorizontalDown">
	<Data>
		<Sprite name="s_sprite" fileName="game/tiles_page17.rttex" textureSize="32" frame="8,11" />
