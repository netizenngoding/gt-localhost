			</SpriteAnimation>
			<SpriteAnimation name="a_hell_before" sprite="s_iniSword" animTime="750" autoPlay="true" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>		
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
								<Frame>0,1</Frame>
