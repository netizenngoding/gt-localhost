				<Frame>1,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_buddha_earth" sprite="vowdmmm" animTime="800" isLoop="false">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
