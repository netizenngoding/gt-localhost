            </SpriteAnimation>
        </Animations>
        <ParticleSystems>
            <ParticleSystem name="PS423">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="emissionInterval">0</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Random name="particlesPerEmission" min="4" max="8" />
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="true" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>0.8,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Random name="initialAngle" min="0" max="360" />
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Random name="lifeTime" min="0.4" max="0.6" />
                    <Random name="offset" min="-4,-4" max="4,4" />
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Random name="initialScale" min="0.75,0.75" max="1.25,1.25" />
                    <Set name="sprite">Sprite236</Set>
                    <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="70,120" />
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="PS429" secondary="PS705">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,-10</Set>
                    <Set name="emissionInterval">0</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="false" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Set name="initialAlpha">1</Set>
                    <Set name="initialAngle">0</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="lifeTime">0.4</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Set name="initialScale">1,1</Set>
                    <Set name="sprite">Sprite138</Set>
                    <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="PS507">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="emissionInterval">0</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Random name="particlesPerEmission" min="1" max="4" />
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="false" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>0.25,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Random name="initialAngle" min="0" max="360" />
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="lifeTime">0.5</Set>
                    <Random name="offset" min="-4,-4" max="4,4" />
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Set name="initialScale">1,1</Set>
                    <Set name="sprite">Sprite562</Set>
                    <Set name="initialVelocity">0,0</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="PS595">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="emissionInterval">0</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Random name="particlesPerEmission" min="2" max="5" />
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="true" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>0.25,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Random name="initialAngle" min="0" max="360" />
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Random name="lifeTime" min="0.35" max="0.7" />
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">false</Set>
                    <Random name="initialRotationRate" min="0" max="30" />
                    <Set name="initialScale">1,1</Set>
                    <Set name="sprite">Sprite643</Set>
                    <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="110,180" />
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="PS705">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0.4</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="emissionInterval">0.033</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="true" randomSpriteFrame="false" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>0.25,0.5</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Random name="initialAngle" min="0" max="360" />
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="lifeTime">0.3</Set>
                    <Random name="offset" min="-16,-16" max="16,16" />
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Random name="initialScale" min="0.8,0.8" max="1.1,1.1" />
                    <Set name="sprite">Sprite236</Set>
                    <Set name="initialVelocity" source="trail.vel"/>
                </Particle>
            </ParticleSystem>
			<ParticleSystem name="PSFlash">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="lifeTime">0.4</Set>
					<Curve name="initialScale">
                        <KeyFrame>0,0.5,0.5</KeyFrame>
                        <KeyFrame>1,1.5,1.5</KeyFrame>
                    </Curve>
                    <Set name="sprite">SpriteFlash</Set>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>
		<VariableMap>
			<Set name="trail.vel">0, 0</Set>
			<Set name="context.pos">0, 0</Set>
			<Set name="target.pos">0, 0</Set>
			<Set name="target.distance">0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="DefaultPunchSound">audio/slash.wav</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
			</Default>
		</RenderOptions>
    </Data>
    <RenderRules>
        <RenderHandItem>
            <Translate>0,8,0</Translate>
            <SpriteRender name="Sprite10" blend="PREMULTIPLIED_ALPHA" drawShadow="true" />
            <SpriteRender name="Sprite51" blend="PREMULTIPLIED_ALPHA" drawShadow="false" />
			<ArithmethicOperation LeftHandVariableName="trail.vel" RightHandVariableName="target.pos" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="trail.vel" RightHandVariableName="context.pos" OperationType="Substract"/>
			<ArithmethicOperation LeftHandVariableName="trail.vel" RightHandVariableName="target.distance" OperationType="Divide"/>
			<ArithmethicOperation LeftHandVariableName="trail.vel" RightHandVariableName="-10" OperationType="Multiply"/>
        </RenderHandItem>
        <OnPunchStart>
            <ParticleSystemUpdate name="PS429" />
        </OnPunchStart>
        <OnPunchUpdate>
            <AvatarTransform class="ArmAngle">
                <Set name="armName">arm2Angle</Set>
                <Set name="Curve">
                    <KeyFrame>0,0</KeyFrame>
                    <KeyFrame>1,360</KeyFrame>
                </Set>
                <Set name="animTime">300</Set>
            </AvatarTransform>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
        </OnPunchUpdate>
        <OnDamagedTile>
            <ParticleSystemUpdate name="PS423" />
            <ParticleSystemUpdate name="PS507" />
            <ParticleSystemUpdate name="PS595" />
        </OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="PS423" />
			<ParticleSystemUpdate name="PS595" />
			<ParticleSystemUpdate name="PSFlash" />
		</OnDestroyedTile>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="md_sprite" fileName="game/goku.rttex" textureSize="64,96"/>
        <Sprite name="md_eff" fileName="game/{XML_SPRITESHEET_1}" textureSize="64"/>
        <Sprite name="md_eff2" fileName="game/goku_particles.rttex" textureSize="64" frame="7,4"/>
        <Sprite name="md_eff3" fileName="game/goku_particles.rttex" textureSize="32"/>
		<Sprite name="md_punch" fileName="game/goku_punch.rttex" textureSize="32"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="ge_eff" sprite="md_eff" animTime="9250" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
            <Frame>2,0</Frame>
            <Frame>3,0</Frame>
            <Frame>4,0</Frame>
            <Frame>5,0</Frame>
            <Frame>6,0</Frame>
            <Frame>7,0</Frame>
            <Frame>8,0</Frame>
            <Frame>9,0</Frame>
            <Frame>10,0</Frame>
            <Frame>11,0</Frame>
            <Frame>12,0</Frame>
            <Frame>13,0</Frame>
            <Frame>14,0</Frame>
            <Frame>15,0</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
            <Frame>2,1</Frame>
            <Frame>3,1</Frame>
			</SpriteAnimation>
            <SpriteAnimation name="ge_eff2" sprite="md_eff2" animTime="400" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
			<Frame>7,4</Frame>
			<Frame>8,4</Frame>
            <Frame>9,4</Frame>
            <Frame>10,4</Frame>
            <Frame>11,4</Frame>
			</SpriteAnimation>
            <SpriteAnimation name="ge_eff3" sprite="md_eff3" animTime="400" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
			<Frame>4,30</Frame>
			<Frame>5,30</Frame>
            <Frame>6,30</Frame>
            <Frame>7,30</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="ge_punch_eff" sprite="md_punch" animTime="400" isLoop="true" playOnState="Motion.Punch">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Idle_Animation" playOnState="Motion.Idle" sprite="md_sprite" animTime="7500" isLoop="true">
            <Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
            
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Punch_Animation" playOnState="Motion.Punch" sprite="md_sprite" animTime="7500">
			<Frame>0,3</Frame>
			<Frame>1,3</Frame>
			<Frame>2,3</Frame>
            <Frame>3,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Jump_Animation" playOnState="Motion.Jump" sprite="md_sprite" animTime="7000">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Fall_Animation" playOnState="Motion.Fall" sprite="md_sprite" animTime="7000">
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="gigi_Walk_Animation" playOnState="Motion.Move" sprite="md_sprite" animTime="7000" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>

			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">30</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
                <Set name="ShouldHover">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
            <SpriteRender name="md_punch" offset="23,-10025" onState="Motion.Punch" blend="ADDITIVE" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0" scale="1,1"/>
            <SpriteRender name="md_eff" offset="0,-10060" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff" offset="0,-10060" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff" offset="0,-10060" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff3" offset="0,-10035" drawShadow="false" blend="ADDITIVE" flip="1,0" scale="1.5,2" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_sprite" offset="0,-10045" drawShadow="true" scale="1,1" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff" offset="0,-10050" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff" offset="0,-10045" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
            <SpriteRender name="md_eff2" offset="0,-10060" drawShadow="false" blend="ADDITIVE" scale="1.5,2" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>\
            <SpriteRender name="md_eff3" offset="0,-10035" drawShadow="false" blend="ADDITIVE" scale="1.5,2.5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnPunchStart>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="UC_Sprite" fileName="game/gs.rttex" textureSize="64"/>
		<Sprite name="UC_Punch" fileName="game/gs_punch.rttex" textureSize="128"/>
		<Sprite name="UC_Portal" fileName="game/gs_particles.rtttex" textureSize="64"/>
		<Sprite name="UC_Portal2" fileName="game/gs_particles.rtttex" textureSize="64" frame="1,0"/>
		<Sprite name="UC_Portal4" fileName="game/gs_particles.rtttex" textureSize="64" frame="0,0"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="ge_eff2" sprite="UC_Portal4" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
				<Frame>10,5</Frame>
				<Frame>11,5</Frame>
				<Frame>12,5</Frame>
				<Frame>13,5</Frame>
				<Frame>14,5</Frame>
				<Frame>15,5</Frame>
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="ge_eff" sprite="UC_Portal" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="uc_Idle_Animation" playOnState="Motion.Idle" sprite="UC_Sprite" animTime="14000" isLoop="true">
            <Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Punch_Animation" playOnState="Motion.Punch" sprite="UC_Sprite" animTime="400">
			<Frame>0,5</Frame>
			<Frame>1,5</Frame>
			<Frame>2,5</Frame>
			<Frame>3,5</Frame>
			<Frame>4,5</Frame>
			<Frame>5,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Jump_Animation" playOnState="Motion.Jump" sprite="UC_Sprite" animTime="400">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Fall_Animation" playOnState="Motion.Fall" sprite="UC_Sprite" animTime="400">
				<Frame>3,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Walk_Animation" playOnState="Motion.Move" sprite="UC_Sprite" animTime="600" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>

			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="uc_flex" updateStage="AddClothingParticles" renderStage="RenderInFront">
				<Emitter>
				  <Random name="offset" min="-20, -10002" max="20, -10070" />
				  <Random name="emissionInterval" min="0.05" max="0.07" />
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
				  <Set name="sprite">UC_Portal2</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Set name="lifeTime">0.5</Set>
				  <Set name="initialVelocity">0,-3</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Random name="initialScale" min="0.4" max="0.6" />
				</Particle>
			  </ParticleSystem>
			<ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
				<Emitter>
                    <Set name="offset">20,-10030</Set>
                    <Set name="emissionInterval">10</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">UC_Punch</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Curve name="initialAlpha">
                                <KeyFrame>0, 1</KeyFrame>
                                <KeyFrame>0.5, 1</KeyFrame>
                                <KeyFrame>1, 0</KeyFrame>
                            </Curve>
                    <Curve name="initialScale">
                                <KeyFrame>0, 0,0</KeyFrame>
                                <KeyFrame>1, 0.7,0.7</KeyFrame>
                    </Curve>
					<Random name="initialRotationRate" min="360" max="-360" />
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="interpolateAlpha">false</Set>
                    <Set name="initialAlpha">1</Set>
                    <Set name="finalAlpha">1</Set>
                    <Set name="interpolateVelocity">true</Set>
                    <Set name="initialScale">1,1</Set>
                    <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                    <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                </Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">30</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<AvatarSilhouetteRender color="10,10,10,100" offset ="0,30" emissionInterval="0.08" onState="Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" scale="1=2,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060"  tintOverride="255,50,255,255" scale="2,2.5" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Sprite" offset="0,-10028.5" drawShadow="true" scale="1,1" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" flip="1,0" tintOverride="0,0,0,60" scale="1,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
        </RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnPunchStart>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="UC_Sprite" fileName="game/hs1.rttex" textureSize="132"/>
		<Sprite name="UC_Punch" fileName="game/hs_slash.rttex" textureSize="318"/>
		<Sprite name="UC_Particle1" fileName="game/hs_particles.rttex" textureSize="32"/>
		<Sprite name="UC_Particle2" fileName="game/hs_particles.rttex" textureSize="32"/>
		<Sprite name="UC_Particle3" fileName="game/hs_particles.rttex" textureSize="32"/>
		<Sprite name="UC_Particle4" fileName="game/hs_particles.rttex" textureSize="32"/>
		<Animations>
			<SpriteAnimation name="uc_hell_punch" sprite="UC_Punch" animTime="300" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_snowflakes" sprite="UC_Particle4">
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_snowflakesHit" sprite="UC_Particle2">
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_trail" sprite="UC_Particle1">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_hell_after" sprite="UC_Sprite" animTime="500" isLoop="true" autoPlay="true" >
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>0,3</Frame>
			</SpriteAnimation>
			<InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-120, 0, 0, 1" animTime="2000" playOnState="Punch.False"/>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_breakflame" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_breakflame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Random name="offset" min="0" max="16" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="pUC_Particle2">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UC_Particle2</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 1,1</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_SparklesTrail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Move">
				<Emitter>
					<Set name="offset">0,-5</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UC_Particle1</Set>
					<Random name="offset" min="0, -12" max="4, 1" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="lifeTime" input="randomNumber">
						<Item>0.3</Item>
						<Item>0.6</Item>
					</Select>
					<Random name="initialScale" min="0.5" max="0.8" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_JumpTrail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Jump">
				<Emitter>
					<Set name="offset">0,-5</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UC_Particle1</Set>
					<Random name="offset" min="-8, -12" max="4, 0" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="lifeTime" input="randomNumber">
						<Item>0.3</Item>
						<Item>0.6</Item>
					</Select>
					<Set name="initialAngle">270</Set>
					<Random name="initialScale" min="0.5" max="0.8" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_FallTrail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Fall">
				<Emitter>
					<Set name="offset">0,-5</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UC_Particle1</Set>
					<Random name="offset" min="-8, -12" max="4, 0" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="lifeTime" input="randomNumber">
						<Item>0.3</Item>
						<Item>0.6</Item>
					</Select>
					<Set name="initialAngle">90</Set>
					<Random name="initialScale" min="0.5" max="0.8" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="UserNameOffset">15</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="DefaultPunchSound">audio/droar.wav</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
		<TileStampData>
			<Set name="FileName">game/{XML_SPRITESHEET_2}</Set>
			<Set name="EndFrame">8,0</Set>
			<Set name="FrameCount">5</Set>
		</TileStampData>

	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-26</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="UC_Punch" offset="50,-35" alignment="CENTER" rotateOffset="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="0.7,0.7" onAction="PUNCH" />
		</RenderInFront>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<Group>
			<Rotate>Sword_rotation</Rotate>
			<SpriteRender name="UC_Sprite" offset="13,-25" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="0.55,0.55" />
			</Group>
		</RenderBackHandItem>
		<RenderPet>
		</RenderPet>
		<UpdatePet>
		</UpdatePet>

		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="pUC_Particle2" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
	<!-- 0baseBodyNew -->
		<Sprite name="badan_ninetails" fileName="game/kurama_tails.rttex" textureSize="128" frame="0,0"/>
		<Sprite name="luffy_dance" fileName="game/kurama_tails.rttex" textureSize="128" frame="0,5"/>

	<!-- 1bijuDamaKurama -->
		<Sprite name="s_punchBubbles" fileName="game/kurama_particles1.rttex" textureSize="256" frame="0,0"/>

	<!-- 2ledakanKurama -->
		<Sprite name="s_explosion" fileName="game/kurama_particles2.rttex" textureSize="256"/>

	<!-- ingame -->
		<Sprite name="s_punchSplash" fileName="game/particles11.rttex" textureSize="32" frame="23,26"/>

	<!-- 0baseBodyNew -->
		<Sprite name="luffy_respawn" fileName="game/kurama_tails.rttex" textureSize="128" frame="0,2"/>
		
	<!-- 3tileHitKurama -->
		<Sprite name="s_DestroyImpact" fileName="game/kurama.rttex" textureSize="256" />
		<Sprite name="luffy_sleep" fileName="game/kurama.rttex" textureSize="256" frame="0,1"/>


		<!-- <Sprite name="s_tileHit" fileName="game/tileHitKurama" textureSize="256"/> -->
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
					<State name="Respawn"/>
					<State name="Dance"/>
					<State name="Sleep"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>

					<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|Sleep">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>

					<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|Sleep">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>

					<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|Sleep">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>

					<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|Sleep">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>

					<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
						<Condition>
							<IsAction>DANCE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
						<Condition>
							<IsAction>DANCE_DAB</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
						<Condition>
							<IsAction>DANCE_FLOSS</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
						<Condition>
							<IsAction>DANCE_MARCH</IsAction>
						</Condition>
					</Transition>

					<Transition to="Sleep" from="Idle|Move|Fall|Jump|Punch|Dance">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Animations>
			<SpriteAnimation name="luffy_sleep_animation" sprite="luffy_sleep" animTime="1000" isLoop="true" playOnState="Motion.Sleep">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Dance_Animation" playOnState="Motion.Dance" sprite="luffy_dance" animTime="500" isLoop="true">
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kyub_bjdama" sprite="s_punchBubbles" animTime="800" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>0,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_explosion" sprite="s_explosion" animTime="400" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="kyub_Idle_Animation" playOnState="Motion.Idle" sprite="badan_ninetails" animTime="600" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame> 
			</SpriteAnimation>
			<SpriteAnimation name="kyub_Punch_Animation" playOnState="Motion.Punch" sprite="badan_ninetails" animTime="300">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kyub_Jump_Animation" playOnState="Motion.Jump" sprite="badan_ninetails" animTime="300">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kyub_Fall_Animation" playOnState="Motion.Fall" sprite="badan_ninetails" animTime="300">
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kyub_Walk_Animation" playOnState="Motion.Move" sprite="badan_ninetails" animTime="600" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_respawn" sprite="luffy_respawn" animTime="1200" isLoop="false">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>5,2</Frame>
				<Frame>5,2</Frame>
				<Frame>5,2</Frame>
				<Frame>5,2</Frame>
			</SpriteAnimation>
			<!-- <SpriteAnimation name="a_hit_particle" sprite="s_tileHit" animTime="700" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation> -->
			<SpriteAnimation name="a_DestroyImpact" sprite="s_DestroyImpact" animTime="1000">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="offset">5, -245</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.0</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 2,2</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>

			<!-- <ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">8, -60</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem> -->

			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.1</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_respawn</Set>
					<Set name="offset">0,-281</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Set name="initialScale">5,5</Set>
					<Set name="lifeTime">1.5</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="dasdasdas" updateStage="AddClothingParticles" updateState="Motion.Punch">
				<Emitter>
					<Set name="offset">15, -10160</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="6" max="6" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punchBubbles</Set>
					<Set name="frame">0,0</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialScale">0.1,0.1</Set>
					<Random name="finalScale" min="2" max="6"/>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">2.5</Set>
					<Random name="targetPosOffset" min="-12,-11" max="12,11"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="2" angleOutVar="projectile_angle"/>
					<VectorTo name="finalVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.1" angleOutVar="projectile_angle"/>
					<Set name="interpolateVelocity">true</Set>
					<OnFinish>
						<ParticleSystemName>ps_explosion</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_explosion">
				<Emitter>
					<Set name="lifeTime">0.4</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">0,0</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
				</Emitter>
				<Particle>
					<Set name="initialScale">6,6</Set>
					<Set name="sprite">s_explosion</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">120</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="PunchSoundOverride">SHOES</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="badan_ninetails" offset="-50,-10281" drawShadow="true" scale="5,5" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch|Motion.Respawn"/>
			<SpriteRender name="luffy_dance" offset="0,-10291" drawShadow="true" scale="5,5" onState="Motion.Dance"/>
			<SpriteRender name="luffy_sleep" offset="0,-10562" drawShadow="true" scale="5,5" onState="Motion.Sleep"/>
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnPunchStart>
		</OnPunchStart>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="UC_Sprite" fileName="game/mbappe.rttex" textureSize="69"/>
		<Sprite name="UC_Punch" fileName="game/messi_punch.rttex" textureSize="128"/>
		<Sprite name="UC_Portal" fileName="game/mbappe_particles.rttex" textureSize="64"/>
		<Sprite name="UC_Portal2" fileName="game/mbappe_particles.rttex" textureSize="32" frame="1,0"/>
		<Sprite name="UC_Portal4" fileName="game/mbappe_particles.rttex" textureSize="64" frame="0,0"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="ge_eff2" sprite="UC_Portal4" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
				<Frame>10,5</Frame>
				<Frame>11,5</Frame>
				<Frame>12,5</Frame>
				<Frame>13,5</Frame>
				<Frame>14,5</Frame>
				<Frame>15,5</Frame>
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="ge_eff" sprite="UC_Portal" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="uc_Idle_Animation" playOnState="Motion.Idle" sprite="UC_Sprite" animTime="14000" isLoop="true">
            <Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Punch_Animation" playOnState="Motion.Punch" sprite="UC_Sprite" animTime="400">
			<Frame>0,5</Frame>
			<Frame>1,5</Frame>
			<Frame>2,5</Frame>
			<Frame>3,5</Frame>
			<Frame>4,5</Frame>
			<Frame>5,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Jump_Animation" playOnState="Motion.Jump" sprite="UC_Sprite" animTime="400">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Fall_Animation" playOnState="Motion.Fall" sprite="UC_Sprite" animTime="400">
				<Frame>3,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Walk_Animation" playOnState="Motion.Move" sprite="UC_Sprite" animTime="600" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>

			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="uc_flex" updateStage="AddClothingParticles" renderStage="RenderInFront">
				<Emitter>
				  <Random name="offset" min="0, -10000" max="20, -10070" />
				  <Random name="emissionInterval" min="0.05" max="0.07" />
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
				  <Set name="sprite">UC_Portal2</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Set name="lifeTime">0.5</Set>
				  <Set name="initialVelocity">0,-3</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Random name="initialScale" min="0.4" max="0.6" />
				</Particle>
			  </ParticleSystem>
			<ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
				<Emitter>
                    <Set name="offset">25,-10000</Set>
                    <Set name="emissionInterval">10</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">UC_Punch</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Curve name="initialAlpha">
                                <KeyFrame>0, 1</KeyFrame>
                                <KeyFrame>0.5, 1</KeyFrame>
                                <KeyFrame>1, 0</KeyFrame>
                            </Curve>
                    <Curve name="initialScale">
                                <KeyFrame>0, 0,0</KeyFrame>
                                <KeyFrame>1, 0.7,0.7</KeyFrame>
                    </Curve>
					<Random name="initialRotationRate" min="360" max="-360" />
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="interpolateAlpha">false</Set>
                    <Set name="initialAlpha">1</Set>
                    <Set name="finalAlpha">1</Set>
                    <Set name="interpolateVelocity">true</Set>
                    <Set name="initialScale">1,1</Set>
                    <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                    <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                </Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">30</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLembappe">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<AvatarSilhouetteRender color="10,10,10,100" offset ="0,30" emissionInterval="0.08" onState="Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" scale="1=2,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060"  tintOverride="255,50,255,255" scale="2,2.5" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Sprite" offset="0,-10028.5" drawShadow="true" scale="1,1" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" flip="1,0" tintOverride="0,0,0,60" scale="1,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
        </RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnPunchStart>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Move|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite
			name="s_Pet_head" fileName="game/md0.rttex" textureSize="64" frame="13,18" />
		<Sprite
			name="s_Pet_back" fileName="game/md0.rttex" textureSize="64" frame="12,18" />

		<Sprite
			name="p_Pet_head" fileName="game/md0.rttex" textureSize="64" frame="13,19" />
		<Sprite
			name="p_Pet_back" fileName="game/md0.rttex" textureSize="64" frame="12,19" />

		<Sprite
			name="hand" fileName="game/md1.rttex" textureSize="32" frame="0,0" />
		<Sprite name="hand_eletric" fileName="game/md1.rttex" textureSize="32"
			frame="1,42" />
		<Sprite name="s_fire" fileName="game/md1.rttex" textureSize="32" 
            frame="0,42" />
		<Sprite name="s_trail1" fileName="game/md1.rttex" textureSize="32"
			frame="1,43" />
		<Sprite name="s_trail2" fileName="game/md1.rttex" textureSize="32"
			frame="2,43" />
    	<Sprite name="sparks_sprite" fileName="game/particles11.rttex" textureSize="32,32"
			frame="23,25"/>	

		<Animations>
			<SpriteAnimation name="a_dragon_punch_head" sprite="p_Pet_head" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>13,19</Frame>
				<Frame>15,19</Frame>
				<Frame>17,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_punch_back" sprite="p_Pet_back" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>12,19</Frame>
				<Frame>14,19</Frame>
				<Frame>16,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_head" sprite="s_Pet_head" animTime="1000" isLoop="true"
				playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>13,18</Frame>
				<Frame>15,18</Frame>
				<Frame>17,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_back" sprite="s_Pet_back" animTime="1000" isLoop="true"
				playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>12,18</Frame>
				<Frame>14,18</Frame>
				<Frame>16,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_eletric" sprite="hand_eletric" animTime="500" isLoop="true"
				playOnAction="IDLE|PUNCH|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>1,42</Frame>
				<Frame>2,42</Frame>
				<Frame>3,42</Frame>
			</SpriteAnimation>
		</Animations>

		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">26,10</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>

		<ParticleSystems>
			<ParticleSystem name="ps_punchProjectile" updateStage="RenderPet"
				updateState="Motion.Punch">
				<Emitter usePlayerFacing="true">
					<Random name="emissionInterval" min="0.002" max="0.004" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
					<Set name="offset">30, -53</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_fire</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialScale">5,5</Set>
					<Set name="finalScale">10,10</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Random name="targetPosOffset" min="-6, -26" max="6, 26" />
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset"
						duration="lifeTime" x="1" />
					<Set name="rotateWithVelocity">true</Set>
					<OnFinish>
						<ParticleSystemName>ps_punchSmoke</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchSmoke">
				<Emitter>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="delay">-0.25</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_fire</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="offset" min="-16, -16" max="16, 16" />
					<Set name="initialAngle">180</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.5, 1.5</KeyFrame>
						<KeyFrame>1, 0.1, 0.1</KeyFrame>
					</Curve>
					<Set name="rotateWithVelocity">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,80" />
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail1" updateStage="RenderPet">
				<Emitter>
					<Random name="offset" min="0, -26" max="-100, -26" />
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_trail1</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.0, 1.0</KeyFrame>
						<KeyFrame>1, 3.0, 3.0</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.5</Set>
					<Random name="initialAngle" min="-180" max="180" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail2" updateStage="RenderPet">
				<Emitter>
					<Random name="offset" min="0, -26" max="-100, -26" />
					<Set name="emissionInterval">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_trail2</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.0, 1.0</KeyFrame>
						<KeyFrame>1, 3.0, 3.0</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.5</Set>
					<Random name="initialAngle" min="-180" max="180" />
				</Particle>
			</ParticleSystem>
		  	<ParticleSystem name="sparkles_punch" updateStage="OnDamagedTile">
				<Emitter>
				    <Set name="offset">0,0</Set>
				    <Set name="lifeTime">1.5</Set>
				    <Set name="particlesPerEmission">16</Set>
				    <Set name="delayTimer">0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">sparks_sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1.25</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.0, 1.0</KeyFrame>
						<KeyFrame>1, 1.6, 1.6</KeyFrame>
					</Curve>
          			<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="65,90"/>
			  </Particle>
			</ParticleSystem>       
			<ParticleSystem name="hitSpark_particle" updateStage="OnDestroyedTile" secondary="trail_particle">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">sparks_sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">2,2</Set>
					<Random name="finalScale" min="0.1, 0.1" max="0.4, 0.4"/>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200"/>
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300"/>
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">20</Set>
					<Set name="emissionInterval">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">sparks_sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="initialRotationRate">150</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 0</KeyFrame>
						<KeyFrame>0.4, 1, 1</KeyFrame>
						<KeyFrame>0.8, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.75</KeyFrame>
						<KeyFrame>0.8, 0.6</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialVelocity">0,0</Set>
				</Particle>
			</ParticleSystem> 
			<ParticleSystem name="eletric_particles" updateStage="AddClothingParticles"
				renderStage="RenderBackHandItem">
				<Emitter>
					<Random name="offset" min="14,-5" max="15,-45" />
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
					<Set name="emissionInterval">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="useGravity">true</Set>
					<Set name="checkParticleNumToEmit">false</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hand_eletric</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="lifeTime">0.80</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="gravityVector">0, -25</Set>
					<Set name="initialVelocity">1,1</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.5,0.5</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<VariableMap>
			<Set name="projectile_offset">0, 0</Set>
			<Set name="projectile_angle">0</Set>
		</VariableMap>

		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">true</Set>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderBackArmBuild">true</Set>
				<Set name="DefaultPunchSound">audio/droar.wav</Set>
		        <Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderBackHandItem>
			<SpriteRender name="hand" rotateOffset="true" offset="-4,28" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
				blend="PREMULTIPLIED_ALPHA" />
		</RenderBackHandItem>

		<Update>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1700</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</Update>
        
		<OnPunchUpdate>
		<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderPet>
			<SpriteRender name="p_Pet_head" alignment="DOWN_CENTER" onAction="PUNCH" offset="0,10" scale= "2.0, 2.0"/>
			<SpriteRender name="p_Pet_back" alignment="DOWN_CENTER" onAction="PUNCH" offset="-127,10" scale= "2.0, 2.0"/>
			<ParticleSystemRender name="ps_Trail1" />
			<ParticleSystemRender name="ps_Trail2" />
			<SpriteRender name="s_Pet_head" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="0,10" scale= "2.0, 2.0"/>
			<SpriteRender name="s_Pet_back" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="-127,10" scale= "2.0, 2.0" />
		</RenderPet>
	</RenderRules>
</ItemRenderer>
    <?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="UC_Sprite" fileName="game/messi.rttex" textureSize="69"/>
		<Sprite name="UC_Punch" fileName="game/messi_punch.rttex" textureSize="128"/>
		<Sprite name="UC_Portal" fileName="game/messi_particles.rttex" textureSize="64"/>
		<Sprite name="UC_Portal2" fileName="game/messi_particles.rttex" textureSize="32" frame="1,0"/>
		<Sprite name="UC_Portal4" fileName="game/messi_particles.rttex" textureSize="64" frame="0,0"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="ge_eff2" sprite="UC_Portal4" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
				<Frame>10,5</Frame>
				<Frame>11,5</Frame>
				<Frame>12,5</Frame>
				<Frame>13,5</Frame>
				<Frame>14,5</Frame>
				<Frame>15,5</Frame>
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="ge_eff" sprite="UC_Portal" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="uc_Idle_Animation" playOnState="Motion.Idle" sprite="UC_Sprite" animTime="14000" isLoop="true">
            <Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Punch_Animation" playOnState="Motion.Punch" sprite="UC_Sprite" animTime="400">
			<Frame>0,5</Frame>
			<Frame>1,5</Frame>
			<Frame>2,5</Frame>
			<Frame>3,5</Frame>
			<Frame>4,5</Frame>
			<Frame>5,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Jump_Animation" playOnState="Motion.Jump" sprite="UC_Sprite" animTime="400">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Fall_Animation" playOnState="Motion.Fall" sprite="UC_Sprite" animTime="400">
				<Frame>3,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Walk_Animation" playOnState="Motion.Move" sprite="UC_Sprite" animTime="600" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>

			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="uc_flex" updateStage="AddClothingParticles" renderStage="RenderInFront">
				<Emitter>
				  <Random name="offset" min="0, -10000" max="20, -10070" />
				  <Random name="emissionInterval" min="0.05" max="0.07" />
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
				  <Set name="sprite">UC_Portal2</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Set name="lifeTime">0.5</Set>
				  <Set name="initialVelocity">0,-3</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Random name="initialScale" min="0.4" max="0.6" />
				</Particle>
			  </ParticleSystem>
			<ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
				<Emitter>
                    <Set name="offset">25,-10000</Set>
                    <Set name="emissionInterval">10</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">UC_Punch</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Curve name="initialAlpha">
                                <KeyFrame>0, 1</KeyFrame>
                                <KeyFrame>0.5, 1</KeyFrame>
                                <KeyFrame>1, 0</KeyFrame>
                            </Curve>
                    <Curve name="initialScale">
                                <KeyFrame>0, 0,0</KeyFrame>
                                <KeyFrame>1, 0.7,0.7</KeyFrame>
                    </Curve>
					<Random name="initialRotationRate" min="360" max="-360" />
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="interpolateAlpha">false</Set>
                    <Set name="initialAlpha">1</Set>
                    <Set name="finalAlpha">1</Set>
                    <Set name="interpolateVelocity">true</Set>
                    <Set name="initialScale">1,1</Set>
                    <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                    <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                </Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">30</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLemessi">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<AvatarSilhouetteRender color="10,10,10,100" offset ="0,30" emissionInterval="0.08" onState="Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" scale="1=2,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060"  tintOverride="255,50,255,255" scale="2,2.5" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Sprite" offset="0,-10028.5" drawShadow="true" scale="1,1" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" flip="1,0" tintOverride="0,0,0,60" scale="1,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
        </RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnPunchStart>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="UCJUESTUDIO_0" fileName="game/mk0.rttex" textureSize="64" frame="0,0"/>
        <Sprite name="UCJUESTUDIO_1" fileName="game/mk1.rttex" textureSize="32" frame="0,0"/>
        
        <Animations>
			<SpriteAnimation name="UCJUESTUDIO_3" sprite="UCJUESTUDIO_0" animTime="1000" isLoop="true" playOnAction="JUMP|FALL|IDLE|WALK" autoPlay="true" >
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteCurveAnimation name="UCJUESTUDIO_4" isLoop="true" autoPlay="true" sprite="UCJUESTUDIO_1" animTime="175">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.5f, 0.9.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
        </Animations>
		

		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderHandItem>
			<SpriteRender name="UCJUESTUDIO_0" rotateOffset="true" offset="17,3" blend="PREMULTIPLIED_ALPHA"/>
            <SpriteRender name="UCJUESTUDIO_1" offset="5,0" onAction="PUNCH" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,1" scale="1,1.5"/>
		</RenderHandItem>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		    <AvatarTransform class="ArmAngle">
			    <Set name="armName">arm2Angle</Set>
			    <Set name="armAngle">1750</Set>
			    <Set name="isAdditive">true</Set>
			    <Set name="pointTowardsPunchTarget">false</Set>
		    </AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="luffy_idle" fileName="game/luffy_vow.rttex" textureSize="128"/>
		<Sprite name="luffy_punch" fileName="game/luffy_vow.rttex" textureSize="128"/>

		<Sprite name="luffy_bubbles" fileName="game/luffy_bubble.rttex" textureSize="128" frame="0,0"/>
		
		<Sprite name="s_tileHit" fileName="game/luffy_effect.rttex" textureSize="128"/>
		<Sprite name="s_DestroyImpact" fileName="game/luffy_effect.rttex" textureSize="128" />
		<Sprite name="luffy_respawn" fileName="game/luffy_effect.rttex" textureSize="128"/>
		<Sprite name="luffy_sleep" fileName="game/luffy_effect.rttex" textureSize="128"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Dance"/>
				<State name="Sleep"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|Sleep">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Sleep" from="Idle|Move|Fall|Jump|Punch|Dance">
					<Condition>
					<IsAction>SLEEP</IsAction>
					</Condition>
				</Transition>
				<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
					<Condition>
						<IsAction>DANCE</IsAction>
						<IsAction>DANCE_DAB</IsAction>
						<IsAction>DANCE_FLOSS</IsAction>
						<IsAction>DANCE_MARCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		<StateMachine name="IsDying">
			<States>
				<State name="False" />
				<State name="True" />
			</States>
			<Transitions>
				<Transition from="False" to="True">
					<Condition>
						<IsAction>DIE</IsAction>
					</Condition>
				</Transition>
				<Transition from="True" to="False">
					<Condition>
						<IsAction operatorType="NotEqual">DIE</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

		</StateMachines>
	<Animations>
		<SpriteAnimation name="luffy_sleep_animation" sprite="luffy_sleep" animTime="600" isLoop="true" playOnState="Motion.Sleep">
			<Frame>0,1</Frame>
			<Frame>1,1</Frame> 
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Dance_Animation" playOnState="Motion.Dance" sprite="luffy_idle" animTime="1000" isLoop="true">
			<Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
			<Frame>2,2</Frame>
			<Frame>5,2</Frame>
			<Frame>6,2</Frame>
			<Frame>7,2</Frame>
			<Frame>8,2</Frame>
			<Frame>9,2</Frame>
			<Frame>10,2</Frame>
			<Frame>11,2</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_DestroyImpact" sprite="s_DestroyImpact" animTime="1000">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
			<Frame>8,0</Frame>
			<Frame>9,0</Frame>
			<Frame>10,0</Frame>
			<Frame>11,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_hit_particle" sprite="s_tileHit" animTime="700" isLoop="false">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
			<Frame>8,0</Frame>
			<Frame>9,0</Frame>
			<Frame>10,0</Frame>
			<Frame>11,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Idle_Animation" playOnState="Motion.Idle" sprite="luffy_idle" animTime="1000" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Punch_Animation" playOnState="Motion.Punch" sprite="luffy_punch" animTime="500" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Jump_Animation" playOnState="Motion.Jump" sprite="luffy_idle" animTime="300">
				<Frame>8,0</Frame>
				<Frame>9,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Fall_Animation" playOnState="Motion.Fall" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Walk_Animation" playOnState="Motion.Move" sprite="luffy_idle" animTime="400" isLoop="true">
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
		<SpriteAnimation name="luffy_Respawn_Animation" sprite="luffy_respawn" animTime="1200" isLoop="false">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
		</SpriteAnimation>
	</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="offset">8, -60</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<!-- <Set name="offset">0, -10</Set> -->
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.0</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 2,2</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_Right" updateStage="OnPunchStart" updateState="Facing.Right">
				<Emitter>
					<Set name="offset">8, -10085</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_left" updateStage="OnPunchStart" updateState="Facing.Left">
				<Emitter>
					<Set name="offset">8, -10085</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipY">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">8, -60</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.1</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">luffy_respawn</Set>
					<Set name="offset">0,-75</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.1</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">20</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="luffy_idle" offset="0,-10085" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Dance" scale="1.4,1.4"/>
			<SpriteRender name="luffy_punch" offset="0,-10085" drawShadow="true" onState="Motion.Punch" scale="1.4,1.4"/>
			<SpriteRender name="luffy_sleep" offset="0,-10095" drawShadow="true" onState="Motion.Sleep" scale="1.4,1.4"/>
			<!-- <SpriteRender name="luffy_respawn" offset="0,-10160" drawShadow="true" onState="IsDying.True" scale="1.4,1.4"/>DOESNT WORK-STILLUNDERGROUND -->
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="UCJUESTUDIO_0" fileName="game/mw0.rttex" textureSize="64" frame="0,0" />
		<Sprite name="UCJUESTUDIO_1" fileName="game/mw1.rttex" textureSize="32" frame="0,0" />
		<Sprite name="UCJUESTUDIO_2" fileName="game/mw1.rttex" textureSize="32" frame="1,0" />
		<Sprite name="UCJUESTUDIO_3" fileName="game/mw1.rttex" textureSize="32" frame="2,0" />


		<Animations>
			<SpriteAnimation name="UCJUESTUDIO_4" playOnAction="IDLE|WALK" sprite="UCJUESTUDIO_0">
				<Frame>0,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="UCJUESTUDIO_5" playOnAction="FALL" sprite="UCJUESTUDIO_0">
				<Frame>3,0</Frame>
			</SpriteAnimation>g

			<SpriteAnimation name="UCJUESTUDIO_6" playOnAction="JUMP|JUMPEND" sprite="UCJUESTUDIO_0"
				animTime="250" autoPlay="true" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>2,0</Frame>
				<Frame>1,0</Frame>
				<Frame>0,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="UCJUESTUDIO_3"
				playOnState="playerState.DoubleJump" autoPlay="false" isLoop="false"
				sprite="UCJUESTUDIO_3" animTime="100">
				<Frame>2,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="UCJUESTUDIO_1"
				playOnState="playerState.DoubleJump" autoPlay="false" isLoop="false"
				sprite="UCJUESTUDIO_1" animTime="100">
				<Frame>0,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="UCJUESTUDIO_2"
				playOnState="playerState.DoubleJump" autoPlay="false" isLoop="false"
				sprite="UCJUESTUDIO_2" animTime="100">
				<Frame>1,0</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>


			<ParticleSystem name="UCJUESTUDIO_3_up">
				<Emitter>
					<Random name="offset" min="0, -5" max="0, -5" />
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">UCJUESTUDIO_3</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1.3, 1.3</Set>
					<Set name="finalScale">1.3, 1.3</Set>
				</Particle>
			</ParticleSystem>


			<ParticleSystem name="double_jump_particle_left">
				<Emitter>
					<Random name="offset" min="20, 0" max="16, 0" />
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">UCJUESTUDIO_1</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1.3, 1.3</Set>
					<Set name="finalScale">2.6, 2.6</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="double_jump_particle_right">
				<Emitter>
					<Random name="offset" min="-16, 0" max="-20, 0" />
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">UCJUESTUDIO_2</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1.3, 1.3</Set>
					<Set name="finalScale">2.6, 2.6</Set>
				</Particle>
			</ParticleSystem>

		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderBackpack>
            <SpriteRender name="UCJUESTUDIO_0" offset="0,-32" scale="1.3, 1.3" alignmentLeft="LEFT_CENTER"
                alignmentRight="RIGHT_CENTER" />
            <SpriteRender name="UCJUESTUDIO_0" offset="0,-32" scale="1.3, 1.3" flip="1,0"
                alignmentLeft="RIGHT_CENTER"
                alignmentRight="LEFT_CENTER" />
        </RenderBackpack>

		<AddClothingParticles>
			<ParticleSystemUpdate name="UCJUESTUDIO_3_up" onAction="JUMPDOUBLE"
				drawShadow="false" align="RIGHT_CENTER" />
			<ParticleSystemUpdate name="double_jump_particle_left" onAction="JUMPDOUBLE"
				drawShadow="false" align="LEFT_CENTER" />
			<ParticleSystemUpdate name="double_jump_particle_right" onAction="JUMPDOUBLE"
				drawShadow="false" align="RIGHT_CENTER" />
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="UCJUESTUDIO_3_up" />
			<ParticleSystemOff name="double_jump_particle_left" />
			<ParticleSystemOff name="double_jump_particle_right" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
