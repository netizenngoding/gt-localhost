			<SpriteAnimation name="gogeta_SSJBSleepLoop_Animation" playOnState="Motion.SSJBSleepLoop" sprite="gogeta_sprite_2" animTime="400" isLoop="true">
				<Frame>9,2</Frame>
				<Frame>10,2</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="gogeta_SSJBDance_Animation" playOnState="Motion.SSJBDance" sprite="gogeta_sprite_2" animTime="4000" isLoop="false">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>7,4</Frame>
				<Frame>8,4</Frame>
				<Frame>9,4</Frame>
				<Frame>10,4</Frame>
				<Frame>11,4</Frame>
				<Frame>12,4</Frame>
				<Frame>13,4</Frame>
				<Frame>14,4</Frame>
				<Frame>15,4</Frame>
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="gogeta_SSJBDanceLoop_Animation" playOnState="Motion.SSJBDanceLoop" sprite="gogeta_sprite_3" animTime="1800" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">2</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">gogeta_respawn</Set>
					<Set name="offset">0,-75</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.5,1.5</KeyFrame>
						<KeyFrame>1, 1.5,1.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">2</Set>
				</Particle>
			</ParticleSystem>


			<ParticleSystem name="ps_tileHit_base" updateStage="OnDamagedTile" updateState="Motion.Punch">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">gogeta_tilehit_ssj</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.45, 0.45</KeyFrame>
						<KeyFrame>1, 1.1, 1.1</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.7</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_bubble_ssj" updateStage="OnPunchStart" updateState="Motion.SSJPunch">
				<Emitter>
					<Set name="offset">45,-10040</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">gogeta_bubble_ssj</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialScale">0.1,0.1</Set>
					<Random name="finalScale" min="2" max="2"/>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.45</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<OnFinish>
						<ParticleSystemName>ps_bubbleExplosion_ssj</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_bubbleExplosion_ssj">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">gogeta_tilehit_ssj</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.7</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_bubble_ssjb" updateStage="OnPunchStart" updateState="Motion.SSJBPunch">
				<Emitter>
					<Set name="offset">45,-10040</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">gogeta_bubble_ssjb</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialScale">0.1,0.1</Set>
					<Random name="finalScale" min="2" max="2"/>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.45</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<OnFinish>
						<ParticleSystemName>ps_bubbleExplosion_ssjb</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_bubbleExplosion_ssjb">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">gogeta_tilehit_ssjb</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">2.1</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">SHOES</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">50</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.SSJTransform">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.SSJTransform">
				<Set name="action">NOD</Set>
			</AvatarTransform>
			<AvatarTransform class="FootPosition" onState="Motion.SSJBTransform">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.SSJBTransform">
				<Set name="action">NOD</Set>
			</AvatarTransform>

			<AvatarTransform class="FootPosition" onState="Motion.Dance|Motion.SSJDance|Motion.SSJBDance|Motion.SSJBDanceLoop">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance|Motion.SSJDance|Motion.SSJBDance|Motion.SSJBDanceLoop">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>

		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>

			<SpriteRender
				name="gogeta_sprite"
				offset="0,-10090"
				drawShadow="true"
				onState="Motion.TransformGate|Motion.Transform|Motion.Idle|Motion.IdleLoop|Motion.MoveRight|Motion.Jump|Motion.Fall|Motion.Punch|Motion.Sleep|Motion.SleepLoop|Motion.Dance|Motion.SSJTransform|Motion.SSJSleep|Motion.SSJSleepLoop|Motion.SSJMoveRight|Motion.SSJJump|Motion.SSJFall|Motion.SSJDance"
				scale="1.5,1.5"
			/>

			<SpriteRender
				name="gogeta_sprite_2"
				offset="0,-10090"
				drawShadow="true"
				onState="Motion.SSJIdleGate|Motion.SSJIdleIntro|Motion.SSJIdleLoop|Motion.SSJPunch|Motion.SSJBTransform|Motion.SSJBIdleLoop|Motion.SSJBPunch|Motion.SSJBMoveRight|Motion.SSJBJump|Motion.SSJBFall|Motion.SSJBSleep|Motion.SSJBSleepLoop|Motion.SSJBDance"
				scale="1.5,1.5"
			/>

			<SpriteRender
				name="gogeta_sprite_3"
				offset="0,-10058"
				drawShadow="true"
				onState="Motion.SSJBDanceLoop"
				scale="2,2"
			/>

			<SpriteRender
				name="gogeta_respawn"
				offset="0,-10090"
				drawShadow="true"
				onState="Motion.Respawn|Motion.PostRespawn"
				scale="1.5,1.5"
			/>

			<SpriteRender
				name="gogeta_sprite"
				offset="0,-10090"
				drawShadow="true"
				onState="Motion.MoveLeft|Motion.SSJMoveLeft"
				scale="1.5,1.5"
				flip="1,0"
			/>

			<SpriteRender
				name="gogeta_sprite_2"
				offset="0,-10090"
				drawShadow="true"
				onState="Motion.SSJBMoveLeft"
				scale="1.5,1.5"
				flip="1,0"
			/>
		</RenderInFront>

		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>

		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
<!-- 0idle -->
		<Sprite name="luffy_idle" fileName="game/UGCSpritesheet14v0.rttex" textureSize="128"/>
		<Sprite name="luffy_punch" fileName="game/UGCSpritesheet14v0.rttex" textureSize="128"/>
<!-- 1bubble -->
		<Sprite name="luffy_bubbles" fileName="game/UGCSpritesheet14v1.rttex" textureSize="32" frame="0,0"/>
<!-- 2effect -->
		<Sprite name="s_tileHit" fileName="game/UGCSpritesheet14v2.rttex" textureSize="64"/>
		<Sprite name="s_DestroyImpact" fileName="game/UGCSpritesheet14v2.rttex" textureSize="64" />
<!-- 0idle -->
		<Sprite name="luffy_respawn" fileName="game/UGCSpritesheet14v0.rttex" textureSize="128"/>
		<Sprite name="luffy_sleep" fileName="game/UGCSpritesheet14v0.rttex" textureSize="128"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Dance"/>
				<State name="Sleep"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|Sleep">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Sleep" from="Idle|Move|Fall|Jump|Punch|Dance">
					<Condition>
					<IsAction>SLEEP</IsAction>
					</Condition>
				</Transition>
				<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
					<Condition>
						<IsAction>DANCE</IsAction>
						<IsAction>DANCE_DAB</IsAction>
						<IsAction>DANCE_FLOSS</IsAction>
						<IsAction>DANCE_MARCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		<StateMachine name="IsDying">
			<States>
				<State name="False" />
				<State name="True" />
			</States>
			<Transitions>
				<Transition from="False" to="True">
					<Condition>
						<IsAction>DIE</IsAction>
					</Condition>
				</Transition>
				<Transition from="True" to="False">
					<Condition>
						<IsAction operatorType="NotEqual">DIE</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

		</StateMachines>
	<Animations>
		<SpriteAnimation name="luffy_sleep_animation" sprite="luffy_sleep" animTime="600" isLoop="true" playOnState="Motion.Sleep">
			<Frame>0,7</Frame>
			<Frame>1,7</Frame> 
			<Frame>2,7</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Dance_Animation" playOnState="Motion.Dance" sprite="luffy_idle" animTime="1000" isLoop="true">
			<Frame>0,6</Frame>
			<Frame>1,6</Frame>
			<Frame>2,6</Frame>
			<Frame>3,6</Frame>
			<Frame>4,6</Frame>
