				<Frame>2, 2</Frame>
				<Frame>3, 2</Frame>
				<Frame>4, 2</Frame>
				<Frame>5, 2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_land_foot2_move_anim" sprite="s_land_foot2" animTime="600" isLoop="true" playOnState="Land.Move">
				<Frame>0, 3</Frame>
