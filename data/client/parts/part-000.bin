								<Frame>0,2</Frame>	
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_iniSword" animTime="750" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
			</SpriteAnimation>	<SpriteAnimation name="a_hit_fire" sprite="s_flameHit" animTime="400" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
            <!-- <InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-190, 0, 180, 1" animTime="1000" playOnState="Punch.False"/> -->
		</Animations>
        <TileStampData>
            <Set name="FileName">game/UGCSpritesheet69v1.rttex</Set>
            <Set name="EndFrame">1,2</Set>
            <Set name="FrameCount">1</Set>
        </TileStampData>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
    <StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ScytheAnimation">
				<States>
					<State name="Before" />
					<State name="Idle" />
				</States>
				<Transitions>
					<Transition from="Before" to="Idle">
						<Condition>
							<IsAnimationFinished>a_hell_before</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileIni</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
							<Random name="finalScale" min="0.1" max="1"/>
												<Set name="interpolateScale">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_meledakDuar</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-300</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_buddha_fire</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_raygun_smoke</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,10,10</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="ScytheAnimation.Idle">
        <Emitter>
          <Random name="offset" min="-20, -30" max="20, -70" />
          <Random name="emissionInterval" min="0.28" max="0.56" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.8" max="1.4" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">12,-48</Set>
          <Set name="lifeTime">2</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">-16,-48</Set>
          <Set name="lifeTime">2</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
			<KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_debuWinter</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="ScytheAnimation.Idle">
				<Emitter>
          <Random name="offset" min="-300, -150" max="110, 30" />
					<Random name="emissionInterval" min="0.010" max="0.02" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_debuWinter</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    				<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.7" max="1.8" />
					<Set name="lifeTime">1.5</Set>
					<Random name="initialVelocity" min="-20, 40" max="30, 60" />
					<Random name="initialAngle" min="0" max="-360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <!-- <VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap> -->
	<RenderOptions>
		<Default>
			<!-- <Set name="ShouldHover">true</Set> -->
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">false</Set>
			<Set name="IncludeAllActions">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>
			<Set name="RenderBackArmBuild">false</Set>
			<Set name="RenderFrontArmInfected">true</Set>
			<Set name="RenderBackArmInfected">true</Set>
			<Set name="UserNameOffset">15</Set>
			<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
		</Default>
	</RenderOptions>
	</Data>
	<RenderRules>
		<!-- <Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Jump">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-210</Set>
				<Set name="angleOffset">90</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Fall">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-135</Set>
				<Set name="angleOffset">90</Set>
			</AvatarTransform>

		</Update> -->
		<RenderInFront>
			<!-- <SpriteRender name="s_punchEfek" offset="10,-10" alignment="CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="-2,-2" onAction="PUNCH" />
			<SpriteRender name="s_buddha" offset="0,-360" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle|Pet.Punch" /> -->


		</RenderInFront>
		<RenderBackHandItem>
		</RenderBackHandItem>

		<RenderHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group onState="ScytheAnimation.Before">
				<SpriteRender name="s_iniSword" offset="0,-15" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" />
			</Group>

			      <SpriteRender name="s_FrontArm" offset="0,-12" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>


			<Group onState="ScytheAnimation.Idle">
				<SpriteRender name="s_iniSword" offset="3,0" rotationPoint="-0.45, 0.4" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" scale="0.1,0.1" />
				     <SpriteRender name="s_FrontArm" offset="0,-12" rotationPoint="0,1" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>
			</Group>
		</RenderHandItem>

		
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="angleOffset">0</Set>
				<!-- <Set name="armAngle">0</Set> -->
				<!-- <Set name="isAdditive">true</Set> -->
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<!-- <AvatarTransform class="ArmAngle" onState="Punch.True">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-135</Set>
			</AvatarTransform> -->
		</OnPunchUpdate>
		
    <RenderFrontArm>
      <ContextUpdate type="PositionSinPulse" onState="Punch.True">
        <Set name="period">100</Set>
        <Set name="scale">-0.5</Set>
        <Set name="clamp">true</Set>
      </ContextUpdate>
    </RenderFrontArm>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<!-- 0sahurVow -->
		<Sprite name="sahur_idle" fileName="game/UGCSpritesheet7v0.rttex" textureSize="128"/>
		<!-- 1sahurBubble -->
		<Sprite name="sahur_bubbles" fileName="game/UGCSpritesheet7v1.rttex" textureSize="128" frame="0,0|1,0|2,0|3,0"/>
		<!-- 2sahurEffect -->
		<Sprite name="s_tileHit" fileName="game/UGCSpritesheet7v2.rttex" textureSize="128"/>
		<Sprite name="s_DestroyImpact" fileName="game/UGCSpritesheet7v2.rttex" textureSize="128" />
		<Sprite name="sahur_respawn" fileName="game/UGCSpritesheet7v2.rttex" textureSize="128"/>
		<!-- 3sahurSleep -->
		<Sprite name="sahur_sleep" fileName="game/UGCSpritesheet7v3.rttex" textureSize="128"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Dance"/>
				<State name="Sleep"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|Sleep">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Sleep" from="Idle|Move|Fall|Jump|Punch|Dance">
					<Condition>
					<IsAction>SLEEP</IsAction>
					</Condition>
				</Transition>
				<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
					<Condition>
						<IsAction>DANCE</IsAction>
						<IsAction>DANCE_DAB</IsAction>
						<IsAction>DANCE_FLOSS</IsAction>
						<IsAction>DANCE_MARCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		<StateMachine name="IsDying">
			<States>
				<State name="False" />
				<State name="True" />
			</States>
			<Transitions>
				<Transition from="False" to="True">
					<Condition>
						<IsAction>DIE</IsAction>
					</Condition>
				</Transition>
				<Transition from="True" to="False">
					<Condition>
						<IsAction operatorType="NotEqual">DIE</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

		</StateMachines>
	<Animations>
		<SpriteAnimation name="luffy_sleep_animation" sprite="sahur_sleep" animTime="1000" isLoop="true" playOnState="Motion.Sleep">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame> 
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Dance_Animation" playOnState="Motion.Dance" sprite="sahur_idle" animTime="1000" isLoop="true">
			<Frame>0,5</Frame>
			<Frame>1,5</Frame>
			<Frame>2,5</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_DestroyImpact" sprite="s_DestroyImpact" animTime="1000">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_hit_particle" sprite="s_tileHit" animTime="700" isLoop="false">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="sahur_Idle_Animation" playOnState="Motion.Idle" sprite="sahur_idle" animTime="1000" isLoop="true">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>7,4</Frame>
				<Frame>8,4</Frame>
				<Frame>9,4</Frame>
				<Frame>10,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sahur_Punch_Animation" playOnState="Motion.Punch" sprite="sahur_idle" animTime="500" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sahur_Jump_Animation" playOnState="Motion.Jump" sprite="sahur_idle" animTime="300">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sahur_Fall_Animation" playOnState="Motion.Fall" sprite="sahur_idle" animTime="400" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sahur_Walk_Animation" playOnState="Motion.Move" sprite="sahur_idle" animTime="400" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
			</SpriteAnimation>
		<SpriteAnimation name="sahur_Respawn_Animation" sprite="sahur_respawn" animTime="1200" isLoop="false">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
		</SpriteAnimation>
	</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="offset">8, -60</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<!-- <Set name="offset">0, -10</Set> -->
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.0</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 2,2</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_Right" updateStage="OnPunchStart" updateState="Facing.Right">
				<Emitter>
					<Set name="offset">8, -10050</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">sahur_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-15, 0</Item>
						<Item>40, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_left" updateStage="OnPunchStart" updateState="Facing.Left">
				<Emitter>
					<Set name="offset">8, -10050</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">sahur_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipY">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">8, -20</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.1</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">sahur_respawn</Set>
					<Set name="offset">0,0</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.1</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">80</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="sahur_idle" offset="0,-10050" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Punch|Motion.Fall|Motion.Dance" scale="1.4,1.4"/>
			<SpriteRender name="sahur_sleep" offset="0,-10050" drawShadow="true" onState="Motion.Sleep" scale="1.4,1.4"/>
			<!-- <SpriteRender name="sahur_respawn" offset="0,-10160" drawShadow="true" onState="IsDying.True" scale="1.4,1.4"/>DOESNT WORK-STILLUNDERGROUND -->
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
<!-- dm reeel. or VOW for items like this :) -->
  <Data>
  <!-- spikeyLwingBlackRed0 -->
    <Sprite name="iniWingnya" fileName="game/UGCSpritesheet70v0.rttex" textureSize="128"/>
  <!-- jumpSpikey1 -->
    <Sprite name="iniParticlenya" fileName="game/UGCSpritesheet70v1.rttex" textureSize="128" frame="0,0"/>
    <!-- <Sprite name="s_death" fileName="game/flamingssSplash" textureSize="128"/> -->
  <!-- deathSpikey2 -->
    <Sprite name="s_death" fileName="game/UGCSpritesheet70v2.rttex" textureSize="128"/>
    <!-- <Sprite name="iniTrail" fileName="game/flamingssFet" textureSize="64" frame="0,0"/> -->
        <!-- <Sprite name="s_glow" fileName="game/particles_large17" textureSize="64" frame="9,3"/> -->
    <Sprite name="s_snowflake" fileName="game/UGCSpritesheet70v2.rttex" textureSize="128" frame="0,0"/>
    <Sprite name="s_trail" fileName="game/UGCSpritesheet70v2.rttex" textureSize="128" frame="0,0"/>

    <Animations>
            <SpriteAnimation name="a_particle" sprite="iniParticlenya" isLoop="true" animTime="400">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_snowflake" sprite="s_snowflake" isLoop="true" animTime="400">
        <Frame>0,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_trail" sprite="s_trail" isLoop="true" animTime="300">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
        <Frame>4,2</Frame>
        <Frame>5,2</Frame>
        <Frame>6,2</Frame>
        <Frame>7,2</Frame>
        <Frame>8,2</Frame>
        <Frame>9,2</Frame>
        <Frame>10,2</Frame>
        <Frame>11,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Jump" playOnAction="JUMP|JUMPDOUBLE" sprite="iniWingnya" animTime="200" autoPlay="true" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Fall" playOnAction="FALL" sprite="iniWingnya" animTime="200" autoPlay="true" isLoop="true">
        <Frame>3,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="iniWingnya" tintOverride="0,127,236,255">
        <Frame>0,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_death" sprite="s_death" animTime="1200">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_snowflake">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_snowflake</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.05</Set>
          <Set name="initialAngle" source="snowflake_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_snowflake1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_snowflake</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.05</Set>
          <Set name="initialAngle" source="snowflake_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_deathSplash" updateStage="OnKilled" renderStage="RenderBehind">
        <Emitter>
          <Set name="lifeTime">1.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-24</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_death</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">3.0, 3.0</Set>
              <Set name="lifeTime">1.2</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="iniParticlenya_jump">
        <Emitter>
          <Random name="offset" min="0, 40" max="0, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">1.1, 1.1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_left">
        <Emitter>
          <Random name="offset" min="40, 40" max="32, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_right">
        <Emitter>
          <Random name="offset" min="-32, 40" max="-40, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
      
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="HideAvatarOnDeath">true</Set>
        <Set name="HideAngelOnDeath">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>

    <RenderBackpack>
      <SpriteRender name="iniWingnya" offset="0,-35" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="iniWingnya" offset="0,-35" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/> 
     </RenderBackpack>
    
    <RenderInFront>
        <ParticleSystemRender name="ps_snowflake" />
        <ParticleSystemRender name="ps_trail"/>
        <ParticleSystemRender name="ps_snowflake1"/>
        <ParticleSystemRender name="ps_trail1"/>
    </RenderInFront>

    <AddClothingParticles>
        <ParticleSystemUpdate name="ps_trail" onAction="WALK|IDLE|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_snowflake" onAction="IDLE|WALK|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_trail1" onAction="WALK|IDLE|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_snowflake1" onAction="IDLE|WALK|JUMP|FALL" drawShadow="false"/>
      <!-- donotremoveS -->
      <ParticleSystemUpdate name="iniParticlenya_jump" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_left" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_right" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_trail" />
      <ParticleSystemOff name="ps_trail1" />
      <ParticleSystemOff name="iniParticlenya_jump" />
      <ParticleSystemOff name="bloody_jump_left" />
      <ParticleSystemOff name="bloody_jump_right" />
    </SwitchOffClothingParticles>
  
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
	<!-- sworddark0 -->
		<Sprite name="s_scythe" fileName="game/UGCSpritesheet71v0.rttex" textureSize="112,64"/>
	<!-- slash1 -->
		<Sprite name="s_punch_eff" fileName="game/UGCSpritesheet71v1.rttex" textureSize="292,203"/>
	<!-- wave2 -->
		<Sprite name="s_punchCurve" fileName="game/UGCSpritesheet71v2.rttex" textureSize="128"/>

		<Sprite name="s_DestroyImpact" fileName="game/UGCSpritesheet71v3.rttex" textureSize="64"/>
		<Sprite name="Lightning" fileName="game/UGCSpritesheet71v3.rttex" textureSize="64" />
		<Sprite name="s_flameHit" fileName="game/UGCSpritesheet71v3.rttex" textureSize="64" frame="0,2" />
		<Sprite name="s_FrontArm" fileName="game/UGCSpritesheet71v3.rttex" textureSize="64" frame="0,4"/>
		<Sprite name="s_debu" fileName="game/UGCSpritesheet71v3.rttex" textureSize="64" frame="10,0" />
		<Sprite name="s_debuWinter" fileName="game/UGCSpritesheet71v3.rttex" textureSize="64" frame="0,0"/>
		<Sprite name="s_flameCurve" fileName="game/UGCSpritesheet71v3.rttex" textureSize="64" frame="4,0" />

		<Animations>			
			<SpriteAnimation name="a_hit_fire" sprite="s_flameHit" animTime="400" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_punch" sprite="s_punch_eff" animTime="300" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_scythe" animTime="500" isLoop="true" autoPlay="true" >
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="Lightning_Anim" sprite="Lightning" autoPlay="true" animTime="910" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
				<Frame>9,2</Frame>
				<Frame>10,2</Frame>
				<Frame>11,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Attack_particle" sprite="s_punchCurve" animTime="700" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakesHit" sprite="s_DestroyImpact" animTime="500">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="s_debuWinter">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
			</SpriteAnimation>
		</Animations>

		<!-- <TileStampData>
            <Set name="FileName">game/UGCSpritesheet71v3.rttex</Set>
            <Set name="EndFrame">1,2</Set>
            <Set name="FrameCount">1</Set>
        </TileStampData> -->

		<ParticleSystems>
			<ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
				<Emitter>
				  <Set name="offset">12,-48</Set>
				  <Set name="lifeTime">2</Set>
				  <Set name="particlesPerEmission">1</Set>
				  <Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
				  <Set name="sprite">s_flameHit</Set>
				  <Set name="renderAlignment">CENTER</Set>
				  <Set name="lifeTime">2</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 1</KeyFrame>
					<KeyFrame>0.9, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Curve name="initialScale">
					<KeyFrame>0, 5,5</KeyFrame>
					<KeyFrame>1, 5,5</KeyFrame>
				  </Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
				<Emitter>
				  <Set name="offset">-16,-48</Set>
				  <Set name="lifeTime">2</Set>
				  <Set name="particlesPerEmission">1</Set>
				  <Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
				  <Set name="sprite">s_flameHit</Set>
				  <Set name="renderAlignment">CENTER</Set>
				  <Set name="lifeTime">2</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 1</KeyFrame>
					<KeyFrame>0.9, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Curve name="initialScale">
					<KeyFrame>0, 5,5</KeyFrame>
					<KeyFrame>1, 5,5</KeyFrame>
				  </Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
				<Emitter attachment="contextRotation">
					<Set name="offset">0,-18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punchCurve</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="initialScale">1.2,1.2</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="ScytheAnimation.Idle">
				<Emitter>
				  <Random name="offset" min="-20, -30" max="20, -70" />
				  <Random name="emissionInterval" min="0.28" max="0.56" />
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
				  <Set name="sprite">s_debu</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Set name="lifeTime">1.0</Set>
				  <Set name="initialVelocity">0,-3</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Random name="initialScale" min="0.8" max="1.4" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_breakSparkles">
				<Emitter>
				  <Set name="lifeTime">0.25</Set>
				  <Set name="particlesPerEmission">1</Set>
				  <Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
				  <Set name="sprite">s_debu</Set>
				  <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				  <Set name="lifeTime">1</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Curve name="initialScale">
					<KeyFrame>0, 2,2</KeyFrame>
					<KeyFrame>0.5, 3,3</KeyFrame>
					<KeyFrame>1, 0.5,0.5</KeyFrame>
				  </Curve>
				  <Random name="initialRotationRate" min="5" max="15" />
				  <Random name="offset" min="0" max="16" />
				  <Set name="useGravity">true</Set>
				  <Set name="gravityVector">0, -100</Set>
				  <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_breakMist">
				<Emitter>
				  <Set name="lifeTime">1</Set>
				  <Set name="infParticles">true</Set>
				  <Set name="checkParticleNumToEmit">true</Set>
				  <Set name="particlesPerEmission">24</Set>
				  <Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
				  <Set name="sprite">s_debuWinter</Set>
				  <Random name="offset" min="-30, -20" max="30, 20" />
				  <Set name="renderAlignment">CENTER</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 1</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Curve name="initialScale">
					<KeyFrame>0, 2, 2</KeyFrame>
					<KeyFrame>1, 0.5, 0.5</KeyFrame>
				  </Curve>
				  <Set name="lifeTime">1</Set>
				  <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="ScytheAnimation.Idle">
				<Emitter>
				  <Random name="offset" min="-300, -150" max="110, 30" />
					<Random name="emissionInterval" min="0.010" max="0.02" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_debuWinter</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.7" max="1.8" />
					<Set name="lifeTime">1.5</Set>
					<Random name="initialVelocity" min="-20, 40" max="30, 60" />
					<Random name="initialAngle" min="0" max="-360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
					<State name="Respawn"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<VariableMap>
		</VariableMap>

		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="UserNameOffset">15</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="DefaultPunchSound">audio/realitytear.wav</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-120</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="s_punch_eff" offset="75,-30" alignment="CENTER" rotateOffset="true" rotateToTarget="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="2,2" onAction="PUNCH" />
			<SpriteRender name="Lightning" alignment="DOWN_CENTER" offset="0, 10" onAction="IDLE|PUNCH|WALK|JUMP|FALL" drawShadow="false" />
		</RenderInFront>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<Group>
				<Rotate>Sword_rotation</Rotate>
				<SpriteRender name="s_scythe" offset="75,0" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="2,2" />
			</Group>
		</RenderBackHandItem>
		<RenderHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="s_FrontArm" offset="0,-12" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>
		</RenderHandItem>
		<RenderPet>
		</RenderPet>
		<UpdatePet>
		</UpdatePet>

		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="angleOffset">0</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderFrontArm>
			<ContextUpdate type="PositionSinPulse" onState="Punch.True">
				<Set name="period">100</Set>
				<Set name="scale">-0.5</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderFrontArm>

		<OnDamagedTile>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
			<ParticleSystemUpdate name="ps_breakSparkles"/>
			<ParticleSystemUpdate name="ps_breakMist"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
    <Data>
        <StateMachines>
            <StateMachine name="MOYYVOW">
                <States>
                    <State name="Equip"/>
                    <State name="Fall"/>
                    <State name="Punch"/>
                </States>
                <Transitions>
                    <Transition from="Equip" to="Fall">
                        <Condition>
                            <IsAction>FALL</IsAction>
                        </Condition>
                    </Transition>
                    <Transition from="Fall" to="Equip">
                        <Condition>
                            <IsAction operatorType="NotEqual">FALL</IsAction>
                        </Condition>
                    </Transition>
                    <Transition from="Equip|Fall" to="Punch">
                        <Condition>
                            <IsAction>PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition from="Punch" to="Equip">
                        <Condition type="and">
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">FALL</IsAction>
                        </Condition>
                    </Transition>
                    <Transition from="Punch" to="Fall">
                        <Condition type="and">
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction>FALL</IsAction>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>

<!-- 0scy_blackhole -->
        <Sprite name="equip_sprite" fileName="game/UGCSpritesheet72v0.rttex" textureSize="64" frame="0,0"/>
        <Sprite name="slash_sprite" fileName="game/UGCSpritesheet72v0.rttex" textureSize="64" frame="6,0"/>
        <Sprite name="res" fileName="game/UGCSpritesheet72v0.rttex" textureSize="64" frame="0,1"/>
        <Sprite name="punch_projectile_sprite" fileName="game/UGCSpritesheet72v0.rttex" textureSize="64" frame="4,0"/>
<!-- 1bh_ic -->
       
        <Sprite name="s_sparkles" fileName="game/UGCSpritesheet72v1.rttex" textureSize="32" frame="4,0"/>
        <Sprite name="MAYO_FY" fileName="game/UGCSpritesheet72v1.rttex" textureSize="32" frame="1,0"/>
        <Sprite name="MAYFY" fileName="game/UGCSpritesheet72v1.rttex" textureSize="32" frame="2,1"/>
       
       
       
       
        <Sprite name="s_mist" fileName="game/particles_large16.rttex" textureSize="64" frame="15,4"/>
        <Animations>
            <SpriteAnimation name="a_SCYTHEA_equip" playOnState="MOYYVOW.Equip|MOYYVOW.Fall|MOYYVOW.Punch" sprite="equip_sprite" animTime="400" isLoop="true">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="slash_animation" sprite="slash_sprite" animTime="175" isLoop="true" playOnState="MOYYVOW.Punch">
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>8,0</Frame>
                <Frame>9,0</Frame>
                <Frame>10,0</Frame>
                <Frame>11,0</Frame>
                <Frame>12,0</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="M4Y0" sprite="MAYO_FY" animTime="400">
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="SCYTHEARespawn" sprite="res" animTime="1200" isLoop="true">
                <Frame>7,1</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
                <Frame>4,1</Frame>
                <Frame>5,1</Frame>
                <Frame>6,1</Frame>
                <Frame>7,1</Frame>
                <Frame>7,1</Frame>
            </SpriteAnimation>
        </Animations>
        <ParticleSystems>
            <ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
                <Emitter>
                    <Set name="offset">9,-18</Set>
                    <Set name="emissionInterval">0.25</Set>
                    <Set name="lifeTime">0.25</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="true">
                    <Set name="sprite">punch_projectile_sprite</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">0.4</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="interpolateAlpha">false</Set>
                    <Set name="initialScale">2,2</Set>
                    <Set name="initialAlpha">1</Set>
                    <Set name="finalAlpha">1</Set>
                    <Set name="interpolateVelocity">true</Set>
                    <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
                    <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="CPS">
                <Emitter>
                    <Set name="emissionInterval">0.1</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle randomSpriteFrame="true" usePlayerFacing="true" angleRelativeToPlayerSpeed="true">
                    <Set name="sprite">s_mist</Set>
                    <Random name="offset" min="-12, -15" max="12, -18"/>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="isBackgroundParticle">true</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 0.75, 0.75</KeyFrame>
                        <KeyFrame>0.8, 1, 0.25</KeyFrame>
                        <KeyFrame>1, 1.5, 0</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">1</Set>
                    <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,20"/>
                    <Random name="initialAngle" min="0" max="360"/>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_mist">
                <Emitter>
                    <Set name="offset">0, -15</Set>
                    <Set name="emissionInterval">0.5</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">s_mist</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="isBackgroundParticle">true</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0</KeyFrame>
                        <KeyFrame>0.5, 0.5</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Curve name="initialScale">
                        <KeyFrame>0, 0.5, 0.5</KeyFrame>
                        <KeyFrame>1, 1.25, 1.25</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">3</Set>
                    <Set name="initialVelocity">0, 0</Set>
                    <Random name="initialAngle" min="0" max="360"/>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="GAGAGAGAGAG" updateStage="OnKilled">
                <Emitter>
                    <Set name="lifeTime">0.9</Set>
                    <Set name="emissionInterval">0</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">res</Set>
                    <Set name="offset">0,-10</Set>
                    <Set name="renderAlignment">CENTER</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>1, 1.4,1.4</KeyFrame>
                        <KeyFrame>1, 1.4,1.4</KeyFrame>
                    </Curve>
                    <Curve name="initialScale">
                        <KeyFrame>1, 1,1</KeyFrame>
                        <KeyFrame>1, 1,1</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">0.8</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="SCYTHEADEMAYO" updateStage="OnDamagedTile">
                <Emitter>
                    <Set name="lifeTime">1.8</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="offset">0,0</Set>
                </Emitter>
                <Particle>
                    <Curve name="initialScale">
                        <KeyFrame>0, 0,0</KeyFrame>
                        <KeyFrame>0.3, 3,1.5</KeyFrame>
                        <KeyFrame>0.9, 2,0.7</KeyFrame>
                        <KeyFrame>1, 1,0</KeyFrame>
                    </Curve>
                    <Set name="sprite">MAYO_FY</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="lifeTime">1.8</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="oKEMAYO" updateStage="OnDamagedTile">
                <Emitter>
                    <Set name="lifeTime">1.8</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="offset">0,0</Set>
                </Emitter>
                <Particle>
                    <Curve name="initialScale">
                        <KeyFrame>0, 0,0</KeyFrame>
                        <KeyFrame>0.4, 1,1</KeyFrame>
                        <KeyFrame>0.8, 1,1</KeyFrame>
                        <KeyFrame>0.93, 1.5,1.5</KeyFrame>
                        <KeyFrame>0.96, 1,0.5</KeyFrame>
                        <KeyFrame>1, 2,0</KeyFrame>
                    </Curve>
                    <Set name="sprite">MAYFY</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1.8</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_Sparkles" updateStage="AddClothingParticles">
                <Emitter>
                    <Random name="emissionInterval" min="0.03" max="0.06"/>
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Random name="offset" min="-32, -32" max="24, -6"/>
                </Emitter>
                <Particle>
                    <Set name="sprite">s_sparkles</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0</KeyFrame>
                        <KeyFrame>0.3, 1</KeyFrame>
                        <KeyFrame>0.8, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Curve name="initialScale">
                        <KeyFrame>0, 0.2,0.2</KeyFrame>
                        <KeyFrame>0.05, 1,1</KeyFrame>
                        <KeyFrame>0.1, 0.2,0.2</KeyFrame>
                        <KeyFrame>0.15, 1,1</KeyFrame>
                        <KeyFrame>0.2, 0.2,0.2</KeyFrame>
                        <KeyFrame>0.25, 1,1</KeyFrame>
                        <KeyFrame>0.3, 0.2,0.2</KeyFrame>
                        <KeyFrame>0.35, 1,1</KeyFrame>
                        <KeyFrame>0.4, 0.2,0.2</KeyFrame>
                        <KeyFrame>0.45, 1,1</KeyFrame>
                        <KeyFrame>0.5, 0.2,0.2</KeyFrame>
                        <KeyFrame>0.55, 1,1</KeyFrame>
                        <KeyFrame>0.6, 0.2,0.2</KeyFrame>
                        <KeyFrame>0.65, 1,1</KeyFrame>
                        <KeyFrame>0.7, 0.2,0.2</KeyFrame>
                        <KeyFrame>0.75, 0.75,0.75</KeyFrame>
                        <KeyFrame>0.8, 0.15,0.15</KeyFrame>
                        <KeyFrame>0.85, 0.5,0.5</KeyFrame>
                        <KeyFrame>0.9, 0.1,0.1</KeyFrame>
                        <KeyFrame>0.95, 0.25,0.25</KeyFrame>
                        <KeyFrame>1, 0.05,0.05</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">1.25</Set>
                    <Random name="initialVelocity" min="0, -25" max="0, -50"/>
                    <Random name="initialRotationRate" min="-60" max="60"/>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>
        <RenderOptions>
            <Default>
                <Set name="DefaultRenderMannequinHandItem">false</Set>
                <Set name="HideParticlesOnTransform">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="RenderBackArmBuild">false</Set>
                <Set name="RenderFrontArmInfected">true</Set>
                <Set name="RenderBackArmInfected">true</Set>
                <Set name="UserNameOffset">15</Set>
                <Set name="PunchSoundOverride">HAND</Set>
                <Set name="PlayDefaultPunchAudio">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="IgnoreDefaultDestroyedTileEffect">false</Set>
                <Set name="HasDeathParticles">true</Set>
                <Set name="HideAvatarOnDeath">true</Set>
                <Set name="HideAngelOnDeath">true</Set>
            </Default>
        </RenderOptions>
    </Data>
    <RenderRules>
        <OnDrawCustomOutline>
            <AvatarTransform class="Scale">
                <Set name="targetScale">getCurrent</Set>
            </AvatarTransform>
            <AvatarTransform class="RenderData">
                <Set name="saturation">3</Set>
                <Set name="brightness">1</Set>
                <Set name="contrast">0.1</Set>
            </AvatarTransform>
            <AvatarOutline duration="1500" startScale="1,1" endScale="1.1,1.1">
                <Colours>
                    <Colour>183,38,255,255</Colour>
                    <Colour>106,0,159,255</Colour>
                </Colours>
            </AvatarOutline>
            <AvatarTransform class="RenderData">
                <Set name="saturation">1</Set>
                <Set name="brightness">1</Set>
                <Set name="contrast">0.1</Set>
            </AvatarTransform>
            <AvatarTransform class="Scale">
                <Set name="targetScale">reset</Set>
            </AvatarTransform>
        </OnDrawCustomOutline>
        <Update>
            <StopIf>
                <IsZombified>true</IsZombified>
            </StopIf>
            <AvatarTransform class="ArmAngle" onState="MOYYVOW.Equip|MOYYVOW.Fall">
                <Set name="armName">arm1Angle</Set>
                <Set name="armAngle">215</Set>
            </AvatarTransform>
        </Update>
        <RenderBackHandItem>
            <StopIf type="and">
                <IsZombified>true</IsZombified>
                <IsAction>PUNCH</IsAction>
            </StopIf>
            <SpriteRender name="equip_sprite" offset="18, 13" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="MOYYVOW.Equip|MOYYVOW.Fall|MOYYVOW.Punch"/>
        </RenderBackHandItem>
        <RenderInFront>
            <StopIf>
                <IsZombified>true</IsZombified>
            </StopIf>
            <SpriteRender name="slash_sprite" offset="12,-20" scale="1.25,1.25" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="MOYYVOW.Punch" drawShadow="false" tintOverride="255,255,255,255"/>
        </RenderInFront>
        <AddClothingParticles>
            <ParticleSystemUpdate name="CPS" onAction="WALK|JUMP|FALL|SWIM"/>
            <ParticleSystemUpdate name="ps_mist" onAction="IDLE"/>
        </AddClothingParticles>
        <OnPunchStart>
            <StopIf>
                <IsZombified>true</IsZombified>
            </StopIf>
        </OnPunchStart>
        <OnPunchUpdate>
            <StopIf>
                <IsZombified>true</IsZombified>
            </StopIf>
            <AvatarTransform class="Face">
                <Set name="face">MAD</Set>
            </AvatarTransform>
            <AvatarTransform class="ArmAngle" onState="MOYYVOW.Equip|MOYYVOW.Fall">
                <Set name="armName">arm1Angle</Set>
                <Set name="armAngle">215</Set>
            </AvatarTransform>
            <AvatarTransform class="ArmAngle" onState="MOYYVOW.Punch">
                <Set name="armName">arm1Angle</Set>
                <Set name="armAngle">1200</Set>
                <Set name="isAdditive">true</Set>
                <Set name="pointTowardsPunchTarget">false</Set>
            </AvatarTransform>
            <AvatarTransform class="ArmAngle" onState="MOYYVOW.Punch">
                <Set name="armName">arm2Angle</Set>
                <Set name="armAngle">0</Set>
            </AvatarTransform>
        </OnPunchUpdate>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
  <!-- FOR ITEM LIKE THIS PLEASE DM VOW :) or @reeel. with dot on discord! -->
<!-- enderBbody0 -->
    <Sprite name="s_Pet" fileName="game/UGCSpritesheet73v0.rttex" textureSize="512" frame="0,0"/>
    <Sprite name="s_PetParts" fileName="game/UGCSpritesheet73v0.rttex" textureSize="512" frame="0,1"/>
<!-- enderEeff1 -->
    <Sprite name="s_raygun_smoke" fileName="game/UGCSpritesheet73v1.rttex" textureSize="256"/>
    <Sprite name="s_Hand" fileName="game/UGCSpritesheet73v1.rttex" textureSize="256" frame="0,1"/>
<!-- EnderArm2 -->
    <Sprite name="s_Punch" fileName="game/UGCSpritesheet73v2.rttex" textureSize="64" frame="0,0" />
<!-- diamond3 -->
    <Sprite name="s_feather" fileName="game/UGCSpritesheet73v3.rttex" textureSize="32" frame="0,0" />
    <Sprite name="s_fog" fileName="game/UGCSpritesheet73v3.rttex" textureSize="32" frame="0,0" />
    <Sprite name="respawnParticle" fileName="game/particles_large16.rttex" textureSize="64" frame="8,11" />
    <!-- <Sprite name="s_Punch" fileName="game/particles12" textureSize="32" frame="27,8" /> -->

    <Animations>
      <SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="800" isLoop="true" autoPlay="true" playOnState="Pet.Idle">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      
      <SpriteAnimation name="a_PetPartsIdle" sprite="s_PetParts" animTime="800" isLoop="true" playOnState="Pet.Idle">
        <Frame>0,1</Frame>
        <Frame>2,1</Frame>
        <Frame>1,1</Frame>
        <!-- <Frame>0,0</Frame> -->
      </SpriteAnimation>
      <SpriteAnimation name="a_PetPunch" sprite="s_Pet" animTime="800" isLoop="false" playOnState="Pet.Punch">
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetPartsPunch" sprite="s_PetParts" animTime="800" isLoop="true" playOnState="Pet.Punch">
        <!-- <Frame>1,0</Frame> -->
                <Frame>0,1</Frame>
        <Frame>2,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_feather" sprite="s_feather" animTime="100" isLoop="true" playOnState="Action.Move">
        <Frame>0,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fog" sprite="s_fog" animTime="100" isLoop="true" playOnState="Action.Move">
        <Frame>0,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_earth" sprite="s_raygun_smoke" animTime="800" isLoop="false">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <!-- <Frame>7,0</Frame>
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
        <Frame>4,1</Frame>
        <Frame>5,1</Frame>
        <Frame>6,1</Frame>
        <Frame>7,1</Frame>
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
        <Frame>4,2</Frame> -->
      </SpriteAnimation>

    </Animations>
    
    <StateMachines>
      <StateMachine name="Pet">
        <States>
          <State name="Idle" />
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition to="Punch" from="Idle">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Idle" from="Punch" >
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Move|Jump" >
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Jump|Fall|Idle" >
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall" >
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move" >
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>

    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_punch_projectile" updateStage="OnPunchStart" updateState="Pet.Punch">
  <Emitter>
    <Set name="offset">60,-15</Set>
    <Set name="emissionInterval">0.05</Set>
    <Set name="particlesPerEmission">1</Set>
    <Set name="infParticles">true</Set>
    <Set name="infLifeTime">true</Set>
    <Set name="renderAlignment">LEFT_CENTER</Set>
    
  </Emitter>
        <Particle>
          <Set name="sprite">s_Punch</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ALPHA</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">0</Set>
          <Set name="interpolateAlpha">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1.2, 0.6</KeyFrame>
            <KeyFrame>1, 9.6, 4.8</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.45</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />

          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>

          <RandomRadial name="initialVelocity" angleRange="-15,15" radiusRange="50,100" />
          <Set name="rotateWithVelocity">true</Set>
          <Set name="gravityVector">0,-20</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="flipX">false</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_raygun_smoke</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">MODULATE</Set>
          <!-- <Set name="initialAlpha">1</Set> -->
          <Set name="finalAlpha">0</Set>
          <Set name="interpolateAlpha">true</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0.5,1,1.5</KeyFrame>
            <KeyFrame>1,10,10</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_feather" updateStage="AddClothingParticles" updateState="Motion.Move">
        <Emitter>
          <Set name="offset">-17, -2</Set>
          <Set name="lifeTime">1</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_feather</Set>
          <Random name="offset" min="-15, -10" max="15, -5" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="initalRGB">1, 1, 1</Set>
          <Set name="finalAlpha">0</Set>
          <Set name="interpolateAlpha">true</Set>
          <Set name="useGravity">true</Set>
          <Set name="initialScale">1, 1</Set>
          <Set name="lifeTime">1.2</Set>
          <Curve name="initialVelocity">
            <KeyFrame>0.2, -20, 0</KeyFrame>
            <KeyFrame>0.4, 50, 0</KeyFrame>
            <KeyFrame>0.6, -50, 0</KeyFrame>
            <KeyFrame>0.8, 50, 0</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Curve name="initialAngle">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, -15</KeyFrame>
            <KeyFrame>0.4, 15</KeyFrame>
            <KeyFrame>0.6, -15</KeyFrame>
            <KeyFrame>0.8, 15</KeyFrame>
          </Curve>
          <Set name="gravityVector">0, 30</Set>
          <Set name="flipX">false</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_fogLocal" updateStage="AddClothingParticles" updateState="Motion.Idle">
        <Emitter>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">false</Set>
          <Set name="infLifeTime">false</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_fog</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-8, -8" max="8, -16" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.25</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="initalRGB">0.346503, 0.25668, 0.534314</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 2, 2</KeyFrame>
          </Curve>
          <Set name="lifeTime">1.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,30" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_fogWorld" updateStage="AddClothingParticles" updateState="Motion.Move">
        <Emitter>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_fog</Set>
          <Random name="offset" min="-12, 0" max="12, -24" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.25</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="initalRGB">0.303625, 0.221429, 0.47549</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1.25, 1.25</KeyFrame>
            <KeyFrame>1, 2, 2</KeyFrame>
          </Curve>
          <Set name="lifeTime">1.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,20" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="SpawnParticle">
        <Emitter>
          <Set name="offset">0, -500</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">respawnParticle</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 3, 3</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="SpawnParticleRabbits">
        <Emitter>
          <Set name="offset">0, -500</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Pet</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 3, 3</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="SpawnSparkle">
        <Emitter>
          <Set name="offset">0, -900</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_Punch</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Random name="offset" min="-24, -16" max="24, 16" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="1" max="1.5" />
          <Increment name="finalScale" source="initialScale" multiplier="2.5,2.5"/>
          <Set name="interpolateScale">true</Set>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        			<Set name="PlayDefaultPunchAudio">false</Set>
            <Set name="DefaultPunchSound">audio/droar.wav</Set>

        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">20,20</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="UsePetForceFaceTime">true</Set>
        			<Set name="PlayDefaultPunchAudio">true</Set>

      </Default>
    </RenderOptions>
  </Data>

    <RenderRules>
      <RenderPet>
        <SpriteRender name="s_PetParts" alignment="DOWN_CENTER" offset="-9,46" scale="0.30,0.30" onState="Pet.Punch"/>
        <SpriteRender name="s_PetParts" alignment="DOWN_CENTER" offset="1,43" scale="0.30,0.30" onState="Pet.Idle"/>
        <SpriteRender name="s_Pet" alignment="DOWN_CENTER" scale="0.25,0.25" offset="0,45"/>
        <SpriteRender name="s_PetParts" alignment="DOWN_CENTER" offset="-5,42" scale="0.30,0.30" onState="Pet.Idle"/>
        <!-- <SpriteRender name="s_PetParts" alignment="DOWN_CENTER" offset="-5,73" scale="0.30,0.30" onState="Pet.Punch"/> -->
        <SpriteRender name="s_PetParts" alignment="DOWN_CENTER" offset="-12,45" scale="0.30,0.30" onState="Pet.Punch"/>
        <ParticleSystemUpdate name="ps_punch_projectile" offset="90,-16" scale="1,0.5" onState="Pet.Punch" blend="PREMULTIPLIED_ALPHA" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" />
      </RenderPet>
    <RenderHandItem>
      <SpriteRender name="s_Hand" offset="5,8" rotationPoint="0,1" alignment="CENTER"  scale="0.1,0.1" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
      <ParticleSystemUpdate name="ps_feather" onState="Motion.Move" />
      <ParticleSystemUpdate name="ps_fogLocal" onState="Motion.Idle" />
      <ParticleSystemUpdate name="ps_fogWorld" onState="Motion.Move" />
    </RenderHandItem>
    <OnRespawned>
      <ParticleSystemUpdate name="SpawnParticle" />
      <ParticleSystemUpdate name="SpawnParticleRabbits" />
      <ParticleSystemUpdate name="SpawnSparkle" />
    </OnRespawned>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
    <Data>

        <!-- ========================================================== -->
        <!-- SPRITES -->
        <!-- ========================================================== -->
        <!-- idle0 -->
        <Sprite name="s_bow" fileName="game/UGCSpritesheet74v0.rttex" textureSize="144"/>
        <!-- effect1 -->
        <Sprite name="s_arrow" fileName="game/UGCSpritesheet74v1.rttex" textureSize="256" frame="1,2"/>
        <Sprite name="s_bow_effect" fileName="game/UGCSpritesheet74v1.rttex" textureSize="256"/>
        <Sprite name="s_tileArrow" fileName="game/UGCSpritesheet74v1.rttex" textureSize="256"/>
        
        
        <Sprite name="s_ember" fileName="game/particles11.rttex" textureSize="32"/>
        

        <!-- ========================================================== -->
        <!-- STATE MACHINES -->
        <!-- ========================================================== -->
        <StateMachines>
            <StateMachine name="Punch">
                <States>
                    <State name="True"/>
                    <State name="False"/>
                </States>

                <Transitions>
                    <Transition from="False" to="True">
                        <Condition type="and">
                            <IsAction>PUNCH</IsAction>
                            <IsZombified>false</IsZombified>
                        </Condition>
                    </Transition>

                    <Transition from="True" to="False">
                        <Condition>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>

        <!-- ========================================================== -->
        <!-- ANIMATIONS -->
        <!-- ========================================================== -->
        <Animations>

            <SpriteAnimation
                name="a_bow_idle"
                sprite="s_bow"
                animTime="700"
                isLoop="true"
                playOnState="Punch.False">

                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
                <Frame>0,2</Frame>
                <Frame>1,2</Frame>
            </SpriteAnimation>

            <SpriteAnimation
                name="a_bow_effect"
                sprite="s_bow_effect"
                animTime="200"
                autoPlay="true"
                playOnAction="PUNCH"
                isLoop="true">

                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="a_ember" sprite="s_ember">
                <Frame>5,26</Frame>
                <Frame>6,26</Frame>
            </SpriteAnimation>

            <SpriteAnimation
                name="a_tileArrow"
                sprite="s_tileArrow"
                animTime="500">

                <Frame>0,2</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
            </SpriteAnimation>

        </Animations>

        <!-- ========================================================== -->
        <!-- VARIABLES -->
        <!-- ========================================================== -->
        <VariableMap>
            <Set name="projectile_offset">0, 0</Set>
            <Set name="projectile_angle">0</Set>
        </VariableMap>

        <!-- ========================================================== -->
        <!-- PARTICLE SYSTEMS -->
        <!-- ========================================================== -->
        <ParticleSystems>

            <!-- Projectile -->
            <ParticleSystem
                name="ps_punchProjectile"
                updateStage="RenderBackHandItem"
                updateState="Punch.True">

                <Emitter attachment="handspotRoot">
                    <Set name="offset">-3, 0</Set>
                    <Set name="lifeTime">0.3</Set>
                    <Set name="emissionInterval">0.05</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>

                <Particle randomSpriteFrame="true">
                    <Set name="sprite">s_arrow</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="lifeTime">0.2</Set>
                    <Set name="initialScale">0.4,0.4</Set>

                    <Random
                        name="targetPosOffset"
                        min="-12,-11"
                        max="12,11"/>

                    <VectorTo
                        name="initialVelocity"
                        source="targetPos"
                        offset="targetPosOffset"
                        duration="lifeTime"
                        x="1"
                        angleOutVar="projectile_angle"/>

                    <Set name="rotateWithVelocity">true</Set>
                    <SetVar name="projectile_offset" source="targetPosOffset"/>
                </Particle>
            </ParticleSystem>

            <!-- Tile Arrow -->
            <ParticleSystem name="ps_tileArrow">

                <Emitter>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>

                <Particle>
                    <Set name="sprite">s_tileArrow</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">0.5</Set>
                    <Set name="initialScale">0.4,0.4</Set>
                    <Set name="offset" source="projectile_offset"/>
                    <Set name="initialAngle" source="projectile_angle"/>
                </Particle>

            </ParticleSystem>

            <!-- Hit Embers -->
            <ParticleSystem name="ps_hitEmbers">

                <Emitter>
                    <Set name="lifeTime">0.25</Set>
                    <Set name="particlesPerEmission">8</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>

                <Particle randomSpriteFrame="true">

                    <Set name="sprite">s_ember</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="lifeTime">1</Set>

                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>

                    <Curve name="initialScale">
                        <KeyFrame>0, 1,1</KeyFrame>
                        <KeyFrame>1, 0.25,0.25</KeyFrame>
                    </Curve>

                    <Random name="initialRotationRate" min="5" max="15"/>
                    <Random name="offset" min="-4,-3" max="4,3"/>

                    <Set name="useGravity">true</Set>
                    <Set name="gravityVector">0, 100</Set>

                    <RandomRadial
                        name="initialVelocity"
                        angleRange="45,315"
                        radiusRange="80,200"/>

                </Particle>

            </ParticleSystem>

            <!-- Destroy Embers -->
            <ParticleSystem name="ps_destroyEmbers">

                <Emitter>
                    <Set name="lifeTime">0.25</Set>
                    <Set name="particlesPerEmission">16</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>

                <Particle randomSpriteFrame="true">

                    <Set name="sprite">s_ember</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="lifeTime">1</Set>

                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>

                    <Curve name="initialScale">
                        <KeyFrame>0, 1,1</KeyFrame>
                        <KeyFrame>1, 0.25,0.25</KeyFrame>
                    </Curve>

                    <Random name="initialRotationRate" min="5" max="15"/>
                    <Random name="offset" min="-4,-3" max="4,3"/>

                    <Set name="useGravity">true</Set>
                    <Set name="gravityVector">0, 100</Set>

                    <RandomRadial
                        name="initialVelocity"
                        angleRange="45,315"
                        radiusRange="80,200"/>

                </Particle>

            </ParticleSystem>

        </ParticleSystems>

        <!-- ========================================================== -->
        <!-- RENDER OPTIONS -->
        <!-- ========================================================== -->
        <RenderOptions>

            <Default>
                <Set name="PunchSoundOverride">HAND</Set>
                <Set name="PlayDefaultPunchAudio">false</Set>
                <Set name="DefaultRenderMannequinHandItem">false</Set>
                <Set name="RenderFrontArmInfected">true</Set>
                <Set name="RenderBackArmInfected">true</Set>
                <Set name="RenderBackArmBuild">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="IncludeAllActions">true</Set>
                <Set name="HideParticlesOnTransform">true</Set>

                <Set name="DefaultPunchSound">audio/gauntlet_spawn.wav</Set>
                <Set name="PlayDefaultPunchAudio">true</Set>
            </Default>

        </RenderOptions>

    </Data>

    <!-- ========================================================== -->
    <!-- RENDER RULES -->
    <!-- ========================================================== -->
    <RenderRules>

        <RenderInFront>
        </RenderInFront>

        <RenderBackHandItem>

            <StopIf>
                <IsAction>BUILD</IsAction>
            </StopIf>

            <StopIf type="and">
                <IsZombified>true</IsZombified>
                <IsAction>PUNCH</IsAction>
            </StopIf>

            <SpriteRender
                name="s_bow"
                offset="-4,6"
                rotationPoint="0,1"
                alignment="CENTER"
                rotateOffset="true"
                drawShadow="false"
                blend="PREMULTIPLIED_ALPHA"
                scale="0.4,0.4"/>

            <SpriteRender
                name="s_bow_effect"
                offset="-5,-7"
                alignment="CENTER"
                rotateOffset="true"
                rotateToTarget="true"
                drawShadow="false"
                blend="PREMULTIPLIED_ALPHA"
                scale="0.4,0.4"
                onAction="PUNCH"/>

        </RenderBackHandItem>

        <OnPunchUpdate>

            <AvatarTransform class="Face">
                <Set name="face">MAD</Set>
            </AvatarTransform>

            <AvatarTransform class="ArmAngle">
                <Set name="armName">arm1Angle</Set>
                <Set name="pointTowardsPunchTarget">true</Set>
            </AvatarTransform>

            <AvatarTransform class="ArmAngle">
                <Set name="armName">arm2Angle</Set>
                <Set name="armAngle">1500</Set>
                <Set name="isAdditive">true</Set>
            </AvatarTransform>

        </OnPunchUpdate>

        <OnDamagedTile>

            <StopIf type="or">
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
                <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
            </StopIf>

            <ParticleSystemUpdate name="ps_tileArrow"/>
            <ParticleSystemUpdate name="ps_hitEmbers"/>

        </OnDamagedTile>

        <OnDestroyedTile>

            <StopIf type="or">
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
                <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
            </StopIf>

            <ParticleSystemUpdate name="ps_destroyEmbers"/>

        </OnDestroyedTile>

    </RenderRules>

</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_SERAPHIC_WINGS">
	<Data>
		<StateMachines>
			<StateMachine name="playerState">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Fall"/>
					<State name="Jump"/>
					<State name="DoubleJump"/>
					<State name="SpiritGuide"/>
				</States>
				<Transitions>
					<Transition from="SpiritGuide|Jump|Fall|Move|DoubleJump" to="Idle" >
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Jump|Fall|Idle|DoubleJump" to="Move">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>WALK</IsAction>
						</Condition>
					</Transition>				
					<Transition from="Move|Jump|Fall|Idle|DoubleJump" to="SpiritGuide">
						<Condition type="and">
							<IsWearing slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0</IsVariableFloat>
							<IsAction operatorType="NotEqual">FALL</IsAction>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Fall|Move|Idle" to="Jump">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition from="Jump|Fall" to="DoubleJump">
						<Condition>
							<IsAction>JUMPDOUBLE</IsAction>
						</Condition>
					</Transition>
					<Transition from="DoubleJump|SpiritGuide|Jump|Idle|Move" to="Fall">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater" abs="false">0.01</IsVariableFloat>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="wing" fileName="game/UGCSpritesheet75v0.rttex" textureSize="112" frame="0,0"/>
		<Sprite name="jumpeffect" fileName="game/UGCSpritesheet75v0.rttex" textureSize="112" frame="6,0"/>

		<Animations>
			<SpriteAnimation name="wing_Idle" playOnState="playerState.Idle|playerState.SpiritGuide|playerState.Move" sprite="wing" isLoop="true" animTime="900">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			
			<SpriteAnimation name="wing_DoubleJ" playOnState="playerState.DoubleJump" sprite="wing" isLoop="false" animTime="800">
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>		

      		<SpriteAnimation name="wing_Fall" playOnState="playerState.Fall" sprite="wing" isLoop="false" animTime="300">
        		<Frame>5,0</Frame>
			</SpriteAnimation>		
		
			<SpriteAnimation name="wing_Jump" playOnState="playerState.Jump" sprite="wing" isLoop="true" animTime="900">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>

		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="double_jump_particle">
				<Emitter>
          			<Set name="offset">0,47</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="infParticles">true</Set>
          			<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">jumpeffect</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="rotateWithVelocity">false</Set>
          			<Set name="interpolateScale">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialScale">1,1</Set>
          			<Set name="finalScale">1.3, 1.3</Set>
          			<Set name="initialVelocity">2,2</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<OnDrawCustomOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">getCurrent</Set>
        <Set name="brightness">getCurrent</Set>
        <Set name="contrast">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="RenderData">
        <Set name="saturation">3</Set>
        <Set name="brightness">1</Set>
        <Set name="contrast">0.1</Set>
      </AvatarTransform>
      <AvatarOutline duration="2000" startScale="0.9,0.9" endScale="1.1,1.1">
		<Colours>
          <Colour>92,92,94,225</Colour>
          <Colour>0,0,0,225</Colour>
        </Colours>
      </AvatarOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">reset</Set>
        <Set name="brightness">reset</Set>
        <Set name="contrast">reset</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">reset</Set>
      </AvatarTransform>
    </OnDrawCustomOutline>
		<RenderBackpack>
			<SpriteRender name="wing" offset="4,-23" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
			<SpriteRender name="wing" offset="-4,-23" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
		</RenderBackpack>
		<ParticleSystemRender>
			<ParticleSystemRenderer name="drop_particles" onAction="MOVE|IDLE" drawShadow="false"/>
			<ParticleSystemRenderer name="double_jump_particle" onAction="JUMPDOUBLE" drawShadow="false"/>
		</ParticleSystemRender>



		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<AddClothingParticles>
			<ParticleSystemUpdate name="double_jump_particle" onAction="JUMPDOUBLE" drawShadow="false"/>
		</AddClothingParticles>
    
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="double_jump_particle"/>
		</SwitchOffClothingParticles>

	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
	<!-- sword0 -->
		<Sprite name="s_scythe" fileName="game/UGCSpritesheet76v0.rttex" textureSize="208"/>
<!-- punch1 -->
		<Sprite name="s_punch_eff" fileName="game/UGCSpritesheet76v1.rttex" textureSize="336"/>
		<Sprite name="s_DestroyImpact" fileName="game/UGCSpritesheet76v1.rttex" textureSize="336"/>
<!-- partcle2 -->
		<Sprite name="s_punchCurve" fileName="game/UGCSpritesheet76v2.rttex" textureSize="32"/>
		<Sprite name="s_breakflame" fileName="game/UGCSpritesheet76v2.rttex" textureSize="32"/>

		<Sprite name="s_sparkle" fileName="game/particles9.rttex" textureSize="32"/>
		<Animations>
			<SpriteAnimation name="a_Attack_particle" sprite="s_punchCurve" animTime="700" isLoop="true">
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_punch" sprite="s_punch_eff" animTime="400" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="s_breakflame" animTime="300" >
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakesHit" sprite="s_DestroyImpact" animTime="400" >
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Sparkles" sprite="s_sparkle" animTime="300" autoPlay="true" isLoop="true">
				<Frame>8,8</Frame>
				<Frame>9,8</Frame>
				<Frame>10,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_scythe" animTime="1000" isLoop="true" autoPlay="true" >
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="45, 0, 0, 1" animTime="2000" playOnState="Punch.False"/>
		</Animations>
			<ParticleSystems>
				<ParticleSystem name="ps_SparklesTrail" updateState="Motion.Move" updateStage="AddClothingParticles" renderStage="RenderInFront">
					<Emitter>
						<Set name="offset">0,0</Set>
						<Set name="offsetFacing">true</Set>
						<Set name="emissionInterval">0.1</Set>
						<Set name="infParticles">true</Set>
						<Set name="infLifeTime">true</Set>
						<Set name="particlesPerEmission">2</Set>
						<Set name="particlesToEmit">2</Set>
					</Emitter>
					<Particle>
						<Set name="sprite">s_sparkle</Set>
						<Random name="offset" min="-28, -16" max="28, 0" />
						<Set name="inSpecificOrder">true</Set>
						<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
						<Curve name="initialAlpha">
							<KeyFrame>0, 1</KeyFrame>
							<KeyFrame>0.8, 1</KeyFrame>
							<KeyFrame>1, 0</KeyFrame>
						</Curve>

						<Select name="lifeTime" input="randomNumber">
							<Item>0.3</Item>
							<Item>0.6</Item>
						</Select>
						<Random name="initialScale" min="0.5" max="0.8" />
						<Random name="initialAngle" min="0" max="360" />
					</Particle>
				</ParticleSystem>

				<ParticleSystem name="ps_breakflame" updateStage="OnDamagedTile">
					<Emitter>
						<Set name="particlesPerEmission">1</Set>
						<Set name="offset">0,0</Set>
						<Set name="emissionInterval">0.5</Set>
						<Set name="infParticles">true</Set>
						<Set name="particlesPerEmission">1</Set>
					</Emitter>
					<Particle>
						<Set name="sprite">s_breakflame</Set>
						<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
						<Curve name="initialScale">
							<KeyFrame>0, 1,1</KeyFrame>
							<KeyFrame>1, 1,1</KeyFrame>
						</Curve>
						<Curve name="initialAlpha">
							<KeyFrame>0, 1</KeyFrame>
							<KeyFrame>0.65, 1</KeyFrame>
							<KeyFrame>1, 0</KeyFrame>
						</Curve>
						<Set name="lifeTime">0.3</Set>
						<Random name="initialAngle" min="0" max="0" />
					</Particle>
				</ParticleSystem>
				<ParticleSystem name="ps_destroyImpact">
					<Emitter>
						<Set name="particlesPerEmission">1</Set>
					</Emitter>
					<Particle>
						<Set name="sprite">s_DestroyImpact</Set>
						<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
						<Set name="lifeTime">0.3</Set>
						<Random name="initialAngle" min="0" max="0" />
						<Curve name="initialScale">
							<KeyFrame>0, 1,1</KeyFrame>
							<KeyFrame>1, 1,1</KeyFrame>
						</Curve>
					</Particle>
				</ParticleSystem>
				<ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
				<Emitter attachment="contextRotation">"
					<Set name="offset">0,-18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punchCurve</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="initialScale">0.8,0.8</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="UserNameOffset">0</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
            <Set name="DefaultPunchSound">audio/metalwingz.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
		<TileStampData>
			<Set name="FileName">game/UGCSpritesheet76v2.rttex</Set>
			<Set name="EndFrame">3,0</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
	</Data>
	<RenderRules>
		<Update>
		</Update>
		<RenderInFront>
			<SpriteRender name="s_punch_eff" offset="10,-20" alignment="CENTER" rotateOffset="true" rotateToTarget="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="0.8,0.8" onAction="PUNCH" />
		</RenderInFront>
		<RenderBehind>
			<StopIf >
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<Group>
				<Rotate>Sword_rotation</Rotate>
				<SpriteRender name="s_scythe" offset="7,5" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="0.5,0.5" />
			</Group>
		</RenderBehind>
		<RenderBackHandItem>
				<SpriteRender name="s_scythe" offset="33,3" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="0.5,0.5" onAction="PUNCH" />
		</RenderBackHandItem>
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
	<StateMachines>
		<StateMachine name="playerState">
			<States>
				<State name="Idle"/>
				<State name="Punch"/>
				<State name="ZombiePunch"/>
			</States>
			<Transitions>
				<Transition from="ZombiePunch|Punch" to="Idle" >
					<Condition>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition from="ZombiePunch|Idle" to="Punch">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
						<IsZombified>false</IsZombified>
					</Condition>
				</Transition>
				<Transition from="Idle|Punch" to="ZombiePunch">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
						<IsZombified>true</IsZombified>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
	</StateMachines>
	<Sprite name="item_Sprite_1" fileName="game/UGCSpritesheet78v0.rttex" textureSize="64" frame="0,0"/>
	<Sprite name="item_Slash" fileName="game/UGCSpritesheet78v0.rttex" textureSize="64" frame="0,1"/>
	<Animations>

		<SpriteAnimation name="wingFlexJump2" playOnAction="JUMP|FALL|IDLE|WALK" sprite="item_Sprite_1" animTime="6000" autoPlay="true" isLoop="true">
			<Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
			<Frame>5,0</Frame>
			<Frame>6,0</Frame>
			<Frame>7,0</Frame>
			<Frame>8,0</Frame>
			<Frame>9,0</Frame>
			<Frame>10,0</Frame>
			<Frame>11,0</Frame>
			<Frame>12,0</Frame>
			<Frame>13,0</Frame>
			<Frame>14,0</Frame>
			<Frame>14,0</Frame>
			<Frame>13,0</Frame>
			<Frame>12,0</Frame>
			<Frame>11,0</Frame>
			<Frame>10,0</Frame>
			<Frame>9,0</Frame>
			<Frame>8,0</Frame>
			<Frame>7,0</Frame>
			<Frame>6,0</Frame>
			<Frame>5,0</Frame>
			<Frame>4,0</Frame>
			<Frame>3,0</Frame>
			<Frame>2,0</Frame>
		</SpriteAnimation>
    </Animations>
	<ParticleSystems>
		<ParticleSystem name="yellow_slash_particle">
			<Emitter>
				<Set name="offset">0,-18</Set>
				<Set name="emissionInterval">0.25</Set>
				<Set name="lifeTime">0.25</Set>
				<Set name="particlesPerEmission">1</Set>
				<Set name="particlesToEmit">1</Set>
			</Emitter>
			<Particle>
				<Set name="sprite">item_Slash</Set>
				<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				<Set name="lifeTime">0.4</Set>
				<Set name="rotateWithVelocity">true</Set>
				<Set name="interpolateAlpha">false</Set>
				<Set name="initialAlpha">1</Set>
				<Set name="finalAlpha">1</Set>
				<Set name="interpolateVelocity">true</Set>
				<Set name="initialScale">2,2</Set>
				<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
			</Particle>
		</ParticleSystem>
	</ParticleSystems>

  <RenderRules>
    <RenderHandItem>
	  <SpriteRender name="item_Sprite_1" rotateOffset="true" offset="18,4" alignment="CENTER"/>
    </RenderHandItem>
	<OnPunchUpdate>
		<Set name="DefaultPunchSound">audio/droar.wav</Set>
		<Set name="PlayDefaultPunchAudio">true</Set>
		<AvatarTransform class="Face">
			<Set name="face">MAD</Set>
		</AvatarTransform>
		<AvatarTransform class="ArmAngle">
			<Set name="armName">arm2Angle</Set>
			<Set name="armAngle">800</Set>
			<Set name="isAdditive">true</Set>
			<Set name="pointTowardsPunchTarget">false</Set>
		</AvatarTransform>
	</OnPunchUpdate>
	<OnPunchStart>
		<ParticleSystemUpdate name="yellow_slash_particle"/>
	</OnPunchStart>
	<SwitchOffClothingParticles>
		<ParticleSystemOff name="yellow_slash_particle"/>
	</SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Move|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="s_Pet_head" fileName="game/UGCSpritesheet79v0.rttex" textureSize="64" frame="0,1" />
		<Sprite name="s_Pet_back" fileName="game/UGCSpritesheet79v0.rttex" textureSize="64" frame="0,0" />
		<Sprite name="p_Pet_head" fileName="game/UGCSpritesheet79v0.rttex" textureSize="64" frame="1,1" />
		<Sprite name="p_Pet_back" fileName="game/UGCSpritesheet79v0.rttex" textureSize="64" frame="12,19" />
		<!-- ic1 -->
		<Sprite name="hanS" fileName="game/UGCSpritesheet79v1.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_fire" fileName="game/UGCSpritesheet79v1.rttex" textureSize="32" frame="1,0" />

		<Animations>
			<SpriteAnimation name="a_dragon_punch_head" sprite="p_Pet_head" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>1,1</Frame>
				<Frame>3,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_punch_back" sprite="p_Pet_back" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>0,1</Frame>
				<Frame>2,1</Frame>
				<Frame>4,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_head" sprite="s_Pet_head" animTime="1000" isLoop="true"
				playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>1,0</Frame>
				<Frame>3,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_back" sprite="s_Pet_back" animTime="1000" isLoop="true"
				playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>0,0</Frame>
				<Frame>2,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_eletric" sprite="hand_eletric" animTime="500" isLoop="true"
				playOnAction="IDLE|PUNCH|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>1,42</Frame>
				<Frame>2,42</Frame>
				<Frame>3,42</Frame>
			</SpriteAnimation>
		</Animations>

		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">17,23</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>

		<ParticleSystems>
			<ParticleSystem name="ps_punchProjectile" updateStage="RenderPet"
				updateState="Motion.Punch">
				<Emitter usePlayerFacing="true">
					<Random name="emissionInterval" min="0.002" max="0.004" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
					<Set name="offset">16,-19</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_fire</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="finalScale">2,2</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Random name="targetPosOffset" min="-3, -13" max="3, 13" />
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset"
						duration="lifeTime" x="1" />
					<Set name="rotateWithVelocity">true</Set>
					<OnFinish>
						<ParticleSystemName>ps_punchSmoke</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchSmoke">
				<Emitter>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="delay">-0.25</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_fire</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="offset" min="-8, -8" max="8, 8" />
					<Set name="initialAngle">180</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.6, 0.6</KeyFrame>
						<KeyFrame>1, 0.05, 0.05</KeyFrame>
					</Curve>
					<Set name="rotateWithVelocity">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,80" />
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem> 
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderBackArmBuild">false</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderHandItem>
			<SpriteRender name="hanS" offset="0,16" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
		</RenderHandItem>
        
		<OnPunchUpdate>
			<AvatarTransform class="Emotion">
				<Set name="emotion">ANGRY</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderPet>
			<SpriteRender name="p_Pet_head" alignment="DOWN_CENTER" onAction="PUNCH" offset="0,10" />
			<SpriteRender name="p_Pet_back" alignment="DOWN_CENTER" onAction="PUNCH"
				offset="-63.5,10" />
			<SpriteRender name="s_Pet_head" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="0,10" />
			<SpriteRender name="s_Pet_back" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="-63.5,10" />
		</RenderPet>
	</RenderRules>
</ItemRenderer>
    <?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_DRAGON_FRUIT_DRAGON_WINGS">
	<Data>
		<StateMachines>
			<StateMachine name="playerState">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Fall"/>
					<State name="Jump"/>
					<State name="DoubleJump"/>
					<State name="SpiritGuide"/>
				</States>
				<Transitions>
					<Transition from="SpiritGuide|Jump|Fall|Move|DoubleJump" to="Idle" >
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Jump|Fall|Idle|DoubleJump" to="Move">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>WALK</IsAction>
						</Condition>
					</Transition>				
					<Transition from="Move|Jump|Fall|Idle|DoubleJump" to="SpiritGuide">
						<Condition type="and">
							<IsWearing slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0</IsVariableFloat>
							<IsAction operatorType="NotEqual">FALL</IsAction>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Fall|Move|Idle" to="Jump">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition from="Jump|Fall" to="DoubleJump">
						<Condition>
							<IsAction>JUMPDOUBLE</IsAction>
						</Condition>
					</Transition>
					<Transition from="DoubleJump|SpiritGuide|Jump|Idle|Move" to="Fall">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater" abs="false">0.01</IsVariableFloat>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
            <StateMachine name="Motion">
                <States>
                  <State name="IdleDelay" />
                  <State name="Idle" />
                  <State name="Move" />
                </States>
                <Transitions>
                  <Transition to="IdleDelay" from="Move">
                    <Condition>
                      <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                    </Condition>
                  </Transition>
                  <Transition to="Idle" from="IdleDelay">
                    <Condition>
                      <IsAnimationFinished>idle_delay_anim</IsAnimationFinished>
                    </Condition>
                  </Transition>
                  <Transition to="Move" from="Idle">
                    <Condition>
                      <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                    </Condition>
                  </Transition>
                </Transitions>
              </StateMachine>
		</StateMachines>

		<Sprite name="holw" fileName="game/UGCSpritesheet8v0.rttex" textureSize="150,125"/>
        <Sprite name="s_mist" fileName="game/UGCSpritesheet8v1.rttex" textureSize="64" frame="5,8"/>
        <Sprite name="s_sparkle" fileName="game/UGCSpritesheet8v2.rttex" textureSize="32" frame="20,14"/>
        <Sprite name="s_jump_prop1" fileName="game/UGCSpritesheet8v2.rttex" textureSize="32" frame="1,9"/>
		<Animations>
      <SpriteAnimation name="idle_delay_anim" playOnState="Motion.IdleDelay" sprite="holw" isLoop="false" animTime="1200">
  <Frame>0,0</Frame>
  </SpriteAnimation>
      <SpriteAnimation name="a_Sparkles" sprite="s_sparkle" playOnState="playerState.Move" animTime="800" autoPlay="true">
        <Frame>20,14</Frame>
        <Frame>21,14</Frame>
        <Frame>22,14</Frame>
        <Frame>23,14</Frame>
        <Frame>24,14</Frame>
      </SpriteAnimation>
			<SpriteAnimation name="wing_Idle" playOnState="playerState.Idle|playerState.SpiritGuide|playerState.Move" sprite="holw" isLoop="true" animTime="1200">
				<Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>0,2</Frame>
                <Frame>1,2</Frame>
                <Frame>2,2</Frame>
                <Frame>0,3</Frame>
                <Frame>1,3</Frame>
                <Frame>2,3</Frame>
			</SpriteAnimation>
            <SpriteAnimation name="wing_jump" playOnState="playerState.Jump" sprite="holw" isLoop="true" animTime="600">
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
			</SpriteAnimation>
            <SpriteAnimation name="wing_fall" playOnState="playerState.Fall" sprite="holw" isLoop="true" animTime="800">
                <Frame>0,3</Frame>
                <Frame>1,3</Frame>
                <Frame>2,3</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
      <ParticleSystem name="ps_jump_prop1_left" updateStage="AddClothingParticles" updateState="playerState.Jump">
        <Emitter>
        <Set name="offset">0, 15</Set>
        <Random name="emissionInterval" min="5" max="5" />		
        <Set name="infParticles">true</Set>
        <Set name="infLifeTime">true</Set>
        <Set name="particlesPerEmission">1</Set>
      </Emitter>
      <Particle>
        <Set name="sprite">s_jump_prop1</Set>

        <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
        <Curve name="initialAlpha">
          <KeyFrame>0, 1</KeyFrame>
          <KeyFrame>0.5, 1</KeyFrame>
          <KeyFrame>1, 0</KeyFrame>
        </Curve>
        <Curve name="initialScale">
                  <KeyFrame>0, 0,0</KeyFrame>
                  <KeyFrame>1, 2.5,2.5</KeyFrame>
                </Curve>
        <Set name="lifeTime">1</Set>
        <Random name="initialVelocity" min="-15, 10" max="-15, 10" />
      </Particle>
    </ParticleSystem>
    <ParticleSystem name="ps_jump_prop1_right" updateStage="AddClothingParticles" updateState="playerState.Jump">
      <Emitter>
      <Set name="offset">0, 15</Set>
      <Random name="emissionInterval" min="5" max="5" />					
      <Set name="infParticles">true</Set>
      <Set name="infLifeTime">true</Set>
      <Set name="particlesPerEmission">1</Set>
    </Emitter>
    <Particle>
      <Set name="sprite">s_jump_prop1</Set>

      <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
      <Curve name="initialAlpha">
        <KeyFrame>0, 1</KeyFrame>
        <KeyFrame>0.5, 1</KeyFrame>
        <KeyFrame>1, 0</KeyFrame>
      </Curve>
      <Curve name="initialScale">
                <KeyFrame>0, 0,0</KeyFrame>
                <KeyFrame>1, 2.5,2.5</KeyFrame>
              </Curve>
      <Set name="lifeTime">1</Set>
      <Set name="flipX">true</Set>
      <Random name="initialVelocity" min="15, 10" max="15, 10" />
    </Particle>
  </ParticleSystem>
      <ParticleSystem name="ps_SparklesTrail">
        <Emitter>
          <Random name="offset" min="-5, -10" max="-5, -5"/>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
	      <Set name="lifeTime">0.8</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_sparkle</Set>
          <Random name="offset" min="-8, -4" max="8, 0" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="initalRGB">1, 0.4, 0.2</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.3" max="0.5" />
          <Select name="initialRotationRate" input="randomNumber">
	          <Item>90</Item>
	          <Item>-90</Item>
          </Select>
          <Set name="useGravity">true</Set>
          <Curve name="initialVelocity">
	          <KeyFrame>0, -30</KeyFrame>
	          <KeyFrame>0.2, -20, -30</KeyFrame>
	          <KeyFrame>0.4, 50, -30</KeyFrame>
	          <KeyFrame>0.6, -50, -30</KeyFrame>
	          <KeyFrame>0.8, 50, -30</KeyFrame>
	          <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Set name="gravityVector">0, 50</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
            <ParticleSystem name="ps_swordMist">
                <Emitter>
                    <Set name="offset">0,-30</Set>
                    <Random name="emissionInterval" min="3" max="3" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">s_mist</Set>
                    <Set name="initalRGB">1, 0.7, 0</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="lifeTime">3</Set>
                    <Set name="initialVelocity">0,-3</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Curve name="initialAlpha">
                    <KeyFrame>0, 0</KeyFrame>
                    <KeyFrame>0.5, 1</KeyFrame>
                    <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Curve name="initialScale">
                        <KeyFrame>0, 0.5, 0.5</KeyFrame>
                        <KeyFrame>1, 2, 2</KeyFrame>
                        </Curve>
                        <Set name="initialRotationRate">200</Set>
                </Particle>
                </ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
        <OnDrawCustomOutline>
            <AvatarTransform class="RenderData">
              <Set name="saturation">getCurrent</Set>
              <Set name="brightness">getCurrent</Set>
              <Set name="contrast">getCurrent</Set>
            </AvatarTransform>
            <AvatarTransform class="Scale">
              <Set name="targetScale">getCurrent</Set>
            </AvatarTransform>
            <AvatarTransform class="RenderData">
              <Set name="saturation">10</Set>
              <Set name="brightness">1</Set>
              <Set name="contrast">1</Set>
            </AvatarTransform>
            <AvatarOutline duration="1500" startScale="1,1" endScale="1.1,1.1">
                    <Colours>
                <Colour>255,255,0,255</Colour>
                <Colour>200,255,0,255</Colour>
                <Colour>255,200,0,255</Colour>
              </Colours>
            </AvatarOutline>
            <AvatarTransform class="RenderData">
              <Set name="saturation">1</Set>
              <Set name="brightness">10</Set>
              <Set name="contrast">1</Set>
            </AvatarTransform>
            <AvatarOutline duration="1500" startScale="1,1" endScale="1.05,1.05">
                    <Colours>
                <Colour>255,255,255,255</Colour>
              </Colours>
            </AvatarOutline>
            <AvatarTransform class="RenderData">
              <Set name="saturation">reset</Set>
              <Set name="brightness">reset</Set>
              <Set name="contrast">reset</Set>
            </AvatarTransform>
            <AvatarTransform class="Scale">
              <Set name="targetScale">reset</Set>
            </AvatarTransform>
          </OnDrawCustomOutline>
          <AddClothingParticles>
            <ParticleSystemUpdate name="ps_swordMist" onState="Motion.Idle"/>
            <ParticleSystemUpdate name="ps_SparklesTrail" onState="playerState.Move"/>
          </AddClothingParticles>
		<RenderBackpack>
            <ParticleSystemRender name="ps_swordMist"/>
            <ParticleSystemRender name="ps_SparklesTrail"/>
			<SpriteRender name="holw" offset="0,-30"/>
		</RenderBackpack>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
	<!-- complete0 -->
		<Sprite name="vowIdle" fileName="game/UGCSpritesheet80v0.rttex" textureSize="256"/>
		<Sprite name="vowPunch" fileName="game/UGCSpritesheet80v0.rttex" textureSize="256"/>
		<!-- anim1 -->
		<Sprite name="vowDance" fileName="game/UGCSpritesheet80v1.rttex" textureSize="256"/>
		<Sprite name="vowRes" fileName="game/UGCSpritesheet80v1.rttex" textureSize="256"/>
		<Sprite name="vowSleep" fileName="game/UGCSpritesheet80v1.rttex" textureSize="256"/>
		<!-- <Sprite name="luffyIdle" fileName="game/UGCSpritesheet80v0.rttex" textureSize="256"/> -->

<!-- roule2 -->
		<Sprite name="vowRoul" fileName="game/UGCSpritesheet80v2.rttex" textureSize="256"/>
		
		<!-- chip3 -->
		<Sprite name="vowBubble" fileName="game/UGCSpritesheet80v3.rttex" textureSize="128" frame="0,0"/>
		<Sprite name="vowTile" fileName="game/UGCSpritesheet80v3.rttex" textureSize="128" frame="0,0"/>
		<Sprite name="vowBreak" fileName="game/UGCSpritesheet80v3.rttex" textureSize="128" />
		<!-- <Sprite name="vowBreak" fileName="game/vowBreak" textureSize="128" /> -->

		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Dance"/>
				<State name="Sleep"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|Sleep" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|Sleep">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Sleep" from="Idle|Move|Fall|Jump|Punch|Dance">
					<Condition>
					<IsAction>SLEEP</IsAction>
					</Condition>
				</Transition>
				<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
					<Condition>
						<IsAction>DANCE</IsAction>
						<IsAction>DANCE_DAB</IsAction>
						<IsAction>DANCE_FLOSS</IsAction>
						<IsAction>DANCE_MARCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		<StateMachine name="IsDying">
			<States>
				<State name="False" />
				<State name="True" />
			</States>
			<Transitions>
				<Transition from="False" to="True">
					<Condition>
						<IsAction>DIE</IsAction>
					</Condition>
				</Transition>
				<Transition from="True" to="False">
					<Condition>
						<IsAction operatorType="NotEqual">DIE</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

		</StateMachines>
	<Animations>
					<SpriteAnimation name="a_gambler_Bubble" sprite="vowBreak" animTime="300" isLoop="true">
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_buddha_earth" sprite="vowRoul" animTime="800" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gambler_Bubble" sprite="vowBubble" animTime="300" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
		<SpriteAnimation name="luffy_sleep_animation" sprite="vowSleep" animTime="2000" isLoop="true" playOnState="Motion.Sleep">
			<Frame>0,1</Frame>
			<Frame>1,1</Frame> 
			<Frame>2,1</Frame>
			<Frame>1,1</Frame> 
		</SpriteAnimation>
		<SpriteAnimation name="luffy_Dance_Animation" playOnState="Motion.Dance" sprite="vowDance" animTime="1500" isLoop="true">
			<Frame>0,4</Frame>
			<Frame>1,4</Frame>
			<Frame>2,4</Frame>
			<Frame>3,4</Frame>
			<Frame>4,4</Frame>
			<Frame>5,4</Frame>
			<Frame>6,4</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="a_hit_particle" sprite="vowTile" animTime="700" isLoop="false">
			<Frame>0,1</Frame>
		</SpriteAnimation>
		<SpriteAnimation name="gamblerIdle_Animation" playOnState="Motion.Idle" sprite="vowIdle" animTime="1000" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="gamblerPunch_Animation" playOnState="Motion.Punch" sprite="vowPunch" animTime="500" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Jump_Animation" playOnState="Motion.Jump" sprite="vowIdle" animTime="300">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Fall_Animation" playOnState="Motion.Fall" sprite="vowIdle" animTime="400" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="luffy_Walk_Animation" playOnState="Motion.Move" sprite="vowIdle" animTime="400" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
		<SpriteAnimation name="gamblerRes_Animation" sprite="vowRes" animTime="3000" isLoop="false">
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
		</SpriteAnimation>
	</Animations>
	    <!-- <TileStampData>
            <Set name="FileName">game/UGCSpritesheet80v3.rttex</Set>
            <Set name="EndFrame">0,0</Set>
            <Set name="FrameCount">1</Set>
        </TileStampData> -->
		<ParticleSystems>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vowRoul</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
						<KeyFrame>0, 0.25, 0.25</KeyFrame>    
						<KeyFrame>0.5, 0.5, 0.5</KeyFrame>  
						<KeyFrame>1, 0.25, 0.25</KeyFrame>     	
            <!-- <KeyFrame>0,0.25,0.25</KeyFrame> -->
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_Projectile_Right" updateStage="OnPunchStart" updateState="Facing.Right">
				<Emitter>
					<Set name="offset">8, -10020</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">vowBubble</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.15, 0.15</KeyFrame>
						<KeyFrame>0, 0.15, 0.15</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
			<OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          	</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_left" updateStage="OnPunchStart" updateState="Facing.Left">
				<Emitter>
					<Set name="offset">8, -10020</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">vowBubble</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipY">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.15, 0.15</KeyFrame>
						<KeyFrame>0, 0.15, 0.15</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
			<OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          	</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">6</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">false</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">vowTile</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.8,0.8</Set>
					<Random name="finalScale" min="0.1, 0.1" max="0.4, 0.4" />
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200" />
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300" />
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.1</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">vowRes</Set>
					<Set name="offset">0,-30</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>     <!-- Starts at 0.5 scale -->
						<KeyFrame>0.33, 0.5, 0.5</KeyFrame>  <!-- Peaks at 0.5 scale at 33% lifetime -->
						<KeyFrame>0.66, 0.25, 0.25</KeyFrame><!-- Shrinks to 0.25 scale at 66% lifetime -->
						<KeyFrame>1, 0.1, 0.1</KeyFrame>     <!-- Ends at 0.1 scale at death -->
					</Curve>
					<Set name="lifeTime">3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hitSpark_particle" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">false</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">vowBreak</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.8,0.8</Set>
					<Random name="finalScale" min="0.1, 0.1" max="0.4, 0.4" />
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200" />
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300" />
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="smoke_particle" updateStage="AddClothingParticles">
				<Emitter>
					<Random name="offset" min="-10,-20" max="15,-25"/>
					<Random name="emissionInterval" min="0.5" max="0.6"/>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">vowBreak</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.3,0.3</Set>
					<Set name="finalScale">0.1,0.1</Set>
					<Set name="lifeTime">3</Set>
					<Random name="initialVelocity" min="-10, 20" max="10, 30"/>
					<Random name="initialAngle" min="0" max="271"/>
					<Select name="initialRotationRate" input="randomNumber">
						<Item>340</Item>
						<Item>360</Item>
					</Select>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
        <Set name="ShouldHover">true</Set>
					<Set name="PlayDefaultPunchAudio">false</Set>
					<!-- <Set name="PlayDefaultRespawnAudio">false</Set> -->
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">25</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
						<!-- <Set name="DefaultRespawnSound">audio/magic.wav</Set> -->
						<Set name="DefaultPunchSound">audio/wheel.wav</Set>
						<Set name="PlayDefaultPunchAudio">true</Set>
						<!-- <Set name="PlayDefaultRespawnAudio">true</Set> -->
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
			<MusicSource onState="Motion.Dance">
                <Set name="MusicFile">audio/ogg/bagpipes.ogg</Set>
            </MusicSource>
			<MusicSource onState="Motion.Sleep">
                <Set name="MusicFile">audio/ogg/campfire.ogg</Set>
            </MusicSource>
		</Update>
		<RenderInFront>
			<StopIf>
				<!-- <IsVariableBool name="isMannequin">true</IsVariableBool> -->
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="vowIdle" offset="0,-10020" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall" scale="0.35,0.35"/>
			<SpriteRender name="vowDance" offset="0,-10020" drawShadow="true" onState="Motion.Dance" scale="0.35,0.35"/>
			<SpriteRender name="vowPunch" offset="0,-10020" drawShadow="true" onState="Motion.Punch" scale="0.35,0.35"/>
			<SpriteRender name="vowSleep" offset="0,-10020" drawShadow="true" onState="Motion.Sleep" scale="0.40,0.40"/>
			<!-- <SpriteRender name="luffy_dance" offset="0,-10020" drawShadow="true" onState="Motion.Sleep" scale="0.40,0.40"/> -->
			<!-- <SpriteRender name="vowBubble" drawShadow="true" scale="0.35,0.35"/> -->
			<!-- <SpriteRender name="vowRes" offset="0,-10160" drawShadow="true" onState="IsDying.True" scale="1.4,1.4"/>DOESNT WORK-STILLUNDERGROUND -->
			<ParticleSystemRender name="smoke_particle" />
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
<!-- dm reeel. for items like this :) -->
  <Data>
    <!-- 0wing -->
    <Sprite name="wingVow" fileName="game/UGCSpritesheet81v0.rttex" textureSize="256"/>
    <!-- jump1 -->
    <Sprite name="particleVow" fileName="game/UGCSpritesheet81v1.rttex" textureSize="192" frame="0,0"/>
    <!-- <Sprite name="deathVow" fileName="game/flamingssSplash" textureSize="128"/> -->
    <!-- death3 -->
    <Sprite name="deathVow" fileName="game/UGCSpritesheet81v2.rttex" textureSize="128"/>
    <Sprite name="flakeVow" fileName="game/UGCSpritesheet81v2.rttex" textureSize="128" frame="0,0"/>
    <Sprite name="tVow" fileName="game/UGCSpritesheet81v2.rttex" textureSize="128" frame="0,0"/>
    <!-- <Sprite name="iniTrail" fileName="game/flamingssFet" textureSize="64" frame="0,0"/> -->
        <!-- <Sprite name="s_glow" fileName="game/particles_large17" textureSize="64" frame="9,3"/> -->

    <Animations>
            <SpriteAnimation name="a_particle" sprite="particleVow" isLoop="true" animTime="400">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_snowflake" sprite="flakeVow" isLoop="true" animTime="400">
        <Frame>0,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_trail" sprite="tVow" isLoop="true" animTime="300">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
        <Frame>4,2</Frame>
        <Frame>5,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Jump" playOnAction="JUMP|JUMPDOUBLE" sprite="wingVow" animTime="200" autoPlay="true" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Fall" playOnAction="FALL" sprite="wingVow" animTime="200" autoPlay="true" isLoop="false">
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="wingVow" tintOverride="0,127,236,255">
        <Frame>0,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_death" sprite="deathVow" animTime="1200">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_snowflake">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">flakeVow</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.05</Set>
          <Set name="initialAngle" source="snowflake_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_snowflake1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">flakeVow</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.05</Set>
          <Set name="initialAngle" source="snowflake_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_deathSplash" updateStage="OnKilled" renderStage="RenderBehind">
        <Emitter>
          <Set name="lifeTime">1.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-24</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">deathVow</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">3.0, 3.0</Set>
              <Set name="lifeTime">1.2</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="iniParticlenya_jump">
        <Emitter>
          <Random name="offset" min="0, 40" max="0, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">particleVow</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">1.1, 1.1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_left">
        <Emitter>
          <Random name="offset" min="40, 40" max="32, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">particleVow</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_right">
        <Emitter>
          <Random name="offset" min="-32, 40" max="-40, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">particleVow</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">tVow</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">tVow</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
      
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="HideAvatarOnDeath">true</Set>
        <Set name="HideAngelOnDeath">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
        <OnDrawCustomOutline>
            <AvatarTransform class="Scale">
                <Set name="targetScale">getCurrent</Set>
            </AvatarTransform>
            <!-- <AvatarTransform class="RenderData">
                <Set name="saturation">3</Set>
                <Set name="brightness">1</Set>
                <Set name="contrast">0.1</Set>
            </AvatarTransform> -->
            <AvatarOutline duration="1500" startScale="1,1" endScale="1.1,1.1">
                <Colours>
                    <Colour>183,38,255,255</Colour>
                    <Colour>106,0,159,255</Colour>
                </Colours>
            </AvatarOutline>
            <!-- <AvatarTransform class="RenderData">
                <Set name="saturation">1</Set>
                <Set name="brightness">1</Set>
                <Set name="contrast">0.1</Set>
            </AvatarTransform> -->
            <AvatarTransform class="Scale">
                <Set name="targetScale">reset</Set>
            </AvatarTransform>
        </OnDrawCustomOutline>
    <RenderBackpack>
      <SpriteRender name="wingVow" offset="0,-35" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" scale="0.5,0.5"/>
      <SpriteRender name="wingVow" offset="0,-35" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" scale="0.5,0.5"/> 
     </RenderBackpack>
    
    <RenderInFront>
        <ParticleSystemRender name="ps_snowflake" />
        <ParticleSystemRender name="ps_trail"/>
        <ParticleSystemRender name="ps_snowflake1"/>
        <ParticleSystemRender name="ps_trail1"/>
    </RenderInFront>

    <AddClothingParticles>
        <ParticleSystemUpdate name="ps_trail" onAction="WALK|IDLE|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_snowflake" onAction="IDLE|WALK|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_trail1" onAction="WALK|IDLE|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_snowflake1" onAction="IDLE|WALK|JUMP|FALL" drawShadow="false"/>
      <!-- donotremoveS -->
      <ParticleSystemUpdate name="iniParticlenya_jump" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_left" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_right" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_trail" />
      <ParticleSystemOff name="ps_trail1" />
      <ParticleSystemOff name="iniParticlenya_jump" />
      <ParticleSystemOff name="bloody_jump_left" />
      <ParticleSystemOff name="bloody_jump_right" />
    </SwitchOffClothingParticles>
  
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_idle" fileName="game/UGCSpritesheet82v0.rttex" textureSize="150"/>
		<Sprite name="s_punch" fileName="game/UGCSpritesheet82v0.rttex" textureSize="150"/>
		<Sprite name="s_bubbles" fileName="game/UGCSpritesheet82v1.rttex" textureSize="128" frame="0,0"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		<StateMachine name="IsDying">
			<States>
				<State name="False" />
				<State name="True" />
			</States>
			<Transitions>
				<Transition from="False" to="True">
					<Condition>
						<IsAction>DIE</IsAction>
					</Condition>
				</Transition>
				<Transition from="True" to="False">
					<Condition>
						<IsAction operatorType="NotEqual">DIE</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

		</StateMachines>
	<Animations>
		<SpriteAnimation name="s_Idle_Animation" playOnState="Motion.Idle" sprite="s_idle" animTime="1000" isLoop="true">
			    <Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_Punch_Animation" playOnState="Motion.Punch" sprite="s_punch" animTime="500" isLoop="true">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_Jump_Animation" playOnState="Motion.Jump" sprite="s_idle" animTime="300">
                <Frame>0,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_Fall_Animation" playOnState="Motion.Fall" sprite="s_idle" animTime="400" isLoop="true">
				<Frame>0,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_Walk_Animation" playOnState="Motion.Move" sprite="s_idle" animTime="400" isLoop="true">
				<Frame>2,1</Frame>
				<Frame>1,1</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
	</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_Projectile_Right" updateStage="OnPunchStart" updateState="Facing.Right">
				<Emitter>
					<Set name="offset">60, -10074</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-7, 0</Item>
						<Item>7, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile_left" updateStage="OnPunchStart" updateState="Facing.Left">
				<Emitter>
					<Set name="offset">60, -10074</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_bubbles</Set>
					<Select name="offset" input="punchCount">
						<Item>-7, 0</Item>
						<Item>7, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipY">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1, 1</KeyFrame>
						<KeyFrame>0, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">20</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">false</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultPunchSound">audio/realitytear.wav</Set>
		        <Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="s_idle" offset="0,-10044" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall" scale="0.8,0.8"/>
			<SpriteRender name="s_punch" offset="0,-10044" drawShadow="true" onState="Motion.Punch" scale="0.8,0.8"/>
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <StateMachines>
      <StateMachine name="playerState">
        <States>
          <State name="Equip"/>
          <State name="Fall"/>
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition from="Equip" to="Fall" >
            <Condition>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Fall" to="Equip">
            <Condition>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Equip|Fall" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Equip">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Fall">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine><StateMachine name="trailParticleState">
        <States>
          <State name="Equip"/>
          <State name="HorizontalMove"/>
          <State name="Punch"/>
          <State name="Sleep"/>
        </States>
        <Transitions>
          <Transition from="Equip|HorizontalMove|Punch" to="Sleep" >
            <Condition>
              <IsSleepingOnaBed>true</IsSleepingOnaBed>
            </Condition>
          </Transition>
          <Transition from="Equip|HorizontalMove|Sleep" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch|HorizontalMove|Sleep" to="Equip">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Punch|Equip|Sleep" to="HorizontalMove">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Sprite name="equip_sprite" fileName="game/UGCSpritesheet83v0.rttex" textureSize="64" frame="0,0"/>
    <Sprite name="fall_sprite" fileName="game/UGCSpritesheet83v0.rttex" textureSize="64" frame="0,0"/>
    <Sprite name="slash_sprite" fileName="game/UGCSpritesheet83v0.rttex" textureSize="64" frame="2,0"/>
    <Sprite name="trail_drops_sprite" fileName="game/UGCSpritesheet83v1.rttex" textureSize="32" frame="0,0"/>
    <Sprite name="block_hit_sprite" fileName="game/UGCSpritesheet83v1.rttex" textureSize="32" frame="1,0"/>
    <Sprite name="punch_projectile_sprite" fileName="game/UGCSpritesheet83v0.rttex" textureSize="64" frame="1,0"/>
    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="UserNameOffset">15</Set>
        <Set name="DefaultPunchSound">audio/squish.wav</Set>
		<Set name="PlayDefaultPunchAudio">true</Set>
      </Default>
    </RenderOptions>
    <ParticleSystems>
			<ParticleSystem name="drop_particles" updateStage="AddClothingParticles" updateState="trailParticleState.Equip" renderStage="RenderHandItem">
				<Emitter>
					<Set name="offset">-20, -34</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="forceXScaling">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true">
					<Set name="sprite">trail_drops_sprite</Set>
					<Random name="offset" min="-24, -8" max="24, 8"/>
					<Set name="inSpecificOrder">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialVelocity">-10, -40</Set>
					<Set name="gravityVector">0, 100</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="drop_particles_move" updateStage="AddClothingParticles" updateState="trailParticleState.HorizontalMove">
				<Emitter>
					<Set name="offset">-20, -34</Set>
					<Set name="emissionInterval">0.15</Set>
					<Set name="forceXScaling">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true">
					<Set name="sprite">trail_drops_sprite</Set>
					<Random name="offset" min="-48, -8" max="48, 8"/>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialVelocity">-10, -40</Set>
					<Set name="gravityVector">0, 100</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">0,-18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">slash_sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="initialScale">1,1</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="tile_break_particle" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="particlesPerEmission">20</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">trail_drops_sprite</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.25, 0.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,60"/>
					<Set name="gravityVector">0, 30</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="tile_hit_particle" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">block_hit_sprite</Set>
					<Random name="offset" min="-4, -4" max="4, 4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4, 0.4</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="tile_hit_splash" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">trail_drops_sprite</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.25, 0.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,60"/>
					<Set name="gravityVector">0, 30</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems></Data>

  <RenderRules>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="equip_sprite" offset="17, 4" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onState="playerState.Equip|playerState.Punch"/>
      <SpriteRender name="fall_sprite" offset="17, 4" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onState="playerState.Fall"/>
    </RenderBackHandItem>
    <AddClothingParticles>
      <StopIf type="or">
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
    </AddClothingParticles>
    <OnPunchStart>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
    </OnPunchStart>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1200</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="punch_projectile"/>
      <ParticleSystemOff name="drop_particles"/>
      <ParticleSystemOff name="drop_particles_move"/>
      <ParticleSystemOff name="tile_break_particle"/>
      <ParticleSystemOff name="tile_hit_particle"/>
      <ParticleSystemOff name="tile_hit_splash"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Move|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="VOW" fileName="game/UGCSpritesheet84v0.rttex" textureSize="64" frame="0,1" />
		<Sprite name="VOWW" fileName="game/UGCSpritesheet84v0.rttex" textureSize="64" frame="0,0" />
		<Sprite name="VOWWW" fileName="game/UGCSpritesheet84v0.rttex" textureSize="64" frame="1,1" />
		<Sprite name="VOWWWW" fileName="game/UGCSpritesheet84v0.rttex" textureSize="64" frame="12,19" />
<!-- DMVOW aka @reeel. on discord FOR ITEM  LIKE THIS -->

		<Sprite name="VOWWWWWWW" fileName="game/UGCSpritesheet84v1.rttex" textureSize="256" frame="0,1" />
<!-- DMVOW aka @reeel. on discord FOR ITEM  LIKE THIS -->

		<Sprite name="VOWWWWW" fileName="game/UGCSpritesheet84v2.rttex" textureSize="32" frame="0,0" />
<!-- DMVOW aka @reeel. on discord FOR ITEM  LIKE THIS -->
		<Sprite name="dmReeel" fileName="game/UGCSpritesheet84v3.rttex" textureSize="128" frame="0,4" />
		<Sprite name="dmReeelwithDot" fileName="game/UGCSpritesheet84v3.rttex" textureSize="128" frame="0,0" />
		<Sprite name="aduhai" fileName="game/UGCSpritesheet84v3.rttex" textureSize="128" />
		<Sprite name="mledakduar" fileName="game/particles_large16.rttex" textureSize="64" frame="8,11" />

		<Animations>
			<SpriteAnimation name="iniFire" sprite="VOWWWWW" animTime="200" isLoop="true"  autoPlay="true" >
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_punch_head" sprite="VOWWW" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>1,1</Frame>
				<Frame>3,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_punch_back" sprite="VOWWWW" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>0,1</Frame>
				<Frame>2,1</Frame>
				<Frame>4,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_head" sprite="VOW" animTime="1000" isLoop="true"
				playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>1,0</Frame>
				<Frame>3,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_back" sprite="VOWW" animTime="1000" isLoop="true"
				playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>0,0</Frame>
				<Frame>2,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_eletric" sprite="hand_eletric" animTime="500" isLoop="true"
				playOnAction="IDLE|PUNCH|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>1,42</Frame>
				<Frame>2,42</Frame>
				<Frame>3,42</Frame>
			</SpriteAnimation>

			<!-- Added Animations from dragonBenzyl -->
			<SpriteAnimation name="a_feather" sprite="dmReeel" animTime="100" isLoop="true" playOnState="Motion.Move">
				<Frame>0,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_fog" sprite="dmReeelwithDot" animTime="100" isLoop="true" playOnState="Motion.Move">
				<Frame>0,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="Lightning_Anim" sprite="aduhai" autoPlay="true" animTime="910" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
				<Frame>8,1</Frame>
				<Frame>9,1</Frame>
				<Frame>10,1</Frame>
				<Frame>11,1</Frame>
			</SpriteAnimation>
		</Animations>

		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">17,23</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>

		<ParticleSystems>
		<!-- <ParticleSystem name="ps_punch_projectile" updateStage="RenderPet" >
        <Emitter usePlayerFacing="true">
					<Random name="emissionInterval" min="0.002" max="0.004" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
					<Set name="offset">16,-19</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">VOWWWWW</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ALPHA</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">0</Set>
          <Set name="interpolateAlpha">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1.2, 0.6</KeyFrame>
            <KeyFrame>1, 9.6, 4.8</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.45</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <RandomRadial name="initialVelocity" angleRange="-15,15" radiusRange="50,100" />
          <Set name="rotateWithVelocity">true</Set>
          <Set name="gravityVector">0,-20</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="flipX">false</Set>
        </Particle>
      </ParticleSystem> -->
			<ParticleSystem name="ps_punchProjectile" updateStage="RenderPet"
				updateState="Motion.Punch">
				<Emitter usePlayerFacing="true">
					<Random name="emissionInterval" min="0.002" max="0.004" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
					<Set name="offset">16,-19</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">VOWWWWW</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.15</Set>
					          <Set name="interpolateAlpha">true</Set>

					<!-- <Set name="initialScale">2,2</Set> -->
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 0.6</KeyFrame>
						<KeyFrame>1, 9.6, 4.8</KeyFrame>
          			</Curve>
					<!-- <Set name="finalScale">4,4</Set> -->
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">0</Set>
					<Random name="targetPosOffset" min="-3, -13" max="3, 13" />
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset"
						duration="lifeTime" x="1" />
					<Set name="rotateWithVelocity">true</Set>
					<OnFinish>
						<ParticleSystemName>ps_punchSmoke</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchSmoke">
				<Emitter>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="delay">-0.25</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">VOWWWWW</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="offset" min="-8, -8" max="8, 8" />
					<Set name="initialAngle">180</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.6, 0.6</KeyFrame>
						<KeyFrame>1, 0.05, 0.05</KeyFrame>
					</Curve>
					<Set name="rotateWithVelocity">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,80" />
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>

			<!-- Added Particle Systems from dragonBenzyl -->
			<ParticleSystem name="ps_feather" updateStage="AddClothingParticles" updateState="Motion.Move">
				<Emitter>
					<Set name="offset">-17, -2</Set>
					<Set name="lifeTime">1</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">dmReeel</Set>
					<Random name="offset" min="-15, -10" max="15, -5" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="useGravity">true</Set>
					<Set name="initialScale">1, 1</Set>
					<Set name="lifeTime">1.2</Set>
					<Curve name="initialVelocity">
						<KeyFrame>0.2, -20, 0</KeyFrame>
						<KeyFrame>0.4, 50, 0</KeyFrame>
						<KeyFrame>0.6, -50, 0</KeyFrame>
						<KeyFrame>0.8, 50, 0</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Curve name="initialAngle">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -15</KeyFrame>
						<KeyFrame>0.4, 15</KeyFrame>
						<KeyFrame>0.6, -15</KeyFrame>
						<KeyFrame>0.8, 15</KeyFrame>
					</Curve>
					<Set name="gravityVector">0, 30</Set>
					<Set name="flipX">false</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fogLocal" updateStage="AddClothingParticles" updateState="Motion.Idle">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">false</Set>
					<Set name="infLifeTime">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">dmReeelwithDot</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-8, -8" max="8, -16" />
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.25</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="initalRGB">0.346503, 0.25668, 0.534314</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 2, 2</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,30" />
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fogWorld" updateStage="AddClothingParticles" updateState="Motion.Move">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">dmReeelwithDot</Set>
					<Random name="offset" min="-12, 0" max="12, -24" />
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.25</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="initalRGB">0.303625, 0.221429, 0.47549</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.25, 1.25</KeyFrame>
						<KeyFrame>1, 2, 2</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,20" />
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="SpawnParticle">
				<Emitter>
					<Set name="offset">0, -500</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">mledakduar</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 3, 3</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="SpawnSparkle">
				<Emitter>
					<Set name="offset">0, -900</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">24</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">VOWWWWW</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Random name="offset" min="-24, -16" max="24, 16" />
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="relativeToEmitter">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="1" max="1.5" />
					<Increment name="finalScale" source="initialScale" multiplier="2.5,2.5"/>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
		<Default>
        	<Set name="PlayDefaultPunchAudio">false</Set>
            <Set name="DefaultPunchSound">audio/droar.wav</Set>
        	<Set name="PlayDefaultPunchAudio">true</Set>

			<Set name="NeedRenderPet">true</Set>
			<Set name="PetOffsetDuplication">20,20</Set>
			<Set name="IgnorePunchTypeCheck">true</Set>
			<!-- <Set name="ShouldHover">true</Set> -->
			<Set name="UsePetForceFaceTime">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>


      	</Default>
			<!-- <Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderBackArmBuild">false</Set>
			</Default> -->
		</RenderOptions>
	</Data>

	<RenderRules>
		<!-- Added RenderInFront for aduhai -->
		<RenderInFront>
			<SpriteRender name="aduhai" alignment="DOWN_CENTER" offset="0, 40" onAction="IDLE|PUNCH|WALK|JUMP|FALL" drawShadow="false" />
		</RenderInFront>

		<RenderHandItem>
			<!-- <SpriteRender name="VOWWWWWWW" offset="0,16" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/> -->
			<!-- Added Particle updates for hand item -->
			<ParticleSystemUpdate name="ps_feather" onState="Motion.Move" />
			<ParticleSystemUpdate name="ps_fogLocal" onState="Motion.Idle" />
			<ParticleSystemUpdate name="ps_fogWorld" onState="Motion.Move" />
			      <SpriteRender name="VOWWWWWWW" offset="2,8" rotationPoint="0,1" alignment="CENTER" scale="1,1" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />

		</RenderHandItem>
        
		<OnPunchUpdate>
			<AvatarTransform class="Emotion">
				<Set name="emotion">ANGRY</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderPet>
			<SpriteRender name="VOWWW" alignment="DOWN_CENTER" onAction="PUNCH" offset="0,10" />
			<SpriteRender name="VOWWWW" alignment="DOWN_CENTER" onAction="PUNCH"
				offset="-63.5,10" />
			<SpriteRender name="VOW" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="0,10" />
			<SpriteRender name="VOWW" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="-63.5,10" />
		</RenderPet>

		<!-- Added OnRespawned block -->
		<OnRespawned>
			<ParticleSystemUpdate name="SpawnParticle" />
			<ParticleSystemUpdate name="SpawnSparkle" />
		</OnRespawned>
	</RenderRules>
</ItemRenderer><ItemRenderer>
  <Data>
    <Sprite name="RAPS" fileName="game/UGCSpritesheet85v0.rttex" textureSize="64"/>
    <Sprite name="MAYO_WM" fileName="game/UGCSpritesheet85v1.rttex" textureSize="32"/>
    <Sprite name="MAYO_LOVE" fileName="game/UGCSpritesheet85v1.rttex" textureSize="32" frame="3,0"/>
    <StateMachines>
      <StateMachine name="RAPS">
        <States>
          <State name="IDLE"/>
          <State name="WALK"/>
          <State name="JUMP"/>
          <State name="FALL"/>
        </States>
        <Transitions>
          <Transition to="IDLE" from="WALK|JUMP|FALL">
            <Condition>
              <IsAction>IDLE</IsAction>
            </Condition>
          </Transition>
          <Transition to="WALK" from="IDLE|JUMP|FALL">
            <Condition>
              <IsAction>WALK</IsAction>
            </Condition>
          </Transition>
          <Transition to="JUMP" from="IDLE|WALK|FALL">
            <Condition>
              <IsAction>JUMP</IsAction>
            </Condition>
          </Transition>
          <Transition to="FALL" from="IDLE|WALK|JUMP">
            <Condition>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <Animations>
      <SpriteAnimation name="A" sprite="RAPS" animTime="400" playOnState="RAPS.IDLE|RAPS.WALK">
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="B" sprite="RAPS" isLoop="false" animTime="200" playOnState="RAPS.JUMP">
        <Frame>2,0</Frame>
        <Frame>1,0</Frame>
        <Frame>0,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="C" sprite="RAPS" isLoop="true" animTime="300" playOnState="RAPS.FALL">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="D" sprite="MAYO_WM" animTime="400" isLoop="true">
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
    </Animations>
   <ParticleSystems>
			<ParticleSystem name="A" updateStage="AddClothingParticles">
			<Emitter>
				<Random name="offset" min="-10,-35" max="10,-35"/>
				<Random name="emissionInterval" min="0.5" max="0.6"/>
				<Set name="infParticles">true</Set>
				<Set name="infLifeTime">true</Set>
				<Set name="particlesPerEmission">3</Set>
			</Emitter>
			<Particle>
				<Set name="sprite">MAYO_LOVE</Set>
				<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				<Set name="isBackgroundParticle">false</Set>
				<Set name="initalRGB">1, 1, 1</Set>
				<Set name="initialAlpha">1</Set>
				<Set name="finalAlpha">0</Set>
				<Set name="interpolateAlpha">true</Set>
				<Set name="interpolateScale">true</Set>
				<Set name="initialScale">0.4,0.4</Set>
				<Set name="finalScale">0.2,0.2</Set>
				<Set name="lifeTime">3</Set>
				<Random name="initialVelocity" min="-10, 20" max="10, 30"/>
				<Random name="initialAngle" min="0" max="271"/>
				<Select name="initialRotationRate" input="randomNumber">
                        <Item>90</Item>
                        <Item>-360</Item>
                    </Select>
			</Particle>
		</ParticleSystem>
		<ParticleSystem name="B" updateStage="AddClothingParticles">
			<Emitter>
				<Random name="offset" min="25,-35" max="-25,-35"/>
				<Random name="emissionInterval" min="0.5" max="0.6"/>
				<Set name="infParticles">true</Set>
				<Set name="infLifeTime">true</Set>
				<Set name="particlesPerEmission">1</Set>
			</Emitter>
			<Particle>
				<Set name="sprite">MAYO_WM</Set>
				<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				<Set name="isBackgroundParticle">false</Set>
				<Set name="initalRGB">1, 1, 1</Set>
				<Set name="initialAlpha">1</Set>
				<Set name="finalAlpha">0</Set>
				<Set name="interpolateAlpha">true</Set>
				<Set name="interpolateScale">true</Set>
				<Set name="initialScale">0.4,0.4</Set>
				<Set name="finalScale">0.1,0.1</Set>
				<Set name="lifeTime">3</Set>
				<Random name="initialVelocity" min="-15, 20" max="15, 30"/>
				<Random name="initialAngle" min="0" max="271"/>
				<Select name="initialRotationRate" input="randomNumber">
                        <Item>90</Item>
                        <Item>-360</Item>
                    </Select>
			</Particle>
		</ParticleSystem>
  </ParticleSystems>
  </Data>
  <RenderRules>
    <RenderBehind>
      <SpriteRender name="RAPS" offset="-7, 8" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="RAPS" offset="7, 8" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBehind> <!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO--><!--RAPSDEMAYO-->
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<!-- <TileStampData>
			<Set name="FileName">game/UGCSpritesheet86v0.rttex</Set> 
			<Set name="EndFrame">3,0</Set>
			<Set name="FrameCount">3</Set>
		</TileStampData> -->
		<StateMachines>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="playerState">
				<States>
					<State name="Idle" />
					<State name="Punch" />
					<State name="ZombiePunch" />
				</States>
				<Transitions>
					<Transition from="ZombiePunch|Punch" to="Idle">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="ZombiePunch|Idle" to="Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Idle|Punch" to="ZombiePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
					 </Transitions>
      </StateMachine>
		</StateMachines>
		<!-- 0cloverpunchBlack0 -->
		<Sprite name="VOWdm" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64" frame="6,3" />
		<Sprite name="vowdmm" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64" frame="4,3" />
		<Sprite name="vowdmmm" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64"/>
		<Sprite name="dmVOW" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64"/>
		<Sprite name="dmdmvow" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64"/>
		<Sprite name="itisvowygy" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64"/>
        <Sprite name="reeelOnDiscord" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64"/>
		<Sprite name="imreel" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64" frame="0,0" />
		<Sprite name="reeelWithDot" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64" frame="0,1" />
		<Sprite name="vowcapek" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64"/>
		<Sprite name="vowLelah" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64"/>
		<Sprite name="vowIsTired" fileName="game/UGCSpritesheet86v0.rttex" textureSize="64"/>
		<!-- 1clover_sbksBlack1 -->
		<Sprite name="VOOWOWWWWWVOW" fileName="game/UGCSpritesheet86v1.rttex" textureSize="1024" frame="0,0" />
		<!-- 2clvoer_backBlack2 -->
		<Sprite name="APAINIVOW" fileName="game/UGCSpritesheet86v2.rttex" textureSize="640" />
		<Sprite name="BackPack" fileName="game/UGCSpritesheet86v2.rttex" textureSize="640"/>
		

		<Animations>
<!-- <SpriteAnimation name="slashFinish" animTime="1000" sprite="s_finalSlash">
	<Frame>0,1</Frame>
	<Frame>1,1</Frame>
