			</SpriteAnimation>
			<SpriteAnimation name="a_land_foot2_jump_anim" sprite="s_land_foot2" animTime="1200" isLoop="true" playOnState="Land.Jump|Land.Fall">
				<Frame>6, 3</Frame>
				<Frame>7, 3</Frame>
				<Frame>8, 3</Frame>
				<Frame>9, 3</Frame>
				<Frame>10, 3</Frame>
				<Frame>11, 3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_land_foot1_punch_anim" sprite="s_land_foot1" animTime="1200" isLoop="true" playOnState="Land.Punch">
				<Frame>0, 4</Frame>
				<Frame>1, 4</Frame>
