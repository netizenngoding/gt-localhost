<?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="s_Pants" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="0,0" />
        <Sprite name="s_Dog" fileName="game/pets/p_friendly_dog.rttex" textureSize="32,32" frame="0,0" />
		<Sprite name="s_Punch" fileName="game/particles12.rttex" textureSize="32" frame="31,3" />
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
					<State name="Death" />
					<State name="Sleep" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal|Sleep|Death">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal|Sleep">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Sleep" from="None">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Death" from="None|Punch|Up|Down|Horizontal|Sleep">
						<Condition>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="SleepParticle">
				<States>
					<State name="On" />
					<State name="Off" ExitTime="2"/>
				</States>
				<Transitions>
					<Transition to="On" from="Off">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Off" from="On"/>
				</Transitions>
			</StateMachine>
		</StateMachines>
        <Animations>
            <SpriteAnimation name="s_Dog_Idle" sprite="s_Dog" isLoop="true" animTime="400" playOnState="Motion.None">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="s_Dog_Death" sprite="s_Dog" isLoop="false" animTime="2000" playOnState="Motion.Death">
                <Frame>4,1</Frame>
                <Frame>5,1</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="s_Dog_Sleep" sprite="s_Dog" isLoop="true" animTime="100" playOnState="Motion.Sleep">
                <Frame>3,1</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="s_Dog_Jump" sprite="s_Dog" isLoop="true" animTime="100" playOnState="Motion.Up">
                <Frame>7,0</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="s_Dog_Fall" sprite="s_Dog" isLoop="true" animTime="100" playOnState="Motion.Down">
                <Frame>0,1</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="s_Dog_Move" sprite="s_Dog" isLoop="true" animTime="300" playOnState="Motion.Horizontal">
                <Frame>4,0</Frame>
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="s_Dog_Punch" sprite="s_Dog" isLoop="true" animTime="400" playOnState="Motion.Punch">
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
            </SpriteAnimation>
        </Animations>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="UsePetForceFaceTime">false</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
			</Default>
		</RenderOptions>
        <ParticleSystems>
			<ParticleSystem name="PunchParticle">
				<Emitter>
					<Set name="offset">10, -16</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
    </Data>
    <RenderRules>
		<Update>
      <StopIf type="or">
				<IsZombified>true</IsZombified>
        <IsVariableBool name="isBattleLeash">true</IsVariableBool>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Motion.Punch">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</Update>
		<RenderPet>
			<Translate>-16,0,0</Translate>
            <SpriteRender name="s_Dog" alignment="DOWN_CENTER"/>
			<StopIf type="or">
				<IsTrnsformed>true</IsTrnsformed>
        <IsVariableBool name="isBattleLeash">true</IsVariableBool>
			</StopIf>
			<ParticleSystemUpdate name="PunchParticle" onState="Motion.Punch"/>
			<Group onState="SleepParticle.On">
				<ParticleSystemLegacy type="5"/>
			</Group>
        </RenderPet>
		<UpdatePunch>
			
		</UpdatePunch>
		<UpdatePet>
			<ContextUpdate type="SetPetWalkRunJump">
				<Set name="PetWalkRunJump.minSpeed">500</Set>
				<Set name="PetWalkRunJump.distSpeedMult">10</Set>
			</ContextUpdate>
		</UpdatePet>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_DIAMOND_SPARKLING_SNEAKERS">
	<Data>
		<Sprite name="s_leg1" fileName="game/player_feet16.rttex" textureSize="32" frame="16,26" />
		<Sprite name="s_leg2" fileName="game/player_feet16.rttex" textureSize="32" frame="16,27" />
		<Sprite name="s_foot1" fileName="game/player_feet.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_foot2" fileName="game/player_feet.rttex" textureSize="32" frame="0,1" />
		<VariableMap>
			<Set name="leftFootYPos">0,0,0</Set>
			<Set name="rightFootYPos">0,0,0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="HideParticlesOnTransform">true</Set>
				<Set name="RenderShoesWithMermaidTail">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderShoes>
			<StopIf type="or">
				<IsWearing slot="PANTS">ITEM_ID_RAPTOR_LEGS</IsWearing>
				<IsRenderObjectFlag>RENDER_OBJECT_FLAG_NO_FEET</IsRenderObjectFlag>
				<IsVariableBool name="isInvisible">true</IsVariableBool>
			</StopIf>
			<Group>
				<Translate>leftFootYPos</Translate>
				<SpriteRender name="s_leg1" alignment="DOWN_CENTER" />
				<SpriteRender name="s_foot1" alignment="DOWN_CENTER"  tintOverride="SKIN"/>
			</Group>
			<Group>
				<Translate>rightFootYPos</Translate>
				<SpriteRender name="s_leg2" alignment="DOWN_CENTER" />
				<SpriteRender name="s_foot2" alignment="DOWN_CENTER"  tintOverride="SKIN"/>
			</Group>
		</RenderShoes>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wings" fileName="game/particles_large17.rttex" textureSize="64" frame="7,12"/>
    <Sprite name="s_angel" fileName="game/particles12.rttex" textureSize="32" frame="14,17"/>
    <Sprite name="s_petal" fileName="game/particles12.rttex" textureSize="32" frame="16,17"/>

    <Animations>
      <SpriteAnimation name="a_equip" sprite="s_wings" animTime="1200" playOnState="Action.Equip" isLoop="true">
        <Frame>7,12</Frame>
        <Frame>8,12</Frame>
        <Frame>9,12</Frame>
        <Frame>10,12</Frame>
        <Frame>9,12</Frame>
        <Frame>8,12</Frame>
      </SpriteAnimation>
      <SequenceAnimation name="a_BackJump" playOnState="Action.Jump">
        <SpriteAnimation name="a_BackJump1" sprite="s_wings" animTime="100">
          <Frame>7,12</Frame>
          <Frame>11,12</Frame>
          <Frame>12,12</Frame>
          <Frame>11,12</Frame>
          <Frame>7,12</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_BackJump2" sprite="s_wings" animTime="200">
          <Frame>7,12</Frame>
          <Frame>11,12</Frame>
          <Frame>12,12</Frame>
          <Frame>13,12</Frame>
        </SpriteAnimation>
      </SequenceAnimation>
      <SpriteAnimation name="a_fall" sprite="s_wings" animTime="1000" playOnState="Action.Fall" isLoop="true">
        <Frame>13,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_angel" sprite="s_angel" animTime="400">
        <Frame>14,17</Frame>
        <Frame>15,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_petal" sprite="s_petal">
        <Frame>16,17</Frame>
        <Frame>17,17</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Equip" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Equip" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Equip|Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Equip|Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_angel" updateStage="OnKilled">
        <Emitter>
          <Set name="lifeTime">5.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-32</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_angel</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialVelocity">0, -20</Set>
          <Set name="lifeTime">5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petals" updateStage="OnKilled">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">8</Set>
          <Set name="lifeTime">0.5</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Random name="offset" min="-15,-20" max="15,0"/>
          <Set name="sprite">s_petal</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 40</Set>
          <Set name="initialScale">1,1</Set>
          <Random name="flipX" min="false" max="true"/>
          <Curve name="initialAngle">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, -15</KeyFrame>
            <KeyFrame>0.4, 15</KeyFrame>
            <KeyFrame>0.6, -15</KeyFrame>
            <KeyFrame>0.8, 15</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Curve name="initialVelocity">
            <KeyFrame>0, 0, 0</KeyFrame>
            <KeyFrame>0.2, -20, 0</KeyFrame>
            <KeyFrame>0.4, 20, 0</KeyFrame>
            <KeyFrame>0.6, -20, 0</KeyFrame>
            <KeyFrame>0.8, 20, 0</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.75</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="HideAngelOnDeath">true</Set>
        <Set name="HasDeathParticles">true</Set>
        <Set name="IncludeAllActions">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_wings" offset="0,-22" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_wings" offset="0,-22" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="ActiveType">
				<States>
					<State name="Angel"/>
					<State name="Devil"/>
				</States>
				<Transitions>
					<Transition to="Angel" from="Devil">
						<Condition>
							<ItemHasTag>MOD_TYPE_BLOCK</ItemHasTag>
						</Condition>
					</Transition>
					<Transition to="Devil" from="Angel">
						<Condition>
							<ItemHasTag>MOD_TYPE_GEM</ItemHasTag>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Sprite name="s_angel" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="s_devil" fileName="game/particles11.rttex" textureSize="32"/>
		
		<Animations>
			<SpriteAnimation name="a_angel_active" sprite="s_angel" isLoop="true" animTime="200" playOnState="ActiveType.Angel">
				<Frame>20,19</Frame>
				<Frame>21,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_devil_active" sprite="s_devil" isLoop="true" animTime="200" playOnState="ActiveType.Devil">
				<Frame>20,18</Frame>
				<Frame>21,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_angel_idle" sprite="s_angel" isLoop="true" animTime="200" playOnState="ActiveType.Devil">
				<Frame>22,19</Frame>
				<Frame>23,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_devil_idle" sprite="s_devil" isLoop="true" animTime="200" playOnState="ActiveType.Angel">
				<Frame>22,18</Frame>
				<Frame>23,18</Frame>
			</SpriteAnimation>
			<SpriteSinPulseAnimation name="a_angel_float" sprite="s_angel" autoPlay="true">
				<Parameter name="pos.y">
					<Set name="period">2000</Set>
					<Set name="scale">2</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_devil_float" sprite="s_devil" autoPlay="true">
				<Parameter name="pos.y">
					<Set name="period">2000</Set>
					<Set name="scale">2</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
		</Animations>
		
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsAction>SLEEP</IsAction>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Emotion" onState="ActiveType.Angel">
				<Set name="emotion">LOOKLEFT</Set>
			</AvatarTransform>
			<AvatarTransform class="Emotion" onState="ActiveType.Devil">
				<Set name="emotion">LOOKRIGHT</Set>
			</AvatarTransform>
		</Update>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_angel" offset="14,-10" scale="0.5,0.5" drawShadow="false" alignment="DOWN_CENTER" onState="Facing.Right"/>
			<SpriteRender name="s_devil" offset="14,-10" scale="0.5,0.5" drawShadow="false" alignment="DOWN_CENTER" onState="Facing.Left"/>
		</RenderBehind>
		<RenderInFront value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_devil" offset="-14,-10" scale="0.5,0.5" drawShadow="false" alignment="DOWN_CENTER" onState="Facing.Right"/>
			<SpriteRender name="s_angel" offset="-14,-10" scale="0.5,0.5" drawShadow="false" alignment="DOWN_CENTER" onState="Facing.Left"/>
			<StopIf>
				<IsSitting>false</IsSitting>
			</StopIf>
			<SpriteRender name="s_angel" offset="14,-10" scale="0.5,0.5" drawShadow="false" alignment="DOWN_CENTER" onState="Facing.Right"/>
		</RenderInFront>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_circlet" fileName="game/particles_large9.rttex" textureSize="64" frame="13,15"/>

    <Animations>
      <SpriteAnimation name="a_circlet" sprite="s_circlet" animTime="600" isLoop="true" autoPlay="true">
        <Frame>13,15</Frame>
        <Frame>14,15</Frame>
        <Frame>15,15</Frame>
        <Frame>15,14</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_circletFloat" sprite="s_circlet" animTime="1400" autoPlay="true" isLoop="true">
        <Curve name="pos.y">
          <KeyFrame>0.f, -4</KeyFrame>
          <KeyFrame>0.5f, 0</KeyFrame>
          <KeyFrame>1.f, -4</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>
  </Data>

  <RenderRules>
    <RenderBackHat>
      <SpriteRender name="s_circlet" offset="-5,0" alignment="DOWN_CENTER" drawShadow="false"/>
    </RenderBackHat>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="auraBack" fileName="game/particles_large15.rttex" textureSize="64" frame="0,4" />
		<Sprite name="auraFront" fileName="game/particles_large15.rttex" textureSize="64" frame="0,5" />
		<Sprite name="s_hitFlash" fileName="game/particles12.rttex" textureSize="32" frame="8,1" />
		<Sprite name="s_Sparkles" fileName="game/particles12.rttex" textureSize="32" frame="7,1" />
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="True"/>
					<State name="False"/>
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ActiveType">
				<States>
					<State name="Light" />
					<State name="Dark" />
					<State name="None" />
					<State name="Both" />
				</States>
				<Transitions>
					<Transition to="Both" from="Dark|Light|None">
						<Condition type="and">
							<CompareCustomVariable VariableNameToCompare="darkAnomaly">true</CompareCustomVariable>
							<CompareCustomVariable VariableNameToCompare="lightAnomaly">true</CompareCustomVariable>
						</Condition>
					</Transition>					
					<Transition to="None" from="Dark|Light">
						<Condition type="and">
							<CompareCustomVariable VariableNameToCompare="darkAnomaly">false</CompareCustomVariable>
							<CompareCustomVariable VariableNameToCompare="lightAnomaly">false</CompareCustomVariable>
						</Condition>
					</Transition>			
					<Transition to="Light" from="None|Dark">
						<Condition type="and">
							<CompareCustomVariable VariableNameToCompare="darkAnomaly">false</CompareCustomVariable>
							<CompareCustomVariable VariableNameToCompare="lightAnomaly">true</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="Dark" from="None|Light">
						<Condition type="and">
							<CompareCustomVariable VariableNameToCompare="darkAnomaly">true</CompareCustomVariable>
							<CompareCustomVariable VariableNameToCompare="lightAnomaly">false</CompareCustomVariable>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="TimerState">
				<States start="Idle">
					<State name="Stay" />
					<State name="Reset" />
					<State name="Idle" />
					<State name="Init" />
					<State name="TimerChanged" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Stay|Reset">
						<Condition>
							<CompareCustomVariable VariableNameToCompare="timeCycle_On">false</CompareCustomVariable>
						</Condition>
					</Transition>			
					<Transition to="Init" from="Idle">
						<Condition>
							<CompareCustomVariable VariableNameToCompare="timeCycle_On">true</CompareCustomVariable>
						</Condition>
					</Transition>					
					<Transition to="TimerChanged" from="Stay">
						<Condition>
							<CompareCustomVariable operatorType="NotEqual" VariableNameToCompare="timeCyclePrevious" RightHSVariableNameToCompare="timeCycle">15</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="Stay" from="Reset|Init|TimerChanged">
						<Condition type="and">
							<CompareCustomVariable operatorType="Greater" VariableNameToCompare="timeCycleTemp">0</CompareCustomVariable>
							<CompareCustomVariable VariableNameToCompare="timeCycle_On">true</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="Reset" from="Stay|TimerChanged">
						<Condition type="and">
							<CompareCustomVariable operatorType="Less" VariableNameToCompare="timeCycleTemp">0</CompareCustomVariable>
							<CompareCustomVariable VariableNameToCompare="timeCycle_On">true</CompareCustomVariable>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="darkEnabledBack" sprite="auraBack" animTime="900" isLoop="true" playOnState="ActiveType.Dark">
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
				<Frame>10,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="darkEnabledFront" sprite="auraFront" animTime="900" isLoop="true" playOnState="ActiveType.Dark">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>7,4</Frame>
				<Frame>8,4</Frame>
				<Frame>9,4</Frame>
				<Frame>10,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="lightEnabledBack" sprite="auraBack" animTime="900" isLoop="true" playOnState="ActiveType.Light">
				<Frame>0,7</Frame>
				<Frame>1,7</Frame>
				<Frame>2,7</Frame>
				<Frame>3,7</Frame>
				<Frame>4,7</Frame>
				<Frame>5,7</Frame>
				<Frame>6,7</Frame>
				<Frame>7,7</Frame>
				<Frame>8,7</Frame>
				<Frame>9,7</Frame>
				<Frame>10,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="lightEnabledFront" sprite="auraFront" animTime="900" isLoop="true" playOnState="ActiveType.Light">
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				<Frame>4,6</Frame>
				<Frame>5,6</Frame>
				<Frame>6,6</Frame>
				<Frame>7,6</Frame>
				<Frame>8,6</Frame>
				<Frame>9,6</Frame>
				<Frame>10,6</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_hitFlash">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hitFlash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1.6, 1.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_wandSparklesPunchTarget">
				<Emitter attachment="targetPos">
					<Set name="offset">0,0</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Sparkles</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Random name="initialScale" min="0.3" max="0.8"/>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="70,80"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="ShouldHover">true</Set>
				<Set name="DisableWalkAnimation">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnorePunchTypeDamagedTileCheck">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="UserNameOffset">8</Set>
				<Set name="DisableDefaultAncestralParticleEffects">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="ItemUIDescription">You can customize the Anomaly Aura from this popup.</Set>
			<Set name="timeCycle" MinValue="1" MaxValue="999" UIOrder="0" UIName="Time Dilation Cycle Time:">15</Set>
			<Set name="timeCycleTemp">15</Set>
			<Set name="timeCyclePrevious">15</Set>
			<Set name="timeCycle_On" UIOrder="1" RadioGroup="0" UIName="Time Dilation On / Off">true</Set>
			<Set name="darkAnomaly" UIOrder="2" RadioGroup="0" UIName="Dark Anomaly">false</Set>
			<Set name="lightAnomaly" UIOrder="3" RadioGroup="0" UIName="Light Anomaly">false</Set>
			<Set name="lightAnomalyTemp">true</Set>
			<Set name="DeltaTime">0</Set>
			<Set name="sittingOffset">0, 0, 0</Set>
			<Set name="sittingOffsetTemp">0, 0, 0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
			</StopIf>
			<StopIf>
				<IsAction>DIE</IsAction>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="timeCycleTemp" RightHandVariableName="timeCycle" OperationType="Set" onState="TimerState.TimerChanged|TimerState.Init" />
			<ArithmethicOperation LeftHandVariableName="timeCyclePrevious" RightHandVariableName="timeCycle" OperationType="Set" onState="TimerState.Init|TimerState.TimerChanged" />
			
			<ArithmethicOperation LeftHandVariableName="timeCycleTemp" RightHandVariableName="DeltaTime" OperationType="Substract" onState="TimerState.Stay" />
			<ArithmethicOperation LeftHandVariableName="timeCycleTemp" RightHandVariableName="timeCycle" OperationType="Set" onState="TimerState.Reset" />
			<ArithmethicOperation LeftHandVariableName="lightAnomaly" RightHandVariableName="true" OperationType="Set" onState="ActiveType.None|ActiveType.Both" />
			<ArithmethicOperation LeftHandVariableName="darkAnomaly" RightHandVariableName="false" OperationType="Set" onState="ActiveType.None|ActiveType.Both" />
			<ArithmethicOperation LeftHandVariableName="lightAnomalyTemp" RightHandVariableName="lightAnomaly" OperationType="Set" onState="TimerState.Reset" />
			<ArithmethicOperation LeftHandVariableName="lightAnomaly" RightHandVariableName="darkAnomaly" OperationType="Set" onState="TimerState.Reset" />
			<ArithmethicOperation LeftHandVariableName="darkAnomaly" RightHandVariableName="lightAnomalyTemp" OperationType="Set" onState="TimerState.Reset" />
		</Update>
		<RenderInFront value="playerCenter">
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
			</StopIf>
			<StopIf>
				<IsAction>DIE</IsAction>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>
			<SpriteRender name="auraFront" drawShadow="false" offset="0,-20" scale="1.1, 1.1" />
		</RenderInFront>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
			</StopIf>
			<StopIf>
				<IsAction>DIE</IsAction>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>
			<SpriteRender name="auraBack" drawShadow="false" offset="0,-20" scale="1.1, 1.1" />
		</RenderBehind>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_hitFlash"/>
			<ParticleSystemUpdate name="ps_wandSparklesPunchTarget"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_hitFlash"/>
			<ParticleSystemUpdate name="ps_wandSparklesPunchTarget"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="antagon_idle" fileName="game/smack/antagon_idle.rttex" textureSize="256"/>
		<Sprite name="antagon_punch" fileName="game/smack/antagon_attack.rttex" textureSize="256"/>
		<Sprite name="antagon_walk" fileName="game/smack/antagon_walk.rttex" textureSize="256"/>
		<Sprite name="antagon_jump" fileName="game/smack/antagon_jump.rttex" textureSize="256"/>
		<Sprite name="antagon_fall" fileName="game/smack/antagon_fall.rttex" textureSize="256"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>			
			<SpriteAnimation name="antagon_Idle_Animation" playOnState="Motion.Idle" sprite="antagon_idle" animTime="1200" isLoop="true">
				<Frame>0,0</Frame> <Frame>1,0</Frame> <Frame>2,0</Frame> <Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>5,0</Frame> <Frame>6,0</Frame> <Frame>7,0</Frame> <Frame>0,1</Frame> <Frame>1,1</Frame> <Frame>2,1</Frame> <Frame>3,1</Frame> <Frame>4,1</Frame> <Frame>5,1</Frame> <Frame>6,1</Frame> <Frame>7,1</Frame> <Frame>0,2</Frame> <Frame>1,2</Frame> <Frame>2,2</Frame> <Frame>3,2</Frame> <Frame>4,2</Frame> <Frame>5,2</Frame> <Frame>6,2</Frame> <Frame>7,2</Frame> <Frame>0,3</Frame> <Frame>1,3</Frame> <Frame>2,3</Frame> <Frame>3,3</Frame> <Frame>4,3</Frame> <Frame>5,3</Frame> <Frame>6,3</Frame> <Frame>7,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="antagon_Punch_Animation" playOnState="Motion.Punch" sprite="antagon_punch" animTime="350" isLoop="true">
				<Frame>1,0</Frame> <Frame>2,0</Frame> <Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>5,0</Frame> <Frame>6,0</Frame> <Frame>7,0</Frame> <Frame>0,1</Frame> <Frame>1,1</Frame> <Frame>2,1</Frame> <Frame>3,1</Frame> <Frame>4,1</Frame> <Frame>5,1</Frame> <Frame>6,1</Frame> <Frame>7,1</Frame> <Frame>0,2</Frame> <Frame>1,2</Frame> <Frame>2,2</Frame> <Frame>3,2</Frame> <Frame>4,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="antagon_Jump_Animation" playOnState="Motion.Jump" sprite="antagon_jump" animTime="400">
				<Frame>0,0</Frame> <Frame>1,0</Frame> <Frame>2,0</Frame> <Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>5,0</Frame> <Frame>6,0</Frame> <Frame>7,0</Frame> <Frame>0,1</Frame> <Frame>1,1</Frame> <Frame>2,1</Frame> <Frame>3,1</Frame> <Frame>4,1</Frame> <Frame>5,1</Frame> <Frame>6,1</Frame> <Frame>7,1</Frame> <Frame>0,2</Frame> <Frame>1,2</Frame> <Frame>2,2</Frame> <Frame>3,2</Frame> <Frame>4,2</Frame> <Frame>5,2</Frame> <Frame>6,2</Frame> <Frame>7,2</Frame> <Frame>0,3</Frame> <Frame>1,3</Frame> <Frame>2,3</Frame> <Frame>3,3</Frame> <Frame>4,3</Frame> <Frame>5,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="antagon_Fall_Animation" playOnState="Motion.Fall" sprite="antagon_fall" animTime="400" isLoop="true">
				<Frame>0,0</Frame> <Frame>1,0</Frame> <Frame>2,0</Frame> <Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>5,0</Frame> <Frame>6,0</Frame> <Frame>7,0</Frame> <Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="antagon_Walk_Animation" playOnState="Motion.Move" sprite="antagon_walk" animTime="400" isLoop="true">
				<Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>5,0</Frame> <Frame>6,0</Frame> <Frame>7,0</Frame> <Frame>0,1</Frame> <Frame>1,1</Frame> <Frame>2,1</Frame> <Frame>3,1</Frame> <Frame>4,1</Frame> <Frame>5,1</Frame> <Frame>6,1</Frame> <Frame>7,1</Frame> <Frame>0,2</Frame> <Frame>1,2</Frame> <Frame>2,2</Frame> <Frame>3,2</Frame> <Frame>4,2</Frame> <Frame>5,2</Frame> <Frame>6,2</Frame> <Frame>7,2</Frame> <Frame>0,3</Frame> <Frame>1,3</Frame> <Frame>2,3</Frame> <Frame>3,3</Frame> <Frame>4,3</Frame> <Frame>5,3</Frame> <Frame>6,3</Frame> <Frame>7,3</Frame> <Frame>0,4</Frame> <Frame>1,4</Frame> <Frame>2,4</Frame> <Frame>3,4</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">50</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="antagon_idle" offset="0,-9996" drawShadow="true" onState="Motion.Idle" scale="0.8,0.8"/>
			<SpriteRender name="antagon_punch" offset="30,-10080" drawShadow="true" onState="Motion.Punch" scale="0.8,0.8"/>
			<SpriteRender name="antagon_walk" offset="0,-9998" drawShadow="true" onState="Motion.Move" scale="0.8,0.8"/>
			<SpriteRender name="antagon_jump" offset="0,-9998" drawShadow="true" onState="Motion.Jump" scale="0.8,0.8"/>
            <SpriteRender name="antagon_fall" offset="0,-9998" drawShadow="true" onState="Motion.Fall" scale="0.8,0.8"/>
			
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_cannon" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="0,9" />
		<Sprite name="s_ember" fileName="game/particles11.rttex" textureSize="32" frame="21,21" />
		<Sprite name="s_muzzleFlash" fileName="game/particles12.rttex" textureSize="32" frame="29,1" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="30,1" />
		<Animations>
			<SpriteAnimation name="a_cannon" sprite="s_cannon" animTime="400" isLoop="true" playOnState="Idle.No">
				<Frame>0,9</Frame>
				<Frame>1,9</Frame>
				<Frame>2,9</Frame>
				<Frame>3,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_cannonIdle" sprite="s_cannon" animTime="400" isLoop="true" playOnState="Idle.Yes">
				<Frame>4,9</Frame>
				<Frame>5,9</Frame>
				<Frame>6,9</Frame>
				<Frame>7,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punch" sprite="s_punch" animTime="200">
				<Frame>30,1</Frame>
				<Frame>31,1</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Idle">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition type="or">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_ember">
				<Emitter attachment="handspotRoot">
					<Set name="offset">16, 8</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_ember</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Set name="lifeTime">1.5</Set>
					<RandomRadial name="initialVelocity" angleRange="210,330" radiusRange="5,15" />
					<Random name="initialRotationRate" min="-90" max="90" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_muzzleFlash">
				<Emitter attachment="handspotRoot">
					<Set name="offset">2, 24</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzleFlash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punch" updateStage="RenderBackHandItem" updateState="Punch.Yes">
				<Emitter attachment="handspotRoot">
					<Set name="offset">0, 19</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">29,19</Set>
			<Set name="FrameCount">4</Set>
			<Set name="RenderObjectName">AquaticVolcanicCannonTileStamp</Set>
			<Set name="RenderDefaultCracks">true</Set>
		</TileStampData>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="ArmAngle" onState="Idle.Yes">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-90</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
		<ParticleSystemUpdate name="ps_ember" onState="Punch.No"/>
		</AddClothingParticles>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderBackArm>
			<ContextUpdate type="PositionSinPulse" onState="Punch.Yes">
				<Set name="period">200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderBackArm>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<ParticleSystemRender name="ps_ember" />
			<Group onState="Idle.Yes">
				<Rotate>180,0,0,1</Rotate>
				<Translate>-2,-8,0</Translate>
				<SpriteRender name="s_cannon" flip="1,0" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
			</Group>
			<Group onState="Punch.Yes">
				<Rotate>90,0,0,1</Rotate>
				<Translate>-6,0,0</Translate>
				<SpriteRender name="s_cannon" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" />
				<ParticleSystemUpdate name="ps_muzzleFlash" />
				<ParticleSystemRender name="ps_muzzleFlash" />
			</Group>
			<Group onState="Punch.No">
				<Group onState="Idle.No">
					<Translate>-4,2,0</Translate>
					<SpriteRender name="s_cannon" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" />
				</Group>
			</Group>
		</RenderBackHandItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>	
		<Sprite name="s_hat" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="18,14"/>
		<Sprite name="s_hat_glow" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="19,14"/>
		<Sprite name="smoke" fileName="game/particles11.rttex" textureSize="32" frame="24,21"/>
		<Sprite name="ember" fileName="game/particles11.rttex" textureSize="32" frame="21,21"/>
		<Sprite name="fire" fileName="game/particles11.rttex" textureSize="32" frame="24,19"/>
		<Sprite name="meteor" fileName="game/particles11.rttex" textureSize="32" frame="25,19"/>
		<Sprite name="HitSpark_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="trail_Sprite" fileName="game/particles.rttex" textureSize="32" frame="4,0"/>
		<Animations>
			<SpriteAnimation name="HitSpark_Anim" autoPlay="false" isLoop="false" sprite="HitSpark_Sprite"  animTime="200">
				<Frame>30, 18</Frame>
				<Frame>30, 19</Frame>
			</SpriteAnimation>
			<SpriteCurveAnimation name="hat" isLoop="true" autoPlay="true" sprite="s_hat_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>	
			<SpriteAnimation name="smoke_anim" autoPlay="true" sprite="smoke" animTime="1000">
				<Frame>24, 20</Frame>
				<Frame>25, 20</Frame>
				<Frame>26, 20</Frame>
				<Frame>27, 20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="trail_anim" autoPlay="true" sprite="trail_Sprite" animTime="1200">
				<Frame>3, 0</Frame>
				<Frame>4, 0</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="UserNameOffset">8</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAT</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ember_particle_left" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">-7, -40</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">0.6</Set>
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">ember</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="initialScale" min="0.75" max="1.25"/>
					<RandomRadial name="initialVelocity" angleRange="50,95" radiusRange="-20,-60"/>
					<Set name="gravityVector">0, 45</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ember_particle_right" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">7, -40</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">0.6</Set>
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">ember</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="initialScale" min="0.75" max="1.25"/>
					<RandomRadial name="initialVelocity" angleRange="-50,-95" radiusRange="20,60"/>
					<Set name="gravityVector">0, 45</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="fire_particle">
				<Emitter attachment="targetPos">
					<Set name="infParticles">true</Set>
					<Set name="offset">0,-38</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.08</Set>
					<Set name="particlesPerEmission">4</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">fire</Set>
					<Select name="offset" input="punchCount">
						<Item>-40, -36</Item>
						<Item>40, -36</Item>
						<Item>0, -46</Item>
					</Select>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initialAlpha">0.5</Set>
					<Set name="finalAlpha">0.1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Random name="lifeTime" min="0.3" max="0.5"/>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1.5,1.5</Set>
					<Set name="finalScale">0.5,1.0</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>	
			<ParticleSystem name="meteor_particle">
				<Emitter attachment="targetPos">
					<Set name="offset">0,-48</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">meteor</Set>
					<Select name="offset" input="punchCount">
						<Item>-40, -32</Item>
						<Item>40, -32</Item>
						<Item>0, -42</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hitSpark_particle" secondary="trail_particle">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">HitSpark_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">2,2</Set>
					<Random name="finalScale" min="0.1" max="0.4"/>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200"/>
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300"/>
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">80</Set>
					<Set name="emissionInterval">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">trail_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="initialRotationRate">150</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 0</KeyFrame>
						<KeyFrame>0.4, 1, 1</KeyFrame>
						<KeyFrame>0.8, 0.3, 0.3</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.8, 0</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialVelocity">0,0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="smoke_particle" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">1.5, -49</Set>
					<Random name="emissionInterval" min="0.5" max="2"/>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">smoke</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1, 1</Set>
					<Set name="finalScale">2, 2</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">0, -40</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">29,19</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
	</Data>
	<RenderRules>		
		<OnPunchStart>
			<ParticleSystemUpdate name="fire_particle"/>
			<ParticleSystemUpdate name="meteor_particle"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<AddClothingParticles>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ParticleSystemUpdate name="smoke_particle"/>
			<ParticleSystemUpdate name="ember_particle_left"/>
			<ParticleSystemUpdate name="ember_particle_right"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="punch_particleTrail"/>
			<ParticleSystemOff name="hitSpark_particle"/>
			<ParticleSystemOff name="ember_particle_left"/>
			<ParticleSystemOff name="ember_particle_right"/>
			<ParticleSystemOff name="smoke_particle"/>
			<ParticleSystemOff name="fire_particle"/>
			<ParticleSystemOff name="meteor_particle"/>
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="hitSpark_particle"/>
		</OnDestroyedTile>
		<RenderHat>
			<SpriteRender name="s_hat" offset="0,-16" alignment="DOWN_CENTER"/>
			<SpriteRender name="s_hat_glow" offset="0,-16" alignment="DOWN_CENTER"/>
		</RenderHat>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_punch" fileName="game/particles11.rttex" textureSize="32" frame="12,26" />
		<Sprite name="s_gloveBack" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="6,8" />
		<Sprite name="s_gloveBack_glow" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="7,8" />
		<Sprite name="s_gloveFront" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="4,8" />
