	<RenderRules>
		<OnDrawCustomOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">getCurrent</Set>
        <Set name="brightness">getCurrent</Set>
        <Set name="contrast">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="RenderData">
        <Set name="saturation">10</Set>
        <Set name="brightness">1</Set>
        <Set name="contrast">1</Set>
      </AvatarTransform>
      <AvatarOutline duration="1500" startScale="1,1" endScale="1.1,1.1">
			  <Colours>
          <Colour>255,0,255,255</Colour>
          <Colour>255,0,0,255</Colour>
          <Colour>0,255,255,255</Colour>
        </Colours>
      </AvatarOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">1</Set>
        <Set name="brightness">10</Set>
        <Set name="contrast">1</Set>
      </AvatarTransform>
      <AvatarOutline duration="1500" startScale="1,1" endScale="1.05,1.05">
			  <Colours>
          <Colour>255,255,255,255</Colour>
        </Colours>
      </AvatarOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">reset</Set>
        <Set name="brightness">reset</Set>
        <Set name="contrast">reset</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">reset</Set>
      </AvatarTransform>
    </OnDrawCustomOutline>
    <RenderBackpack>
			<SpriteRender name="ColorWingSprite" offset="-4,-16" alignmentLeft="LEFT_CENTER" drawShadow="false" alignmentRight="RIGHT_CENTER" />
			<SpriteRender name="ColorWingSprite" offset="4,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" drawShadow="false" alignmentRight="LEFT_CENTER" />
			<SpriteRender name="WingSprite" offset="-4,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" />
			<SpriteRender name="WingSprite" offset="4,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" />
		</RenderBackpack>
		<AddClothingParticles>
			<ParticleSystemUpdate name="LeftWingTrailSmoke" onState="IdleState.NotIdle"/>
			<ParticleSystemUpdate name="RightWingTrailSmoke"  onState="IdleState.NotIdle"/>
			<ParticleSystemUpdate name="LeftWingShards" />
			<ParticleSystemUpdate name="RightWingShards" />
			<ParticleSystemUpdate name="LeftWingStaticSmoke" onState="IdleState.Idle" />
			<ParticleSystemUpdate name="RightWingStaticSmoke" onState="IdleState.Idle" />
			<ParticleSystemUpdate name="LeftWingAnimatedSmokeStatic" />
			<ParticleSystemUpdate name="RightWingAnimatedSmokeStatic" />
		</AddClothingParticles>
		<RenderBehind>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="LeftWingTrailSmoke" />
			<ParticleSystemRender name="RightWingTrailSmoke" />
			<ParticleSystemRender name="LeftWingStaticSmoke" />
			<ParticleSystemRender name="RightWingStaticSmoke" />
			<ParticleSystemRender name="LeftWingAnimatedSmokeStatic" />
			<ParticleSystemRender name="RightWingAnimatedSmokeStatic" />
			<ParticleSystemRender name="LeftWingShards" />
			<ParticleSystemRender name="RightWingShards" />
		</RenderBehind>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="RightWingAnimatedSmokeStatic" />
			<ParticleSystemOff name="LeftWingAnimatedSmokeStatic" />
			<ParticleSystemOff name="LeftWingTrailSmoke" />
			<ParticleSystemOff name="RightWingTrailSmoke" />
			<ParticleSystemOff name="LeftWingStaticSmoke" />
			<ParticleSystemOff name="RightWingStaticSmoke" />
			<ParticleSystemOff name="LeftWingShards" />
			<ParticleSystemOff name="RightWingShards" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_capeBack" fileName="game/particles12.rttex" textureSize="32"/>
    <Sprite name="s_hand_on_top" fileName="game/particles12.rttex" textureSize="32" frame="15,10"/>
    <Sprite name="s_punch_hand" fileName="game/particles12.rttex" textureSize="32"/>
    <Sprite name="s_double_jump_hand" fileName="game/particles12.rttex" textureSize="32" frame="14,10"/>

    <Animations>
      <SpriteAnimation name="a_cape" sprite="s_capeBack" isLoop="true" animTime="100" autoPlay="false" playOnState="Motion.Idle">
        <Frame>7,10</Frame>
      </SpriteAnimation>          
		<SpriteAnimation name="moving" sprite="s_capeBack" isLoop="true" animTime="600" autoPlay="false" playOnState="HandWalking.GoingToTarget">
        <Frame>8,10</Frame>
        <Frame>9,10</Frame>
        <Frame>10,10</Frame>
        <Frame>11,10</Frame>
        <Frame>12,10</Frame>
        <Frame>13,10</Frame>
      </SpriteAnimation>   
		<SpriteAnimation name="fallTopHand" sprite="s_hand_on_top" isLoop="false" animTime="400" autoPlay="false" playOnState="Motion.BeforeFall">
		    <Frame>16,10</Frame>
			<Frame>15,10</Frame>
	    </SpriteAnimation>
	    <SpriteAnimation name="fallTopHand_fall" sprite="s_hand_on_top" isLoop="true" animTime="50" autoPlay="false" playOnState="Motion.Fall">
		    <Frame>15,10</Frame>
	    </SpriteAnimation>

		<SpriteAnimation name="on_punch" sprite="s_punch_hand" isLoop="true" animTime="400" autoPlay="false" playOnState="Action.Punch|Action.PunchAfter">
			<Frame>17,10</Frame>
			<Frame>18,10</Frame>
			<Frame>19,10</Frame>
			<Frame>20,10</Frame>
		</SpriteAnimation>	


		<InterpolationFloatAnimation name="fishMove_afterfall" variableName="fishPositionVariable.x" targetVariableName="targetPosition.x" isLoop="false" animTime="50" playOnState="Motion.AfterFall|Motion.Fall" />
		<InterpolationFloatAnimation name="i_fishSnapped" variableName="fishPositionVariable.x" offsetVariableName="targetOffset.x" targetVariableName="targetPosition.x" isLoop="false" animTime="15000" playOnState="HandWalking.GoingToTarget" />
		
		<InterpolationFloatAnimation name="upperHandMove" variableName="upperhandOffsetTemp.y" targetValue="-26" isLoop="false" animTime="250" playOnState="Motion.BeforeFall" />
		<InterpolationFloatAnimation name="upperHandMoveBack" variableName="upperhandOffsetTemp.y" targetValue="-50" isLoop="false" animTime="350" playOnState="Motion.AfterFall" />

		<SpriteCurveAnimation name="hand_on_top_alpha_on" isLoop="false" autoPlay="false" sprite="s_hand_on_top" animTime="200" playOnState="Motion.BeforeFall">
			<Curve name="alpha">
				<KeyFrame>0.f, 0.f</KeyFrame>
				<KeyFrame>0.4f, 1.f</KeyFrame>
				<KeyFrame>1.f, 1.f</KeyFrame>
			</Curve>
		</SpriteCurveAnimation>

		<SpriteCurveAnimation name="hand_on_top_alpha_off_idle" isLoop="true" sprite="s_hand_on_top" animTime="50" playOnState="Motion.Idle|Motion.Horizontal">
			<Curve name="alpha">
				<KeyFrame>0.f, 0.f</KeyFrame>
				<KeyFrame>1.f, 0.f</KeyFrame>
			</Curve>
		</SpriteCurveAnimation>		
		
		<SpriteCurveAnimation name="hand_on_top_alpha_off_afterfall" isLoop="false" sprite="s_hand_on_top" animTime="200" playOnState="Motion.AfterFall">
			<Curve name="alpha">
				<KeyFrame>0.f, 1.f</KeyFrame>
				<KeyFrame>1.f, 0.f</KeyFrame>
			</Curve>d
		</SpriteCurveAnimation>		

		<SpriteCurveAnimation name="hand_on_left_alpha_on" isLoop="false" sprite="s_capeBack" animTime="200" playOnState="Motion.AfterFall">
			<Curve name="alpha">
				<KeyFrame>0.f, 0</KeyFrame>
				<KeyFrame>1.f, 1.f</KeyFrame>
			</Curve>
		</SpriteCurveAnimation>
		
		<SpriteCurveAnimation name="hand_on_left_alpha_off_duringfall" isLoop="true" sprite="s_capeBack" animTime="50" playOnState="Motion.Fall|Motion.BeforeFall">
			<Curve name="alpha">
				<KeyFrame>0.f, 0.f</KeyFrame>
				<KeyFrame>1.f, 0.f</KeyFrame>
			</Curve>
		</SpriteCurveAnimation>

		<SpriteCurveAnimation name="hand_on_left_alpha_on_idleForce" isLoop="true" sprite="s_capeBack" animTime="50" playOnState="Motion.Idle|Motion.Horizontal">
			<Curve name="alpha">
				<KeyFrame>0.f, 1.f</KeyFrame>
				<KeyFrame>1.f, 1.f</KeyFrame>
			</Curve>
		</SpriteCurveAnimation>

		<SpriteCurveAnimation name="hand_on_left_alpha_off_idle" isLoop="false" sprite="s_capeBack" animTime="200" playOnState="Motion.BeforeJump">
			<Curve name="alpha">
				<KeyFrame>0.f, 1.f</KeyFrame>
				<KeyFrame>1.f, 0.f</KeyFrame>
			</Curve>
		</SpriteCurveAnimation>
    </Animations>
    <ParticleSystems>
	    <ParticleSystem name="punch_start_particle_left">
		    <Emitter attachment="targetPos" onPunchCount="even">
			    <Set name="offset">-8, 0</Set>
		
			    <Set name="checkParticleNumToEmit">true</Set>
			    <Set name="particlesPerEmission">1</Set>
			    <Set name="particlesToEmit">1</Set>
		    </Emitter>
		    <Particle>
			    <Set name="sprite">s_punch_hand</Set>
			    <Set name="offset">0, -38</Set>
			    <Set name="initialVelocity">0,192</Set>
			    <Curve name="initialAlpha">
				    <KeyFrame>0, 1</KeyFrame>
				    <KeyFrame>0.6, 1</KeyFrame>
				    <KeyFrame>1, 0</KeyFrame>
			    </Curve>
			    <Set name="flipX">false</Set>
			    <Set name="inSpecificOrder">true</Set>
			    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
			    <Set name="lifeTime">0.45</Set>
			    <Set name="initialScale">1,1</Set>
		    </Particle>
	    </ParticleSystem>
	    <ParticleSystem name="punch_start_particle_right">
		    <Emitter attachment="targetPos" onPunchCount="odd">
			    <Set name="offset">8, 0</Set>
			    <Set name="checkParticleNumToEmit">true</Set>
			    <Set name="particlesPerEmission">1</Set>
			    <Set name="particlesToEmit">1</Set>
		    </Emitter>
		    <Particle>
			    <Set name="offset">0, -38</Set>
			    <Set name="initialVelocity">0,192</Set>
			    <Curve name="initialAlpha">
				    <KeyFrame>0, 1</KeyFrame>
				    <KeyFrame>0.6, 1</KeyFrame>
				    <KeyFrame>1, 0</KeyFrame>
			    </Curve>
			    <Set name="sprite">s_punch_hand</Set>
			    <Set name="flipX">true</Set>
			    <Set name="inSpecificOrder">true</Set>
			    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
			    <Set name="lifeTime">0.45</Set>
			    <Set name="initialScale">1,1</Set>
		    </Particle>
	    </ParticleSystem>
	    <ParticleSystem name="jumpHand">
		    <Emitter>
			    <Set name="particlesPerEmission">1</Set>
			    <Set name="particlesToEmit">1</Set>
			    <Set name="offset">0,12</Set>
		    </Emitter>
		    <Particle>
			    <Set name="sprite">s_double_jump_hand</Set>
			    <Set name="lifeTime">0.75</Set>
			    <Curve name="initialAlpha">
				    <KeyFrame>0, 1</KeyFrame>
				    <KeyFrame>0.5, 1</KeyFrame>
				    <KeyFrame>1, 0</KeyFrame>
			    </Curve>
			
			    <Set name="initialScale">1.5,1.5</Set>
			    <Set name="offset">0,0</Set>
		    </Particle>
	    </ParticleSystem>
    </ParticleSystems>
	  <StateMachines>
		  <StateMachine name="Action">
			  <States>
				  <State name="None" />
				  <State name="Punch" />
				  <State name="PunchAfter" ExitTime="0.2"/>
			  </States>
			  <Transitions>
				  <Transition to="None" from="PunchAfter">
					  <Condition>
						  <IsAction operatorType="NotEqual">PUNCH</IsAction>
					  </Condition>
				  </Transition>
				  <Transition to="PunchAfter" from="Punch"/>
				  <Transition to="Punch" from="None">
					  <Condition>
						  <IsAction>PUNCH</IsAction>
					  </Condition>
				  </Transition>
			  </Transitions>
		  </StateMachine>
		  <StateMachine name="Facing">
			  <States>
				  <State name="Left" />
				  <State name="Right" />
			  </States>
			  <Transitions>
				  <Transition to="Left" from="Right">
					  <Condition>
						  <IsFacingLeft>true</IsFacingLeft>
					  </Condition>
				  </Transition>
				  <Transition to="Right" from="Left">
					  <Condition>
						  <IsFacingLeft>false</IsFacingLeft>
					  </Condition>
				  </Transition>
			  </Transitions>
		  </StateMachine>
		  <StateMachine name="HandWalking">
			  <States>
				  <State name="GoingToTarget" />
				  <State name="TargetReached" />
			  </States>
			  <Transitions>
				  <Transition to="TargetReached" from="GoingToTarget">
					  <Condition type="and">
						  <CompareCustomVariable operatorType="LessOrEqual" VariableNameToCompare="targetDistance.x">3</CompareCustomVariable>
						  <CompareCustomVariable operatorType="GreaterOrEqual" VariableNameToCompare="targetDistance.x">-3</CompareCustomVariable>
					  </Condition>
				  </Transition>
				  <Transition to="GoingToTarget" from="TargetReached">
					  <Condition type="or">
						  <CompareCustomVariable operatorType="Greater" VariableNameToCompare="targetDistance.x">3</CompareCustomVariable>
						  <CompareCustomVariable operatorType="Less" VariableNameToCompare="targetDistance.x">-3</CompareCustomVariable>
					  </Condition>
				  </Transition>
			  </Transitions>
		  </StateMachine>
		  <StateMachine name="Motion">
			  <States>
				  <State name="Idle"/>
				  <State name="BeforeJump" ExitTime="0.125"/>
				  <State name="Jump" />
				  <State name="Fall"/>
				  <State name="BeforeFall" ExitTime="0.125"/>
				  <State name="AfterFall" ExitTime="0.2"/>
				  <State name="Horizontal"/>
			  </States>
			  <Transitions>
				  <Transition to="Idle" from="Jump|Horizontal">
					  <Condition>
						  <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
					  </Condition>
				  </Transition>
				  <Transition to="BeforeJump" from="Idle|Horizontal">
					  <Condition>
						  <IsVariableFloat name="speed.y" operator="Less">0</IsVariableFloat>
					  </Condition>
				  </Transition>		  
				  <Transition to="Jump" from="BeforeJump"/>
				  <Transition to="BeforeFall" from="Idle|Jump|Horizontal">
					  <Condition>
						  <IsVariableBool name="onGround">false</IsVariableBool>
					  </Condition>
				  </Transition>
				  <Transition to="Fall" from="BeforeFall"/>
				  <Transition to="AfterFall" from="Fall">
					  <Condition>
						  <IsVariableBool name="onGround">true</IsVariableBool>
					  </Condition>
				  </Transition>
				  <Transition to="Idle" from="AfterFall">
					  <Condition type="and">
						  <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						  <IsVariableBool name="onGround">true</IsVariableBool>
					  </Condition>
				  </Transition>
				  <Transition to="BeforeJump" from="AfterFall">
					  <Condition>
						  <IsAction>JUMPSTART</IsAction>
					  </Condition>
				  </Transition>
				  <Transition to="Horizontal" from="AfterFall">
					  <Condition type="and">
						  <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						  <IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
						  <IsVariableBool name="onGround">true</IsVariableBool>
					  </Condition>
				  </Transition>
				  <Transition to="Horizontal" from="Idle">
					  <Condition type="and">
						  <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						  <IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
					  </Condition>
				  </Transition>
			  </Transitions>
		  </StateMachine>
	  </StateMachines>
    <RenderOptions>
	    <Default>
		    <Set name="IgnorePunchTypeCheck">false</Set>
		    <Set name="IgnoreDefaultDamagedTileEffect">false</Set>
	    </Default>
    </RenderOptions>
    <VariableMap>
	    <Set name="baloonOffsetIdle">0, 0, 0</Set>
	    <Set name="baloonOffset">0, 0, 0</Set>
	    <Set name="baloonOffsetRight">-50, 0, 0</Set>
	    <Set name="baloonOffsetLeft">50, 0, 0</Set>
	    <Set name="playerPositionVariable">0, 0, 0</Set>
	    <Set name="fishPositionVariable">0, 0, 0</Set>
	    <Set name="fishPositionVariableTemp">0, 0, 0</Set>
	    <Set name="facingVariable">1, 1, 1</Set>
	    <Set name="sittingOffset">0, 0, 0</Set>
	    <Set name="localScale">1, 1, 1</Set>
	    <Set name="upperhandOffset">0, -50, 0</Set>
	    <Set name="upperhandOffsetTemp">0, -50, 0</Set>
	    <Set name="targetPosition">0, 0, 0</Set>
	    <Set name="targetDistance">0, 0, 0</Set>
	    <Set name="targetOffset">32, 0, 0</Set>

    </VariableMap>
  </Data>
  <RenderRules>
	  <OnEnteredToWorld>
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariable.x" RightHandVariableName="playerPositionVariable.x" OperationType="Set" />
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp.x" RightHandVariableName="playerPositionVariable.x" OperationType="Set" />
	  </OnEnteredToWorld>		
	  <OnRespawned>
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariable.x" RightHandVariableName="playerPositionVariable.x" OperationType="Set" />
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp.x" RightHandVariableName="playerPositionVariable.x" OperationType="Set" />
	  </OnRespawned>
	  <OnItemEquipped>
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariable.x" RightHandVariableName="playerPositionVariable.x" OperationType="Set" />
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp.x" RightHandVariableName="playerPositionVariable.x" OperationType="Set" />
	  </OnItemEquipped>
    <RenderBackpack>
	    <StopIf>
		    <IsVariableBool name="isMannequin">true</IsVariableBool>
	    </StopIf>
	    <StopIf type="or">
		    <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
		    <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
		    <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
	    </StopIf>
	    <Group>
		    <StopIf>
			    <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
		    </StopIf>
		    <ArithmethicOperation LeftHandVariableName="baloonOffset" RightHandVariableName="baloonOffsetRight" OperationType="Set" onState="Facing.Right" />
		    <ArithmethicOperation LeftHandVariableName="baloonOffset" RightHandVariableName="baloonOffsetLeft" OperationType="Set" onState="Facing.Left" />
			
		    <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp.x" RightHandVariableName="fishPositionVariable.x" OperationType="Set" />
		    <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp.x" RightHandVariableName="playerPositionVariable.x" OperationType="Substract" />
		    <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp.x" RightHandVariableName="facingVariable.x" OperationType="Multiply"/>
			
		    <ArithmethicOperation LeftHandVariableName="baloonOffsetIdle" RightHandVariableName="sittingOffset" OperationType="Set" />

			
		    <ArithmethicOperation LeftHandVariableName="playerPositionVariable.x" RightHandVariableName="baloonOffsetIdle.x" OperationType="Substract" />

		    <ArithmethicOperation LeftHandVariableName="targetPosition" RightHandVariableName="playerPositionVariable" OperationType="Set" />
		    <ArithmethicOperation LeftHandVariableName="targetPosition" RightHandVariableName="baloonOffset" OperationType="Add"/>
			
		    <ArithmethicOperation LeftHandVariableName="targetDistance.x" RightHandVariableName="targetPosition.x" OperationType="Set"/>
		    <ArithmethicOperation LeftHandVariableName="targetDistance.x" RightHandVariableName="fishPositionVariable.x" OperationType="Substract"/>

		    <ArithmethicOperation LeftHandVariableName="targetOffset.x" RightHandVariableName="-32" OperationType="Set" onState="HandWalking.GoingToTarget"/>
		    <ArithmethicOperation LeftHandVariableName="targetOffset.x" RightHandVariableName="0" OperationType="Set" onState="HandWalking.TargetReached"/>
			<ArithmethicOperation LeftHandVariableName="targetOffset.x" RightHandVariableName="facingVariable.x" OperationType="Multiply"/>
			
		
			
	
		</Group>
	    <Translate>baloonOffsetIdle</Translate>
	    <Translate>fishPositionVariableTemp</Translate>
	    <SpriteRender name="s_capeBack" alignment="DOWN_CENTER" />
	</RenderBackpack>
	<RenderFrontpack>
		<Translate>upperhandOffsetTemp</Translate>
		<SpriteRender name="s_hand_on_top" offset="0,0" alignment="DOWN_CENTER" />
	 </RenderFrontpack>
	  <OnPunchUpdate>
		  <AvatarTransform class="Face">
			  <Set name="face">MAD</Set>
		  </AvatarTransform>
		  <AvatarTransform class="ArmAngle">
			  <Set name="armName">arm2Angle</Set>
			  <Set name="pointTowardsPunchTarget">true</Set>
		  </AvatarTransform>
	  </OnPunchUpdate>
	  <OnPunchStart>
		  <ParticleSystemUpdate name="punch_start_particle_left" />
		  <ParticleSystemUpdate name="punch_start_particle_right" />
	  </OnPunchStart>	  
	  <OnPunchStop>
		  <ParticleSystemOff name="punch_start_particle_left" />
		  <ParticleSystemOff name="punch_start_particle_right" />
	  </OnPunchStop>
	  <AddClothingParticles>
		  <ParticleSystemUpdate name="jumpHand" onAction="JUMPDOUBLE"/>

	  </AddClothingParticles>
	  <SwitchOffClothingParticles>
		  <ParticleSystemOff name="jumpHand"/>
		  <ParticleSystemOff name="punch_start_particle_left"/>
		  <ParticleSystemOff name="punch_start_particle_right"/>
	  </SwitchOffClothingParticles>
	  <RenderInFront>
		  <ParticleSystemRender name="punch_start_particle_left" />
		  <ParticleSystemRender name="punch_start_particle_right" />
		  <StopIf>
			  <IsVariableBool name="isMannequin">false</IsVariableBool>
		  </StopIf>
		  <SpriteRender name="s_capeBack" offset="-32,2" alignment="DOWN_CENTER" />
	  </RenderInFront>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_cannon" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="0,8" />
		<Sprite name="s_ember" fileName="game/particles11.rttex" textureSize="32" frame="24,21" />
		<Sprite name="s_muzzleFlash" fileName="game/particles12.rttex" textureSize="32" frame="29,0" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="30,0" />
		<Animations>a
			<SpriteAnimation name="a_cannon" sprite="s_cannon" animTime="400" isLoop="true" playOnState="Idle.No">
				<Frame>0,8</Frame>
				<Frame>1,8</Frame>
				<Frame>2,8</Frame>
				<Frame>3,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_cannonIdle" sprite="s_cannon" animTime="400" isLoop="true" playOnState="Idle.Yes">
				<Frame>4,8</Frame>
				<Frame>5,8</Frame>
				<Frame>6,8</Frame>
				<Frame>7,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punch" sprite="s_punch" animTime="200">
				<Frame>30,0</Frame>
				<Frame>31,0</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Idle">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition type="or">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_ember">
				<Emitter attachment="handspotRoot">
					<Set name="offset">16, 8</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_ember</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Set name="lifeTime">1.5</Set>
					<RandomRadial name="initialVelocity" angleRange="210,330" radiusRange="5,15" />
					<Random name="initialRotationRate" min="-90" max="90" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_muzzleFlash">
				<Emitter attachment="handspotRoot">
					<Set name="offset">2, 24</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzleFlash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punch" updateStage="RenderBackHandItem" updateState="Punch.Yes">
				<Emitter attachment="handspotRoot">
					<Set name="offset">0, 19</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">29,18</Set>
			<Set name="FrameCount">4</Set>
			<Set name="RenderObjectName">VolcanicCannonTileStamp</Set>
			<Set name="RenderDefaultCracks">true</Set>
		</TileStampData>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="ArmAngle" onState="Idle.Yes">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-90</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
		<ParticleSystemUpdate name="ps_ember" onState="Punch.No"/>
		</AddClothingParticles>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderBackArm>
			<ContextUpdate type="PositionSinPulse" onState="Punch.Yes">
				<Set name="period">200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderBackArm>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<ParticleSystemRender name="ps_ember" />
			<Group onState="Idle.Yes">
				<Rotate>180,0,0,1</Rotate>
				<Translate>-2,-8,0</Translate>
				<SpriteRender name="s_cannon" flip="1,0" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
			</Group>
			<Group onState="Punch.Yes">
				<Rotate>90,0,0,1</Rotate>
				<Translate>-6,0,0</Translate>
				<SpriteRender name="s_cannon" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" />
				<ParticleSystemUpdate name="ps_muzzleFlash" />
				<ParticleSystemRender name="ps_muzzleFlash" />
			</Group>
			<Group onState="Punch.No">
				<Group onState="Idle.No">
					<Translate>-4,2,0</Translate>
					<SpriteRender name="s_cannon" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" />
				</Group>
			</Group>
		</RenderBackHandItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>	
		<Sprite name="s_hat" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="16,14"/>
		<Sprite name="s_hat_glow" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="17,14"/>
		<Sprite name="smoke" fileName="game/particles11.rttex" textureSize="32" frame="20,20"/>
		<Sprite name="ember" fileName="game/particles11.rttex" textureSize="32" frame="24,21"/>
		<Sprite name="fire" fileName="game/particles11.rttex" textureSize="32" frame="24,18"/>
		<Sprite name="meteor" fileName="game/particles11.rttex" textureSize="32" frame="25,18"/>
		<Sprite name="HitSpark_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="trail_Sprite" fileName="game/particles.rttex" textureSize="32" frame="4,0"/>
		<Animations>
			<SpriteAnimation name="HitSpark_Anim" autoPlay="false" isLoop="false" sprite="HitSpark_Sprite"  animTime="200">
				<Frame>30, 18</Frame>
				<Frame>30, 19</Frame>
			</SpriteAnimation>
			<SpriteCurveAnimation name="hat" isLoop="true" autoPlay="true" sprite="s_hat_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>	
			<SpriteAnimation name="smoke_anim" autoPlay="true" sprite="smoke" animTime="800">
				<Frame>20, 20</Frame>
				<Frame>21, 20</Frame>
				<Frame>22, 20</Frame>
				<Frame>23, 20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="trail_anim" autoPlay="true" sprite="trail_Sprite" animTime="1200">
				<Frame>3, 0</Frame>
				<Frame>4, 0</Frame>
			</SpriteAnimation>
		</Animations>
		
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="UserNameOffset">8</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAT</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ember_particle_left" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">-7, -40</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">0.6</Set>
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">ember</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="initialScale" min="0.75" max="1.25"/>
					<RandomRadial name="initialVelocity" angleRange="50,95" radiusRange="-20,-60"/>
					<Set name="gravityVector">0, 45</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ember_particle_right" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">7, -40</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">0.6</Set>
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">ember</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="initialScale" min="0.75" max="1.25"/>
					<RandomRadial name="initialVelocity" angleRange="-50,-95" radiusRange="20,60"/>
					<Set name="gravityVector">0, 45</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="fire_particle">
				<Emitter attachment="targetPos">
					<Set name="infParticles">true</Set>
					<Set name="offset">0,-38</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.08</Set>
					<Set name="particlesPerEmission">4</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">fire</Set>
					<Select name="offset" input="punchCount">
						<Item>-40, -36</Item>
						<Item>40, -36</Item>
						<Item>0, -46</Item>
					</Select>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initialAlpha">0.5</Set>
					<Set name="finalAlpha">0.1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Random name="lifeTime" min="0.3" max="0.5"/>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1.5,1.5</Set>
					<Set name="finalScale">0.5,1.0</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>	
			<ParticleSystem name="meteor_particle">
				<Emitter attachment="targetPos">
					<Set name="offset">0,-48</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">meteor</Set>
					<Select name="offset" input="punchCount">
						<Item>-40, -32</Item>
						<Item>40, -32</Item>
						<Item>0, -42</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hitSpark_particle" secondary="trail_particle">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">HitSpark_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">2,2</Set>
					<Random name="finalScale" min="0.1" max="0.4"/>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200"/>
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300"/>
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">80</Set>
					<Set name="emissionInterval">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">trail_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="initialRotationRate">150</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 0</KeyFrame>
						<KeyFrame>0.4, 1, 1</KeyFrame>
						<KeyFrame>0.8, 0.3, 0.3</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.8, 0</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialVelocity">0,0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="smoke_particle" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">1.5, -49</Set>
					<Random name="emissionInterval" min="0.5" max="2"/>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">smoke</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1, 1</Set>
					<Set name="finalScale">2, 2</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">0, -40</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">29,18</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
	</Data>
	<RenderRules>		
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnPunchStart>
			<ParticleSystemUpdate name="fire_particle"/>
			<ParticleSystemUpdate name="meteor_particle"/>
		</OnPunchStart>
		<AddClothingParticles>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ParticleSystemUpdate name="smoke_particle"/>
			<ParticleSystemUpdate name="ember_particle_left"/>
			<ParticleSystemUpdate name="ember_particle_right"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="punch_particleTrail"/>
			<ParticleSystemOff name="hitSpark_particle"/>
			<ParticleSystemOff name="ember_particle_left"/>
			<ParticleSystemOff name="ember_particle_right"/>
			<ParticleSystemOff name="smoke_particle"/>
			<ParticleSystemOff name="fire_particle"/>
			<ParticleSystemOff name="meteor_particle"/>
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="hitSpark_particle"/>
		</OnDestroyedTile>
		<RenderHat>
			<SpriteRender name="s_hat" offset="0,-16" alignment="DOWN_CENTER"/>
			<SpriteRender name="s_hat_glow" offset="0,-16" alignment="DOWN_CENTER"/>
		</RenderHat>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_punch" fileName="game/particles11.rttex" textureSize="32" frame="12,26" />
		<Sprite name="s_gloveBack" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="2,8" />
		<Sprite name="s_gloveBack_glow" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="3,8" />
		<Sprite name="s_gloveFront" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="0,8" />
		<Sprite name="s_gloveFront_glow" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="1,8" />
		<Sprite name="s_aura" fileName="game/particles12.rttex" textureSize="32" frame="23,19"/>
		<Sprite name="s_Trail" fileName="game/particles11.rttex" textureSize="32" frame="12,26" />
		<Animations>
			<SpriteCurveAnimation name="a_gloveFront_glow" isLoop="true" autoPlay="true" sprite="s_gloveFront_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="a_gloveBack_glow" isLoop="true" autoPlay="true" sprite="s_gloveBack_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_punch" sprite="s_punch" animTime="200">
				<Frame>12,26</Frame>
				<Frame>13,26</Frame>
				<Frame>14,26</Frame>
				<Frame>15,26</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_aura" sprite="s_aura">
				<Frame>23,18</Frame>
				<Frame>24,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Trail" sprite="s_Trail" animTime="400">
				<Frame>12,26</Frame>
				<Frame>13,26</Frame>
				<Frame>14,26</Frame>
				<Frame>15,26</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Moving">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Horizontal">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_punchBack" updateStage="RenderBackHandItem" updateState="Punch.Yes">
				<Emitter attachment="handspotRoot">
					<Set name="offset">-2, 6</Set>
					<Set name="lifeTime">0.01</Set>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.45</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
					<Set name="initalRGB">1, 0.5, 0</Set>
					<Set name="finalRGB">1, 0.9, 0</Set>
					<Set name="interpolateRGB">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>1, 0.5</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5" max="0.6"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchFront">
				<Emitter attachment="handspotRoot">
					<Set name="offset">0,10</Set>
					<Set name="lifeTime">0.01</Set>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.45</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
					<Set name="initalRGB">1, 0.5, 0</Set>
					<Set name="finalRGB">1, 0.9, 0</Set>
					<Set name="interpolateRGB">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>1, 0.5</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5" max="0.6"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_thrustBack">
				<Emitter attachment="handspotRoot">
					<Set name="offset">12, 24</Set>
					<Set name="lifeTime">0.07</Set>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="initialVelocity" source="thrustVel"/>
					<Set name="initalRGB">1, 0.5, 0</Set>
					<Set name="finalRGB">1, 0.9, 0</Set>
					<Set name="interpolateRGB">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>1, 0.5</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_thrustFront">
				<Emitter attachment="handspotRoot">
					<Set name="offset">1, 13</Set>
					<Set name="lifeTime">0.07</Set>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="initialVelocity" source="thrustVel"/>
					<Set name="initalRGB">1, 0.5, 0</Set>
					<Set name="finalRGB">1, 0.9, 0</Set>
					<Set name="interpolateRGB">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>1, 0.5</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_frontSmoke" updateStage="AddClothingParticles" renderStage="RenderHandItem">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">-8,0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="inSpecificOrder">true</Set>
					<Set name="sprite">s_aura</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="initialVelocity" min="-5, -7" max="5, -10" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.75</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0.75, 0.75</KeyFrame>
					</Curve>
					<Set name="lifeTime">2</Set>
					<Random name="flipX" min="false" max="true"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_backSmoke" updateStage="AddClothingParticles" renderStage="RenderBackHandItem">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">10,0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="inSpecificOrder">true</Set>
					<Set name="sprite">s_aura</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="initialVelocity" min="-5, -7" max="5, -10" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.75</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0.75, 0.75</KeyFrame>
					</Curve>
					<Set name="lifeTime">2</Set>
					<Random name="flipX" min="false" max="true"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Platform" updateStage="RenderHandItem" renderStage="RenderHandItem" updateState="Moving.Yes">
				<Emitter>
					<Set name="offset">40, 19</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialVelocity" source="platformVel"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0.5</KeyFrame>
					</Curve>
					<Set name="finalRGB">1, 0.65, 0</Set>
					<Set name="initalRGB">1, 0.9, 0</Set>
					<Set name="interpolateRGB">true</Set>
					<Random name="initialScale" min="1,1" max="0.8,0.8"/>
					<Set name="lifeTime">0.4</Set>
					<Set name="relativeToEmitter">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail" updateStage="RenderHandItem" renderStage="RenderHandItem" updateState="Horizontal.Yes">
				<Emitter>
					<Set name="offset">5, 19</Set>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.3</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" angleRelativeToPlayerSpeed="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0.5</KeyFrame>
						<KeyFrame>0.3, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,0.9</KeyFrame>
						<KeyFrame>1, 1,0.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">1, 0.65, 0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<TileStampData>
			<Set name="RenderObjectName">VolcanicGauntletsTileStamp</Set>
			<Set name="RenderDefaultCracks">true</Set>
			<Sprites>
				<Sprite fname="game/particles12.rttex" scale="1.3,1">
					<Animation animTime="100">
						<Frame>7,18</Frame>
						<Frame>8,18</Frame>
						<Frame>9,18</Frame>
						<Frame>10,18</Frame>
					</Animation>
				</Sprite>
				<Sprite fname="game/particles12.rttex" scale="1.3,1">
					<Animation animTime="100">
						<Frame>11,18</Frame>
						<Frame>12,18</Frame>
						<Frame>13,18</Frame>
						<Frame>14,18</Frame>
					</Animation>
				</Sprite>
				<Sprite fname="game/particles12.rttex" scale="1.3,1">
					<Animation animTime="100">
						<Frame>15,18</Frame>
						<Frame>16,18</Frame>
						<Frame>17,18</Frame>
						<Frame>18,18</Frame>
					</Animation>
				</Sprite>
				<Sprite fname="game/particles12.rttex" scale="1.3,1">
					<Animation animTime="100">
						<Frame>19,18</Frame>
						<Frame>20,18</Frame>
						<Frame>21,18</Frame>
						<Frame>22,18</Frame>
					</Animation>
				</Sprite>
			</Sprites>
		</TileStampData>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="RenderBackArmBuild">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="TargetPosUseTileHealth">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="thrustVel">0,0</Set>
			<Set name="platformVel">0,0</Set>
			<Set name="Player.GetFacing">0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<Update>
			<StopIf type="Or">
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="thrustVel" RightHandVariableName="30,20" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="thrustVel.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="platformVel" RightHandVariableName="-95,0" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="platformVel.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<Group onState="Moving.Yes">
				<AvatarTransform class="Face">
					<Set name="face">MAD</Set>
				</AvatarTransform>
				<Group onState="Punch.No">
					<AvatarTransform class="ArmAngle">
						<Set name="armName">arm1Angle</Set>
						<Set name="armAngle">-50</Set>
					</AvatarTransform>
				</Group>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">-50</Set>
				</AvatarTransform>
			</Group>
		</Update>
		<AddClothingParticles>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Group onState="Moving.Yes">
				<Group onState="Punch.No">
					<ParticleSystemUpdate name="ps_thrustBack"/>
				</Group>
				<ParticleSystemUpdate name="ps_thrustFront"/>
			</Group>
		</AddClothingParticles>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<Group onState="Moving.No">
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm2Angle</Set>
					<Set name="pointTowardsPunchTarget">true</Set>
				</AvatarTransform>
			</Group>
		</OnPunchUpdate>
		<RenderHandItem>
			<SpriteRender name="s_gloveFront" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" />
			<SpriteRender name="s_gloveFront_glow" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" />
			<Group onState="Moving.No">
				<ParticleSystemUpdate name="ps_punchFront" onState="Punch.Yes"/>
			</Group>
		</RenderHandItem>
		<RenderBackHandItem>
			<StopIf>
				<IsAction>BUILD</IsAction>
			</StopIf>
			<SpriteRender offset="-2,5" rotateOffset="true" rotationPoint="0,1" name="s_gloveBack" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" />
			<SpriteRender offset="-3,5" rotateOffset="true" rotationPoint="0,1" name="s_gloveBack_glow" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" />
		</RenderBackHandItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_axe" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="3,12"/>
    <Sprite name="s_punch_watermelon" fileName="game/particles12.rttex" textureSize="32" frame="28,12"/>
    <Sprite name="s_punch_watermelon_trail" fileName="game/particles10.rttex" textureSize="32" frame="17,27"/>
    <Sprite name="s_punch_splash" fileName="game/particles10.rttex" textureSize="32" frame="19,27"/>
    <Sprite name="s_punch_chunks" fileName="game/particles10.rttex" textureSize="32" frame="16,27"/>

    <Animations>
      <SpriteAnimation name="a_axe_equip" autoPlay="false" sprite="s_axe" playOnState="Action.None">
        <Frame>3,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_axe_punch" autoPlay="false" sprite="s_axe" playOnState="Action.Punch">
        <Frame>4,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punch_watermelon_trail" autoPlay="false" sprite="s_punch_watermelon_trail">
        <Frame>17,27</Frame>
        <Frame>18,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punch_chunks" autoPlay="false" sprite="s_punch_chunks">
        <Frame>16,27</Frame>
        <Frame>17,27</Frame>
        <Frame>18,27</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition type="or">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsZombified>true</IsZombified>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_punch" secondary="ps_punch_trail">
        <Emitter>
          <Set name="offset">9,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch_watermelon</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialScale">1,1</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Select name="initialRotationRate" input="randomNumber">
            <Item>-600</Item>
            <Item>600</Item>
          </Select>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punch_trail">
        <Emitter>
          <Set name="lifeTime">0.4</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">80</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_punch_watermelon_trail</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="initialVelocity" source="trail.velocity.final"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5" max="1" />
          <Random name="offset" min="-8,-8" max="8,8" />
          <Select name="initialRotationRate" input="randomNumber">
            <Item>-600</Item>
            <Item>600</Item>
          </Select>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_chunks">
        <Emitter>
          <Set name="particlesPerEmission">20</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_punch_chunks</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>

          <Random name="initialScale" min="0.5" max="0.75" />
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,100"/>
          <Set name="gravityVector">0, 60</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_splash">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="delayTimer">0.1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch_splash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.8,0.8</KeyFrame>
            <KeyFrame>1, 1.2, 1.2</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.75</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <VariableMap>
      <Set name="Player.GetFacing">0</Set>
      <Set name="trail.velocity.original">-40,0,0</Set>
      <Set name="trail.velocity.final">50, 50</Set>
      <Set name="Punch.GetPosition">0,0,0</Set>
      <Set name="Context.GetPosition">0,0,0</Set>
    </VariableMap>

    <RenderOptions>
      <Default>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderHandItem>
      <Translate>4,-7,0</Translate>
      <SpriteRender name="s_axe" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" />
    </RenderHandItem>
    <Update>
      <Group onState="Action.Punch">
        <ArithmethicOperation LeftHandVariableName="trail.velocity.final" RightHandVariableName="Punch.GetPosition" OperationType="Set"/>
        <ArithmethicOperation LeftHandVariableName="trail.velocity.final" RightHandVariableName="Context.GetPosition" OperationType="Substract"/>
        <ArithmethicOperation LeftHandVariableName="trail.velocity.final" RightHandVariableName="trail.velocity.original" OperationType="Normalize"/>
      </Group>
    </Update>
    <OnPunchStart>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <ParticleSystemUpdate name="ps_punch"/>
    </OnPunchStart>
    <OnPunchUpdate>
      <Group onState="Action.Punch">
        <AvatarTransform class="Face">
          <Set name="face">MAD</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="armAngle">1500</Set>
          <Set name="isAdditive">true</Set>
        </AvatarTransform>
      </Group>
    </OnPunchUpdate>
    <OnDamagedTile>
        <ParticleSystemUpdate name="ps_splash"/>
        <ParticleSystemUpdate name="ps_chunks"/>
    </OnDamagedTile>
    <OnDestroyedTile>
        <ParticleSystemUpdate name="ps_splash"/>
        <ParticleSystemUpdate name="ps_chunks"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="s_Chunkzooka" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="27,14"/>
		<Sprite name="s_MuzzleFlash" fileName="game/particles10.rttex" textureSize="32" frame="7,22"/>
		<Sprite name="s_Punch" fileName="game/particles10.rttex" textureSize="32" frame="8,22"/>
		<Sprite name="s_Splat" fileName="game/particles10.rttex" textureSize="32" frame="9,22"/>
		<Sprite name="s_Crack" fileName="game/particles10.rttex" textureSize="32" frame="10,23"/>
		<Sprite name="s_Chunk" fileName="game/particles10.rttex" textureSize="32" frame="10,22"/>
		
		<ParticleSystems>
			<ParticleSystem name="Chunks" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">15</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Chunk</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,100"/>
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="0" max="360"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="MuzzleFlash" updateStage="RenderBackHandItem" updateState="Action.Punch" renderStage="RenderBackHandItem">
				<Emitter attachment="handspotRoot">
					<Set name="offset">7, 21</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_MuzzleFlash</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Punch" updateStage="RenderBackHandItem" updateState="Action.Punch" secondary="Splat">
				<Emitter attachment="handspotRoot">
					<Set name="offset">6, 3</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Splat">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.4</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Splat</Set>
					<Random name="offset" min="-4, -4" max="4, 4"/>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.5, 1.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Set name="gravityVector">0, 20</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="RenderBackArmBuild">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
			</Default>
		</RenderOptions>

		<TileStampData>
			<Set name="FileName">game/particles10.rttex</Set>
			<Set name="EndFrame">10,23</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
	</Data>

	<RenderRules>
		<OnPunchUpdate>
			<AvatarTransform class="Emotion">
				<Set name="emotion">WRY</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderBackArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderBackArm>
		<RenderBackHandItem>
			<StopIf>
				<IsAction>BUILD</IsAction>
			</StopIf>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<SpriteRender name="s_Chunkzooka" offset="8,-6" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackHandItem>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_spinner" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="25,28" />
    <Sprite name="s_JumpParticles" fileName="game/particles10.rttex" textureSize="32" frame="6,25"/>
    
    <Animations>
      <CurveAnimationFloat name="a_rotationSpeedJump" playOnState="Action.Jump" isLoop="true" animTime="10000">
        <Curve name="rotation_speed">
          <KeyFrame>0, 800</KeyFrame>
          <KeyFrame>1, 800</KeyFrame>
        </Curve>
      </CurveAnimationFloat>
      <CurveAnimationFloat name="a_rotationSpeedInAir" playOnState="Action.InAir" isLoop="false" animTime="1000">
        <Curve name="rotation_speed">
          <KeyFrame>0, 800</KeyFrame>
          <KeyFrame>1, 400</KeyFrame>
        </Curve>
      </CurveAnimationFloat>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None"/>
          <State name="Jump" ExitTime="0.2"/>
          <State name="InAir"/>
        </States>
        <Transitions>
          <Transition to="None" from="InAir">
            <Condition type="and">
              <IsAction operatorType="NotEqual">JUMP</IsAction>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="InAir" from="Jump">
            <Condition >
              <IsAction operatorType="NotEqual">JUMP</IsAction>
            </Condition>
          </Transition>
          <Transition to="Jump" from="None|InAir">
            <Condition>
              <IsAction>JUMP</IsAction>
            </Condition>
          </Transition>
          <Transition to="InAir" from="None">
            <Condition type="and">
              <IsAction operatorType="NotEqual">JUMP</IsAction>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <VariableMap>
      <Set name="spinner_rotation">0, 0, 0, 1</Set>
      <Set name="spinner_offset">0, -16, 0</Set>
      <Set name="DeltaTime">0.0</Set>
      <Set name="rotation_speed">10.0</Set>
    </VariableMap>

    <ParticleSystems>
      <ParticleSystem name="ps_JumpParticles">
        <Emitter>
          <Set name="offset">0, -24</Set>
          <Set name="lifeTime">0.75</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">8</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_JumpParticles</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="initalRGB">1, 1, 1</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">true</Set>
          <Set name="lifeTime">0.75</Set>
          <Random name="initialScale" min="0.5" max="1"/>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  
  <RenderRules>
    <Update>
      <StopIf>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MANNEQUIN</IsRenderMod>
        <IsRenderMod>RENDER_MOD_COLORED_SHADOW</IsRenderMod>
      </StopIf>
      <Group onState="Action.None">
        <ArithmethicOperation LeftHandVariableName="spinner_rotation.x" RightHandVariableName="0" OperationType="Set"/>
      </Group>
      <Group onState="Action.InAir|Action.Jump">
        <ArithmethicOperation LeftHandVariableName="DeltaTime" RightHandVariableName="rotation_speed" OperationType="Multiply"/>
        <ArithmethicOperation LeftHandVariableName="spinner_rotation.x" RightHandVariableName="DeltaTime" OperationType="Add"/>
      </Group>
    </Update>
    <RenderBackpack>
      <Translate>spinner_offset</Translate>
      <Rotate>spinner_rotation</Rotate>
      <Translate>0,1,0</Translate>
      <SpriteRender name="s_spinner" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackpack>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_JumpParticles" onAction="JUMPSTART|JUMPDOUBLE"/>
    </AddClothingParticles>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_glove1" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="27,30" />
		<Sprite name="s_glove2" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="27,30" />
		<Sprite name="s_web" fileName="game/particles12.rttex" textureSize="32" frame="20,4" />
		<Sprite name="s_webRing" fileName="game/particles12.rttex" textureSize="32" frame="21,4" />
		<Animations>
			<SpriteAnimation name="a_glove_idle" sprite="s_glove2" autoPlay="true" isLoop="true" playOnState="Grip.No">
				<Frame>27,30</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glove_punch" sprite="s_glove2" autoPlay="true" isLoop="true" playOnState="Grip.Yes">
				<Frame>28,30</Frame>
			</SpriteAnimation>
			
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmInTheFront">false</Set>
			</Default>
			<Override overrideOnState="Web.Yes">
				<Set name="RenderBackArmInTheFront">true</Set>
			</Override>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_web">
				<Emitter attachment="targetPos">
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle>
					<Set name="lifeTime" source="web.lifetime"/>
					<Set name="sprite">s_webRing</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.95, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_webHit">
				<Emitter attachment="targetPos">
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="delayTimer">0.0</Set>
					
				</Emitter>
				<Particle>
					<Set name="lifeTime">0.1</Set>
					<Set name="sprite">s_webRing</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.95, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Web">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<CompareCustomVariable operatorType="LessOrEqual" VariableNameToCompare="web.timer">0</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<CompareCustomVariable operatorType="Greater" VariableNameToCompare="web.timer">0</CompareCustomVariable>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Grip">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="web.timer">0</Set>
			<Set name="web.duration">2</Set>
			<Set name="web.lifetime">0</Set>
			<Set name="DeltaTime">0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<Update>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<Group onState="Web.Yes">
				<StopIf>
					<IsAction>BUILD</IsAction>
				</StopIf>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm1Angle</Set>
					<Set name="pointTowardsPunchTarget">true</Set>
				</AvatarTransform>
			</Group>
			<ArithmethicOperation LeftHandVariableName="web.timer" RightHandVariableName="DeltaTime" OperationType="Substract" />
		</Update>
		<RenderHandItem>	
			<SpriteRender name="s_glove1" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="UPPER_CENTER" />		
		</RenderHandItem>
		<RenderBehind>
			<StopIf type="or">
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">false</IsSitting>
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group onState="Web.Yes">
				<Translate>0,10,0</Translate>
				<SpriteRender name="s_web" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" />
				<ParticleSystemUpdate name="ps_webHit"/>
			</Group>
		</RenderBehind>
		<RenderBackHandItem value="shoulder">
			<StopIf type="and">
				<IsAction>PUNCH</IsAction>
				<IsZombified>true</IsZombified>
			</StopIf>
			<StopIf>
				<IsAction>BUILD</IsAction>
			</StopIf>
			<SpriteRender name="s_glove2" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="UPPER_CENTER" />
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group onState="Web.Yes">
				<Translate>0,10,0</Translate>
				<SpriteRender name="s_web" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" />
				<ParticleSystemUpdate name="ps_webHit"/>
			</Group>
		</RenderBackHandItem>
		<OnPunchStart>
			<ArithmethicOperation LeftHandVariableName="web.duration" RightHandVariableName="0.4" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="web.lifetime" RightHandVariableName="0.4" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="web.timer" RightHandVariableName="web.duration" OperationType="Set" />
			<ParticleSystemUpdate name="ps_web"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="web.duration" RightHandVariableName="2.5" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="web.lifetime" RightHandVariableName="2.5" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="web.timer" RightHandVariableName="web.duration" OperationType="Set" />
		</OnDamagedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="item_sprite" fileName="game/player_feet16.rttex" textureSize="32" frame="11,26"/>
    <Sprite name="s_waterDrop" fileName="game/particles12.rttex" textureSize="32" frame="7,20"/>

    <Animations>
      <SpriteAnimation name="equip_anim" sprite="item_sprite" autoPlay="true" animTime="800" isLoop="true">
        <Frame>11,26</Frame>
        <Frame>12,26</Frame>
        <Frame>13,26</Frame>
        <Frame>14,26</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_waterDrop" sprite="s_waterDrop" autoPlay="false" animTime="1000" isLoop="true">
        <Frame>10,20</Frame>
        <Frame>7,20</Frame>
        <Frame>8,20</Frame>
        <Frame>9,20</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="No" />
          <State name="Yes" />
        </States>
        <Transitions>
          <Transition to="No" from="Yes">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Yes" from="No">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ember_particle_left" updateStage="AddClothingParticles" renderStage="RenderShoes">
        <Emitter>
          <Set name="offset">-7, 0</Set>
          <Set name="offsetFacing">false</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="useCharacterPos">false</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="lifeTime">0.3</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_waterDrop</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="useGravity">true</Set>
          <Set name="lifeTime">1</Set>
          <Random name="offset" min="0,-7" max="0,0"/>
          <Set name="inSpecificOrder">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Random name="initialScale" min="0.5" max="1"/>
          <RandomRadial name="initialVelocity" angleRange="50,0" radiusRange="-30,-80"/>
          <Set name="gravityVector">0, 45</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ember_particle_right" updateStage="AddClothingParticles" renderStage="RenderShoes">
        <Emitter>
          <Set name="offset">7, 0</Set>
          <Set name="offsetFacing">false</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="useCharacterPos">false</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="lifeTime">0.3</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_waterDrop</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="useGravity">true</Set>
          <Set name="lifeTime">1</Set>
          <Random name="offset" min="0,-7" max="0,0"/>
          <Set name="inSpecificOrder">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Random name="initialScale" min="0.5" max="1"/>
          <RandomRadial name="initialVelocity" angleRange="-50,0" radiusRange="30,80"/>
          <Set name="gravityVector">0, 45</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IsToRenderPants">false</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="ClothingOffsetFromShoes">-7</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="UserNameOffset">8</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IsSurfboard">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderShoes>
      <SpriteRender name="item_sprite" offset="0,-10"/>
    </RenderShoes>
    
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">45</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Punch.No">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">310</Set>
      </AvatarTransform>
    </Update>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_body" fileName="game/particles_large17.rttex" textureSize="64" frame="0,10" />
		<Sprite name="s_head" fileName="game/particles_large17.rttex" textureSize="64" frame="0,9" />
		<Sprite name="s_headPunch" fileName="game/particles_large17.rttex" textureSize="64" frame="12,9" />
		<Sprite name="s_punch" fileName="game/particles.rttex" textureSize="32" frame="4,14" />
		<Sprite name="s_trunk" fileName="game/particles12.rttex" textureSize="32" frame="26,10" />
		<Sprite name="s_tusk" fileName="game/particles_large17.rttex" textureSize="64" frame="13,9" />
		<Animations>
			<SpriteAnimation name="a_idle1" sprite="s_body" animTime="800" isLoop="true" playOnState="Movement.Idle">
				<Frame>0,10</Frame>
				<Frame>1,10</Frame>
				<Frame>2,10</Frame>
				<Frame>3,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_idle2" sprite="s_head" animTime="800" isLoop="true" playOnState="Movement.Idle">
				<Frame>0,9</Frame>
				<Frame>1,9</Frame>
				<Frame>2,9</Frame>
				<Frame>3,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_move1" sprite="s_body" animTime="400" isLoop="true" playOnState="Movement.Move">
				<Frame>4,10</Frame>
				<Frame>5,10</Frame>
				<Frame>6,10</Frame>
				<Frame>7,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_move2" sprite="s_head" animTime="400" isLoop="true" playOnState="Movement.Move">
				<Frame>4,9</Frame>
				<Frame>5,9</Frame>
				<Frame>6,9</Frame>
				<Frame>7,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_jump1" sprite="s_head" animTime="400" isLoop="true" playOnState="Movement.Jump">
				<Frame>8,9</Frame>
				<Frame>9,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_jump2" sprite="s_body" animTime="400" isLoop="true" playOnState="Movement.Jump">
				<Frame>8,10</Frame>
				<Frame>9,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_fall1" sprite="s_head" animTime="400" isLoop="true" playOnState="Movement.Fall">
				<Frame>10,9</Frame>
				<Frame>11,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_fall2" sprite="s_body" animTime="400" isLoop="true" playOnState="Movement.Fall">
				<Frame>10,10</Frame>
				<Frame>11,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punch" sprite="s_trunk" animTime="400" isLoop="true" playOnState="Action.Punch">
				<Frame>26,10</Frame>
				<Frame>27,10</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Movement">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-11</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">false</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="IsCar">true</Set>
				<Set name="CarCastSmokeParticle">false</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="UserNameOffset">18</Set>
				<Set name="AllowChangePunchType">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="target.angle">0</Set>
			<Set name="turret.Rotation">0</Set>
		</VariableMap>
		<ParticleSystems>
			<ParticleSystem name="p_punch">
				<Emitter attachment="contextRotation">
					<Set name="offset">0, 0</Set>
					<Set name="emissionInterval">0.001</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.25</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
					<Random name="targetPosOffset" min="-15, -8" max="15, 8"/>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<OnFinish>
						<ParticleSystemName>p_splash</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_splash" >
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="emissionInterval">0.5</Set>
					<Random name="particlesPerEmission" min="1" max="4"/>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 0.25, 0.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,75" baseAnglePosition="targetPos" baseOffset="0,16"/>
					<Set name="gravityVector">0, 45</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="ArmAngle" onState="Action.Punch">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-30</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<SpriteRender name="s_body" offset="32,14" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
			<SpriteRender name="s_head" offset="-32,14" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" onState="Action.None"/>
			<SpriteRender name="s_headPunch" offset="-32,14" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" onState="Action.Punch"/>
			<Group onState="Action.Punch">
				<ArithmethicOperation LeftHandVariableName="turret.Rotation" RightHandVariableName="target.angle" OperationType="Set" />
				<Group>
					<Translate>13, 0.5, 0</Translate>
					<Rotate forceValue="true" incrementRotate="true">turret.Rotation</Rotate>
					<Group onState="Facing.Right">
						<SpriteRender name="s_trunk" alignment="LEFT_CENTER"/>
					</Group>
					<Group onState="Facing.Left">
						<Rotate incrementRotate="true">0,0,0,1</Rotate>
						<SpriteRender name="s_trunk" alignment="RIGHT_CENTER"/>
					</Group>
				</Group>
				<SpriteRender name="s_tusk" offset="-32,14" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT"/>
			</Group>
		</RenderShoes>
		<OnPunchStart>
			<Translate>13, 0.5, 0</Translate>
			<Rotate forceValue="true" incrementRotate="true">turret.Rotation</Rotate>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsSitting>true</IsSitting>
			</StopIf>
			<Translate onState="Facing.Right">0,3,0</Translate>
			<Translate onState="Facing.Left">0,-1,0</Translate>
			<ParticleSystemUpdate name="p_punch"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile />
		<OnDestroyedTile />
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_front_hair" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="0,12"/>
    <Sprite name="s_back_hair" fileName="game/particles_large19.rttex" textureSize="64" frame="0,0"/>
    
    <Animations>
      <SpriteAnimation name="a_front_hair" sprite="s_front_hair" isLoop="true" animTime="1400" playOnState="Action.Equip">
        <Frame>0,12</Frame>
        <Frame>1,12</Frame>
        <Frame>2,12</Frame>
        <Frame>3,12</Frame>
        <Frame>4,12</Frame>
        <Frame>5,12</Frame>
        <Frame>6,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_back_hair" sprite="s_back_hair" isLoop="true" animTime="1400" playOnState="Action.Equip">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_front_hair_jump" sprite="s_front_hair" isLoop="true" animTime="800" playOnState="Action.Jump">
        <Frame>0,13</Frame>
        <Frame>1,13</Frame>
        <Frame>2,13</Frame>
        <Frame>3,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_back_hair_jump" sprite="s_back_hair" isLoop="true" animTime="800" playOnState="Action.Jump">
        <Frame>7,0</Frame>
        <Frame>8,0</Frame>
        <Frame>9,0</Frame>
        <Frame>10,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_front_hair_fall" sprite="s_front_hair" isLoop="true" animTime="400" playOnState="Action.Fall">
        <Frame>4,13</Frame>
        <Frame>5,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_back_hair_fall" sprite="s_back_hair" isLoop="true" animTime="400" playOnState="Action.Fall">
        <Frame>11,0</Frame>
        <Frame>12,0</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Equip" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Equip" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Equip|Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Equip|Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

  </Data>

  <RenderRules>
    <RenderBackHair>
      <StopIf>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <SpriteRender name="s_back_hair" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackHair>
    <RenderHair>
      <SpriteRender name="s_front_hair" alignment="DOWN_CENTER" offset="0,-16" blend="PREMULTIPLIED_ALPHA"/>
    </RenderHair>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Pet" fileName="game/pets/p_ahool.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_Wing" fileName="game/particles_large13.rttex" textureSize="64" frame="13,2" />
		<Animations>
			<SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="300" isLoop="true" playOnState="Action.None">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PetPunch" sprite="s_Pet" animTime="200" isLoop="true" playOnState="Action.Punch">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_WingFly" sprite="s_Wing" animTime="300" isLoop="true" playOnState="VMotion.Up">
				<Frame>13,2</Frame>
				<Frame>12,3</Frame>
				<Frame>13,3</Frame>
				<Frame>12,3</Frame>
				<Frame>13,2</Frame>
				<Frame>12,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_WingGlide" sprite="s_Wing" animTime="100" playOnState="VMotion.Down">
				<Frame>12,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_WingGround" sprite="s_Wing" animTime="100" playOnState="VMotion.None">
				<Frame>13,2</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="VMotion">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
				</States>
				<Transitions>
					<Transition to="None" from="Up|Down">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Up" from="None|Down">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Down" from="None|Up">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="HideWings">
				<States>
					<State name="True"/>
					<State name="False"/>
				</States>
				<Transitions>
					<Transition to="True" from="False">
						<Condition>
							<ItemHasTag>HIDE_WINGS</ItemHasTag>
						</Condition>
					</Transition>
					<Transition to="False" from="True">
						<Condition>
							<ItemHasTag operatorType="NotEqual">HIDE_WINGS</ItemHasTag>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ShowPet">
				<States>
					<State name="True"/>
					<State name="False"/>
				</States>
				<Transitions>
					<Transition to="True" from="False">
						<Condition>
							<ItemHasTag>SHOW_PET</ItemHasTag>
						</Condition>
					</Transition>
					<Transition to="False" from="True">
						<Condition>
							<ItemHasTag operatorType="NotEqual">SHOW_PET</ItemHasTag>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IsNightVision">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">32,0</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderBackpack>
			<SpriteRender flip="0,0" name="s_Wing" offset="-32,-18" onState="HideWings.False" />
			<SpriteRender flip="1,0" name="s_Wing" offset="32,-18" onState="HideWings.False" />
		</RenderBackpack>
		<RenderPet>
			<SpriteRender name="s_Pet" alignment="DOWN_CENTER" onState="ShowPet.True"/>
		</RenderPet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
    <Data>
		<Sprite name="s_FeatheredWingTop" fileName="game/particles_large17.rttex" textureSize="64" frame="0,1" />
		<Sprite name="s_FeatheredWingTipTop" fileName="game/particles_large17.rttex" textureSize="64" frame="1,1" />
		<Sprite name="s_FeatheredWingBottom" fileName="game/particles_large17.rttex" textureSize="64" frame="0,0" />
		<Sprite name="s_FeatheredWingTipBottom" fileName="game/particles_large17.rttex" textureSize="64" frame="1,0" />
		<Sprite name="s_FeatheredTrail" fileName="game/particles12.rttex" textureSize="32" frame="21,11" />
		<Sprite name="s_MechanicalWingTop" fileName="game/particles_large17.rttex" textureSize="64" frame="0,5" />
		<Sprite name="s_MechanicalWingTipTop" fileName="game/particles_large17.rttex" textureSize="64" frame="1,5" />
		<Sprite name="s_MechanicalWingBottom" fileName="game/particles_large17.rttex" textureSize="64" frame="0,4" />
		<Sprite name="s_MechanicalWingTipBottom" fileName="game/particles_large17.rttex" textureSize="64" frame="1,4" />
		<Sprite name="s_MechanicalTrail" fileName="game/particles12.rttex" textureSize="32" frame="22,11" />
		<Sprite name="s_MechanicalSpark" fileName="game/particles12.rttex" textureSize="32" frame="21,12" />
        <Animations>
			<!-- Idle -->
            <SpriteAnimation name="a_FeatheredWingTop_Idle" sprite="s_FeatheredWingTop" isLoop="true" playOnState="Movement.Idle" animTime="400">
                <Frame>0,1</Frame>
                <Frame>2,1</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_FeatheredWingTipTop_Idle" sprite="s_FeatheredWingTipTop" isLoop="true" playOnState="Movement.Idle" animTime="400">
                <Frame>1,1</Frame>
                <Frame>3,1</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_FeatheredWingBottom_Idle" sprite="s_FeatheredWingBottom" isLoop="true" playOnState="Movement.Idle" animTime="400">
                <Frame>0,0</Frame>
                <Frame>2,0</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_FeatheredWingTipBottom_Idle" sprite="s_FeatheredWingTipBottom" isLoop="true" playOnState="Movement.Idle" animTime="400">
                <Frame>1,0</Frame>
                <Frame>3,0</Frame>
            </SpriteAnimation>
			<!-- Jump -->
			<SpriteAnimation name="a_FeatheredWingTop_Jump" sprite="s_FeatheredWingTop" isLoop="false" playOnState="Movement.Jump" animTime="400">
                <Frame>0,3</Frame>
                <Frame>2,3</Frame>
				<Frame>4,3</Frame>
				<Frame>8,1</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_FeatheredWingTipTop_Jump" sprite="s_FeatheredWingTipTop" isLoop="false" playOnState="Movement.Jump" animTime="400">
                <Frame>1,3</Frame>
                <Frame>3,3</Frame>
				<Frame>5,3</Frame>
				<Frame>9,1</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_FeatheredWingBottom_Jump" sprite="s_FeatheredWingBottom" isLoop="false" playOnState="Movement.Jump" animTime="400">
                <Frame>0,2</Frame>
                <Frame>2,2</Frame>
				<Frame>4,2</Frame>
				<Frame>6,2</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_FeatheredWingTipBottom_Jump" sprite="s_FeatheredWingTipBottom" isLoop="false" playOnState="Movement.Jump" animTime="400">
                <Frame>1,2</Frame>
                <Frame>3,2</Frame>
				<Frame>5,2</Frame>
				<Frame>7,2</Frame>
            </SpriteAnimation>
			<!-- Fall -->
			<SpriteAnimation name="a_FeatheredWingTop_Fall" sprite="s_FeatheredWingTop" isLoop="true" playOnState="Movement.Fall" animTime="400">
                <Frame>8,1</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_FeatheredWingTipTop_Fall" sprite="s_FeatheredWingTipTop" isLoop="true" playOnState="Movement.Fall" animTime="400">
                <Frame>9,1</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_FeatheredWingBottom_Fall" sprite="s_FeatheredWingBottom" isLoop="true" playOnState="Movement.Fall" animTime="400">
                <Frame>6,2</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_FeatheredWingTipBottom_Fall" sprite="s_FeatheredWingTipBottom" isLoop="true" playOnState="Movement.Fall" animTime="400">
                <Frame>7,2</Frame>
            </SpriteAnimation>
			<!-- Mechanical Jump/Fall -->
			<SpriteCurveAnimation name="a_MechanicalWingTipTop_JumpFall" isLoop="true" sprite="s_MechanicalWingTipTop" animTime="1000" playOnState="Movement.Jump|Movement.Fall">
				<Curve name="alpha">
					<KeyFrame>0, 1</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="a_MechanicalWingTipBottom_JumpFall" isLoop="true" sprite="s_MechanicalWingTipBottom" animTime="1000" playOnState="Movement.Jump|Movement.Fall">
				<Curve name="alpha">
					<KeyFrame>0, 1</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_MechanicalSpark" sprite="s_MechanicalSpark">
