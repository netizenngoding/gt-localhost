            </SpriteCurveAnimation>
            <SpriteSinPulseAnimation name="Animation145" sprite="Sprite27" autoPlay="true" playOnState="GroundAir.OnGround">
                <Parameter name="scale.x">
                    <Set name="offset">1.5</Set>
                    <Set name="period">3000</Set>
                    <Set name="scale">0.05</Set>
