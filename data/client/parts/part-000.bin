          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">4</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,16</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_petals</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">4</Set>
          <Random name="initialScale" min="0.25" max="0.6"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-16,0" max="16,0" />
          <Random name="initialVelocity" min="20, -120" max="-20, -150" />
          <Curve name="finalVelocity">
            <KeyFrame>0.05, -20,600</KeyFrame>
            <KeyFrame>0.15, 20,600</KeyFrame>
            <KeyFrame>0.4, -0,200</KeyFrame>
            <KeyFrame>0.55, 20,200</KeyFrame>
            <KeyFrame>0.7, -20,40</KeyFrame>
            <KeyFrame>0.8, 20,40</KeyFrame>
            <KeyFrame>0.9, -20,40</KeyFrame>
            <KeyFrame>1, 20,40</KeyFrame>
          </Curve>
          <Set name="interpolateVelocity">true</Set>
          <Random name="initialRotationRate" min="-90" max="90" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <Render>
      <SpriteRender name="s_tile_sprite" blend="PREMULTIPLIED_ALPHA" />
    </Render>
    <OnTileEnter>
      <ParticleSystemUpdate name="ps_petals"/>
    </OnTileEnter>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_WEATHER_MACHINE_ANCESTRAL_PLANE">
	<Data>
		<Sprite name="s_WeatherMachine" fileName="game/tiles_page17.rttex" textureSize="32" frame="29,11" />
		
		<StateMachines>
			<StateMachine name="Toggle">
				<States>
					<State name="Off"/>
					<State name="On"/>
				</States>
				<Transitions>
					<Transition to="Off" from="On">
						<Condition>
							<IsWeatherType operatorType="NotEqual">ANCESTRAL_PLANE</IsWeatherType>
						</Condition>
					</Transition>
					<Transition to="On" from="Off">
						<Condition>
							<IsWeatherType>ANCESTRAL_PLANE</IsWeatherType>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Animations>
			<SpriteAnimation name="a_WeatherMachineOn" sprite="s_WeatherMachine" animTime="1600" isLoop="true" playOnState="Toggle.On">
				<Frame>30,11</Frame>
				<Frame>31,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_WeatherMachineOff" sprite="s_WeatherMachine" animTime="100" isLoop="true" playOnState="Toggle.Off">
				<Frame>29,11</Frame>
			</SpriteAnimation>
		</Animations>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_WeatherMachine" blend="PREMULTIPLIED_ALPHA" />
		</Render>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_ROCKET_BLOCK">
	<Data>
		<Sprite name="s_tile" fileName="game/tiles_page17.rttex" textureSize="32" frame="5,18" />
		<Sprite name="rocket_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="31,12"/>
		<Sprite name="trail_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="30,12"/>
		<Sprite name="hit_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="29,12"/>

		<Animations>
			<SpriteAnimation name="a_tile1" sprite="s_tile" isLoop="true" animTime="400" playOnState="IsOn.True">
				<Frame>6,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_tile2" playOnState="IsOn.False" sprite="s_tile">
				<Frame>5,18</Frame>
			</SpriteAnimation>
		</Animations>

		<StateMachines>
			<StateMachine name="IsOn">
				<States>
					<State name="False"/>
					<State name="True"/>
				</States>
				<Transitions>
					<Transition to="True" from="False">
						<Condition>
							<IsTileFlagActive operatorType="Equal">TILE_FLAG_IS_ON</IsTileFlagActive>
						</Condition>
					</Transition>

					<Transition to="False" from="True">
						<Condition>
							<IsTileFlagActive operatorType="NotEqual">TILE_FLAG_IS_ON</IsTileFlagActive>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>

					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<ParticleSystems>
			<ParticleSystem name="particle_right" secondary="trail_particle">
				<Emitter>
					<Random name="particlesPerEmission" min="1" max="2"/>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="offset">10,-8</Set>
					<Set name="emissionInterval">0.4</Set>
					<Set name="rgbTint">1, 1, 1, 1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">rocket_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="lifeTime" min="1.5" max="2.0"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.9, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="offset" min="-6,-6" max="6,6" />
					<Random name="initialVelocity" min="50, -80" max="75, -80" />
					<Random name="finalVelocity" min="50, 60" max="75, 90" />
					<Set name="interpolateVelocity">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<OnFinish>
						<ParticleSystemName>hit_particle</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="particle_left" secondary="trail_particle">
				<Emitter>
					<Random name="particlesPerEmission" min="1" max="2"/>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="offset">10,-8</Set>
					<Set name="emissionInterval">0.4</Set>
					<Set name="rgbTint">1, 1, 1, 1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">rocket_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="lifeTime" min="1.5" max="2.0"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.9, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="offset" min="-6,-6" max="6,6" />
					<Random name="initialVelocity" min="-50, -80" max="-75, -80" />
					<Random name="finalVelocity" min="-50, 60" max="-75, 90" />
					<Set name="interpolateVelocity">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<OnFinish>
						<ParticleSystemName>hit_particle</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">2</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">80</Set>
					<Set name="emissionInterval">0.075</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">trail_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialScale">1,1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0.35</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialVelocity">0,0</Set>

				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">20</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,30"/>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 3,3</KeyFrame>
						<KeyFrame>0.33, 1,1</KeyFrame>
						<KeyFrame>1, 1,1</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_tile" blend="PREMULTIPLIED_ALPHA" />
		</Render>
		<RenderInWorldSpaceFront>
			<Group onState="Facing.Right">
				<ParticleSystemUpdate name="particle_right" onState="IsOn.True"/>
			</Group>
			<Group onState="Facing.Left">
				<ParticleSystemUpdate name="particle_left" onState="IsOn.True"/>
			</Group>
		</RenderInWorldSpaceFront>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_SNOW_MACHINE">
  <Data>
    <Sprite name="s_tile_sprite" fileName="game/tiles_page17.rttex" textureSize="32" frame="28,10" />
    <Sprite name="s_snow" fileName="game/particles12.rttex" textureSize="32" frame="24,7"/>

    <Animations>
      <SpriteAnimation name="a_snow" autoPlay="false" sprite="s_snow">
        <Frame>24,7</Frame>
        <Frame>25,7</Frame>
        <Frame>26,7</Frame>
        <Frame>27,7</Frame>
      </SpriteAnimation>
    </Animations>
    
    <StateMachines>
      <StateMachine name="IsOn">
        <States>
          <State name="False"/>
          <State name="True"/>
        </States>
        <Transitions>
          <Transition to="True" from="False">
            <Condition>
              <IsTileFlagActive operatorType="Equal">TILE_FLAG_IS_ON</IsTileFlagActive>
            </Condition>
          </Transition>

          <Transition to="False" from="True">
            <Condition>
              <IsTileFlagActive operatorType="NotEqual">TILE_FLAG_IS_ON</IsTileFlagActive>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Facing">
        <States>
          <State name="Left"/>
          <State name="Right"/>
        </States>
        <Transitions>
          <Transition to="Right" from="Left">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>

          <Transition to="Left" from="Right">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <VariableMap>
      <Set name="tileColour">0, 0, 0</Set>
    </VariableMap>

    <ParticleSystems>
      <ParticleSystem name="snow_particle_right">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="offset">6,-10</Set>
          <Random name="emissionInterval" min="0.01" max="0.1"/>
          <Set name="rgbTint" source="tileColour"/>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_snow</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">4</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.95, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialVelocity" min="15, -30" max="85, -50" />
          <Curve name="finalVelocity">
            <KeyFrame>0, 0,40</KeyFrame>
            <KeyFrame>0.2, 0,40</KeyFrame>
            <KeyFrame>0.2, -20,40</KeyFrame>
            <KeyFrame>0.3, 20,40</KeyFrame>
            <KeyFrame>0.4, -20,40</KeyFrame>
            <KeyFrame>0.5, 20,40</KeyFrame>
            <KeyFrame>0.6, -20,40</KeyFrame>
            <KeyFrame>0.7, 20,40</KeyFrame>
            <KeyFrame>0.8, -20,40</KeyFrame>
            <KeyFrame>0.9, 20,40</KeyFrame>
            <KeyFrame>1, -20,40</KeyFrame>
          </Curve>
          <Set name="interpolateVelocity">true</Set>
          <Random name="initialRotationRate" min="-360" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="snow_particle_left">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="offset">6,-10</Set>
          <Random name="emissionInterval" min="0.01" max="0.1"/>
          <Set name="rgbTint" source="tileColour"/>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_snow</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">4</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.8</KeyFrame>
            <KeyFrame>0.95, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialVelocity" min="-15, -30" max="-85, -50" />
          <Curve name="finalVelocity">
            <KeyFrame>0, 0,40</KeyFrame>
            <KeyFrame>0.2, 0,40</KeyFrame>
            <KeyFrame>0.2, -20,40</KeyFrame>
            <KeyFrame>0.3, 20,40</KeyFrame>
            <KeyFrame>0.4, -20,40</KeyFrame>
            <KeyFrame>0.5, 20,40</KeyFrame>
            <KeyFrame>0.6, -20,40</KeyFrame>
            <KeyFrame>0.7, 20,40</KeyFrame>
            <KeyFrame>0.8, -20,40</KeyFrame>
            <KeyFrame>0.9, 20,40</KeyFrame>
            <KeyFrame>1, -20,40</KeyFrame>
          </Curve>
          <Set name="interpolateVelocity">true</Set>
          <Random name="initialRotationRate" min="-360" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <Render>
      <SpriteRender name="s_tile_sprite" blend="PREMULTIPLIED_ALPHA" />
    </Render>
    <RenderInWorldSpaceFront>
      <Group onState="Facing.Right">
        <ParticleSystemUpdate name="snow_particle_right" onState="IsOn.True"/>
      </Group>
      <Group onState="Facing.Left">
        <ParticleSystemUpdate name="snow_particle_left" onState="IsOn.True"/>
      </Group>
    </RenderInWorldSpaceFront>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_STONE_CHIMNEY">
  <Data>
    <Sprite name="s_sprite" fileName="game/tiles_page17.rttex" textureSize="32" frame="30,8" />
    <Sprite name="s_smoke" fileName="game/particles.rttex" textureSize="32" frame="4,1" />

    <Animations>
      <SpriteAnimation name="a_single" sprite="s_sprite" animTime="100" playOnState="Connect.Single">
        <Frame>30,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_top" sprite="s_sprite" animTime="100" playOnState="Connect.Top">
        <Frame>29,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_middle" sprite="s_sprite" animTime="100" playOnState="Connect.Middle">
        <Frame>28,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_bottom" sprite="s_sprite" animTime="100" playOnState="Connect.Bottom">
        <Frame>27,8</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Connect">
        <States>
          <State name="Single"/>
          <State name="Top"/>
          <State name="Middle"/>
          <State name="Bottom"/>
        </States>
        <Transitions>
          <Transition to="Single" from="Top|Middle|Bottom">
            <Condition type="and">
              <CheckTileId ItemId="ITEM_ID_STONE_CHIMNEY" Position="0,-1">false</CheckTileId>
              <CheckTileId ItemId="ITEM_ID_STONE_CHIMNEY" Position="0,1">false</CheckTileId>
            </Condition>
          </Transition>

          <Transition to="Top" from="Single|Middle|Bottom">
            <Condition type="and">
              <CheckTileId ItemId="ITEM_ID_STONE_CHIMNEY" Position="0,1">true</CheckTileId>
              <CheckTileId ItemId="ITEM_ID_STONE_CHIMNEY" Position="0,-1">false</CheckTileId>
            </Condition>
          </Transition>
          
          <Transition to="Middle" from="Single|Top|Bottom">
            <Condition type="and">
              <CheckTileId ItemId="ITEM_ID_STONE_CHIMNEY" Position="0,-1">true</CheckTileId>
              <CheckTileId ItemId="ITEM_ID_STONE_CHIMNEY" Position="0,1">true</CheckTileId>
            </Condition>
          </Transition>
          
          <Transition to="Bottom" from="Single|Top|Middle">
            <Condition type="and">
              <CheckTileId ItemId="ITEM_ID_STONE_CHIMNEY" Position="0,-1">true</CheckTileId>
              <CheckTileId ItemId="ITEM_ID_STONE_CHIMNEY" Position="0,1">false</CheckTileId>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_smoke">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Random name="emissionInterval" min="1" max="5"/>
        </Emitter>
        <Particle>
          <Set name="sprite">s_smoke</Set>
          <Random name="offset" min="-10, -16" max="10,-16" />
          <Set name="lifeTime">2</Set>
          <Set name="initialVelocity">0,-25</Set>
          <Set name="renderAlignment">DOWN_CENTER</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.1, 0.5</KeyFrame>
            <KeyFrame>0.75, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>0.33, -1, 1.33</KeyFrame>
            <KeyFrame>0.66, 1, 1.66</KeyFrame>
            <KeyFrame>1, -1, 2</KeyFrame>
          </Curve>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

  </Data>
  <RenderRules>
    <Render>
      <SpriteRender name="s_sprite" blend="PREMULTIPLIED_ALPHA" />
    </Render>
    <RenderInWorldSpaceFront>
      <ParticleSystemUpdate name="ps_smoke" onState="Connect.Top|Connect.Single"/>
    </RenderInWorldSpaceFront>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_VAMPIRE_BED">
	<Data>
		<Sprite name="s_OpenCoffin" fileName="game/tiles_page16.rttex" textureSize="32" frame="23,30" />
		<Sprite name="s_ClosedCoffin" fileName="game/tiles_page16.rttex" textureSize="32" frame="20,31" />
		<RenderOptions>
			<Default>
				<Set name="IsBed">true</Set>
				<Set name="SleepHidesPlayer">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_OpenCoffin" blend="PREMULTIPLIED_ALPHA"/>
		</Render>
		<RenderBedOverlay>
			<SpriteRender name="s_ClosedCoffin" blend="PREMULTIPLIED_ALPHA" alignment="LEFT_CENTER" offset="0,1"/>
		</RenderBedOverlay>
	</RenderRules>
</ItemRenderer><template name="BaseEventButton">
    <head>
    </head>
    <body>
        <div data-if="buttonData.buttonTemplate == 'BaseEventButton'">
            <div data-attr-class="'state' + buttonData.buttonState">
                <div class="event_button_body">
                    <div data-attr-class="buttonData.buttonClass">

                        <div class="rays"></div>
                        <div class="itemIdIcon" data-style-decorator="buttonData.itemIdIcon" />

                        <div class="label" data-rml="ToRMLText(buttonData.buttonText)" />
                        <div class="notification_icon" data-visible="buttonData.notification > 0"></div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="buttonData.buttonTemplate == 'EventButtonWithCounter'">
            <div data-attr-class="'state' + (buttonData.buttonState + ((buttonData.buttonState == 0 && (buttonData.counter >= buttonData.counterMax)) ? 1 : 0))">
                <div class="event_button_body">
                    <div data-attr-class="buttonData.buttonClass">

                        <div class="rays"></div>
                        <div class="itemIdIcon" data-style-decorator="buttonData.itemIdIcon" />

                        <div class="label" data-visible="buttonData.counter < buttonData.counterMax">{{buttonData.counter}}/{{buttonData.counterMax}}</div>
                        <div class="notification_icon" data-visible="buttonData.notification > 0"></div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="buttonData.buttonTemplate == 'FTUEButton'">
            <div data-event-click="buttonData.buttonState = ((buttonData.buttonState == 1 || buttonData.buttonState == 3) ? buttonData.buttonState - 1 : buttonData.buttonState + 1);"
                 data-class-closed="buttonData.buttonState == 0"
                 data-class-opened="buttonData.buttonState == 1 || buttonData.buttonState == 3"
                 data-class-call="buttonData.buttonState == 2">
                <div class="event_button_body">
                    <div data-attr-class="buttonData.buttonClass">
                        <div class="label" data-rml="ToRMLText(buttonData.buttonText)">
                        </div>
                        <div class="notification_icon" data-visible="buttonData.notification > 0"></div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="buttonData.buttonTemplate == 'DungeonEventButton'">
            <div class="event_button_body">
                <div data-attr-class="buttonData.buttonClass">

                    <div class="label" data-rml="ToRMLText(buttonData.buttonText)" />
                    <div class="lifeAndProgress">
                        <progress class="progressBar" data-attr-value="ToRMLText(buttonData.counter)" data-attr-max="ToRMLText(buttonData.counterMax)" />
                    </div>


                    <div class="notification_icon" data-visible="buttonData.notification > 0"></div>
                </div>
            </div>
        </div>
    </body>
</template>.window {
    width: 830dp;
}

#window-title .title-icon {
    decorator: image(dungeon_start_ui_title_icon);
}

#dungeonstartui-popup .img-button {
    padding: 10dp 20dp 10dp 20dp;
}

#dungeonstartui-popup .flex-button {
    display: flex;
    flex-direction: row;
	align-items: center;
}

#dungeonstartui-popup .row-flex {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
	align-items: center;
}

#dungeonstartui-popup .column-flex {
    display: flex;
    flex-direction: column;
	align-items: center;
}

#dungeonstartui-popup .zero-lr-padding {
    padding-left: 0dp;
    padding-right: 0dp;
}

#dungeonstartui-popup .rounded-section {
    background-color: rgba(0, 63, 77, 125);
    border-radius: 8dp;
}

#dungeonstartui-popup .img-button .icon {
    width: 40dp;
    height: 40dp;
    display: block;
    flex-shrink: 0;
    margin: 0 10dp;
}

#dungeonstartui-popup .label-with-icon {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    height: auto;
	align-items: center;
}

#dungeonstartui-popup .label-with-icon .icon {
    width: 50dp;
    height: 50dp;
    display: block;
    flex-shrink: 0;
    margin: auto 10dp auto 0;
}

#dungeonstartui-popup .label-with-icon .icon:active {
		filter: brightness(0.85);
		transform: scale(0.95);
	}

#dungeonstartui-popup .label-with-icon .title {
    display: block;
    line-height: 40dp;
    margin-left: 10dp;
	vertical-align: middle;
}

#league-section {
    height: auto;
    overflow: hidden;
    border-radius: 8dp;
    width: 100%;
    margin-bottom: 15dp;
    background-color: rgba(0, 63, 77, 125);
}

#league-section #league-bg {
    width: 100%;
    height: 100%;
    decorator: image(interface/large/gui_dungeons_league_bg.rttex cover);
    image-color: rgba(255,255,255,125);
}

#league-section #league-bg>div {
    margin: 10dp 20dp;
}

#league-section #league-banner-and-text {
    margin-left: 0dp;
}

#league-section #league-banner{
    height: 90dp;
    width: 90dp;
}

#league-section #league-button{
    margin: 0 0dp 0 0;
}

#start-section {
    width: 100%;
    height: auto;
    margin-bottom: 15dp;
}

#start-section #warning-container {
    padding: 20dp;
}

#start-section>div {
    margin: 20dp;
}

#start-section #start-button {
    width: 100%;
    margin-bottom: 10dp;
}

#start-section .row-flex {
    margin-bottom: 10dp;
}

#start-section #scrolls-counter.label-with-icon .icon {
    width: 40dp;
    height: 40dp;
}

#start-section #scrolls-counter.label-with-icon .title {
	font-effect: shadow(1dp 1dp #000);
}

#quests-section {
    width: 100%;
    height: auto;
    margin-bottom: 15dp;
}

#quests-section>div {
    margin: 20dp;
}

#info-button,
#quests-section ul li {
  position: relative;
  padding: 0;
  border-radius: 8dp;
  padding: 10dp;
}

#quests-section ul li.inprogress {
  background-color: rgba(0, 63, 77, 204);
}

#quests-section ul li.completed {
  background-color: rgba(58, 170, 53, 127);
}

#quests-section ul li.notstarted {
  background-color: rgba(126, 42, 16, 204);
}

#quests-section ul li.claimed {
  background-color: rgba(154, 154, 154, 127);
}

#info-button input,
#quests-section ul li input {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  opacity: 0;
}

#info-button input:checked ~ #dungeon-info-panel,
#quests-section ul li input:checked ~ .challenge-info * {
  display:none;
}

#info-button #info-button-text i,
#quests-section ul li i {
  decorator: image(interface/large/gui_ftue_accordion_arrow.rttex);
  width: 40dp;
  height: 40dp;
  transform: rotate(180deg);
}

#info-button input:checked ~ #info-button-text i,
#quests-section ul li input:checked ~ .challenge-title i {
    transform: rotate(0deg);
}

#quests-section .challenge-title{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    height: auto;
    align-items: center;
    vertical-align: middle;
}

#quests-section .challenge-title .icon {
    width: 40dp;
    height: 40dp;
    display: block;
    flex-shrink: 0;
    position: relative;
}

#quests-section .challenge-title .icon .check-mark {
  position: absolute;
  width: 80%;
  height: 80%;
  margin: auto;
    display: block;
    decorator: image(interface/large/gui_dungeons_check_icon.rttex);
}

#quests-section .challenge-title .title-points {
    flex-grow: 1;
    height: auto;
    margin-left: 10dp;
}

#quests-section .challenge {
    height: auto;
    display: block;
    margin: 10dp 0 0dp 0;
}

#quests-section .challenge-button {
    z-index: 1;
    margin-top: 15dp;
}



.challenge-info .reward-icon {
    position: relative;
    width: 60dp;
    height: 60dp;
    padding: 0dp;
    border: 3dp white;
    border-radius: 5dp;
    background-color: rgba(0,0,0,128);
}

.reward-icon .image {
    display: block;
    width: 50dp;
    height: 50dp;
    padding: 0dp;
    margin: auto;
}

.reward-icon .label {
    position: absolute;
    width: 100%;
    font-size: 20dp;
    text-align: right;
    bottom: 0dp;
    right: 3dp;
}

.challenge-info .rewards-panel {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    width: 100%;
    gap: 10dp;
    margin-top: 10dp;
}
.challenge-info .rewards-panel.disabled {
    filter: opacity(0.5);
}

#info-button {
	vertical-align: middle;
	align-items: center;
	justify-content: center;
    margin-bottom: 15dp;
    padding: 10dp 20dp 10dp 20dp;
}

#info-button #info-button-text {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    height: auto;
    align-items: center;
    vertical-align: middle;
}

#main-description {
    margin: 10dp 0 15dp 0;
}<rml>
  <head>
    <title>DungeonStartUi</title>
    <link type="text/template" href="../Base/BasePopup.rml" />
    <link type="text/rcss" href="../Base/WindowTitle.rcss" />
    <link type="text/rcss" href="DungeonStartUi.rcss" />
    <link type="text/template" href="../Templates/DungeonRankBanner.rml" />
  </head>
  <body template="BasePopup" class="show-scrollbar wondow-content-full wondow-content-horizontal">
    <div data-model="DungeonStartUiModel" id="dungeonstartui-popup" class="font-content">
      <div>
        <div id="window-title">
          <div class="title-icon"/>
          <div class="title-text font-title label">Dungeons</div>
        </div>

        <div id="main-description" class="color_dreamsicle" data-rml="ToRMLText(Localize('[dungeon_start_ui_desc]'))"/>

        <div id="info-button" class="rounded-section">
          <input type="checkbox" data-checked="true"/>
          <div id="info-button-text">
            <span class="label">Dungeon Information</span>
            <i/>
                  </div>
          <div id="dungeon-info-panel">
            <p class="color_dreamsicle font-contentnormal" data-rml="ToRMLText(Localize('[dungeon_info_ui_body]'))"/>
          </div>
        </div>

        <div id="start-section" class="rounded-section">
          <div>
            <!--Dungeon Start Button-->
            <div id="start-button" onclick="OnEvent(event, 'DungeonStartUi.OnStart')" class="img-button flex-button button-purple-color zero-lr-padding" data-class-disabled="DungeonStartUiModel.DisableStart">
              <span class="label">
                Start Dungeon
              </span>
              <div class="icon" data-style-decorator="'itemidimage(ITEM_ID_DUNGEONS_SCROLLS)'"/>
              <span class="label">{{DungeonStartUiModel.EnterCost}}</span>
            </div>

            <!--Scrolls & invite friends row-->
            <div class="row-flex">
              <div class="column-flex">
                <div id="scrolls-counter" class="label-with-icon">
                  <div class="icon" data-style-decorator="'itemidimage(ITEM_ID_DUNGEONS_SCROLLS)'"/>
                  <div class="title font-contentnormal color_dreamsicle">{{ItemName('ITEM_ID_DUNGEONS_SCROLLS')}}: {{DungeonStartUiModel.PiggyProgress}}/{{DungeonStartUiModel.PiggyTarget}}</div>
                  <i/>
                </div>

                <!--Display timer if required.-->
                <div data-if="DungeonStartUiModel.ScrollTimer > 0" class="font-contentnormal color_bright_purple scroll-timer">
                  <Timer data-attr-seconds="DungeonStartUiModel.ScrollTimer" sec-post-1m="true" onfinish="OnEvent(event, 'DungeonStartUi.OnScrollTimerFinish')">
                    <active>
                      <span>More in: </span>
                      <timertext/>
                    </active>
                    <expired/>
                  </Timer>
                </div>

                <!--Else show static text.-->
                <div data-if="DungeonStartUiModel.ScrollTimer == 0" class="font-contentnormal color_bright_purple scroll-timer">
                  More in: --
                </div>
              </div>


              <div id="invite-button" onclick="OnEvent(event, 'DungeonStartUi.OnInviteFriends')" class="img-button flex-button button-default-color">
                <div class="icon" data-style-decorator="'image(dungeon_start_ui_invite_friends_icon)'"/>
                <span class="label">
                  Invite Friends
                </span>
              </div>
            </div>

            <!--Buy buttons-->
            <div class="row-flex">
              <div id="purchase-scroll-button" onclick="OnEvent(event, 'DungeonStartUi.OnPurchaseScroll')" class="img-button button-green-color">
                <span class="label">Buy {{ItemName('ITEM_ID_DUNGEONS_SCROLLS')}}</span>
              </div>

              <!--if dungeon pass is active, show timer till it ends-->
              <p data-if="DungeonStartUiModel.HasDungeonPass" class="font-contentnormal">
                <Timer data-attr-seconds="DungeonStartUiModel.PassTimeRemaining"  sec-post-1m="true"  onfinish="OnEvent(event, 'DungeonStartUi.OnPassTimerFinish')">
                  <active>
                    <span class="color_dreamsicle">Dungeon Pass: </span>
                    <timertext class="color_pinky_purple"/>
                  </active>
                  <expired>Expired!</expired>
                </Timer>
              </p>

              <!--Else show dungeon pass purchase button-->
              <div id="purchase-pass-button" onclick="OnEvent(event, 'DungeonStartUi.OnPurchasePass')" class="img-button button-green-color" data-if="!DungeonStartUiModel.HasDungeonPass">
                <span class="label">Buy {{ItemName('ITEM_ID_DUNGEON_PASS_ICON')}}</span>
              </div>
            </div>

            <!--3 different warnings based on server/leaderboard state-->
            <div id="warning-container" class="color_brown font-contentnormal rounded-section">
              <span data-if="DungeonStartUiModel.WarningType == 0"
                    data-rml="ToRMLText(Localize('[dungeon_start_ui_normal_warning]'))"/>

              <span data-if="DungeonStartUiModel.WarningType == 1"
                    data-rml="ToRMLText(Localize('[dungeon_start_ui_shutdown_warning]'))"/>

              <span data-if="DungeonStartUiModel.WarningType == 2">
                <Timer data-attr-seconds="DungeonStartUiModel.CooldownTimeLeft" sec-post-1m="true" onfinish="OnEvent(event, 'DungeonStartUi.OnCooldownTimerFinish')">
                  <active>
                    <span data-rml="ToRMLText(Localize('[dungeon_start_ui_cooldown_warning]'))"/>
                    <timertext class="color_pinky_purple"/>
                  </active>
                  <expired>Expired!</expired>
                </Timer>
              </span>
            </div>
          </div>
        </div>

        <div id="league-section">
          <div id="league-bg">
            <div class="row-flex">
              <div id="league-banner-and-text" class="column-flex">
                <span class="color_dreamsicle font-contentnormal">Your Rank:</span>
                <div id="league-banner"
                     data-alias-file_path="DungeonStartUiModel.BannerPath"
                     data-alias-tier="DungeonStartUiModel.LeagueTier">
                  <template src="DungeonRankBanner"/>
                </div>
              </div>

              <div id="league-button" onclick="OnEvent(event, 'DungeonStartUi.OnLeagueInfo')" class="img-button button-default-color">
                <span class="label">League Standings</span>
              </div>
            </div>
          </div>
        </div>

        <div id="quests-section" class="rounded-section" data-if="DungeonStartUiModel.Challenges.size > 0">
          <div>
            <div class="label-with-icon">
              <div class="icon" data-style-decorator="'itemidimage(ITEM_ID_CRAZY_JIM)'"/>
              <div class="title">Dungeon Daily Challenges</div>
              <i/>
            </div>

            <ul>
              <div data-for="Challenge : DungeonStartUiModel.Challenges">
                <li data-attr-class="'challenge ' + 
                    (Challenge.State == 0 ? 'notstarted' :
                    (Challenge.State == 1 ? 'inprogress' :
                    (Challenge.State == 2 ? 'completed' : 'claimed')))">
                  <input type="checkbox" data-checked="true"/>
                  <div class="challenge-title">
                    <div class="icon" data-style-decorator="'itemidimage(' + Challenge.Icon + ')'">
                      <div data-if="Challenge.State == 3" class="check-mark"/>
                    </div>
                    <div class="title-points">
                      <div class="title color_orange_text">
                        {{Challenge.Title}}<span data-if="Challenge.State == 0 || Challenge.State == 1">: 
                          <span class="color_dreamsicle">({{Challenge.Progress}}/{{Challenge.Target}})</span>
                        </span>
                      </div>
                      <span data-if="Challenge.State == 3" class="font-contentnormal color_dreamsicle">(Claimed) </span>
                      <span data-if="Challenge.Points > 0" class="font-contentnormal color_pinky_purple">{{MoneyString(Challenge.Points)}} {{ItemName('ITEM_ID_DUNGEONS_LEADERBOARD_POINTS')}}</span>
                    </div>
                    <i/>
                  </div>
                  <div class="challenge-info">
                    <div style="padding: 10dp;">
                      <div class="font-contentnormal color_dreamsicle">
                        {{Challenge.Description}}
                      </div>

                      <div data-if="Challenge.Rewards.size > 0" data-attr-class="'rewards-panel ' + (Challenge.State == 3 ? 'disabled' : '')">
                        <div data-for="reward : Challenge.Rewards">
                          <div class="reward-icon">
                            <span class="image" data-style-decorator="'itemidimage('+reward.Id+')'"/>
                            <span class="label">{{reward.Count}}</span>
                          </div>
                        </div>
                      </div>
                    <div data-if="Challenge.State == 0 ||
                                  (Challenge.State == 2 && (Challenge.Rewards.size > 0 || Challenge.Points > 0)) ||
                                  (Challenge.State == 1 && Challenge.IsOptional)"
                         data-attr-chal_id="Challenge.Id" 
                         data-attr-is_optional="Challenge.IsOptional" 
                         onclick="OnEvent(event, 'DungeonStartUi.OnChallengeButtonClicked')" 
                           data-attr-class="'challenge-button img-button ' + (Challenge.State == 1 ? 'button-yellow-color' : (Challenge.State == 2 ? 'button-green-color' : 'button-default-color'))">
                      <span data-if="Challenge.State == 0" class="label">Start</span>
                      <span data-if="Challenge.State == 1 && Challenge.IsOptional" class="label">Give Up</span>
                        <span data-if="Challenge.State == 2 && (Challenge.Rewards.size > 0  || Challenge.Points > 0)" class="label">Claim</span>
                      <span data-if="Challenge.State == 3" class="label">Prize Claimed</span>
                    </div>
                  </div>
                  </div>
                </li>
              </div>
            </ul>
          </div>
        </div>

        <div id="close-button" onclick="OnEvent(event, 'DungeonStartUi.OnClose')" class="img-button button-yellow-color">
          <span class="label">Close</span>
        </div>
      </div>
    </div>
  </body>
</rml>.window {
    width: 900dp;
}

.window .bg {
    overflow-y: auto;
}

.leaderboard-actions {
    padding-top: 10dp;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 15dp;
    align-items: flex-start;
    position: relative;
}

.leaderboard-actions > .info-panel {
    position: static;
    flex: 1 1 auto;
}

.leaderboard-actions > .img-button {
    flex-shrink: 0;
}

.horizontal-panel {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        height: auto;
        gap:15dp;
        align-items: center;
    }

.vertical-panel {
        display: flex;
        flex-direction: col;
        flex-wrap: wrap;
        width: 100%;
        height: auto;
        gap:15dp;
        align-items: center;
    }

.info-panel {
        position: relative;
    }

.info-panel input {
        position: absolute;
        width: 290dp;
        height: 60dp;
        top: 0;
        left: 0;
        opacity: 0;
    }

.info-panel > input[type="checkbox"]:checked ~ .button {
    transform: scale(0.95);
    transition: transform 0.1s;
}

.info-panel > .button {
    transform: scale(1);
    transition: transform 0.1s;
}

.arrow {
        decorator: image(interface/large/gui_ftue_accordion_arrow.rttex);
        width: 40dp;
        height: 40dp;
    }

.info-panel input[type="checkbox"]:checked ~ .button .horizontal-panel .arrow {
    transform: rotate(180deg);
}

.info-panel > div:last-child {
    display: none;
}

.info-panel > input[type="checkbox"]:checked ~ div:last-child {
    display: block;
}

.info-panel .title {
    font-size: 22dp;
}

.more-info-banner-border {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        padding: 15dp;
    }

.more-info-banner {
        decorator: image(interface/large/all_rank_banner.rttex);
        width: 705dp;
        height: 120dp;
        padding: 0dp;
        display: block;
    }

.entry-panel {
        position: relative;
        padding: 0;
        border-radius: 10dp;

        background-color: rgba(104,134,141, 200);
        border: 1dp rgba(0,0,0,50);
        box-shadow: 0 4px 4px 0 rgba(0, 0, 0, 64);
        margin: 0dp;

    }

.entry-panel.unselected {
    background-color: rgba(104, 134, 141, 200);
}

.entry-panel.selected {
    background-color: rgba(171, 224, 235, 250);
}

.entry-panel.unselected-promoted {
    background-color: rgba(139, 177, 130, 200);
}

.entry-panel.selected-promoted {
    background-color: rgba(58, 170, 53, 250);
}

.entry-panel.unselected-demoted {
    background-color: rgba(177, 146, 130, 200);
}

.entry-panel.selected-demoted {
    background-color: rgba(254, 87, 65, 250);
}

.entry-padding {
	padding-top: 2dp;
}

.reward-bkgnd {
    display: block;
    position: relative;
    padding: 3dp;
    border: 2dp white;
    border-radius: 10dp;
    background-color: rgba(0,0,0,128);
}

.reward-image {
    width: 44dp;
    height: 44dp;
}

.reward-text {
   position: absolute;
    bottom: -6dp;
    right: 4dp;
    font-size: 14dp;
    font-effect: shadow(1dp 1dp #000);
    z-index: 2;
}

.entry-panel .default-text {
    font-size: 22dp;
    font-effect: shadow(1dp 1dp #000);
    padding: 10dp;
    color: white;
}

.default-text.promoted {
    color: #49FC00;
}

.default-text.demoted {
    color: #FF9445;
}

.default-text.selected {
    color: white;
}

.leader-board-header-font {
    font-size: 26dp;
    color: white;
    padding:2dp;
}

.timer-font {
    font-size: 26dp;
}

.scroll-header-top-padding {
    padding-top: 10dp;
}

.scroll-header {
    padding: 0dp 4dp 4dp 0dp;
    background-color: rgba(0, 0, 0, 128);
    border: 1dp rgba(0,0,0,64);
    border-radius:8dp;
}

.reward-horizontal-panel {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        height: auto;
        gap:8dp;
        align-items: center;
        width: 260dp;
        padding: 4dp;
    }

.scroll-container {
    width: 100%;
    height:32vh;
    
    overflow-y: auto;
    margin: 0dp;
}

#dungeonleaderboard-popup #results-list {
    width: 100%;
    overflow-y: auto;
    display: block;
    margin-bottom: 10dp;
    min-height: 60dp;
}

#dungeonleaderboard-popup #results-list #results-table.centered {
    display: flex;
    align-items: center;
    justify-content: center;
}

.promotion-banner {
        decorator: image(interface/large/promotion_zone.rttex);
        width: 640dp;
        height: 64dp;
        padding: 0dp;
        display: block;
    }

.promotion-banner-label {
	width: 100%;
	text-align: center;
    color: rgb(37,171,67);
    font-size: 24dp;
}

.demotion-banner {
        decorator: image(interface/large/demotion_zone.rttex);
        width: 640dp;
        height: 64dp;
        padding: 0dp;
        display: block;
    }

.demotion-banner-label {
	width: 100%;
	text-align: center;
    color: rgb(255, 148, 69);
    font-size: 24dp;
}

.banner-center {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
}

.info-popup {
    
    background-color: rgba(58,28,84, 224);
    border-radius: 4pt;
    border: 2dp #AF08CAFF;
    padding: 0dp;
    z-index: 100;
    font-size: 20dp;
    width: 100%;
}

.league-banner{
    height: 128dp;
    width: 128dp;
    flex-shrink: 0;
}

.loading-popup {
    position: absolute;
    top: 386dp;
    left: 45dp;
    background-color: rgba(60,137,166, 224);
    border-radius: 4pt;
    border: 2dp rgb(136,184,203);
    padding: 0dp;
    font-size: 20dp;
    width: 800dp;
    height: 60dp;
    display: flex;
    align-items: center;
    justify-content: center;
}

.top-panel {
    display: flex;
    width: 100%;
    align-items: stretch;
    gap: 10px;
}

.top-inner-left {
    flex: 1.6 1 0;
    display: flex;
    padding: 8px 16px;
    align-items: flex-start;
    gap: 10px;
    border-radius: 8px;
    background: rgba(0, 63, 77, 128);
}

.top-inner-right {
    flex: 1 1 0;
    display: flex;
    padding: 16px;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    flex: 1 0 0;
    border-radius: 8px;
    background: rgba(0, 63, 77, 128);
}<rml>
	<head>
		<title>DungeonleaderboardBlock</title>
		<link type="text/template" href="../Base/BasePopup.rml" />
		<link type="text/rcss" href="../Base/WindowTitle.rcss" />
		<link type="text/rcss" href="Leaderboard.rcss" />
		<link type="text/template" href="../Templates/DungeonRankBanner.rml" />
	</head>
	<body template="BasePopup" class="show-scrollbar ">
		<div data-model="DungeonLeaderboardModel" id="dungeonleaderboard-popup" class="font-content">
			<div class="font-contentnormal">
				<div style="font-size: 46dp; padding-bottom: 20dp;">{{DungeonLeaderboardModel.Title}}</div>
				<div class="top-panel">
					<div class="top-inner-left">
						<div class="league-banner" data-alias-file_path="DungeonLeaderboardModel.BannerPath" data-alias-tier="DungeonLeaderboardModel.LeagueTier">
							<template src="DungeonRankBanner"/>
						</div>
						<div class="font-contentnormal color_white ">
							<Timer data-attr-seconds="DungeonLeaderboardModel.EndTime" sec-post-1m="true">
								<active class="timer-font">
									<span class="color_dreamsicle" data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_TIMER_PREFIX]'))"/>
									<timertext class="color_pinky_purple"/>
								</active>
								<expired data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_TIMER_EXPIRED]'))"/>
							</Timer>
							<div data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_DESCRIPTION_1]', DungeonLeaderboardModel.PromotionPerc, DungeonLeaderboardModel.DemotionPerc))" data-class-hidden="DungeonLeaderboardModel.DemotionPerc <= 0"/>
							<div data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_DESCRIPTION_2]', DungeonLeaderboardModel.PromotionPerc))" data-class-hidden="DungeonLeaderboardModel.DemotionPerc > 0"/>
						</div>
					</div>
					<div class="top-inner-right color_dreamsicle">
						<div>
							<Span>Your Position: </Span>
							<Span>{{DungeonLeaderboardModel.PositionInfo}}</Span>
						</div>
						<div data-class-hidden="DungeonLeaderboardModel.Position <= DungeonLeaderboardModel.PromotionPosition">
							<Span>Next Promotion: </Span>
							<Span>{{NumWithSeparator(DungeonLeaderboardModel.PromotionInfo)}}</Span>
						</div>
						<div style="height:100%;" data-class-hidden="DungeonLeaderboardModel.Position > DungeonLeaderboardModel.PromotionPosition"/>
						<div>
							<Span>Your Points: </Span>
							<Span>{{NumWithSeparator(DungeonLeaderboardModel.Points)}}</Span>
						</div>
						<div onclick="OnEvent(event, 'DungeonLeaderboard.GotoPlayer')" class="img-button button-default-color">
							<span class="label"  style="font-size: 20dp;">Go To Your Rank</span>
						</div>
					</div>
				</div>
				<div class="leaderboard-actions">
					<div class="info-panel">
						<input type="checkbox" onchange="OnEvent(event, 'DungeonLeaderboard.OnInfoChanged')"/>
						<div class="button button-purple-color" style="padding: 3dp 15dp 5dp 10dp;">
							<div class="horizontal-panel">
								<class class="title" data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_LEAGUE_INFO_TITLE]'))"/>
								<class class="arrow"/>
							</div>
						</div>
						<div class="info-popup">
							<div class="more-info-banner-border">
								<div class="more-info-banner"/>
								<div class="font-contentnormal color_dreamsicle" data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_LEAGUE_INFO_TEXT]'))"/>
							</div>
						</div>
					</div>
					
				</div>
				<div class="scroll-header-top-padding">
					<div class="scroll-header">
						<div class="horizontal-panel color_dreamsicle leader-board-header-font">
							<span style="width:95dp;"></span>
							<span style="width:278dp;" data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_NAME]'))"/>
							<span style="width:170dp;" data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_POINTS]'))"/>
							<span data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_REWARDS]'))"/>
						</div>
					</div>
				</div>
				<div class="loading-popup" data-class-hidden="DungeonLeaderboardModel.RequestState != 1 || DungeonLeaderboardModel.Entries.size > 0">
					<div class="font-contentnormal" data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_LOADING]'))"/>
				</div>
				<div class="loading-popup" data-class-hidden="DungeonLeaderboardModel.RequestState != 0 || DungeonLeaderboardModel.Entries.size > 0">
					<div class="font-contentnormal" data-rml="ToRMLText(Localize('[DUNGEON_LEADERBOARD_EMPTY]'))"/>
				</div>
				<div id="results-list" class="scroll-container show-scrollbar" onscroll="OnEvent(event, 'DungeonLeaderboard.OnScroll')">
					<div class="results-table" id="results-table">
						<div id="entry-list" data-for="entry : DungeonLeaderboardModel.Entries">
							<div class="entry-padding">
								<div class="entry-panel" 
									data-class-selected-promoted="entry.Position <= DungeonLeaderboardModel.PromotionPosition && DungeonLeaderboardModel.Position == entry.Position"
									data-class-unselected-promoted="entry.Position <= DungeonLeaderboardModel.PromotionPosition && DungeonLeaderboardModel.Position != entry.Position"
									data-class-selected-demoted="entry.Position > DungeonLeaderboardModel.DemotionPosition && DungeonLeaderboardModel.Position == entry.Position"
									data-class-unselected-demoted="entry.Position > DungeonLeaderboardModel.DemotionPosition && DungeonLeaderboardModel.Position != entry.Position"
									data-class-selected="DungeonLeaderboardModel.Position == entry.Position"
									data-class-unselected="DungeonLeaderboardModel.Position != entry.Position">
										 <div class="horizontal-panel">
										<div class="default-text" style="padding-left: 20dp; width:60dp;"
											 data-class-selected="DungeonLeaderboardModel.Position == entry.Position">
											{{entry.Position}}
										</div>
										<div class="default-text" style="width:264dp;"
											 data-class-selected="DungeonLeaderboardModel.Position == entry.Position">
											{{entry.PlayerName}}
										</div>
										<div class="default-text" style="width:160dp;">
											{{NumWithSeparator(entry.Points)}}
										</div>
										<div class ="reward-horizontal-panel">
											<div data-for="reward : entry.Rewards">
												<div class="reward-bkgnd">
													<div class="reward-image" data-style-decorator="'itemidimage('+reward.ItemID+')'"/>
													<div class="reward-text" data-rml="NumWithSeparator(reward.Number)" data-class-hidden="reward.Number <= 1"/>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
							<div class="banner-center">
								<div data-class-hidden="DungeonLeaderboardModel.PromotionPosition != entry.Position || DungeonLeaderboardModel.PlayerCount <= 1">
									<div class="promotion-banner"/>
									<!--<div class="promotion-banner-label">
										<Span>Top </Span>
										<Span>{{DungeonLeaderboardModel.PromotionPerc}}</Span>
										<Span>%</Span>
									</div>-->
								</div>
								<div data-class-hidden="DungeonLeaderboardModel.DemotionPosition != entry.Position || DungeonLeaderboardModel.PlayerCount <= 2">
									<div class="demotion-banner"/>
									<!--<div class="demotion-banner-label">
										<Span>Bottom </Span>
										<Span>{{DungeonLeaderboardModel.DemotionPerc}}</Span>
										<Span>%</Span>
									</div>-->
								</div>
							</div>
						</div>
					</div>
				</div>
				<div id="bottom-panel">
					<div id="back-button" onclick="OnEvent(event, 'DungeonLeaderboard.OnBack')" class="img-button button-default-color">
						<span class="label">Back</span>
					</div>
				</div>
			</div>
		</div>
	</body>
</rml>/*------- WINDOW TITLE -------*/

@spritesheet wardrobe_saveload_ui_title_sprites {
    src: game/tiles_page17.rttex;
    resolution: 1x;
    wardrobe_saveload_title_icon: 736px 96px 32px 32px;
}

.window .bg {
    overflow-y: auto;
}

#window-title .title-icon {
    decorator: image(wardrobe_saveload_title_icon);
}

.ticket-container {
    background-color: rgba(191, 218, 255, 75);
    width:98%;
    height:175dp;
    display: inline-block; 
    margin-left:2dp;
}

.theme-text {
    position: relative;
    width:98%;
    height: 34dp;
    display: inline-block; 
    vertical-align: top;
    horizontal-align: left;
    margin-left: 20dp;
}

#add-remove-button {
    margin-left: 24dp;
}


.small_text {
    margin-top: -27dp; /* Remove fixed margin */
}

.popup-header-text {
    margin-top: 0dp; /* Remove fixed margin */
    text-align: left;
    width: 98%; /* Make it take full width of its container */
    min-width: 0; /* Allow it to shrink below content size */
    display: inline-block; 
    vertical-align: top;
    line-height: 0.92; /* Reduces line height to 80% of font size */
}

.popup-warning-text {
    margin-top: -10dp; /* Remove fixed margin */
    text-align: left;
}

.buttons-panel {
    height: 10dp;
    position: relative;
    display: inline-block; 
    horizontal-align: left;
}

.item-small {
    position: relative;
    width:98%;
    height: 34dp;
    display: inline-block; 
    vertical-align: top;
    horizontal-align: left;
}

.item-icon {
    position: relative;
    height: 34dp;
    width: 34dp;
    display: inline-block; 
    margin-left: 20dp;
}

.wl-value {
    text-align: left;
    width: 80%; /* Make it take full width of its container */
    min-width: 0; /* Allow it to shrink below content size */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 10dp; /* Remove fixed margin */
    margin-top: 3dp; /* Remove fixed margin */
    display: inline-block; 
    vertical-align: top;
}

table {
    padding-bottom: 20dp;
}<template name="BaseEventButton">
    <head>
    </head>
    <body>
        <div data-if="buttonData.buttonTemplate == 'BaseEventButton'">
            <div data-attr-class="'state' + buttonData.buttonState">
                <div class="event_button_body">
                    <div data-attr-class="buttonData.buttonClass">

                        <div class="rays"></div>
                        <div class="itemIdIcon" data-style-decorator="buttonData.itemIdIcon" />

                        <div class="label" data-rml="ToRMLText(buttonData.buttonText)" />
                        <div class="notification_circle" data-visible="buttonData.notification > 0">
							<div class="notification_text">{{buttonData.notification}}</div>
						</div>
						<div class="notification_exclamation" data-visible="buttonData.notification < 0"></div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="buttonData.buttonTemplate == 'EventButtonWithCounter'">
            <div data-attr-class="'state' + (buttonData.buttonState + ((buttonData.buttonState == 0 && (buttonData.counter >= buttonData.counterMax)) ? 1 : 0))">
                <div class="event_button_body">
                    <div data-attr-class="buttonData.buttonClass">

                        <div class="rays"></div>
                        <div class="itemIdIcon" data-style-decorator="buttonData.itemIdIcon" />

                        <div class="label" data-visible="buttonData.counter < buttonData.counterMax">{{buttonData.counter}}/{{buttonData.counterMax}}</div>
                        <div class="notification_circle" data-visible="buttonData.notification > 0">
							<div class="notification_text" data-visible="buttonData.notification > 1">{{buttonData.notification}}</div>
						</div>
						<div class="notification_exclamation" data-visible="buttonData.notification < 0"></div>
                    </div>
                </div>
            </div>
        </div>

        <div id="FtueTaskButton" data-if="buttonData.buttonTemplate == 'FTUEButton'" onclick="onFtuePanelShown(document)">
            <div data-event-click="buttonData.buttonState = ((buttonData.buttonState == 1 || buttonData.buttonState == 3) ? buttonData.buttonState - 1 : buttonData.buttonState + 1);"
                 data-class-closed="buttonData.buttonState == 0"
                 data-class-opened="buttonData.buttonState == 1 || buttonData.buttonState == 3"
                 data-class-call="buttonData.buttonState == 2">
                <div class="event_button_body">
                    <div data-attr-class="buttonData.buttonClass">
                        <div class="label" data-rml="ToRMLText(buttonData.buttonText)">
                        </div>
                        <div class="notification_exclamation" data-visible="buttonData.notification > 0"></div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="buttonData.buttonTemplate == 'DungeonEventButton'">
            <div class="event_button_body">
                <div data-attr-class="buttonData.buttonClass">

                    <div class="label" data-rml="ToRMLText(buttonData.buttonText)" />
                    <div class="lifeAndProgress">
                        <progress class="progressBar" data-attr-value="ToRMLText(buttonData.counter)" data-attr-max="ToRMLText(buttonData.counterMax)" />
                    </div>


					<div class="notification_exclamation" data-visible="buttonData.notification > 0"></div>
                </div>
            </div>
        </div>

        <div data-if="buttonData.buttonTemplate == 'ActiveAuctionEventButton'">
          <div>
            <div class="event_button_body" onclick="onToggleAuctionPanel(document)">
              <div data-attr-class="buttonData.buttonClass">
                <div class="itemIdIcon" data-style-decorator="buttonData.itemIdIcon" />
                <div class="arrow" data-attr-class="'arrow ' + 'state' + buttonData.buttonState"/>
                <div class="label color_yellow" data-rml="ToRMLText(buttonData.buttonText)"/>
                <div class="notification_exclamation" data-visible="buttonData.notification > 0"></div>
              </div>
            </div>
          </div>
        </div>
    </body>
</template>body.world_ui {
    width: 100%;
    height: 100%;
    clip: always;
    margin-left: inset-left;
}

#top_panel {
    display: block;
    position: absolute;
    top: 10dp;
    left: 8dp;
    transition: margin-top 0.2s linear-in;
    margin-top: 0dp;
}

#left_panel {
    display: block;
    position: absolute;
    top: 90dp;
    left: 8dp;
    transition: margin-left 0.2s linear-in;
    margin-left: 0dp;
}

#left_panel.withPearls {
    top: 135dp;
}

.full-hide #left_panel,
.petbattle-hide #left_panel,
.hide #left_panel {
    transition: margin-left 0.2s linear-in;
    margin-left: -130dp;
}

.ftue-hide #top_panel,
.full-hide #top_panel,
.petbattle-hide #top_panel,
.hide #top_panel {
    transition: margin-top 0.2s linear-in;
    margin-top: -200dp;
}

/*-------------------------------------------------------------------------------*/
/*--------------                   Gems panel                      --------------*/
@spritesheet gems_panel_sprites {
    src: interface/large/gui_store_top_scale9.rttex;
    resolution: 1x;
    gems_panel_bg: 0px 0px 32px 32px;
    gems_panel_bg_inner: 15px 15px 2px 2px;
}

#gems_panel {
    display: inline;
    width: 250dp;
    height: 75dp;
    border-radius: 7dp;
    background-color: rgba(24, 107, 139, 170);
    display: inline-block;
    vertical-align: top;
}

.box_border {
    margin-top: 5dp;
    margin-left: 5dp;
    width: 65dp;
    height: 65dp;
    border-radius: 7dp;
    background-color: #186B8BCC;
    vertical-align: top;
    /* Remove any margins that might interfere with centering */
}

.box_border_background {
    width: 65dp;
    height: 65dp;
    background-color: rgba(121, 194, 222, 0);
    border-top-left-radius: 6dp;
    border-bottom-left-radius: 6dp;
    vertical-align: top;
    display: flex; /* Use flexbox for centering */
    justify-content: center; /* Center horizontally */
    align-items: center; /* Center vertically */
}

@spritesheet dungeon_avatar_sprite
{
	src: game/vilpix.rttex;
    resolution: 1x;
    dungeonAvatar0: 4px 164px 24px 24px;
}

.avatar {
    width: 77%;
    height: 77%;
    margin-top: 13%;
    margin-left: 12%;
    z-index: 2;
    top: 0;
    left: 0;
    display: block;
}

    #gems_panel .panel {
        margin-left: 15dp;
        width: 70%;
        height: 34dp;
        background-color: rgba(65,123,150,255);
        display: inline-block; 
        vertical-align: top;
        box-shadow: #000a 0px 2px 2px;
        border-top-left-radius: 6dp;
        border-top-right-radius: 6dp;
        border-bottom-left-radius: 6dp;
        border-bottom-right-radius: 6dp;
    }

    
    #gems_panel .left_panel {
        height:100%; 
        width:20%; 
        display: inline-block; 
        vertical-align: top;
    }    
    
    #gems_panel .right_panel {
        margin-left: 12dp; 
        height:100%; 
        width:75%; 
        display: inline-block;
        vertical-align: top;
	sound-on-click: true;
    }

    #gems_panel .panel_name {
        width: 95%; /* Ensure it takes full width */
        height: 33dp;
        vertical-align: top;
        margin-left: 15dp;
    }

    #gems_panel .panel:active,
    #gems_panel .panel:active * {
        image-color: #aaa;
        color: #aaa;
    }

        #gems_panel .panel:active #gem_left_panel {
            background-color: rgba(83, 133, 152, 255);
        }

    #gems_panel #gem_left_panel {
        width: 41dp;
        height: 100%;
        background-color: rgba(116,189,212,255);
        border-top-left-radius: 6dp;
        border-bottom-left-radius: 6dp;
        margin-left: -4dp;
        margin-right: 8dp;
        display: inline-block;
    }

        #gems_panel #gem_left_panel #gem_icon {
            width: 28dp;
            height: 28dp;
            decorator: image(interface/cash_icon_overlay.rttex);
            margin: auto;
        }

    #gems_panel #gem_right_panel {
        width: 66%;
        text-align: center;
        margin-top: 12%;
        font-size: 82%;
        margin-left: -4%;
        font-weight: bold;
        white-space: nowrap;
        overflow: hidden;
        font-effect: shadow(2dp 2dp black);
        display: inline-block;
        vertical-align: top;
    }

    #gems_panel #gem_plus_button_right {
        margin-left: 2dp; /* Space from currency panel */
        margin-top: 0.5dp;
        width: 35dp;
        height: 35dp;
        vertical-align: top;
        display: inline-block;
    }

    #gems_panel #player_name {
    text-align: left;
    font-size: 20dp;
    width: 95%; /* Make it take full width of its container */
    min-width: 0; /* Allow it to shrink below content size */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 0dp; /* Remove fixed margin */
    margin-top: 3dp; /* Remove fixed margin */
    font-weight: bold;
    font-effect: shadow(2dp 2dp black);
    display: block; /* Change to block for full width */
    vertical-align: top;
    }

    #gems_panel #plus_button {
        display: inline-block;
        width: 35dp;
        height: 35dp;
        decorator: image(interface/large/gui_buy_plus.rttex);
	sound-on-click: true;
    }

    #gems_panel #plus_button:active {
        image-color: #aaa;
    }

/*-------------------------------------------------------------------------------*/
/*--------------                   Pearl panel                      --------------*/
@spritesheet pearls_panel_sprites {
    src: interface/large/gui_store_top_scale9.rttex;
    resolution: 1x;
    pearls_panel_bg: 0px 0px 32px 32px;
    pearls_panel_bg_inner: 15px 15px 2px 2px;
}

#pearls_panel {
    display: block;
    margin-top: 5dp;
}

#pearls_panel.hidden {
    display: none;
}

#pearls_panel .panel {
    width: 186dp;
    height: 41dp;
    decorator: ninepatch(pearls_panel_bg, pearls_panel_bg_inner);
    display: inline-block;
    vertical-align: top;
}

#pearls_panel #pearl_left_panel {
    width: 41dp;
    height: 39dp;
    background-color: rgba(121, 194, 222, 255);
    border-top-left-radius: 6dp;
    border-bottom-left-radius: 6dp;
    margin-left: -1dp;
    margin-right: 8dp;
    display: inline-block;
}

#pearls_panel #pearl_left_panel #pearl_icon {
    width: 26dp;
    height: 26dp;
    decorator: image(interface/large/pearl_icon_overlay.rttex);
    margin: auto;
}

#pearls_panel #pearl_right_panel {
    font-size: 24dp;
    font-weight: bold;
    line-height: 39dp;
    font-effect: shadow(2dp 2dp black);
    display: inline-block;
    vertical-align: top;
}

/*-------------------------------------------------------------------------------*/
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer name="CANDY_LAND">
  <Data>
    <Sprite name="s_bg" fileName="game/bg_vd_cndy_sky.rttex"/>
    <Sprite name="s_frontLayer" fileName="game/bg_vd_cndy_layer2.rttex"/>
    <Sprite name="s_midLayer" fileName="game/bg_vd_cndy_layer3.rttex"/>
    <Sprite name="s_backLayer" fileName="game/bg_vd_cndy_layer4.rttex"/>
    <Sprite name="s_clouds" fileName="game/bg_vd_cndy_layer1.rttex"/>

    <Animations>
      <SpriteCurveAnimation name="a_clouds" sprite="s_clouds" autoPlay="true" isLoop="true" animTime="50000">
        <Curve name="pos.x">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>
  </Data>
  <RenderRules>
    <RenderBackground>

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_bg</Set>
      </ContextUpdate>

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0</Set>
      </ContextUpdate>
      <SpriteRender name="s_bg" offset="0, 0.85" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_backLayer</Set>
        <Set name="padding">100</Set>
      </ContextUpdate>

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.05</Set>
      </ContextUpdate>
      <SpriteRender name="s_backLayer" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_backLayer</Set>
        <Set name="padding">300</Set>
      </ContextUpdate>
      
      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.1</Set>
      </ContextUpdate>
      <SpriteRender name="s_midLayer" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_backLayer</Set>
        <Set name="padding">700</Set>
      </ContextUpdate>
      
      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.15</Set>
      </ContextUpdate>
      <SpriteRender name="s_frontLayer" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
      <SpriteRender name="s_clouds" offset="0, 0" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_LEFT" />
      

    </RenderBackground>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer name="CONCERT_LIGHTS">
	<Data>
		<Sprite name="s_bg" fileName="game/bg_cl_sky1.rttex"/>
		<Sprite name="s_dots1" fileName="game/bg_cl_dots1.rttex"/>
		<Sprite name="s_dots2" fileName="game/bg_cl_dots2.rttex"/>
		<Sprite name="s_rays1" fileName="game/bg_cl_rays1.rttex"/>
		<Sprite name="s_rays2" fileName="game/bg_cl_rays2.rttex"/>
		<Sprite name="s_lights" fileName="game/bg_cl_lights.rttex"/>
		<Animations>
			<SpriteCurveAnimation name="a_rays1" isLoop="true" autoPlay="true" sprite="s_rays1" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0,   0</KeyFrame>
					<KeyFrame>0.25, 0.35</KeyFrame>
					<KeyFrame>0.5,  1</KeyFrame>
					<KeyFrame>0.75, 0.35</KeyFrame>
					<KeyFrame>1,   0</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="a_rays2" isLoop="true" autoPlay="true" sprite="s_rays2" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0,   1</KeyFrame>
					<KeyFrame>0.25, 0.35</KeyFrame>
					<KeyFrame>0.5,  0</KeyFrame>
					<KeyFrame>0.75, 0.35</KeyFrame>
					<KeyFrame>1,   1</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="s_dots1" isLoop="true" autoPlay="true" sprite="s_dots1" animTime="400">
				<Curve name="alpha">
					<KeyFrame>0, 0.3</KeyFrame>
					<KeyFrame>0.49, 0.3</KeyFrame>
					<KeyFrame>0.5, 0</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="s_dots2" isLoop="true" autoPlay="true" sprite="s_dots2" animTime="400">
				<Curve name="alpha">
					<KeyFrame>0, 0.0</KeyFrame>
					<KeyFrame>0.49, 0.0</KeyFrame>
					<KeyFrame>0.5, 0.3</KeyFrame>
					<KeyFrame>1, 0.3</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
		</Animations>
		<VariableMap>
			<Set name="RayColor1">0, 197, 199</Set>
			<Set name="RayColor2">233, 33, 179</Set>
			<Set name="DotsColor">84, 4, 159</Set>
			<Set name="GradientColor1">8, 8, 34</Set>
			<Set name="GradientColor2">20, 29, 77</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderBackground>
			<ContextUpdate type="ScaleScreenHeight">
				<Set name="sprite">s_bg</Set>
			</ContextUpdate>
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0</Set>
			</ContextUpdate>
			<ContextUpdate type="SetTint">
				<Set name="tint">GradientColor1</Set>
				<Set name="forceTint">true</Set>
			</ContextUpdate>
			<SpriteRender name="s_bg" offset="0, 1" blend="ADDITIVE" alignment="DOWN_LEFT" />
			<ContextUpdate type="SetTint">
				<Set name="tint">GradientColor2</Set>
				<Set name="forceTint">true</Set>
			</ContextUpdate>
			<SpriteRender name="s_bg" offset="0, 1" flip="0,1" blend="ADDITIVE" alignment="DOWN_LEFT" />

			<ContextUpdate type="ScaleScreenHeight">
				<Set name="sprite">s_rays1</Set>
				<Set name="padding">0</Set>
			</ContextUpdate>
			
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.25</Set>
			</ContextUpdate>
			
			<ContextUpdate type="SetTint">
				<Set name="tint">DotsColor</Set>
				<Set name="forceTint">true</Set>
			</ContextUpdate>
			<SpriteRender name="s_dots1" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_dots2" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.45</Set>
			</ContextUpdate>
			
			<ContextUpdate type="SetTint">
				<Set name="tint">RayColor1</Set>
				<Set name="forceTint">true</Set>
			</ContextUpdate>
			<SpriteRender name="s_rays1" offset="0, 1" blend="ADDITIVE" alignment="DOWN_LEFT" />
			<SpriteRender name="s_rays1" offset="0.5, 1" blend="ADDITIVE" alignment="DOWN_LEFT" />
			<SpriteRender name="s_rays1" offset="0.25, 0.5" flip="0,1" blend="ADDITIVE" alignment="LEFT_CENTER" />
			<SpriteRender name="s_rays1" offset="-0.25, 0.5" flip="0,1" blend="ADDITIVE" alignment="LEFT_CENTER" />
			
			<ContextUpdate type="SetTint">
				<Set name="tint">RayColor2</Set>
				<Set name="forceTint">true</Set>
			</ContextUpdate>
			<SpriteRender name="s_rays2" offset="0, 1" blend="ADDITIVE" alignment="DOWN_LEFT" />
			<SpriteRender name="s_rays2" offset="0.5, 1" blend="ADDITIVE" alignment="DOWN_LEFT" />
			<SpriteRender name="s_rays2" offset="0.25, 0.5" flip="0,1" blend="ADDITIVE" alignment="LEFT_CENTER" />
			<SpriteRender name="s_rays2" offset="-0.25, 0.5" flip="0,1" blend="ADDITIVE" alignment="LEFT_CENTER" />
			
			<ContextUpdate type="SetTint">
				<Set name="tint">255,255,255</Set>
				<Set name="forceTint">true</Set>
			</ContextUpdate>
			<SpriteRender name="s_lights" offset="0.5, 1" blend="ADDITIVE" alignment="DOWN_CENTER" />
			<SpriteRender name="s_lights" offset="1, 1" blend="ADDITIVE" alignment="DOWN_CENTER" />
			<SpriteRender name="s_lights" offset="0.75, 0.185" flip="0,1" blend="ADDITIVE" alignment="DOWN_CENTER" />
			<SpriteRender name="s_lights" offset="-0.75, 0.185" flip="0,1" blend="ADDITIVE" alignment="DOWN_CENTER" />
		</RenderBackground>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer name="DRAGONS_KEEP">
  <Data>
    <Sprite name="s_bg" fileName="game/WM-Draconic_Layer8.rttex"/>
    <Sprite name="s_vortex" fileName="game/WM-Draconic_Layer6.rttex"/>
    <Sprite name="s_clouds1" fileName="game/WM-Draconic_Layer5.rttex"/>
    <Sprite name="s_clouds2" fileName="game/WM-Draconic_Layer5.rttex"/>
    <Sprite name="s_clouds3" fileName="game/WM-Draconic_Layer5.rttex"/>
    <Sprite name="s_clouds4" fileName="game/WM-Draconic_Layer5.rttex"/>
    <Sprite name="s_loopingBG" fileName="game/WM-Draconic_Layer4.rttex"/>
    <Sprite name="s_dragonCastle" fileName="game/WM-Draconic_Layer3.rttex"/>
    <Sprite name="s_loopingFG" fileName="game/WM-Draconic_Layer1.rttex"/>

    <Animations>
      <SpriteCurveAnimation name="a_vortex" autoPlay="true" sprite="s_vortex" animTime="96000" isLoop="true">
        <Curve name="rotation">
          <KeyFrame>0.f, 0</KeyFrame>
          <KeyFrame>1.f, -360</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_clouds1" autoPlay="true" sprite="s_clouds1" animTime="112000" isLoop="true">
        <Curve name="rotation">
          <KeyFrame>0.f, 0</KeyFrame>
          <KeyFrame>1.f, -360</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_clouds2" autoPlay="true" sprite="s_clouds2" animTime="128000" isLoop="true">
        <Curve name="rotation">
          <KeyFrame>0.f, 0</KeyFrame>
          <KeyFrame>1.f, -360</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_clouds3" autoPlay="true" sprite="s_clouds3" animTime="144000" isLoop="true">
        <Curve name="rotation">
          <KeyFrame>0.f, 0</KeyFrame>
          <KeyFrame>1.f, -360</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_clouds4" autoPlay="true" sprite="s_clouds4" animTime="160000" isLoop="true">
        <Curve name="rotation">
          <KeyFrame>0.f, 0</KeyFrame>
          <KeyFrame>1.f, -360</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>
   
  </Data>
  <RenderRules>
    <RenderBackground>
      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_bg</Set>
      </ContextUpdate>

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0</Set>
      </ContextUpdate>
      <SpriteRender name="s_bg" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_vortex</Set>
      </ContextUpdate>

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0</Set>
        <Set name="wrapHorizontal">false</Set>
      </ContextUpdate>
      <SpriteRender name="s_vortex" offset="0.75,0.25" scale="1,1" rotateOffset="true" rotationPoint="768,256" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" />
      <SpriteRender name="s_clouds1" offset="0.75,0.25" scale="0.55,0.55" rotateOffset="true" rotationPoint="768,256" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" tintOverride="255,255,255,204"/>
      <SpriteRender name="s_clouds2" offset="0.75,0.25" useFixedRotation="true" fixedRotation="180" scale="1,1" rotateOffset="true" rotationPoint="768,256" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" tintOverride="255,255,255,153"/>
      <SpriteRender name="s_clouds3" offset="0.75,0.25" scale="1.33,1.33" rotateOffset="true" rotationPoint="768,256" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" tintOverride="255,255,255,76"/>
      <SpriteRender name="s_clouds4" offset="0.75,0.25" useFixedRotation="true" fixedRotation="180" scale="2,2" rotateOffset="true" rotationPoint="768,256" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" tintOverride="255,255,255,51"/>

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_loopingBG</Set>
      </ContextUpdate>

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.1</Set>
      </ContextUpdate>
      <SpriteRender name="s_loopingBG" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.2</Set>
        <Set name="wrapHorizontal">false</Set>
      </ContextUpdate>
      <SpriteRender name="s_dragonCastle" offset="0.35,0.53" scale="0.9,0.9" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" />

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.3</Set>
        <Set name="wrapHorizontal">true</Set>
      </ContextUpdate>
      <SpriteRender name="s_loopingFG" offset="0.85, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
      
    </RenderBackground>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer name="EMERALD_CITY">
  <Data>
    <Sprite name="s_bg" fileName="game/bg_EC_sky.rttex"/>
    <Sprite name="s_clouds" fileName="game/bg_EC_cloud.rttex"/>
    <Sprite name="s_mountain" fileName="game/bg_EC_mountain.rttex"/>
    <Sprite name="s_castle" fileName="game/bg_EC_castle.rttex"/>
    <Sprite name="s_loopingFG" fileName="game/bg_EC_foreground.rttex"/>

    <Animations>
      <SpriteCurveAnimation name="a_clouds" sprite="s_clouds" autoPlay="true" isLoop="true" animTime="100000">
        <Curve name="pos.x">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>

  </Data>
  <RenderRules>
    <RenderBackground>
      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_bg</Set>
      </ContextUpdate>

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0</Set>
      </ContextUpdate>
      <SpriteRender name="s_bg" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_mountain</Set>
      </ContextUpdate>

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.1</Set>
      </ContextUpdate>
      <SpriteRender name="s_mountain" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_castle</Set>
      </ContextUpdate>
      
      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.15</Set>
        <Set name="wrapHorizontal">false</Set>
      </ContextUpdate>
      <SpriteRender name="s_castle" offset="0.4, 0.77" scale="0.8,0.8" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.2</Set>
        <Set name="wrapHorizontal">true</Set>
      </ContextUpdate>
      <SpriteRender name="s_loopingFG" offset="0.9, 0.875" scale="1,1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
      <SpriteRender name="s_clouds" offset="0, 0" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_LEFT" />

    </RenderBackground>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer name="ENCHANTED_LOCK">
	<Data>
		<Sprite name="s_Silhouette" fileName="game/bg_EL_regularl_silhouette.rttex"/>
		<Sprite name="s_FrontBuilding" fileName="game/bg_EL_regula_frontBuilding.rttex"/>
		<Sprite name="s_MiddleBuilding" fileName="game/bg_EL_regularl_middleBuilding.rttex"/>
		<Sprite name="s_BackgroundBuilding" fileName="game/bg_EL_regularl_backgroundBuilding.rttex"/>
		<Sprite name="s_Cloud1" fileName="game/bg_EL_regularl_cloud1.rttex"/>
		<Sprite name="s_Cloud2" fileName="game/bg_EL_regularl_cloud2.rttex"/>
		<Sprite name="s_BackGradient" fileName="game/bg_EL_regularl_backGradient.rttex"/>
		
		<Animations>
			<SpriteCurveAnimation name="a_Cloud1" sprite="s_Cloud1" autoPlay="true" isLoop="true" animTime="70000">
				<Curve name="pos.x">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>1.f, 1.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>	
			<SpriteCurveAnimation name="a_Cloud2" sprite="s_Cloud2" autoPlay="true" isLoop="true" animTime="90000">
				<Curve name="pos.x">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>1.f, 1.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>	
		</Animations>
	</Data>
	<RenderRules>
		<RenderBackground>
			<ContextUpdate type="ScaleScreenHeight">
				<Set name="sprite">s_BackGradient</Set>
			</ContextUpdate>
			
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0</Set>
			</ContextUpdate>
			<SpriteRender name="s_BackGradient" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			
			<ContextUpdate type="ScaleScreenHeight">
				<Set name="sprite">s_MiddleBuilding</Set>
				<Set name="padding">100</Set>
			</ContextUpdate>
			
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.06</Set>
			</ContextUpdate>
			<SpriteRender name="s_Cloud2" offset="0.332, 0.211" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_Cloud1" offset="0.418, 0.154" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.13</Set>
			</ContextUpdate>
			<SpriteRender name="s_BackgroundBuilding" offset="0, 0.432" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.3</Set>
			</ContextUpdate>
			<SpriteRender name="s_MiddleBuilding" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.8</Set>
			</ContextUpdate>
			<SpriteRender name="s_FrontBuilding" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			
			<ContextUpdate type="PositionParallax">
				<Set name="scale">1</Set>
			</ContextUpdate>
			<SpriteRender name="s_Silhouette" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
		</RenderBackground>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer name="FRUIT_KINGDOM">
  <Data>
    <Sprite name="s_bg" fileName="game/bg_fk_sky.rttex"/>
    <Sprite name="s_frontLayer" fileName="game/bg_FK_fg.rttex"/>
    <Sprite name="s_midLayer" fileName="game/bg_FK_mg.rttex"/>
    <Sprite name="s_backLayer" fileName="game/bg_FK_bg.rttex"/>
    <Sprite name="s_cloud" fileName="game/cloud.rttex" textureSize="197,111" frame="0,0"/>

	  <ParticleSystems>
		  <ParticleSystem name="ps_clouds" updateStage="RenderBackground">
			  <Emitter>
				  <Random name="emissionInterval" min="120" max="240"/>
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">1</Set>
				  <Set name="maxParticleInstanceAtOnce">5</Set>
			  </Emitter>
			  <Particle moveConstraint="Horizontal" autoLifeTimeToTarget="true">
				  <Set name="inScreenSpace">true</Set>
				  <Set name="renderAlignment">LEFT_CENTER</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Set name="sprite">s_cloud</Set>
				  <Random name="offset" min="1.5, 0.05" max="1.5, 0.5"/>
				  <Set name="targetPos">-1.5, 0</Set>
				  <Curve name="initialAlpha">
					  <KeyFrame>0, 0</KeyFrame>
					  <KeyFrame>0.001, 1</KeyFrame>
					  <KeyFrame>9.999, 1</KeyFrame>
					  <KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Random name="initialVelocity" min="-0.001, 0" max="-0.01, 0"/>
				  <Random name="initialScale" min="0.1" max="1"/>
			  </Particle>
		  </ParticleSystem>
		  <ParticleSystem name="ps_cloudsFG" updateStage="RenderBackground">
			  <Emitter>
				  <Random name="emissionInterval" min="120" max="240"/>
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">1</Set>
				  <Set name="maxParticleInstanceAtOnce">5</Set>
			  </Emitter>
			  <Particle moveConstraint="Horizontal" autoLifeTimeToTarget="true">
				  <Set name="inScreenSpace">true</Set>
				  <Set name="renderAlignment">LEFT_CENTER</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Set name="sprite">s_cloud</Set>
				  <Random name="offset" min="1.5, 0.05" max="1.5, 0.5"/>
				  <Curve name="initialAlpha">
					  <KeyFrame>0, 0</KeyFrame>
					  <KeyFrame>0.001, 1</KeyFrame>
					  <KeyFrame>9.999, 1</KeyFrame>
					  <KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Set name="targetPos">-1.5, 0</Set>
				  <Random name="initialVelocity" min="-0.001, 0" max="-0.01, 0"/>
				  <Random name="initialScale" min="0.1" max="1"/>
			  </Particle>
		  </ParticleSystem>
	  </ParticleSystems>
  </Data>
  <RenderRules>
    <RenderBackground>

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_bg</Set>
      </ContextUpdate>

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0</Set>
      </ContextUpdate>
      <SpriteRender name="s_bg" offset="0, 0.85" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
      <ParticleSystemRender name="ps_clouds"/>
		
      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_backLayer</Set>
        <Set name="padding">100</Set>
      </ContextUpdate>

      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.05</Set>
      </ContextUpdate>
      <SpriteRender name="s_backLayer" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_backLayer</Set>
        <Set name="padding">300</Set>
      </ContextUpdate>
      
      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.1</Set>
      </ContextUpdate>
      <SpriteRender name="s_midLayer" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

      <ContextUpdate type="ScaleScreenHeight">
        <Set name="sprite">s_backLayer</Set>
        <Set name="padding">700</Set>
      </ContextUpdate>
      
      <ContextUpdate type="PositionParallax">
        <Set name="scale">0.15</Set>
      </ContextUpdate>
      <SpriteRender name="s_frontLayer" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

	<ParticleSystemRender name="ps_cloudsFG"/>
    </RenderBackground>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer name="LATIUM_AND_ALBION">
	<Data>
		<Sprite name="s_bg" fileName="game/bg_PR_sky.rttex"/>
		<Sprite name="s_bg_temp" fileName="game/bg_NWM_bg.rttex"/>
		<Sprite name="s_lightening" fileName="game/bg_PR_lightning.rttex" textureSize="1920,1080" frame="0,0" cullingDisabled="true"/>
		<Sprite name="s_sunshine" fileName="game/bg_PR_sunshine.rttex"/>
		<Sprite name="s_clouds" fileName="game/bg_PR_clouds.rttex"/>
		<Sprite name="s_clouds_right" fileName="game/bg_PR_clouds.rttex"/>
		<Sprite name="s_mountain" fileName="game/bg_PR_background.rttex"/>
		<Sprite name="s_mountain_extension" fileName="game/bg_PR_background_right.rttex" cullingDisabled="true"/>
		<Sprite name="s_castle" fileName="game/bg_PR_midground.rttex"/>
		<Sprite name="s_castle_left" fileName="game/bg_PR_midground_left.rttex" cullingDisabled="true"/>
		<Sprite name="s_castle_right" fileName="game/bg_PR_midground_right.rttex" cullingDisabled="true"/>
		<Sprite name="s_loopingFG" fileName="game/bg_PR_foregound.rttex"/>
		<Sprite name="s_loopingFGLeft" fileName="game/bg_PR_foregound_left.rttex"/>
		<Sprite name="s_loopingFGRight" fileName="game/bg_PR_foregound_right.rttex"/>

		<Animations>

		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_lightening">
				<Emitter>
					<Random name="emissionInterval" min="0.8" max="3"/>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				
				</Emitter>
				<Particle>
					<Set name="inScreenSpace">true</Set>
					<Set name="renderAlignment">UPPER_LEFT</Set>
					<Random name="lifeTime" min="0.8" max="1.5" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="initialScale">1,1</Set>
		
					<Random name="offset" min="0.75, 0" max="0.84, 0"/>
					<Set name="sprite">s_lightening</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.0</KeyFrame>
						<KeyFrame>0.1, 1</KeyFrame>
						<KeyFrame>0.4, 1</KeyFrame>
						<KeyFrame>1, 0.0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderBackground>
			<ContextUpdate type="ScaleScreenSize">
				<Set name="sprite">s_bg</Set>
			</ContextUpdate>

			<ContextUpdate type="PositionParallax">
				<Set name="scale">0</Set>
				<Set name="wrapHorizontal">false</Set>
			</ContextUpdate>
			<SpriteRender name="s_bg" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

			<ContextUpdate type="ScaleScreenHeight">
				<Set name="sprite">s_bg_temp</Set>
			</ContextUpdate>
			<ParticleSystemUpdate name="ps_lightening"/>
			<ParticleSystemRender name="ps_lightening"/>

			<SpriteRender name="s_sunshine" scale="1,1" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_clouds" scale="1,1"  offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_clouds_right" scale="1,1" flip="1,0" offset="0.9995, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
		
			
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.1</Set>
				<Set name="wrapHorizontal">false</Set>
			</ContextUpdate>

			<SpriteRender name="s_mountain" flip="1.1,0" offset="-1, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_mountain" offset="-0.1, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_mountain_extension" offset="0.9, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.15</Set>
				<Set name="wrapHorizontal">false</Set>
			</ContextUpdate>


			<SpriteRender name="s_castle" scale="1,1" offset="0.4, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.15</Set>
				<Set name="wrapHorizontal">false</Set>
				<Set name="worldAttachmentType">Left</Set>
				‚ÄÉ‚ÄÉ
			</ContextUpdate>
			<SpriteRender name="s_castle_right" offset="0.25, 0.96" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.15</Set>
				<Set name="wrapHorizontal">false</Set>
				<Set name="worldAttachmentType">Left</Set>
				‚ÄÉ‚ÄÉ
			</ContextUpdate>
			<SpriteRender name="s_castle_left" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />

			<ContextUpdate type="PositionParallax">
				<Set name="scale">0.7</Set>
				<Set name="wrapHorizontal">false</Set>
			</ContextUpdate>
			<SpriteRender name="s_loopingFG" offset="0, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_loopingFGLeft" offset="-0.98, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_loopingFGLeft" offset="-1.98, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_loopingFGLeft" offset="-2.98, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
			<SpriteRender name="s_loopingFGRight" offset="0.98, 1" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_LEFT" />
