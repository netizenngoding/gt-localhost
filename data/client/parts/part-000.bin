				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_before" sprite="s_iniSword" animTime="1050" autoPlay="true" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>		
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>		
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>		
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_iniSword" animTime="750" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
			</SpriteAnimation>	<SpriteAnimation name="a_hit_fire" sprite="s_flameHit" animTime="400" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
            <!-- <InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-190, 0, 180, 1" animTime="1000" playOnState="Punch.False"/> -->
		</Animations>
        <TileStampData>
            <Set name="FileName">game/UGCSpritesheet67v1.rttex</Set>
            <Set name="EndFrame">3,1</Set>
            <Set name="FrameCount">4</Set>
        </TileStampData>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
    <StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ScytheAnimation">
				<States>
					<State name="Before" />
					<State name="Idle" />
				</States>
				<Transitions>
					<Transition from="Before" to="Idle">
						<Condition>
							<IsAnimationFinished>a_hell_before</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileIni</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
							<Random name="finalScale" min="0.1" max="1"/>
												<Set name="interpolateScale">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_meledakDuar</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-300</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_buddha_fire</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_raygun_smoke</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,10,10</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="ScytheAnimation.Idle">
        <Emitter>
          <Random name="offset" min="-20, -30" max="20, -70" />
          <Random name="emissionInterval" min="0.28" max="0.56" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.8" max="1.4" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">12,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">60</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">-16,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">60</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
			<KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_debuWinter</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="ScytheAnimation.Idle">
				<Emitter>
          <Random name="offset" min="-300, -150" max="110, 30" />
					<Random name="emissionInterval" min="0.010" max="0.02" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_debuWinter</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    				<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.7" max="1.8" />
					<Set name="lifeTime">1.5</Set>
					<Random name="initialVelocity" min="-20, 40" max="30, 60" />
					<Random name="initialAngle" min="0" max="-360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <!-- <VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap> -->
	<RenderOptions>
		<Default>
			<!-- <Set name="ShouldHover">true</Set> -->
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">false</Set>
			<Set name="IncludeAllActions">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>
			<Set name="RenderBackArmBuild">false</Set>
			<Set name="RenderFrontArmInfected">true</Set>
			<Set name="RenderBackArmInfected">true</Set>
			<Set name="UserNameOffset">15</Set>
			<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
		</Default>
	</RenderOptions>
	</Data>
	<RenderRules>
		<!-- <Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Jump">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-210</Set>
				<Set name="angleOffset">90</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Fall">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-135</Set>
				<Set name="angleOffset">90</Set>
			</AvatarTransform>

		</Update> -->
		<RenderInFront>
			<!-- <SpriteRender name="s_punchEfek" offset="10,-10" alignment="CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="-2,-2" onAction="PUNCH" />
			<SpriteRender name="s_buddha" offset="0,-360" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle|Pet.Punch" /> -->


		</RenderInFront>
		<RenderBackHandItem>
		</RenderBackHandItem>

		<RenderHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group onState="ScytheAnimation.Before">
				<SpriteRender name="s_iniSword" offset="0,-15" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" />
			</Group>

			      <SpriteRender name="s_FrontArm" offset="0,-12" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>


			<Group onState="ScytheAnimation.Idle">
				<SpriteRender name="s_iniSword" offset="3,0" rotationPoint="-0.45, 0.4" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" scale="0.1,0.1" />
				     <SpriteRender name="s_FrontArm" offset="0,-12" rotationPoint="0,1" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>
			</Group>
		</RenderHandItem>

		
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="angleOffset">0</Set>
				<!-- <Set name="armAngle">0</Set> -->
				<!-- <Set name="isAdditive">true</Set> -->
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<!-- <AvatarTransform class="ArmAngle" onState="Punch.True">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-135</Set>
			</AvatarTransform> -->
		</OnPunchUpdate>
		
    <RenderFrontArm>
      <ContextUpdate type="PositionSinPulse" onState="Punch.True">
        <Set name="period">100</Set>
        <Set name="scale">-0.5</Set>
        <Set name="clamp">true</Set>
      </ContextUpdate>
    </RenderFrontArm>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<!-- arm1 -->
		<Sprite name="s_FrontArm" fileName="game/UGCSpritesheet68v1.rttex" textureSize="32" frame="0,2"/>

	<!-- smoke0 -->
		<Sprite name="s_raygun_smoke" fileName="game/UGCSpritesheet68v0.rttex" textureSize="256"/>
		<Sprite name="s_buddha" fileName="game/mainBuddha.rttex" textureSize="256"/>
<!-- arm1 -->
		<Sprite name="s_debu" fileName="game/UGCSpritesheet68v1.rttex" textureSize="32" frame="10,0" />
		<Sprite name="s_debuWinter" fileName="game/UGCSpritesheet68v1.rttex" textureSize="32" frame="0,0"/>
		<Sprite name="s_flameHit" fileName="game/UGCSpritesheet68v1.rttex" textureSize="32" frame="0,2" />
		<Sprite name="s_flameCurve" fileName="game/UGCSpritesheet68v1.rttex" textureSize="32" frame="4,0" />
<!-- dont remove and dm vow for items like this :) -->
		<Sprite name="s_punchEfek" fileName="game/slashBuddha.rttex" textureSize="512" frame="0,0"/>
<!-- HAND2 -->
		<Sprite name="s_iniSword" fileName="game/UGCSpritesheet68v2.rttex" textureSize="256"/>
		<Sprite name="s_meledakDuar" fileName="game/UGCSpritesheet68v2.rttex" textureSize="256"/>
		<Sprite name="s_buddha_fire" fileName="game/UGCSpritesheet68v2.rttex" textureSize="256"/>
		<!-- eff3 -->
		<Sprite name="s_ProjectileIni" fileName="game/UGCSpritesheet68v3.rttex" textureSize="256"/>
<Animations>
			<SpriteAnimation name="a_buddha_earth_before" sprite="s_buddha" autoPlay="true" animTime="800" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_buddha_earth_after" sprite="s_buddha" animTime="600" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_buddha_punch" sprite="s_buddha" animTime="400" isLoop="true" playOnState="Pet.Punch" playOnAction="PUNCH">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="s_debuWinter">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_punch" sprite="s_punchEfek" animTime="400" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_projectile" sprite="s_ProjectileIni" animTime="300" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
=			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_destroy_impact" sprite="s_meledakDuar" animTime="400" isLoop="false">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_fireball" sprite="s_buddha_fire" animTime="400" isLoop="true">
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_buddha_earth" sprite="s_raygun_smoke" animTime="800" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_before" sprite="s_iniSword" animTime="750" autoPlay="true" playerState="ScytheAnimation.Before">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>		
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
								<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>		
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
								<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>		
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_iniSword" animTime="750" isLoop="true" playOnState="ScytheAnimation.Idle">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
			</SpriteAnimation>	<SpriteAnimation name="a_hit_fire" sprite="s_flameHit" animTime="400" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
            <!-- <InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-190, 0, 180, 1" animTime="1000" playOnState="Punch.False"/> -->
		</Animations>
        <TileStampData>
            <Set name="FileName">game/UGCSpritesheet68v1.rttex</Set>
            <Set name="EndFrame">3,1</Set>
            <Set name="FrameCount">4</Set>
        </TileStampData>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
    <StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ScytheAnimation">
				<States>
					<State name="Before" />
					<State name="Idle" />
				</States>
				<Transitions>
					<Transition from="Before" to="Idle">
						<Condition>
							<IsAnimationFinished>a_hell_before</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileIni</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
							<Random name="finalScale" min="0.1" max="1"/>
												<Set name="interpolateScale">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_meledakDuar</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-300</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_buddha_fire</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_raygun_smoke</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,10,10</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="ScytheAnimation.Idle">
        <Emitter>
          <Random name="offset" min="-20, -30" max="20, -70" />
          <Random name="emissionInterval" min="0.28" max="0.56" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.8" max="1.4" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">12,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">60</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">-16,-48</Set>
          <Set name="lifeTime">60</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">60</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 5,5</KeyFrame>
            <KeyFrame>1, 5,5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
			<KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_debuWinter</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="ScytheAnimation.Idle">
				<Emitter>
          <Random name="offset" min="-300, -150" max="110, 30" />
					<Random name="emissionInterval" min="0.010" max="0.02" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_debuWinter</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    				<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.7" max="1.8" />
					<Set name="lifeTime">1.5</Set>
					<Random name="initialVelocity" min="-20, 40" max="30, 60" />
					<Random name="initialAngle" min="0" max="-360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <!-- <VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap> -->
	<RenderOptions>
		<Default>
			<!-- <Set name="ShouldHover">true</Set> -->
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">false</Set>
			<Set name="IncludeAllActions">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>
			<Set name="RenderBackArmBuild">false</Set>
			<Set name="RenderFrontArmInfected">true</Set>
			<Set name="RenderBackArmInfected">true</Set>
			<Set name="UserNameOffset">15</Set>
			<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
		</Default>
	</RenderOptions>
	</Data>
	<RenderRules>
		<!-- <Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Jump">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-210</Set>
				<Set name="angleOffset">90</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Fall">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-135</Set>
				<Set name="angleOffset">90</Set>
			</AvatarTransform>

		</Update> -->
		<RenderInFront>
			<!-- <SpriteRender name="s_punchEfek" offset="10,-10" alignment="CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="-2,-2" onAction="PUNCH" />
			<SpriteRender name="s_buddha" offset="0,-360" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle|Pet.Punch" /> -->


		</RenderInFront>
		<RenderBackHandItem>
		</RenderBackHandItem>

		<RenderHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group onState="ScytheAnimation.Before">
				<SpriteRender name="s_iniSword" offset="0,-15" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" />
			</Group>

			      <SpriteRender name="s_FrontArm" offset="0,-12" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>


			<Group onState="ScytheAnimation.Idle">
				<SpriteRender name="s_iniSword" offset="3,0" rotationPoint="-0.45, 0.4" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" scale="0.1,0.1" />
				     <SpriteRender name="s_FrontArm" offset="0,-12" rotationPoint="0,1" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>
			</Group>
		</RenderHandItem>

		
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="angleOffset">0</Set>
				<!-- <Set name="armAngle">0</Set> -->
				<!-- <Set name="isAdditive">true</Set> -->
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<!-- <AvatarTransform class="ArmAngle" onState="Punch.True">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-135</Set>
			</AvatarTransform> -->
		</OnPunchUpdate>
		
    <RenderFrontArm>
      <ContextUpdate type="PositionSinPulse" onState="Punch.True">
        <Set name="period">100</Set>
        <Set name="scale">-0.5</Set>
        <Set name="clamp">true</Set>
      </ContextUpdate>
    </RenderFrontArm>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
