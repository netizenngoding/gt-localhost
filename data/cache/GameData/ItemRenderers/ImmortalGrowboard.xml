<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Mobility">
				<States>
					<State name="Stationary"/>
					<State name="Moving"/>
				</States>
				<Transitions>
					<Transition to="Stationary" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Stationary">
						<Condition>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Sprite name="s_boardLeft" fileName="game/player_feet16.rttex" textureSize="32" frame="11,28"/>
		<Sprite name="s_boardRight" fileName="game/player_feet16.rttex" textureSize="32" frame="11,29"/>
		<Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="19,25"/>
		
		<Animations>
			<SpriteAnimation sprite="s_trail" name="a_trail" autoPlay="false">
				<Frame>19,25</Frame>
				<Frame>20,25</Frame>
				<Frame>21,25</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="ps_trail" updateStage="AddClothingParticles" updateState="Mobility.Moving" renderStage="RenderShoes">
				<Emitter>
					<Set name="offset">-16, 0</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true" randomSpriteFrame="true">
					<Set name="sprite">s_trail</Set>
					<Random name="offset" min="0, -4" max="0, 4"/>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75,1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.1, 0.1</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-4</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="UserNameOffset">8</Set>
				<Set name="ShouldHover">true</Set>
				<Set name="NeedRenderBareFeetWithShoesItem">false</Set>
				<Set name="AllowChangePunchType">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<StopIf type="or">
				<IsAction>PUNCH</IsAction>
				<IsAction>BUILD</IsAction>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
			  <Set name="armName">arm2Angle</Set>
			  <Set name="armAngle">45</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
			  <Set name="armName">arm1Angle</Set>
			  <Set name="armAngle">-45</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<SpriteRender name="s_boardLeft" offset="16,3" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT"/>
			<SpriteRender name="s_boardRight" offset="-16,3" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT"/>
		</RenderShoes>
	</RenderRules>
</ItemRenderer>