</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_blob" fileName="game/particles12.rttex" textureSize="32" frame="16,2" />
		<Sprite name="s_flash" fileName="game/particles12.rttex" textureSize="32" frame="16,1" />
		<Sprite name="s_foot1" fileName="game/player_feet16.rttex" textureSize="32" frame="0,22" />
		<Sprite name="s_foot2" fileName="game/player_feet16.rttex" textureSize="32" frame="0,23" />
		<Sprite name="s_hit" fileName="game/particles12.rttex" textureSize="32" frame="15,2" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="17,1" />
		<Sprite name="s_turret" fileName="game/particles12.rttex" textureSize="32" frame="14,2" />
		<Animations>
			<SpriteAnimation name="a_blob" sprite="s_blob" animTime="200">
				<Frame>16,2</Frame>
				<Frame>17,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_idle1" sprite="s_foot1" animTime="200" isLoop="true" playOnState="Mobility.Stationary">
				<Frame>0,22</Frame>
				<Frame>1,22</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_idle2" sprite="s_foot2" animTime="200" isLoop="true" playOnState="Mobility.Stationary">
				<Frame>0,23</Frame>
				<Frame>1,23</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_move1" sprite="s_foot1" animTime="400" isLoop="true" playOnState="Mobility.Moving">
				<Frame>2,22</Frame>
				<Frame>3,22</Frame>
				<Frame>4,22</Frame>
				<Frame>5,22</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_move2" sprite="s_foot2" animTime="400" isLoop="true" playOnState="Mobility.Moving">
				<Frame>2,23</Frame>
				<Frame>3,23</Frame>
				<Frame>4,23</Frame>
				<Frame>5,23</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Mobility">
				<States>
					<State name="Stationary" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Stationary" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Stationary">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-5</Set>
				<Set name="IsCar">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="IsRidingBird">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="target.angle">0</Set>
			<Set name="target.origin.offset">0,0,0</Set>
			<Set name="turret.Rotation">0</Set>
			<Set name="transform.turret.offset">16,-8,0</Set>
			<Set name="turret.offset">16,-26,0</Set>
		</VariableMap>
		<ParticleSystems>
			<ParticleSystem name="p_flash">
				<Emitter attachment="contextRotation">
					<Set name="offset">0, 0</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_flash</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_hitBlob" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_blob</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,80" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_punch">
				<Emitter attachment="contextRotation">
					<Set name="offset">0, 0</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.25</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderShoes>
			<SpriteRender name="s_foot1" offset="12,8" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
			<SpriteRender name="s_foot2" offset="12,8" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />
			<ArithmethicOperation LeftHandVariableName="turret.Rotation" RightHandVariableName="target.angle" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="target.origin.offset" RightHandVariableName="turret.offset" OperationType="Set" />
			<Translate>16, -26, 0</Translate>
			<Rotate forceValue="true">turret.Rotation</Rotate>
			<Group onState="Facing.Left">
				<Rotate>180,0,0,1</Rotate>
				<Translate>6, 0, 0</Translate>
				<SpriteRender name="s_turret" />
				<Translate>27, 1, 0</Translate>
				<Rotate>180,0,0,1</Rotate>
				<Group>
					<StopIf>
						<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
					</StopIf>
					<ParticleSystemUpdate name="p_flash" onState="Action.Punch" />
					<Translate>15,0, 0</Translate>
					<ParticleSystemUpdate name="p_punch" onState="Action.Punch" />
				</Group>
			</Group>
			<Group onState="Facing.Right">
				<Translate>6, 0, 0</Translate>
				<SpriteRender name="s_turret" />
				<Translate>27, 1, 0</Translate>
				<Group>
					<StopIf>
						<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
					</StopIf>
					<ParticleSystemUpdate name="p_flash" onState="Action.Punch" />
					<Translate>-15,0, 0</Translate>
					<ParticleSystemUpdate name="p_punch" onState="Action.Punch" />
				</Group>
			</Group>
		</RenderShoes>
		<RenderTransform>
			<SpriteRender name="s_foot1" offset="12,24" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
			<SpriteRender name="s_foot2" offset="12,24" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />
			<ArithmethicOperation LeftHandVariableName="turret.Rotation" RightHandVariableName="target.angle" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="target.origin.offset" RightHandVariableName="transform.turret.offset" OperationType="Set" />
			<Translate>16, -8, 0</Translate>
			<Rotate forceValue="true">turret.Rotation</Rotate>
			<Group onState="Facing.Left">
				<Rotate>180,0,0,1</Rotate>
				<Translate>6, 0, 0</Translate>
				<SpriteRender name="s_turret" />
				<Translate>27, 1, 0</Translate>
				<Rotate>180,0,0,1</Rotate>
				<StopIf>
					<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				</StopIf>
				<ParticleSystemUpdate name="p_flash" onState="Action.Punch" />
				<ParticleSystemUpdate name="p_punch" onState="Action.Punch" />
			</Group>
			<Group onState="Facing.Right">
				<Translate>6, 0, 0</Translate>
				<SpriteRender name="s_turret" />
				<Translate>27, 1, 0</Translate>
				<StopIf>
					<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				</StopIf>
				<ParticleSystemUpdate name="p_flash" onState="Action.Punch" />
				<ParticleSystemUpdate name="p_punch" onState="Action.Punch" />
			</Group>
		</RenderTransform>
		<OnPunchStart />
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile />
		<OnDestroyedTile />
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_SARGON_BANDOLIER">
	<Data>
		<StateMachines>
			<StateMachine name="state">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Move">
						<Condition type="and">
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle">
						<Condition type="or">
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.y" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Sprite name="Equip" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="17,12"/>
		<Sprite name="Trail" fileName="game/particles11.rttex" textureSize="32"/>
		
		<Animations>
			<SpriteAnimation name="Trail_Frames" sprite="Trail" animTime="300">
				<Frame>28,4</Frame>
				<Frame>29,4</Frame>
				<Frame>30,4</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="particle_trail">
				<Emitter>
					<Set name="offset">0,-8</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">4</Set>
					<Set name="intervalMin">.05</Set>
					<Set name="intervalMax">.15</Set>
					<Set name="randomizeInterval">true</Set>
				</Emitter>
				<Particle angleRelativeToPlayerSpeed="true" randomSpriteFrame="true">
					<Set name="sprite">Trail</Set>
					<Random name="offset" min="-8,-8" max="8,8"/>
					<Set name="lifeTime">0.7</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="useGravity">false</Set>
					<Set name="gravityVector">0,25</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.85, 0.85</KeyFrame>
						<KeyFrame>1, 1.0, 1.0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>	 
		
	</Data>

	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="Equip" alignment="DOWN_CENTER"/>
		</RenderChestItem>
		<RenderBehind>
			<ParticleSystemRender name="particle_trail"/>
		</RenderBehind>
		<AddClothingParticles>
			<ParticleSystemUpdate name="particle_trail" onState="state.Move"/>
			<AvatarSilhouetteRender color="20,180,255,200" emissionInterval="0.25" onState="state.Move"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="particle_trail"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_SCARECROWS_CHAINS">
  <Data>
    <Sprite name="s_FrontArm" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="13,19"/>
    <Sprite name="s_BackArm" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="14,19"/>
    <Sprite name="s_Sickle" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="2,5"/>
    <Sprite name="s_PunchChain" fileName="game/particles11.rttex" textureSize="32" frame="1,25"/>
    <Sprite name="s_HitSlash" fileName="game/particles11.rttex" textureSize="32" frame="0,25"/>
    <Sprite name="s_DestroySparkles" fileName="game/particles11.rttex" textureSize="32" frame="24,24"/>
    <Sprite name="s_DestroyImpact" fileName="game/particles11.rttex" textureSize="32" frame="18,24"/>

    <StateMachines>
      <StateMachine name="Facing">
        <States>
          <State name="Left"/>
          <State name="Right"/>
        </States>
        <Transitions>
          <Transition from="Right" to="Left">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition from="Left" to="Right">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_PunchChains" sprite="s_PunchChain" animTime="400" isLoop="true" playOnState="Punch.True">
        <Frame>1,25</Frame>
        <Frame>2,25</Frame>
        <Frame>3,25</Frame>
        <Frame>4,25</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_DestroySparkles" sprite="s_DestroySparkles">
        <Frame>24,24</Frame>
        <Frame>25,24</Frame>
        <Frame>26,24</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_DestroyImpact" sprite="s_DestroyImpact" animTime="300">
        <Frame>23,24</Frame>
        <Frame>18,24</Frame>
        <Frame>19,24</Frame>
        <Frame>20,24</Frame>
        <Frame>21,24</Frame>
        <Frame>22,24</Frame>
      </SpriteAnimation>
    </Animations>
    
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
        <Set name="IncludeAllActions">true</Set>
      </Default>
    </RenderOptions>

    <TileStampData>
      <Set name="FileName">game/particles11.rttex</Set>
      <Set name="EndFrame">30,24</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>

    <ParticleSystems>
      <ParticleSystem name="ps_hitSlash">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.2</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">3</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_HitSlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Random name="lifeTime" min="0.2" max="0.5" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Select name="initialScale" input="randomNumber">
            <Item>1,1</Item>
            <Item>1,-1</Item>
          </Select>
          <RandomRadial name="initialVelocity" angleRange="-45,45" radiusRange="1,1" baseAnglePosition="targetPos" baseOffset="0,16"/>
          <Set name="rotateWithVelocity">true</Set>
          <Random name="offset" min="-8,-4" max="8,4" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_DestroySparkles</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_destroySparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_DestroySparkles</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="80,200" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_destroyImpact">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_DestroyImpact</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.3</Set>
          <Random name="initialAngle" min="0" max="360" />
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>

  <RenderRules>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <Group onState="Facing.Right">
        <SpriteRender name="s_BackArm" offset="-3,10.5" rotateOffset="true" rotationPoint="1,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
      </Group>
      <Group onState="Facing.Left">
        <SpriteRender name="s_BackArm" offset="-3,10.5" rotateOffset="true" rotationPoint="-1,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
      </Group>
    </RenderBackHandItem>
    
    <RenderHandItem>
      <SpriteRender name="s_Sickle" offset="0,7" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="Punch.False"/>

      <Group>
        <StopIf type="and">
          <IsZombified>true</IsZombified>
          <IsAction>PUNCH</IsAction>
        </StopIf>
          <SpriteRender name="s_PunchChain" offset="0,2" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" tintOverride="255,255,255,255" onState="Punch.True" />
      </Group>
      
      <SpriteRender name="s_FrontArm" offset="0,-1.5" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>

    </RenderHandItem>
    <OnPunchStart>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <ParticleSystemUpdate name="ps_hitSlash" />
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchStart>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitSparkles" />
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_destroySparkles" />
      <ParticleSystemUpdate name="ps_destroyImpact" />
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <StateMachines>
      <StateMachine name="playerState">
        <States>
          <State name="Idle"/>
          <State name="Move"/>
          <State name="Fall"/>
          <State name="Jump"/>
        </States>
        <Transitions>
          <Transition from="Jump|Fall|Move" to="Idle" >
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Jump|Fall|Idle" to="Move">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Fall|Move|Idle" to="Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Jump|Idle|Move" to="Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Sprite name="s_hair" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="9,31"/>
    
    <Animations>
      <SpriteAnimation name="a_idle" playOnState="playerState.Idle" sprite="s_hair" isLoop="true" animTime="100">
        <Frame>9,31</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_move" playOnState="playerState.Move" sprite="s_hair" isLoop="true" animTime="800">
        <Frame>10,31</Frame>
        <Frame>11,31</Frame>
        <Frame>12,31</Frame>
        <Frame>13,31</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump" playOnState="playerState.Jump" sprite="s_hair" isLoop="true" animTime="600">
        <Frame>14,31</Frame>
        <Frame>15,31</Frame>
        <Frame>16,31</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall" playOnState="playerState.Fall" sprite="s_hair" isLoop="true" animTime="450">
        <Frame>17,31</Frame>
        <Frame>18,31</Frame>
        <Frame>19,31</Frame>
      </SpriteAnimation>
    </Animations>
  </Data>
  <RenderRules>
    <RenderHair>
      <SpriteRender name="s_hair" offset="0,-15" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderHair>
  </RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
		<Sprite name="s_glove1" fileName="game/player_cosmetics3.rttex" textureSize="32,32" frame="20,31" />
        <Sprite name="s_glove2" fileName="game/player_cosmetics3.rttex" textureSize="32,32" frame="20,31" />
        <Sprite name="s_sword" fileName="game/player_cosmetics3.rttex" textureSize="32,32" frame="21,31" />
        <Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32,32" frame="10,5" />
		<Sprite name="s_hit" fileName="game/particles12.rttex" textureSize="32,32" frame="10,4" />
        <Animations />
        <ParticleSystems>
            <ParticleSystem name="ps_slash" secondary="ps_slash2">
                <Emitter attachment="targetPos">
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="lifeTime">0.6</Set>
                    <Set name="sprite">s_slash</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Random name="offset" min="-8,-8" max="8,8"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
                </Particle>
            </ParticleSystem>
			<ParticleSystem name="ps_slash2">
                <Emitter attachment="targetPos">
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.15</Set>
                </Emitter>
                <Particle UseParentEmitterAngle="true">
                    <Set name="lifeTime">0.6</Set>
                    <Set name="sprite">s_slash</Set>
					<Set name="flipX">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
                </Particle>
            </ParticleSystem>
			<ParticleSystem name="ps_hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">8</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Random name="offset" min="-8, -8" max="8, 8"/>
					<Set name="lifeTime">0.4</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="20,40"/>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				</Particle>
			</ParticleSystem>
        </ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="DefaultPunchSound">audio/slash.wav</Set>
			</Default>
		</RenderOptions>
		<Animations>
			<SpriteAnimation name="a_glove_idle_1" sprite="s_glove1" playOnState="Punch.No">
				<Frame>20,31</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glove_idle_2" sprite="s_glove2" playOnState="Punch.No">
				<Frame>20,31</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glove_fall_1" sprite="s_glove1" playOnState="Movement.Fall">
				<Frame>24,31</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glove_fall_2" sprite="s_glove2" playOnState="Movement.Fall">
				<Frame>25,31</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glove_jump_1" sprite="s_glove1" playOnState="Movement.Jump">
				<Frame>22,31</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glove_jump_2" sprite="s_glove2" playOnState="Movement.Jump">
				<Frame>23,31</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glove_punch_1" sprite="s_glove1" playOnState="Punch.Yes">
				<Frame>26,31</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Movement">
				<States>
					<State name="Other"/>
					<State name="Jump"/>
					<State name="Fall"/>
				</States>
				<Transitions>
					<Transition from="Other|Fall" to="Jump">
						<Condition>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition from="Other|Jump" to="Fall">
						<Condition>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
					<Transition from="Fall|Jump" to="Other">
						<Condition type="and">
							<IsAction operatorType="NotEqual">FALL</IsAction>
							<IsAction operatorType="NotEqual">JUMP</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
    </Data>
    <RenderRules>
        <Update>
            <Group onAction="FALL|JUMP">
                <AvatarTransform class="ArmAngle">
                    <Set name="armName">arm2Angle</Set>
                    <Set name="Curve">
                        <KeyFrame>0,0</KeyFrame>
                        <KeyFrame>0.5,120</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Set>
                    <Set name="animTime">1000</Set>
                </AvatarTransform>
                <AvatarTransform class="ArmAngle">
                    <Set name="armName">arm1Angle</Set>
                    <Set name="Curve">
                        <KeyFrame>0,0</KeyFrame>
                        <KeyFrame>0.5,-120</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Set>
                    <Set name="animTime">1000</Set>
                </AvatarTransform>
            </Group>
        </Update>
        <RenderHandItem>
            <SpriteRender name="s_sword" alignment="UPPER_CENTER" drawShadow="true" onState="Movement.Other"/>
			<Group onState="Movement.Jump|Movement.Fall">
				<Translate>0,-2,0</Translate>
				<SpriteRender name="s_sword" flip="0,1" alignment="CENTER" drawShadow="true"/>
			</Group>
            <SpriteRender name="s_glove1" alignment="UPPER_CENTER" drawShadow="true" />
        </RenderHandItem>
        <RenderBackHandItem>
            <Translate>-3,12,0</Translate>
            <SpriteRender name="s_sword" drawShadow="true" onState="Movement.Other"/>
			<Group onState="Movement.Jump|Movement.Fall">
				<Translate>2,-18,0</Translate>
				<SpriteRender name="s_sword" flip="1,1" alignment="CENTER" drawShadow="true"/>
			</Group>
            <SpriteRender name="s_glove2" drawShadow="true" />
        </RenderBackHandItem>
        <OnPunchStart>
            <ParticleSystemUpdate name="ps_slash" />
        </OnPunchStart>
        <OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
            <AvatarTransform class="ArmAngle">
                <Set name="armName">arm2Angle</Set>
                <Set name="Curve">
                    <KeyFrame>0,0</KeyFrame>
                    <KeyFrame>1,-360</KeyFrame>
                </Set>
                <Set name="animTime">300</Set>
            </AvatarTransform>
			<AvatarTransform class="ArmAngle">
                <Set name="armName">arm1Angle</Set>
                <Set name="Curve">
                    <KeyFrame>0,180</KeyFrame>
                    <KeyFrame>1,-180</KeyFrame>
                </Set>
                <Set name="animTime">300</Set>
            </AvatarTransform>
        </OnPunchUpdate>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_SEASIDE_SUN_HAT">
  <Data>
    <Sprite name="hatForegroundSprite" fileName="game/particles_large10.rttex" textureSize="64" frame="12,11"/>
    <Sprite name="hatBackgroundSprite" fileName="game/particles_large10.rttex" textureSize="64" frame="11,11"/>
  </Data>

  <RenderRules>
    <RenderBackHat>
      <SpriteRender name="hatBackgroundSprite" alignment="DOWN_CENTER"/>
    </RenderBackHat>
    <RenderHat>
      <SpriteRender name="hatForegroundSprite" alignment="DOWN_CENTER"/>
    </RenderHat>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_shoe1" fileName="game/player_feet16.rttex" textureSize="32" frame="28,16" />
    <Sprite name="s_shoe2" fileName="game/player_feet16.rttex" textureSize="32" frame="28,17" />
    <Sprite name="s_shoe1Light" fileName="game/player_feet16.rttex" textureSize="32" frame="30,16" />
    <Sprite name="s_shoe2Light" fileName="game/player_feet16.rttex" textureSize="32" frame="30,17" />
    <Animations>
      <SpriteAnimation name="a_shoe1Idle" sprite="s_shoe1" playOnState="Motion.Idle">
        <Frame>28,16</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shoe2Idle" sprite="s_shoe2" playOnState="Motion.Idle">
        <Frame>28,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shoe1LightIdle" sprite="s_shoe1Light" playOnState="Motion.Idle">
        <Frame>30,16</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shoe2LightIdle" sprite="s_shoe2Light" playOnState="Motion.Idle">
        <Frame>30,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shoe1Move" sprite="s_shoe1" animTime="200" isLoop="true" playOnState="Motion.Moving">
        <Frame>28,16</Frame>
        <Frame>29,16</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shoe2Move" sprite="s_shoe2" animTime="200" isLoop="true" playOnState="Motion.Moving">
        <Frame>28,17</Frame>
        <Frame>29,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shoe1LightMove" sprite="s_shoe1Light" animTime="200" isLoop="true" playOnState="Motion.Moving">
        <Frame>30,16</Frame>
        <Frame>31,16</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shoe2LightMove" sprite="s_shoe2Light" animTime="200" isLoop="true" playOnState="Motion.Moving">
        <Frame>30,17</Frame>
        <Frame>31,17</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Tile">
        <States>
          <State name="Light" />
          <State name="Dark" />
        </States>
        <Transitions>
          <Transition to="Light" from="Dark">
            <Condition>
              <IsDarkTile>false</IsDarkTile>
            </Condition>
          </Transition>
          <Transition to="Dark" from="Light">
            <Condition>
              <IsDarkTile>true</IsDarkTile>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="UserNameOffset">2</Set>
        <Set name="ClothingOffsetFromShoes">-8</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderShoes>
      <AvatarTransform class="FootPosition">
        <Set name="foot1dy">0</Set>
        <Set name="foot2dy">0</Set>
        <Set name="foot1y">0</Set>
        <Set name="foot2y">0</Set>
      </AvatarTransform>
      <SpriteRender name="s_shoe1" offset="1,8" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" onState="Tile.Light" />
      <SpriteRender name="s_shoe2" offset="1,8" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" onState="Tile.Light" />
      <SpriteRender name="s_shoe1Light" offset="1,8" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" onState="Tile.Dark" />
      <SpriteRender name="s_shoe2Light" offset="1,8" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" onState="Tile.Dark" />
    </RenderShoes>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
	<Data>
		<Sprite name="item_Sprite" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="4,11"/>
		<Sprite name="s_Sparkles" fileName="game/particles.rttex" textureSize="32" frame="1,1" />
		<Sprite name="s_hitFlash" fileName="game/particles4.rttex" textureSize="32" frame="4,10" />
		<Animations>
			<InterpolationFloatAnimation name="saturationValueTo" variableName="saturationValue" playOnState="SelfieTake.Max" targetVariableName="saturationValueMax" animTime="0"/>
			<InterpolationFloatAnimation name="saturationValueFrom" variableName="saturationValue" playOnState="SelfieTake.Default" targetVariableName="saturationValueDefault" animTime="100"/>

			<InterpolationFloatAnimation name="contrastValueTo" variableName="contrastValue" playOnState="SelfieTake.Max" targetVariableName="contrastValueMax" animTime="0"/>
			<InterpolationFloatAnimation name="contrastValueFrom" variableName="contrastValue" playOnState="SelfieTake.Default" targetVariableName="contrastValueDefault" animTime="100"/>

			<InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" playOnState="SelfieTake.Max" targetVariableName="brightnessValueMax" animTime="0"/>
			<InterpolationFloatAnimation name="brightnessValueFrom" variableName="brightnessValue" playOnState="SelfieTake.Default" targetVariableName="brightnessValueDefault" animTime="100"/>

		</Animations>
		<ParticleSystems>
			<ParticleSystem name="pshitFlash">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offsetFacing">false</Set>
				</Emitter>
				<Particle >
					<Set name="relativeToEmitter">true</Set>

					<Set name="offset">3, 0</Set>
					<Set name="sprite">s_hitFlash</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.1, 0.1</Set>
					<Set name="flipY">1</Set>
					<Set name="finalScale">2, 2</Set>
					<Set name="initalRGB">0, 0, 0</Set>
					<Set name="finalRGB">1, 1, 1</Set>
					<Set name="interpolateRGB">true</Set>
					<Set name="initialAlpha">0</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="lifeTime">0.1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="psSparkles">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="offset">-6, 8</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="offsetFacing">false</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="inSpecificOrder">true</Set>
					<Random name="offset" min="-1, -3" max="13, 5" />
					<Set name="relativeToEmitter">true</Set>
					<Set name="sprite">s_Sparkles</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialAlpha">0</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 0</KeyFrame>
						<KeyFrame>0.5, 1, 1</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Moving">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="SelfieTake">
				<States>
					<State name="Default" />
					<State name="Max"/>
				</States>
				<Transitions>
					<Transition to="Default" from="Max">
						<Condition>
							<CompareCustomVariable operatorType="Greater" VariableNameToCompare="flashTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="Max" from="Default">
						<Condition  type="and">
							<IsSitting ItemID="ITEM_ID_THEATER_SEAT">false</IsSitting>
							<IsSleepingOnaBed>false</IsSleepingOnaBed>
							<IsVariableBool name="isMannequin">false</IsVariableBool>
							<CompareCustomVariable operatorType="LessOrEqual" VariableNameToCompare="flashTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="ResetCounter">
				<States>
					<State name="Idle"/>
					<State name="DecreaseCounter"/>
					<State name="Reset"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Reset|DecreaseCounter"/>
					<Transition to="DecreaseCounter" from="Idle">
						<Condition type="and">
							<CompareCustomVariable operatorType="Greater" ForceFloats="false" VariableNameToCompare="flashCount">1</CompareCustomVariable>
							<CompareCustomVariable operatorType="Less" VariableNameToCompare="flashTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="Reset" from="Idle">
						<Condition type="and">
							<CompareCustomVariable operatorType="LessOrEqual" ForceFloats="false" VariableNameToCompare="flashCount">1</CompareCustomVariable>
							<CompareCustomVariable operatorType="Less" VariableNameToCompare="flashTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="saturationValue">1</Set>
			<Set name="saturationValueMax">0.5</Set>
			<Set name="brightnessValue">1</Set>
			<Set name="brightnessValueMax">4</Set>
			<Set name="contrastValue">0</Set>
			<Set name="contrastValueMax">-0.75</Set>

			<Set name="saturationValueDefault">1</Set>
			<Set name="contrastValueDefault">0</Set>
			<Set name="brightnessValueDefault">1</Set>

			<Set name="flashCount" ForceFloats="false">0</Set>

			<Set name="flashTimer">0</Set>
			
			<Set name="DeltaTime">0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			
			<ParticleSystemRender name="pshitFlash"/>
			<ParticleSystemRender name="psSparkles"/>
	
			<SpriteRender name="item_Sprite" offset="20, 9" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />

			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<Translate>46,0, 0</Translate>
			<ParticleSystemUpdate name="pshitFlash" onState="SelfieTake.Max"/>
			<ParticleSystemUpdate name="psSparkles" onState="SelfieTake.Max"/>

			<AvatarTransform class="RenderData">
				<Set name="saturation">saturationValue</Set>
				<Set name="brightness">brightnessValue</Set>
				<Set name="contrast">contrastValue</Set>
			</AvatarTransform>
		</RenderHandItem>
		<Update>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<RandomValueOperation LeftHandVariableName="flashTimer" MinVariableName="0" MaxVariableName="0.5" onState="ResetCounter.DecreaseCounter" />
			<ArithmethicOperation LeftHandVariableName="flashCount" RightHandVariableName="1" OperationType="Substract" onState="ResetCounter.DecreaseCounter" />

			<RandomValueOperation LeftHandVariableName="flashCount" MinVariableName="0" MaxVariableName="5" onState="ResetCounter.Reset" />
			<RandomValueOperation LeftHandVariableName="flashTimer" MinVariableName="1" MaxVariableName="5" onState="ResetCounter.Reset" />

			<ArithmethicOperation LeftHandVariableName="flashTimer" RightHandVariableName="DeltaTime" OperationType="Substract"/>
		</Update>

	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_SERPENTAIL">
  <Data>
    <Sprite name="s_body" fileName="game/player_feet16.rttex" textureSize="32"/>
    <Sprite name="s_tail" fileName="game/player_feet16.rttex" textureSize="32"/>

    <Animations>
      <SpriteAnimation name="a_bodyIdle" sprite="s_body" animTime="100" playOnState="Action.Idle" isLoop="true">
        <Frame>31,19</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_bodyMove" sprite="s_body" animTime="1000" playOnState="Action.Walk|Action.Jump|Action.Fall" isLoop="true">
        <Frame>21,19</Frame>
        <Frame>22,19</Frame>
        <Frame>23,19</Frame>
        <Frame>24,19</Frame>
        <Frame>25,19</Frame>
        <Frame>26,19</Frame>
        <Frame>27,19</Frame>
        <Frame>28,19</Frame>
        <Frame>29,19</Frame>
        <Frame>30,19</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_tailIdle" sprite="s_tail" animTime="100" playOnState="Action.Idle" isLoop="true">
        <Frame>31,18</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_tailMove" sprite="s_tail" animTime="1000" playOnState="Action.Walk|Action.Jump|Action.Fall" isLoop="true">
        <Frame>21,18</Frame>
        <Frame>22,18</Frame>
        <Frame>23,18</Frame>
        <Frame>24,18</Frame>
        <Frame>25,18</Frame>
        <Frame>26,18</Frame>
        <Frame>27,18</Frame>
        <Frame>28,18</Frame>
        <Frame>29,18</Frame>
        <Frame>30,18</Frame>
      </SpriteAnimation>
      <InterpolationVec4Animation name="ia_idle" variableName="tail_rotation" targetValue="0, 0, 0, 1" animTime="600" playOnState="Action.Idle"/>
      <InterpolationVec4Animation name="ia_walk" variableName="tail_rotation" targetValue="0, 0, 0, 1" animTime="400" playOnState="Action.Walk"/>
      <InterpolationVec4Animation name="ia_fall" variableName="tail_rotation" targetValue="30, 0, 0, 1" animTime="1000" playOnState="Action.Fall"/>
      <InterpolationVec4Animation name="ia_jump" variableName="tail_rotation" targetValue="-30, 0, 0, 1" animTime="1000" playOnState="Action.Jump"/>
    </Animations>

    <VariableMap>
      <Set name="tail_rotation">0, 0, 0, 1</Set>
      <Set name="tail_position">-7, 4, 0</Set>
    </VariableMap>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|Fall|Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|Fall|Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Walk|Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Walk|Jump|Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">SHOES</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="ClothingOffsetFromShoes">-8</Set>
        <Set name="UserNameOffset">8</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderShoes>
      <Group>
        <Translate>tail_position</Translate>
        <Rotate>tail_rotation</Rotate>
        <SpriteRender name="s_tail" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      </Group>
      <SpriteRender name="s_body" offset="0,-8"/>
    </RenderShoes>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="UsePetForceFaceTime">false</Set>
				<Set name="NeedRenderShadow">false</Set>
				<Set name="IsPetBehind">true</Set>
				<Set name="DisableDefaultAncestralParticleEffects">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderPet>
			<StopIf type="or">
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>
			<ContextUpdate type="SetTint">
				<Set name="tint">0,0,0,128</Set>
				<Set name="forceTint">true</Set>
			</ContextUpdate>
			<RenderClone offset="-32,0"/>
		</RenderPet>
		<UpdatePet>
			<ContextUpdate type="SetPetWalkRunJump">
				<Set name="PetWalkRunJump.minSpeed">500</Set>
				<Set name="PetWalkRunJump.distSpeedMult">10</Set>
			</ContextUpdate>
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
		</UpdatePet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="PrePunch" ExitTime="0.15"/>
					<State name="PunchL"/>
					<State name="PunchR"/>
				</States>
				<Transitions>
					<Transition to="None" from="PunchL|PunchR|PrePunch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="PrePunch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="PunchL" from="PrePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="PunchR" from="PrePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="s_Item" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="4,13"/>
		<Sprite name="s_Punch" fileName="game/particles12.rttex" textureSize="32" frame="1,19"/>
		<Sprite name="s_Smoke" fileName="game/particles9.rttex" textureSize="32" frame="5,9"/>

		<Animations>
			<SpriteAnimation name="a_IdleItem" sprite="s_Item" playOnState="Action.None">
				<Frame>3, 13</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PunchItem" sprite="s_Item" playOnState="Action.PunchL|Action.PunchR">
				<Frame>4, 13</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Smoke" sprite="s_Smoke"  animTime="500">
				<Frame>14,9</Frame>
				<Frame>5,9</Frame>
				<Frame>6,9</Frame>
				<Frame>7,9</Frame>
				<Frame>8,9</Frame>
				<Frame>9,9</Frame>
				<Frame>10,9</Frame>
				<Frame>11,9</Frame>
				<Frame>12,9</Frame>
				<Frame>13,9</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="ps_PunchR" updateStage="RenderHandItem" updateState="Action.PunchR">
				<Emitter attachment="handspotRoot">
					<Set name="offset">-24, 0</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<Set name="rotateWithVelocity">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_PunchL" updateStage="RenderHandItem" updateState="Action.PunchL">
				<Emitter attachment="handspotRoot">
					<Set name="offset">-24, 0</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="flipY">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Explosion">
				<Emitter>
					<Set name="lifeTime">0.4</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">0,0</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Smoke</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Set name="initialRotationRate">360</Set>
					<Set name="initialScale">2,2</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="RenderBackArmBuild">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Action.PunchL|Action.PunchR">
				<Set name="armName">arm2Angle</Set>
				<Set name="angleOffset">-90</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
				<Set name="pulseArmScale">5</Set>
				<Set name="pulseArmRate">300</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Action.PrePunch">
				<Set name="armName">arm2Angle</Set>
				<Set name="animTime">160</Set>
				<Set name="Curve">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 180</KeyFrame>
				</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<Group onState="Action.None|Action.PrePunch">
				<Translate>0,10,0</Translate>
				<SpriteRender name="s_Item" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
			</Group>
			<SpriteRender name="s_Item" flip="1,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="Action.PunchL|Action.PunchR"/>
		</RenderHandItem>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_Explosion"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_Explosion"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_chariot" fileName="game/player_feet16.rttex" textureSize="32" frame="0,28" />
		<Sprite name="s_sheep" fileName="game/player_pet.rttex" textureSize="32" frame="0,24" />
		<Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="24,17" />
		<VariableMap>
			<Set name="FinalOffset">0,0,0</Set>
			<Set name="JumpTargetOffset">0,-10,0</Set>
			<Set name="FallTargetOffset">0,5,0</Set>
			<Set name="RopeStartFront">0,0,0</Set>
			<Set name="IdleTargetOffset">0,0,0</Set>
			<Set name="RopeEndFront">50,0,0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="ClothingOffsetFromShoes">-3</Set>
				<Set name="UserNameOffset">11</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="IsCar">true</Set>
				<Set name="IsVehicle">false</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShoesHidesBodyLegs">false</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="IsRidingBird">true</Set>
			</Default>
		</RenderOptions>
		<Animations>
			<InterpolationVec3Animation name="a_jump" variableName="FinalOffset" targetVariableName="JumpTargetOffset" isLoop="false" animTime="1000" playOnState="Motion.Jump" />
			<InterpolationVec3Animation name="a_fall" variableName="FinalOffset" targetVariableName="FallTargetOffset" isLoop="false" animTime="1000" playOnState="Motion.Fall" />
			<InterpolationVec3Animation name="a_idle" variableName="FinalOffset" targetVariableName="IdleTargetOffset" isLoop="false" animTime="10" playOnState="Motion.Idle|Motion.GroundMove" />
			<SpriteAnimation name="a_chariotIdle" sprite="s_chariot" animTime="1000" isLoop="true" playOnState="Motion.Idle">
				<Frame>0,28</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_chariotMove" sprite="s_chariot" animTime="200" isLoop="true" playOnState="Motion.Fall|Motion.GroundMove|Motion.Jump">
				<Frame>1,28</Frame>
				<Frame>0,28</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sheepFall" sprite="s_sheep" animTime="200" isLoop="true" playOnState="Motion.Fall">
				<Frame>6,24</Frame>
				<Frame>7,24</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sheepIdle" sprite="s_sheep" animTime="1000" isLoop="true" playOnState="Motion.Idle">
				<Frame>0,24</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sheepJump" sprite="s_sheep" animTime="200" isLoop="true" playOnState="Motion.Jump">
				<Frame>4,24</Frame>
				<Frame>5,24</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sheepMove" sprite="s_sheep" animTime="300" isLoop="true" playOnState="Motion.GroundMove">
				<Frame>1,24</Frame>
				<Frame>2,24</Frame>
				<Frame>3,24</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="GroundMove" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Jump|GroundMove">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="GroundMove" from="Fall|Jump|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Fall|GroundMove">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|GroundMove">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
	</Data>
	<RenderRules>
		<Update />
		<RenderShoes value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Translate>0,-10,0</Translate>
			<SpriteRender name="s_chariot" blend="PREMULTIPLIED_ALPHA" />
			<Group>
				<Translate>30,0,0</Translate>
				<Translate>FinalOffset</Translate>
				<SpriteRender name="s_sheep" blend="PREMULTIPLIED_ALPHA" />
				<SpriteRender name="s_sheep" blend="PREMULTIPLIED_ALPHA" tintOverride="0,0,0,128" drawShadow="false" />
			</Group>
			<Group>
				<Group>
					<Translate>20,0,0</Translate>
					<Translate>FinalOffset</Translate>
					<SpriteRender name="s_sheep" blend="PREMULTIPLIED_ALPHA" />
				</Group>
				<Group>
					<ArithmethicOperation LeftHandVariableName="RopeEndFront" RightHandVariableName="17,4,0" OperationType="Set" />
					<ArithmethicOperation LeftHandVariableName="RopeEndFront" RightHandVariableName="FinalOffset" OperationType="Add" />
					<LineRender color="173,63,38,255" StartPointVariableName="RopeStartFront" EndPointVariableName="RopeEndFront" LineWidth="6" />
				</Group>
			</Group>
		</RenderShoes>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <StateMachines>
      <StateMachine name="Motion">
        <States start="OnGroundIdle">
          <State name="OnGroundIdle"/>
          <State name="OnGroundMove"/>
          <State name="OnAir"/>
          <State name="OnWater"/>
        </States>
        <Transitions>
          <Transition from="OnGroundMove|OnAir|OnWater" to="OnGroundIdle" >
            <Condition type="and">
	            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
	            <IsVariableBool name="onGround">true</IsVariableBool>
	            <IsVariableBool name="underWater">false</IsVariableBool>
            </Condition>
          </Transition>              
		    <Transition from="OnGroundIdle|OnAir|OnWater" to="OnGroundMove" >
            <Condition type="and">
	            <IsVariableFloat name="speed.length" operator="GreaterOrEqual" abs="true">0.1</IsVariableFloat>
	            <IsVariableBool name="onGround">true</IsVariableBool>
	            <IsVariableBool name="underWater">false</IsVariableBool>
            </Condition>
          </Transition>          
		   <Transition from="OnGroundIdle|OnWater|OnGroundMove" to="OnAir" >
            <Condition type="and">
	            <IsVariableBool name="onGround">false</IsVariableBool>
	            <IsVariableBool name="underWater">false</IsVariableBool>
            </Condition>
          </Transition>		    
			<Transition from="OnGroundIdle|OnGroundMove|OnAir" to="OnWater" >
            <Condition type="or">
	            <IsVariableBool name="underWater">true</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
	   <StateMachine name="MovementDir">
		    <States start="None">
			    <State name="None"/>
			    <State name="Horizontal"/>
		    </States>
		    <Transitions>
			    <Transition from="Horizontal" to="None" >
				    <Condition type="or">
					    <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">true</IsVariableBool>
					    <IsVariableBool name="underWater">true</IsVariableBool>
				    </Condition>
			    </Transition>                  
			    <Transition from="None" to="Horizontal" >
				    <Condition type="and">
					    <IsVariableFloat name="speed.x" operator="GreaterOrEqual" abs="true">0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">false</IsVariableBool>
					    <IsVariableBool name="underWater">false</IsVariableBool>
				    </Condition>
			    </Transition>		    
		    </Transitions>
	    </StateMachine>
    </StateMachines>

    <Sprite name="s_cartFront" fileName="game/particles_large15.rttex" textureSize="64" frame="0,0"/>
    <Sprite name="s_cartBack" fileName="game/particles_large15.rttex" textureSize="64" frame="0,1"/>
    <Sprite name="trailOnAir" fileName="game/particles12.rttex" textureSize="32" frame="8,0"/>
    <Sprite name="trailinWater" fileName="game/particles12.rttex" textureSize="32" frame="9,0"/>
    
    <Animations>
      <SpriteAnimation name="a_cartFrontIdle" playOnState="Motion.OnGroundIdle" sprite="s_cartFront" isLoop="true" animTime="100">
        <Frame>0,0</Frame>
      </SpriteAnimation>      
	   <SpriteAnimation name="a_cartBackIdle" playOnState="Motion.OnGroundIdle" sprite="s_cartBack" isLoop="true" animTime="100">
		<Frame>0,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_cartFrontMove" playOnState="Motion.OnGroundMove" sprite="s_cartFront" isLoop="true" animTime="100">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
      </SpriteAnimation>      
	<SpriteAnimation name="a_cartBackMove" playOnState="Motion.OnGroundMove" sprite="s_cartBack" isLoop="true" animTime="100">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
		
	    <SpriteAnimation name="a_cartFrontSwim" playOnState="Motion.OnWater" sprite="s_cartFront" isLoop="true" animTime="100">
		    <Frame>4,0</Frame>
	    </SpriteAnimation>      
	    <SpriteAnimation name="a_cartBackSwim" playOnState="Motion.OnWater" sprite="s_cartBack" isLoop="true" animTime="100">
		    <Frame>4,1</Frame>
		    <Frame>5,1</Frame>
	    </SpriteAnimation>	    
		
		<SpriteAnimation name="a_cartFrontAir" playOnState="Motion.OnAir" sprite="s_cartFront" isLoop="true" animTime="100">
		    <Frame>2,0</Frame>
		    <Frame>3,0</Frame>
	    </SpriteAnimation>      
	    <SpriteAnimation name="a_cartBackAir" playOnState="Motion.OnAir" sprite="s_cartBack" isLoop="true" animTime="100">
		    <Frame>2,1</Frame>
		    <Frame>3,1</Frame>
	    </SpriteAnimation>	    
	
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_trailFlash" updateStage="AddClothingParticles" renderStage="RenderShoes" updateState="MovementDir.Horizontal">
	      <Emitter>
		      <Set name="offset">-25, 2</Set>
		      <Set name="emissionInterval">0.02</Set>
		      <Set name="infParticles">true</Set>
		      <Set name="infLifeTime">true</Set>
		      <Set name="particlesPerEmission">1</Set>
	      </Emitter>
	      <Particle usePlayerFacing="true">
		      <Set name="sprite">trailOnAir</Set>
		      <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
		      <Set name="inSpecificOrder">true</Set>
		      <Curve name="initialAlpha">
			      <KeyFrame>0, 0.8</KeyFrame>
			      <KeyFrame>1, 0</KeyFrame>
		      </Curve>
		      <Curve name="initialScale">
			      <KeyFrame>0, 1,0.75</KeyFrame>
			      <KeyFrame>1, 1.25, 1</KeyFrame>
		      </Curve>
		      <Set name="lifeTime">0.3</Set>
	      </Particle>
      </ParticleSystem>     
	<ParticleSystem name="ps_trailBubbles">
        <Emitter>
          <Set name="offset">-29, -2</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="lifeTime">0.3</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">trailinWater</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.25, 0.25</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
	        <Set name="initialVelocity">-25, -25</Set>
          <Set name="lifeTime">1</Set>
          <Random name="offset" min="-2,-6" max="0,6" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="ClothingOffsetFromShoes">-3</Set>
        <Set name="UserNameOffset">3</Set>
        <Set name="RenderShoesWithMermaidTail">true</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="IsRidingBird">true</Set>
	    <Set name="IsRv">true</Set>
	     <Set name="IsVehicle">true</Set>
	      <Set name="IsCar">true</Set>
	      <Set name="IsSurfboard">true</Set>
      </Default>
	    <Override overrideOnState="Motion.OnWater">
		    <Set name="IsRv">false</Set>
		    <Set name="IsCar">false</Set>
		    <Set name="IsVehicle">false</Set>
	    </Override>	    
		<Override overrideOnState="Motion.OnAir">
		    <Set name="IsRv">false</Set>
		    <Set name="IsCar">false</Set>
		    <Set name="IsVehicle">false</Set>
	    </Override>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderBehind>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSitting>true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
	  <ParticleSystemRender name="ps_trailBubbles" />
      <SpriteRender name="s_cartBack" offset="2.75,30" alignment="DOWN_CENTER"/>
    </RenderBehind>
    <RenderShoes>
      <SpriteRender name="s_cartFront" offset="2.75,6" drawShadow="false" alignment="DOWN_CENTER"/>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>

      <ParticleSystemUpdate name="ps_trailBubbles" onState="Motion.OnWater"/>
    </RenderShoes>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="Punch"/>
					<State name="ZombiePunch"/>
				</States>
				<Transitions>
					<Transition to="None" from="Punch|ZombiePunch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|ZombiePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition to="ZombiePunch" from="None|Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Sprite name="s_pot" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="22,12"/>
		<Sprite name="s_pot_particles" fileName="game/particles11.rttex" textureSize="32" frame="6,18"/>
		<Sprite name="s_ghost_particles" fileName="game/particles11.rttex" textureSize="32" frame="7,18"/>
		<Sprite name="s_crack_particles" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="s_smoke_particles" fileName="game/particles11.rttex" textureSize="32"/>
		
		<Animations>
			<SpriteAnimation name="a_crack_particles" sprite="s_crack_particles" animTime="200">
				<Frame>8,18</Frame>
				<Frame>9,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_smoke_particles" sprite="s_smoke_particles" animTime="500">
				<Frame>10,18</Frame>
				<Frame>11,18</Frame>
				<Frame>12,18</Frame>
				<Frame>13,18</Frame>
				<Frame>14,18</Frame>
				<Frame>15,18</Frame>
				<Frame>16,18</Frame>
				<Frame>17,18</Frame>
				<Frame>18,18</Frame>
				<Frame>19,18</Frame>
			</SpriteAnimation>
		</Animations>
		
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="RenderBackArmInTheFront">true</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
			</Default>
			<Override overrideOnAction="PUNCH">
				<Set name="RenderBackArmInTheFront">false</Set>
			</Override>
			<Override overrideOnAction="BUILD">
				<Set name="RenderBackArmInTheFront">false</Set>
			</Override>
		</RenderOptions>
		
		<ParticleSystems>
			<ParticleSystem name="HitCrackParticle" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_crack_particles</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Random name="initialScale" min="0.4" max="0.8"/>
					<Set name="lifeTime">0.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="80,150"/>
					<Set name="gravityVector">0, 100</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="HitGhostParticle" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_ghost_particles</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0</KeyFrame>
						<KeyFrame>0.25, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.1, 0.1</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="-180,180" radiusRange="50,100"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="HitSmokeParticle" updateStage="OnDamagedTile" renderStage="RenderInFront">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_smoke_particles</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1.5, 1.5</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialVelocity">0, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="PunchParticle" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">0, -8</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_pot_particles</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" upSpeed="-600"/>
					<Set name="gravityVector">0, 2400</Set>
					<Random name="initialRotationRate" min="400" max="700"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>

	<RenderRules>
		<OnPunchUpdate>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-800</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-800</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderFrontArm>
			<AvatarTransform class="ArmAngle" onState="Action.None">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<ContextUpdate type="PositionFootY" onState="Action.None"/>
		</RenderFrontArm>
		<RenderBackArm>
			<AvatarTransform class="ArmAngle" onState="Action.None">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<ContextUpdate type="PositionFootY" onState="Action.None"/>
		</RenderBackArm>
		<RenderHandItem>
			<SpriteRender name="s_pot" rotateOffset="true" offset="8,-2" alignment="CENTER" onState="Action.None|Action.ZombiePunch"/>
		</RenderHandItem>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_SOARING_CROPDUSTER">
  <Data>
    <StateMachines>
      <StateMachine name="trailParticleState">
        <States>
          <State name="Idle"/>
          <State name="Move"/>
        </States>
        <Transitions>
          <Transition from="Idle" to="Move" >
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Move" to="Idle" >
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Sprite name="foot1_sprite" fileName="game/player_feet16.rttex" textureSize="32" frame="12,20"/>
    <Sprite name="foot2_sprite" fileName="game/player_feet16.rttex" textureSize="32" frame="12,21"/>
    <Sprite name="trail_sprite" fileName="game/particles11.rttex" textureSize="32" frame="15,25"/>

    <Animations>
      <SpriteAnimation name="foot1_anim" sprite="foot1_sprite" animTime="400" isLoop="true" autoPlay="true">
        <Frame>12,20</Frame>
        <Frame>13,20</Frame>
        <Frame>14,20</Frame>
        <Frame>15,20</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="foot2_anim" sprite="foot2_sprite" animTime="400" isLoop="true" autoPlay="true">
        <Frame>12,21</Frame>
        <Frame>13,21</Frame>
        <Frame>14,21</Frame>
        <Frame>15,21</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="trail_Sprites" autoPlay="false" sprite="trail_sprite">
        <Frame>15,25</Frame>
        <Frame>16,25</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="trail_particle">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">10</Set>
          <Set name="emissionInterval">0.035</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="offset">-20,-4</Set>
          <Select name="rgbTint" input="intervalMS">
            <InputConfig>
              <Set name="timeMS">50</Set>
            </InputConfig>
            <Item>1,1,1</Item>
            <Item>0.65,0.99,0.98</Item>
          </Select>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="inSpecificOrder">true</Set>
          <Set name="sprite">trail_sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialVelocity">0,0</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75,0.75</KeyFrame>
            <KeyFrame>1, 3,3</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="trail_particle_back">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">10</Set>
          <Set name="emissionInterval">0.035</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="offset">10,-10</Set>
          <Select name="rgbTint" input="intervalMS">
            <InputConfig>
              <Set name="timeMS">50</Set>
            </InputConfig>
            <Item>1,1,1</Item>
            <Item>0.65,0.99,0.98</Item>
          </Select>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="inSpecificOrder">true</Set>
          <Set name="sprite">trail_sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialVelocity">0,0</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75,0.75</KeyFrame>
            <KeyFrame>1, 3,3</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="ClothingOffsetFromShoes">-18</Set>
        <Set name="UserNameOffset">18</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <Update>
      <StopIf type="or">
        <IsZombified>true</IsZombified>
        <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
    </Update>
    <RenderBehind>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="trail_particle_back" />
    </RenderBehind>
    <RenderShoes>
      <SpriteRender name="foot1_sprite" offset="-3,-5" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="foot2_sprite" offset="-3,-5" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="trail_particle"/>
      <ParticleSystemUpdate name="trail_particle_back" onState="trailParticleState.Move"/>
      <ParticleSystemUpdate name="trail_particle" onState="trailParticleState.Move"/>
    </RenderShoes>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_SOLAR_SURFER">
  <Data>
    <Sprite name="s_board1" fileName="game/player_feet16.rttex" textureSize="32" frame="30,12" />
    <Sprite name="s_board2" fileName="game/player_feet16.rttex" textureSize="32" frame="30,13" />
    <Sprite name="s_shoes1" fileName="game/player_feet16.rttex" textureSize="32" frame="31,12" />
    <Sprite name="s_shoes2" fileName="game/player_feet16.rttex" textureSize="32" frame="31,13" />
    <Sprite name="s_trail" fileName="game/particles10.rttex" textureSize="32" frame="31,31" />
    <Sprite name="s_sail" fileName="game/particles_large13.rttex" textureSize="64"/>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Move">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Jump|Fall|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="TrailMotion">
        <States>
          <State name="Idle" />
          <State name="Move" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <VariableMap>
      <Set name="sail_position">32, 24, 0</Set>
      <Set name="sail_rotation">0, 0, 0, 1</Set>
    </VariableMap>

    <Animations>
      <SpriteAnimation name="a_sailAnim" sprite="s_sail" animTime="500" autoPlay="true" isLoop="true">
        <Frame>8,12</Frame>
        <Frame>9,12</Frame>
        <Frame>10,12</Frame>
        <Frame>11,12</Frame>
        <Frame>12,12</Frame>
      </SpriteAnimation>
      <InterpolationVec4Animation name="ia_idle" variableName="sail_rotation" targetValue="0, 0, 0, 1" animTime="2000" playOnState="Motion.Idle"/>
      <InterpolationVec4Animation name="ia_move" variableName="sail_rotation" targetValue="-2.5, 0, 0, 1" animTime="2000" playOnState="Motion.Move"/>
      <InterpolationVec4Animation name="ia_jump" variableName="sail_rotation" targetValue="-5, 0, 0, 1" animTime="2000" playOnState="Motion.Jump"/>
      <InterpolationVec4Animation name="ia_fall" variableName="sail_rotation" targetValue="-7.5, 0, 0, 1" animTime="2000" playOnState="Motion.Fall"/>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="emissionInterval">0.035</Set>
          <Set name="offset">-30,-5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="inSpecificOrder">true</Set>
          <Set name="sprite">s_trail</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.2</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,1</KeyFrame>
            <KeyFrame>1, 1,0.5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="ClothingOffsetFromShoes">-5</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="UserNameOffset">26</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBehind>
      <StopIf type="or">
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsSitting>true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
      </StopIf>
      <Group>
        <Translate>sail_position</Translate>
        <Rotate>sail_rotation</Rotate>
        <SpriteRender name="s_sail" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT"/>
      </Group>

      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="ps_trail"/>
    </RenderBehind>
    <Update>
      <StopIf>
        <IsVariableBool name="isMannequin">false</IsVariableBool>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-125</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </Update>
    <RenderShoes>
      <SpriteRender name="s_shoes2" alignment="DOWN_CENTER" />
      <SpriteRender name="s_shoes1" alignment="DOWN_CENTER" />
      <SpriteRender name="s_board1" offset="0,5.5" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
      <SpriteRender name="s_board2" offset="0,5.5" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />
    
      <Group>
        <StopIf>
          <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
        </StopIf>
        <ParticleSystemUpdate name="ps_trail" onState="TrailMotion.Move"/>
      </Group>
      
      <StopIf type="or">
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsAction>PUNCH</IsAction>
        <IsAction>BUILD</IsAction>
        <IsSitting>true</IsSitting>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="Motion.Idle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-125</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Idle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>

      <AvatarTransform class="ArmAngle" onState="Motion.Move">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-120</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Move">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">75</Set>
      </AvatarTransform>

      <AvatarTransform class="ArmAngle" onState="Motion.Jump">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-115</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Jump">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">75</Set>
      </AvatarTransform>

      <AvatarTransform class="ArmAngle" onState="Motion.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-110</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Fall">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">75</Set>
      </AvatarTransform>

      <AvatarTransform class="FootPosition">
        <Set name="foot1dy">0</Set>
        <Set name="foot2dy">0</Set>
        <Set name="foot1y">0</Set>
        <Set name="foot2y">0</Set>
      </AvatarTransform>
    </RenderShoes>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_handFront" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="28,5" />
    <Sprite name="s_handBack" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="29,5" />
    <Sprite name="s_transform" fileName="game/tf_page4.rttex" textureSize="64" frame="0,13" />
    <Sprite name="s_flash" fileName="game/tf_page4.rttex" textureSize="64" frame="7,14" />
    <Sprite name="s_flashImg" fileName="game/tf_page4.rttex" textureSize="64" frame="8,14" />
    <Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="26,14" />
    <Sprite name="s_hitShard" fileName="game/particles12.rttex" textureSize="32" frame="28,14" />
    <Sprite name="s_breakShard" fileName="game/particles12.rttex" textureSize="32" frame="30,14" />
    <Sprite name="s_break" fileName="game/particles12.rttex" textureSize="32" frame="27,14" />

    <StateMachines>
      <StateMachine name="Main">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="Jump" />
          <State name="Fall" />
          <State name="PunchOnGround" />
          <State name="PunchInAir" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|Fall|PunchOnGround|Jump|PunchInAir">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|Fall|PunchOnGround|PunchInAir|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Walk|Fall|PunchInAir|PunchOnGround">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Walk|PunchInAir|PunchOnGround">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="PunchOnGround" from="Idle|Walk|PunchInAir|Jump|Fall">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="PunchInAir" from="Idle|Walk|Jump|Fall|PunchOnGround">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="IsTransformed">
        <States>
          <State name="No" />
          <State name="Transition" />
          <State name="Yes" />
        </States>
        <Transitions>
          <Transition to="Yes" from="Transition">
            <Condition>
              <IsItemTransformed>true</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="No" from="Transition">
            <Condition>
              <IsItemTransformed>false</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="Transition" from="No">
            <Condition>
              <IsItemTransformed>true</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="Transition" from="Yes">
            <Condition>
              <IsItemTransformed>false</IsItemTransformed>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
      <Override overrideOnState="IsTransformed.Yes">
        <Set name="UserNameOffset">16</Set>
      </Override>
    </RenderOptions>
    <Animations>
      <SpriteAnimation name="a_idle" sprite="s_transform" animTime="800" isLoop="true" playOnState="Main.Idle">
        <Frame>0,13</Frame>
        <Frame>1,13</Frame>
        <Frame>2,13</Frame>
        <Frame>3,13</Frame>
        <Frame>4,13</Frame>
        <Frame>5,13</Frame>
        <Frame>6,13</Frame>
        <Frame>7,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_walk" sprite="s_transform" animTime="700" isLoop="true" playOnState="Main.Walk">
        <Frame>8,13</Frame>
        <Frame>9,13</Frame>
        <Frame>10,13</Frame>
        <Frame>11,13</Frame>
        <Frame>12,13</Frame>
        <Frame>13,13</Frame>
        <Frame>14,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump" sprite="s_transform" animTime="100" isLoop="true" playOnState="Main.Jump">
        <Frame>5,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall" sprite="s_transform" animTime="200" isLoop="true" playOnState="Main.Fall">
        <Frame>6,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punch" sprite="s_transform" animTime="500" isLoop="true" playOnState="Main.PunchOnGround|Main.PunchInAir">
        <Frame>0,14</Frame>
        <Frame>1,14</Frame>
        <Frame>2,14</Frame>
        <Frame>3,14</Frame>
        <Frame>4,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_hitShards" sprite="s_hitShard">
        <Frame>28,14</Frame>
        <Frame>29,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_breakShards" sprite="s_breakShard">
        <Frame>30,14</Frame>
        <Frame>31,14</Frame>
      </SpriteAnimation>
    </Animations>
    <ParticleSystems>
      <ParticleSystem name="p_flash" updateStage="AddClothingParticles" updateState="IsTransformed.Transition">
        <Emitter>
          <Set name="offset">0, -32</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_flash</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_flashImg" updateStage="AddClothingParticles" updateState="IsTransformed.Transition">
        <Emitter>
          <Set name="offset">0, -32</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_flashImg</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 3, 3</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_flashShards" updateStage="AddClothingParticles" updateState="IsTransformed.Transition">
        <Emitter>
          <Set name="offset">0, -32</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true" usePlayerFacing="true">
          <Set name="sprite">s_hitShard</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.8, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.5,0.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="120,170" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punch">
        <Emitter attachment="targetPos">
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Random name="offset" min="-16,-16" max="16,16" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5,0.75" max="0.5,1" />
          <Set name="lifeTime">0.2</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitShard" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_hitShard</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="-4,-3" max="4,3" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="80,200" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakShard" updateStage="OnDestroyedTile">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_breakShard</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="-4,-3" max="4,3" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="80,200" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakLogo" updateStage="OnDestroyedTile">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_break</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">2</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_punch" onState="Main.PunchOnGround|Main.PunchInAir"/>
    </AddClothingParticles>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, 360</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 180</KeyFrame>
          <KeyFrame>1, 540</KeyFrame>
        </Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnRespawned>
      <ParticleSystemUpdate name="p_flashImg" />
      <ParticleSystemUpdate name="p_flash" />
      <ParticleSystemUpdate name="p_flashShards" />
    </OnRespawned>
    <RenderHandItem>
      <SpriteRender name="s_handFront" offset="0.3,16.3" rotateOffset="true" rotationPoint="0,1" blend="NORMAL" alignment="CENTER" drawShadow="true" />
    </RenderHandItem>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_handBack" offset="-4.5,11.3" rotateOffset="true" rotationPoint="1,1" blend="NORMAL" alignment="CENTER" drawShadow="true" />
    </RenderBackHandItem>
    <RenderTransform>
      <SpriteRender name="s_transform" blend="PREMULTIPLIED_ALPHA" offset="0,-8" />
    </RenderTransform>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_capeFront" fileName="game/particles_large15.rttex" textureSize="64" frame="6,3" />
    <Sprite name="s_sparkle" fileName="game/particles12.rttex" textureSize="32"/>
    
    <Animations>
      <SpriteAnimation name="a_Sparkles" sprite="s_sparkle" animTime="300" autoPlay="false">
        <Frame>0,3</Frame>
        <Frame>1,3</Frame>
        <Frame>2,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_cape" sprite="s_capeFront" animTime="1600" autoPlay="true" isLoop="true">
        <Frame>6,3</Frame>
        <Frame>7,3</Frame>
        <Frame>8,3</Frame>
        <Frame>9,3</Frame>
        <Frame>10,3</Frame>
        <Frame>11,3</Frame>
        <Frame>12,3</Frame>
        <Frame>13,3</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_SparklesTrail">
        <Emitter>
          <Set name="offset">-5,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
	      <Set name="lifeTime">0.8</Set>
          <Set name="particlesPerEmission">2</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_sparkle</Set>
          <Random name="offset" min="-8, -4" max="8, 0" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1.5</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5" max="0.7" />
          <Select name="initialRotationRate" input="randomNumber">
	          <Item>90</Item>
	          <Item>-90</Item>
          </Select>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 25</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_SparklesTrail" onState="Motion.Move"/>
    </AddClothingParticles>
	<RenderShirt>
      <SpriteRender name="s_capeFront" offset="-2,-26" blend="PREMULTIPLIED_ALPHA"/>
      <ParticleSystemRender name="ps_SparklesTrail"/>
    </RenderShirt>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_snowflakes" fileName="game/particles12.rttex" textureSize="32" frame="0,1" />
		<Sprite name="s_snowflakesHit" fileName="game/particles12.rttex" textureSize="32" frame="0,2" />
		<Sprite name="s_sword" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="6,6" />
		<Sprite name="s_punchCurve" fileName="game/particles12.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_HitStampParticle" fileName="game/particles12.rttex" textureSize="32" frame="2,0" />
		<Animations>
			<SpriteAnimation name="a_snowflakes" sprite="s_snowflakes">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakesHit" sprite="s_snowflakesHit">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="UserNameOffset">15</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">false</Set>
			</Default>
		</RenderOptions>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_hitSparkles" >
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">4</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakes</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Random name="finalScale" min="0.1" max="0.4"/>
					<Set name="initialScale">1, 1</Set>
					<Set name="interpolateScale">true</Set>				
					<Curve name="initialRotationRate">
						<KeyFrame>0, 15</KeyFrame>
						<KeyFrame>1, 5</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="0" max="360" />
					<Random name="offset" min="0, -16" max="16, 16" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="Punch.False">
				<Emitter>
					<Random name="offset" min="-22, -42" max="4, -25" />
					<Random name="emissionInterval" min="0.6" max="1" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakesHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.1</KeyFrame>
						<KeyFrame>0.5, 0.4</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">2</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_backHandSparkles" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="Punch.False">
				<Emitter>
					<Random name="offset" min="-22, -42" max="4, -25" />
					<Random name="emissionInterval" min="0.30" max="0.5" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakes</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.1</KeyFrame>
						<KeyFrame>0.5, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="15" max="60"/>
					<Random name="finalScale" min="0.3" max="0.6"/>
					<Set name="initialScale">0.8, 0.8</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.85</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">14,-16</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.25</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punchCurve</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initialScale">0.3,0.3</Set>
					<Set name="finalScale">2,2.5</Set>
					<Set name="interpolateScale">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_stamp_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_HitStampParticle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 1.3,1.3</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">215</Set>
			</AvatarTransform>
		</Update>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<SpriteRender name="s_sword" offset="13.7,3" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackHandItem>
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="animTime">500</Set>
				<Set name="Curve">
					<KeyFrame>0.0, 215</KeyFrame>
					<KeyFrame>0.3, 360</KeyFrame>
					<KeyFrame>0.8, 360</KeyFrame>
					<KeyFrame>0.81, 215</KeyFrame>
					<KeyFrame>1, 215</KeyFrame>
				</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_hitSparkles" />
			<ParticleSystemUpdate name="hit_stamp_particle" />
		</OnDamagedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_scarf" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="27,9" />
    <Sprite name="s_scarfGlow" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="28,9" />
    <Sprite name="s_cloak" fileName="game/particles12.rttex" textureSize="32" frame="2,21" />
    <Sprite name="s_sparkle" fileName="game/particles12.rttex" textureSize="32" frame="0,21" />
    <Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="7,21" />

    <StateMachines>
      <StateMachine name="TrailState">
        <States start="On">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition type="or">
              <CompareCustomVariable VariableNameToCompare="showTrail">false</CompareCustomVariable>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="showTrail">true</CompareCustomVariable>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="CloakState">
        <States start="On">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showCloak">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showCloak">true</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteCurveAnimation name="a_scarfGlow" isLoop="true" autoPlay="true" sprite="s_scarfGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="a_cloak" sprite="s_cloak" animTime="500" isLoop="true" autoPlay="true">
        <Frame>2,21</Frame>
        <Frame>3,21</Frame>
        <Frame>4,21</Frame>
        <Frame>5,21</Frame>
        <Frame>6,21</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_sparkle" sprite="s_sparkle" animTime="200" autoPlay="true" isLoop="true">
        <Frame>0,21</Frame>
        <Frame>1,21</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_trail" sprite="s_trail" animTime="300">
        <Frame>7,21</Frame>
        <Frame>8,21</Frame>
        <Frame>9,21</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_sparkle" updateStage="AddClothingParticles" renderStage="RenderChestItem">
        <Emitter>
          <Set name="offset">0,-16</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.4</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_sparkle</Set>
          <Set name="inSpecificOrder">true</Set>
          <Random name="offset" min="-8,-16" max="8,16" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.85</Set>
          <Random name="initialScale" min="0.3" max="0.8"/>
          <Random name="initialRotationRate" min="-180" max="180"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">0,-8</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">4</Set>
          <Set name="intervalMin">.05</Set>
          <Set name="intervalMax">.15</Set>
          <Set name="randomizeInterval">true</Set>
        </Emitter>
        <Particle angleRelativeToPlayerSpeed="true" randomSpriteFrame="true">
          <Set name="sprite">s_trail</Set>
          <Random name="offset" min="-8,-8" max="8,8"/>
          <Set name="lifeTime">0.7</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="useGravity">false</Set>
          <Set name="gravityVector">0,25</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.85, 0.85</KeyFrame>
            <KeyFrame>1, 1.0, 1.0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <VariableMap>
      <Set name="showCloak" UIOrder="1" RadioGroup="-1" UIName="Show Cloak">true</Set>
      <Set name="showTrail" UIOrder="2" RadioGroup="-1" UIName="Show Trail">true</Set>
    </VariableMap>

  </Data>
  <RenderRules>
    <RenderChestItem>
      <SpriteRender name="s_scarf" offset="0,-14" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_scarfGlow" drawShadow="false" offset="0,-14" blend="PREMULTIPLIED_ALPHA"/>
    </RenderChestItem>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_trail" onState="TrailState.On"/>
      <AvatarSilhouetteRender color="20,180,255,200" emissionInterval="0.25" onState="TrailState.On"/>
    </AddClothingParticles>
    <RenderChestBackItem>
      <SpriteRender name="s_cloak" offset="0,-14" blend="PREMULTIPLIED_ALPHA" scale="1.3,1" onState="CloakState.On"/>
    </RenderChestBackItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_foot1" fileName="game/player_feet16.rttex" textureSize="32" frame="6,26" />
		<Sprite name="s_foot2" fileName="game/player_feet16.rttex" textureSize="32" frame="6,27" />
		<Sprite name="s_pogoStick" fileName="game/particles12.rttex" textureSize="32" frame="9,16" />
		<VariableMap>
			<Set name="ClothingOffsetFromShoes">0</Set>
			<Set name="poleScale">1,0.3,1</Set>
			<Set name="poleOffset">0,0,0</Set>
			<Set name="leftFootYPos">0,0,0</Set>
			<Set name="rightFootYPos">0,0,0</Set>
			<Set name="leftFoot">0</Set>
			<Set name="rightFoot">0</Set>
		</VariableMap>
		<Animations>
			<CurveAnimationFloat name="a_Offset" isLoop="true" animTime="700" playOnState="MotionY.No">
				<Curve name="ClothingOffsetFromShoes">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.07, 0</KeyFrame>
					<KeyFrame>0.25, -15</KeyFrame>
					<KeyFrame>0.5, -18</KeyFrame>
					<KeyFrame>0.75, -15</KeyFrame>
					<KeyFrame>0.93, 0</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
			<CurveAnimationVec3 name="a_PoleScale" isLoop="true" animTime="700" playOnState="MotionY.No">
				<Curve name="poleScale">
					<KeyFrame>0, 1,0.2,1</KeyFrame>
					<KeyFrame>0.07, 1,0.2,1</KeyFrame>
					<KeyFrame>0.25, 1,0.4,1</KeyFrame>
					<KeyFrame>0.5, 1,0.4,1</KeyFrame>
					<KeyFrame>0.75, 1,0.4,1</KeyFrame>
					<KeyFrame>0.93, 1,0.2,1</KeyFrame>
					<KeyFrame>1, 1,0.2,1</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="a_PoleOffset" isLoop="true" animTime="700" playOnState="MotionY.No">
				<Curve name="poleOffset">
					<KeyFrame>0, 0,-1,0</KeyFrame>
					<KeyFrame>0.07, 0,-1,0</KeyFrame>
					<KeyFrame>0.25, 0,0,0</KeyFrame>
					<KeyFrame>0.5, 0,0,0</KeyFrame>
					<KeyFrame>0.75, 0,0,0</KeyFrame>
					<KeyFrame>0.93, 0,-1,0</KeyFrame>
					<KeyFrame>1, 0,-1,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="a_PoleScaleAir" isLoop="true" animTime="700" playOnState="MotionY.Yes">
				<Curve name="poleScale">
					<KeyFrame>0, 1,0.4,1</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="a_PoleScaleManne" isLoop="true" animTime="700" playOnState="MotionY.Mannequin">
				<Curve name="poleScale">
					<KeyFrame>0, 1,0.15,1</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationFloat name="a_OffsetAir" isLoop="true" animTime="700" playOnState="MotionY.Yes">
				<Curve name="ClothingOffsetFromShoes">
					<KeyFrame>0, 0</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
			<CurveAnimationFloat name="a_LeftFoot" isLoop="true" animTime="700" playOnState="MotionY.No">
				<Curve name="leftFoot">
					<KeyFrame>0, -1</KeyFrame>
					<KeyFrame>0.07, -1</KeyFrame>
					<KeyFrame>0.25, 0</KeyFrame>
					<KeyFrame>0.5, 0</KeyFrame>
					<KeyFrame>0.75, 0</KeyFrame>
					<KeyFrame>0.93, -1</KeyFrame>
					<KeyFrame>1, -1</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
			<CurveAnimationFloat name="a_RightFoot" isLoop="true" animTime="700" playOnState="MotionY.No">
				<Curve name="rightFoot">
					<KeyFrame>0, -1</KeyFrame>
					<KeyFrame>0.07, -1</KeyFrame>
					<KeyFrame>0.25, 0</KeyFrame>
					<KeyFrame>0.5, 0</KeyFrame>
					<KeyFrame>0.75, 0</KeyFrame>
					<KeyFrame>0.93, -1</KeyFrame>
					<KeyFrame>1, -1</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
		</Animations>
		<StateMachines>
			<StateMachine name="MotionY">
				<States>
					<State name="No" />
					<State name="Yes" />
					<State name="Mannequin" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isMannequin">false</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isMannequin">false</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Mannequin" from="No|Yes">
						<Condition>
							<IsVariableBool name="isMannequin">true</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-5</Set>
				<Set name="UserNameOffset">14</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
        <IsSitting>true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">leftFoot</Set>
				<Set name="foot2dy">rightFoot</Set>
				<Set name="foot1y">leftFoot</Set>
				<Set name="foot2y">rightFoot</Set>
			</AvatarTransform>
      <MusicSource onAction="JUMP">
        <Set name="MusicFile">audio/trampoline.wav</Set>
      </MusicSource>
		</Update>
		<RenderShoes>
			<Group>
				<Translate onState="MotionY.No">poleOffset</Translate>
				<Scale>poleScale</Scale>
				<SpriteRender name="s_pogoStick" offset="-4,0" alignment="UPPER_CENTER" />
				<SpriteRender name="s_pogoStick" offset="8,0" alignment="UPPER_CENTER" />
			</Group>
			<Group>
				<Translate>leftFootYPos</Translate>
				<SpriteRender name="s_foot1" alignment="DOWN_CENTER" />
			</Group>
			<Group>
				<Translate>rightFootYPos</Translate>
				<SpriteRender name="s_foot2" alignment="DOWN_CENTER" />
			</Group>
			<Group>
        <StopIf>
          <IsAction operatorType="Equal">BUILD</IsAction>
          <IsAction operatorType="Equal">PUNCH</IsAction>
          <IsVariableFloat name="speed.y" operator="Greater" abs="true">0.1</IsVariableFloat>
        </StopIf>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
			</Group>
		</RenderShoes>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_staff" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="0,11" />
    <Sprite name="s_punchSparkleMain" fileName="game/particles12.rttex" textureSize="32" frame="24,12"/>
    <Sprite name="s_punchSparkleTrail" fileName="game/particles12.rttex" textureSize="32" frame="25,12"/>

    <Animations>
      <SpriteAnimation name="a_staff" sprite="s_staff" autoPlay="true" isLoop="true" animTime="400">
        <Frame>0,11</Frame>
        <Frame>1,11</Frame>
        <Frame>2,11</Frame>
        <Frame>3,11</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_mainPunchSparkleMain" updateStage="OnPunchStart" secondary="ps_trail">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-48</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchSparkleMain</Set>
          <Random name="offset" min="-60,-35" max="60,-25"/>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.5</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">80</Set>
          <Set name="emissionInterval">0.05</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchSparkleTrail</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.3</Set>
          <Random name="initialRotationRate" min="-120" max="120"/>
          <Random name="offset" min="-2,-2" max="2,2"/>
          <Random name="initialScale" min="0.5,0.5" max="1,1"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="OnGround"/>
          <State name="InAir"/>
          <State name="Punching"/>
        </States>
        <Transitions>
          <Transition to="OnGround" from="InAir|Punching">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="InAir" from="OnGround|Punching">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punching" from="OnGround|InAir">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <Update>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="Action.InAir">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-140</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Action.OnGround|Action.Punching">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-90</Set>
      </AvatarTransform>
    </Update>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <Translate onState="Action.OnGround">-3,3,0</Translate>
      
      <Translate onState="Action.InAir">-6,2,0</Translate>
      <Rotate onState="Action.InAir">50,0,0,1</Rotate>

      <Translate onState="Action.Punching">-3,3,0</Translate>
      <Rotate onState="Action.Punching">20,0,0,1</Rotate>
      
      <SpriteRender name="s_staff" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackHandItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="Sprite33" fileName="game/particles_large16.rttex" textureSize="64,64" frame="0,8" />
        <Animations>
            <SpriteAnimation name="Animation34" sprite="Sprite33" isLoop="true" autoPlay="true" animTime="1200">
                <Frame>0,8</Frame>
                <Frame>1,8</Frame>
                <Frame>2,8</Frame>
                <Frame>3,8</Frame>
                <Frame>4,8</Frame>
                <Frame>5,8</Frame>
            </SpriteAnimation>
        </Animations>
        <ParticleSystems />
    </Data>
    <RenderRules>
        <RenderBackpack>
            <ContextUpdate type="SetFlip">
                <Set name="flip">false</Set>
            </ContextUpdate>
            <SpriteRender name="Sprite33" alignment="DOWN_CENTER" drawShadow="false" />
        </RenderBackpack>
    </RenderRules>
</ItemRenderer>
