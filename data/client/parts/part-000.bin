			</SpriteAnimation>
			<SpriteAnimation name="a_hell_punch" sprite="s_reeel" animTime="400" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_gacor_projectile" sprite="s_voww" animTime="300" isLoop="true">
