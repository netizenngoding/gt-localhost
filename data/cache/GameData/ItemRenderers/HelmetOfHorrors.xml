<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_helmet" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="6,13"/>

    <Sprite name="s_bat" textureSize="32" fileName="game/particles12.rttex" frame="12,25"/>

    <Sprite name="s_hit" textureSize="32" fileName="game/particles12.rttex" frame="15,25"/>

    <Animations>
      <SpriteAnimation name="a_helmetPunch" autoPlay="true" sprite="s_helmet" isLoop="true" animTime="100" playOnState="Punch.Yes">
				<Frame>7,13</Frame>
			</SpriteAnimation>
      <SpriteAnimation name="a_helmetIdle" autoPlay="true" sprite="s_helmet" isLoop="true" animTime="100" playOnState="Punch.No">
				<Frame>6,13</Frame>
			</SpriteAnimation>
      <SpriteAnimation sprite="s_bat" name="a_bat" animTime="300">
				<Frame>12,25</Frame>
				<Frame>13,25</Frame>
				<Frame>14,25</Frame>
			</SpriteAnimation>
      <SpriteAnimation sprite="s_hit" name="a_hit" animTime="400">
				<Frame>15,25</Frame>
				<Frame>16,25</Frame>
				<Frame>17,25</Frame>
				<Frame>18,25</Frame>
			</SpriteAnimation>
    </Animations>

    <StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

    <ParticleSystems>
			<ParticleSystem name="ps_punchRight">
				<Emitter attachment="contextRotation">
					<Set name="lifeTime">0.15</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offset">5,-28</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="0, -8" max="0, 8"/>
					<Set name="sprite">s_bat</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="targetPosOffset" min="-15, -8" max="15, 8"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<OnFinish>
						<ParticleSystemName>ps_punchHit</ParticleSystemName>
					</OnFinish>
					<Set name="initialScale">0.7,0.7</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchLeft">
				<Emitter attachment="contextRotation">
					<Set name="lifeTime">0.15</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offset">5,-28</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="0, -8" max="0, 8"/>
					<Set name="sprite">s_bat</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="targetPosOffset" min="-15, -8" max="15, 8"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<OnFinish>
						<ParticleSystemName>ps_punchHit</ParticleSystemName>
					</OnFinish>
					<Set name="flipY">true</Set>
					<Set name="initialScale">0.7,0.7</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchHit">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0.75, 0.75</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.2</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Select name="initialRotationRate" input="randomNumber">
						<Item>-720</Item>
						<Item>720</Item>
					</Select>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

  </Data>

  <RenderRules>
    <RenderFaceItem>
      <SpriteRender name="s_helmet" offset="0,-16" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <Group onState="Facing.Right">
				<ParticleSystemUpdate name="ps_punchRight" onState="Punch.Yes"/>
			</Group>
      <Group onState="Facing.Left">
				<ParticleSystemUpdate name="ps_punchLeft" onState="Punch.Yes"/>
			</Group>
    </RenderFaceItem>
  </RenderRules>
</ItemRenderer>