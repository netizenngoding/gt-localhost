<ItemRenderer>
<!-- DMVOWFOR ITEM LIKE THIS @reeel. ON DISCORD -->
  <Data>
    <StateMachines>
      <StateMachine name="playerState">
        <States>
          <State name="Equip"/>
          <State name="Fall"/>
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition from="Equip" to="Fall" >
            <Condition>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Fall" to="Equip">
            <Condition>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Equip|Fall" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Equip">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Fall">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="trailParticleState">
        <States>
          <State name="Equip"/>
          <State name="HorizontalMove"/>
          <State name="Punch"/>
          <State name="Sleep"/>
        </States>
        <Transitions>
          <Transition from="Equip|HorizontalMove|Punch" to="Sleep" >
            <Condition>
              <IsSleepingOnaBed>true</IsSleepingOnaBed>
            </Condition>
          </Transition>
          <Transition from="Equip|HorizontalMove|Sleep" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch|HorizontalMove|Sleep" to="Equip">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Punch|Equip|Sleep" to="HorizontalMove">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Facing">
        <States>
          <State name="Left" />
          <State name="Right" />
        </States>
        <Transitions>
          <Transition to="Left" from="Right">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition to="Right" from="Left">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="ScytheAnimation">
        <States>
          <State name="Before" />
          <State name="Idle" />
        </States>
        <Transitions>
          <Transition from="Before" to="Idle">
            <Condition>
              <IsAnimationFinished>a_buddha_earth_before</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <!-- scy0 -->
    <!-- DM VOW FOR ITEM LIKE THIS -->
    <Sprite name="VOWEQ" fileName="game/UGCSpritesheet88v0.rttex" textureSize="512,512" frame="0,0" />
    <!-- sw1 -->
    <Sprite name="slash_sprite" fileName="game/UGCSpritesheet88v1.rttex" textureSize="64"/>
    <Sprite name="s_raygun_smoke" fileName="game/UGCSpritesheet88v1.rttex" textureSize="64"/>
    <Sprite name="s_ProjectileIni" fileName="game/UGCSpritesheet88v1.rttex" textureSize="64"/>

    <!-- slash_godly2 -->
    <Sprite name="punch_projectile_sprite" fileName="game/UGCSpritesheet88v2.rttex" textureSize="240,142"/>
    <Sprite name="s_meledakDuar" fileName="game/UGCSpritesheet88v2.rttex" textureSize="240,142"/>
    <Sprite name="s_buddha_fire" fileName="game/UGCSpritesheet88v2.rttex" textureSize="240,142"/>

    <!--particles3  -->
    <Sprite name="particle_1" fileName="game/UGCSpritesheet88v3.rttex" textureSize="32" frame="1,0"/>
    <Sprite name="s_debu" fileName="game/UGCSpritesheet88v3.rttex" textureSize="32" frame="10,0" />
    <Sprite name="s_debuWinter" fileName="game/UGCSpritesheet88v3.rttex" textureSize="32" frame="0,0"/>
    <Sprite name="s_flameHit" fileName="game/UGCSpritesheet88v3.rttex" textureSize="32" frame="0,2" />
    <Sprite name="s_flameCurve" fileName="game/UGCSpritesheet88v3.rttex" textureSize="32" frame="20,0" />

    <!-- remove=error so dont touch this
         -vow :)
    -->
    <Sprite name="s_buddha" fileName="game/itemsLikeThisDMVOW.rttex" textureSize="64"/>


    <Animations>
      <SpriteAnimation name="a_hit_fire" sprite="s_flameHit" animTime="400" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>8,0</Frame>
        <Frame>9,0</Frame>
        <Frame>10,0</Frame>
        <Frame>11,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_snowflakes" sprite="s_debuWinter">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_raps_equip" playOnState="playerState.Equip|playerState.Fall|playerState.Punch" sprite="VOWEQ" animTime="400" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_raps_p" playOnState="playerState.Punch" sprite="punch_projectile_sprite" animTime="400" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="slash_animation" sprite="slash_sprite" animTime="175" isLoop="true" playOnState="playerState.Punch">
        <Frame>0,8</Frame>
        <Frame>8,8</Frame>
        <Frame>2,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="particle_animation" sprite="particle_1" animTime="500" isLoop="true">
        <!-- <Frame>1,0</Frame> -->
        <Frame>20,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_earth_before" sprite="s_buddha" autoPlay="true" animTime="800" playerState="ScytheAnimation.Before">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
        <Frame>4,1</Frame>
        <Frame>5,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_earth_after" sprite="s_buddha" animTime="600" isLoop="true" playOnState="ScytheAnimation.Idle">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_punch" sprite="s_buddha" animTime="400" isLoop="true" playOnAction="PUNCH">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
        <Frame>4,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_gacor_projectile" sprite="s_ProjectileIni" animTime="300" isLoop="false">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_gacor_destroy_impact" sprite="s_meledakDuar" animTime="400" isLoop="false">
        <Frame>0,3</Frame>
        <Frame>1,3</Frame>
        <Frame>0,5</Frame>
        <Frame>1,5</Frame>
        <Frame>2,5</Frame>
        <Frame>3,5</Frame>
        <Frame>4,5</Frame>
        <Frame>5,5</Frame>
        <Frame>6,5</Frame>
        <Frame>7,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_pet_fireball" sprite="s_buddha_fire" animTime="400" isLoop="true">
        <Frame>0,6</Frame>
        <Frame>1,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_earth" sprite="s_raygun_smoke" animTime="800" isLoop="false">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="UserNameOffset">5</Set>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
      </Default>
    </RenderOptions>
  <ParticleSystems>
<ParticleSystem name="ps_scytheFade">
  <Emitter>
    <!-- Spawns a new frame every 0.133 seconds (400ms divided by 3 frames) -->
    <Set name="emissionInterval">0.133</Set>
    <Set name="infParticles">true</Set>
    <Set name="infLifeTime">true</Set>
    <Set name="particlesPerEmission">1</Set>
  </Emitter>
  <Particle>
    <Set name="sprite">VOWEQ</Set>
    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    <!-- Matches your 400ms (0.4s) total animation time -->
    <Set name="lifeTime">0.4</Set>
    <!-- Controls how long it stays visible before fading out -->
    <Curve name="initialAlpha">
      <KeyFrame>0, 1</KeyFrame>      <!-- Starts at 100% visible -->
      <KeyFrame>0.5, 0.8</KeyFrame>  <!-- Stays mostly visible midway -->
      <KeyFrame>1, 0</KeyFrame>      <!-- Fades to invisible right at 0.4s -->
    </Curve>
  </Particle>
</ParticleSystem>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileIni</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Random name="finalScale" min="2" max="4"/>
          <Set name="interpolateScale">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_meledakDuar</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-300</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_buddha_fire</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <!-- <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_raygun_smoke</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.8</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem> -->
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="offset">0,-32</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_raygun_smoke</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,10,10</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_debu</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
            <KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <!-- <Set name="sprite">s_debuWinter</Set> -->
          <Set name="sprite">s_flameHit</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_crack">
        <Emitter>
          <Set name="offset">-20, -16</Set>
          <Set name="emissionInterval">0.15</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">particle_1</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Set name="relativeToEmitter">true</Set>
          <Random name="initialAngle" min="190" max="-190" />
          <Set name="initialScale">0.68,0.68</Set>
          <Random name="offset" min="-2,-7" max="2,7" />
          <Set name="lifeTime">0.3</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="VOWEQ" offset="17,10" scale="0.25,0.25" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" drawShadow="true" onState="playerState.Equip|playerState.Fall|playerState.Punch" />
    </RenderBackHandItem>
    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="punch_projectile_sprite" offset="50,-55" alignment="CENTER" rotateOffset="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="1,1" onAction="PUNCH" />
      <SpriteRender name="slash_sprite" offset="12,-20" scale="1.25,1.25" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="playerState.Punch" drawShadow="false" tintOverride="255,255,255,255"/>
      <SpriteRender name="s_buddha" offset="0,-360" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle" />
    </RenderInFront>
    <AddClothingParticles>

<AddClothingParticles>
  <ParticleSystemUpdate name="ps_scytheFade"/>
</AddClothingParticles>

      <StopIf type="or">
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <ParticleSystemUpdate name="ps_crack"/>
    </AddClothingParticles>
    <OnPunchStart>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <ParticleSystemUpdate name="ps_gacorProjectile"/>
      <ParticleSystemUpdate name="ps_petFireball"/>
    </OnPunchStart>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1200</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_crack"/>
    </SwitchOffClothingParticles>
    <RenderFrontpack>
      <ParticleSystemRender name="ps_crack" />
    </RenderFrontpack>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <!-- swrd0 -->
    <Sprite name="vow" fileName="game/UGCSpritesheet89v0.rttex" textureSize="512,512" frame="0,0" />
    <!-- sw1 -->
    <Sprite name="vowme" fileName="game/UGCSpritesheet89v1.rttex" textureSize="64"/>
    <Sprite name="vowreeel" fileName="game/UGCSpritesheet89v1.rttex" textureSize="64"/>
    <Sprite name="dmvowforthis" fileName="game/UGCSpritesheet89v1.rttex" textureSize="64"/>
    <Sprite name="vow_afterProjectile" fileName="game/UGCSpritesheet89v1.rttex" textureSize="64"/>
    <Sprite name="vow_flameHit" fileName="game/UGCSpritesheet89v1.rttex" textureSize="64" frame="0,0" />
    <Sprite name="vow_aduhai" fileName="game/UGCSpritesheet89v1.rttex" textureSize="64" />

    <!-- slash_olympus2 -->
    <Sprite name="vow_punch_projectile" fileName="game/UGCSpritesheet89v2.rttex" textureSize="240,142"/>
    <Sprite name="vow_meledakDuar" fileName="game/UGCSpritesheet89v2.rttex" textureSize="240,142"/>
    <Sprite name="vow_buddha_fire" fileName="game/UGCSpritesheet89v2.rttex" textureSize="240,142"/>

    <!--particles3  -->
    <Sprite name="vow_particle_1" fileName="game/UGCSpritesheet89v3.rttex" textureSize="32" frame="1,0"/>
    <Sprite name="vow_debu" fileName="game/UGCSpritesheet89v3.rttex" textureSize="32" frame="10,0" />
    <Sprite name="vow_debuWinter" fileName="game/UGCSpritesheet89v3.rttex" textureSize="32" frame="0,0"/>
    <Sprite name="vow_flameCurve" fileName="game/UGCSpritesheet89v3.rttex" textureSize="32" frame="20,0" />

    <!-- remove=error so dont touch this
         -vow :)
    -->
    <Sprite name="s_buddha" fileName="game/itemsLikeThisDMVOW.rttex" textureSize="64"/>
    <StateMachines>

<StateMachine name="TileAnimationState">
  <States>
    <State name="Before" />
    <State name="After" />
  </States>
  <Transitions>
    <Transition from="Before" to="After">
      <Condition>
        <IsAnimationFinished>a_buddha_earth</IsAnimationFinished>
      </Condition>
    </Transition>
  </Transitions>
</StateMachine>

      <StateMachine name="playerState">
        <States>
          <State name="Equip"/>
          <State name="Fall"/>
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition from="Equip" to="Fall" >
            <Condition>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Fall" to="Equip">
            <Condition>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Equip|Fall" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Equip">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Fall">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="trailParticleState">
        <States>
          <State name="Equip"/>
          <State name="HorizontalMove"/>
          <State name="Punch"/>
          <State name="Sleep"/>
        </States>
        <Transitions>
          <Transition from="Equip|HorizontalMove|Punch" to="Sleep" >
            <Condition>
              <IsSleepingOnaBed>true</IsSleepingOnaBed>
            </Condition>
          </Transition>
          <Transition from="Equip|HorizontalMove|Sleep" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch|HorizontalMove|Sleep" to="Equip">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Punch|Equip|Sleep" to="HorizontalMove">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Facing">
        <States>
          <State name="Left" />
          <State name="Right" />
        </States>
        <Transitions>
          <Transition to="Left" from="Right">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition to="Right" from="Left">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="ScytheAnimation">
        <States>
          <State name="Before" />
          <State name="Idle" />
        </States>
        <Transitions>
          <Transition from="Before" to="Idle">
            <Condition>
              <IsAnimationFinished>a_buddha_earth_before</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>


    <Animations>
      <SpriteAnimation name="a_buddha_earth_before" sprite="s_buddha" autoPlay="true" animTime="800" playerState="ScytheAnimation.Before">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
        <Frame>4,1</Frame>
        <Frame>5,1</Frame>
      </SpriteAnimation>
<SpriteAnimation name="a_buddha_earth" sprite="vowreeel" autoPlay="true" animTime="800" isLoop="false" playOnState="TileAnimationState.Before">
  <Frame>0,1</Frame>
  <Frame>1,1</Frame>
  <Frame>2,1</Frame>
  <Frame>3,1</Frame>
  <Frame>4,1</Frame>
  <Frame>5,1</Frame>
</SpriteAnimation>

<SpriteAnimation name="afterTile" sprite="vow_afterProjectile" animTime="400" isLoop="true" playOnState="TileAnimationState.After">
  <Frame>0,2</Frame>
  <Frame>1,2</Frame>
  <Frame>2,2</Frame>
  <Frame>3,2</Frame>
  <Frame>4,2</Frame>
  <Frame>5,2</Frame>
  <Frame>6,2</Frame>
  <Frame>7,2</Frame>
  <Frame>8,2</Frame>
  <Frame>9,2</Frame>
  <Frame>10,2</Frame>
  <Frame>11,2</Frame>
  <Frame>12,2</Frame>
  <Frame>13,2</Frame>
</SpriteAnimation>
      <SpriteAnimation name="a_hit_fire" sprite="vow_flameHit" animTime="400" isLoop="true">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
        <Frame>4,2</Frame>
        <Frame>5,2</Frame>
        <Frame>6,2</Frame>
        <Frame>7,2</Frame>
        <Frame>8,2</Frame>
        <Frame>9,2</Frame>
        <Frame>10,2</Frame>
        <Frame>11,2</Frame>
        <Frame>12,2</Frame>
        <Frame>13,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_snowflakes" sprite="vow_debuWinter">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_raps_equip" playOnState="playerState.Equip|playerState.Fall|playerState.Punch" sprite="vow" animTime="400" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_raps_p" playOnState="playerState.Punch" sprite="vow_punch_projectile" animTime="400" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="slash_animation" sprite="vowme" animTime="175" isLoop="true" playOnState="playerState.Punch">
        <Frame>0,8</Frame>
        <Frame>8,8</Frame>
        <Frame>2,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="particle_animation" sprite="vow_particle_1" animTime="500" isLoop="true">
        <Frame>20,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_earth_after" sprite="s_buddha" animTime="600" isLoop="true" playOnState="ScytheAnimation.Idle">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_buddha_punch" sprite="s_buddha" animTime="400" isLoop="true" playOnAction="PUNCH">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
        <Frame>4,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_gacor_projectile" sprite="dmvowforthis" animTime="300" isLoop="false">
        <Frame>0,3</Frame>
        <Frame>1,3</Frame>
        <Frame>2,3</Frame>
        <Frame>3,3</Frame>
        <Frame>4,3</Frame>
        <Frame>5,3</Frame>
        <Frame>6,3</Frame>
        <Frame>7,3</Frame>
        <Frame>8,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_gacor_destroy_impact" sprite="vow_meledakDuar" animTime="400" isLoop="false">
        <Frame>0,3</Frame>
        <Frame>1,3</Frame>
        <Frame>0,5</Frame>
        <Frame>1,5</Frame>
        <Frame>2,5</Frame>
        <Frame>3,5</Frame>
        <Frame>4,5</Frame>
        <Frame>5,5</Frame>
        <Frame>6,5</Frame>
        <Frame>7,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_pet_fireball" sprite="vow_buddha_fire" animTime="400" isLoop="true">
        <Frame>0,6</Frame>
        <Frame>1,6</Frame>
      </SpriteAnimation>

      <SpriteAnimation name="Lightning_Anim" sprite="vow_aduhai" autoPlay="true" animTime="910" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>8,0</Frame>
        <Frame>9,0</Frame>
        <Frame>10,0</Frame>
        <Frame>11,0</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="UserNameOffset">5</Set>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
      </Default>
    </RenderOptions>
  <ParticleSystems>
<ParticleSystem name="ps_scytheFade">
  <Emitter>
    <Set name="emissionInterval">0.133</Set>
    <Set name="infParticles">true</Set>
    <Set name="infLifeTime">true</Set>
    <Set name="particlesPerEmission">1</Set>
  </Emitter>
  <Particle>
    <Set name="sprite">vow</Set>
    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
    <Set name="lifeTime">0.4</Set>
    <Curve name="initialAlpha">
      <KeyFrame>0, 1</KeyFrame>
      <KeyFrame>0.5, 0.8</KeyFrame>
      <KeyFrame>1, 0</KeyFrame>
    </Curve>
  </Particle>
</ParticleSystem>
      <ParticleSystem name="ps_gacorProjectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">5,-18</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">dmvowforthis</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Random name="finalScale" min="2" max="4"/>
          <Set name="interpolateScale">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1,1</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_gacorDestroyImpact</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_gacorDestroyImpact">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vow_meledakDuar</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Curve name="initialScale">
            <KeyFrame>0,3,3</KeyFrame>
            <KeyFrame>1,3,3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.75,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petFireball" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">64,-300</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vow_buddha_fire</Set>
          <Set name="offset">0,-16</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>1,1</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0,1.5,1.5</KeyFrame>
            <KeyFrame>1,1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <OnFinish>
            <ParticleSystemName>ps_petTornado</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petTornado">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="offset">0,-100</Set>
          <Set name="sprite">vowreeel</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,5,5</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
          <OnFinish>
            <ParticleSystemName>ps_AfterProjectile</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_AfterProjectile">
        <Emitter>
          <Set name="offset">0,-960</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vowreeel</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialScale">
            <KeyFrame>0,2,4</KeyFrame>
            <KeyFrame>1,10,10</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0,1</KeyFrame>
            <KeyFrame>0.85,1</KeyFrame>
            <KeyFrame>1,0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesRight" updateStage="OnDamagedTile" updateState="Facing.Right">
        <Emitter>
          <Set name="offset">0,-15</Set>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vow_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">3</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.90,0.90</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparklesLeft" updateStage="OnDamagedTile" updateState="Facing.Left">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vow_flameHit</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">vow_debu</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2,2</KeyFrame>
            <KeyFrame>0.5, 3,3</KeyFrame>
            <KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, -100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vow_flameHit</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_crack">
        <Emitter>
          <Set name="offset">-20, -16</Set>
          <Set name="emissionInterval">0.15</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">vow_particle_1</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Set name="relativeToEmitter">true</Set>
          <Random name="initialAngle" min="190" max="-190" />
          <Set name="initialScale">0.68,0.68</Set>
          <Random name="offset" min="-2,-7" max="2,7" />
          <Set name="lifeTime">0.3</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    		<OnDrawCustomOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">getCurrent</Set>
        <Set name="brightness">getCurrent</Set>
        <Set name="contrast">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="RenderData">
        <Set name="saturation">50</Set>
        <Set name="brightness">1</Set>
        <Set name="contrast">1</Set>
      </AvatarTransform>
      <AvatarOutline duration="1500" startScale="1,1" endScale="1.1,1.1">
		<Colours>
          <Colour>255,213,65,255</Colour>
          <Colour>255,235,163,255</Colour>
        </Colours>
      </AvatarOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">reset</Set>
        <Set name="brightness">reset</Set>
        <Set name="contrast">reset</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">reset</Set>
      </AvatarTransform>
    </OnDrawCustomOutline>
    
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="vow" offset="40,5" scale="0.20,0.20" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" drawShadow="true" onState="playerState.Equip|playerState.Fall|playerState.Punch" />
    </RenderBackHandItem>
    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="vow_aduhai" alignment="DOWN_CENTER" offset="0,7" onAction="IDLE|PUNCH|WALK|JUMP|FALL" drawShadow="false" />
      <SpriteRender name="vow_punch_projectile" offset="50,-55" alignment="CENTER" rotateOffset="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="1,1" onAction="PUNCH" />
      <SpriteRender name="vowme" offset="12,-20" scale="1.25,1.25" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="playerState.Punch" drawShadow="false" tintOverride="255,255,255,255"/>
      <SpriteRender name="s_buddha" offset="0,-360" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle" />
    </RenderInFront>
    <AddClothingParticles>

<AddClothingParticles>
  <ParticleSystemUpdate name="ps_scytheFade"/>
</AddClothingParticles>

      <StopIf type="or">
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <ParticleSystemUpdate name="ps_crack"/>
    </AddClothingParticles>
<OnPunchStart>
  <StopIf>
    <IsZombified>true</IsZombified>
  </StopIf>
  <ParticleSystemUpdate name="ps_gacorProjectile"/>
  <ParticleSystemUpdate name="ps_petFireball"/>
</OnPunchStart>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1200</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_crack"/>
    </SwitchOffClothingParticles>
    <RenderFrontpack>
      <ParticleSystemRender name="ps_crack" />
    </RenderFrontpack>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
      <ParticleSystemUpdate name="ps_AfterProjectile"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_scythe" fileName="game/UGCSpritesheet9v0.rttex" textureSize="132"/>
		<Sprite name="s_punch_eff" fileName="game/UGCSpritesheet9v1.rttex" textureSize="318"/>
		<Sprite name="s_trail" fileName="game/UGCSpritesheet9v2.rttex" textureSize="32"/>
		<Sprite name="s_DestroyImpact" fileName="game/UGCSpritesheet9v2.rttex" textureSize="32"/>
		<Sprite name="s_break" fileName="game/UGCSpritesheet9v2.rttex" textureSize="32"/>
		<Sprite name="s_breakflame" fileName="game/UGCSpritesheet9v2.rttex" textureSize="32"/>
		<Animations>
			<SpriteAnimation name="a_hell_punch" sprite="s_punch_eff" animTime="300" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="s_breakflame">
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakesHit" sprite="s_DestroyImpact">
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_trail" sprite="s_trail">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hell_after" sprite="s_scythe" animTime="500" isLoop="true" autoPlay="true" >
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>0,3</Frame>
			</SpriteAnimation>
			<InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-120, 0, 0, 1" animTime="2000" playOnState="Punch.False"/>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_breakflame" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_breakflame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Random name="offset" min="0" max="16" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 1,1</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_SparklesTrail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Move">
				<Emitter>
					<Set name="offset">0,-5</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_trail</Set>
					<Random name="offset" min="0, -12" max="4, 1" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="lifeTime" input="randomNumber">
						<Item>0.3</Item>
						<Item>0.6</Item>
					</Select>
					<Random name="initialScale" min="0.5" max="0.8" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_JumpTrail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Jump">
				<Emitter>
					<Set name="offset">0,-5</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_trail</Set>
					<Random name="offset" min="-8, -12" max="4, 0" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="lifeTime" input="randomNumber">
						<Item>0.3</Item>
						<Item>0.6</Item>
					</Select>
					<Set name="initialAngle">270</Set>
					<Random name="initialScale" min="0.5" max="0.8" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_FallTrail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Fall">
				<Emitter>
					<Set name="offset">0,-5</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_trail</Set>
					<Random name="offset" min="-8, -12" max="4, 0" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="lifeTime" input="randomNumber">
						<Item>0.3</Item>
						<Item>0.6</Item>
					</Select>
					<Set name="initialAngle">90</Set>
					<Random name="initialScale" min="0.5" max="0.8" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="UserNameOffset">15</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="DefaultPunchSound">audio/droar.wav</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
		<TileStampData>
			<Set name="FileName">game/UGCSpritesheet9v2.rttex</Set>
			<Set name="EndFrame">8,0</Set>
			<Set name="FrameCount">5</Set>
		</TileStampData>

	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-120</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="s_punch_eff" offset="50,-35" alignment="CENTER" rotateOffset="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="0.7,0.7" onAction="PUNCH" />
		</RenderInFront>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<Group>
			<Rotate>Sword_rotation</Rotate>
			<SpriteRender name="s_scythe" offset="-12,28" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="0.55,0.55" />
			</Group>
		</RenderBackHandItem>
		<RenderPet>
		</RenderPet>
		<UpdatePet>
		</UpdatePet>

		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
<!-- dm reeel. for items like this :) -->
  <Data>
    <!-- natwing0 -->
    <Sprite name="vow" fileName="game/UGCSpritesheet90v0.rttex" textureSize="256,256"/>
    <!-- natjump1 -->
    <Sprite name="iniParticlenya" fileName="game/UGCSpritesheet90v1.rttex" textureSize="128" frame="0,0"/>
    <!-- natdeath2 -->
    <Sprite name="deathVow" fileName="game/UGCSpritesheet90v2.rttex" textureSize="128"/>
    <Sprite name="flakeVow" fileName="game/UGCSpritesheet90v2.rttex" textureSize="128" frame="0,0"/>
    <Sprite name="tVow" fileName="game/UGCSpritesheet90v2.rttex" textureSize="128" frame="0,0"/>
    <!-- <Sprite name="iniTrail" fileName="game/flamingssFet" textureSize="64" frame="0,0"/> -->
        <!-- <Sprite name="s_glow" fileName="game/particles_large17" textureSize="64" frame="9,3"/> -->

    <Animations>
      <SpriteAnimation name="a_particle" sprite="iniParticlenya" isLoop="true" animTime="400">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>8,0</Frame>
        <Frame>9,0</Frame>
        <Frame>10,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Jump" playOnAction="JUMP|JUMPDOUBLE" sprite="vow" animTime="400" autoPlay="true" isLoop="false">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>  
      </SpriteAnimation>
      <SpriteAnimation name="Fall" playOnAction="FALL" sprite="vow" animTime="400" autoPlay="true" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>  
      </SpriteAnimation>
      <SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="vow" autoPlay="true" isLoop="true" animTime="750">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>  
      </SpriteAnimation>
      <SpriteAnimation name="a_snowflake" sprite="flakeVow" isLoop="true" animTime="400">
        <Frame>0,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_trail" sprite="tVow" isLoop="true" animTime="300">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
        <Frame>4,1</Frame>
        <!-- <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
        <Frame>4,2</Frame>
        <Frame>5,2</Frame>
        <Frame>6,2</Frame>
        <Frame>7,2</Frame>
        <Frame>8,2</Frame>
        <Frame>9,2</Frame>
        <Frame>10,2</Frame> -->
      </SpriteAnimation>
      <SpriteAnimation name="a_death" sprite="deathVow" animTime="1200">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>8,0</Frame>
        <Frame>9,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="iniParticlenya_jump">
        <Emitter>
          <Random name="offset" min="0, 40" max="0, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">1.1, 1.1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_left">
        <Emitter>
          <Random name="offset" min="40, 40" max="32, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">1.1, 1.1</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_right">
        <Emitter>
          <Random name="offset" min="-32, 40" max="-40, 40" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
