			</SpriteAnimation>
			<SpriteAnimation name="a_card_particle_front" sprite="s_card_particle_front" isLoop="true" animTime="200">
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="a_card_particle_back" sprite="s_card_particle_back" isLoop="true" animTime="200">
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_card_particle_front_burn" sprite="s_card_particle_front_burn" isLoop="false" animTime="1100">
				<Frame>1,8</Frame>
				<Frame>2,8</Frame>
				<Frame>3,8</Frame>
				<Frame>4,8</Frame>
				<Frame>5,8</Frame>
				<Frame>6,8</Frame>
				<Frame>7,8</Frame>
				<Frame>8,8</Frame>
				<Frame>9,8</Frame>
				<Frame>10,8</Frame>
				<Frame>11,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_card_particle_back_burn" sprite="s_card_particle_back_burn" isLoop="false" animTime="800">
				<Frame>1,9</Frame>
				<Frame>2,9</Frame>
				<Frame>3,9</Frame>
				<Frame>4,9</Frame>
				<Frame>5,9</Frame>
				<Frame>6,9</Frame>
				<Frame>7,9</Frame>
				<Frame>8,9</Frame>
				<Frame>9,9</Frame>
				<Frame>10,9</Frame>
				<Frame>11,9</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">false</Set>
				<Set name="IgnorePunchTypeDamagedTileCheck">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IsToRenderParticlesWhenShrunken">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="Arc1" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.75</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_card_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart">-0.2</Set>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="lifeTime">6.1</Set>
					<Set name="orbitPeriod">5.8</Set>
					<Set name="initialRotationRate">0</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="orbit">-24, 3</Set>
					<Set name="orbitScaleVariation">0.08</Set>
					<Set name="orbitSkew">0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchProjectile" updateState="Action.Punch">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Random name="variantId" min="0" max="4" />
					<Select name="sprite" input="variantId">
						<Item>"s_card_particle_front"</Item>
						<Item>"s_card_particle_back"</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="initialAngle">0</Set>
					<Random name="targetPosOffset" min="-12,-11" max="12,11"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angleOutVar="projectile_angle"/>
					<Set name="rotateWithVelocity">true</Set>
					<SetVar name="projectile_offset" source="targetPosOffset"/>
					<SetVar name="variantIdVar" source="variantId"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileCard">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.25</Set>
				</Emitter>
				<Particle>
					<Set name="variantId" source="variantIdVar"/>
					<Select name="sprite" input="variantId">
						<Item>"s_card_particle_front_burn"</Item>
						<Item>"s_card_particle_back_burn"</Item>
					</Select>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="offset" source="projectile_offset"/>
					<Set name="initialAngle" source="projectile_angle"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hitEmbers">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.3</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_ember</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="offset" source="projectile_offset"/>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hitEmbers_destroy">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_ember</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="offset" source="projectile_offset"/>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="projectile_offset">0, 0</Set>
			<Set name="projectile_angle">0</Set>
			<Set name="variantIdVar" ForceFloats="false">0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderPants>
			<SpriteRender name="s_Pants" alignment="DOWN_CENTER" />
			<SpriteRender name="s_Pants_deck" alignment="DOWN_CENTER" />
		</RenderPants>
		<AddClothingParticles>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
			</StopIf>
		</AddClothingParticles>
		<OnDamagedTile>
			<StopIf type="or">
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
			<ParticleSystemUpdate name="ps_tileCard" />
			<ParticleSystemUpdate name="ps_hitEmbers" />
		</OnDamagedTile>
		<OnDestroyedTile>
			<StopIf type="or">
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
			<ParticleSystemUpdate name="ps_hitEmbers_destroy" />
		</OnDestroyedTile>
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Action.Punch">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Action.Punch">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			
			<ParticleSystemUpdate name="ps_punchProjectile"/>
		</OnPunchUpdate>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="Arc1"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_shirt" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="23,11"/>
		<Sprite name="s_orbit" fileName="game/particles12.rttex" textureSize="32" frame="10,23"/>
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="12,23" />
		<Sprite name="s_aura" fileName="game/particles_large18.rttex" textureSize="64" frame="12,14" />
		<Sprite name="s_Hit" fileName="game/particles_large18.rttex" textureSize="64" frame="15,12" />
		<Sprite name="s_Sparkle" fileName="game/particles12.rttex" textureSize="32" frame="14,23" />
		<Animations>
			<SpriteAnimation name="a_shirt" sprite="s_shirt" autoPlay="true" animTime="1200" isLoop="true">
				<Frame>23,11</Frame>
				<Frame>24,11</Frame>
				<Frame>25,11</Frame>
				<Frame>26,11</Frame>
				<Frame>27,11</Frame>
				<Frame>28,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_orbit" sprite="s_orbit">
				<Frame>10,23</Frame>
				<Frame>11,23</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_aura" sprite="s_aura">
				<Frame>12,14</Frame>
				<Frame>13,14</Frame>
				<Frame>14,14</Frame>
				<Frame>15,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Sparkle" sprite="s_Sparkle">
				<Frame>14,23</Frame>
				<Frame>15,23</Frame>
				<Frame>16,23</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_orb1">
				<Emitter>
					<Set name="offset">5, -35</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart" source="posOrb"/>
					<Set name="orbitPeriod">2.4</Set>
					<Set name="orbitScaleVariation">0.2</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="orbit">-30,10</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Random name="initialScale" min="0.7" max="0.9"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_orb2">
				<Emitter>
					<Set name="offset">5, -20</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart" source="posOrb"/>
					<Set name="orbitPeriod">2.2</Set>
					<Set name="orbitScaleVariation">0.1</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="orbit">30,10</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
					<Random name="initialScale" min="0.7" max="0.9"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_orb3">
				<Emitter>
					<Set name="offset">5, -15</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart" source="posOrb"/>
					<Set name="orbitPeriod">2</Set>
					<Set name="orbitSkew">0.5</Set>
					<Set name="orbitScaleVariation">0.1</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="orbit">20,-18</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialScale" min="0.7" max="0.9"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">14,-20</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">false</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Aura" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">0,8</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">false</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" usePlayerFacing="true">
					<Set name="sprite">s_aura</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Hit</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="initialAngle" min="-360" max="360"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4,0.4</KeyFrame>
						<KeyFrame>1, 1.3,1.3</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_HitSparkle" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Sparkle</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,120"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="posOrb">0</Set>
			<Set name="incOrb">0</Set>
			<Set name="DeltaTime">0.0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="ShouldHover">true></Set>
				<Set name="DisableWalkAnimation">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderShirt>
			<SpriteRender name="s_shirt" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" />
		</RenderShirt>
		<RenderInFront>
			<ParticleSystemRender name="ps_orb1" />
			<ParticleSystemRender name="ps_orb2" />
			<ParticleSystemRender name="ps_orb3" />
		</RenderInFront>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_orb1" />
			<ParticleSystemUpdate name="ps_orb2" />
			<ParticleSystemUpdate name="ps_orb3" />
		</AddClothingParticles>
		<Update>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="incOrb" RightHandVariableName="0.4" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="incOrb" RightHandVariableName="DeltaTime" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="posOrb" RightHandVariableName="incOrb" OperationType="Add"/>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">JUMP_UP</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-40</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">40</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_Hit" />
			<ParticleSystemUpdate name="ps_HitSparkle" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Wing" fileName="game/particles_large16.rttex" textureSize="64" frame="0,2" />
		<Sprite name="s_spark" fileName="game/particles12.rttex" textureSize="32"/>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="JumpStraight" />
					<State name="FallStraight" />
				</States>
				<Transitions>
					<Transition to="Idle" from="FallStraight|Move">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|FallStraight">
						<Condition type="and">
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="JumpStraight" from="Idle|FallStraight|Move">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="FallStraight" from="JumpStraight|Idle|Move">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="s_spark_frames" sprite="s_spark">
				<Frame>0,11</Frame>
				<Frame>1,11</Frame>
				<Frame>2,11</Frame>				
				<Frame>3,11</Frame>
				<Frame>4,11</Frame>
				<Frame>5,11</Frame>
				<Frame>6,11</Frame>
				<Frame>7,11</Frame>
				<Frame>8,11</Frame>
				<Frame>9,11</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Wing_idle" sprite="s_Wing" animTime="50" isLoop="true" playOnState="Action.Idle" >
				<Frame>0,2</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Wing_walk" sprite="s_Wing" animTime="200" isLoop="true" playOnState="Action.Move" >
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>1,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Wing_jump" sprite="s_Wing" animTime="100" isLoop="true" playOnState="Action.JumpStraight">
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Wing_fall" sprite="s_Wing" animTime="100" isLoop="true" playOnState="Action.FallStraight">
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
			</SpriteAnimation>
		</Animations>

		<RenderOptions>
			<Default>
				<Set name="HideParticlesOnTransform">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="trail_spark_left" updateStage="AddClothingParticles" updateState="Action.Idle">
				<Emitter>
					<Random name="offset" min="-32, -20" max="-11.5, -10" />
					<Set name="offsetFacing">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.4</Set>
				</Emitter>
				<Particle  usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />

					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_right" updateStage="AddClothingParticles" updateState="Action.Idle">
				<Emitter>
					<Random name="offset" min="11.5, -20" max="32, -10" />
					<Set name="offsetFacing">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.4</Set>
				</Emitter>
				<Particle usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_left_jump" updateStage="AddClothingParticles" updateState="Action.JumpStraight">
				<Emitter>
					<Random name="offset" min="-32, -20" max="-11.5, -10" />
					<Set name="offsetFacing">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_right_jump" updateStage="AddClothingParticles" updateState="Action.JumpStraight">
				<Emitter>
					<Random name="offset" min="11.5, -20" max="32, -10" />
					<Set name="offsetFacing">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_left_walk">
				<Emitter>
					<Random name="offset" min="-32, -28" max="-11.5, 0" />
					<Set name="offsetFacing">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_spark_right_walk">
				<Emitter>
					<Random name="offset" min="11.5, -28" max="32, 0" />
					<Set name="offsetFacing">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<AddClothingParticles>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ParticleSystemUpdate name="trail_spark_left_walk" onState="Action.Move|Action.FallStraight" />
			<ParticleSystemUpdate name="trail_spark_right_walk" onState="Action.Move|Action.FallStraight" />
		</AddClothingParticles>
		<RenderFrontpack>
			<ParticleSystemRender name="trail_spark_left_walk"/>
			<ParticleSystemRender name="trail_spark_right_walk"/>
		</RenderFrontpack>
		<RenderBackpack>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_Wing" offset="0,-16" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackpack>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wings" fileName="game/particles_large17.rttex" textureSize="64" frame="4,7" />
    <Sprite name="s_flare" fileName="game/particles_large17.rttex" textureSize="64" frame="8,7" />
    <Sprite name="s_bokeh" fileName="game/particles_large17.rttex" textureSize="64" frame="9,6" />

    <Animations>
      <SpriteAnimation name="a_wings" sprite="s_wings">
        <Frame>4,7</Frame>
        <Frame>5,7</Frame>
        <Frame>6,7</Frame>
        <Frame>7,7</Frame>
      </SpriteAnimation>

      <SequenceAnimation name="flash_sequence" playOnState="SelfieTake.Max">

        <InterpolationFloatAnimation name="saturationValueTo" variableName="saturationValue" targetVariableName="saturationValueMax" animTime="0"/>

        <InterpolationFloatAnimation name="contrastValueTo" variableName="contrastValue" targetVariableName="contrastValueMax" animTime="0"/>

        <InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" targetVariableName="brightnessValueWhite" animTime="0"/>

        <DelayAnimation delayTime="200" />

        <InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" targetVariableName="brightnessValueBlack" animTime="0"/>

        <DelayAnimation delayTime="100" />

        <InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" targetVariableName="brightnessValueWhite" animTime="0"/>

      </SequenceAnimation>

      <InterpolationFloatAnimation name="saturationValueFrom" variableName="saturationValue" playOnState="SelfieTake.Default" targetVariableName="saturationValueDefault" animTime="600"/>

      <InterpolationFloatAnimation name="contrastValueFrom" variableName="contrastValue" playOnState="SelfieTake.Default" targetVariableName="contrastValueDefault" animTime="600"/>

      <InterpolationFloatAnimation name="brightnessValueFrom" variableName="brightnessValue" playOnState="SelfieTake.Default" targetVariableName="brightnessValueDefault" animTime="600"/>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_wingsLeft" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0,-16</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_wings</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="renderAlignment">RIGHT_CENTER</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.3, 0.3</KeyFrame>
            <KeyFrame>1, 1.2, 1.2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_wingsRight" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0,-16</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_wings</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="flipX">true</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.3, 0.3</KeyFrame>
            <KeyFrame>1, 1.2, 1.2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_flare">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flare</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-10,-10" max="10,10" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 2.6,2.6</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_bokeh" renderStage="RenderInFront">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_bokeh</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-10,-10" max="10,10" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 1.5,1.5</KeyFrame>
          </Curve>
          <Random name="lifeTime" min="0.5" max="2" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <VariableMap>
      <Set name="saturationValue">1</Set>
      <Set name="saturationValueMax">0</Set>
      <Set name="brightnessValue">1</Set>
      <Set name="brightnessValueWhite">100</Set>
      <Set name="brightnessValueBlack">0</Set>
      <Set name="contrastValue">0</Set>
      <Set name="contrastValueMax">0</Set>

      <Set name="saturationValueDefault">1</Set>
      <Set name="contrastValueDefault">0</Set>
      <Set name="brightnessValueDefault">1</Set>

      <Set name="flashTimer">0</Set>
    </VariableMap>
    <StateMachines>
      <StateMachine name="SelfieTake">
        <States>
          <State name="Default" />
          <State name="Max" ExitTime="0.6" />
        </States>
        <Transitions>
          <Transition to="Default" from="Max"/>
          <Transition to="Max" from="Default">
            <Condition  type="and">
              <IsAction>JUMPDOUBLE</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
  </Data>
  <RenderRules>
    <AddClothingParticles>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_flare" onAction="JUMPDOUBLE"/>
      <ParticleSystemUpdate name="ps_bokeh" onAction="JUMPDOUBLE"/>
    </AddClothingParticles>
    <OnDrawCustomOutline>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <AvatarTransform class="RenderData">
        <Set name="saturation">getCurrent</Set>
        <Set name="brightness">getCurrent</Set>
        <Set name="contrast">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="RenderData">
        <Set name="saturation">1.5</Set>
        <Set name="brightness">0.8</Set>
        <Set name="contrast">0.15</Set>
      </AvatarTransform>
      <AvatarOutline duration="1500" startScale="1.1,1.1" endScale="1.1,1.1">
        <Colours>
          <Colour>62,40,255,255</Colour>
        </Colours>
      </AvatarOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">reset</Set>
        <Set name="brightness">reset</Set>
        <Set name="contrast">reset</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">reset</Set>
      </AvatarTransform>
    </OnDrawCustomOutline>
    <RenderBackpack>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="ps_wingsLeft"/>
      <ParticleSystemRender name="ps_wingsRight"/>
      <ParticleSystemRender name="ps_flare"/>
      <AvatarTransform class="RenderData">
        <Set name="saturation">saturationValue</Set>
        <Set name="brightness">brightnessValue</Set>
        <Set name="contrast">contrastValue</Set>
      </AvatarTransform>
      <StopIf>
        <IsVariableBool name="isMannequin">false</IsVariableBool>
      </StopIf>
      <SpriteRender name="s_wings" offset="0,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="ADDITIVE"/>
      <SpriteRender name="s_wings" offset="0,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="ADDITIVE"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_tentacle" fileName="game/particles12.rttex" textureSize="32" frame="26,17" />
    <Sprite name="s_mist" fileName="game/particles_large17.rttex" textureSize="64" frame="6,13" />
    <Sprite name="s_tileHit" fileName="game/particles4.rttex" textureSize="32" frame="4,2" />
    <Sprite name="s_eyes" fileName="game/particles_large17.rttex" textureSize="64" frame="15,11" />
    <Sprite name="s_cthulu" fileName="game/particles_large17.rttex" textureSize="64" frame="0,13" />
    <Sprite name="s_chest" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="20,7" />
    <Sprite name="s_pet" fileName="game/pets/p_espawn_r.rttex" textureSize="32" frame="0,0" />

    <Animations>
      <SpriteAnimation name="a_Attack" sprite="s_tentacle" animTime="500" isLoop="true" playOnState="PunchAnim.Continue">
        <Frame>26,17</Frame>
        <Frame>27,17</Frame>
        <Frame>28,17</Frame>
        <Frame>29,17</Frame>
        <Frame>30,17</Frame>
        <Frame>31,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_cthuluAttack" sprite="s_cthulu" animTime="600" isLoop="true" playOnState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End">
        <Frame>0,13</Frame>
        <Frame>1,13</Frame>
        <Frame>2,13</Frame>
        <Frame>3,13</Frame>
        <Frame>4,13</Frame>
        <Frame>5,13</Frame>
      </SpriteAnimation>

      <SpriteCurveAnimation name="a_cthuluStart" isLoop="false" playOnState="PunchAnim.Start" sprite="s_cthulu" animTime="200">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_eyesStart" isLoop="false" playOnState="PunchAnim.Start" sprite="s_eyes" animTime="200">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_cthuluEnd" isLoop="false" playOnState="PunchAnim.End" sprite="s_cthulu" animTime="200">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_eyesEnd" isLoop="false" playOnState="PunchAnim.End" sprite="s_eyes" animTime="200">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_cthuluContinue" isLoop="true" playOnState="PunchAnim.Continue" sprite="s_cthulu" animTime="500">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteCurveAnimation name="a_eyesContinue" isLoop="true" playOnState="PunchAnim.Continue" sprite="s_eyes" animTime="500">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteAnimation name="a_PetIdle" sprite="s_pet" animTime="300" isLoop="true" playOnState="Action.None">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetPunch" sprite="s_pet" animTime="300" isLoop="true" playOnState="Action.Punch">
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="punch_start_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tentacle</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="lifeTime">0.2</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 0</KeyFrame>
            <KeyFrame>1, 1, 3</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_continue_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="delayTimer">0.23</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tentacle</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="initialScale">1,3</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_end_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tentacle</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="lifeTime">0.2</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 3</KeyFrame>
            <KeyFrame>1, 1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_mistBack">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="rgbTint">0, 0, 0, 1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.25</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Set name="initialVelocity">0, 0</Set>
          <Random name="offset" min="20,0" max="-20,0" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_mistFront">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-96</Set>
          <Set name="emissionInterval">0.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.25</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Set name="initialVelocity">0, 0</Set>
          <Random name="offset" min="-16,0" max="16,0" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tileHit">
        <Emitter attachment="targetPos">
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tileHit</Set>
          <Random name="offset" min="-16,-16" max="16,16" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5,0.75" max="0.5,1" />
          <Set name="lifeTime">0.2</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_cthuluMist">
        <Emitter>
          <Set name="offset">-28, -36</Set>
          <Set name="emissionInterval">0.5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">3</Set>
          <Set name="initialVelocity">0, 0</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="PunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start" ExitTime="0.2"/>
          <State name="Continue"/>
          <State name="End" ExitTime="0.2"/>
        </States>
        <Transitions>
          <Transition from="Off|End" to="Start">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Continue|Start" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-36,0</Set>
        <Set name="UsePetForceFaceTime">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnorePunchTypeCheck">false</Set>
        <Set name="UserNameOffset">16</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <Update>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="punch_continue_particle" />
      <ParticleSystemUpdate name="ps_mistBack" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
      <ParticleSystemUpdate name="ps_mistFront" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
    </Update>
    <AddClothingParticles>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_cthuluMist" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
      <ParticleSystemUpdate name="ps_tileHit" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
    </AddClothingParticles>
    <OnPunchBegin>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemOff name="punch_continue_particle" />
      <ParticleSystemOff name="punch_end_particle" />
      <ParticleSystemUpdate name="punch_start_particle" />
    </OnPunchBegin>
    <OnPunchStop>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemOff name="punch_continue_particle" />
      <ParticleSystemOff name="punch_start_particle" />
      <ParticleSystemUpdate name="punch_end_particle" />
    </OnPunchStop>
    <RenderInFront>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="ps_mistBack"/>
      <ParticleSystemRender name="punch_start_particle" onState="PunchAnim.Start" />
      <ParticleSystemRender name="punch_continue_particle" onState="PunchAnim.Continue" />
      <ParticleSystemRender name="punch_end_particle" onState="PunchAnim.End" />
      <ParticleSystemRender name="ps_mistFront"/>
    </RenderInFront>
    <RenderBehind>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <SpriteRender name="s_cthulu" offset="-16,-16" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
      <ParticleSystemRender name="ps_cthuluMist"/>
      <SpriteRender name="s_eyes" offset="-16,-16" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
    </RenderBehind>
    <RenderChestItem>
      <SpriteRender name="s_chest" offset="0,0" alignment="DOWN_CENTER" />
    </RenderChestItem>
    <RenderPet>
      <SpriteRender name="s_pet" offset="0,0" alignment="DOWN_CENTER" />
    </RenderPet>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_eye" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="19,5"/>
    <Sprite name="s_mist" fileName="game/particles_large16.rttex" textureSize="64" frame="15,4" />
    <Sprite name="s_projectile" fileName="game/particles12.rttex" textureSize="32" frame="26,13" />

    <Animations>
      <SpriteAnimation name="a_eye" autoPlay="true" sprite="s_eye" isLoop="true" animTime="400">
        <Frame>19,5</Frame>
        <Frame>20,5</Frame>
        <Frame>21,5</Frame>
        <Frame>22,5</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_mist" updateStage="AddClothingParticles" renderStage="RenderBehind">
        <Emitter>
          <Set name="offset">0, -18</Set>
          <Set name="emissionInterval">0.5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">3</Set>
          <Set name="initialVelocity">0, 0</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchProjectile" updateStage="OnPunchUpdate">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.5</Set>
          <Set name="emissionInterval">0.03</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="targetPos" source="context.pos"/>
          <Random name="offset" min="-3,-3" max="3,3" />
          <Random name="targetPosOffset" min="-4,-30" max="4,-2" />
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.8</KeyFrame>
            <KeyFrame>0.8, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="initialScale" min="0.5" max="1" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <VariableMap>
      <Set name="context.pos">0, 0</Set>
    </VariableMap>

  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderFaceItem>
      <SpriteRender name="s_eye" offset="0.5,-16" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderFaceItem>
    <RenderBehind>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
    </RenderBehind>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_swordBack" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="0,13" />
    <Sprite name="s_swordFront" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="1,13" />
    <Sprite name="s_separateSlash" fileName="game/particles12.rttex" textureSize="32" frame="27,19"/>
    <Sprite name="s_combinedSlash" fileName="game/particles12.rttex" textureSize="32" frame="26,19"/>
    <Sprite name="s_flash" fileName="game/particles_large17.rttex" textureSize="64" frame="14,7" />
    <Sprite name="s_hitSparks" fileName="game/particles12.rttex" textureSize="32" frame="29,19"/>
    <Sprite name="s_hitFlash" fileName="game/particles_large17.rttex" textureSize="64" frame="15,7"/>
    <Animations>
      <SpriteAnimation name="a_swordBackNormalSeparate" sprite="s_swordBack" playOnState="PunchType.NoneSeparate|PunchType.Separate|PunchType.TransitionFromSeparate">
        <Frame>0,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_swordBackNormalCombined" sprite="s_swordBack" playOnState="PunchType.NoneCombined|PunchType.Combined|PunchType.TransitionFromCombine">
        <Frame>2,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_separateSlash" autoPlay="false" sprite="s_separateSlash">
        <Frame>27,19</Frame>
        <Frame>28,19</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="s_hitSparks">
        <Frame>29,19</Frame>
        <Frame>30,19</Frame>
        <Frame>31,19</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="UserNameOffset">15</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="OnEquipTag">COMBINED_BLADE</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
      </Default>
    </RenderOptions>
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="False" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="PunchType">
        <States>
          <State name="NoneSeparate"/>
          <State name="NoneCombined"/>
          <State name="Separate"/>
          <State name="Combined"/>
          <State name="TransitionFromSeparate"/>
          <State name="TransitionFromCombined"/>
        </States>
        <Transitions>
          <Transition to="NoneSeparate" from="NoneCombined|Separate|Combined|TransitionFromSeparate|TransitionFromCombined">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <ItemHasTag operatorType="NotEqual">COMBINED_BLADE</ItemHasTag>
            </Condition>
          </Transition>
          <Transition to="NoneCombined" from="NoneSeparate|Separate|Combined|TransitionFromSeparate|TransitionFromCombined">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <ItemHasTag>COMBINED_BLADE</ItemHasTag>
            </Condition>
          </Transition>
          <Transition to="Separate" from="NoneSeparate|NoneCombined">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Greater" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
              <CheckRandomRangeNumber EndNumber="2">0</CheckRandomRangeNumber>
            </Condition>
          </Transition>
          <Transition to="Combined" from="NoneSeparate|NoneCombined">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Greater" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
              <CheckRandomRangeNumber EndNumber="2">1</CheckRandomRangeNumber>
            </Condition>
          </Transition>
          <Transition to="TransitionFromCombined" from="Combined">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Less" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="TransitionFromSeparate" from="Separate">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Less" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Combined" from="TransitionFromSeparate">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Greater" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Separate" from="TransitionFromCombined">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <CompareCustomVariable operatorType="Greater" VariableNameToCompare="punchDuration">0.0</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_hitSparks" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">10</Set>
          <Set name="delayTimer">0.0</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_hitSparks</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initalRGB">1,1,1</Set>
          <Set name="initialScale">1,1</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">true</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlash" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Random name="initialAngle" min="-360" max="360"/>
          <Set name="sprite">s_hitFlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.4,0.4</KeyFrame>
            <KeyFrame>1, 1.3,1.3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_flash">
        <Emitter>
          <Set name="offset">6, -14</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_flash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.25, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1.75, 1.75</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_separateSlash">
        <Emitter>
          <Set name="offset">9,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle alternateSpriteFrameWithPunch="true">
          <Set name="sprite">s_separateSlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <Set name="initialAlpha">1</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_combinedSlash">
        <Emitter>
          <Set name="offset">24,-14</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_combinedSlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <Set name="initialAlpha">1</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <VariableMap>
      <Set name="punchDuration" MinValue="2" MaxValue="4">0</Set>
      <Set name="DeltaTime">0.0</Set>
    </VariableMap>
  </Data>
  <RenderRules>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="Punch.False">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>
    <AddClothingParticles>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <ParticleSystemUpdate name="ps_flash" onState="PunchType.Separate|PunchType.Combined"/>
    </AddClothingParticles>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>

      <Group onState="PunchType.NoneSeparate|PunchType.NoneCombined|PunchType.Separate|PunchType.TransitionFromSeparate">
        <SpriteRender name="s_swordBack" offset="18, 2" rotationPoint="0,1" flip="0,0" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
      </Group>

      <Group onState="PunchType.Combined|PunchType.TransitionFromCombine">
        <Rotate forceValue="true">0,0,0,1</Rotate>
        <Translate>-6,2,0</Translate>
        <SpriteRender name="s_swordBack" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" rotateOffset="true" useFixedRotation="true" fixedRotation="0" blend="PREMULTIPLIED_ALPHA" />
      </Group>

    </RenderBackHandItem>
    <RenderHandItem>
      <Group onState="PunchType.NoneSeparate|PunchType.Separate|PunchType.TransitionFromSeparate">
        <SpriteRender name="s_swordFront" offset="25, 8" rotationPoint="0,1" flip="0,0" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
      </Group>
    </RenderHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>

      <ArithmethicOperation LeftHandVariableName="punchDuration" RightHandVariableName="punchDuration" OperationType="Randomize" onState="PunchType.NoneSeparate|PunchType.NoneCombined|PunchType.TransitionFromCombined|PunchType.TransitionFromSeparate"/>

      <ArithmethicOperation LeftHandVariableName="punchDuration" RightHandVariableName="DeltaTime" OperationType="Substract"/>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <Group onState="PunchType.Separate">
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="animTime">1000</Set>
          <Set name="Curve">
            <KeyFrame>0.0, 0</KeyFrame>
            <KeyFrame>0.3, 0</KeyFrame>
            <KeyFrame>0.60, 360</KeyFrame>
            <KeyFrame>0.99, 720</KeyFrame>
          </Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm1Angle</Set>
          <Set name="animTime">1000</Set>
          <Set name="Curve">
            <KeyFrame>0.0, 60</KeyFrame>
            <KeyFrame>0.3, 360</KeyFrame>
            <KeyFrame>0.60, 360</KeyFrame>
            <KeyFrame>0.99, 720</KeyFrame>
          </Set>
        </AvatarTransform>
      </Group>
      <Group onState="PunchType.Combined">
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm1Angle</Set>
          <Set name="armAngle">1200</Set>
          <Set name="isAdditive">true</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="armAngle">0</Set>
        </AvatarTransform>
      </Group>
    </OnPunchUpdate>
    <OnPunchStart>
      <ParticleSystemUpdate name="ps_separateSlash" onState="PunchType.Separate"/>
      <ParticleSystemUpdate name="ps_combinedSlash" onState="PunchType.Combined"/>
    </OnPunchStart>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_ROYAL_GROWTRONIC_GLIDER">
	<Data>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="Punch"/>
					<State name="Sleep"/>
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Sleep">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsSleepingOnaBed>false</IsSleepingOnaBed>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Sleep">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Sleep" from="None|Punch">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Mobility">
				<States>
					<State name="Stationary"/>
					<State name="Moving"/>
				</States>
				<Transitions>
					<Transition to="Stationary" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Stationary">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Sprite name="s_glider_left" fileName="game/player_feet16.rttex" textureSize="32" frame="5,18"/>
		<Sprite name="s_glider_right" fileName="game/player_feet16.rttex" textureSize="32" frame="5,19"/>
		<Sprite name="s_trail" fileName="game/particles11.rttex" textureSize="32" frame="31,13"/>
		<Sprite name="s_missile" fileName="game/particles11.rttex" textureSize="32" frame="30,13"/>
		<Sprite name="s_muzzle" fileName="game/particles_large13.rttex" textureSize="64" frame="0,3"/>
		<Sprite name="s_hit" fileName="game/particles_large13.rttex" textureSize="64" frame="1,2"/>
		
		<Animations>
			<SpriteAnimation name="a_glider_left" playOnState="Action.None" sprite="s_glider_left" isLoop="true" animTime="300">
				<Frame>5,20</Frame>
				<Frame>6,20</Frame>
				<Frame>7,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glider_right" playOnState="Action.None" sprite="s_glider_right" isLoop="true" animTime="300">
				<Frame>5,21</Frame>
				<Frame>6,21</Frame>
				<Frame>7,21</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glider_left_punch" playOnState="Action.Punch" sprite="s_glider_left" isLoop="true" animTime="300">
				<Frame>8,20</Frame>
				<Frame>9,20</Frame>
				<Frame>10,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glider_right_punch" playOnState="Action.Punch" sprite="s_glider_right" isLoop="true" animTime="300">
				<Frame>8,21</Frame>
				<Frame>9,21</Frame>
				<Frame>10,21</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hit" sprite="s_hit" animTime="800">
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>
				<Frame>8,3</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="ps_hit">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_missile">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_missile</Set>
					<Select name="offset" input="punchCount">
						<Item>-12, 0</Item>
						<Item>24, 0</Item>
					</Select>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_muzzle">
				<Emitter>
					<Set name="offset">6, -16</Set>
					<Set name="lifeTime">0</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzle</Set>
					<Select name="offset" input="punchCount">
						<Item>-15, 0</Item>
						<Item>15, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.2</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_trail">
				<Emitter>
					<Set name="offset">-30, 4</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true">
					<Set name="sprite">s_trail</Set>
					<Random name="offset" min="0, -4" max="0, 4"/>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1.25, 1.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialVelocity" min="-30, 0" max="-40, 0"/>
					<Random name="initialAngle" min="-45" max="45"/>
					<Set name="initialRotationRate">90</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-18</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="UserNameOffset">22</Set>
				<Set name="ShouldHover">true</Set>
				<Set name="NeedRenderBareFeetWithShoesItem">true</Set>
				<Set name="AllowChangePunchType">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
			  <Set name="armName">arm2Angle</Set>
			  <Set name="armAngle">45</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
			  <Set name="armName">arm1Angle</Set>
			  <Set name="armAngle">-45</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<SpriteRender name="s_glider_left" offset="0,14" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT"/>
			<SpriteRender name="s_glider_right" offset="0,14" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT"/>
		</RenderShoes>
		<OnPunchStart>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>
			<ParticleSystemUpdate name="ps_muzzle"/>
			<ParticleSystemUpdate name="ps_missile"/>
		</OnPunchStart>
		<OnDamagedTile>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>
			<ParticleSystemUpdate name="ps_hit"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>
			<ParticleSystemUpdate name="ps_hit"/>
		</OnDestroyedTile>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_trail" onState="Mobility.Moving"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="ps_missile"/>
			<ParticleSystemOff name="ps_muzzle"/>
			<ParticleSystemOff name="ps_hit"/>
			<ParticleSystemOff name="ps_trail"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_ROYAL_HORNED_CROWN">
  <Data>
    <Sprite name="hatForegroundSprite" fileName="game/particles_large10.rttex" textureSize="64" frame="10,8"/>
    <Sprite name="hatBackgroundSprite" fileName="game/particles_large10.rttex" textureSize="64" frame="11,8"/>
    <Sprite name="lineSprite" fileName="game/particles10.rttex" textureSize="32" frame="31,27"/>
    <Sprite name="sparkSprite" fileName="game/particles10.rttex" textureSize="32" frame="31,28"/>

    <ParticleSystems>
      <ParticleSystem name="LineAura" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">lineSprite</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.1, 0.5</Set>
          <Random name="finalScale" min="5, 0.5" max="3, 0.5"/>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="LineMoveAura" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">3</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">lineSprite</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5, 0.5" max="1.5, 0.5"/>
          <Set name="lifeTime">0.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,60"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="SparksAura" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">3</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">sparkSprite</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">0.5, 0.5</Set>
          <Set name="lifeTime">0.75</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="35,35"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>

  <RenderRules>
    <RenderBackHat>
      <SpriteRender name="hatBackgroundSprite" alignment="DOWN_CENTER"/>
    </RenderBackHat>
    <RenderHat>
      <SpriteRender name="hatForegroundSprite" alignment="DOWN_CENTER"/>
    </RenderHat>
  </RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="s_Shirt" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="17,5" />
		<Sprite name="s_ShirtGlow" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="16,5" />
		<Sprite name="s_ShirtPunch" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="18,5" />
        <Sprite name="s_Transform" fileName="game/tf_page4.rttex" textureSize="64,64" frame="0,11" />
        <Sprite name="s_Projectile" fileName="game/particles12.rttex" textureSize="32,32" frame="18,13" />
		<Sprite name="s_ProjectileHit" fileName="game/particles12.rttex" textureSize="32,32" frame="20,13" />
		<Sprite name="s_flash" fileName="game/tf_page4.rttex" textureSize="64" frame="15,11" />
		<Sprite name="s_shard" fileName="game/particles7.rttex" textureSize="32" frame="10,15" />
        <Animations>
			<SpriteAnimation name="a_Projectile" sprite="s_Projectile" animTime="400">
                <Frame>19,13</Frame>
                <Frame>18,13</Frame>
            </SpriteAnimation>
			<SpriteCurveAnimation name="a_ShirtGlow" sprite="s_ShirtGlow" isLoop="true" autoPlay="true" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_shards" sprite="s_shard" animTime="200">
				<Frame>10,15</Frame>
				<Frame>11,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_LandIdle" sprite="s_Transform" isLoop="true" animTime="1600" playOnState="Main.LandIdle">
				<Frame>0,11</Frame>
				<Frame>1,11</Frame>
				<Frame>2,11</Frame>
				<Frame>3,11</Frame>
				<Frame>4,11</Frame>
				<Frame>5,11</Frame>
				<Frame>6,11</Frame>
				<Frame>7,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_LandMove" sprite="s_Transform" isLoop="true" animTime="600" playOnState="Main.LandMove">
				<Frame>8,11</Frame>
				<Frame>9,11</Frame>
				<Frame>10,11</Frame>
				<Frame>11,11</Frame>
				<Frame>12,11</Frame>
				<Frame>13,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_LandPunch" sprite="s_Transform" isLoop="true" animTime="100" playOnState="Main.LandPunch">
				<Frame>14,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_ToAir" sprite="s_Transform" isLoop="false" animTime="600" playOnState="Main.TransformToAir">
				<Frame>10,12</Frame>
				<Frame>9,12</Frame>
				<Frame>8,12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_Air" sprite="s_Transform" animTime="400" isLoop="true" playOnState="Main.Air|Main.AirUp">
				<Frame>0,12</Frame>
				<Frame>1,12</Frame>
				<Frame>2,12</Frame>
				<Frame>3,12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_ToGround" sprite="s_Transform" isLoop="false" animTime="600" playOnState="Main.TransformToLand">
				<Frame>8,12</Frame>
				<Frame>9,12</Frame>
				<Frame>11,12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_AirPunch" sprite="s_Transform" isLoop="true" animTime="400" playOnState="Main.AirPunch">
				<Frame>4,12</Frame>
				<Frame>5,12</Frame>
				<Frame>6,12</Frame>
				<Frame>7,12</Frame>
			</SpriteAnimation>
		</Animations>
        <ParticleSystems>
            <ParticleSystem name="ps_Projectile1">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="lifeTime">0</Set>
					<Set name="offset" source="projectileOffset"/>
                    <Set name="emissionInterval">0</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="interpolateVelocity">true</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Select name="initialAngle" input="punchCount">
                        <Item>45</Item>
                        <Item>0</Item>
                        <Item>-45</Item>
                    </Select>
                    <Select name="finalAngle" input="punchCount">
                        <Item>-45</Item>
                        <Item>0</Item>
                        <Item>45</Item>
                    </Select>
                    <Select name="finalAlpha" input="punchCount">
                        <Item>1.4f</Item>
                        <Item>1.f</Item>
                        <Item>1.4f</Item>
                    </Select>
                    <Set name="lifeTime">0.5</Set>
                    <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="finalAlpha" angle="initialAngle" />
                    <VectorTo name="finalVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="finalAlpha" angle="finalAngle" />
                    <Set name="offset">8,0</Set>
                    <Set name="sprite">s_Projectile</Set>
					<Random name="targetPosOffset" min="-8, -8" max="8, 8"/>
					<OnFinish>
						<ParticleSystemName>ps_ProjectileHit</ParticleSystemName>
					</OnFinish>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="ps_Projectile2">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="lifeTime">0</Set>
					<Set name="offset" source="projectileOffset"/>
                    <Set name="emissionInterval">0</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="interpolateVelocity">true</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Select name="initialAngle" input="punchCount">
                        <Item>0</Item>
                        <Item>-45</Item>
                        <Item>45</Item>
                    </Select>
                    <Select name="finalAngle" input="punchCount">
                        <Item>0</Item>
                        <Item>45</Item>
                        <Item>-45</Item>
                    </Select>
                    <Select name="finalAlpha" input="punchCount">
                        <Item>1</Item>
                        <Item>1.4f</Item>
                        <Item>1.4f</Item>
                    </Select>
                    <Set name="lifeTime">0.4</Set>
                    <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="finalAlpha" angle="initialAngle" />
                    <VectorTo name="finalVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="finalAlpha" angle="finalAngle" />
                    <Set name="offset">-8,0</Set>
                    <Set name="sprite">s_Projectile</Set>
					<Random name="targetPosOffset" min="-8, -8" max="8, 8"/>
					<OnFinish>
						<ParticleSystemName>ps_ProjectileHit</ParticleSystemName>
					</OnFinish>
                </Particle>
            </ParticleSystem>
			<ParticleSystem name="ps_ProjectileHit">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_ProjectileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Select name="initialRotationRate" input="randomNumber">
						<Item>-720</Item>
						<Item>720</Item>
					</Select>
				</Particle>
			</ParticleSystem>
            <ParticleSystem name="ps_flash" updateStage="AddClothingParticles" updateState="IsTransformed.Changing">
				<Emitter>
					<Set name="offset">0, -24</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true" usePlayerFacing="true">
					<Set name="sprite">s_flash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1.25, 1.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_flashShards" updateStage="AddClothingParticles" updateState="IsTransformed.Changing">
				<Emitter>
					<Set name="offset">0, -32</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">16</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" usePlayerFacing="true" usePlayerFacing="true">
					<Set name="sprite">s_shard</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.8, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="120,170" />
				</Particle>
			</ParticleSystem>
        </ParticleSystems>
        <VariableMap>
			<Set name="projectileOffset">0, -16</Set>
			<Set name="DeltaTime">0</Set>
			<Set name="AirTimer">0</Set>
		</VariableMap>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="IsTransformed">
				<States>
					<State name="No" />
					<State name="Yes" />
					<State name="Changing" />
				</States>
				<Transitions>
					<Transition to="Yes" from="Changing">
						<Condition>
							<IsItemTransformed>true</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="No" from="Changing">
						<Condition>
							<IsItemTransformed>false</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="Changing" from="Yes">
						<Condition>
							<IsItemTransformed>false</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="Changing" from="No">
						<Condition>
							<IsItemTransformed>true</IsItemTransformed>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Main">
				<States>
					<State name="LandIdle" />
					<State name="LandMove" />
					<State name="TransformToAir" ExitTime="0.6" />
					<State name="Air"/>
					<State name="AirUp"/>
					<State name="TransformToLand" ExitTime="0.6" />
					<State name="LandPunch" />
					<State name="AirPunch" />
				</States>
				<Transitions>
					<Transition to="LandMove" from="LandIdle|LandPunch|TransformToLand">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="LandIdle" from="LandMove|LandPunch|TransformToLand">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="LandPunch" from="LandIdle|LandMove|AirPunch|TransformToLand">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<CompareCustomVariable operatorType="Less" VariableNameToCompare="AirTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="TransformToAir" from="LandIdle|LandMove">
						<Condition>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Air" from="TransformToAir|AirPunch|AirUp">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<CompareCustomVariable operatorType="Greater" VariableNameToCompare="AirTimer">0</CompareCustomVariable>
							<IsVariableFloat name="speed.y" operator="Greater">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="AirUp" from="Air">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="TransformToLand" from="Air|AirUp">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<CompareCustomVariable operatorType="Less" VariableNameToCompare="AirTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="AirPunch" from="Air|AirUp|LandPunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<CompareCustomVariable operatorType="Greater" VariableNameToCompare="AirTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions />
	</Data>
	<RenderRules>
		<Update>
			<Group onState="IsTransformed.Yes">
				<StopIf type="or">
					<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				</StopIf>
				<ArithmethicOperation LeftHandVariableName="AirTimer" RightHandVariableName="5" OperationType="Set" onState="Main.TransformToAir|Main.AirUp" />
				<ArithmethicOperation LeftHandVariableName="AirTimer" RightHandVariableName="DeltaTime" OperationType="Substract" onState="Main.Air" />
			</Group>
		</Update>
		<OnPunchStart>
			<Group onState="IsTransformed.Yes">
				<ArithmethicOperation LeftHandVariableName="projectileOffset" RightHandVariableName="8,-26" OperationType="Set" onState="Main.LandPunch" />
				<ArithmethicOperation LeftHandVariableName="projectileOffset" RightHandVariableName="8,-24" OperationType="Set" onState="Main.AirPunch" />
			</Group>
			<Group onState="IsTransformed.No">
				<ArithmethicOperation LeftHandVariableName="projectileOffset" RightHandVariableName="8,-18" OperationType="Set" />
			</Group>
			<ParticleSystemUpdate name="ps_Projectile2" />
			<ParticleSystemUpdate name="ps_Projectile1" />
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">60</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-60</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderTransform>
			<Translate>0,-8,0</Translate>
			<SpriteRender name="s_Transform" blend="NORMAL" alignment="CENTER" drawShadow="true" />
		</RenderTransform>
		<RenderShirt>
			<Group onState="Punch.No">
				<SpriteRender name="s_Shirt" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
				<SpriteRender name="s_ShirtGlow" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
			</Group>
			<Group onState="Punch.Yes">
				<SpriteRender name="s_ShirtPunch" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
			</Group>
		</RenderShirt>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_ROYAL_MUSCLE_MINIGUN">
    <Data>
      <Sprite name="s_FrontArm" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="9,20"/>
      <Sprite name="s_Minigun" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="4,21"/>
      <Sprite name="s_MuzzleFlash" fileName="game/particles10.rttex" textureSize="32" frame="31,10"/>
      <Sprite name="s_Projectile" fileName="game/particles11.rttex" textureSize="32" frame="17,25"/>
      <Sprite name="s_ProjectileHit" fileName="game/particles11.rttex" textureSize="32" frame="18,25"/>
      <Sprite name="s_ProjectileHitSparks" fileName="game/particles11.rttex" textureSize="32" frame="22,25"/>

      <StateMachines>
        <StateMachine name="Punch">
          <States>
            <State name="True"/>
            <State name="False"/>
          </States>
          <Transitions>
            <Transition from="False" to="True">
              <Condition type="and">
                <IsAction>PUNCH</IsAction>
                <IsZombified>false</IsZombified>
              </Condition>
            </Transition>
            <Transition from="True" to="False">
              <Condition>
                <IsAction operatorType="NotEqual">PUNCH</IsAction>
              </Condition>
            </Transition>
          </Transitions>
        </StateMachine>
      </StateMachines>

      <Animations>
        <SpriteAnimation name="a_PunchGun" sprite="s_Minigun" animTime="250" isLoop="true" playOnState="Punch.True">
          <Frame>4,21</Frame>
          <Frame>5,21</Frame>
          <Frame>6,21</Frame>
          <Frame>7,21</Frame>
          <Frame>8,21</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_NonPunchGun" sprite="s_Minigun" animTime="100" isLoop="true" playOnState="Punch.False">
          <Frame>4,21</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_ProjectileBlast" sprite="s_ProjectileHit" animTime="400">
          <Frame>21,25</Frame>
          <Frame>18,25</Frame>
          <Frame>19,25</Frame>
          <Frame>20,25</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_ProjectilehitSparks" sprite="s_ProjectileHitSparks">
          <Frame>22,25</Frame>
          <Frame>23,25</Frame>
        </SpriteAnimation>
      </Animations>

      <RenderOptions>
        <Default>
          <Set name="PunchSoundOverride">HAND</Set>
          <Set name="PlayDefaultPunchAudio">false</Set>
          <Set name="DefaultRenderMannequinHandItem">false</Set>
          <Set name="RenderFrontArmInfected">true</Set>
        </Default>
      </RenderOptions>

      <ParticleSystems>
        <ParticleSystem name="MuzzleFlash" updateStage="RenderHandItem" updateState="Punch.True">
          <Emitter attachment="handspotRoot">
            <Set name="offset">18, 12</Set>
            <Set name="lifeTime">0.15</Set>
            <Set name="infParticles">true</Set>
            <Set name="checkParticleNumToEmit">true</Set>
            <Set name="particlesPerEmission">1</Set>
            <Set name="particlesToEmit">1</Set>
          </Emitter>
          <Particle usePlayerFacing="true">
            <Set name="sprite">s_MuzzleFlash</Set>
            <Set name="relativeToEmitter">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Curve name="initialAlpha">
              <KeyFrame>0, 1</KeyFrame>
              <KeyFrame>1, 0</KeyFrame>
            </Curve>
            <Set name="lifeTime">0.15</Set>
          </Particle>
        </ParticleSystem>
        <ParticleSystem name="Punch" updateStage="RenderHandItem" updateState="Punch.True" secondary="BulletHit">
          <Emitter attachment="handspotRoot">
            <Random name="offset" min="10, 8" max="18, 16"/>
            <Set name="lifeTime">0.15</Set>
            <Set name="infParticles">true</Set>
            <Set name="checkParticleNumToEmit">true</Set>
            <Set name="particlesPerEmission">1</Set>
            <Set name="particlesToEmit">1</Set>
          </Emitter>
          <Particle>
            <Set name="sprite">s_Projectile</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="rotateWithVelocity">true</Set>
            <Set name="lifeTime">0.2</Set>
            <Random name="targetPosOffset" min="-15, -16" max="15, 16"/>
            <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
          </Particle>
        </ParticleSystem>
        <ParticleSystem name="BulletHit" secondary="BulletHitSparks">
          <Emitter>
            <Set name="offset">0, 0</Set>
            <Set name="infParticles">true</Set>
            <Set name="checkParticleNumToEmit">true</Set>
            <Set name="particlesPerEmission">1</Set>
            <Set name="particlesToEmit">1</Set>
            <Set name="delayTimer">0.2</Set>
          </Emitter>
          <Particle>
            <Set name="sprite">s_ProjectileHit</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="lifeTime">0.4</Set>
            <Random name="initialAngle" min="0" max="360"/>
            <Set name="initialScale">0.5,0.5</Set>
          </Particle>
        </ParticleSystem>
        <ParticleSystem name="BulletHitSparks">
          <Emitter>
            <Set name="offset">0, 0</Set>
            <Set name="infParticles">true</Set>
            <Set name="checkParticleNumToEmit">true</Set>
            <Set name="particlesPerEmission">4</Set>
            <Set name="particlesToEmit">1</Set>
            <Set name="delayTimer">0.01</Set>
          </Emitter>
          <Particle randomSpriteFrame="true">
            <Set name="sprite">s_ProjectileHitSparks</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="lifeTime">0.5</Set>
            <Set name="useGravity">true</Set>
            <Set name="gravityVector">0, 100</Set>
            <RandomRadial name="initialVelocity" angleRange="-225,45" radiusRange="50,50" />
            <Curve name="initialAlpha">
              <KeyFrame>0, 1</KeyFrame>
              <KeyFrame>0.9, 1</KeyFrame>
              <KeyFrame>1, 0</KeyFrame>
            </Curve>
            <Set name="initialScale">0.5,0.5</Set>
          </Particle>
        </ParticleSystem>
      </ParticleSystems>
    </Data>

    <RenderRules>
      <RenderHandItem>
        <SpriteRender name="s_FrontArm" offset="0,-1" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>
        <SpriteRender name="s_Minigun" offset="0,0" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      </RenderHandItem>
      <OnPunchUpdate>
        <StopIf>
          <IsZombified>true</IsZombified>
        </StopIf>
        <AvatarTransform class="Emotion">
          <Set name="emotion">ANGRY</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="angleOffset">90</Set>
          <Set name="pointTowardsPunchTarget">true</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm1Angle</Set>
          <Set name="armAngle">0</Set>
        </AvatarTransform>
      </OnPunchUpdate>

      <RenderFrontArm>
        <ContextUpdate type="PositionSinPulse" onState="Punch.True">
          <Set name="period">100</Set>
          <Set name="scale">-0.5</Set>
          <Set name="clamp">true</Set>
        </ContextUpdate>
      </RenderFrontArm>
    </RenderRules>
  </ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Punch" fileName="game/particles11.rttex" textureSize="32" frame="10,26" />
		<Sprite name="s_Turntable" fileName="game/particles_large13.rttex" textureSize="64" frame="10,15" />
		<Animations>
			<SpriteCurveAnimation name="a_TurntablePos1" isLoop="true" autoPlay="true" sprite="s_Turntable" animTime="8000">
				<Curve name="pos">
					<KeyFrame>0, 0, 0</KeyFrame>
					<KeyFrame>0.2856, 0, 1</KeyFrame>
					<KeyFrame>0.7854, 0, -2</KeyFrame>
					<KeyFrame>1, 0, 0</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_Turntable" sprite="s_Turntable" isLoop="true" playOnState="Motion.Idle">
				<Frame>10,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_TurntablePulse" sprite="s_Turntable" animTime="400" isLoop="true" playOnState="Motion.Dance|Motion.Punch">
				<Frame>10,15</Frame>
				<Frame>11,15</Frame>
				<Frame>12,15</Frame>
				<Frame>13,15</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Punch" />
					<State name="Dance" />
					<State name="Sleep" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Punch|Dance|Sleep">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsDancing>false</IsDancing>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Dance|Sleep">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Idle|Punch|Sleep">
						<Condition>
							<IsDancing>true</IsDancing>
						</Condition>
					</Transition>
					<Transition to="Sleep" from="Idle|Punch|Dance">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_Dance">
				<Emitter>
					<Set name="offset">4, -6</Set>
					<Set name="emissionInterval">0.15</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,100" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">4, -6</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<MusicSource onState="Motion.Dance|Motion.Punch">
				<Set name="ItemID">ITEM_ID_ROYAL_MUSICAL_MAESTRO</Set>
				<Set name="FadeOutTimeMs">500</Set>
			</MusicSource>
			<AvatarTransform class="ActionUpdate" onState="Motion.Sleep|Motion.Idle|Motion.Punch">
				<Set name="action">CLEAR</Set>
			</AvatarTransform>
			<StopIf>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Dance|Motion.Punch">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-80</Set>
				<Set name="pulseArmScale">10</Set>
				<Set name="pulseArmRate">500</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Dance|Motion.Punch">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">180</Set>
				<Set name="pulseArmScale">10</Set>
				<Set name="pulseArmRate">500</Set>
			</AvatarTransform>
		</Update>
		<SwitchOffClothingParticles>
			<AvatarTransform class="ActionUpdate">
				<Set name="action">CLEAR</Set>
			</AvatarTransform>
		</SwitchOffClothingParticles>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_Dance" onState="Motion.Dance"/>
		</AddClothingParticles>
		<RenderInFront value="playerCenter">
			<StopIf>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<SpriteRender name="s_Turntable" offset="0,0" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
		</RenderInFront>
		<OnPunchUpdate>
			<StopIf>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Emotion">
				<Set name="emotion">ECSTATIC</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_equip" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="0,28"/>
    <Sprite name="s_flower" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="5,28"/>
    <Sprite name="s_punchBranch" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="1,28"/>
    <Sprite name="HitSpark_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="30,18"/>

    <Animations>
      <SpriteAnimation name="HitSpark_Anim" autoPlay="false" isLoop="false" sprite="HitSpark_Sprite"  animTime="200">
        <Frame>30, 18</Frame>
        <Frame>30, 19</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flowerIdle" sprite="s_flower" animTime="100" isLoop="true" playOnState="FlowerPunchAnim.Off">
        <Frame>5,28</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flowerPunchStart" sprite="s_flower" animTime="400" playOnState="FlowerPunchAnim.Start">
        <Frame>6,28</Frame>
        <Frame>7,28</Frame>
        <Frame>8,28</Frame>
        <Frame>9,28</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flowerPunchContinue" sprite="s_flower" animTime="100" isLoop="true" playOnState="FlowerPunchAnim.Continue">
        <Frame>9,28</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flowerPunchEnd" sprite="s_flower" animTime="400" playOnState="FlowerPunchAnim.End">
        <Frame>9,28</Frame>
        <Frame>8,28</Frame>
        <Frame>7,28</Frame>
        <Frame>6,28</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_branchPunchStart" sprite="s_punchBranch" animTime="400" playOnState="BranchPunchAnim.Start">
        <Frame>1,28</Frame>
        <Frame>2,28</Frame>
        <Frame>3,28</Frame>
        <Frame>4,28</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_branchPunchContinue" sprite="s_punchBranch" animTime="100" isLoop="true" playOnState="BranchPunchAnim.Continue">
        <Frame>4,28</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_branchPunchEnd" sprite="s_punchBranch" animTime="400" playOnState="BranchPunchAnim.End">
        <Frame>4,28</Frame>
        <Frame>3,28</Frame>
        <Frame>2,28</Frame>
        <Frame>1,28</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="FlowerPunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start"/>
          <State name="Continue"/>
          <State name="End"/>
        </States>
        <Transitions>
          <Transition from="Off|End" to="Start">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsAnimationFinished>a_flowerPunchStart</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="Continue|Start" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAnimationFinished>a_flowerPunchEnd</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="BranchPunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start"/>
          <State name="Continue"/>
          <State name="End"/>
        </States>
        <Transitions>
          <Transition from="Off|End" to="Start">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsAnimationFinished>a_branchPunchStart</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="Continue|Start" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAnimationFinished>a_branchPunchEnd</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <TileStampData>
      <Set name="FileName">game/particles12.rttex</Set>
      <Set name="EndFrame">13,2</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>

    <ParticleSystems>
      <ParticleSystem name="hitSpark_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="rgbTint">0.22, 0.62, 0.32, 1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">HitSpark_Sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="useGravity">true</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.5,0.5</Set>
          <Random name="finalScale" min="0.1" max="0.4"/>
          <Set name="lifeTime">0.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="80,100"/>
          <Set name="gravityVector">0, 100</Set>
          <Random name="initialRotationRate" min="-300" max="300"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>

    <RenderChestItem>
      <SpriteRender name="s_equip" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
      <SpriteRender name="s_flower" blend="PREMULTIPLIED_ALPHA" offset =" 0,-3" alignment="DOWN_CENTER" />
      <SpriteRender name="s_punchBranch" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" onState="BranchPunchAnim.Start|BranchPunchAnim.Continue|BranchPunchAnim.End"/>
      <ParticleSystemUpdate name="hitSpark_particle" onAction="PUNCH"/>
    </RenderChestItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_animal" fileName="game/particles_large14.rttex" textureSize="64" frame="0,2" />
		<Sprite name="s_animal_punch" fileName="game/particles_large14.rttex" textureSize="64" frame="0,2" />
		<Sprite name="s_back_cloud" fileName="game/particles_large14.rttex" textureSize="64" frame="0,8" />
		<Sprite name="s_front_cloud" fileName="game/particles_large14.rttex" textureSize="64" frame="0,1" />
		<Sprite name="s_front_cloud_punch" fileName="game/particles_large14.rttex" textureSize="64" frame="0,0" />
		<Sprite name="s_god_rays" fileName="game/particles_large14.rttex" textureSize="64" frame="0,10" />
		<Sprite name="s_necklace" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="1,16" />
		<StateMachines>
			<StateMachine name="Action1">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteCurveAnimation name="a_back_cloud_spin" isLoop="true" autoPlay="true" sprite="s_back_cloud" animTime="10000">
				<Curve name="rotation">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 360</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteSinPulseAnimation name="a_animal_Stretch" sprite="s_animal" autoPlay="true" isLoop="true">
				<Parameter name="scale.x">
					<Set name="offset">1</Set>
					<Set name="period">3000</Set>
					<Set name="scale">0.1</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_animal_Stretchy" sprite="s_animal" autoPlay="true" isLoop="true">
				<Parameter name="scale.y">
					<Set name="offset">1</Set>
					<Set name="period">4500</Set>
					<Set name="scale">0.1</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteAnimation name="a_animal" sprite="s_animal" animTime="1000" autoPlay="true" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>
				<Frame>8,3</Frame>
				<Frame>9,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_back_cloud" sprite="s_back_cloud" animTime="1000" autoPlay="true" isLoop="true">
				<Frame>0,8</Frame>
				<Frame>1,8</Frame>
				<Frame>2,8</Frame>
				<Frame>3,8</Frame>
				<Frame>4,8</Frame>
				<Frame>5,8</Frame>
				<Frame>6,8</Frame>
				<Frame>7,8</Frame>
				<Frame>8,8</Frame>
				<Frame>9,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_front_cloud" sprite="s_front_cloud" animTime="1000" autoPlay="true" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
				<Frame>8,1</Frame>
				<Frame>9,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_front_cloud_punch" sprite="s_front_cloud_punch" animTime="1000" autoPlay="true" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>8,0</Frame>
				<Frame>9,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_god_rays" sprite="s_god_rays" animTime="200" autoPlay="true" isLoop="true">
				<Frame>0,10</Frame>
				<Frame>1,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_animal_punch" sprite="s_animal_punch" animTime="500" isLoop="true" playOnState="Action1.Punch">
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="UserNameOffset">30</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_front_cloud" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="emissionInterval">3</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_front_cloud</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0.6</KeyFrame>
						<KeyFrame>0.9, 0.6</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0.8, 0.8</KeyFrame>
					</Curve>
					<Set name="lifeTime">10</Set>
					<Curve name="initialRotationRate">
						<KeyFrame>0, 6</KeyFrame>
						<KeyFrame>1, 12</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_front_cloud_punch" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="emissionInterval">3</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_front_cloud_punch</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0.6</KeyFrame>
						<KeyFrame>0.9, 0.6</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>0.9, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0.8, 0.8</KeyFrame>
					</Curve>
					<Set name="lifeTime">10</Set>
					<Curve name="initialRotationRate">
						<KeyFrame>0, 6</KeyFrame>
						<KeyFrame>1, 12</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_god_rays" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_god_rays</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.75</Set>
					<Random name="initialAngle" min="-75" max="75" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="s_back_cloud" scale="0.6,0.6" offset="0,-52" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
			<SpriteRender name="s_animal" scale="0.35,0.35" offset="-3,-50" drawShadow="false" blend="ADDITIVE" onState="Action1.None" />
			<SpriteRender name="s_animal_punch" scale="0.35,0.35" offset="-3,-50" drawShadow="false" blend="ADDITIVE" onState="Action1.Punch" />
			<StopIf>
				<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_front_cloud" onState="Action1.None" />
			<ParticleSystemRender name="ps_front_cloud_punch" onState="Action1.Punch" />
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_god_rays" />
			<StopIf>
				<IsVariableBool name="isMannequin">false</IsVariableBool>
			</StopIf>
			<SpriteRender name="s_front_cloud" scale="0.6,0.6" offset="0,-52" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
		</RenderBehind>
		<RenderChestItem>
			<SpriteRender name="s_necklace" offset="0,0" alignment="DOWN_CENTER" />
		</RenderChestItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_strap" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="12,9"/>
		<Sprite name="s_robot" fileName="game/particles_large18.rttex" textureSize="64" frame="0,10"/>
		<Sprite name="s_robotPunch" fileName="game/particles_large18.rttex" textureSize="64" frame="8,11"/>
		<Sprite name="s_line" fileName="game/particles12.rttex" textureSize="32" frame="23,21"/>
		<Sprite name="s_jumpSmoke" fileName="game/mi_minbot.rttex" textureSize="64" frame="3,0"/>
		<Sprite name="s_jumpFlame" fileName="game/particles12.rttex" textureSize="32" frame="21,21"/>

		<Animations>
			<SpriteAnimation name="a_robot_idle" sprite="s_robot" isLoop="true" animTime="2600" playOnState="Movement.Idle">
				<Frame>0,10</Frame>
				<Frame>1,10</Frame>
				<Frame>2,10</Frame>
				<Frame>3,10</Frame>
				<Frame>4,10</Frame>
				<Frame>5,10</Frame>
				<Frame>6,10</Frame>
				<Frame>7,10</Frame>
				<Frame>8,10</Frame>
				<Frame>9,10</Frame>
				<Frame>10,10</Frame>
				<Frame>11,10</Frame>
				<Frame>12,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robot_move" sprite="s_robot" isLoop="true" animTime="400" playOnState="Movement.Move">
				<Frame>0,11</Frame>
				<Frame>1,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robot_jump" sprite="s_robot" isLoop="true" animTime="400" playOnState="Movement.Jump">
				<Frame>2,11</Frame>
				<Frame>3,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robot_fall" sprite="s_robot" isLoop="true" animTime="400" playOnState="Movement.Fall">
				<Frame>4,11</Frame>
				<Frame>5,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robot_slowFall" sprite="s_robot" isLoop="true" animTime="400" playOnState="Movement.SlowFall">
				<Frame>6,11</Frame>
				<Frame>7,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robotPunch" sprite="s_robotPunch" isLoop="true" animTime="400" playOnState="Punch.Yes">
				<Frame>8,11</Frame>
				<Frame>9,11</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Movement">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="SlowFall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|SlowFall">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|SlowFall">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|SlowFall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|SlowFall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsHoldingJumpKey>false</IsHoldingJumpKey>
						</Condition>
					</Transition>
					<Transition to="SlowFall" from="Jump|Idle|Move|Fall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsHoldingJumpKey>true</IsHoldingJumpKey>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<ParticleSystems>
			<ParticleSystem name="ps_jumpSmokeL">
				<Emitter>
					<Set name="particlesPerEmission">3</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offset">-18,16</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpSmoke</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.75</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.2,0.1</Set>
					<Increment name="initialScale" source="particleIndex" multiplier="0.1,0.1"/>
					<Set name="finalScale">0.3,0.2</Set>
					<Increment name="finalScale" source="particleIndex" multiplier="0.1,0.1"/>
					<Set name="offset">0,-30</Set>
					<Increment name="worldPos" source="particleIndex" multiplier="0,8"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_jumpSmokeR">
				<Emitter>
					<Set name="particlesPerEmission">3</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offset">0,16</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpSmoke</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.75</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.2,0.1</Set>
					<Increment name="initialScale" source="particleIndex" multiplier="0.1,0.1"/>
					<Set name="finalScale">0.3,0.2</Set>
					<Increment name="finalScale" source="particleIndex" multiplier="0.1,0.1"/>
					<Set name="offset">0,-30</Set>
					<Increment name="worldPos" source="particleIndex" multiplier="0,8"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_jumpFlameR">
				<Emitter>
					<Set name="offset">0, -5.5</Set>
					<Random name="emissionInterval" min="0.1" max="0.2" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpFlame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.9</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">false</Set>
					<Set name="lifeTime">0.75</Set>
					<Random name="initialScale" min="0.8,0.9" max="0.9,1.1" />
					<Set name="relativeToEmitter">true</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Set name="offset" source="FacingOffset"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_jumpFlameL">
				<Emitter>
					<Set name="offset">-16.5, -5.5</Set>
					<Random name="emissionInterval" min="0.1" max="0.2" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpFlame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.9</KeyFrame>
						<KeyFrame>0.5, 0.75</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">false</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialScale" min="0.8,0.9" max="0.9,1.1" />
					<Set name="relativeToEmitter">true</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Set name="offset" source="FacingOffset"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fallFlameR">
				<Emitter>
					<Set name="offset">0, -5.5</Set>
					<Random name="emissionInterval" min="0.05" max="0.15" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpFlame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">false</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialScale" min="0.5,0.7" max="1,1" />
					<Set name="relativeToEmitter">true</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Set name="offset" source="FacingOffset"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fallFlameL">
				<Emitter>
					<Set name="offset">-16.5, -5.5</Set>
					<Random name="emissionInterval" min="0.05" max="0.15" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpFlame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">false</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialScale" min="0.5,0.7" max="1,1" />
					<Set name="relativeToEmitter">true</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Set name="offset" source="FacingOffset"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<TileStampData>
			<Set name="FileName">game/particles12.rttex</Set>
			<Set name="EndFrame">27,21</Set>
			<Set name="FrameCount">4</Set>
			<Set name="Offset">0,-22</Set>
			<Set name="RenderDefaultCracks">true</Set>
		</TileStampData>

		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="IgnorePunchTypeDamagedTileCheck">true</Set>
				<Set name="IgnoreDamagedTileForPunchPos">true</Set>
			</Default>
		</RenderOptions>

		<VariableMap>
			<Set name="FacingOffset">0,0</Set>
		</VariableMap>
	</Data>

	<RenderRules>
		<RenderFrontpack>
			<SpriteRender name="s_strap" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER"/>
		</RenderFrontpack>
		<RenderBackpack>
			<Translate>1,-32,0</Translate>
			<SpriteRender name="s_robot" blend="PREMULTIPLIED_ALPHA" onState="Punch.No"/>
			<SpriteRender name="s_robotPunch" blend="PREMULTIPLIED_ALPHA" onState="Punch.Yes"/>
			<Group onState="Punch.Yes">
				<Translate>-12,-5,0</Translate>
				<SpriteRender name="s_line" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0"/>
			</Group>
		</RenderBackpack>
		<AddClothingParticles>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="FacingOffset" RightHandVariableName="-2,0" OperationType="Set" onState="Facing.Left" />
			<ArithmethicOperation LeftHandVariableName="FacingOffset" RightHandVariableName="0,0" OperationType="Set" onState="Facing.Right" />
			<ParticleSystemUpdate name="ps_jumpSmokeL" onAction="JUMPSTART|JUMPDOUBLE"/>
			<ParticleSystemUpdate name="ps_jumpSmokeR" onAction="JUMPSTART|JUMPDOUBLE"/>
			<ParticleSystemUpdate name="ps_jumpFlameL" onAction="JUMPSTART|JUMPDOUBLE"/>
			<ParticleSystemUpdate name="ps_jumpFlameR" onAction="JUMPSTART|JUMPDOUBLE"/>
			<ParticleSystemUpdate name="ps_fallFlameL" onState="Movement.SlowFall"/>
			<ParticleSystemUpdate name="ps_fallFlameR" onState="Movement.SlowFall"/>
		</AddClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_guitarIdle" fileName="game/particles12.rttex" textureSize="32" frame="18,2"/>
    <Sprite name="s_guitarPunch" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="5,7"/>
    <Sprite name="s_guitarPunchGlow" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="6,7"/>
    <Sprite name="s_strap" fileName="game/particles12.rttex" textureSize="32" frame="19,1"/>
    <Sprite name="s_shards" fileName="game/particles12.rttex" textureSize="32" frame="13,4"/>
    <Sprite name="s_mist" fileName="game/particles12.rttex" textureSize="32" frame="15,3"/>
    <Sprite name="s_mistFinish" fileName="game/particles12.rttex" textureSize="32" frame="15,3"/>
    <Sprite name="s_ember" fileName="game/particles12.rttex" textureSize="32" frame="11,4"/>
    <Sprite name="s_note" fileName="game/particles11.rttex" textureSize="32" frame="9,28"/>

    <Animations>
      <SpriteCurveAnimation name="a_guitarPunchGlow" sprite="s_guitarPunchGlow" animTime="1000" playOnState="Action.Punch|Action.Dance">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="a_strapIdle" sprite="s_strap" animTime="100" isLoop="true" playOnState="Action.None">
        <Frame>19,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_strapPunch" sprite="s_strap" animTime="100" isLoop="true" playOnState="Action.Punch">
        <Frame>20,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_strapDance" sprite="s_strap" animTime="100" isLoop="true" playOnState="Action.Dance">
        <Frame>21,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_mist" sprite="s_mist">
        <Frame>15,3</Frame>
        <Frame>16,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ember" sprite="s_ember">
        <Frame>11,4</Frame>
        <Frame>12,4</Frame>
      </SpriteAnimation>
      <CurveAnimationFloat name="a_footExtend" isLoop="true" animTime="500" playOnState="Action.Dance">
        <Curve name="footOffset">
          <KeyFrame>0, -2</KeyFrame>
          <KeyFrame>0.5, 1</KeyFrame>
          <KeyFrame>1, -2</KeyFrame>
        </Curve>
      </CurveAnimationFloat>
      <SpriteAnimation name="a_note" sprite="s_note">
        <Frame>11,28</Frame>
        <Frame>12,28</Frame>
      </SpriteAnimation>
    </Animations>

    <VariableMap>
      <Set name="item.Rotation">340</Set>
      <Set name="footOffset">0</Set>
      <Set name="rotation">340</Set>
      <Set name="facingVariable">1,1,1</Set>
    </VariableMap>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None"/>
          <State name="Punch"/>
          <State name="Dance"/>
        </States>
        <Transitions>
          <Transition to="None" from="Punch|Dance">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">DANCE</IsAction>
              <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None|Dance">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
              <IsAction operatorType="NotEqual">DANCE</IsAction>
              <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
            </Condition>
          </Transition>
          <Transition to="Dance" from="None|Punch">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsZombified>false</IsZombified>
              <SubCondition type="or">
                <IsAction>DANCE</IsAction>
                <IsAction>DANCE_FLOSS</IsAction>
              </SubCondition>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_note" updateStage="AddClothingParticles" updateState="Action.Dance">
        <Emitter>
          <Set name="offset">0, -8</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_note</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">2.5</Set>
          <Random name="offset" min="-16, 0" max="16, 0" />
          <Random name="initialVelocity" min="0, -60" max="0, -30" />
          <Random name="initialRotationRate" min="-60" max="60" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_PunchFire" renderStage="RenderHandItem" updateStage="AddClothingParticles" updateState="Action.Punch">
        <Emitter>
          <Set name="offset">15, -6</Set>
          <Random name="emissionInterval" min="0.001" max="0.005" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_shards</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.8, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 0.3</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Random name="targetPosOffset" min="-12,-8" max="12,8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.7"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchEmber" renderStage="RenderHandItem" updateStage="AddClothingParticles" updateState="Action.Punch">
        <Emitter>
          <Set name="offset">0, -6</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_ember</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="lifeTime">1</Set>
          <Random name="initialVelocity" min="-20,-20" max="20,-30"/>
          <Random name="offset" min="-5,-5" max="0,0"/>
          <Set name="gravityVector">0, 60</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_onHitEmber" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="particlesPerEmission">5</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_ember</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,25"/>
          <Set name="gravityVector">0, 60</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_onDestroyEmber" updateStage="OnDestroyedTile">
        <Emitter>
          <Set name="particlesPerEmission">10</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_ember</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,25"/>
          <Set name="gravityVector">0, 60</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <TileStampData>
      <Set name="FileName">game/particles12.rttex</Set>
      <Set name="EndFrame">19,4</Set>
      <Set name="FrameCount">4</Set>
      <Set name="RenderDefaultCracks">false</Set>
    </TileStampData>

    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="IsFacingChangeDisabled">false</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
      </Default>
      <Override overrideOnAction="DANCE">
        <Set name="IsFacingChangeDisabled">true</Set>
      </Override>
      <Override overrideOnAction="DANCE_FLOSS">
        <Set name="IsFacingChangeDisabled">true</Set>
      </Override>
    </RenderOptions>
  </Data>

  <RenderRules>
    <Update>
      <ArithmethicOperation LeftHandVariableName="rotation" RightHandVariableName="item.Rotation" OperationType="Set" />
      <ArithmethicOperation LeftHandVariableName="rotation" RightHandVariableName="facingVariable.x" OperationType="Multiply" />
      <Group onState="Action.Dance">
        <AvatarTransform class="FootPosition">
          <Set name="foot1y">footOffset</Set>
          <Set name="foot2y">footOffset</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm1Angle</Set>
          <Set name="armAngle">-90</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="pulseArmScale">20</Set>
          <Set name="pulseArmRate">100</Set>
          <Set name="armAngle">-40</Set>
        </AvatarTransform>
        <AvatarTransform class="Face">
          <Set name="face">MAD</Set>
        </AvatarTransform>
        <MusicSource>
          <Set name="MusicFile">audio/mp3/death_metal_radio.mp3</Set>
        </MusicSource>
      </Group>

    </Update>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1500</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderHandItem>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <Group onState="Action.Dance">
        <Rotate forceValue="true">rotation</Rotate>
        <SpriteRender name="s_guitarPunchGlow" offset="6,8" blend="ADDITIVE" drawShadow="false"/>
        <SpriteRender name="s_guitarPunch" offset="6,8" blend="PREMULTIPLIED_ALPHA"/>
      </Group>
      <Group onState="Action.Punch">
        <SpriteRender name="s_guitarPunchGlow" offset="4,8" blend="ADDITIVE" useFixedRotation="true" fixedRotation="0" drawShadow="false"/>
        <SpriteRender name="s_guitarPunch" offset="4,8" blend="PREMULTIPLIED_ALPHA" useFixedRotation="true" fixedRotation="0"/>
      </Group>
    </RenderHandItem>
    <RenderFrontArm>
      <SpriteRender name="s_strap" offset="1,0" alignment="DOWN_CENTER" useFixedRotation="true" fixedRotation="0"/>
    </RenderFrontArm>
    <RenderBehind value="playerCenter">
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_guitarIdle" offset="0, -16" onState="Action.None" useFixedRotation="true" fixedRotation="0"/>
      <Group>
      <StopIf>
        <IsZombified>false</IsZombified>
      </StopIf>
      <SpriteRender name="s_guitarIdle" offset="0, -16" onState="Action.None" useFixedRotation="true" fixedRotation="0" tintOverride="111,217,45,255"/>
      </Group>
      <Group>
        <StopIf>
          <IsSitting ItemID="ITEM_ID_THEATER_SEAT">false</IsSitting>
        </StopIf>
        <SpriteRender name="s_guitarIdle" offset="0, -16" onState="Action.None" useFixedRotation="true" fixedRotation="0" tintOverride="0,0,0,255"/>
      </Group>
    </RenderBehind>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <StateMachines>
      <StateMachine name="Motion">
        <States start="OnGroundIdle">
          <State name="OnGroundIdle"/>
          <State name="OnGroundMove"/>
          <State name="OnAir"/>
          <State name="OnWater"/>
        </States>
        <Transitions>
                    <Transition from="OnGroundMove|OnAir|OnWater" to="OnGroundIdle" >
            <Condition type="and">
	            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
	            <IsVariableBool name="onGround">true</IsVariableBool>
	            <IsVariableBool name="underWater">false</IsVariableBool>
            </Condition>
          </Transition>              
		    <Transition from="OnGroundIdle|OnAir|OnWater" to="OnGroundMove" >
            <Condition type="and">
	            <IsVariableFloat name="speed.length" operator="GreaterOrEqual" abs="true">0.1</IsVariableFloat>
	            <IsVariableBool name="onGround">true</IsVariableBool>
	            <IsVariableBool name="underWater">false</IsVariableBool>
            </Condition>
          </Transition>          
		   <Transition from="OnGroundIdle|OnWater|OnGroundMove" to="OnAir" >
            <Condition type="and">
	            <IsVariableBool name="onGround">false</IsVariableBool>
	            <IsVariableBool name="underWater">false</IsVariableBool>
            </Condition>
          </Transition>		    
			<Transition from="OnGroundIdle|OnGroundMove|OnAir" to="OnWater" >
            <Condition type="or">
	            <IsVariableBool name="underWater">true</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
	   <StateMachine name="MovementDir">
		    <States start="None">
			    <State name="None"/>
			    <State name="Horizontal"/>
		    </States>
		    <Transitions>
			    <Transition from="Horizontal" to="None" >
				    <Condition type="or">
					    <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">true</IsVariableBool>
					    <IsVariableBool name="underWater">true</IsVariableBool>
				    </Condition>
			    </Transition>                  
			    <Transition from="None" to="Horizontal" >
				    <Condition type="and">
					    <IsVariableFloat name="speed.x" operator="GreaterOrEqual" abs="true">0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">false</IsVariableBool>
					    <IsVariableBool name="underWater">false</IsVariableBool>
				    </Condition>
			    </Transition>		    
		    </Transitions>
	    </StateMachine>
    </StateMachines>

    <Sprite name="s_cartFront" fileName="game/particles_large15.rttex" textureSize="64" frame="0,2"/>
    <Sprite name="s_cartBack" fileName="game/particles_large15.rttex" textureSize="64" frame="0,3"/>
    <Sprite name="trailOnAir" fileName="game/particles12.rttex" textureSize="32" frame="8,0"/>
    <Sprite name="trailinWater" fileName="game/particles12.rttex" textureSize="32" frame="9,0"/>
    
    <Animations>
      <SpriteAnimation name="a_cartFrontIdle" playOnState="Motion.OnGroundIdle" sprite="s_cartFront" isLoop="true" animTime="100">
        <Frame>0,2</Frame>
      </SpriteAnimation>      
		<SpriteAnimation name="a_cartNackIdle" playOnState="Motion.OnGroundIdle" sprite="s_cartBack" isLoop="true" animTime="100">
        <Frame>0,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_cartFrontMove" playOnState="Motion.OnGroundMove" sprite="s_cartFront" isLoop="true" animTime="100">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
      </SpriteAnimation>      
	<SpriteAnimation name="a_cartBackMove" playOnState="Motion.OnGroundMove" sprite="s_cartBack" isLoop="true" animTime="100">
        <Frame>0,3</Frame>
        <Frame>1,3</Frame>
      </SpriteAnimation>
		
	    <SpriteAnimation name="a_cartFrontSwim" playOnState="Motion.OnWater" sprite="s_cartFront" isLoop="true" animTime="100">
		    <Frame>4,2</Frame>
	    </SpriteAnimation>      
	    <SpriteAnimation name="a_cartBackSwim" playOnState="Motion.OnWater" sprite="s_cartBack" isLoop="true" animTime="100">
		    <Frame>4,3</Frame>
		    <Frame>5,3</Frame>
	    </SpriteAnimation>	    
		
		<SpriteAnimation name="a_cartFrontAir" playOnState="Motion.OnAir" sprite="s_cartFront" isLoop="true" animTime="100">
		    <Frame>2,2</Frame>
		    <Frame>3,2</Frame>
	    </SpriteAnimation>      
	    <SpriteAnimation name="a_cartBackAir" playOnState="Motion.OnAir" sprite="s_cartBack" isLoop="true" animTime="100">
		    <Frame>2,3</Frame>
		    <Frame>3,3</Frame>
	    </SpriteAnimation>	    
	
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_trailFlash" updateStage="AddClothingParticles" renderStage="RenderShoes" updateState="MovementDir.Horizontal">
        <Emitter>
	        <Set name="offset">-23, 2</Set>
	        <Set name="emissionInterval">0.02</Set>
	        <Set name="infParticles">true</Set>
	        <Set name="infLifeTime">true</Set>
	        <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">trailOnAir</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,0.75</KeyFrame>
            <KeyFrame>1, 1.25, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
        </Particle>
      </ParticleSystem>    
	<ParticleSystem name="ps_trailBubbles">
        <Emitter>
          <Set name="offset">-29, -2</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="lifeTime">0.3</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">trailinWater</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.25, 0.25</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
	        <Set name="initialVelocity">-25, -25</Set>
          <Set name="lifeTime">1</Set>
          <Random name="offset" min="-2,-6" max="0,6" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="ClothingOffsetFromShoes">-3</Set>
        <Set name="UserNameOffset">3</Set>
        <Set name="RenderShoesWithMermaidTail">true</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="IsRidingBird">true</Set>
	    <Set name="IsRv">true</Set>
	     <Set name="IsVehicle">true</Set>
	      <Set name="IsCar">true</Set>
	      <Set name="IsSurfboard">true</Set>
      </Default>
	    <Override overrideOnState="Motion.OnWater">
		    <Set name="IsRv">false</Set>
		    <Set name="IsCar">false</Set>
		    <Set name="IsVehicle">false</Set>
	    </Override>	    
	    <Override overrideOnState="Motion.OnAir">
		    <Set name="IsRv">false</Set>
		    <Set name="IsCar">false</Set>
		    <Set name="IsVehicle">false</Set>
	    </Override>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderBehind>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSitting>true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
	  <ParticleSystemRender name="ps_trailBubbles" />
      <SpriteRender name="s_cartBack" offset="2.75,30" alignment="DOWN_CENTER"/>
    </RenderBehind>
    <RenderShoes>
      <SpriteRender name="s_cartFront" offset="2.75,6" drawShadow="false" alignment="DOWN_CENTER"/>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>

      <ParticleSystemUpdate name="ps_trailBubbles" onState="Motion.OnWater"/>
    </RenderShoes>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>

    <Sprite name="dirtSprite1" fileName="game/particles11.rttex" textureSize="32" frame="0,19"/>
    <Sprite name="dirtSprite2" fileName="game/particles11.rttex" textureSize="32" frame="1,19"/>
    <Sprite name="dirtSprite3" fileName="game/particles11.rttex" textureSize="32" frame="2,19"/>
    <Sprite name="s_crown" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="29,0"/>
    <Sprite name="s_hatWind" fileName="game/particles12.rttex" textureSize="32" frame="0,13"/>
    <Sprite name="s_lightning" fileName="game/particles6.rttex" textureSize="32" frame="4,7"/>
    <Sprite name="s_lightning2" fileName="game/particles10.rttex" textureSize="32" frame="12,2"/>
    <Sprite name="s_frontWind" fileName="game/particles_large16.rttex" textureSize="64" frame="0,11"/>
    <Sprite name="s_backWind" fileName="game/particles_large16.rttex" textureSize="64" frame="0,12"/>

    <Animations>
      <SpriteAnimation name="dirt1" sprite="dirtSprite1" animTime="100">
        <Frame>0,19</Frame>
        <Frame>0,20</Frame>
        <Frame>0,21</Frame>
        <Frame>0,22</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="dirt2" sprite="dirtSprite2" animTime="125">
        <Frame>1,19</Frame>
        <Frame>1,20</Frame>
        <Frame>1,21</Frame>
        <Frame>1,22</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="dirt3" sprite="dirtSprite3" animTime="150">
        <Frame>2,19</Frame>
        <Frame>2,20</Frame>
        <Frame>2,21</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_hatWind" sprite="s_hatWind" animTime="800" autoPlay="true" isLoop="true">
        <Frame>0,13</Frame>
        <Frame>1,13</Frame>
        <Frame>2,13</Frame>
        <Frame>3,13</Frame>
        <Frame>4,13</Frame>
        <Frame>5,13</Frame>
        <Frame>6,13</Frame>
        <Frame>7,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_lightning" sprite="s_lightning" animTime="900" autoPlay="true" isLoop="true">
        <Frame>4,7</Frame>
        <Frame>5,7</Frame>
        <Frame>6,7</Frame>
        <Frame>7,7</Frame>
        <Frame>8,7</Frame>
        <Frame>9,7</Frame>
        <Frame>10,7</Frame>
        <Frame>11,7</Frame>
        <Frame>12,7</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_lightning2" sprite="s_lightning2" animTime="400" autoPlay="true" isLoop="true">
        <Frame>12,2</Frame>
        <Frame>13,2</Frame>
        <Frame>14,2</Frame>
        <Frame>15,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_frontWind" sprite="s_frontWind" animTime="400" autoPlay="true" isLoop="true">
        <Frame>0,11</Frame>
        <Frame>1,11</Frame>
        <Frame>2,11</Frame>
        <Frame>3,11</Frame>
        <Frame>4,11</Frame>
        <Frame>5,11</Frame>
        <Frame>6,11</Frame>
        <Frame>7,11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_backWind" sprite="s_backWind" animTime="800" autoPlay="true" isLoop="true">
        <Frame>7,11</Frame>
		<Frame>6,11</Frame>
		<Frame>5,11</Frame>
		<Frame>4,11</Frame>
		<Frame>3,11</Frame>
		<Frame>2,11</Frame>
		<Frame>1,11</Frame>
		<Frame>0,11</Frame>        
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="dirtOrbit1" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0, -10</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">1</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">-1000</Set>
            <Set name="hAmplitude">20</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">4</Set>
            <Set name="vOrbitPeriod">1000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.3</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">dirtSprite1</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.1</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="dirtOrbit2" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0, -23</Set>
          <Set name="emissionInterval">0.0625</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">1</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">-1250</Set>
            <Set name="hAmplitude">26</Set>
            <Set name="hTimeOffset">-500</Set>
            <Set name="vAmplitude">-3</Set>
            <Set name="vOrbitPeriod">1250</Set>
            <Set name="vTimeOffset">-500</Set>
            <Set name="minScale">0.3</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">dirtSprite2</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.125</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="dirtOrbit3" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0, -36</Set>
          <Set name="emissionInterval">0.075</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">1</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">-1500</Set>
            <Set name="hAmplitude">30</Set>
            <Set name="hTimeOffset">-1000</Set>
            <Set name="vAmplitude">7</Set>
            <Set name="vOrbitPeriod">1500</Set>
            <Set name="vTimeOffset">-1000</Set>
            <Set name="minScale">0.3</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">dirtSprite3</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.15</Set>
        </Particle>
      </ParticleSystem>

    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="UserNameOffset">25</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <AddClothingParticles>
    </AddClothingParticles>
    <RenderBehind value="playerCenter">
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsRenderMod>RENDER_MOD_PORTRAIT</IsRenderMod>
      </StopIf>
      <ContextUpdate type="SetFlip">
        <Set name="flip">1,0</Set>
      </ContextUpdate>
      <SpriteRender name="s_backWind" alignment="DOWN_CENTER" offset="0,10" drawShadow="false" blend="PREMULTIPLIED_ALPHA" tintOverride="255,255,255,180"/>
    </RenderBehind>
    <RenderInFront>
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <ParticleSystemRender name="dirtOrbit1"/>
      <ParticleSystemRender name="dirtOrbit2"/>
      <ParticleSystemRender name="dirtOrbit3"/>
      <ContextUpdate type="SetFlip">
        <Set name="flip">0,0</Set>
      </ContextUpdate>
      <SpriteRender name="s_frontWind" alignment="DOWN_CENTER" offset="0,10" drawShadow="false" blend="PREMULTIPLIED_ALPHA" tintOverride="255,255,255,120"/>
    </RenderInFront>
    <RenderHat>
      <Group>
        <ContextUpdate type="SetFlip">
          <Set name="flip">1,0</Set>
        </ContextUpdate>
        
        <SpriteRender name="s_backWind" alignment="DOWN_CENTER" scale ="0.5,0.5" offset="0,-35" drawShadow="false" blend="PREMULTIPLIED_ALPHA"/>
		<SpriteRender name="s_lightning2" alignment="DOWN_CENTER" offset="0,-34" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="0.8,0.8"/>
        <ContextUpdate type="SetFlip">
          <Set name="flip">0,0</Set>
        </ContextUpdate>
        <SpriteRender name="s_frontWind" alignment="DOWN_CENTER" scale ="0.5,0.5" offset="0,-35" drawShadow="false" blend="PREMULTIPLIED_ALPHA" tintOverride="255,255,255,255"/>
        <SpriteRender name="s_lightning" alignment="DOWN_CENTER" offset="0,-32" drawShadow="false" blend="PREMULTIPLIED_ALPHA"/>
      </Group>
      <SpriteRender name="s_crown" alignment="DOWN_CENTER" offset="0,-16" blend="PREMULTIPLIED_ALPHA"/>
    </RenderHat>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
