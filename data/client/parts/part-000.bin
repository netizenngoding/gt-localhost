			<ParticleSystem name="ABC" updateStage="OnKilled">
				<Emitter>
					<Set name="lifeTime">0.9</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">raja</Set>
					<Set name="offset">0,-10</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1,1</KeyFrame>
						<KeyFrame>1, 1,1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem> 
			<ParticleSystem name="ps_aura" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -15</Set>
					<Set name="emissionInterval">0.8</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">vowaura</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0.5, 1.1, 1.1</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialVelocity">0, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_aura2" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -15</Set>
					<Set name="emissionInterval">0.8</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">vowaura</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="flipX">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>0.5, 1.1, 1.1</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialVelocity">0, 0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
	<RenderOptions>
		<Default>
			<!-- <Set name="ShouldHover">true</Set> -->
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">false</Set>
			<Set name="IncludeAllActions">true</Set>
			<Set name="DefaultRenderMannequinHandItem">false</Set>
			<Set name="RenderBackArmBuild">false</Set>
			<Set name="RenderFrontArmInfected">true</Set>
			<Set name="RenderBackArmInfected">true</Set>
			<Set name="UserNameOffset">15</Set>
			<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
            <Set name="DefaultPunchSound">audio/realitytear.wav</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
			<Set name="HasDeathParticles">true</Set>
			<Set name="HideAvatarOnDeath">true</Set>
			<Set name="HideAngelOnDeath">true</Set>
			<!-- DM VOW @reeel. for items like this! -->
		</Default>
	</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-160</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Jump">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-210</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Fall">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-135</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="s_reeel" offset="10,-10" alignment="CENTER" rotateOffset="true" rotateToTarget="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="2,2" onAction="PUNCH" />
			<SpriteRender name="s_YwachVOW" offset="-130,-360" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" scale="2,2" onState="ScytheAnimation.Before|ScytheAnimation.Idle|Pet.Punch" />
		</RenderInFront>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
            <Group onState="ScytheAnimation.Before">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_vow" offset="-38,-30" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="-1.3,1.3" />
            </Group>
			<Group onState="ScytheAnimation.Idle">
                <Rotate>Sword_rotation</Rotate>
                <SpriteRender name="s_vow" offset="-38,-30" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="-1.3,1.3" />
			</Group>
		</RenderBackHandItem>
<!-- DM VOW @reeel. for items like this! -->

		
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
      <ParticleSystemUpdate name="ps_gacorDestroyImpact"/>
    </OnDestroyedTile>
		<RenderBehind>
			<StopIf>
				<!-- DM VOW @reeel. for items like this! -->
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_aura" onState="Facing.Right" />
			<ParticleSystemRender name="ps_aura2" onState="Facing.Left" />
		</RenderBehind>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
<!-- dm reeel. for items like this :) -->
  <Data>
    <!-- dem -->
    <Sprite name="iniWingnya" fileName="game/UGCSpritesheet97v0.rttex" textureSize="512"/>
    <!-- jump -->
    <Sprite name="iniParticlenya" fileName="game/UGCSpritesheet97v1.rttex" textureSize="192" frame="0,0"/>
    <!-- <Sprite name="s_death" fileName="game/flamingssSplash" textureSize="128"/> -->
    <!-- death -->
    <Sprite name="s_death" fileName="game/UGCSpritesheet97v2.rttex" textureSize="128"/>
    <Sprite name="s_snowflake" fileName="game/UGCSpritesheet97v2.rttex" textureSize="128" frame="0,0"/>
    <Sprite name="s_trail" fileName="game/UGCSpritesheet97v2.rttex" textureSize="128" frame="0,0"/>

    <Animations>
            <SpriteAnimation name="a_particle" sprite="iniParticlenya" isLoop="false" animTime="400">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>8,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_snowflake" sprite="s_snowflake" isLoop="true" animTime="400">
        <Frame>0,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_trail" sprite="s_trail" isLoop="true" animTime="300">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
        <Frame>4,2</Frame>
        <Frame>5,2</Frame>
        <Frame>6,2</Frame>
        <Frame>7,2</Frame>
        <Frame>8,2</Frame>
        <Frame>9,2</Frame>
        <Frame>10,2</Frame>
        <Frame>11,2</Frame>
        <Frame>12,2</Frame>
        <Frame>13,2</Frame>
        <Frame>14,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="Jump" playOnAction="JUMP|JUMPDOUBLE" sprite="iniWingnya" animTime="500" autoPlay="true" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <!-- <Frame>3,0</Frame> -->
      </SpriteAnimation>
      <SpriteAnimation name="Fall" playOnAction="FALL" sprite="iniWingnya" animTime="200" autoPlay="true" isLoop="true">
        <Frame>2,1</Frame>
        <Frame>2,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="iniWingnya"  isLoop="true"  autoPlay="true" animTime="600" tintOverride="0,127,236,255">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>0,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_death" sprite="s_death" animTime="1200">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>8,0</Frame>
        <Frame>9,0</Frame>
        <Frame>10,0</Frame>
        <Frame>11,0</Frame>
        <Frame>12,0</Frame>
        <Frame>13,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_snowflake">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_snowflake</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.05</Set>
          <Set name="initialAngle" source="snowflake_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_snowflake1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_snowflake</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.05</Set>
          <Set name="initialAngle" source="snowflake_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_deathSplash" updateStage="OnKilled" renderStage="RenderBehind">
        <Emitter>
          <Set name="lifeTime">1.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-24</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_death</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">3.0, 3.0</Set>
              <Set name="lifeTime">1.2</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="iniParticlenya_jump">
        <Emitter>
          <Random name="offset" min="0, 150" max="0, 150" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">2.2, 2.2</Set>
            <Set name="finalScale">1.1, 1.1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_left">
        <Emitter>
          <Random name="offset" min="40, 150" max="32, 150" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">2.2, 2.2</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="bloody_jump_right">
        <Emitter>
          <Random name="offset" min="-32, 150" max="-40, 150" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">iniParticlenya</Set>
            <Set name="overrideDefaultCloud">true</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="isBackgroundParticle">false</Set>
            <Set name="initalRGB">1, 1, 1</Set>
            <Set name="relativeToEmitter">false</Set>
            <Set name="rotateWithVelocity">false</Set>
            <Set name="interpolateAlpha">true</Set>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.8</Set>
            <Set name="initialScale">2.2, 2.2</Set>
            <Set name="finalScale">2.3, 2.3</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.2f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
      
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="HideAvatarOnDeath">true</Set>
        <Set name="HideAngelOnDeath">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
          <!-- <OnDrawCustomOutline>
        <AvatarTransform class="Scale">
            <Set name="targetScale">getCurrent</Set>
        </AvatarTransform>
        <AvatarOutline duration="1500" startScale="1,1" endScale="1.18,1.18">
            <Colours>
                <Colour>50,50,50,255</Colour>
                <Colour>0,0,0,255</Colour>
            </Colours>
        </AvatarOutline>
        <AvatarTransform class="Scale">
            <Set name="targetScale">reset</Set>
        </AvatarTransform>
    </OnDrawCustomOutline> -->
 <!-- scale="0.25,0.25"
 scale="0.25,0.25" -->
    <RenderBackpack>
      <SpriteRender name="iniWingnya" offset="15,-25" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"  scale="0.6,0.6"  drawShadow="true"/>
      <SpriteRender name="iniWingnya" offset="-15,-25" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"  scale="0.6,0.6" drawShadow="true"/> 
     </RenderBackpack>
    
    <RenderInFront>
        <ParticleSystemRender name="ps_snowflake" />
        <ParticleSystemRender name="ps_trail"/>
        <ParticleSystemRender name="ps_snowflake1"/>
        <ParticleSystemRender name="ps_trail1"/>
    </RenderInFront>

    <AddClothingParticles>
        <ParticleSystemUpdate name="ps_trail" onAction="WALK|IDLE|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_snowflake" onAction="IDLE|WALK|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_trail1" onAction="WALK|IDLE|JUMP|FALL" drawShadow="false"/>
        <ParticleSystemUpdate name="ps_snowflake1" onAction="IDLE|WALK|JUMP|FALL" drawShadow="false"/>
      <!-- donotremoveS -->
      <ParticleSystemUpdate name="iniParticlenya_jump" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_left" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
      <ParticleSystemUpdate name="bloody_jump_right" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_trail" />
      <ParticleSystemOff name="ps_trail1" />
      <ParticleSystemOff name="iniParticlenya_jump" />
      <ParticleSystemOff name="bloody_jump_left" />
      <ParticleSystemOff name="bloody_jump_right" />
    </SwitchOffClothingParticles>
  
  </RenderRules>
