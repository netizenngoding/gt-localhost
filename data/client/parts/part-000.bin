          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.05</Set>
          <Set name="initialAngle" source="snowflake_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_snowflake1">
        <Emitter>
          <Set name="offset">0, -16</Set>
