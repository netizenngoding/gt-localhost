			</SpriteAnimation>
			<SpriteAnimation name="a_land_foot1_jump_anim" sprite="s_land_foot1" animTime="1200" isLoop="true" playOnState="Land.Jump|Land.Fall">
				<Frame>6, 2</Frame>
