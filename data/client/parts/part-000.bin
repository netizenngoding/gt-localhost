        </Animations>

        <StateMachines>
            <StateMachine name="WYSKEE">
                <States>
                    <State name="1" />
                    <State name="2" />
                    <State name="3" />
                    <State name="4" />
                    <State name="5" />
                    <State name="6" />
                    <State name="7" />
                    <State name="w" />
                    <State name="tf_gate" />
                    <State name="t1_gate" />
                    <State name="revert_gate" />
                    <State name="norm_gate" />
                    <State name="t1" />
                    <State name="t2" />
                    <State name="t3" />
                    <State name="t4" />
                    <State name="t5" />
                    <State name="t6" />
                    <State name="tw" />
                </States>
                <Transitions>
                    <!-- Base Mode Movement Transitions -->
                    <Transition to="1" from="2|3|4|5|6|w">
                        <Condition>
                            <IsAction>IDLE</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="2" from="1|3|4|5|6|w">
                        <Condition>
                            <IsAction>WALK</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="3" from="1|2|4|5|6|w">
                        <Condition>
                            <IsAction>JUMP</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="4" from="1|2|3|5|6|w">
                        <Condition>
                            <IsAction>FALL</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="5" from="1|2|3|4|6|w">
                        <Condition>
                            <IsAction>PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="6" from="1|2|3|4|5|w">
                        <Condition>
                            <IsAction>DANCE</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="w" from="1|2|3|4|5|6">
                        <Condition>
                            <IsAction>SLEEP</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="7" from="1|2|3|4|5|6|w">
                        <Condition>
                            <IsVariableBool name="isMannequin">true</IsVariableBool>
                        </Condition>
                    </Transition>

                    <!-- Transformed Mode Movement Transitions (Stable 1-to-1) -->
                    <Transition to="t1" from="t2|t3|t4|t5|t6|tw">
                        <Condition>
                            <IsAction>IDLE</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="t2" from="t1|t3|t4|t5|t6|tw">
                        <Condition>
                            <IsAction>WALK</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="t3" from="t1|t2|t4|t5|t6|tw">
                        <Condition>
                            <IsAction>JUMP</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="t4" from="t1|t2|t3|t5|t6|tw">
                        <Condition>
                            <IsAction>FALL</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="t5" from="t1|t2|t3|t4|t6|tw">
                        <Condition>
                            <IsAction>PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="t6" from="t1|t2|t3|t4|t5|tw">
                        <Condition>
                            <IsAction>DANCE</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="tw" from="t1|t2|t3|t4|t5|t6">
                        <Condition>
                            <IsAction>SLEEP</IsAction>
                        </Condition>
                    </Transition>

                    <!-- 1. Tekan FURIOUS dari Normal Mode -> tf_gate -->
                    <Transition to="tf_gate" from="1|2|3|4|5|6|w">
                        <Condition>
                            <IsAction>FURIOUS</IsAction>
                        </Condition>
                    </Transition>

                    <!-- 2. Animasi Gate Selesai -> t1_gate (Nahan Jari Sampai Dilepas) -->
                    <Transition to="t1_gate" from="tf_gate">
                        <Condition>
                            <IsAnimationFinished>tf_gate_anim</IsAnimationFinished>
                        </Condition>
                    </Transition>

                    <!-- 3. Jari Dilepas dari FURIOUS -> Resmi Masuk Transformed Mode (t1) -->
                    <Transition to="t1" from="t1_gate">
                        <Condition>
                            <IsAction operatorType="NotEqual">FURIOUS</IsAction>
                        </Condition>
                    </Transition>

                    <!-- 4. Tekan FURIOUS dari Transformed Mode -> revert_gate -->
                    <Transition to="revert_gate" from="t1|t2|t3|t4|t5|t6|tw">
                        <Condition>
                            <IsAction>FURIOUS</IsAction>
                        </Condition>
                    </Transition>

                    <!-- 5. Animasi Revert Selesai -> norm_gate (Nahan Jari Sampai Dilepas) -->
                    <Transition to="norm_gate" from="revert_gate">
                        <Condition>
                            <IsAnimationFinished>revert_gate_anim</IsAnimationFinished>
                        </Condition>
                    </Transition>

                    <!-- 6. Jari Dilepas dari FURIOUS -> Resmi Kembali Ke Normal Mode (1) -->
                    <Transition to="1" from="norm_gate">
                        <Condition>
                            <IsAction operatorType="NotEqual">FURIOUS</IsAction>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>

        <ParticleSystems>
            <!-- 1. Proyektil Bola dari Mulut (Smooth Spawn & Scaling Curve) -->
            <ParticleSystem name="ps_punchProjectile" updateStage="OnPunchStart">
                <Emitter>
                    <Set name="offset">25,-10037</Set>
                    <Set name="offsetFacing">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">nailong_eff</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="renderAlignment">CENTER</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <!-- Mengembang mulus dari 0.4 ke 1.0 saat keluar mulut -->
                    <Curve name="initialScale">
                        <KeyFrame>0, 0.4, 0.4</KeyFrame>
                        <KeyFrame>0.2, 1.0, 1.0</KeyFrame>
                        <KeyFrame>1, 1.0, 1.0</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">0.22</Set>
                    <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
                    <OnFinish>
                        <ParticleSystemName>ps_punchHit</ParticleSystemName>
                    </OnFinish>
                </Particle>
            </ParticleSystem>

            <!-- 2. Ledakan Benturan di Target (Smooth Expansion & Fade Out) -->
            <ParticleSystem name="ps_punchHit">
                <Emitter>
                    <Set name="offset">0,0</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">nailong_hit</Set>
                    <Set name="renderAlignment">CENTER</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <!-- Membesar halus dari 0.7 ke 1.5 -->
                    <Curve name="initialScale">
                        <KeyFrame>0, 0.7, 0.7</KeyFrame>
                        <KeyFrame>1, 1.5, 1.5</KeyFrame>
                    </Curve>
                    <!-- Terang di awal, lalu memudar lembut di akhir animasi -->
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.7, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">0.35</Set>
                </Particle>
            </ParticleSystem>


            <!-- Partikel Api Membakar Tubuh SEJENAK (HANYA Saat Berubah Wujud Normal -> Super) -->
            <ParticleSystem name="ps_tf_burst" updateStage="AddClothingParticles" updateState="WYSKEE.tf_gate">
                <Emitter>
                    <Random name="offset" min="-20, -10075" max="20, -10000" />
                    <Set name="lifeTime">0.2</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">15</Set>
                    <Set name="particlesToEmit">15</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">bd</Set>
                    <Set name="frame">18,5</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="initialVelocity">0, -75</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Curve name="initialScale">
                        <KeyFrame>0, 1.0, 1.0</KeyFrame>
                        <KeyFrame>1, 0.2, 0.2</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">0.4</Set>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>

        <RenderOptions>
            <Default>
                <Set name="DefaultPunchSound">audio/droar.wav</Set>
                <Set name="JumpEndStateRange">100</Set>
                <Set name="ClothingOffsetFromShoes">10000</Set>
                <Set name="IsRidingBird">true</Set>
                <Set name="IsVehicle">true</Set>
                <Set name="UserNameOffset">25</Set>
                <Set name="RenderShoesWithMermaidTail">true</Set>
                <Set name="ShoesHidesBodyLegs">true</Set>
                <Set name="IsToRenderPants">false</Set>

                <Set name="IncludeAllActions">true</Set>
            </Default>
            <Override overrideOnState="WYSKEE.7">
                <Set name="ClothingOffsetFromShoes">10000</Set>
            </Override>
        </RenderOptions>
    </Data>

    <RenderRules>
        <Update>
            <AvatarTransform class="ActionUpdate" onState="WYSKEE.6|WYSKEE.7|WYSKEE.t6">
                <Set name="action">NOD</Set>
            </AvatarTransform>
            <MusicSource onState="WYSKEE.6|WYSKEE.t6">
                <Set name="MusicFile">audio/ogg/you_row.ogg</Set>
            </MusicSource>
        </Update>

        <RenderInFront>
            <StopIf>
                <IsVariableBool name="isMannequin">true</IsVariableBool>
                <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
            </StopIf>

            <SpriteRender
                name="bd"
                offset="0,-10035"
                drawShadow="true"
                onState="WYSKEE.1|WYSKEE.2|WYSKEE.3|WYSKEE.4|WYSKEE.5|WYSKEE.6|WYSKEE.w|WYSKEE.7|WYSKEE.tf_gate|WYSKEE.t1_gate|WYSKEE.revert_gate|WYSKEE.norm_gate|WYSKEE.t1|WYSKEE.t2|WYSKEE.t3|WYSKEE.t4|WYSKEE.t5|WYSKEE.t6|WYSKEE.tw"
                scale="0.8,0.8" />

            <SpriteRender
                name="fc"
                offset="0,-10035"
                drawShadow="false"
                onState="WYSKEE.1|WYSKEE.w|WYSKEE.tf_gate|WYSKEE.t1_gate|WYSKEE.revert_gate|WYSKEE.norm_gate|WYSKEE.t1|WYSKEE.tw"
                scale="0.8,0.8" />

        </RenderInFront>

        <RenderShoes>
            <StopIf>
                <IsSitting>true</IsSitting>
                <IsSleepingOnaBed>true</IsSleepingOnaBed>
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
            </StopIf>
        </RenderShoes>
    </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="UC_Sprite" fileName="game/neymar.rttex" textureSize="69"/>
		<Sprite name="UC_Punch" fileName="game/messi_punch.rttex" textureSize="128"/>
		<Sprite name="UC_Portal" fileName="game/neymar_particles.rttex" textureSize="64"/>
		<Sprite name="UC_Portal2" fileName="game/neymar_particles.rttex" textureSize="32" frame="1,0"/>
		<Sprite name="UC_Portal4" fileName="game/neymar_particles.rttex" textureSize="64" frame="0,0"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="ge_eff2" sprite="UC_Portal4" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
				<Frame>10,5</Frame>
				<Frame>11,5</Frame>
				<Frame>12,5</Frame>
				<Frame>13,5</Frame>
				<Frame>14,5</Frame>
				<Frame>15,5</Frame>
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="ge_eff" sprite="UC_Portal" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="uc_Idle_Animation" playOnState="Motion.Idle" sprite="UC_Sprite" animTime="14000" isLoop="true">
            <Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Punch_Animation" playOnState="Motion.Punch" sprite="UC_Sprite" animTime="400">
			<Frame>0,5</Frame>
			<Frame>1,5</Frame>
			<Frame>2,5</Frame>
			<Frame>3,5</Frame>
			<Frame>4,5</Frame>
			<Frame>5,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Jump_Animation" playOnState="Motion.Jump" sprite="UC_Sprite" animTime="400">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Fall_Animation" playOnState="Motion.Fall" sprite="UC_Sprite" animTime="400">
				<Frame>3,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Walk_Animation" playOnState="Motion.Move" sprite="UC_Sprite" animTime="600" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>

			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="uc_flex" updateStage="AddClothingParticles" renderStage="RenderInFront">
				<Emitter>
				  <Random name="offset" min="0, -10000" max="20, -10070" />
				  <Random name="emissionInterval" min="0.05" max="0.07" />
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
				  <Set name="sprite">UC_Portal2</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Set name="lifeTime">0.5</Set>
				  <Set name="initialVelocity">0,-3</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Random name="initialScale" min="0.4" max="0.6" />
				</Particle>
			  </ParticleSystem>
			<ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
				<Emitter>
                    <Set name="offset">25,-10000</Set>
                    <Set name="emissionInterval">10</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">UC_Punch</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Curve name="initialAlpha">
                                <KeyFrame>0, 1</KeyFrame>
                                <KeyFrame>0.5, 1</KeyFrame>
                                <KeyFrame>1, 0</KeyFrame>
                            </Curve>
                    <Curve name="initialScale">
                                <KeyFrame>0, 0,0</KeyFrame>
                                <KeyFrame>1, 0.7,0.7</KeyFrame>
                    </Curve>
					<Random name="initialRotationRate" min="360" max="-360" />
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="interpolateAlpha">false</Set>
                    <Set name="initialAlpha">1</Set>
                    <Set name="finalAlpha">1</Set>
                    <Set name="interpolateVelocity">true</Set>
                    <Set name="initialScale">1,1</Set>
                    <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                    <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                </Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">30</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLeneymar">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<AvatarSilhouetteRender color="10,10,10,100" offset ="0,30" emissionInterval="0.08" onState="Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" scale="1=2,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060"  tintOverride="255,50,255,255" scale="2,2.5" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Sprite" offset="0,-10028.5" drawShadow="true" scale="1,1" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" flip="1,0" tintOverride="0,0,0,60" scale="1,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
        </RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnPunchStart>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="XML_SPRITESHEET_0" fileName="game/nw.rttex" textureSize="64" frame="0,0" />

		<Sprite name="XML_SPRITESHEET_1" fileName="game/nw_particles.rttex" textureSize="32"
			frame="0,0" />
		<Sprite name="XML_SPRITESHEET_2" fileName="game/nw_particles.rttex"
			textureSize="32"
			frame="1,0" />
		<Sprite name="XML_SPRITESHEET_3" fileName="game/nw_particles.rttex" textureSize="32"
			frame="2,0" />


		<Animations>
			<SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="XML_SPRITESHEET_0">
				<Frame>0,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="be_idle3" playOnAction="FALL" sprite="XML_SPRITESHEET_0">
				<Frame>3,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="wingFlexJump2" playOnAction="JUMP|JUMPEND" sprite="XML_SPRITESHEET_0"
				animTime="250" autoPlay="true" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>2,0</Frame>
				<Frame>1,0</Frame>
				<Frame>0,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="XML_SPRITESHEET_3"
				playOnState="playerState.DoubleJump" autoPlay="false" isLoop="false"
				sprite="XML_SPRITESHEET_3" animTime="100">
				<Frame>2,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="XML_SPRITESHEET_1"
				playOnState="playerState.DoubleJump" autoPlay="false" isLoop="false"
				sprite="XML_SPRITESHEET_1" animTime="100">
				<Frame>0,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="XML_SPRITESHEET_2"
				playOnState="playerState.DoubleJump" autoPlay="false" isLoop="false"
				sprite="XML_SPRITESHEET_2" animTime="100">
				<Frame>1,0</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>


			<ParticleSystem name="XML_SPRITESHEET_3_up">
				<Emitter>
					<Random name="offset" min="0, -5" max="0, -5" />
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">XML_SPRITESHEET_3</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1.1, 1.1</Set>
					<Set name="finalScale">1.1, 1.1</Set>
				</Particle>
			</ParticleSystem>


			<ParticleSystem name="double_jump_particle_left">
				<Emitter>
					<Random name="offset" min="20, 0" max="16, 0" />
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">XML_SPRITESHEET_1</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1.1, 1.1</Set>
					<Set name="finalScale">2.3, 2.3</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="double_jump_particle_right">
				<Emitter>
					<Random name="offset" min="-16, 0" max="-20, 0" />
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">XML_SPRITESHEET_2</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1.1, 1.1</Set>
					<Set name="finalScale">2.3, 2.3</Set>
				</Particle>
			</ParticleSystem>

		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderBackpack>
			<SpriteRender name="XML_SPRITESHEET_0" offset="0,-32" alignmentLeft="LEFT_CENTER"
				alignmentRight="RIGHT_CENTER" />
			<SpriteRender name="XML_SPRITESHEET_0" offset="0,-32" flip="1,0"
				alignmentLeft="RIGHT_CENTER"
				alignmentRight="LEFT_CENTER" />
		</RenderBackpack>

		<AddClothingParticles>
			<ParticleSystemUpdate name="XML_SPRITESHEET_3_up" onAction="JUMPDOUBLE"
				drawShadow="false" align="RIGHT_CENTER" />
			<ParticleSystemUpdate name="double_jump_particle_left" onAction="JUMPDOUBLE"
				drawShadow="false" align="LEFT_CENTER" />
			<ParticleSystemUpdate name="double_jump_particle_right" onAction="JUMPDOUBLE"
				drawShadow="false" align="RIGHT_CENTER" />
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="XML_SPRITESHEET_3_up" />
			<ParticleSystemOff name="double_jump_particle_left" />
			<ParticleSystemOff name="double_jump_particle_right" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="UC_Sprite" fileName="game/ronaldo.rttex" textureSize="69"/>
		<Sprite name="UC_Punch" fileName="game/messi_punch.rttex" textureSize="128"/>
		<Sprite name="UC_Portal" fileName="game/ronaldo_particles.rttex" textureSize="64"/>
		<Sprite name="UC_Portal2" fileName="game/ronaldo_particles.rttex" textureSize="32" frame="1,0"/>
		<Sprite name="UC_Portal4" fileName="game/ronaldo_particles.rttex" textureSize="64" frame="0,0"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="ge_eff2" sprite="UC_Portal4" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
				<Frame>10,5</Frame>
				<Frame>11,5</Frame>
				<Frame>12,5</Frame>
				<Frame>13,5</Frame>
				<Frame>14,5</Frame>
				<Frame>15,5</Frame>
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="ge_eff" sprite="UC_Portal" animTime="800" isLoop="true" playOnState="Motion.Punch|Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>
				</SpriteAnimation>
			<SpriteAnimation name="uc_Idle_Animation" playOnState="Motion.Idle" sprite="UC_Sprite" animTime="14000" isLoop="true">
            <Frame>0,0</Frame>
			<Frame>1,0</Frame>
			<Frame>2,0</Frame>
			<Frame>3,0</Frame>
			<Frame>4,0</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,2</Frame>
			<Frame>1,2</Frame>
			<Frame>2,2</Frame>
			<Frame>3,2</Frame>
            <Frame>0,1</Frame>
			<Frame>1,1</Frame>
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
            <Frame>2,1</Frame>
            <Frame>1,1</Frame>
            <Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Punch_Animation" playOnState="Motion.Punch" sprite="UC_Sprite" animTime="400">
			<Frame>0,5</Frame>
			<Frame>1,5</Frame>
			<Frame>2,5</Frame>
			<Frame>3,5</Frame>
			<Frame>4,5</Frame>
			<Frame>5,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Jump_Animation" playOnState="Motion.Jump" sprite="UC_Sprite" animTime="400">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Fall_Animation" playOnState="Motion.Fall" sprite="UC_Sprite" animTime="400">
				<Frame>3,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_Walk_Animation" playOnState="Motion.Move" sprite="UC_Sprite" animTime="600" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>

			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="uc_flex" updateStage="AddClothingParticles" renderStage="RenderInFront">
				<Emitter>
				  <Random name="offset" min="0, -10000" max="20, -10070" />
				  <Random name="emissionInterval" min="0.05" max="0.07" />
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
				  <Set name="sprite">UC_Portal2</Set>
				  <Set name="blendingMode">ADDITIVE</Set>
				  <Set name="lifeTime">0.5</Set>
				  <Set name="initialVelocity">0,-3</Set>
				  <Set name="inSpecificOrder">true</Set>
				  <Curve name="initialAlpha">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				  </Curve>
				  <Random name="initialScale" min="0.4" max="0.6" />
				</Particle>
			  </ParticleSystem>
			<ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
				<Emitter>
                    <Set name="offset">25,-10000</Set>
                    <Set name="emissionInterval">10</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">UC_Punch</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Curve name="initialAlpha">
                                <KeyFrame>0, 1</KeyFrame>
                                <KeyFrame>0.5, 1</KeyFrame>
                                <KeyFrame>1, 0</KeyFrame>
                            </Curve>
                    <Curve name="initialScale">
                                <KeyFrame>0, 0,0</KeyFrame>
                                <KeyFrame>1, 0.7,0.7</KeyFrame>
                    </Curve>
					<Random name="initialRotationRate" min="360" max="-360" />
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="interpolateAlpha">false</Set>
                    <Set name="initialAlpha">1</Set>
                    <Set name="finalAlpha">1</Set>
                    <Set name="interpolateVelocity">true</Set>
                    <Set name="initialScale">1,1</Set>
                    <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                    <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
                </Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">30</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLeronaldo">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<AvatarSilhouetteRender color="10,10,10,100" offset ="0,30" emissionInterval="0.08" onState="Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" scale="1=2,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060"  tintOverride="255,50,255,255" scale="2,2.5" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal4" offset="3,-10060" tintOverride="255,50,255,255" scale="2,2.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Sprite" offset="0,-10028.5" drawShadow="true" scale="1,1" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
			<SpriteRender name="UC_Portal" offset="-3,-10028.5" flip="1,0" tintOverride="0,0,0,60" scale="1,1.5" drawShadow="false" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
        </RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnPunchStart>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Canister" fileName="game/particles_large13.rttex" textureSize="64" frame="0,10" />
		<Sprite name="s_Grenade" fileName="game/particles11.rttex" textureSize="32" frame="22,23" />
		<Sprite name="s_HitParticles" fileName="game/particles11.rttex" textureSize="32" frame="19,23" />
		<Sprite name="s_InkDrop" fileName="game/particles11.rttex" textureSize="32" frame="23,23" />
		<Sprite name="s_PaintBall" fileName="game/particles2.rttex" textureSize="32" frame="13,11" />
		<Sprite name="s_PaintDrop" fileName="game/particles.rttex" textureSize="32" frame="10,9" />
		<Sprite name="s_PaintSplat" fileName="game/particles11.rttex" textureSize="32" frame="18,23" />
		<Sprite name="s_Strap" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="0,18" />
		<Animations>
			<SpriteAnimation name="a_Canister" sprite="s_Canister" animTime="600" autoPlay="true" isLoop="true">
				<Frame>0,10</Frame>
				<Frame>1,10</Frame>
				<Frame>2,10</Frame>
				<Frame>3,10</Frame>
				<Frame>4,10</Frame>
				<Frame>5,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_HitParticles" sprite="s_HitParticles" animTime="300">
				<Frame>19,23</Frame>
				<Frame>20,23</Frame>
				<Frame>21,23</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_InkDrop" sprite="s_InkDrop" animTime="800">
				<Frame>23,23</Frame>
				<Frame>24,23</Frame>
				<Frame>25,23</Frame>
				<Frame>26,23</Frame>
				<Frame>27,23</Frame>
				<Frame>28,23</Frame>
				<Frame>29,23</Frame>
				<Frame>30,23</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="Drops" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_InkDrop</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="initialScale">0.5, 0.5</Set>
					<Set name="lifeTime">0.75</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="20,40" />
					<Set name="gravityVector">0, 60</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="DropsDestroy" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="particlesPerEmission">20</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_InkDrop</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="initialScale">0.5, 0.5</Set>
					<Set name="lifeTime">0.75</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="20,40" />
					<Set name="gravityVector">0, 60</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_HitParticles</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1.5, 1.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="HitDestroy" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_HitParticles</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1.5, 1.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="PaintBall" updateStage="OnPaintTile" secondary="PaintSplat">
				<Emitter>
					<Set name="offset">22, -22</Set>
					<Set name="lifeTime">0.1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_PaintBall</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="PaintDrops">
				<Emitter>
					<Random name="offset" min="-8, 8" max="-8, 8.1" />
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_PaintDrop</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="initialScale">0.75, 0.75</Set>
					<Set name="lifeTime">0.75</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="20,40" />
					<Set name="gravityVector">0, 60</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="PaintSplat" secondary="PaintDrops">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="delayTimer">0.4</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_PaintSplat</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1.5, 1.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<Set name="initialVelocity">0, 0</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">25, -22</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle particleIndexSpriteFrame="true">
					<Set name="sprite">s_Grenade</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" />
					<Random name="initialAngle" min="-180" max="180" />
					<Set name="initialRotationRate">200</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderBackpack>
			<SpriteRender name="s_Canister" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" />
		</RenderBackpack>
		<RenderFrontpack>
			<SpriteRender name="s_Strap" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" />
		</RenderFrontpack>
		<OnPunchStart>
			<AvatarTransform class="Face">
				<Set name="face">NORMAL</Set>
			</AvatarTransform>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
	<StateMachines>
		<StateMachine name="playerState">
			<States>
				<State name="Idle"/>
				<State name="Punch"/>
				<State name="ZombiePunch"/>
			</States>
			<Transitions>
				<Transition from="ZombiePunch|Punch" to="Idle" >
					<Condition>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition from="ZombiePunch|Idle" to="Punch">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
						<IsZombified>false</IsZombified>
					</Condition>
				</Transition>
				<Transition from="Idle|Punch" to="ZombiePunch">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
						<IsZombified>true</IsZombified>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
	</StateMachines>

	<Sprite name="item_Sprite_1" fileName="game/ugc_sprites2.rttex" textureSize="128" frame="2,1"/>
	<Sprite name="SlashSprite" fileName="game/ugc_sprites2.rttex" textureSize="128" frame="6,1"/>
	<Sprite name="punch_effect" fileName="game/ugc_particles2.rttex" textureSize="64" frame="1,14"/>

	<Animations>
		<SpriteAnimation name="wingFlexJump2" playOnAction="JUMP|FALL|IDLE|WALK" sprite="item_Sprite_1" animTime="700" autoPlay="true" isLoop="true">
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
			<Frame>4,1</Frame>
			<Frame>5,1</Frame>
		</SpriteAnimation>

		<SpriteAnimation name="slash_animation" sprite="SlashSprite" animTime="250" isLoop="true" playOnState="playerState.Punch">
        	<Frame>6,1</Frame>
        	<Frame>7,1</Frame>
        	<Frame>8,1</Frame>
        	<Frame>9,1</Frame>
      </SpriteAnimation>
    </Animations>

	<ParticleSystems>
		<ParticleSystem name="soulless_particle">
			<Emitter>
				<Set name="offset">0,-12</Set>
				<Set name="emissionInterval">0.25</Set>
				<Set name="lifeTime">0.25</Set>
				<Set name="particlesPerEmission">1</Set>
				<Set name="particlesToEmit">1</Set>
			</Emitter>
			<Particle>
				<Set name="sprite">punch_effect</Set>
				<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				<Set name="lifeTime">0.4</Set>
				<Set name="rotateWithVelocity">true</Set>
				<Set name="interpolateAlpha">false</Set>
				<Set name="initialAlpha">1</Set>
				<Set name="finalAlpha">1</Set>
				<Set name="interpolateVelocity">true</Set>
				<Curve name="initialScale">
            				<KeyFrame>0, 0.5,0.5</KeyFrame>
            				<KeyFrame>1, 1,1</KeyFrame>
          				</Curve>
				<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
			</Particle>
		</ParticleSystem>
	</ParticleSystems>

	<RenderOptions>
		<Default>
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
		</Default>
	</RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackHandItem>
	  <SpriteRender name="item_Sprite_1" rotateOffset="true" offset="15,0" alignment="CENTER"/>
    </RenderBackHandItem>

    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="SlashSprite" offset="12,-28" scale="1.25,1.25" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onState="playerState.Punch" drawShadow="false"/>
    </RenderInFront>

    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="playerState.Idle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>

    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Idle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1200</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>

	<OnPunchStart>
		<ParticleSystemUpdate name="soulless_particle"/>
	</OnPunchStart>

	<SwitchOffClothingParticles>
		<ParticleSystemOff name="soulless_particle"/>
	</SwitchOffClothingParticles>

  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_CapeBack" fileName="game/particles_large18.rttex" textureSize="64" frame="0,14" />
    <Sprite name="s_CapeFront" fileName="game/particles_large18.rttex" textureSize="64" frame="0,13" />
    <Sprite name="s_Hood" fileName="game/particles12.rttex" textureSize="32" frame="12,21" />
    <Sprite name="s_HoodBack" fileName="game/particles12.rttex" textureSize="32" frame="13,21" />
    <Sprite name="s_Angelic" fileName="game/particles_large18.rttex" textureSize="64" frame="6,13" />
    <Sprite name="s_Sparks" fileName="game/particles12.rttex" textureSize="32" frame="10,21" />

    <StateMachines>
      <StateMachine name="PlayerState">
        <States start="Grounded">
          <State name="Grounded"/>
          <State name="Fall"/>
          <State name="Jump"/>
        </States>
        <Transitions>
          <Transition from="Jump|Fall" to="Grounded" >
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Fall|Grounded" to="Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Jump|Grounded" to="Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="HoodState">
        <States start="On">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showHood">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showHood">true</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="StardustState">
        <States start="On">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showStardust">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showStardust">true</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="AngelicState">
        <States start="On">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showAngelic">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showAngelic">true</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Zombie">
        <States start="Off">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <IsZombified>true</IsZombified>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <Animations>
      <SpriteAnimation name="a_Sparks" sprite="s_Sparks">
        <Frame>10,21</Frame>
        <Frame>11,21</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeBackIdle" sprite="s_CapeBack" animTime="800" isLoop="true" playOnState="PlayerState.Grounded">
        <Frame>0,14</Frame>
        <Frame>1,14</Frame>
        <Frame>2,14</Frame>
        <Frame>3,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeFrontIdle" sprite="s_CapeFront" animTime="800" isLoop="true" playOnState="PlayerState.Grounded">
        <Frame>0,13</Frame>
        <Frame>1,13</Frame>
        <Frame>2,13</Frame>
        <Frame>3,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeBackJump" sprite="s_CapeBack" animTime="800" isLoop="true" playOnState="PlayerState.Jump">
        <Frame>4,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeFrontJump" sprite="s_CapeFront" animTime="800" isLoop="true" playOnState="PlayerState.Jump">
        <Frame>4,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeBackFall" sprite="s_CapeBack" animTime="400" isLoop="true" playOnState="PlayerState.Fall">
        <Frame>5,14</Frame>
        <Frame>6,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeFrontFall" sprite="s_CapeFront" animTime="800" isLoop="true" playOnState="PlayerState.Fall">
        <Frame>5,13</Frame>
      </SpriteAnimation>
      <SpriteSinPulseAnimation name="a_Angelic_float" sprite="s_Angelic" autoPlay="true">
        <Parameter name="pos.y">
          <Set name="period">1500</Set>
          <Set name="scale">2</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteSinPulseAnimation name="a_Angelic_opacity" sprite="s_Angelic" autoPlay="true" isLoop="true">
        <Parameter name="alpha">
          <Set name="period">1000</Set>
          <Set name="scale">0.25</Set>
          <Set name="offset">0.75</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
    </Animations>
    
    <ParticleSystems>
      <ParticleSystem name="ps_sparks_left" updateStage="AddClothingParticles" updateState="StardustState.On">
        <Emitter>
          <Set name="lifeTime">0.4</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">4</Set>
          <Set name="emissionInterval">0.3</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="offset">0,-10</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_Sparks</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="225,270" radiusRange="25,25" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-25, 0" max="0, 0" />
          <Set name="relativeToEmitter">true</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_sparks_right" updateStage="AddClothingParticles" updateState="StardustState.On">
        <Emitter>
          <Set name="lifeTime">0.4</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">4</Set>
          <Set name="emissionInterval">0.3</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="offset">0,-10</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_Sparks</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="270,315" radiusRange="25,25" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="0, 0" max="25, 0" />
          <Set name="relativeToEmitter">true</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <VariableMap>
      <Set name="showHood" UIOrder="1" RadioGroup="-1" UIName="Show Hood">true</Set>
      <Set name="showStardust" UIOrder="2" RadioGroup="-1" UIName="Show Stardust Aura">true</Set>
      <Set name="showAngelic" UIOrder="3" RadioGroup="-1" UIName="Show Angelic Aura">true</Set>
    </VariableMap>
    
  </Data>
  <RenderRules>
    <RenderBackpack>
      <ParticleSystemRender name="ps_sparks_left"/>
      <ParticleSystemRender name="ps_sparks_right"/>
      <SpriteRender name="s_Angelic" offset="0,-30" blend="PREMULTIPLIED_ALPHA" onState="AngelicState.On" drawShadow="false"/>
      <SpriteRender name="s_CapeBack" offset="0,-31" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_HoodBack" offset="0,-30" blend="PREMULTIPLIED_ALPHA" onState="HoodState.On"/>
    </RenderBackpack>
    <RenderInFront>
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>

      <ContextUpdate type="SetTint" onState="Zombie.On">
        <Set name="tint">111,217,45</Set>
        <Set name="forceTint">true</Set>
      </ContextUpdate>
      
      <SpriteRender name="s_Hood" offset="0,-30" blend="PREMULTIPLIED_ALPHA" drawShadow="false" onState="HoodState.On"/>
      <SpriteRender name="s_CapeFront" offset="0,-31" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      
    </RenderInFront>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_pendant" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="5,0" />
    <Sprite name="s_transform" fileName="game/tf_page4.rttex" textureSize="64" frame="0,5" />
    <Sprite name="s_flash" fileName="game/tf_page4.rttex" textureSize="64" frame="11,6" />
    <Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32" frame="15,5" />
    <Sprite name="s_break" fileName="game/particles12.rttex" textureSize="32" frame="20,5" />
    <Sprite name="s_death" fileName="game/tf_page4.rttex" textureSize="64" frame="0,6" />
    <Sprite name="s_sparkles" fileName="game/particles.rttex" textureSize="32" frame="15,5" />

    <StateMachines>
      <StateMachine name="Main">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="Jump" />
          <State name="Fall" />
          <State name="PunchOnGround" />
          <State name="PunchInAir" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|Fall|PunchOnGround|Jump|PunchInAir">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|Fall|PunchOnGround|PunchInAir|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Walk|Fall|PunchInAir|PunchOnGround">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Walk|PunchInAir|PunchOnGround">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="PunchOnGround" from="Idle|Walk|PunchInAir|Jump|Fall">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="PunchInAir" from="Idle|Walk|Jump|Fall|PunchOnGround">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="IsTransformed">
        <States>
          <State name="No" />
          <State name="Transition" />
          <State name="Yes" />
        </States>
        <Transitions>
          <Transition to="Yes" from="Transition">
            <Condition>
              <IsItemTransformed>true</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="No" from="Transition">
            <Condition>
              <IsItemTransformed>false</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="Transition" from="No">
            <Condition>
              <IsItemTransformed>true</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="Transition" from="Yes">
            <Condition>
              <IsItemTransformed>false</IsItemTransformed>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="AllowChangePunchType">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="HideAvatarOnDeath">false</Set>
      </Default>
      <Override overrideOnState="IsTransformed.Yes">
        <Set name="HideAvatarOnDeath">true</Set>
      </Override>
    </RenderOptions>
    <TileStampData>
      <Set name="FileName">game/particles12.rttex</Set>
      <Set name="EndFrame">19,5</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>
    <Animations>
      <SpriteAnimation name="a_idle" sprite="s_transform" animTime="500" isLoop="true" playOnState="Main.Idle">
        <Frame>0,5</Frame>
        <Frame>1,5</Frame>
        <Frame>2,5</Frame>
        <Frame>3,5</Frame>
        <Frame>4,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_walk" sprite="s_transform" animTime="400" isLoop="true" playOnState="Main.Walk">
        <Frame>5,5</Frame>
        <Frame>6,5</Frame>
        <Frame>7,5</Frame>
        <Frame>8,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump" sprite="s_transform" animTime="300" isLoop="true" playOnState="Main.Jump">
        <Frame>9,5</Frame>
        <Frame>10,5</Frame>
        <Frame>11,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall" sprite="s_transform" animTime="300" isLoop="true" playOnState="Main.Fall">
        <Frame>12,5</Frame>
        <Frame>13,5</Frame>
        <Frame>14,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punch" sprite="s_transform" animTime="300" isLoop="true" playOnState="Main.PunchOnGround|Main.PunchInAir">
        <Frame>8,6</Frame>
        <Frame>9,6</Frame>
        <Frame>10,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flash" sprite="s_flash" animTime="400" >
        <Frame>14,6</Frame>
        <Frame>11,6</Frame>
        <Frame>12,6</Frame>
        <Frame>13,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_death" sprite="s_death" animTime="800">
        <Frame>7,6</Frame>
        <Frame>0,6</Frame>
        <Frame>1,6</Frame>
        <Frame>2,6</Frame>
        <Frame>3,6</Frame>
        <Frame>4,6</Frame>
        <Frame>5,6</Frame>
        <Frame>6,6</Frame>
      </SpriteAnimation>
    </Animations>
    <ParticleSystems>
      <ParticleSystem name="p_flash" updateStage="AddClothingParticles" updateState="IsTransformed.Transition">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0, -32</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_flashRespawn" updateStage="OnRespawned" updateState="IsTransformed.Yes">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0, -680</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_flash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">16,-18</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="emissionInterval">0.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_slash</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_break" updateStage="OnDestroyedTile">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_break</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0,0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_killedAnim" updateStage="OnKilled">
        <Emitter>
          <Set name="lifeTime">0.8</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-32</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_death</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.8</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_Sparkles" updateStage="AddClothingParticles" updateState="Motion.Move">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Random name="emissionInterval" min="0.01" max="0.1" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_sparkles</Set>
          <Random name="offset" min="-10, -16" max="10, 16" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.05, 1</KeyFrame>
            <KeyFrame>0.1, 0</KeyFrame>
            <KeyFrame>0.15, 1</KeyFrame>
            <KeyFrame>0.2, 0</KeyFrame>
            <KeyFrame>0.25, 1</KeyFrame>
            <KeyFrame>0.3, 0</KeyFrame>
            <KeyFrame>0.35, 1</KeyFrame>
            <KeyFrame>0.4, 0</KeyFrame>
            <KeyFrame>0.45, 1</KeyFrame>
            <KeyFrame>0.5, 0</KeyFrame>
            <KeyFrame>0.55, 1</KeyFrame>
            <KeyFrame>0.6, 0</KeyFrame>
            <KeyFrame>0.65, 1</KeyFrame>
            <KeyFrame>0.7, 0</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>0.8, 0</KeyFrame>
            <KeyFrame>0.85, 1</KeyFrame>
            <KeyFrame>0.9, 0</KeyFrame>
            <KeyFrame>0.95, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="interpolateScale">true</Set>
          <Random name="initialScale" min="0.25" max="0.75" />
          <Set name="finalScale">0, 0</Set>
          <Random name="lifeTime" min="1" max="1.5" />
          <Select name="initialRotationRate" input="randomNumber">
            <Item>-720</Item>
            <Item>-360</Item>
            <Item>360</Item>
            <Item>720</Item>
          </Select>
          <Set name="isBackgroundParticle">true</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <RenderInFront>
      <StopIf>
        <IsItemTransformed>false</IsItemTransformed>
      </StopIf>
      <SpriteRender name="s_death" alignment="CENTER" offset="0,-8" onState="IsDying.True" />
    </RenderInFront>
    <RenderChestItem>
      <SpriteRender name="s_pendant" alignment="DOWN_CENTER" />
    </RenderChestItem>
    <RenderTransform>
      <ParticleSystemRender name="ps_killedAnim"/>
      <StopIf>
        <IsAction>DIE</IsAction>
      </StopIf>
      <SpriteRender name="s_transform" blend="PREMULTIPLIED_ALPHA" offset="0,-8" />
    </RenderTransform>
    <OnDamagedTile>
      <StopIf>
        <IsItemTransformed>false</IsItemTransformed>
      </StopIf>
    </OnDamagedTile>
    <OnDestroyedTile>
      <StopIf>
        <IsItemTransformed>false</IsItemTransformed>
      </StopIf>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<Resources>
	<String id="[TEST_TITLE]">`6Growtopia``</String>
	<String id="[TEST_TEXT]">`3line 1``
	`5line 2
	`7line 3````</String>
	<String id="[TEST_BTN1]">Cancel</String>
	<String id="[TEST_BTN2]">Ok</String>
	<String id="[TEST_DESCR]">Descr str</String>
	<String id="[FEATURE_WELCOME_TITLE]">You've got `2Grow-Mail``!</String>
	<String id="[FEATURE_WELCOME_DESCR]">Join the fun with your fellow Growtopians!</String>
	<String id="[FEATURE_WELCOME_BODY]">
		`oThe `2Mailbox`` has arrived! Sealed with fun, stamped with surprises, and always first-class!
		&nbsp;
		&nbsp;
		Hey there, Growtopian!
		Introducing the brand-new `2Mailbox``, your all-in-one hub for `wofficial messages`` and `8surprise rewards`` from the `6Growtopia Team``!
		&nbsp;
		&nbsp;
		Whether it's a nifty `5gift``, a `4system update``, or a little something just because - it'll all be delivered straight to your `2Mailbox``! No more missed messages, no more reward rush! Each message or reward comes with an expiry timer, so you can grab them when you feel ready (just make sure you've got some inventory space before claiming, nobody likes a packed pocket!).
		&nbsp;
		And don't worry, this box is strictly business (no Growtopian fan mails just yet).
		&nbsp;
		So what are you waiting for? Pop open your `2Mailbox`` and see what's inside! Who knows what surprises are envelope-ing you!?
		&nbsp;
		Signed, Sealed, Delivered - it's all yours!
		&nbsp;
		~ `6The Growtopia Team```
	</String>

  <!--FashionShow Bouncer Strings-->
  <String id="[BOUNCER_POPUP_UI_DESC]">Welcome to Growtopia's Fashion Show!</String>
  <String id="[BOUNCER_POPUP_UI_THEME_TEXT]">Theme for the next show: `#{}``</String>
  <String id="[BOUNCER_POPUP_UI_CURRENT_THEME_TEXT]">Theme: `#{}``</String>
  <String id="[BOUNCER_POPUP_UI_TICKET_COUNT]">Fashion Show Tickets: {}</String>
  <String id="[BOUNCER_POPUP_UI_TICKET_COUNT_RED]">Fashion Show Tickets: `4{}``</String>
  <String id="[BOUNCER_POPUP_UI_ACTIVE_ROUND_WARNING]">There is an active Fashion Show in progress. Go to the Voting Ballots to vote for who you think best matches the theme: `#{}``</String>
  <String id="[BOUNCER_POPUP_UI_ACTIVE_ROUND_WARNING_SECOND_LINE]">If you'd like to participate in one, come back when this one is over.</String>
  <String id="[BOUNCER_POPUP_UI_LEVEL_AND_PLAYTIME_ERROR]">If you would like to participate, you must be Level {} and you must have been a Growtopian for {} days.</String>
  <String id="[BOUNCER_POPUP_UI_EQUIPMENT_ERROR]">Looks like you don't have enough clothes to take part in the fashion show.
	  &nbsp;
	  You must wear at least {} different items to participate.
  </String>
  <String id="[BOUNCER_POPUP_UI_DISCLAIMER_TEXT]">
	Note: You will be entering with the clothes you are currently wearing. &nbsp; 
	You won't be able to change clothes until the end of the show.
  </String>
  <String id="[VOTING_POPUP_DE_ACTIVE_UI_TEXT]">Which participant would you like to vote for?</String>
  <String id="[VOTING_POPUP_ACTIVE_UI_TEXT]">Which participant would you like to vote for?</String>>
  <String id="[VOTING_POPUP_ALREADY_VOTED_WARNING]">You already have voted for a player in this show, if you vote again then your previous vote gets removed.</String>>
  
	<!--************************-->
  <!--Wardrobe Feature Strings-->
  
  <String id="[WARDROBE_MAIN_UNEQUIP_BTN]">Unequip All</String>
  <String id="[WARDROBE_MAIN_SAVE_BTN]">Save Outfit</String>
  <String id="[WARDROBE_MAIN_LOAD_BTN]">Load Outfit</String>
  <String id="[WARDROBE_MAIN_ERROR_MSG]">You can't change clothes as you are currently participating in a Fashion Show.</String>
  
  <String id="[WARDROBE_SAVE_UI_DESC]">Pick a preset to save your outfit to. Make sure you don't overwrite the one you want to keep.</String>
  <String id="[WARDROBE_SAVE_UI_BTN_1]">Save as Outfit 1</String>
  <String id="[WARDROBE_SAVE_UI_BTN_2]">Save as Outfit 2</String>
  
  <String id="[WARDROBE_LOAD_UI_DESC]">Equip a saved preset. This will only equip items that are also in your inventory.</String>
  <String id="[WARDROBE_LOAD_UI_WARNING]">Note: There is clothing in your saved outfits that is not in your inventory. Choosing to equip the outfit will ignore that clothing.</String>
  <String id="[WARDROBE_LOAD_UI_BTN_1]">Equip Outfit 1</String>
  <String id="[WARDROBE_LOAD_UI_BTN_2]">Equip Outfit 2</String>
  
  
  <String id="[WARDROBE_CHANGE_UI_DESC]">Pick which {} item you want your Growtopian to wear.</String>
  
  <!--************************-->

	<!--Auction Block-->
	<String id="[AUC_BLOCK_SETUP_DESCRIPTION]">Sell your items through auction. Once the auction starts you will not be able to cancel the auction. When the auction ends, whatever the final bid ends up being will be the sale price so choose your starting bid carefully.&#10; </String>
	<String id="[AUC_BLOCK_SETUP_INCOMPLETE]">You need to fill all the above sections before you can begin this auction.</String>
	<String id="[AUC_BLOCK_SETUP_INVALID_ITEM]">That item can't be sold at auction! Please try another item.</String>
	<String id="[AUC_BLOCK_NON_OWNER_SETUP]">Only the owner can setup the auction.</String>
	<String id="[AUC_BLOCK_BID_DESCRIPTION]">Buy items through this auction block.&#10;&#10;Place your bids but remember, the final bid when the auction ends will be the sale price so choose your bid carefully. Once placed you can't withdraw your bid until the auction ends.&#10; </String>
	<String id="[AUC_BLOCK_BID_OWNER]">&#10;The owner can't bid on their own auction.</String>
	<String id="[AUC_BLOCK_BID_NONE]">No Bid Placed</String>
	<String id="[AUC_MAIN_UI_DESC]">There {} currently `5{}`` auction{}{}.</String>
	

	<String id="[mail_auctionfail_title]">Auction Failed!</String>
	<String id="[mail_auctionfail_desc]">There were no bids for your `2{}`` in {}.</String>
	<String id="[mail_auctionfail_body]">There were no bids for your auction.&#10;&#10;`2 {}`` was not sold in {}.&#10;&#10;Reclaim your item now.</String>
	<String id="[mail_auctionsuccess_title]">Auction Won!</String>
	<String id="[mail_auctionsuccess_desc]">`2 {}`` bought for `5{} WL``!</String>
	<String id="[mail_auctionsuccess_body]">You were the winning bid for the`2{}`` in {}.&#10;&#10;`5{} WL`` have been transferred from your World Lock Bank to the Seller.&#10;&#10;Claim your item now.</String>
	<String id="[mail_auctionsuccessowner_title]">Auction Item Sold!</String>
	<String id="[mail_auctionsuccessowner_desc]">`2{}`` was successfully sold for `5{} WL`` in {}.</String>
	<String id="[mail_auctionsuccessowner_body]">`2{}`` was successfully sold for `5{} WL`` in {}.&#10;&#10;The world locks have been added to your World Lock Bank.</String>
	<String id="[mail_auctionfailbidder_title]">Auction Ended!</String>
	<String id="[mail_auctionfailbidder_desc]">You were not the winning bid.</String>
	<String id="[mail_auctionfailbidder_body]">You were not the winning bid.&#10;&#10;`5{} WL`` have been unblocked in your World Lock Bank for use in another auction.</String>
	
	<String id="[mail_mailharv2025_body]">Hey Growtopian,&#10; &#10;`8HarvestFest`` is here‚Äîjump in today to harvest trees under the moonlight, gather Mooncakes & Songpyeons, and craft them into festive treasures! &#10;It's the season to celebrate together and enjoy one of Growtopia's most cherished traditions.  This year, don't miss the exclusive Gromoji's Little Partner‚Äîonly during HarvestFest! &#10;Need an extra boost? Use Mooncake Magnificence to increase your Mooncake drops!&#10;Or create your very own harvest world with Harvest Blast, filled with 99 random trees and even rare Cherry Blossoms for Purity Mooncakes! &#10;&#10;`2We've prepared a little gift to kick things off‚Äîenjoy the Harvest moon and start celebrating today! ``&#10; &#10;Growtopia Team</String>
	<String id="[mail_mailharv2025_title]">A Gift Awaits You This HarvestFest</String>
	<String id="[mail_mailharv2025_desc]">Jump in now, harvest trees, and discover new surprises‚Äîonly during this year's festival!</String>

	<String id="[mail_fashion2025_body]">Dear Growtopian,&#10;&#10;As the curtains close on `5Growtopia Fashion Weekend``, we celebrate you - the star who brought flair and imagination to the runway.&#10;&#10;To honor your unique style, we're delighted to present the `2Glamorous Crown``. `1Perfect for a Mr. Growtopia or Miss Growtopia``, it's a sparkling reminder that fashion is more than looks - `eit's how you Express in Style``.&#10;&#10;Stay Stylish,&#10;The Growtopia Team</String>
	<String id="[mail_fashion2025_title]">A Crown for a Star</String>
	<String id="[mail_fashion2025_desc]">Your Glamorous Crown Awaits - Express in Style</String>
	
	<String id="[mail_wonder2025_body]">Hi Growtopians,&#10;&#10;Haven't joined `5Wonder Week`` yet? Now's your chance! We're giving you`2 5 FREE Wonder Providers``, so you can dive right in.&#10;&#10;Every day this week, a new Store item awaits, tied to fun Growtopia activities. And for even rarer finds, the Chest of Wonders guarantees 1 wonder from past years.&#10;&#10;Use your free `2Wonder Providers`` - explore Wonder Week today!&#10;&#10;Growtopia Team</String>
	<String id="[mail_wonder2025_title]">Discover Wonder Week with Free Gifts!</String>
	<String id="[mail_wonder2025_desc]">5 Wonder Providers inside - claim now!</String>
	
	<String id="[mail_livestreamrewards_body]">Hi Growtopians,&#10;&#10;We loved spending time with you! &#10;Enjoy your reward and see you soon!&#10;&#10;Growtopia Team</String>
	<String id="[mail_livestreamrewards_title]">Thanks for Joining Growtopia Live! </String>
	<String id="[mail_livestreamrewards_desc]">Rewards inside</String>
	
	<String id="[mail_dungeons2025_body]">Hi Growtopians,&#10;&#10;The Dungeons have changed-new boss, new powers, new dangers! Use the exclusive code `4DNMAGIC25`` to claim 70 Scrolls, power up your strength, and confront the mysterious `qMagic Crystal Ball Boss``! Sharpen your skills and conquer the challenge before it's too late!&#10;&#10;The Growtopia Team</String>
	<String id="[mail_dungeons2025_title]">A New Dungeon Challenge Awaits! Code inside!</String>
	<String id="[mail_dungeons2025_desc]">Take your 70 Scrolls and dive in!</String>
	
	<String id="[mail_halloween2025_body]">Hi Growtopians,&#10;&#10;The Dark King calls once more! Venture into the `8Tomb of Growganoth``, brave vanishing platforms, and make your offerings to the `8Maw`` for haunting treasures. Use your `2Dark Tickets, Sigils``, and `2Dark King's Offerings`` to begin your ritual-and don't forget your `2Fashion Show Tickets`` to celebrate in spooky style. The shadows won't wait forever!&#10;&#10;The Growtopia Team</String>
	<String id="[mail_halloween2025_title]">The Dark King Awaits Your Tribute!</String>
	<String id="[mail_halloween2025_desc]">Claim gifts and face Growganoth's wrath!</String>

	<String id="[SEED_DIARY_PAGE]">Page {}/{}</String>
	<String id="[SEED_DIARY_DISCOVERED]">`oDiscovered: `` `5{}/{}``</String>
	<String id="[SEED_DIARY_GROWN]">`oPlanted: `` `5{}/{}``</String>
	<String id="[SEED_DIARY_MAKE_INFO]">`oSeed can be used to make:``</String>
	<String id="[SEED_DIARY_NO_SELECT_INFO]">Select an item to view details.</String>
	<String id="[SEED_DIARY_NO_ITEMS_INFO_1]">`wNo items discovered.``</String>
	<String id="[SEED_DIARY_NO_ITEMS_INFO_2]">Collect `5items`` or `5seeds`` to reveal more items.</String>

	<String id="[mail_thanksgiving2025_body]">Hi Growtopians,&#10;&#10;The worlds are filling with Turkeys and rewards - come join the fun! Ring your Bell, gather Turkeys, and take on Sgt. Stuffins for exclusive treasures. &#10;Redeem code `2THXGIVING25GT-A`` to pick up your free Organic Turkey, Turkey Sucker, and Thanksgiving Bell. Jump in and celebrate the season with everyone!&#10;&#10;The Growtopia Team</String>
	<String id="[mail_thanksgiving2025_title]">Thanksgiving Gift code Inside!</String>
	<String id="[mail_thanksgiving2025_desc]">Grab your gifts and join the hunt!</String>
	
	<String id="[mail_winterfest2025_body]">Hey Growtopians,&#10;&#10;WinterFest 2025 is finally here, and we wanted to send a little cheer your way- WinterFest Calendar 2025,  Deluxe WinterFest Cracker, WinterFest Cracker, and Snowball to get you in the spirit. &#10;&#10;Jump in, work on your Wish List and Bingo Card, and help warm up the Growch's heart for extra goodies. Come celebrate with us and make this WinterFest a cozy one!&#10;&#10;The Growtopia Team</String>
	<String id="[mail_winterfest2025_title]">Your WinterFest Gifts Are Here!</String>
	<String id="[mail_winterfest2025_desc]">Celebrate with rewards and join the fun!</String>

	
</Resources><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer NPCType="Axebeak">
	<Data>
		<Sprite name="s_sprite" fileName="game/npc2.rttex" textureSize="64" frame="10,0"/>
		<Sprite name="s_HitEffect" fileName="game/particles.rttex" textureSize="32" frame="10,9" />
		<Sprite name="s_curvedFeather" fileName="game/particles5.rttex" textureSize="32" frame="6,6"/>
		<Sprite name="slash_sprite" fileName="game/npc1.rttex" textureSize="32" frame="12,7"/>

		<Animations>
			<SpriteAnimation name="patrol" sprite="s_sprite" isLoop="true" animTime="400" autoPlay="false" playOnState="NPC.Patrol">
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
				<Frame>12,0</Frame>
				<Frame>13,0</Frame>
				<Frame>14,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="chase" sprite="s_sprite" isLoop="true" animTime="400" autoPlay="false" playOnState="NPC.Chase|NPC.AttackProjectile">
				<Frame>10,1</Frame>
				<Frame>11,1</Frame>
				<Frame>12,1</Frame>
				<Frame>13,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="jump" sprite="s_sprite" isLoop="false" animTime="50" autoPlay="false" playOnState="NPC.Jump">
				<Frame>14,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="fall" sprite="s_sprite" isLoop="false" animTime="50" autoPlay="false" playOnState="NPC.Fall">
				<Frame>15,1</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="feather" sprite="s_curvedFeather" isLoop="false" animTime="50" autoPlay="false">
				<Frame>6,6</Frame>
				<Frame>7,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="slash_anim" sprite="slash_sprite" animTime="800">
				<Frame>12,7</Frame>
				<Frame>13,7</Frame>
				<Frame>14,7</Frame>
				<Frame>15,7</Frame>
				<Frame>16,7</Frame>
				<Frame>17,7</Frame>
				<Frame>18,7</Frame>
				<Frame>19,7</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="fireParticle1" updateStage="Update" updateState="NPC.AttackProjectile">
				<Emitter>
					<Set name="offset">16,4</Set>
					<Set name="emissionInterval">0.6</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offsetFacing">true</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">slash_sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="collisionDamageAmount">40</Set>
					<Set name="destroyOnCollision">false</Set>
					<Set name="collisionSize">32,32</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="initialScale">1.5,1</Set>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_destroyFeathers" updateStage="OnDie">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">50</Set>
					<Set name="offset">0,0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="-10,-10" max="10.2,10.1"/>
					<Set name="sprite">s_curvedFeather</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 30</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Random name="flipX" min="false" max="true"/>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Curve name="initialAngle">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -15</KeyFrame>
						<KeyFrame>0.4, 15</KeyFrame>
						<KeyFrame>0.6, -15</KeyFrame>
						<KeyFrame>0.8, 15</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Curve name="initialVelocity">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -40, 0</KeyFrame>
						<KeyFrame>0.4, 50, 0</KeyFrame>
						<KeyFrame>0.6, -50, 0</KeyFrame>
						<KeyFrame>0.8, 50, 0</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="NPC" ServerOnly="true">
				<States start="Patrol">
					<NPCPlatformPatrol name="Patrol">
						<PatrolSpeed>100</PatrolSpeed>
						<DisableFall>false</DisableFall>
					</NPCPlatformPatrol>
					<NPCPlatformChase name="Chase">
						<ChaseSpeed>100</ChaseSpeed>
						<DisableFall>false</DisableFall>
					</NPCPlatformChase>
					<NPCPlatformChase name="AttackProjectile" ExitTime="1">
						<ChaseSpeed>100</ChaseSpeed>
						<DisableFall>false</DisableFall>
					</NPCPlatformChase>					
					<NPCPlatformJump name="Jump" ExitTime="0.4">
						<JumpHeight>65</JumpHeight>
					</NPCPlatformJump>
					<NPCFall name="Fall" ExitTime="0.33"/>
				</States>
				<Transitions>
					<Transition to="Fall" from="Patrol|Chase|Jump">
						<Condition>
							<IsOnGround>false</IsOnGround>
						</Condition>
					</Transition>
					<Transition to="Chase" from="Patrol|Jump|Fall|AttackProjectile">
						<Condition type="and">
							<IsOnGround>true</IsOnGround>
							<CheckNPCVelocity ComparisonElement="Y" operatorType="Less" abs="true">0.1</CheckNPCVelocity>
							<IsPlayerDistanceMatching operatorType="Less">128</IsPlayerDistanceMatching>
							<IsPlayerDistanceMatching operatorType="Greater">32</IsPlayerDistanceMatching>
						</Condition>
					</Transition>					
					<Transition to="Patrol" from="Chase|Jump|Fall|AttackProjectile">
						<Condition type="and">
							<IsOnGround>true</IsOnGround>
							<IsPlayerDistanceMatching operatorType="Greater">128</IsPlayerDistanceMatching>
						</Condition>
					</Transition>								
					<Transition to="AttackProjectile" from="Patrol|Chase|Jump|Fall|AttackProjectile">
						<Condition>
							<IsPlayerDistanceMatching operatorType="LessOrEqual">48</IsPlayerDistanceMatching>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Chase">
						<Condition type="or">
							<SubCondition type="and">
								<CheckRandomRangeNumber EndNumber="2">0</CheckRandomRangeNumber>
								<IsPlayerDistanceMatching operatorType="Less">96</IsPlayerDistanceMatching>
								<CheckTimer ResetOnSuccess="true" name="timeToJump">true</CheckTimer>
							</SubCondition>
							<SubCondition type="and">
								<IsPlayerDistanceMatching operatorType="Less">128</IsPlayerDistanceMatching>
								<CheckTimer ResetOnSuccess="true" name="timeToJump">true</CheckTimer>
								<IsCollidableBetweenPoint Width="8" TargetOffset="0, -32">false</IsCollidableBetweenPoint>
								<SubCondition type="or">
									<SubCondition type="and">
										<IsCollidableBetweenTarget Width="8">true</IsCollidableBetweenTarget>
										<IsPlayerDistanceMatching operatorType="Greater">45</IsPlayerDistanceMatching>
									</SubCondition>
									<CheckPositionDifferenceToPlayer UseVertical="true" operatorType="Less">-16</CheckPositionDifferenceToPlayer>
								</SubCondition>
							</SubCondition>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Components>
			<Info/>
			<MustKillNPC/>
			<AttachmentSlotsCmp/>
			<TintOverrideCmp/>
			<StateMachineTimer>
				<Set name="timeToJump">2</Set>
			</StateMachineTimer>			
			<Enemy>
				<Set name="SoulsReward">8</Set>
				<Set name="destroyTileId">15418</Set>
			</Enemy>
			<Movement/>
			<Damage>
				<Set name="damage">10</Set>
			</Damage>
			<NPCRenderActionCmp/>
			<StateMachine/>d
			<Health>
				<Set name="healthAmount">400</Set>
				<Set name="maxHealth">400</Set>
			</Health>
			<Physics>
				<Set name="acceleration">0, 9.81</Set>
				<Set name="mass">40</Set>
				<Set name="drag">0.6, 0</Set>
			</Physics>
			<CollisionBox>
				<Set name="size">30,62</Set>
				<Set name="CollisionFlag">"PLAYERS|PROJECTILES"</Set>
				<Set name="CollisionType">"ENEMY_NPC"</Set>
			</CollisionBox>
			<DebugDraw/>
		</Components>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_sprite" offset="0,-1"/>
		</Render>		
		<RenderInFront>
			<Translate>0,-4,0</Translate>
			<NPCHealthBarRender TexturePath="interface/large/gui_event_npchealth_bar.rttex" TextureSize="17,9" TextureCoordinates="0,0"/>
		</RenderInFront>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="fireParticle1"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer NPCType="AxebeaksBoss">
	<Data>
		<Sprite name="sprite" fileName="game/bb_page3.rttex" textureSize="128" frame="0,0"/>
		<Sprite name="axebeakboss_sprite" fileName="game/bb_page3.rttex" textureSize="128" frame="4,1"/>
		<Sprite name="trail_sprite" fileName="game/npc1.rttex" textureSize="32" frame="30,6"/>
		<Sprite name="s_HitEffect" fileName="game/particles.rttex" textureSize="32" frame="10,9" />
		<Sprite name="windFeetSprite" fileName="game/npc1.rttex" textureSize="32"/>
		<Sprite name="s_curvedFeather" fileName="game/particles5.rttex" textureSize="32" frame="6,6"/>
		<Sprite name="speedLinesSprite" fileName="game/particles11.rttex" textureSize="32" frame="20,11"/>
		<StateMachines>
			<StateMachine name="NPC" ServerOnly="true">
				<States start="Patrol">
					<NPCStationary name="Stationary" ExitTime="0.1"/>
					<NPCSteerAwayPlatform name="TurnYourBackToPlayer" IsTemporary="true">
						<Speed>10</Speed>
					</NPCSteerAwayPlatform>					
					<NPCPlatformChase name="Patrol" ExitTime="3">
						<ChaseSpeed>125</ChaseSpeed>
						<DisableFall>false</DisableFall>
					</NPCPlatformChase>
					<NPCPlatformDash name="Dash" ExitTime="0.8">
						<DashVelocity>800, -10</DashVelocity>
						<UsePlayerPosition>true</UsePlayerPosition>
					</NPCPlatformDash>
					<NPCPlatformJump name="Jump" ExitTime="0.5">
						<JumpHeight>450</JumpHeight>
					</NPCPlatformJump>			
					<NPCFlyingDash name="DashTopLeft">
						<DashVelocity>-400, 0</DashVelocity>
					</NPCFlyingDash>
					<NPCFlyingDash name="DashTopRight">
						<DashVelocity>400, 0</DashVelocity>
					</NPCFlyingDash>
					<NPCRandomRangeInteger name="DashSideSelection" IsTemporary="true">
						<CounterName>"DashSideSelection"</CounterName>
						<Min>0</Min>
						<Max>2</Max>
					</NPCRandomRangeInteger>					
					<NPCRandomRangeInteger name="AbilitySelection" IsTemporary="true">
						<CounterName>"AbilitySelection"</CounterName>
						<Min>0</Min>
						<Max>3</Max>
					</NPCRandomRangeInteger>
					<NPCPlatformSpawnParticlesWithMinions name="SpawnParticlesWithMinions" ExitTime="0.4">
						<ProjectileName>"AxebeakBossEggProjectile"</ProjectileName>
					</NPCPlatformSpawnParticlesWithMinions>
					<NPCSetPhysicsComponent name="DisableGravity" IsTemporary="true">
						<Gravity>0, 0</Gravity>
						<Drag>1, 0</Drag>
					</NPCSetPhysicsComponent>
					<NPCSetPhysicsComponent name="EnableGravity" IsTemporary="true">
						<Gravity>0, 9.81</Gravity>
						<Drag>0.5, 0</Drag>
					</NPCSetPhysicsComponent>
					<NPCPlatformDash name="DashDiagonal">
						<DashVelocity>900, 450</DashVelocity>
						<UsePlayerPosition>true</UsePlayerPosition>
						<ClampX>false</ClampX>
					</NPCPlatformDash>
					<NPCAnticipation name="AnticipationDash" ExitTime="1"/>
					<NPCAnticipation name="AnticipationLeap" ExitTime="1"/>
					<NPCAnticipation name="AnticipationFire" ExitTime="1"/>
				</States>
				<Transitions>
					<Transition to="Patrol" from="SpawnParticlesWithMinions|EnableGravity"/>
					<Transition to="Patrol" from="Dash">
						<Condition type="or">
							<CheckNPCVelocity ComparisonElement="X" operatorType="LessOrEqual" abs="true">10</CheckNPCVelocity>
							<IsCollidableBetweenPoint Width="32" TargetOffset="100, 0">true</IsCollidableBetweenPoint>
							<IsCollidableBetweenPoint Width="32" TargetOffset="-100, 0">true</IsCollidableBetweenPoint>	
						</Condition>
					</Transition>
					<Transition to="AbilitySelection" from="Patrol"/>
					
					<Transition to="AnticipationDash" from="AbilitySelection">
						<Condition>
							<CheckCounter ResetOnSuccess="false" operatorType="Equal" name="AbilitySelection">0</CheckCounter>
						</Condition>
					</Transition>
					<Transition to="TurnYourBackToPlayer" from="AbilitySelection">
						<Condition>
							<CheckCounter ResetOnSuccess="false" operatorType="Equal" name="AbilitySelection">1</CheckCounter>
						</Condition>aw
					</Transition>
					<Transition to="AnticipationLeap" from="AbilitySelection">
						<Condition>
							<CheckCounter ResetOnSuccess="false" operatorType="Equal" name="AbilitySelection">2</CheckCounter>
						</Condition>
					</Transition>
					<Transition to="Dash" from="AnticipationDash"/>
					
					<Transition to="AnticipationFire" from="TurnYourBackToPlayer"/>
					<Transition to="SpawnParticlesWithMinions" from="AnticipationFire"/>

					<Transition to="Jump" from="AnticipationLeap"/>
					<Transition to="DisableGravity" from="Jump"/>
					<Transition to="DashSideSelection" from="DisableGravity"/>
			
					<Transition to="DashTopLeft" from="DashSideSelection">
						<Condition>
							<CheckCounter ResetOnSuccess="false" operatorType="Equal" name="DashSideSelection">0</CheckCounter>
						</Condition>
					</Transition>
					<Transition to="DashTopRight" from="DashSideSelection">
						<Condition>
							<CheckCounter ResetOnSuccess="false" operatorType="Equal" name="DashSideSelection">1</CheckCounter>
						</Condition>
					</Transition>
					<Transition to="Stationary" from="DashTopLeft">
						<Condition>
							<IsCollidableBetweenPoint Width="32" TargetOffset="-110, 0">true</IsCollidableBetweenPoint>
						</Condition>
					</Transition>
					<Transition to="Stationary" from="DashTopRight">
						<Condition>
							<IsCollidableBetweenPoint Width="32" TargetOffset="110, 0">true</IsCollidableBetweenPoint>
						</Condition>
					</Transition>
					<Transition to="DashDiagonal" from="Stationary"/>
					<Transition to="EnableGravity" from="DashDiagonal">
						<Condition type="or">
							<CheckNPCVelocity ComparisonElement="X" operatorType="LessOrEqual" abs="true">10</CheckNPCVelocity>
							<IsCollidableBetweenPoint Width="8" TargetOffset="100, 0">true</IsCollidableBetweenPoint>
							<IsCollidableBetweenPoint Width="8" TargetOffset="-100, 0">true</IsCollidableBetweenPoint>	
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="slash_anim" sprite="sprite" animTime="400" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="feather" sprite="s_curvedFeather" isLoop="false" animTime="50" autoPlay="false">
				<Frame>6,6</Frame>
				<Frame>7,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="windFeetAnimation" isLoop="true" autoPlay="true" sprite="windFeetSprite" animTime="800">
				<Frame>0,10</Frame>
				<Frame>1,10</Frame>
				<Frame>2,10</Frame>
				<Frame>3,10</Frame>
				<Frame>4,10</Frame>
				<Frame>5,10</Frame>
				<Frame>6,10</Frame>
				<Frame>7,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sprite_anticipation_dash" playOnState="NPC.AnticipationDash" sprite="axebeakboss_sprite" isLoop="false" animTime="1000">
				<Frame>0, 4</Frame>
				<Frame>1, 4</Frame>
				<Frame>2, 4</Frame>
				<Frame>3, 4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sprite_anticipation_leap" playOnState="NPC.AnticipationLeap" sprite="axebeakboss_sprite" isLoop="false" animTime="1000">
				<Frame>0, 5</Frame>
				<Frame>1, 5</Frame>
				<Frame>2, 5</Frame>
				<Frame>3, 5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sprite_jump_attack" playOnState="NPC.Jump" sprite="axebeakboss_sprite" isLoop="true" animTime="50">
				<Frame>7, 3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sprite_dash_attack" playOnState="NPC.Dash|NPC.Patrol" sprite="axebeakboss_sprite" isLoop="true" animTime="400">
				<Frame>4, 4</Frame>
				<Frame>5, 4</Frame>
				<Frame>6, 4</Frame>
				<Frame>7, 4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sprite_flying_dash_attack" playOnState="NPC.DashDiagonal|NPC.DashTopLeft|NPC.DashTopRight|NPC.Stationary" sprite="axebeakboss_sprite" isLoop="true" animTime="400">
				<Frame>4, 5</Frame>
				<Frame>5, 5</Frame>
				<Frame>6, 5</Frame>
				<Frame>7, 5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sprite_anticipation_fire" playOnState="NPC.AnticipationFire" sprite="axebeakboss_sprite" isLoop="false" animTime="1000">
				<Frame>0, 6</Frame>
				<Frame>1, 6</Frame>
				<Frame>2, 6</Frame>
				<Frame>3, 6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sprite_fire_attack" playOnState="NPC.SpawnParticlesWithMinions" sprite="axebeakboss_sprite" isLoop="false" animTime="400">
				<Frame>4, 6</Frame>
				<Frame>5, 6</Frame>
				<Frame>6, 6</Frame>
				<Frame>7, 6</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="speedLinesParticle">
				<Emitter>
					<Random name="offset" min="0,-28" max="0,42.1"/>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.3</Set>
					<Set name="intervalMax">0.7</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offsetFacing">true</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">speedLinesSprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.4</KeyFrame>
						<KeyFrame>0.2, 0.4</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0,0,0</KeyFrame>
						<KeyFrame>0.2,4,1.2</KeyFrame>
						<KeyFrame>1,8,1.2</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.3" max="1"/>
					<Set name="initialVelocity">-10,0</Set>
					<Multiply name="offset" source="initialVelocity" scale="0.1,0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_destroyFeathers" updateStage="OnDamaged">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">8</Set>
					<Set name="offset">0,0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="-10,-10" max="10.2,10.1"/>
					<Set name="sprite">s_curvedFeather</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 30</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Random name="flipX" min="false" max="true"/>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Curve name="initialAngle">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -15</KeyFrame>
						<KeyFrame>0.4, 15</KeyFrame>
						<KeyFrame>0.6, -15</KeyFrame>
						<KeyFrame>0.8, 15</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Curve name="initialVelocity">
						<KeyFrame>0, 0w</KeyFrame>
						<KeyFrame>0.2, -40, 0</KeyFrame>
						<KeyFrame>0.4, 50, 0</KeyFrame>
						<KeyFrame>0.6, -50, 0</KeyFrame>
						<KeyFrame>0.8, 50, 0</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="fireParticle1" updateStage="Update" updateState="NPC.Dash">
				<Emitter>
					<Set name="offset">8,0</Set>
					<Set name="emissionInterval">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offsetFacing">true</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="collisionDamageAmount">5</Set>
					<Set name="destroyOnCollision">false</Set>
					<Set name="collisionSize">128,96</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="collisionType">
						<CollisionType>PROJECTILES_ENEMY</CollisionType>
					</Set>
					<Set name="collisionFlag">
						<CollisionFlag>PLAYERS</CollisionFlag>
					</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<Components>
			<Info/>
			<MustKillNPC/>
			<AttachmentSlotsCmp/>
			<TintOverrideCmp/>
			<IsBossNPC>
				<Set name="displayName">"Dual Axebeaks"</Set>
			</IsBossNPC>
			<StateMachineCounter>
				<Set name="AbilitySelection">0</Set>
				<Set name="DashSideSelection">0</Set>
			</StateMachineCounter>
			<Enemy>
				<Set name="SoulsReward">200</Set>
				<Set name="destroyTileId">15418</Set>
			</Enemy>
			<Movement/>
			<Damage>
				<Set name="damage">20</Set>
			</Damage>
			<NPCRenderActionCmp/>
			<StateMachine/>
			<Physics>
				<Set name="acceleration">0, 9.81</Set>
				<Set name="mass">75</Set>
				<Set name="drag">0.5, 0</Set>
			</Physics>
			<Health>
				<Set name="healthAmount">20000</Set>
				<Set name="maxHealth">20000</Set>
			</Health>
			<CollisionBox>
				<Set name="size">128,96</Set>
				<Set name="CollisionFlag">"PLAYERS|PROJECTILES"</Set>
				<Set name="CollisionType">"ENEMY_NPC"</Set>
			</CollisionBox>
			<DebugDraw/>
		</Components>
	</Data>
	<RenderRules>
		<Render>
			<Translate>0,-16,0</Translate>
			<SpriteRender name="axebeakboss_sprite"/>
		</Render>
		<Update>
			<Translate>0,-16,0</Translate>
			<ParticleSystemUpdate name="speedLinesParticle" onState="NPC.DashDiagonal|NPC.DashTopLeft|NPC.DashTopRight"/>
		</Update>
		<RenderInFront>
			<Translate>0,-32,0</Translate>
			<NPCHealthBarRender TexturePath="interface/large/gui_event_npchealth_bar.rttex" TextureSize="17,9" TextureCoordinates="0,0"/>
		</RenderInFront>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="fireParticle1"/>
			<ParticleSystemOff name="speedLinesParticle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer NPCType="BladeofRevolt" NPCTypeID="0">
	<Data>
		<Sprite name="s_sprite" fileName="game/particles11.rttex" textureSize="32" frame="8,24" />
		<Sprite name="s_sprite_glow" fileName="game/particles11.rttex" textureSize="32" frame="9,24" />
		<Sprite name="s_HitEffect" fileName="game/particles9.rttex" textureSize="32" frame="12,0" />
		<Animations>
			<SpriteCurveAnimation name="s_sprite_glow" isLoop="true" autoPlay="true" sprite="s_sprite_glow" animTime="100" playOnState="NPC.Chase">
				<Curve name="alpha">
					<KeyFrame>0.f, 1.f</KeyFrame>
					<KeyFrame>0.2f, 1.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 1.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="s_sprite_glow_fade" isLoop="true" autoPlay="true" sprite="s_sprite_glow" animTime="100" playOnState="NPC.FlyPatrol">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 0.f</KeyFrame>
					<KeyFrame>0.8f, 0.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<CurveAnimationVec3 name="anim_hover" autoPlay="false" isLoop="true" animTime="2000" playOnState="NPC.FlyPatrol" >
				<Curve name="position">
					<KeyFrame>0, 0, 0, 0</KeyFrame>
					<KeyFrame>0.5, 0, -16, 0</KeyFrame>
					<KeyFrame>1, 0, 0, 0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="anim_normal" autoPlay="false" isLoop="true" animTime="1" playOnState="NPC.Chase|NPC.AttackProjectile" >
				<Curve name="position">
					<KeyFrame>0, 0, 0, 0</KeyFrame>
					<KeyFrame>0.5, 0, 0, 0</KeyFrame>
					<KeyFrame>1, 0, 0, 0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec4 name="attack_rotate" isLoop="true" playOnState="NPC.AttackProjectile" animTime="460">
				<Curve name="rotation">
					<KeyFrame>0, 0, 0,0,1</KeyFrame>
					<KeyFrame>1, 360, 0,0,1</KeyFrame>
				</Curve>
			</CurveAnimationVec4>			
			<CurveAnimationVec4 name="attack_rotate_patrol" isLoop="true" playOnState="NPC.FlyPatrol|NPC.Chase" animTime="100">
				<Curve name="rotation">
					<KeyFrame>0, 0, 0,0,1</KeyFrame>
					<KeyFrame>1, 0, 0,0,1</KeyFrame>
				</Curve>
			</CurveAnimationVec4>		
		</Animations>
		<StateMachines>
			<StateMachine name="NPC" ServerOnly="true">
				<States start="FlyPatrol">
					<NPCFlyingPatrol name="FlyPatrol">
						<PatrolSpeed>0</PatrolSpeed>
						<PatrolRange>0</PatrolRange>
						<StayHome>false</StayHome>
					</NPCFlyingPatrol>
					<NPCFlyingChase name="Chase">
						<ChaseSpeed>200</ChaseSpeed>
					</NPCFlyingChase>	
					<NPCFlyingAttack name="AttackProjectile" ExitTime="0.5">
						<AttackTimeoutInSeconds>0</AttackTimeoutInSeconds>
						<ProjectileName>"BladeSlash"</ProjectileName>
					</NPCFlyingAttack>
					<NPCAnticipation name="Anticipation" ExitTime="0.25"/>
				</States>
				<Transitions>
					<Transition to="Chase" from="FlyPatrol">
						<Condition type="and">
							<IsPlayerDistanceMatching operatorType="Less">250</IsPlayerDistanceMatching>
							<IsPlayerDistanceMatching operatorType="Greater">40</IsPlayerDistanceMatching>
						</Condition>
					</Transition>	
					<Transition to="Chase" from="AttackProjectile">
						<Condition type="or">
							<IsPlayerDistanceMatching operatorType="Greater">40</IsPlayerDistanceMatching>
							<IsCollidableBetweenTarget Width="8">false</IsCollidableBetweenTarget>
						</Condition>
					</Transition>	
					<Transition to="FlyPatrol" from="Chase|AttackProjectile|Anticipation">
						<Condition>
							<IsPlayerDistanceMatching operatorType="Greater">250</IsPlayerDistanceMatching>
						</Condition>
					</Transition>								
					<Transition to="Anticipation" from="AttackProjectile|Chase">
						<Condition type="and">
							<IsPlayerDistanceMatching operatorType="LessOrEqual">40</IsPlayerDistanceMatching>
							<IsCollidableBetweenTarget Width="8">false</IsCollidableBetweenTarget>
						</Condition>
					</Transition>				
					<Transition to="AttackProjectile" from="Anticipation"/>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_HitEffect" updateStage="OnDamaged">
				<Emitter>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_HitEffect</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.4, 0</KeyFrame>
						<KeyFrame>0.41, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="lifeTime">0.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,90" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<Components>
			<Info/>
			<MustKillNPC/>
			<AttachmentSlotsCmp/>
			<StateMachineTimer/>
			<TintOverrideCmp/>
			<Enemy>
				<Set name="SoulsReward">5</Set>
				<Set name="destroyTileId">186</Set>
			</Enemy>
			<Movement/>
			<Damage>
				<Set name="damage">10</Set>
			</Damage>
			<StateMachine/>
			<NPCRenderActionCmp/>
			<Health>
				<Set name="healthAmount">200</Set>
				<Set name="maxHealth">200</Set>
			</Health>
			<Physics>
				<Set name="acceleration">0, 0</Set>
				<Set name="mass">20</Set>
				<Set name="drag">1.24, 1.25</Set>
			</Physics>
			<CollisionBox>
				<Set name="size">16,32</Set>
				<Set name="CollisionFlag">"PLAYERS|PROJECTILES"</Set>
				<Set name="CollisionType">"ENEMY_NPC"</Set>
			</CollisionBox>
			<DebugDraw/>
		</Components>
		<VariableMap>
			<Set name="position">0, -16, 0</Set>
			<Set name="rotation">0, 0, 0, 1</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<Render>
			<Translate>position</Translate>
			<Rotate>rotation</Rotate>
			<SpriteRender name="s_sprite"/>
			<SpriteRender name="s_sprite_glow"/>
		</Render>
		<RenderInFront>
			<Translate>0,-4,0</Translate>
			<NPCHealthBarRender TexturePath="interface/large/gui_event_npchealth_bar.rttex" TextureSize="17,9" TextureCoordinates="0,0"/>
		</RenderInFront>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
