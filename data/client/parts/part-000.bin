<!-- DM VOW @reeel. for items like this! -->
			</SpriteAnimation>
			<SpriteAnimation name="a_pet_punch" sprite="s_YwachVOW" animTime="400" isLoop="true" playOnState="Pet.Punch" playOnAction="PUNCH">
				<!-- <Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
