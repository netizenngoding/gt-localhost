<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_wings" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="31,14"/>
		<Sprite name="s_strap" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="30,14"/>
		<Sprite name="s_jump" fileName="game/particles12.rttex" textureSize="32" frame="31,22"/>

		<Animations>
			<SpriteAnimation sprite="s_wings" name="a_equip" playOnState="Action.Equip">
				<Frame>31,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation sprite="s_wings" name="a_fall" playOnState="Action.Fall">
				<Frame>29,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation sprite="s_wings" name="a_jump" playOnState="Action.Jump">
				<Frame>31,14</Frame>
			</SpriteAnimation>
		</Animations>

		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="Equip" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Equip" from="Fall|Jump">
						<Condition>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Equip|Fall">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Equip|Jump">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<ParticleSystems>
			<ParticleSystem name="ps_jump" updateStage="AddClothingParticles" updateState="Action.Jump">
				<Emitter>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_jump</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.7</Set>
					<Set name="useGravity">true</Set>
					<Set name="initialScale">1,1</Set>
					<Select name="offset" input="particleIndex">
						<Item>-32,-12</Item>
						<Item>32,-12</Item>
					</Select>
					<Select name="flipX" input="particleIndex">
						<Item>true</Item>
						<Item>false</Item>
					</Select>
					<Select name="initialAngle" input="particleIndex">
						<Item>-70</Item>
						<Item>70</Item>
					</Select>
					<Curve name="initialAlpha">
						<KeyFrame>0,1</KeyFrame>
						<KeyFrame>1,0</KeyFrame>
					</Curve>
					<Select name="initialVelocity" input="particleIndex">
						<Item>-20,70</Item>
						<Item>20,70</Item>
					</Select>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderBackpack>
			<SpriteRender name="s_wings" offset="-4,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
			<SpriteRender name="s_wings" offset="4,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackpack>
		<RenderFrontpack>
			<SpriteRender name="s_strap" alignment="DOWN_CENTER"/>
		</RenderFrontpack>
	</RenderRules>
</ItemRenderer>