				<Frame>3, 1</Frame>
				<Frame>4, 1</Frame>
				<Frame>5, 1</Frame>
				<Frame>6, 1</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="a_sprite_anticipation_dash" playOnState="NPC.AnticipationDash" sprite="jelatinous_sprite" isLoop="false" animTime="800">
				<Frame>0, 6</Frame>
				<Frame>1, 6</Frame>
				<Frame>2, 6</Frame>
				<Frame>3, 6</Frame>
				<Frame>4, 6</Frame>
				<Frame>5, 6</Frame>
