            </SpriteAnimation>
            <SpriteAnimation name="Animation238" sprite="Sprite236" isLoop="true" autoPlay="true" animTime="500">
                <Frame>20,6</Frame>
                <Frame>21,6</Frame>
                <Frame>22,6</Frame>
                <Frame>23,6</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="Animation645" sprite="Sprite643" isLoop="false" autoPlay="false" animTime="500">
