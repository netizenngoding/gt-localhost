			</ParticleSystem>
			<ParticleSystem name="Punch_ghost2" updateStage="RenderBackHandItem" updateState="Action.Punch">
				<Emitter>
					<Random name="offset" min="-4, -4" max="4,-20" />
					<Set name="lifeTime">0.12</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">fasle</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch_ghost</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Random name="targetPosOffset" min="-8, -4" max="0,-12"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.95"/>
					<Set name="initialAngle">90</Set>
					<Set name="initialAlpha">0.3</Set>
					<Set name="flipY" source="punch.flipY"/>
				</Particle>
			</ParticleSystem>			
			<ParticleSystem name="ps_hitFlash">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hitFlash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1.6, 1.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="punch.flipY">false</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<Group onState="Action.None">
				<Translate>0,-7,0</Translate>
				<SpriteRender name="Sprite26_front" drawShadow="true" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
				<SpriteRender name="Sprite26_GLOW_front" drawShadow="false" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
			</Group>
		</RenderHandItem>
		<RenderFrontArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderFrontArm>
		<RenderBackArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">-200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderBackArm>
		<RenderBackHandItem>
			<StopIf>
				<IsAction>BUILD</IsAction>
			</StopIf>
			<Translate>-4,-11.8,0</Translate>
			<Group onState="Action.None">
				<SpriteRender name="Sprite26_back" drawShadow="true" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
			</Group>
		</RenderBackHandItem>
		<OnPunchStart>
			<ArithmethicOperation LeftHandVariableName="punch.flipY" RightHandVariableName="false" OperationType="Set" />
			<StopIf>
				<IsFacingLeft>false</IsFacingLeft>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="punch.flipY" RightHandVariableName="true" OperationType="Set" />
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_hitFlash"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_hitFlash"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wingsLeft" fileName="game/particles_large17.rttex" textureSize="64" frame="4,6" />
    <Sprite name="s_wingsRight" fileName="game/particles_large17.rttex" textureSize="64" frame="4,7" />
    <Sprite name="s_flare" fileName="game/particles_large17.rttex" textureSize="64" frame="9,7" />
    <Sprite name="s_bokeh" fileName="game/particles_large17.rttex" textureSize="64" frame="9,6" />

    <Animations>
      <SpriteAnimation name="a_wingsLeft" sprite="s_wingsLeft">
        <Frame>4,6</Frame>
        <Frame>5,6</Frame>
        <Frame>6,6</Frame>
        <Frame>7,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_wingsRight" sprite="s_wingsRight">
        <Frame>4,7</Frame>
        <Frame>5,7</Frame>
        <Frame>6,7</Frame>
        <Frame>7,7</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flare" sprite="s_flare">
        <Frame>9,7</Frame>
        <Frame>10,7</Frame>
        <Frame>11,7</Frame>
      </SpriteAnimation>

      <SequenceAnimation name="flash_sequence" playOnState="SelfieTake.Max">

        <InterpolationFloatAnimation name="saturationValueTo" variableName="saturationValue" targetVariableName="saturationValueMax" animTime="0"/>

        <InterpolationFloatAnimation name="contrastValueTo" variableName="contrastValue" targetVariableName="contrastValueMax" animTime="0"/>

        <InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" targetVariableName="brightnessValueWhite" animTime="0"/>

        <DelayAnimation delayTime="200" />

        <InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" targetVariableName="brightnessValueBlack" animTime="0"/>

        <DelayAnimation delayTime="100" />

        <InterpolationFloatAnimation name="brightnessValueTo" variableName="brightnessValue" targetVariableName="brightnessValueWhite" animTime="0"/>

      </SequenceAnimation>

      <InterpolationFloatAnimation name="saturationValueFrom" variableName="saturationValue" playOnState="SelfieTake.Default" targetVariableName="saturationValueDefault" animTime="600"/>

      <InterpolationFloatAnimation name="contrastValueFrom" variableName="contrastValue" playOnState="SelfieTake.Default" targetVariableName="contrastValueDefault" animTime="600"/>

      <InterpolationFloatAnimation name="brightnessValueFrom" variableName="brightnessValue" playOnState="SelfieTake.Default" targetVariableName="brightnessValueDefault" animTime="600"/>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_wingsLeft" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0,-16</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_wingsLeft</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="renderAlignment">RIGHT_CENTER</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.45, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.3, 0.3</KeyFrame>
            <KeyFrame>1, 1.1, 1.1</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_wingsRight" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0,-16</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_wingsRight</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="flipX">true</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.3, 0.3</KeyFrame>
            <KeyFrame>1, 1.2, 1.2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_flare">
        <Emitter>
          <Set name="particlesPerEmission">5</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_flare</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 2.6,2.6</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_bokeh" renderStage="RenderInFront">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_bokeh</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-10,-10" max="10,10" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 1.5,1.5</KeyFrame>
          </Curve>
          <Random name="lifeTime" min="0.5" max="2" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <VariableMap>
      <Set name="saturationValue">1</Set>
      <Set name="saturationValueMax">0</Set>
      <Set name="brightnessValue">1</Set>
      <Set name="brightnessValueWhite">100</Set>
      <Set name="brightnessValueBlack">0</Set>
      <Set name="contrastValue">0</Set>
      <Set name="contrastValueMax">0</Set>

      <Set name="saturationValueDefault">1</Set>
      <Set name="contrastValueDefault">0</Set>
      <Set name="brightnessValueDefault">1</Set>

      <Set name="flashTimer">0</Set>
    </VariableMap>
    <StateMachines>
      <StateMachine name="SelfieTake">
        <States>
          <State name="Default" />
          <State name="Max" ExitTime="0.6" />
        </States>
        <Transitions>
          <Transition to="Default" from="Max"/>
          <Transition to="Max" from="Default">
            <Condition  type="and">
              <IsAction>JUMPDOUBLE</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
  </Data>
  <RenderRules>
    <AddClothingParticles>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_flare" onAction="JUMPDOUBLE"/>
      <ParticleSystemUpdate name="ps_bokeh" onAction="JUMPDOUBLE"/>
    </AddClothingParticles>
    <OnDrawCustomOutline>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <AvatarTransform class="RenderData">
        <Set name="saturation">getCurrent</Set>
        <Set name="brightness">getCurrent</Set>
        <Set name="contrast">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">getCurrent</Set>
      </AvatarTransform>
      <AvatarTransform class="RenderData">
        <Set name="saturation">1.5</Set>
        <Set name="brightness">1.5</Set>
        <Set name="contrast">1.5</Set>
      </AvatarTransform>
      <AvatarOutline duration="1500" startScale="1.1,1.1" endScale="1.1,1.1">
        <Colours>
          <Colour>255,255,255,255</Colour>
        </Colours>
      </AvatarOutline>
      <AvatarTransform class="RenderData">
        <Set name="saturation">reset</Set>
        <Set name="brightness">reset</Set>
        <Set name="contrast">reset</Set>
      </AvatarTransform>
      <AvatarTransform class="Scale">
        <Set name="targetScale">reset</Set>
      </AvatarTransform>
    </OnDrawCustomOutline>
    <RenderBackpack>
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="ps_wingsLeft"/>
      <ParticleSystemRender name="ps_wingsRight"/>
      <ParticleSystemRender name="ps_flare"/>
      <AvatarTransform class="RenderData">
        <Set name="saturation">saturationValue</Set>
        <Set name="brightness">brightnessValue</Set>
        <Set name="contrast">contrastValue</Set>
      </AvatarTransform>
      <StopIf>
        <IsVariableBool name="isMannequin">false</IsVariableBool>
      </StopIf>
      <SpriteRender name="s_wingsLeft" offset="0,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="ADDITIVE"/>
      <SpriteRender name="s_wingsRight" offset="0,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="ADDITIVE"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <StateMachines>
      <StateMachine name="Facing">
        <States>
          <State name="Left"/>
          <State name="Right"/>
        </States>
        <Transitions>
          <Transition to="Left" from="Right">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition to="Right" from="Left">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>

      <StateMachine name="Movement">
        <States>
          <State name="None"/>
          <State name="Horizontal" />
        </States>
        <Transitions>
          <Transition to="None" from="Horizontal">
            <Condition>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Horizontal" from="None">
            <Condition>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>


    <Sprite name="s_turbine" fileName="game/particles12.rttex" textureSize="32" frame="9,17"/>
    <Sprite name="s_backPiece" fileName="game/particles12.rttex" textureSize="32" frame="13,17"/>
    <Sprite name="s_strap" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="2,7"/>
    <Sprite name="s_sideDust" fileName="game/particles10.rttex" textureSize="32" frame="25,20"/>
    <Sprite name="s_jumpCloud" fileName="game/particles10.rttex" textureSize="32" frame="26,20"/>
    <Sprite name="s_jumpSpeedlines" fileName="game/particles10.rttex" textureSize="32" frame="27,20"/>
    
    <Animations>

      <SpriteAnimation name="a_turbine" sprite="s_turbine" animTime="1200" isLoop="true" autoPlay="true">
        <Frame>9,17</Frame>
        <Frame>10,17</Frame>
        <Frame>11,17</Frame>
        <Frame>12,17</Frame>
        <Frame>11,17</Frame>
        <Frame>10,17</Frame>
      </SpriteAnimation>

      <InterpolationVec4Animation name="a_turbineRotLeftMove" variableName="turbineRotLeft" targetValue="10, 0, 0, 1" animTime="200" playOnState="Movement.Horizontal"/>
      <InterpolationVec4Animation name="a_turbineRotLeftIdle" variableName="turbineRotLeft" targetValue="0, 0, 0, 1" animTime="200" playOnState="Movement.None"/>

      <InterpolationVec4Animation name="a_turbineRotRightMove" variableName="turbineRotRight" targetValue="10, 0, 0, 1" animTime="200" playOnState="Movement.Horizontal"/>
      <InterpolationVec4Animation name="a_turbineRotRightIdle" variableName="turbineRotRight" targetValue="0, 0, 0, 1" animTime="200" playOnState="Movement.None"/>
    </Animations>
    
    <ParticleSystems>
      <ParticleSystem name="ps_sideDust" renderStage="RenderBackpack" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="emissionInterval">0.4</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_sideDust</Set>
          <Set name="relativeToEmitter">false</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.75</Set>
          <Select name="offset" input="particleIndex">
            <Item>-30, -3</Item>
            <Item>30, -3</Item>
          </Select>
          <Select name="initialVelocity" input="particleIndex">
            <Item>-20, 0</Item>
            <Item>20, 0</Item>
          </Select>
          <Select name="flipX" input="particleIndex">
            <Item>false</Item>
            <Item>true</Item>
          </Select>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_jumpClouds">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,0</Set>
          <Set name="useCharacterPos">true</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_jumpCloud</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_jumpSpeedlines" renderStage="RenderBackpack">
        <Emitter>
          <Set name="emissionInterval">0.5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,-30</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_jumpSpeedlines</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1, 4</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="ShouldHover">true</Set>
      </Default>
    </RenderOptions>
    <VariableMap>
      <Set name="turbineRotLeft">0, 0, 0, 1</Set>
      <Set name="turbinePosLeft">-20, -24, 0</Set>

      <Set name="turbinePosRight">20, -24, 0</Set>
      <Set name="turbineRotRight">0, 0, 0, 1</Set>
    </VariableMap>
  </Data>

  <RenderRules>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <AvatarTransform class="FootPosition">
        <Set name="foot1dy">0</Set>
        <Set name="foot2dy">0</Set>
        <Set name="foot1y">0</Set>
        <Set name="foot2y">0</Set>
      </AvatarTransform>
    </Update>
    <AddClothingParticles>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_jumpSpeedlines" onAction="JUMP"/>
    </AddClothingParticles>
    <RenderBackpack>
      <SpriteRender name="s_backPiece" scale="1,1" offset="-16.5,-16" alignment="CENTER"/>

      <Group>
        <Translate>turbinePosLeft</Translate>
        <Rotate>turbineRotLeft</Rotate>
        <SpriteRender name="s_turbine" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="RIGHT_CENTER"  onState="Facing.Right"/>
        <SpriteRender name="s_turbine" flip="1,0" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="LEFT_CENTER"  onState="Facing.Left"/>
      </Group>

      <Group>
        <Translate>turbinePosRight</Translate>
        <Rotate>turbineRotRight</Rotate>
        <SpriteRender name="s_turbine" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="LEFT_CENTER"  onState="Facing.Right"/>
        <SpriteRender name="s_turbine" flip="1,0" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignment="RIGHT_CENTER"  onState="Facing.Left"/>
      </Group>

      <SpriteRender name="s_backPiece" scale="1,1" offset="16,-16" flip="1,0" alignment="CENTER"/>
      
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>

      <ParticleSystemUpdate name="ps_jumpClouds" onAction="JUMPSTART|JUMPDOUBLE"/>
    </RenderBackpack>


    <RenderFrontpack>
      <SpriteRender name="s_strap" offset="0,0" alignment="DOWN_CENTER"/>
    </RenderFrontpack>
    
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_TWILIGHT_AURA">
	<Data>
		<Sprite name="s_Aura" fileName="game/particles_large13.rttex" textureSize="64" frame="12,4" />
		<Sprite name="s_Rays" fileName="game/particles_large13.rttex" textureSize="64" frame="13,4" />
		<Sprite name="s_Sparkles" fileName="game/particles11.rttex" textureSize="32" frame="12,23" />
		<StateMachines>
			<StateMachine name="PlayerAction">
				<States>
					<State name="Idle" />
					<State name="Move" />
				</States>
				<Transitions>
					<Transition from="Idle" to="Move">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="Move" to="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="a_RandomSparkles" sprite="s_Sparkles">
				<Frame>12,23</Frame>
				<Frame>13,23</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_Rays">
				<Emitter>
					<Set name="offset">-2, -28</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Rays</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>0.5, 1.25, 1.25</KeyFrame>
						<KeyFrame>1, 1.75, 1.75</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Sparkles">
				<Emitter>
					<Set name="offset">0, -32</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Sparkles</Set>
					<Random name="offset" min="-20, -21" max="20, 21" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.05, 1</KeyFrame>
						<KeyFrame>0.1, 0</KeyFrame>
						<KeyFrame>0.15, 1</KeyFrame>
						<KeyFrame>0.2, 0</KeyFrame>
						<KeyFrame>0.25, 1</KeyFrame>
						<KeyFrame>0.3, 0</KeyFrame>
						<KeyFrame>0.35, 1</KeyFrame>
						<KeyFrame>0.4, 0</KeyFrame>
						<KeyFrame>0.45, 1</KeyFrame>
						<KeyFrame>0.5, 0</KeyFrame>
						<KeyFrame>0.55, 1</KeyFrame>
						<KeyFrame>0.6, 0</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>0.7, 0</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>0.8, 0</KeyFrame>
						<KeyFrame>0.85, 1</KeyFrame>
						<KeyFrame>0.9, 0</KeyFrame>
						<KeyFrame>0.95, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="interpolateScale">true</Set>
					<Random name="initialScale" min="0.25" max="0.75" />
					<Set name="finalScale">0, 0</Set>
					<Random name="lifeTime" min="1" max="1.5" />
					<Select name="initialRotationRate" input="randomNumber">
						<Item>-720</Item>
						<Item>-360</Item>
						<Item>360</Item>
						<Item>720</Item>
					</Select>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="UserNameOffset">18</Set>
      </Default>
    </RenderOptions>
	</Data>
	<RenderRules>
		<RenderBackpack>
      <Group>
				<StopIf>
					<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				</StopIf>
				<ParticleSystemRender name="ps_Sparkles"/>
				<ParticleSystemRender name="ps_Rays"/>
      </Group>
			<SpriteRender name="s_Aura" offset="0,-32" scale="0.8,0.8"/>
		</RenderBackpack>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_Sparkles" onState="PlayerAction.Move" />
			<ParticleSystemUpdate name="ps_Rays" />
		</AddClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="UC_Sprite" fileName="game/UGCSpritesheet1v0.rttex" textureSize="132"/>
		<Sprite name="UC_Punch" fileName="game/UGCSpritesheet1v1.rttex" textureSize="318"/>
		<Sprite name="UC_Particle1" fileName="game/UGCSpritesheet1v2.rttex" textureSize="32"/>
		<Sprite name="UC_Particle2" fileName="game/UGCSpritesheet1v2.rttex" textureSize="32"/>
		<Sprite name="UC_Particle3" fileName="game/UGCSpritesheet1v2.rttex" textureSize="32"/>
		<Sprite name="UC_Particle4" fileName="game/UGCSpritesheet1v2.rttex" textureSize="32"/>
		<Animations>
			<SpriteAnimation name="uc_hell_punch" sprite="UC_Punch" animTime="300" autoPlay="true" playOnAction="PUNCH" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_snowflakes" sprite="UC_Particle4">
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_snowflakesHit" sprite="UC_Particle2">
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_trail" sprite="UC_Particle1">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="uc_hell_after" sprite="UC_Sprite" animTime="500" isLoop="true" autoPlay="true" >
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>0,3</Frame>
			</SpriteAnimation>
			<InterpolationVec4Animation name="SwordProxy" variableName="Sword_rotation" targetValue="-120, 0, 0, 1" animTime="2000" playOnState="Punch.False"/>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_breakflame" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_breakflame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Random name="offset" min="0" max="16" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="pUC_Particle2">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UC_Particle2</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 1,1</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_SparklesTrail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Move">
				<Emitter>
					<Set name="offset">0,-5</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UC_Particle1</Set>
					<Random name="offset" min="0, -12" max="4, 1" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="lifeTime" input="randomNumber">
						<Item>0.3</Item>
						<Item>0.6</Item>
					</Select>
					<Random name="initialScale" min="0.5" max="0.8" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_JumpTrail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Jump">
				<Emitter>
					<Set name="offset">0,-5</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UC_Particle1</Set>
					<Random name="offset" min="-8, -12" max="4, 0" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="lifeTime" input="randomNumber">
						<Item>0.3</Item>
						<Item>0.6</Item>
					</Select>
					<Set name="initialAngle">270</Set>
					<Random name="initialScale" min="0.5" max="0.8" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_FallTrail" updateStage="AddClothingParticles" renderStage="RenderInFront" updateState="Motion.Fall">
				<Emitter>
					<Set name="offset">0,-5</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="emissionInterval" min="0.1" max="0.3" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UC_Particle1</Set>
					<Random name="offset" min="-8, -12" max="4, 0" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="lifeTime" input="randomNumber">
						<Item>0.3</Item>
						<Item>0.6</Item>
					</Select>
					<Set name="initialAngle">90</Set>
					<Random name="initialScale" min="0.5" max="0.8" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="Sword_rotation">0, 0, 0, 1</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="UserNameOffset">15</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="DefaultPunchSound">audio/droar.wav</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
		<TileStampData>
			<Set name="FileName">game/UGCSpritesheet1v2.rttex</Set>
			<Set name="EndFrame">8,0</Set>
			<Set name="FrameCount">5</Set>
		</TileStampData>

	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-26</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<SpriteRender name="UC_Punch" offset="50,-35" alignment="CENTER" rotateOffset="true" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="0.7,0.7" onAction="PUNCH" />
		</RenderInFront>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<Group>
			<Rotate>Sword_rotation</Rotate>
			<SpriteRender name="UC_Sprite" offset="13,-25" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" scale="0.55,0.55" />
			</Group>
		</RenderBackHandItem>
		<RenderPet>
		</RenderPet>
		<UpdatePet>
		</UpdatePet>

		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="pUC_Particle2" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="naruto_idle" fileName="game/UGCSpritesheet10v0.rttex" textureSize="256"/>
		<Sprite name="naruto_punch" fileName="game/UGCSpritesheet10v0.rttex" textureSize="256"/>

		<Sprite name="naruto_bubbles" fileName="game/UGCSpritesheet10v1.rttex" textureSize="256" frame="0,0"/>
		
		<Sprite name="s_tileHit" fileName="game/UGCSpritesheet10v2.rttex" textureSize="256"/>
		<Sprite name="s_DestroyImpact" fileName="game/UGCSpritesheet10v2.rttex" textureSize="256" />
		<Sprite name="naruto_respawn" fileName="game/UGCSpritesheet10v2.rttex" textureSize="256"/>
		<Sprite name="naruto_sleep" fileName="game/UGCSpritesheet10v2.rttex" textureSize="256"/>
		
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
					<State name="Dance"/>
					<State name="Sleep"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|Sleep" >
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|Sleep" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|Sleep" >
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|Sleep">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Sleep" from="Idle|Move|Fall|Jump|Punch|Dance">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Move|Idle|Jump|Fall|Punch|Sleep">
						<Condition>
							<IsAction>DANCE</IsAction>
							<IsAction>DANCE_DAB</IsAction>
							<IsAction>DANCE_FLOSS</IsAction>
							<IsAction>DANCE_MARCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			
			<StateMachine name="IsDying">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Animations>
			<SpriteAnimation name="naruto_sleep_animation" sprite="naruto_sleep" animTime="600" isLoop="true" playOnState="Motion.Sleep">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame> 
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="naruto_bubble_animation" sprite="naruto_bubbles" animTime="100" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame> 
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="naruto_Dance_Animation" playOnState="Motion.Dance" sprite="naruto_idle" animTime="1000" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_DestroyImpact" sprite="s_DestroyImpact" animTime="1000">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hit_particle" sprite="s_tileHit" animTime="700" isLoop="false">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="naruto_Idle_Animation" playOnState="Motion.Idle" sprite="naruto_idle" animTime="1000" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="naruto_Punch_Animation" playOnState="Motion.Punch" sprite="naruto_punch" animTime="500" isLoop="true">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="naruto_Jump_Animation" playOnState="Motion.Jump" sprite="naruto_idle" animTime="300">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="naruto_Fall_Animation" playOnState="Motion.Fall" sprite="naruto_idle" animTime="400" isLoop="true">
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="naruto_Walk_Animation" playOnState="Motion.Move" sprite="naruto_idle" animTime="400" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="naruto_Respawn_Animation" sprite="naruto_respawn" animTime="1200" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
		</Animations>
<!-- dont change!
 -->
<ParticleSystems>
            <ParticleSystem name="dasdasdas" updateStage="AddClothingParticles" updateState="Motion.Punch">
            <Emitter>
            <Set name="offset">45, -10050</Set>
            <Set name="offsetFacing">true</Set>
            <Random name="emissionInterval" min="0" max="0" />
            <Set name="infParticles">true</Set>
            <Set name="infLifeTime">true</Set>
            <Set name="particlesPerEmission">1</Set>
            </Emitter>
            <Particle>
            <Set name="sprite">naruto_bubbles</Set>
            <Set name="frame">0,0</Set>
            <Set name="renderAlignment">CENTER</Set>
            <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
            <Set name="initialScale">0.1,0.1</Set>
            <Random name="finalScale" min="3" max="3"/>
            <Set name="interpolateScale">true</Set>
            <Set name="lifeTime">0.6</Set>
            <Random name="targetPosOffset" min="-12,-456" max="12,-104"/>
            <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="2" angleOutVar="projectile_angle"/>
            <VectorTo name="finalVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.1" angleOutVar="projectile_angle"/>
            <Set name="interpolateVelocity">true</Set>
            <OnFinish>
                <ParticleSystemName>ps_destroyImpact</ParticleSystemName>
            </OnFinish>
            </Particle>
</ParticleSystem>
			<!-- DESTROY IMPACT EFFECT -->
			<ParticleSystem name="ps_destroyImpact">
				<Emitter>
					<Set name="offset">8, -160</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_DestroyImpact</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.0</Set>
					<Random name="initialAngle" min="0" max="0" />
					<Curve name="initialScale">
						<KeyFrame>0, 2,2</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>

			<!-- TILE HIT EFFECT -->
			<ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">8, -165</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2, 1.2</KeyFrame>
						<KeyFrame>1, 3.6, 3.6</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>

			<!-- DEATH EFFECT -->
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.1</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">naruto_respawn</Set>
					<Set name="offset">0,-175</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>1, 1.4,1.4</KeyFrame>
						<KeyFrame>1, 1.4,1.4</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.1</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">SHOES</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">20</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="naruto_idle" offset="0,-10174" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Dance" scale="1.4,1.4"/>
			<SpriteRender name="naruto_punch" offset="0,-10174" drawShadow="true" onState="Motion.Punch" scale="1.4,1.4"/>
			<SpriteRender name="naruto_sleep" offset="0,-10180" drawShadow="true" onState="Motion.Sleep" scale="1.4,1.4"/>
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>false</IsSitting>
				<IsSleepingOnaBed>false</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="DeathParticle" />
		</SwitchOffClothingParticles>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroyImpact" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_blade" fileName="game/UGCSpritesheet100v1.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_Pet" fileName="game/UGCSpritesheet100v0.rttex" textureSize="128,64" frame="0,2" />
		<Sprite name="s_PetPunch" fileName="game/UGCSpritesheet100v0.rttex" textureSize="128,64" frame="0,3" />
		<Sprite name="s_EyeGlow" fileName="game/UGCSpritesheet100v1.rttex" textureSize="32" frame="1,0" />
		<Sprite name="s_Petal" fileName="game/UGCSpritesheet100v1.rttex" textureSize="32" frame="4,0" />
		<Sprite name="s_Soul" fileName="game/UGCSpritesheet100v1.rttex" textureSize="32" frame="6,0" />
		<Sprite name="s_Drop" fileName="game/UGCSpritesheet100v1.rttex" textureSize="32" frame="5,0" />
		<Sprite name="s_Fire" fileName="game/UGCSpritesheet100v1.rttex" textureSize="32" frame="3,0" />
		<Animations>
			<!-- 128x64 frames: 0,0 wings up/jaw open, 1,0 wings down/jaw open, 0,1 wings down/jaw shut,
			     1,1 wings up/roar, 0,2 wings up/jaw shut, 1,2 wings down/jaw shut,
			     0,3 roar raised 4px, 1,3 wings down/jaw open lowered 4px (punch loop, mouths aligned, tail up/down),
			     6-step idle flap 0,2 > 0,4 > 1,4 > 1,2 > 0,5 > 1,5 (wings up, up, level, down, down, level; tail and body ease between them) -->
			<SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="1200" isLoop="true" playOnState="Pet.Idle">
				<Frame>0,2</Frame>
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>1,2</Frame>
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PetMoving" sprite="s_Pet" animTime="1200" isLoop="true" playOnState="Pet.Moving">
				<Frame>0,2</Frame>
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>1,2</Frame>
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PetPunch" sprite="s_PetPunch" animTime="500" isLoop="true" playOnState="Player.Punch">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_EyeGlow" sprite="s_EyeGlow" animTime="300" isLoop="true" playOnState="Player.Punch">
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<!-- punch: fire stream from the dragon's mouth, white petal-flame burst at the target, blue droplets (Dragon of Legend style) -->
			<ParticleSystem name="ps_DragonFire">
				<Emitter>
					<Set name="offset">53,-16</Set>
					<Random name="emissionInterval" min="0.012" max="0.02" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Fire</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.9</KeyFrame>
						<KeyFrame>0.8, 0.7</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.9, 0.9</KeyFrame>
						<KeyFrame>1, 2.2, 2.2</KeyFrame>
					</Curve>
					<Random name="targetPosOffset" min="-10,-18" max="10,18"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<OnFinish>
						<ParticleSystemName>ps_Hit</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<!-- spawned where each fireball lands (OnFinish), so the burst only appears once the fire arrives -->
			<ParticleSystem name="ps_Hit">
				<Emitter>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Random name="variantId" min="0" max="4" />
					<Select name="sprite" input="variantId">
						<Item>"s_Petal"</Item>
						<Item>"s_Petal"</Item>
						<Item>"s_Petal"</Item>
						<Item>"s_Drop"</Item>
					</Select>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">NORMAL</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.8, 1.8</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="20,160"/>
				</Particle>
			</ParticleSystem>
			<!-- every 0.35 s one fireball carries souls (the respawn soul sprite); where it lands, souls burst out in every direction -->
			<ParticleSystem name="ps_SoulShot">
				<Emitter>
					<Set name="offset">53,-16</Set>
					<Set name="emissionInterval">0.35</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Fire</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.9, 0.9</KeyFrame>
						<KeyFrame>1, 2.2, 2.2</KeyFrame>
					</Curve>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<OnFinish>
						<ParticleSystemName>ps_Souls</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Souls">
				<Emitter>
					<Set name="particlesPerEmission">6</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Soul</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">NORMAL</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="lifeTime">0.7</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.7, 0.7</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.75</KeyFrame>
						<KeyFrame>0.6, 0.6</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,130"/>
				</Particle>
			</ParticleSystem>
			<!-- while walking: faint souls and pale wisps drift up off the dragon's body -->
			<ParticleSystem name="ps_SoulTrail">
				<Emitter>
					<Set name="offset">6,-24</Set>
					<Random name="emissionInterval" min="0.25" max="0.4" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Random name="variantId" min="0" max="3" />
					<Select name="sprite" input="variantId">
						<Item>"s_Soul"</Item>
						<Item>"s_Soul"</Item>
						<Item>"s_Drop"</Item>
					</Select>
					<Random name="offset" min="-30,-10" max="30,10" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">NORMAL</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="lifeTime">1.2</Set>
					<Random name="initialVelocity" min="-8,-30" max="8,-15" />
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0.8, 0.8</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 0.4</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="Idle" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving">
						<Condition>
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle">
						<Condition>
							<IsVariableFloat name="pet.velocity.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Player">
				<States>
					<State name="Idle"/>
					<State name="Sleep"/>
					<State name="Punch"/>
					<State name="Dance"/>
					<State name="Move"/>
				</States>
				<Transitions>
					<Transition to="Sleep" from="Idle|Punch|Dance|Move">
						<Condition type="or">
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Idle" from="Punch|Sleep|Dance|Move">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Sleep|Dance|Move">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Idle|Sleep|Punch|Move">
						<Condition>
							<IsAction>DANCE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|Sleep|Punch|Dance">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-64,0</Set>
				<Set name="UsePetForceFaceTime">false</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<SpriteRender name="s_blade" rotationPoint="0,1" alignment="UPPER_CENTER" />
		</RenderHandItem>
		<RenderPet>
			<SpriteRender name="s_Pet" offset="0,6" alignment="DOWN_CENTER" onState="Player.Idle|Player.Sleep|Player.Dance|Player.Move" />
			<SpriteRender name="s_PetPunch" offset="0,10" alignment="DOWN_CENTER" onState="Player.Punch" />
			<SpriteRender name="s_EyeGlow" offset="47,-20" alignment="CENTER" blend="ADDITIVE" onState="Player.Punch" />
			<ParticleSystemUpdate name="ps_DragonFire" onState="Player.Punch"/>
			<ParticleSystemUpdate name="ps_SoulShot" onState="Player.Punch"/>
			<ParticleSystemUpdate name="ps_SoulTrail" onState="Player.Move"/>
		</RenderPet>
		<UpdatePet>
			<ContextUpdate type="SetPetFlySit">
				<Set name="PetFlySit.speed">100</Set>
				<Set name="PetFlySit.offset">0,26</Set>
				<Set name="PetFlySit.flyTime">60</Set>
			</ContextUpdate>
		</UpdatePet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Move|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="s_Pet_head" fileName="game/UGCSpritesheet101v0.rttex" textureSize="64" frame="0,1" />
		<Sprite name="s_Pet_back" fileName="game/UGCSpritesheet101v0.rttex" textureSize="64" frame="0,0" />
		<Sprite name="p_Pet_head" fileName="game/UGCSpritesheet101v0.rttex" textureSize="64" frame="1,1" />
		<Sprite name="p_Pet_back" fileName="game/UGCSpritesheet101v0.rttex" textureSize="64" frame="12,19" />
		<!-- ic1 -->
		<Sprite name="hanS" fileName="game/UGCSpritesheet101v1.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_fire" fileName="game/UGCSpritesheet101v1.rttex" textureSize="32" frame="1,0" />

		<Animations>
			<SpriteAnimation name="a_dragon_punch_head" sprite="p_Pet_head" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>1,1</Frame>
				<Frame>3,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_punch_back" sprite="p_Pet_back" animTime="1000"
				isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>0,1</Frame>
				<Frame>2,1</Frame>
				<Frame>4,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_head" sprite="s_Pet_head" animTime="1000" isLoop="true"
				playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>1,0</Frame>
				<Frame>3,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_dragon_back" sprite="s_Pet_back" animTime="1000" isLoop="true"
				playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>0,0</Frame>
				<Frame>2,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_eletric" sprite="hand_eletric" animTime="500" isLoop="true"
				playOnAction="IDLE|PUNCH|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>1,42</Frame>
				<Frame>2,42</Frame>
				<Frame>3,42</Frame>
			</SpriteAnimation>
		</Animations>

		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">17,23</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>

		<ParticleSystems>
			<ParticleSystem name="ps_punchProjectile" updateStage="RenderPet"
				updateState="Motion.Punch">
				<Emitter usePlayerFacing="true">
					<Random name="emissionInterval" min="0.002" max="0.004" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
					<Set name="offset">42,-50</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_fire</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialScale">2,4</Set>
					<Set name="finalScale">4,8</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Random name="targetPosOffset" min="-6, -26" max="6, 26" />
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset"
						duration="lifeTime" x="1" />
					<Set name="rotateWithVelocity">true</Set>
					<OnFinish>
						<ParticleSystemName>ps_punchSmoke</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchSmoke">
				<Emitter>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="delay">-0.25</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_fire</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="offset" min="-16, -16" max="16, 16" />
					<Set name="initialAngle">180</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.6, 0.6</KeyFrame>
						<KeyFrame>1, 0.05, 0.05</KeyFrame>
					</Curve>
					<Set name="rotateWithVelocity">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,80" />
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem> 
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="DefaultPunchSound">audio/squish.wav</Set>
		        <Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderHandItem>
			<SpriteRender name="hanS" offset="0,16" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
		</RenderHandItem>
        
		<OnPunchUpdate>
			<AvatarTransform class="Emotion">
				<Set name="emotion">ANGRY</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderPet>
			<SpriteRender name="p_Pet_head" alignment="DOWN_CENTER" onAction="PUNCH" offset="0,10" scale="2.0, 2.0"/>
			<SpriteRender name="p_Pet_back" alignment="DOWN_CENTER" onAction="PUNCH"
				offset="-127,10" scale="2.0, 2.0"/>
			<SpriteRender name="s_Pet_head" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="0,10" scale="2.0, 2.0"/>
			<SpriteRender name="s_Pet_back" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="-127,10" scale="2.0, 2.0"/>
		</RenderPet>
	</RenderRules>
</ItemRenderer>
    <?xml version="1.0"?>

<ItemRenderer>

	<Data>

		<Sprite name="s_card_orbitu" fileName="game/UGCSpritesheet102v0.rttex" textureSize="256" frame="0,0"/>

		<Sprite name="s_card_particle_front" fileName="game/UGCSpritesheet102v0.rttex" textureSize="256"/>

		<Sprite name="s_card_particle_back" fileName="game/UGCSpritesheet102v0.rttex" textureSize="256"/>

		<Animations>

			<SpriteAnimation name="a_sadasdsadasdcard_2222sdas" sprite="s_card_orbit" isLoop="true" animTime="6000">

				<Frame>8,0</Frame>

				<Frame>7,0</Frame>

				<Frame>6,0</Frame>

				<Frame>5,0</Frame>

				<Frame>0,0</Frame>

				<Frame>1,0</Frame>

				<Frame>2,0</Frame>

				<Frame>1,0</Frame>

				<Frame>2,0</Frame>

				<Frame>3,0</Frame>

				<Frame>4,0</Frame>

				<Frame>0,1</Frame>

				<Frame>8,0</Frame>

				<Frame>7,0</Frame>

			</SpriteAnimation>

			<SpriteAnimation name="a_card_particle_front" sprite="s_card_particle_front" isLoop="true" animTime="200">

				<Frame>1,1</Frame>

			</SpriteAnimation>			

			<SpriteAnimation name="a_card_particle_back" sprite="s_card_particle_back" isLoop="true" animTime="200">

				<Frame>1,1</Frame>

			</SpriteAnimation>

		</Animations>

		<StateMachines>

			<StateMachine name="Action">

				<States>

					<State name="None" />

					<State name="Punch" />

				</States>

				<Transitions>

					<Transition to="None" from="Punch">

						<Condition>

							<IsAction operatorType="NotEqual">PUNCH</IsAction>

						</Condition>

					</Transition>

					<Transition to="Punch" from="None">

						<Condition>

							<IsAction>PUNCH</IsAction>

						</Condition>

					</Transition>

				</Transitions>

			</StateMachine>

		</StateMachines>

		<RenderOptions>

			<Default>

				<Set name="IncludeAllActions">true</Set>

				<Set name="IgnorePunchTypeCheck">false</Set>

				<Set name="IgnorePunchTypeDamagedTileCheck">false</Set>

				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>

				<Set name="IsToRenderParticlesWhenShrunken">true</Set>

			</Default>

		</RenderOptions>

		<ParticleSystems>

			<ParticleSystem name="Arc1" updateStage="AddClothingParticles">

				<Emitter>

					<Set name="offset">0, -16</Set>

					<Set name="emissionInterval">0.75</Set>

					<Set name="infParticles">true</Set>

					<Set name="infLifeTime">true</Set>

					<Set name="particlesPerEmission">1</Set>

				</Emitter>

				<Particle>

					<Set name="sprite">s_card_orbit</Set>

					<Set name="relativeToEmitter">true</Set>

					<Set name="orbitStart">-0.2</Set>

					<Set name="initialScale">0.1, 0.1</Set>

					<Set name="lifeTime">6.1</Set>

					<Set name="orbitPeriod">5.8</Set>

					<Set name="initialRotationRate">0</Set>

					<Set name="applyOrbit">true</Set>

					<Set name="orbit">-24, 3</Set>

					<Set name="orbitScaleVariation">0.08</Set>

					<Set name="orbitSkew">0</Set>

				</Particle>

			</ParticleSystem>

			<ParticleSystem name="ps_punchProjectile" updateState="Action.Punch">

				<Emitter>

					<Set name="offset">0, -16</Set>

					<Set name="lifeTime">0.3</Set>

					<Set name="emissionInterval">0.05</Set>

					<Set name="infParticles">true</Set>

					<Set name="checkParticleNumToEmit">true</Set>

					<Set name="particlesPerEmission">1</Set>

					<Set name="particlesToEmit">1</Set>

				</Emitter>

				<Particle>

					<Random name="variantId" min="0" max="4" />

					<Select name="sprite" input="variantId">

						<Item>"s_card_particle_front"</Item>

						<Item>"s_card_particle_back"</Item>

					</Select>

					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>

					<Set name="lifeTime">0.3</Set>

					<Set name="initialScale">0.2, 0.2</Set>

					<Set name="initialAngle">0</Set>

					<Random name="targetPosOffset" min="-12,-11" max="12,11"/>

					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angleOutVar="projectile_angle"/>

					<Set name="rotateWithVelocity">true</Set>

					<SetVar name="projectile_offset" source="targetPosOffset"/>

					<SetVar name="variantIdVar" source="variantId"/>

				</Particle>

			</ParticleSystem>

		</ParticleSystems>

		<VariableMap>

			<Set name="projectile_offset">0, 0</Set>

			<Set name="projectile_angle">0</Set>

			<Set name="variantIdVar" ForceFloats="false">0</Set>

		</VariableMap>

	</Data>

	<RenderRules>

		<AddClothingParticles>

			<StopIf type="or">

				<IsZombified>true</IsZombified>

			</StopIf>

		</AddClothingParticles>

		<OnDamagedTile>

			<StopIf type="or">

				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>

				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>

				<IsZombified>true</IsZombified>

				<IsTrnsformed>true</IsTrnsformed>

			</StopIf>

		</OnDamagedTile>

		<OnDestroyedTile>

			<StopIf type="or">

				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>

				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>

				<IsZombified>true</IsZombified>

				<IsTrnsformed>true</IsTrnsformed>

			</StopIf>

		</OnDestroyedTile>

		<OnPunchUpdate>

			<StopIf>

				<IsZombified>true</IsZombified>

			</StopIf>

			<AvatarTransform class="Face">

				<Set name="face">MAD</Set>

			</AvatarTransform>

			<AvatarTransform class="ArmAngle" onState="Action.Punch">

				<Set name="armName">arm2Angle</Set>

				<Set name="armAngle">1200</Set>

				<Set name="isAdditive">true</Set>

				<Set name="pointTowardsPunchTarget">false</Set>

			</AvatarTransform>

			<AvatarTransform class="ArmAngle" onState="Action.Punch">

				<Set name="armName">arm1Angle</Set>

				<Set name="armAngle">0</Set>

			</AvatarTransform>

			<StopIf>

				<IsZombified>true</IsZombified>

				<IsTrnsformed>true</IsTrnsformed>

				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>

			</StopIf>

			

			<ParticleSystemUpdate name="ps_punchProjectile"/>

		</OnPunchUpdate>

		<SwitchOffClothingParticles>

			<ParticleSystemOff name="Arc1"/>

		</SwitchOffClothingParticles>

	</RenderRules>

</ItemRenderer>

<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="UCJUESTUDIO_0" fileName="game/UGCSpritesheet103v0.rttex" textureSize="256"/>
    <Sprite name="UCJUESTUDIO_1" fileName="game/UGCSpritesheet103v1.rttex" textureSize="128" frame="0,2"/>
    <Sprite name="UCJUESTUDIO_2" fileName="game/UGCSpritesheet103v1.rttex" textureSize="128" frame="0,2"/>
    <Sprite name="UCJUESTUDIO_3" fileName="game/UGCSpritesheet103v1.rttex" textureSize="128" frame="0,3"/>
    
    <Sprite name="UCJUESTUDIO_4" fileName="game/UGCSpritesheet103v1.rttex" textureSize="128" frame="0,0"/>
    <Sprite name="UCJUESTUDIO_5" fileName="game/UGCSpritesheet103v1.rttex" textureSize="128" frame="1,0"/>
    <Sprite name="UCJUESTUDIO_6" fileName="game/UGCSpritesheet103v1.rttex" textureSize="128" frame="2,0"/>
    <Sprite name="UCJUESTUDIO_7" fileName="game/UGCSpritesheet103v1.rttex" textureSize="128" frame="0,1"/>

    <StateMachines>
      <StateMachine name="UCJUESTUDIO_8">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
          <State name="LandedTrigger" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall|LandedTrigger">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.0</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="LandedTrigger" from="Fall|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.001</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Idle" from="Fall|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">0.001</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Idle" from="LandedTrigger" />
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="UCJUESTUDIO_9" playOnState="UCJUESTUDIO_8.Jump" sprite="UCJUESTUDIO_0" animTime="200" autoPlay="true" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="UCJUESTUDIO_10" playOnState="UCJUESTUDIO_8.Fall" sprite="UCJUESTUDIO_0" animTime="200" autoPlay="true" isLoop="true">
        <Frame>5,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="UCJUESTUDIO_11" playOnState="UCJUESTUDIO_8.Idle|UCJUESTUDIO_8.Move|UCJUESTUDIO_8.LandedTrigger" sprite="UCJUESTUDIO_0" tintOverride="0,127,236,255" animTime="600" autoPlay="true" isLoop="true">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="UCJUESTUDIO_12" sprite="UCJUESTUDIO_1" isLoop="true" animTime="400">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="UCJUESTUDIO_13" sprite="UCJUESTUDIO_2" isLoop="true" animTime="400">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="UCJUESTUDIO_14" sprite="UCJUESTUDIO_7" animTime="1200">
        <Frame>8,1</Frame>
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
        <Frame>4,1</Frame>
        <Frame>5,1</Frame>
        <Frame>6,1</Frame>
        <Frame>7,1</Frame>
        <Frame>7,1</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="UCJUESTUDIO_15">
        <Emitter>
          <Random name="offset" min="65, 20" max="55, 20" />
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
            <Set name="sprite">UCJUESTUDIO_1</Set>
