			<SpriteRender name="UCJUESTUDIO_0" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="0,10" scale="1.5, 1.5"/>
			<SpriteRender name="UCJUESTUDIO_1" alignment="DOWN_CENTER"
				onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="-95.25,10" scale="1.5, 1.5" />
		</RenderPet>

		<RenderInFront>
			<SpriteRender name="UCJUESTUDIO_7" alignment="DOWN_CENTER" offset="0, 40" onAction="IDLE|PUNCH|WALK|JUMP|JUMPSTART|FALL" drawShadow="false" />
		</RenderInFront>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_DRAGON_FRUIT_DRAGON_WINGS">
	<Data>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Fall"/>
					<State name="Jump"/>
					<State name="DoubleJump"/>
					<State name="SpiritGuide"/>
				</States>
				<Transitions>
					<Transition from="SpiritGuide|Jump|Fall|Move|DoubleJump" to="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Jump|Fall|Idle|DoubleJump" to="Move">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>WALK</IsAction>
						</Condition>
					</Transition>
					<Transition from="Move|Jump|Fall|Idle|DoubleJump" to="SpiritGuide">
						<Condition type="and">
							<IsWearing slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0</IsVariableFloat>
							<IsAction operatorType="NotEqual">FALL</IsAction>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Fall|Move|Idle" to="Jump">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition from="Jump|Fall" to="DoubleJump">
						<Condition>
							<IsAction>JUMPDOUBLE</IsAction>
						</Condition>
					</Transition>
					<Transition from="DoubleJump|SpiritGuide|Jump|Idle|Move" to="Fall">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater" abs="false">0.01</IsVariableFloat>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="UCJUESTUDIO_0" fileName="game/UGCSpritesheet109v0.rttex" textureSize="256"/>
		<Sprite name="UCJUESTUDIO_1" fileName="game/UGCSpritesheet109v1.rttex" textureSize="32" frame="1,0"/>
		<Sprite name="UCJUESTUDIO_2" fileName="game/UGCSpritesheet109v2.rttex" textureSize="32" frame="0,0"/>
		<Sprite name="UCJUESTUDIO_3" fileName="game/UGCSpritesheet109v2.rttex" textureSize="32" frame="1,0"/>
		<Sprite name="UCJUESTUDIO_4" fileName="game/UGCSpritesheet109v2.rttex" textureSize="32" frame="2,0"/>

		<Animations>
			<SpriteAnimation name="wing_Idle" playOnState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.DoubleJump" sprite="UCJUESTUDIO_0" isLoop="true" animTime="900">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="nw_particle_2_anim" playOnState="Motion.DoubleJump" autoPlay="false" isLoop="false" sprite="UCJUESTUDIO_4" animTime="100">
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="nw_particle_0_anim" playOnState="Motion.DoubleJump" autoPlay="false" isLoop="false" sprite="UCJUESTUDIO_2" animTime="100">
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="nw_particle_1_anim" playOnState="Motion.DoubleJump" autoPlay="false" isLoop="false" sprite="UCJUESTUDIO_3" animTime="100">
				<Frame>0,0</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="ps_right" updateStage="AddClothingParticles" renderStage="RenderInFront">
				<Emitter>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.1</Set>
					<Set name="intervalMax">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true" randomSpriteFrame="true">
					<Set name="sprite">UCJUESTUDIO_1</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">10,10,10</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.45, 0.20</Set>
					<Set name="finalScale">0, 1.5</Set>
					<Set name="interpolateAlpha">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.4, 0.75</KeyFrame>
						<KeyFrame>0.6, 0.75</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="-30" max="30" />
					<Random name="lifeTime" min="0.8" max="1.5" />
					<Random name="initialVelocity" min="-10,-60" max="10,-70" />
					<Random name="offset" min="5,-8" max="10,-15" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">10, -65</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_left" updateStage="AddClothingParticles" renderStage="RenderInFront">
				<Emitter>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.1</Set>
					<Set name="intervalMax">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true" randomSpriteFrame="true">
					<Set name="sprite">UCJUESTUDIO_1</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">10,10,10</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.45, 0.20</Set>
					<Set name="finalScale">0, 1.5</Set>
					<Set name="interpolateAlpha">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.4, 0.75</KeyFrame>
						<KeyFrame>0.6, 0.75</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="-30" max="30" />
					<Random name="lifeTime" min="0.8" max="1.5" />
					<Random name="initialVelocity" min="-10,-60" max="10,-70" />
					<Random name="offset" min="-5,-10" max="-10,-35" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">-10, -65</Set>
				</Particle>
			</ParticleSystem>

			<!-- Partikel double jump (dari nw) -->
			<ParticleSystem name="nw_double_jump_up">
				<Emitter>
					<Random name="offset" min="0, -5" max="0, -5" />
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">UCJUESTUDIO_4</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.85, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">2.2, 2.2</Set>
					<Set name="finalScale">4.2, 4.2</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="nw_double_jump_left">
				<Emitter>
					<Random name="offset" min="60, 0" max="44, 0" />
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">UCJUESTUDIO_2</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateAlpha">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.85, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">2.2, 2.2</Set>
					<Set name="finalScale">4.6, 4.6</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="nw_double_jump_right">
				<Emitter>
					<Random name="offset" min="-44, 0" max="-60, 0" />
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">UCJUESTUDIO_3</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Set name="interpolateAlpha">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.85, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">2.2, 2.2</Set>
					<Set name="finalScale">4.6, 4.6</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderBackpack>
			<SpriteRender name="UCJUESTUDIO_0" scale="0.75,0.75" offset="0,-45"/>
		</RenderBackpack>

		<AddClothingParticles>
			<ParticleSystemUpdate name="nw_double_jump_up" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
			<ParticleSystemUpdate name="nw_double_jump_left" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
			<ParticleSystemUpdate name="nw_double_jump_right" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="nw_double_jump_up" />
			<ParticleSystemOff name="nw_double_jump_left" />
			<ParticleSystemOff name="nw_double_jump_right" />
		</SwitchOffClothingParticles>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Pet" fileName="game/UGCSpritesheet11v0.rttex" textureSize="128,32" frame="0,0"/>
    <Sprite name="s_PetParts" fileName="game/UGCSpritesheet11v1.rttex" textureSize="40,32" frame="0,0"/>
    <Sprite name="s_Hand" fileName="game/UGCSpritesheet11v2.rttex" textureSize="64,32" frame="0,0"/>
    <Sprite name="s_Punch" fileName="game/UGCSpritesheet11v3.rttex" textureSize="32" frame="0,0" />

    <Animations>
      <SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="800" isLoop="true" autoPlay="true" playOnState="Pet.Idle">
        <Frame>0,0</Frame>
        <Frame>0,1</Frame>
        <Frame>1,0</Frame>
      </SpriteAnimation>
      
      <SpriteAnimation name="a_PetPartsIdle" sprite="s_PetParts" animTime="800" isLoop="true" playOnState="Pet.Idle">
        <Frame>0,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetPunch" sprite="s_Pet" animTime="800" isLoop="false" playOnState="Pet.Punch">
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetPartsPunch" sprite="s_PetParts" animTime="800" isLoop="false" playOnState="Pet.Punch">
        <Frame>1,0</Frame>
      </SpriteAnimation>

    </Animations>
    
    <StateMachines>
      <StateMachine name="Pet">
        <States>
          <State name="Idle" />
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition to="Punch" from="Idle">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Idle" from="Punch" >
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Move|Jump" >
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Jump|Fall|Idle" >
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall" >
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move" >
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>

    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_punch_projectile">
				<Emitter>
					<Set name="offset">60, -15</Set>
					<Random name="emissionInterval" min="0.001" max="0.005" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle autoLifeTimeToTarget="true">
					<Set name="sprite">s_Punch</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">false</Set>
					<SetVar name="projectile_offset" source="targetPosOffset"/>
					<Random name="targetPosOffset" min="-8.1,-8.3" max="8.2,8.8"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.5, 1.5</KeyFrame>
						<KeyFrame>1, 2.0, 2.0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="-5,5" radiusRange="150,200" baseAnglePosition="targetPos" baseOffset="0,16" offset="targetPosOffset"  />
				</Particle>
			</ParticleSystem>
      <ParticleSystem name="SpawnParticleRabbits">
        <Emitter>
          <Set name="offset">0, -500</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Pet</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 3, 3</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="SpawnSparkle">
        <Emitter>
          <Set name="offset">0, -900</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_Punch</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Random name="offset" min="-8, -8" max="8, 8" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="1" max="1.5" />
          <Increment name="finalScale" source="initialScale" multiplier="2.5,2.5"/>
          <Set name="interpolateScale">true</Set>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">0,0</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShouldHover">false</Set>
        <Set name="UsePetForceFaceTime">true</Set>
        <Set name="PunchSoundOverride">HAND</Set>
	    <Set name="DefaultPunchSound">audio/droar.wav</Set>
		<Set name="PlayDefaultPunchAudio">true</Set>
      </Default>
    </RenderOptions>
  </Data>

    <RenderRules>
      <RenderPet>
        <SpriteRender name="s_Pet" alignment="DOWN_CENTER"/>
        <SpriteRender name="s_PetParts" alignment="DOWN_CENTER" offset="1,-18" onState="Pet.Idle"/>
        <SpriteRender name="s_PetParts" alignment="DOWN_CENTER" offset="-4,17" onState="Pet.Punch"/>
        <ParticleSystemUpdate name="ps_punch_projectile" offset="90,-16" scale="1,0.5" onState="Pet.Punch" blend="PREMULTIPLIED_ALPHA" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" />
      </RenderPet>
    <RenderHandItem>
      <SpriteRender name="s_Hand" offset="0,8" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
    </RenderHandItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>

    <StateMachines>

      <StateMachine name="playerState">
        <States>
          <State name="Idle"/>
          <State name="Move"/>
          <State name="Fall"/>
          <State name="Jump"/>
          <State name="DoubleJump"/>
          <State name="SpiritGuide"/>
        </States>
        <Transitions>
          <Transition from="SpiritGuide|Jump|Fall|Move|DoubleJump" to="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="SpiritGuide|Jump|Fall|Idle|DoubleJump" to="Move">
            <Condition type="and">
              <IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
              <IsAction>WALK</IsAction>
            </Condition>
          </Transition>
          <Transition from="Move|Jump|Fall|Idle|DoubleJump" to="SpiritGuide">
            <Condition type="and">
              <IsWearing slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0</IsVariableFloat>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="SpiritGuide|Fall|Move|Idle" to="Jump">
            <Condition type="and">
              <IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
              <IsAction>JUMP</IsAction>
            </Condition>
          </Transition>
          <Transition from="Jump|Fall" to="DoubleJump">
            <Condition>
              <IsAction>JUMPDOUBLE</IsAction>
            </Condition>
          </Transition>
          <Transition from="DoubleJump|SpiritGuide|Jump|Idle|Move" to="Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater" abs="false">0.01</IsVariableFloat>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>

      <StateMachine name="Facing">
        <States>
          <State name="Left"/>
          <State name="Right"/>
        </States>
        <Transitions>
          <Transition from="Right" to="Left">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition from="Left" to="Right">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>

    </StateMachines>

