            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="16,0" max="32,-32"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="HideParticlesOnTransform">true</Set>
        <Set name="HideParticlesOnTheaterSeat">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="item_Sprite" offset="0,-32" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="item_Sprite" offset="0,-32" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
      <SpriteRender name="item_glow_Sprite" offset="0,-32" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      <SpriteRender name="item_glow_Sprite" offset="0,-32" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
    </RenderBackpack>
    <AddClothingParticles>
      <ParticleSystemUpdate name="thrusterLeft" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="sparklesLeft" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="jumpTrailLeft" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpSparkleLeft" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpHeartsLeft" onAction="JUMPSTART|JUMPDOUBLE"/>
      <ParticleSystemUpdate name="thrusterRight" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="sparklesRight" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="jumpTrailRight" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpSparkleRight" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpHeartsRight" onAction="JUMPSTART|JUMPDOUBLE"/>
      <ParticleSystemUpdate name="randomWingSparklesLeft"/>
      <ParticleSystemUpdate name="randomWingSparklesRight"/>
    </AddClothingParticles>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="thrusterLeft"/>
      <ParticleSystemOff name="sparklesLeft"/>
      <ParticleSystemOff name="jumpTrailLeft"/>
      <ParticleSystemOff name="jumpSparkleLeft"/>
      <ParticleSystemOff name="jumpHeartsLeft"/>
      <ParticleSystemOff name="thrusterRight"/>
      <ParticleSystemOff name="sparklesRight"/>
      <ParticleSystemOff name="jumpTrailRight"/>
      <ParticleSystemOff name="jumpSparkleRight"/>
      <ParticleSystemOff name="jumpHeartsRight"/>
      <ParticleSystemOff name="randomWingSparklesLeft"/>
      <ParticleSystemOff name="randomWingSparklesRight"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_bow" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="9,3" />
    <Sprite name="s_ribbonLeft" fileName="game/particles12.rttex" textureSize="32" frame="10,16" />
    <Sprite name="s_ribbonRight" fileName="game/particles12.rttex" textureSize="32" frame="11,16" />
    <Sprite name="s_sparkle" fileName="game/particles.rttex" textureSize="32" frame="1,1" />

    <Animations>
      <SpriteAnimation name="a_ribbonLeftIdle" sprite="s_ribbonLeft" animTime="1000" isLoop="true" playOnState="Action.Idle">
        <Frame>10,16</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ribbonRightIdle" sprite="s_ribbonRight" animTime="1000" isLoop="true" playOnState="Action.Idle">
        <Frame>11,16</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ribbonLeftMove" sprite="s_ribbonLeft" animTime="600" isLoop="true" playOnState="Action.Walk|Action.JumpStraight|Action.JumpDiagonal|Action.FallStraight|Action.FallDiagonal">
        <Frame>17,16</Frame>
        <Frame>12,16</Frame>
        <Frame>13,16</Frame>
        <Frame>12,16</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ribbonRightFall" sprite="s_ribbonRight" animTime="600" isLoop="true" playOnState="Action.FallStraight|Action.FallDiagonal">
        <Frame>13,16</Frame>
        <Frame>12,16</Frame>
        <Frame>17,16</Frame>
        <Frame>12,16</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ribbonRightMove" sprite="s_ribbonRight" animTime="600" isLoop="true" playOnState="Action.Walk|Action.JumpStraight|Action.JumpDiagonal">
        <Frame>14,16</Frame>
        <Frame>15,16</Frame>
        <Frame>16,16</Frame>
        <Frame>15,16</Frame>
      </SpriteAnimation>
      <InterpolationVec4Animation name="a_idleLeftRot" variableName="belt_rotationLeft" targetValue="0, 0, 0, 1" animTime="600" playOnState="Action.Idle"/>
      <InterpolationVec4Animation name="a_walkLeftRot" variableName="belt_rotationLeft" targetValue="0, 0, 0, 1" animTime="400" playOnState="Action.Walk"/>
      <InterpolationVec4Animation name="a_fallLeftRotFallStraight" variableName="belt_rotationLeft" targetValue="15, 0, 0, 1" animTime="1000" playOnState="Action.FallStraight"/>
      <InterpolationVec4Animation name="a_fallLeftRotFallDiagonal" variableName="belt_rotationLeft" targetValue="15, 0, 0, 1" animTime="400" playOnState="Action.FallDiagonal"/>
      <InterpolationVec4Animation name="a_jumpLeftRotJumpStraight" variableName="belt_rotationLeft" targetValue="-40, 0, 0, 1" animTime="1000" playOnState="Action.JumpStraight"/>
      <InterpolationVec4Animation name="a_jumpLeftRotJumpDiagonal" variableName="belt_rotationLeft" targetValue="10, 0, 0, 1" animTime="400" playOnState="Action.JumpDiagonal"/>

      <InterpolationVec4Animation name="a_idleRightRot" variableName="belt_rotationRight" targetValue="0, 0, 0, 1" animTime="600" playOnState="Action.Idle"/>
      <InterpolationVec4Animation name="a_walkRightRot" variableName="belt_rotationRight" targetValue="40, 0, 0, 1" animTime="400" playOnState="Action.Walk"/>
      <InterpolationVec4Animation name="a_fallRightRotFallStraight" variableName="belt_rotationRight" targetValue="-15, 0, 0, 1" animTime="1000" playOnState="Action.FallStraight"/>
      <InterpolationVec4Animation name="a_fallRightRotFallDiagonal" variableName="belt_rotationRight" targetValue="-15, 0, 0, 1" animTime="400" playOnState="Action.FallDiagonal"/>
      <InterpolationVec4Animation name="a_jumpRightRotJumpStraight" variableName="belt_rotationRight" targetValue="40, 0, 0, 1" animTime="1000" playOnState="Action.JumpStraight"/>
      <InterpolationVec4Animation name="a_jumpRightRotJumpDiagonal" variableName="belt_rotationRight" targetValue="40, 0, 0, 1" animTime="400" playOnState="Action.JumpDiagonal"/>
    </Animations>
    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="JumpStraight" />
          <State name="JumpDiagonal" />
          <State name="FallStraight" />
          <State name="FallDiagonal" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|FallStraight|FallDiagonal">
            <Condition>
              <IsAction>IDLE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|FallDiagonal|FallStraight">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">JUMP</IsAction>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition to="JumpStraight" from="Idle|Walk|FallStraight|JumpDiagonal|FallDiagonal">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="JumpDiagonal" from="Idle|Walk|FallStraight|JumpStraight|FallDiagonal">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="FallStraight" from="Walk|FallDiagonal|JumpStraight|JumpDiagonal|Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="FallDiagonal" from="Walk|FallStraight|JumpStraight|JumpDiagonal|Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="randomWingSparklesLeft" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="randomizeInterval">true</Set>
          <Set name="intervalMin">0.2</Set>
          <Set name="intervalMax">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_sparkle</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <Select name="initialRotationRate" input="randomNumber">
            <Item>-180</Item>
            <Item>180</Item>
          </Select>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 0</KeyFrame>
            <KeyFrame>0.3, 0.5, 0.5</KeyFrame>
            <KeyFrame>0.6, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-24,-32" max="-16,-8"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="randomWingSparklesRight" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="randomizeInterval">true</Set>
          <Set name="intervalMin">0.2</Set>
          <Set name="intervalMax">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_sparkle</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <Select name="initialRotationRate" input="randomNumber">
            <Item>-180</Item>
            <Item>180</Item>
          </Select>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 0</KeyFrame>
            <KeyFrame>0.3, 0.5, 0.5</KeyFrame>
            <KeyFrame>0.6, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="16,-8" max="24,-32"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <VariableMap>
      <Set name="belt_rotationLeft">0, 0, 0, 1</Set>
      <Set name="belt_rotationRight">0, 0, 0, 1</Set>
    </VariableMap>
  </Data>
  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_bow" offset="0,-17" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="s_bow" offset="0,-17" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
      <Group>
        <Rotate>belt_rotationLeft</Rotate>
        <SpriteRender name="s_ribbonLeft" offset="-2,-15" alignmentLeft="UPPER_LEFT" alignmentRight="UPPER_RIGHT"/>
      </Group>
      <Group>
        <Rotate>belt_rotationRight</Rotate>
        <Group onState="Action.Idle">
          <SpriteRender name="s_ribbonRight" offset="2,-15" alignmentLeft="UPPER_RIGHT" alignmentRight="UPPER_LEFT"/>
        </Group>
        <Group onState="Action.Walk|Action.JumpStraight|Action.JumpDiagonal|Action.FallStraight|Action.FallDiagonal">
          <SpriteRender name="s_ribbonRight" offset="2,-15" flip="1,0" alignmentLeft="UPPER_RIGHT" alignmentRight="UPPER_LEFT"/>
        </Group>
      </Group>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_snowflakes" fileName="game/particles12.rttex" textureSize="32" frame="4,1" />
		<Sprite name="s_snowflakesHit" fileName="game/particles12.rttex" textureSize="32" frame="4,2" />
		<Sprite name="s_sword" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="7,6" />
		<Sprite name="s_punchCurve" fileName="game/particles12.rttex" textureSize="32" frame="4,0" />
		<Sprite name="s_HitStampParticle" fileName="game/particles12.rttex" textureSize="32" frame="6,0" />
		<Animations>
			<SpriteAnimation name="a_snowflakes" sprite="s_snowflakes">
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakesHit" sprite="s_snowflakesHit">
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="UserNameOffset">15</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">false</Set>
			</Default>
		</RenderOptions>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_hitSparkles" >
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">4</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakes</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Random name="finalScale" min="0.1" max="0.4"/>
					<Set name="initialScale">1, 1</Set>
					<Set name="interpolateScale">true</Set>				
					<Curve name="initialRotationRate">
						<KeyFrame>0, 15</KeyFrame>
						<KeyFrame>1, 5</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="0" max="360" />
					<Random name="offset" min="0, -16" max="16, 16" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="Punch.False">
				<Emitter>
					<Random name="offset" min="-22, -42" max="4, -25" />
					<Random name="emissionInterval" min="0.6" max="1" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakesHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.1</KeyFrame>
						<KeyFrame>0.5, 0.4</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">2</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_backHandSparkles" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="Punch.False">
				<Emitter>
					<Random name="offset" min="-22, -42" max="4, -25" />
					<Random name="emissionInterval" min="0.30" max="0.5" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakes</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.1</KeyFrame>
						<KeyFrame>0.5, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="15" max="60"/>
					<Random name="finalScale" min="0.3" max="0.6"/>
					<Set name="initialScale">0.8, 0.8</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">0.85</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">14,-16</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.25</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punchCurve</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initialScale">0.3,0.3</Set>
					<Set name="finalScale">2,2.5</Set>
					<Set name="interpolateScale">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_stamp_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_HitStampParticle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 1.3,1.3</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">215</Set>
			</AvatarTransform>
		</Update>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<SpriteRender name="s_sword" offset="13.7,3" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackHandItem>
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="animTime">500</Set>
				<Set name="Curve">
					<KeyFrame>0.0, 215</KeyFrame>
					<KeyFrame>0.3, 360</KeyFrame>
					<KeyFrame>0.8, 360</KeyFrame>
					<KeyFrame>0.81, 215</KeyFrame>
					<KeyFrame>1, 215</KeyFrame>
				</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_hitSparkles" />
			<ParticleSystemUpdate name="hit_stamp_particle" />
		</OnDamagedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wand" fileName="game/particles_large13.rttex" textureSize="64" frame="14,9" />
    <Sprite name="s_wandGlow" fileName="game/particles_large13.rttex" textureSize="64" frame="15,9" />
    <Sprite name="s_Sparkles" fileName="game/particles9.rttex" textureSize="32" frame="28,23" />
    <Sprite name="s_wandGodRays" fileName="game/particles_large13.rttex" textureSize="64" frame="12,13" />
    <Sprite name="s_damageGodRays" fileName="game/particles_large13.rttex" textureSize="64" frame="15,7" />
    
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <Animations>
      <SpriteAnimation name="a_wandGodRays" sprite="s_wandGodRays">
        <Frame>12,13</Frame>
        <Frame>13,13</Frame>
        <Frame>14,13</Frame>
        <Frame>15,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Sparkles" sprite="s_Sparkles" animTime="400" autoPlay="true" isLoop="true">
        <Frame>28,23</Frame>
        <Frame>29,23</Frame>
        <Frame>30,23</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_wandGlow" isLoop="true" playOnState="Punch.False" sprite="s_wandGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_wandGlowPunch" isLoop="true" playOnState="Punch.True" sprite="s_wandGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_wandSparkles">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.4</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Sparkles</Set>
          <Set name="inSpecificOrder">true</Set>
          <Random name="offset" min="-8,-8.1" max="8,8.1" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.85</Set>
          <Random name="initialScale" min="0.3" max="0.8"/>
          <Random name="initialRotationRate" min="-180" max="180"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_wandSparklesMove">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Sparkles</Set>
          <Set name="inSpecificOrder">true</Set>
          <Random name="offset" min="-8,-8.1" max="8,8.1" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.85</Set>
          <Random name="initialScale" min="0.3" max="0.8"/>
          <Random name="initialRotationRate" min="-180" max="180"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_wandSparklesPunchTarget">
        <Emitter attachment="targetPos">
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Sparkles</Set>
          <Random name="offset" min="-8,-8.1" max="8,8.1" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.85</Set>
          <Random name="initialScale" min="0.3" max="0.8"/>
          <Random name="initialRotationRate" min="-180" max="180"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_wandGodRays">
        <Emitter>
          <Set name="lifeTime">15</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true" usePlayerFacing="true">
          <Set name="sprite">s_wandGodRays</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>0.5, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 0.75, 0.75</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_wandGodRaysIdle">
        <Emitter>
          <Set name="lifeTime">15</Set>
          <Set name="emissionInterval">0.8</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true" usePlayerFacing="true">
          <Set name="sprite">s_wandGodRays</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.25, 0.2</KeyFrame>
            <KeyFrame>0.75, 0.2</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>0.5, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 0.75, 0.75</KeyFrame>
          </Curve>
          <Set name="lifeTime">2</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_damageGodRays">
        <Emitter>
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_damageGodRays</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.75</KeyFrame>
            <KeyFrame>0.5, 1.25, 1.25</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>

    </ParticleSystems>
    
    <VariableMap>
      <Set name="wand_offset">6, 2, 0</Set>
      <Set name="sparkles_offset_right">0, -12, 0</Set>
    </VariableMap>
    
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmAfterItem">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  
  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">NORMAL</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">700</Set>
        <Set name="Curve">
          <KeyFrame>0.0, 270</KeyFrame>
          <KeyFrame>0.5, 300</KeyFrame>
          <KeyFrame>1, 270</KeyFrame>
        </Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <Translate>wand_offset</Translate>
      <Rotate>90,0,0,1</Rotate>
      <SpriteRender name="s_wand" blend="PREMULTIPLIED_ALPHA" rotationPoint="0,1" alignment="CENTER" rotateOffset="true"/>
      <SpriteRender name="s_wandGlow" blend="PREMULTIPLIED_ALPHA" drawShadow="false" rotationPoint="0,1" alignment="CENTER" rotateOffset="true"/>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
      </StopIf>
      <Group>
        <Translate>sparkles_offset_right</Translate>
        <StopIf>
          <IsVariableBool name="isMannequin">true</IsVariableBool>
        </StopIf>
        <ParticleSystemUpdate name="ps_wandSparkles"/>
        <ParticleSystemRender name="ps_wandSparkles" onState="Motion.Idle"/>
        <ParticleSystemUpdate name="ps_wandSparklesMove"/>
        <ParticleSystemRender name="ps_wandSparklesMove" onState="Motion.Move"/>
        <ParticleSystemUpdate name="ps_wandGodRays" onState="Punch.True"/>
        <ParticleSystemUpdate name="ps_wandGodRaysIdle"/>
        <ParticleSystemRender name="ps_wandGodRaysIdle"/>
        <ParticleSystemUpdate name="ps_wandSparklesPunchTarget" onState="Punch.True"/>
      </Group>
    </RenderBackHandItem>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_damageGodRays" />
    </OnDamagedTile>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="item_Sprite" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="31,7"/>

  </Data>

  <RenderRules>
    <RenderHat>
      <SpriteRender name="item_Sprite" offset="-13,-13" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER"/>
    </RenderHat>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_frontArm" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="28,6" />
    <Sprite name="s_backArm" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="29,6" />
    <Sprite name="s_robe" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="30,6" />
    <Sprite name="s_punchGodRays" fileName="game/particles_large17.rttex" textureSize="64" frame="10,1" />
    <Sprite name="s_damageGodRays" fileName="game/particles_large17.rttex" textureSize="64" frame="14,1" />
    <Sprite name="s_punchSparkles" fileName="game/particles12.rttex" textureSize="32" frame="0,17" />
    <Sprite name="s_transform" fileName="game/tf_page4.rttex" textureSize="64" frame="0,15" />

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="Idle">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Transform">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="Jump" />
          <State name="Fall" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|Fall|Punch|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|Fall|Punch|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Walk|Fall|Punch">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Walk|Punch">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="Idle|Walk|Jump|Fall">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="IsTransformed">
        <States>
          <State name="No" />
          <State name="Yes" />
        </States>
        <Transitions>
          <Transition to="Yes" from="No">
            <Condition>
              <IsItemTransformed>true</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="No" from="Yes">
            <Condition>
              <IsItemTransformed>false</IsItemTransformed>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <VariableMap>
      <Set name="frontArmRotation">0, 0, 0, 1</Set>
      <Set name="backArmRotation">0, 0, 0, 1</Set>
    </VariableMap>

    <Animations>
      <SpriteAnimation name="a_robe" sprite="s_robe" isLoop="true" animTime="200" playOnState="Motion.Idle">
        <Frame>30,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_robePunch" sprite="s_robe" isLoop="true" animTime="200" playOnState="Motion.Punch">
        <Frame>30,6</Frame>
        <Frame>31,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchGodRays" sprite="s_punchGodRays">
        <Frame>10,1</Frame>
        <Frame>11,1</Frame>
        <Frame>12,1</Frame>
        <Frame>13,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchSparkles" sprite="s_punchSparkles" animTime="850">
        <Frame>2,17</Frame>
        <Frame>0,17</Frame>
        <Frame>1,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_idle" sprite="s_transform" animTime="1600" isLoop="true" playOnState="Transform.Idle">
        <Frame>0,15</Frame>
        <Frame>1,15</Frame>
        <Frame>2,15</Frame>
        <Frame>3,15</Frame>
        <Frame>4,15</Frame>
        <Frame>5,15</Frame>
        <Frame>6,15</Frame>
        <Frame>7,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_walk" sprite="s_transform" animTime="500" isLoop="true" playOnState="Transform.Walk">
        <Frame>8,15</Frame>
        <Frame>9,15</Frame>
        <Frame>10,15</Frame>
        <Frame>11,15</Frame>
        <Frame>12,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump" sprite="s_transform" animTime="400" isLoop="true" playOnState="Transform.Jump">
        <Frame>9,14</Frame>
        <Frame>10,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall" sprite="s_transform" animTime="400" isLoop="true" playOnState="Transform.Fall">
        <Frame>11,14</Frame>
        <Frame>12,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punch" sprite="s_transform" animTime="200" isLoop="true" playOnState="Transform.Punch">
        <Frame>13,14</Frame>
        <Frame>14,14</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_punchGodRays" updateStage="AddClothingParticles" updateState="Motion.Punch">
        <Emitter>
          <Set name="lifeTime">15</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0,-44</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_punchGodRays</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>0.5, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 0.75, 0.75</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchSparkles" updateStage="AddClothingParticles" updateState="Motion.Punch">
        <Emitter>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,-44</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchSparkles</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-16,-16" max="16,16" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.85</Set>
          <Random name="initialScale" min="0.3" max="0.8"/>
          <Random name="initialRotationRate" min="-180" max="180"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_sparklesPunchTarget" updateStage="AddClothingParticles" updateState="Motion.Punch">
        <Emitter attachment="targetPos">
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchSparkles</Set>
          <Random name="offset" min="-8,-8.1" max="8,8.1" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.85</Set>
          <Random name="initialScale" min="0.3" max="0.8"/>
          <Random name="initialRotationRate" min="-180" max="180"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_damageGodRays" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_damageGodRays</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.75</KeyFrame>
            <KeyFrame>0.5, 1.25, 1.25</KeyFrame>
            <KeyFrame>1, 1.25, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmInfected">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_backArm" offset="-3,-6" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" rotateOffset="true" rotationPoint="0,0"/>
    </RenderBackHandItem>
    <RenderHandItem>
      <SpriteRender name="s_frontArm" offset="-1,-1" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" rotateOffset="true" rotationPoint="0,0" />
    </RenderHandItem>
    <RenderFrontArm>
      <SpriteRender name="s_robe" alignment="DOWN_CENTER" useFixedRotation="true" fixedRotation="0"/>
    </RenderFrontArm>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsItemTransformed>true</IsItemTransformed>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">SURPRISED</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">220</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">150</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderTransform>
      <SpriteRender name="s_transform" blend="PREMULTIPLIED_ALPHA" offset="0,-8" />
    </RenderTransform>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="granite_idle" fileName="game/smack/granite_idle.rttex" textureSize="128"/>
		<Sprite name="granite_punch" fileName="game/smack/granite_punch.rttex" textureSize="256"/>
		<Sprite name="granite_walk" fileName="game/smack/granite_run.rttex" textureSize="128"/>
		<Sprite name="granite_jump" fileName="game/smack/granite_jump.rttex" textureSize="128"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
			</States>
			<Transitions>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition>
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>			
			<SpriteAnimation name="granite_idle_Animation" playOnState="Motion.Idle" sprite="granite_idle" animTime="1200" isLoop="true">
				<Frame>0,0</Frame> <Frame>1,0</Frame> <Frame>2,0</Frame> <Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>5,0</Frame> <Frame>6,0</Frame> <Frame>7,0</Frame> <Frame>0,1</Frame> <Frame>1,1</Frame> <Frame>2,1</Frame> <Frame>3,1</Frame> <Frame>4,1</Frame> <Frame>5,1</Frame> <Frame>6,1</Frame> <Frame>7,1</Frame> <Frame>0,2</Frame> <Frame>1,2</Frame> <Frame>2,2</Frame> <Frame>3,2</Frame> <Frame>4,2</Frame> <Frame>5,2</Frame> <Frame>6,2</Frame> <Frame>7,2</Frame> <Frame>0,3</Frame> <Frame>1,3</Frame> <Frame>2,3</Frame> <Frame>3,3</Frame> <Frame>4,3</Frame> <Frame>5,3</Frame> <Frame>6,3</Frame> <Frame>7,3</Frame> <Frame>0,4</Frame> <Frame>1,4</Frame> <Frame>2,4</Frame> <Frame>3,4</Frame> <Frame>4,4</Frame> <Frame>5,4</Frame> <Frame>6,4</Frame> <Frame>7,4</Frame> <Frame>0,5</Frame> <Frame>1,5</Frame> <Frame>2,5</Frame> <Frame>3,5</Frame> <Frame>4,5</Frame> <Frame>5,5</Frame> <Frame>6,5</Frame> <Frame>7,5</Frame> <Frame>0,6</Frame> <Frame>1,6</Frame> <Frame>2,6</Frame> <Frame>3,6</Frame> <Frame>4,6</Frame> <Frame>5,6</Frame> <Frame>6,6</Frame> <Frame>7,6</Frame> <Frame>0,7</Frame> <Frame>1,7</Frame> <Frame>2,7</Frame> <Frame>3,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="granite_Punch_Animation" playOnState="Motion.Punch" sprite="granite_punch" animTime="350" isLoop="true">
				<Frame>0,0</Frame> <Frame>1,0</Frame> <Frame>2,0</Frame> <Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>5,0</Frame> <Frame>6,0</Frame> <Frame>7,0</Frame> <Frame>0,1</Frame> <Frame>1,1</Frame> <Frame>2,1</Frame> <Frame>3,1</Frame> <Frame>4,1</Frame> <Frame>5,1</Frame> <Frame>6,1</Frame> <Frame>7,1</Frame> <Frame>0,2</Frame> <Frame>1,2</Frame> <Frame>2,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="granite_Jump_Animation" playOnState="Motion.Jump" sprite="granite_jump" animTime="200">
				<Frame>0,0</Frame> <Frame>1,0</Frame> <Frame>2,0</Frame> <Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>5,0</Frame> <Frame>6,0</Frame> <Frame>7,0</Frame> <Frame>0,1</Frame> <Frame>1,1</Frame> <Frame>2,1</Frame> <Frame>3,1</Frame> <Frame>4,1</Frame> <Frame>5,1</Frame> <Frame>6,1</Frame> <Frame>7,1</Frame> <Frame>0,2</Frame> <Frame>1,2</Frame> <Frame>2,2</Frame> <Frame>3,2</Frame> <Frame>4,2</Frame> <Frame>5,2</Frame> <Frame>6,2</Frame> <Frame>7,2</Frame> <Frame>0,3</Frame> <Frame>1,3</Frame> <Frame>2,3</Frame> <Frame>3,3</Frame> <Frame>4,3</Frame> <Frame>5,3</Frame> <Frame>6,3</Frame> <Frame>7,3</Frame> <Frame>0,4</Frame> <Frame>1,4</Frame> <Frame>2,4</Frame> <Frame>3,4</Frame> <Frame>4,4</Frame> <Frame>5,4</Frame> <Frame>6,4</Frame> <Frame>7,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="granite_Fall_Animation" playOnState="Motion.Fall" sprite="granite_jump" animTime="400">
				<Frame>7,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="granite_Walk_Animation" playOnState="Motion.Move" sprite="granite_walk" animTime="400" isLoop="true">
				<Frame>0,0</Frame> <Frame>1,0</Frame> <Frame>2,0</Frame> <Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>5,0</Frame> <Frame>6,0</Frame> <Frame>7,0</Frame> <Frame>0,1</Frame> <Frame>1,1</Frame> <Frame>2,1</Frame> <Frame>3,1</Frame> <Frame>4,1</Frame> <Frame>5,1</Frame> <Frame>6,1</Frame> <Frame>7,1</Frame> <Frame>0,2</Frame> <Frame>1,2</Frame> <Frame>2,2</Frame> <Frame>3,2</Frame> <Frame>4,2</Frame> <Frame>5,2</Frame> <Frame>6,2</Frame> <Frame>7,2</Frame> <Frame>0,3</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">5000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">40</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="granite_idle" offset="0,-5039" drawShadow="true" onState="Motion.Idle" />
			<SpriteRender name="granite_walk" offset="0,-5039" drawShadow="true" onState="Motion.Move" />
			<SpriteRender name="granite_jump" offset="0,-5039" drawShadow="true" onState="Motion.Jump" />
			<SpriteRender name="granite_jump" offset="0,-5039" drawShadow="true" onState="Motion.Fall" />
			<SpriteRender name="granite_punch" offset="0,-5039" drawShadow="true" onState="Motion.Punch" />
			
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="Sprite26" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="24,29" />
		<Sprite name="s_muzzle" fileName="game/particles12.rttex" textureSize="32" frame="31,2" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="30,3" />
		<Animations />
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="MuzzleFlash1" updateStage="RenderBackHandItem" updateState="Action.Punch" renderStage="RenderBackHandItem">
				<Emitter attachment="handspotRoot" onPunchCount="odd">
					<Set name="offset">0, 25</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzle</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Punch1" updateStage="RenderBackHandItem" updateState="Action.Punch">
				<Emitter attachment="handspotRoot" onPunchCount="odd">
					<Set name="offset">0, 4</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<Set name="initialAngle">90</Set>
					<Set name="flipY" source="punch.flipY"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="MuzzleFlash2" updateStage="RenderHandItem" updateState="Action.Punch" renderStage="RenderHandItem">
				<Emitter attachment="handspotRoot" onPunchCount="even">
					<Set name="offset">0, 25</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzle</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialAngle">90</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Punch2" updateStage="RenderHandItem" updateState="Action.Punch">
				<Emitter attachment="handspotRoot" onPunchCount="even">
					<Set name="offset">0, 4</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<Set name="initialAngle">90</Set>
					<Set name="flipY" source="punch.flipY"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="punch.flipY">false</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<SpriteRender name="Sprite26" drawShadow="true" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
		</RenderHandItem>
		<RenderFrontArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderFrontArm>
		<RenderBackArm>
			<ContextUpdate type="PositionSinPulse" onState="Action.Punch">
				<Set name="period">-200</Set>
				<Set name="scale">-2</Set>
				<Set name="clamp">true</Set>
			</ContextUpdate>
		</RenderBackArm>
		<RenderBackHandItem>
			<StopIf>
				<IsAction>BUILD</IsAction>
			</StopIf>
			<Translate>-2,-5,0</Translate>
			<Group onState="Action.Punch">
				<StopIf>
					<IsZombified>true</IsZombified>
				</StopIf>
				<SpriteRender name="Sprite26" drawShadow="true" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
			</Group>
			<Group onState="Action.None">
				<SpriteRender name="Sprite26" drawShadow="true" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
			</Group>
		</RenderBackHandItem>
 		<OnPunchStart>
			<ArithmethicOperation LeftHandVariableName="punch.flipY" RightHandVariableName="false" OperationType="Set" />
			<StopIf>
				<IsFacingLeft>false</IsFacingLeft>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="punch.flipY" RightHandVariableName="true" OperationType="Set" />
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_shirt" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="14,23"/>
    <Sprite name="s_chunksTrail" fileName="game/particles11.rttex" textureSize="32" frame="15,29"/>
    <Sprite name="s_groundTrail" fileName="game/particles11.rttex" textureSize="32" frame="12,30"/>
    
    <StateMachines>
      <StateMachine name="sm_moveTrail">
        <States>
          <State name="Idle"/>
          <State name="Move"/>
        </States>
        <Transitions>
          <Transition from="Idle" to="Move" >
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Move" to="Idle" >
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="sm_groundTrail">
        <States>
          <State name="Idle"/>
          <State name="Move"/>
        </States>
        <Transitions>
          <Transition from="Idle" to="Move" >
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Move" to="Idle" >
            <Condition type="or">
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_shirt" sprite="s_shirt" autoPlay="true" animTime="1000" isLoop="true">
        <Frame>14,23</Frame>
        <Frame>15,23</Frame>
        <Frame>16,23</Frame>
        <Frame>17,23</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_groundTrail" sprite="s_groundTrail">
        <Frame>12,30</Frame>
        <Frame>13,30</Frame>
        <Frame>14,30</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_cakeChunks" updateStage="AddClothingParticles" renderStage="RenderShirt" updateState="sm_moveTrail.Move">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">10</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Random name="offset" min="-16, -14" max="-16, -6"/>
          <Random name="emissionInterval" min="0.05" max="0.2"/>
        </Emitter>
        <Particle usePlayerFacing="true" velocityRelativeToPlayerSpeed="true">
          <Set name="sprite">s_chunksTrail</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.6</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 30</Set>
          <Set name="initalRGB">1,1,1</Set>
          <Set name="initialScale">1,1</Set>
          <Set name="interpolateAlpha">true</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">0</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_groundTrail" updateStage="AddClothingParticles" renderStage="RenderShirt" updateState="sm_groundTrail.Move">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">-32,0</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_groundTrail</Set>
          <Set name="renderAlignment">DOWN_CENTER</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.2</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">1.25</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderShirt>
      <SpriteRender name="s_shirt" offset="0,-16" blend="PREMULTIPLIED_ALPHA" />
    </RenderShirt>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_frontArm" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="29,25" />
    <Sprite name="s_backArm" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="31,25" />
    <Sprite name="s_landingParticleFront" fileName="game/particles11.rttex" textureSize="32" frame="28,29" />
    <Sprite name="s_landingParticleBack" fileName="game/particles11.rttex" textureSize="32" frame="30,29" />
    <Sprite name="s_punchSlash" fileName="game/particles11.rttex" textureSize="32" frame="31,30" />
    <Sprite name="s_hitFlash" fileName="game/particles11.rttex" textureSize="32" frame="30,30" />

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Dance" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Dance|Punch">
            <Condition type="and">
              <IsDancing>false</IsDancing>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Dance" from="Idle|Punch">
            <Condition type="and">
              <IsDancing>true</IsDancing>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="Idle|Dance">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="LandingParticle">
        <States>
          <State name="OnGround" />
          <State name="InAir" />
          <State name="AirToGround" />
        </States>
        <Transitions>
          <Transition to="OnGround" from="AirToGround">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="InAir" from="OnGround">
            <Condition>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="AirToGround" from="InAir">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <VariableMap>
      <Set name="frontArmRotation">0, 0, 0, 1</Set>
      <Set name="backArmRotation">0, 0, 0, 1</Set>
    </VariableMap>

    <Animations>
      <SpriteCurveAnimation name="backArmPunchScaled" sprite="s_backArm" isLoop="true" playOnState="Motion.Punch" animTime="100">
        <Curve name="scale">
          <KeyFrame>0.f, 1.5f, 1.5f</KeyFrame>
          <KeyFrame>1.f, 1.5f, 1.5f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="backArmPunchScaledIdle" sprite="s_backArm" isLoop="true" playOnState="Motion.Idle|Motion.Dance" animTime="100">
        <Curve name="scale">
          <KeyFrame>0.f, 1.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <CurveAnimationVec4 name="backArmRotDance" isLoop="true" playOnState="Motion.Dance" animTime="500">
        <Curve name="backArmRotation">
          <KeyFrame>0, 30, 0,0,1</KeyFrame>
          <KeyFrame>0.5, -30, 0,0,1</KeyFrame>
          <KeyFrame>1, 30, 0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
      <CurveAnimationVec4 name="frontArmRotDance" isLoop="true" playOnState="Motion.Dance" animTime="500">
        <Curve name="frontArmRotation">
          <KeyFrame>0, 30, 0,0,1</KeyFrame>
          <KeyFrame>0.5, -30, 0,0,1</KeyFrame>
          <KeyFrame>1, 30, 0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
      <SpriteAnimation name="a_landingParticlesFront" sprite="s_landingParticleFront" isLoop="true" animTime="200" autoPlay="true">
        <Frame>28,29</Frame>
        <Frame>29,29</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_landingParticlesBack" sprite="s_landingParticleBack" isLoop="true" animTime="200" autoPlay="true">
        <Frame>30,29</Frame>
        <Frame>31,29</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_landingParticlesRightFront" updateStage="AddClothingParticles"  updateState="LandingParticle.AirToGround">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="offset">0,5</Set>
          <Set name="useCharacterPos">true</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_landingParticleFront</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">DOWN_CENTER</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialVelocity" min="25, 0" max="50, 0" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="offset">18,0</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_landingParticlesLeftFront" updateStage="AddClothingParticles"  updateState="LandingParticle.AirToGround">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="offset">0,5</Set>
          <Set name="useCharacterPos">true</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_landingParticleFront</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">DOWN_CENTER</Set>
          <Set name="lifeTime">1</Set>
          <Set name="flipX">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialVelocity" min="-25, 0" max="-50, 0" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="offset">-18,0</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_landingParticlesRightBack" updateStage="AddClothingParticles" renderStage="RenderBehind" updateState="LandingParticle.AirToGround">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="offset">0,6</Set>
          <Set name="useCharacterPos">true</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_landingParticleBack</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">DOWN_CENTER</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialVelocity" min="20, 0" max="30, 0" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="offset">18,0</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_landingParticlesLeftBack" updateStage="AddClothingParticles" renderStage="RenderBehind" updateState="LandingParticle.AirToGround">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="offsetFacing">false</Set>
          <Set name="offset">0,6</Set>
          <Set name="useCharacterPos">true</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_landingParticleBack</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">DOWN_CENTER</Set>
          <Set name="lifeTime">1</Set>
          <Set name="flipX">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="offset">-18,0</Set>
          <Random name="initialVelocity" min="-20, 0" max="-30, 0" />
          <Set name="inSpecificOrder">true</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchSlash" updateStage="AddClothingParticles" updateState="Motion.Punch">
        <Emitter>
          <Set name="offset">10,-12</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchSlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 0</KeyFrame>
            <KeyFrame>0.1, 0, 0</KeyFrame>
            <KeyFrame>0.1, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.15</KeyFrame>
            <KeyFrame>0.5, 0.15</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.6</Set>
          <Set name="rotateWithVelocity">true</Set>
          <VectorTo name="initialVelocity" source="targetPos"  duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlash">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hitFlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1.3, 1.3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.75</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmInfected">false</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackHandItem>
      <StopIf>
        <IsDancing>true</IsDancing>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_backArm" offset="-2,-7" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" rotateOffset="true" rotationPoint="0,0"/>
    </RenderBackHandItem>
    <RenderHandItem>
      <StopIf>
        <IsDancing>true</IsDancing>
      </StopIf>
      <SpriteRender name="s_frontArm" offset="0,-2" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" rotateOffset="true" rotationPoint="0,0" />
    </RenderHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1200</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>

    <RenderInFront>
      <ParticleSystemRender name="ps_landingParticlesLeftFront"/>
      <ParticleSystemRender name="ps_landingParticlesRightFront"/>
      <StopIf>
        <IsDancing>false</IsDancing>
      </StopIf>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <Group>
        <StopIf>
          <IsFacingLeft>true</IsFacingLeft>
        </StopIf>
        <Group>
          <Rotate>frontArmRotation</Rotate>
          <SpriteRender name="s_frontArm" offset="-8,-16" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" rotateOffset="true" rotationPoint="-8,-14" />
        </Group>
        <Group onState="Motion.Dance">
          <Rotate>backArmRotation</Rotate>
          <SpriteRender name="s_backArm" offset="8,-16" blend="PREMULTIPLIED_ALPHA" flip="1,0" alignment="UPPER_CENTER" rotateOffset="true" rotationPoint="8,-14" />
        </Group>
      </Group>
      <Group>
        <StopIf>
          <IsFacingLeft>false</IsFacingLeft>
        </StopIf>
        <Group>
          <Rotate>frontArmRotation</Rotate>
          <SpriteRender name="s_frontArm" offset="-8,-16" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" rotateOffset="true" rotationPoint="8,-14" />
        </Group>
        <Group onState="Motion.Dance">
          <Rotate>backArmRotation</Rotate>
          <SpriteRender name="s_backArm" offset="8,-16" blend="PREMULTIPLIED_ALPHA" flip="1,0" alignment="UPPER_CENTER" rotateOffset="true" rotationPoint="-8,-14" />
        </Group>
      </Group>
    </RenderInFront>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitFlash"/>
    </OnDamagedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_umbrella" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="3,0"/>
    <Sprite name="s_pet" fileName="game/pets/p_little_partern.rttex" textureSize="32" frame="0,0" />

    <StateMachines>
      <StateMachine name="Pet">
        <States>
          <State name="None"/>
          <State name="NoneAnimated"/>
          <State name="Up" />
          <State name="Down" />
          <State name="Horizontal" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch|Up|Down|Horizontal|NoneAnimated">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAnimationFinished>a_Idle_anim</IsAnimationFinished>
			  <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="NoneAnimated" from="None">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <CheckRandomRangeNumber EndNumber="100">0</CheckRandomRangeNumber>
            </Condition>
          </Transition>
          <Transition to="Up" from="Punch|None|Down|Horizontal|NoneAnimated">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Down" from="Punch|None|Up|Horizontal|NoneAnimated">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Horizontal" from="Punch|None|Down|Up|NoneAnimated">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
				<IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None|Up|Down|Horizontal|NoneAnimated">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Player">
        <States>
          <State name="OnGround"/>
          <State name="InAir"/>
        </States>
        <Transitions>
          <Transition to="OnGround" from="InAir">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="InAir" from="OnGround">
            <Condition>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_non_jump" playOnState="Player.OnGround" sprite="s_umbrella" animTime="100">
        <Frame>3, 0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump" playOnState="Player.InAir" sprite="s_umbrella" animTime="100">
        <Frame>4, 0</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_rotate_jump_right" sprite="s_umbrella" playOnState="Player.InAir" useFacing="RIGHT" isLoop="true">
        <Curve name="rotation">
          <KeyFrame>0, 140</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_rotate_jump_left" sprite="s_umbrella" playOnState="Player.InAir" useFacing="LEFT" isLoop="true">
        <Curve name="rotation">
          <KeyFrame>0, 220</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_rotate_on_ground" sprite="s_umbrella" playOnState="Player.OnGround" isLoop="true">
        <Curve name="rotation">
          <KeyFrame>0, 0</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="a_Attack" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.Punch">
        <Frame>3,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Fall" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.Down">
        <Frame>2,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Idle" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.None">
        <Frame>0,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Idle_anim" sprite="s_pet" animTime="1000" isLoop="false" playOnState="Pet.NoneAnimated">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>4,0</Frame>
        <Frame>3,0</Frame>
        <Frame>2,0</Frame>
        <Frame>1,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Jump" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.Up">
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Move" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.Horizontal">
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>0,1</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-32,0</Set>
        <Set name="UsePetForceFaceTime">false</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <Update>
      <AvatarTransform class="ArmAngle" onState="Player.InAir">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">-140</Set>
      </AvatarTransform>
    </Update>
    <RenderHandItem>
      <SpriteRender name="s_umbrella" offset="8,8" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="Player.OnGround"/>
      <SpriteRender name="s_umbrella" offset="5,16" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="Player.InAir"/>
    </RenderHandItem>
    <RenderPet>
      <SpriteRender name="s_pet" offset="-16,0" alignment="DOWN_CENTER" />
    </RenderPet>
    <UpdatePet>
      <ContextUpdate type="SetPetWalkRunJump">
        <Set name="PetWalkRunJump.minSpeed">500</Set>
        <Set name="PetWalkRunJump.distSpeedMult">10</Set>
      </ContextUpdate>
    </UpdatePet>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_GROWTRONIC_GLIDER">
	<Data>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="Punch"/>
					<State name="Sleep"/>
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Sleep">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsSleepingOnaBed>false</IsSleepingOnaBed>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Sleep">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Sleep" from="None|Punch">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Mobility">
				<States>
					<State name="Stationary"/>
					<State name="Moving"/>
				</States>
				<Transitions>
					<Transition to="Stationary" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Stationary">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Sprite name="s_glider_left" fileName="game/player_feet16.rttex" textureSize="32" frame="5,18"/>
		<Sprite name="s_glider_right" fileName="game/player_feet16.rttex" textureSize="32" frame="5,19"/>
		<Sprite name="s_trail" fileName="game/particles11.rttex" textureSize="32" frame="31,12"/>
		<Sprite name="s_missile" fileName="game/particles11.rttex" textureSize="32" frame="30,12"/>
		<Sprite name="s_muzzle" fileName="game/particles_large13.rttex" textureSize="64" frame="0,2"/>
		<Sprite name="s_hit" fileName="game/particles_large13.rttex" textureSize="64" frame="1,2"/>
		
		<Animations>
			<SpriteAnimation name="a_glider_left" playOnState="Action.None" sprite="s_glider_left" isLoop="true" animTime="300">
				<Frame>5,18</Frame>
				<Frame>6,18</Frame>
				<Frame>7,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glider_right" playOnState="Action.None" sprite="s_glider_right" isLoop="true" animTime="300">
				<Frame>5,19</Frame>
				<Frame>6,19</Frame>
				<Frame>7,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glider_left_punch" playOnState="Action.Punch" sprite="s_glider_left" isLoop="true" animTime="300">
				<Frame>8,18</Frame>
				<Frame>9,18</Frame>
				<Frame>10,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_glider_right_punch" playOnState="Action.Punch" sprite="s_glider_right" isLoop="true" animTime="300">
				<Frame>8,19</Frame>
				<Frame>9,19</Frame>
				<Frame>10,19</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_hit" sprite="s_hit" animTime="800">
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="ps_hit">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_missile">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_missile</Set>
					<Select name="offset" input="punchCount">
						<Item>-12, 0</Item>
						<Item>24, 0</Item>
					</Select>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_muzzle">
				<Emitter>
					<Set name="offset">6, -16</Set>
					<Set name="lifeTime">0</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzle</Set>
					<Select name="offset" input="punchCount">
						<Item>-15, 0</Item>
						<Item>15, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.2</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_trail">
				<Emitter>
					<Set name="offset">-30, 4</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true">
					<Set name="sprite">s_trail</Set>
					<Random name="offset" min="0, -4" max="0, 4"/>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1.25, 1.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialVelocity" min="-30, 0" max="-40, 0"/>
					<Random name="initialAngle" min="-45" max="45"/>
					<Set name="initialRotationRate">90</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-18</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="UserNameOffset">22</Set>
				<Set name="ShouldHover">true</Set>
				<Set name="NeedRenderBareFeetWithShoesItem">true</Set>
				<Set name="AllowChangePunchType">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
			  <Set name="armName">arm2Angle</Set>
			  <Set name="armAngle">45</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Mobility.Moving">
			  <Set name="armName">arm1Angle</Set>
			  <Set name="armAngle">-45</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<SpriteRender name="s_glider_left" offset="0,14" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT"/>
			<SpriteRender name="s_glider_right" offset="0,14" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT"/>
		</RenderShoes>
		<OnPunchStart>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>
			<ParticleSystemUpdate name="ps_muzzle"/>
			<ParticleSystemUpdate name="ps_missile"/>
		</OnPunchStart>
		<OnDamagedTile>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>
			<ParticleSystemUpdate name="ps_hit"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<StopIf>
				<IsSitting>true</IsSitting>
			</StopIf>
			<ParticleSystemUpdate name="ps_hit"/>
		</OnDestroyedTile>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_trail" onState="Mobility.Moving"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="ps_missile"/>
			<ParticleSystemOff name="ps_muzzle"/>
			<ParticleSystemOff name="ps_hit"/>
			<ParticleSystemOff name="ps_trail"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="Sprite10" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="14,0" />
        <Sprite name="Sprite39" fileName="game/particles_large16.rttex" textureSize="64,64" frame="0,7" />
        <Sprite name="Sprite152" fileName="game/particles12.rttex" textureSize="32,32" frame="29,5" />
        <Animations>
            <SpriteAnimation name="a_Idle" sprite="Sprite39" isLoop="true" animTime="300" playOnState="Punch.No">
                <Frame>0,7</Frame>
                <Frame>1,7</Frame>
                <Frame>2,7</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_Punch" sprite="Sprite39" isLoop="true" animTime="400" playOnState="Punch.Yes">
                <Frame>4,7</Frame>
                <Frame>5,7</Frame>
                <Frame>6,7</Frame>
				<Frame>7,7</Frame>
            </SpriteAnimation>
			<SpriteSinPulseAnimation name="a_Sprite39" sprite="Sprite39" autoPlay="true">
				<Parameter name="alpha">
					<Set name="period">5000</Set>
					<Set name="scale">0.2</Set>
					<Set name="offset">0.7</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_bob" sprite="Sprite39" autoPlay="true">
				<Parameter name="pos.y">
					<Set name="period">3000</Set>
					<Set name="scale">4</Set>
					<Set name="offset">0</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
        </Animations>
        <ParticleSystems>
            <ParticleSystem name="PS124">
                <Emitter attachment="targetPos2">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="lifeTime">0</Set>
                    <Random name="offset" min="-14,-112" max="14,-112" />
					<SetVar name="arrow.target.offset" source="offset"/>
                    <Set name="emissionInterval">0</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,0.5</KeyFrame>
                        <KeyFrame>1,1</KeyFrame>
                    </Curve>
                    <Set name="initialAngle">0</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="flipX">false</Set>
                    <Set name="flipY">false</Set>
                    <Set name="lifeTime">0.3</Set>
                    <Set name="relativeToEmitter">false</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Set name="initialScale">1,1</Set>
                    <Set name="sprite">Sprite152</Set>
                    <Set name="initialVelocity">0,280</Set>
					<Set name="blendingMode">ADDITIVE</Set>
                </Particle>
            </ParticleSystem>
			<ParticleSystem name="ps_hit">
                <Emitter attachment="targetPos2">
                    <Set name="delayTimer">0.3</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="emissionInterval">0</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
					<Set name="offset" source="arrow.target.offset"/>
                </Emitter>
                <Particle>
                    <Set name="initialAngle">0</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="flipX">false</Set>
                    <Set name="flipY">false</Set>
                    <Set name="lifeTime">1.3</Set>
                    <Set name="relativeToEmitter">false</Set>
                    <Set name="offset">0,-16</Set>
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Set name="initialScale">1,1</Set>
                    <Set name="sprite">Sprite152</Set>
					<Set name="blendingMode">ADDITIVE</Set>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>
		<VariableMap>
			<Set name="arrow.target.offset">0, 0</Set>
		</VariableMap>
		<TileStampData>
			<Set name="FileName">game/particles12.rttex</Set>
			<Set name="EndFrame">28,5</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PunchParticle">
				<States>
					<State name="No" ExitTime="0.4"/>
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes"/>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>
    </Data>
    <RenderRules>
		<Update>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<Group onState="PunchParticle.Yes">
				<ParticleSystemUpdate name="PS124" />
			</Group>
		</Update>
        <RenderChestItem>
            <SpriteRender name="Sprite10" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" drawShadow="true" />
        </RenderChestItem>
        <RenderBehind>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
            <Translate>-13,-8,0</Translate>
            <SpriteRender name="Sprite39" blend="PREMULTIPLIED_ALPHA" drawShadow="false" />
        </RenderBehind>
		<OnDamagedTile>
			<ArithmethicOperation LeftHandVariableName="arrow.target.offset.y" RightHandVariableName="0" OperationType="Set"/>
			<ParticleSystemUpdate name="ps_hit" />
		</OnDamagedTile>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_bow" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="6,10"/>
    <Sprite name="s_bowGlow" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="7,10"/>
    <Sprite name="s_sleeve" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="2,6"/>
    <Sprite name="s_sleeveGlow" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="3,6"/>
    <Sprite name="s_chest" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="0,6"/>
    <Sprite name="s_chestGlow" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="1,6"/>
    <Sprite name="s_arrow" fileName="game/particles12.rttex" textureSize="32" frame="20,16"/>
    <Sprite name="s_tileArrow" fileName="game/particles12.rttex" textureSize="32" frame="18,16"/>
    <Sprite name="s_tileDestroyArrow" fileName="game/particles12.rttex" textureSize="32" frame="19,16"/>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_bow" isLoop="true" playOnState="Punch.False" sprite="s_bow"  animTime="2000">
        <Frame>6,10</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_bowPunch" isLoop="true" playOnState="Punch.True" sprite="s_bow"  animTime="200">
        <Frame>7,10</Frame>
		<Frame>7,11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_bowGlowNoPunch" isLoop="true" playOnState="Punch.False" sprite="s_bowGlow"  animTime="2000">
        <Frame>7,10</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_bowGlowPunchSprite" isLoop="true" playOnState="Punch.True" sprite="s_bowGlow"  animTime="200">
        <Frame>7,10</Frame>
		<Frame>7,11</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_bowGlow" isLoop="true" playOnState="Punch.False" sprite="s_bowGlow" animTime="2000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_sleeveGlow" isLoop="true" playOnState="Punch.False" sprite="s_sleeveGlow" animTime="2000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_chestGlow" isLoop="true" playOnState="Punch.False" sprite="s_chestGlow" animTime="2000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_bowGlowPunch" isLoop="true" playOnState="Punch.True" sprite="s_bowGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_sleeveGlowPunch" isLoop="true" playOnState="Punch.True" sprite="s_sleeveGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_chestGlowPunch" isLoop="true" playOnState="Punch.True" sprite="s_chestGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>

    <VariableMap>
      <Set name="projectile_offset">0, 0</Set>
      <Set name="projectile_angle">0</Set>
    </VariableMap>

    <ParticleSystems>
      <ParticleSystem name="ps_punchProjectile" updateStage="RenderBackHandItem" updateState="Punch.True">
        <Emitter attachment="handspotRoot">
          <Set name="offset">-3, 0</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_arrow</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="renderAlignment">RIGHT_CENTER</Set>
          <Set name="lifeTime">0.2</Set>
          <Random name="targetPosOffset" min="-4,-4" max="4,4"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angleOutVar="projectile_angle"/>
          <Set name="rotateWithVelocity">true</Set>
          <SetVar name="projectile_offset" source="targetPosOffset"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tileArrow">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">false</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tileArrow</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.6</Set>
          <Set name="renderAlignment">RIGHT_CENTER</Set>
          <Set name="offset" source="projectile_offset"/>
          <Set name="initialAngle" source="projectile_angle"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tileDestroyArrow">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tileDestroyArrow</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.6</Set>
          <Set name="renderAlignment">RIGHT_CENTER</Set>
          <Set name="offset" source="projectile_offset"/>
          <Set name="initialAngle" source="projectile_angle"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
			<KeyFrame>0.2, 0</KeyFrame>
            <KeyFrame>0.7, 1</KeyFrame>
            <KeyFrame>0.9, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="HideParticlesOnTransform">true</Set>
      </Default>
    </RenderOptions>

    <TileStampData>
      <Set name="FileName">game/particles10.rttex</Set>
      <Set name="EndFrame">21,1</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>
  </Data>

  <RenderRules>
    <RenderFrontArm value="playerCenter">
      <SpriteRender name="s_chest" offset="0, -16" useFixedRotation="true" fixedRotation="0" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_chestGlow" offset="0, -16" useFixedRotation="true" fixedRotation="0" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
    </RenderFrontArm>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_bow" offset="-2,-2" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_bowGlow" offset="-2,-2" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      <SpriteRender name="s_sleeve" offset="-3,11" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_sleeveGlow" offset="-3,11" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
    </RenderBackHandItem>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1500</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <StopIf type="or">
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
      </StopIf>
      <ParticleSystemUpdate name="ps_tileArrow" />
      <ParticleSystemUpdate name="ps_tileDestroyArrow" />
    </OnDamagedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_front_hair" fileName="game/particles_large17.rttex" textureSize="64"/>
		<Sprite name="s_back_hair" fileName="game/particles_large17.rttex" textureSize="64"/>
		<Animations>
			<SpriteAnimation name="a_front_hair" autoPlay="true" sprite="s_front_hair" isLoop="true" animTime="1200">
				<Frame>8,4</Frame>
				<Frame>9,4</Frame>
				<Frame>10,4</Frame>
				<Frame>11,4</Frame>
				<Frame>12,4</Frame>
				<Frame>13,4</Frame>
				<Frame>14,4</Frame>
				<Frame>15,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_back_hair" autoPlay="true" sprite="s_back_hair" isLoop="true" animTime="1200">
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
				<Frame>10,5</Frame>
				<Frame>11,5</Frame>
				<Frame>12,5</Frame>
				<Frame>13,5</Frame>
				<Frame>14,5</Frame>
				<Frame>15,5</Frame>
			</SpriteAnimation>
		</Animations>
		
	</Data>

	<RenderRules>
		<RenderBackHair>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
			</StopIf>
			<SpriteRender name="s_back_hair" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackHair>
		<RenderHair>
			<SpriteRender name="s_front_hair" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderHair>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_HAIR_OF_FIONN">
	<Data>
		<Sprite name="item_Sprite" fileName="game/particles_large12.rttex" textureSize="64"/>
		
		<Animations>
			<SpriteAnimation name="item_animation" autoPlay="true" sprite="item_Sprite" isLoop="true" animTime="1200">
				<Frame>8,13</Frame>
				<Frame>9,13</Frame>
				<Frame>10,13</Frame>
				<Frame>11,13</Frame>
				<Frame>12,13</Frame>
				<Frame>13,13</Frame>
			</SpriteAnimation>
		</Animations>
		
	</Data>

	<RenderRules>
		<RenderHair>
			<SpriteRender name="item_Sprite" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderHair>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_back" fileName="game/particles_large18.rttex" textureSize="64" frame="11,6" />
    <Sprite name="s_godRays" fileName="game/particles_large18.rttex" textureSize="64" frame="12,6" />
    <Sprite name="s_leaves" fileName="game/particles.rttex" textureSize="32" frame="1,5" />

    <Animations>
      <SpriteCurveAnimation name="a_back" autoPlay="true" isLoop="true" sprite="s_back" animTime="2000">
        <Curve name="pos.y">
          <KeyFrame>0.f, -2</KeyFrame>
          <KeyFrame>0.5f, 2</KeyFrame>
          <KeyFrame>1.f, -2</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="a_godRays" sprite="s_godRays">
        <Frame>12,6</Frame>
        <Frame>13,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_leaves" sprite="s_leaves">
        <Frame>1,5</Frame>
        <Frame>2,5</Frame>
        <Frame>3,5</Frame>
        <Frame>4,5</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_godrays" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="offset">0, -28</Set>
          <Set name="enable">true</Set>
          <Set name="offsetFacing">false</Set>
          <Set name="emissionInterval">1.5</Set>
          <Set name="useCharacterPos">false</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_godRays</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_leaves_right" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="offset">20,-32</Set>
          <Random name="emissionInterval" min="0.75" max="1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.75</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true"  usePlayerFacing="true">
          <Set name="sprite">s_leaves</Set>
          <Random name="offset" min="0, -16" max="0, 16" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.3" max="0.4" />
          <Set name="useGravity">true</Set>
          <Set name="initialVelocity">5, 10</Set>
          <Random name="gravityVector" min="0,5" max="0,10" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_leaves_left" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="offset">-20,-32</Set>
          <Random name="emissionInterval" min="0.75" max="1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.7</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true" usePlayerFacing="true">
          <Set name="sprite">s_leaves</Set>
          <Random name="offset" min="0, 16" max="0, -16" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="flipX">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.3" max="0.4" />
          <Set name="useGravity">true</Set>
          <Set name="initialVelocity">5, 10</Set>
          <Random name="gravityVector" min="0,5" max="0,10" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="UserNameOffset">8</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_back" drawShadow="false" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_HARP_OF_LOVE">
	<Data>
		<Sprite name="item_Sprite" fileName="game/player_cosmetics3.rttex" textureSize="32"/>
		<Sprite name="heart_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="28,14"/>
		<Sprite name="sparkle_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="musicNote_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="29,14"/>
		<Sprite name="musicStav_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="24,15"/>
		<Sprite name="hit_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="danceParticle_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="29,14"/>
		
		<Animations>
			<SpriteAnimation name="Idle_Anim" playOnAction="IDLE|WALK|JUMP|FALL" sprite="item_Sprite">
				<Frame>16, 10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="Punch_Anim" playOnAction="PUNCH|DANCE" sprite="item_Sprite" animTime="800" isLoop="true">
				<Frame>17, 10</Frame>
				<Frame>18, 10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="MusicStav_Anim" playOnAction="PUNCH" sprite="musicStav_Sprite" animTime="800" isLoop="true">
				<Frame>24, 15</Frame>
				<Frame>25, 15</Frame>
				<Frame>26, 15</Frame>
				<Frame>27, 15</Frame>
				<Frame>28, 15</Frame>
				<Frame>29, 15</Frame>
				<Frame>30, 15</Frame>
				<Frame>31, 15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="Sparkle_Anim" autoPlay="false" sprite="sparkle_Sprite">
				<Frame>30, 14</Frame>
				<Frame>31, 14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="Hit_Anim" autoPlay="false" sprite="hit_Sprite">
				<Frame>30,14</Frame>
				<Frame>31,14</Frame>
				<Frame>28,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="DanceParticle_Anim" autoPlay="false" sprite="danceParticle_Sprite">
				<Frame>29,14</Frame>
				<Frame>28,14</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="note_particle">
				<Emitter>
					<Set name="infLifeTime">true</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.1</Set>
					<Set name="intervalMax">0.3</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" autoLifeTimeToTarget="true">
					<Set name="sprite">musicNote_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="offset">0,-14</Set>
					<Set name="initalRGB">1,1,1</Set>
					<RandomRadial name="initialVelocity" angleRange="-10,10" radiusRange="150,160" baseAnglePosition="targetPos" baseOffset="0,16"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.6, 0.6</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="heart_particle">
				<Emitter>
					<Set name="infLifeTime">true</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.1</Set>
					<Set name="intervalMax">0.3</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" autoLifeTimeToTarget="true">
					<Set name="sprite">heart_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="offset">0,-14</Set>
					<RandomRadial name="initialVelocity" angleRange="-10,10" radiusRange="150,160" baseAnglePosition="targetPos" baseOffset="0,16"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Select name="initialScale" input="punchCount">
						<Item>0.5,0.5</Item>
						<Item>1,1</Item>
					</Select>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="sparkle_particle">
				<Emitter>
					<Set name="infLifeTime">true</Set>
					<Set name="infParticles">false</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.1</Set>
					<Set name="intervalMax">0.3</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" autoLifeTimeToTarget="true">
					<Set name="sprite">sparkle_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="offset">0,-14</Set>
					<Set name="initalRGB">1,1,1</Set>
					<RandomRadial name="initialVelocity" angleRange="-10,10" radiusRange="150,160" baseAnglePosition="targetPos" baseOffset="0,16"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1,1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">10</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,60"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="dance_particle">
				<Emitter>
					<Set name="offset">0,-26</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="randomizeInterval">true</Set>
					<Set name="intervalMin">0.3</Set>
					<Set name="intervalMax">0.4</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">danceParticle_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">2</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Random name="offset" min="-15,0" max="15,0"/>
					<Random name="initialVelocity" min="-5,-10" max="5,-20"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
		
	</Data>

	<RenderRules>
		<RenderHandItem value="0,16">
			<SpriteRender name="item_Sprite" offset="0,0" blend="PREMULTIPLIED_ALPHA" stretchToTarget="false"/>

      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="musicStav_Sprite" offset="0,0" onAction="PUNCH" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true"
                    alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0" tintOverride="255,255,255,255"/>
		</RenderHandItem>
		<Update>
			<MusicSource onAction="DANCE">
				<Set name="MusicFile">audio/aibellharp.wav</Set>
			</MusicSource>
			<AvatarTransform class="Emotion" onAction="DANCE">
				<Set name="emotion">CHILLED|CHILLED2</Set>
				<Set name="interval">1000</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="DANCE">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-90</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="DANCE">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-90</Set>
				<Set name="pulseArmScale">25</Set>
				<Set name="pulseArmRate">500</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
			<ParticleSystemUpdate name="dance_particle" onAction="DANCE"/>
		</AddClothingParticles>
		<OnPunchStart>
 			<ParticleSystemUpdate name="note_particle"/>
 			<ParticleSystemUpdate name="heart_particle"/>
			<ParticleSystemUpdate name="sparkle_particle"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
				<Set name="pulseArmScale">25</Set>
				<Set name="pulseArmRate">500</Set>
			</AvatarTransform>
			<AvatarTransform class="Emotion">
				<Set name="emotion">CHILLED|CHILLED2</Set>
				<Set name="interval">1000</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDamagedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="hit_particle"/>
			<ParticleSystemOff name="note_particle"/>
			<ParticleSystemOff name="heart_particle"/>
			<ParticleSystemOff name="sparkle_particle"/>
			<ParticleSystemOff name="dance_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Left" fileName="game/player_feet16.rttex" textureSize="32" frame="27,22" />
    <Sprite name="s_Right" fileName="game/player_feet16.rttex" textureSize="32" frame="27,23" />
    <Sprite name="s_leaves" fileName="game/particles5.rttex" textureSize="32" frame="12,13" />
    <Sprite name="s_legs" fileName="game/player_sit.rttex" textureSize="32" frame="1,0" />
    <Animations>
      <SpriteAnimation name="a_leaves" sprite="s_leaves">
        <Frame>12,13</Frame>
        <Frame>13,13</Frame>
        <Frame>14,13</Frame>
        <Frame>15,13</Frame>
        <Frame>12,14</Frame>
        <Frame>13,14</Frame>
        <Frame>14,14</Frame>
        <Frame>15,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_stick_left" sprite="s_Left" animTime="800" autoPlay="true" isLoop="true">
        <Frame>27,22</Frame>
        <Frame>28,22</Frame>
        <Frame>29,22</Frame>
        <Frame>30,22</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_stick_right" sprite="s_Right" animTime="800" autoPlay="true" isLoop="true">
        <Frame>27,23</Frame>
        <Frame>28,23</Frame>
        <Frame>29,23</Frame>
        <Frame>30,23</Frame>
      </SpriteAnimation>
    </Animations>
    <Animations />
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="ClothingOffsetFromShoes">-6</Set>
        <Set name="UserNameOffset">12</Set>
        <Set name="RenderShoesWithMermaidTail">true</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="IsRidingBird">true</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShouldHover">true</Set>
      </Default>
    </RenderOptions>
    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_leaves">
        <Emitter>
          <Set name="offset">-20,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.8</Set>
          <Set name="particlesPerEmission">1</Set>
          <Random name="emissionInterval" min="0.025" max="0.1" />
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_leaves</Set>
          <Random name="offset" min="-8, -8" max="0, 0" />
          <Set name="lifeTime">1.5</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Select name="initialRotationRate" input="randomNumber">
            <Item>90</Item>
            <Item>-90</Item>
          </Select>
          <Set name="useGravity">true</Set>
          <Curve name="initialVelocity">
            <KeyFrame>0, -10</KeyFrame>
            <KeyFrame>0.2, -20, -10</KeyFrame>
            <KeyFrame>0.4, 50, -10</KeyFrame>
            <KeyFrame>0.6, -50, -10</KeyFrame>
            <KeyFrame>0.8, 50, -10</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Set name="gravityVector">0, 50</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <Update>
      <StopIf type="or">
        <IsAction>PUNCH</IsAction>
        <IsVariableBool name="onGround">false</IsVariableBool>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </Update>
    
    <RenderShoes>
      <Group>
        <Translate>0,10,0</Translate>
        <SpriteRender name="s_Left" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
        <SpriteRender name="s_Right" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />
      </Group>
      
      <Group>
        <Translate>0,-7,0</Translate>
        <SpriteRender name="s_legs" tintOverride="SKINORPANTS" />
      </Group>
      
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_leaves" onState="Motion.Moving"/>
    </RenderShoes>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_HealthCross" fileName="game/particles2.rttex" textureSize="32" frame="15,8" />
		<Sprite name="s_antenna" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="19,28" />
		<Sprite name="s_antenna_glow" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="20,28" />
		<Sprite name="s_antenna_glow2" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="20,28" />
		<Sprite name="s_antenna_skin" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="18,28" />
		<Sprite name="s_aura" fileName="game/particles_large15.rttex" textureSize="64" frame="7,9" />
		<Animations>
			<SpriteCurveAnimation name="a_antenna_glow" isLoop="true" autoPlay="true" sprite="s_antenna_glow" animTime="3000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="UserNameOffset">7</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_Aura" updateStage="AddClothingParticles" updateState="Action.Punch">
				<Emitter>
					<Set name="offset">0, -10</Set>
					<Set name="emissionInterval">0.15</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_aura</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-3, 3" max="0, 0" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.4, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 1, 1.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<Set name="initialVelocity">0, -100</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_HealthCross" updateStage="AddClothingParticles" updateState="Action.Punch">
				<Emitter>
					<Set name="offset">16, -20</Set>
					<Set name="offsetFacing">false</Set>
					<Random name="emissionInterval" min="0.2" max="0.4" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle usePlayerFacing="true" usePlayerFacing="true">
					<Set name="sprite">s_HealthCross</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-32, 32" max="0, 0" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5" max="1" />
					<Random name="lifeTime" min="0.6" max="1" />
					<Set name="initialVelocity">0, -50</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderFaceItem>
			<SpriteRender name="s_antenna_skin" offset="0,-15.5" alignment="DOWN_CENTER" tintOverride="SKIN" />
			<Group onState="Action.Punch">
				<SpriteRender name="s_antenna_glow2" offset="0,-15.5" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
			</Group>
			<Group onState="Action.None">
				<SpriteRender name="s_antenna" offset="0,-15.5" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
				<SpriteRender name="s_antenna_glow" offset="0,-15.5" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
			</Group>
		</RenderFaceItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_equipFront" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="1,1"/>
    <Sprite name="s_equip" fileName="game/particles_large16.rttex" textureSize="64" frame="7,8"/>
    <Sprite name="s_equipGlow" fileName="game/particles_large16.rttex" textureSize="64" frame="8,8"/>
    <Sprite name="s_muzzle" fileName="game/particles9.rttex" textureSize="32" frame="29,25"/>
    <Sprite name="s_projectile" fileName="game/particles12.rttex" textureSize="32" frame="5,10"/>
    <Sprite name="s_hit" fileName="game/particles12.rttex" textureSize="32" frame="6,10" />

    <Animations>
      <SpriteCurveAnimation name="a_equipGlow" isLoop="true" autoPlay="true" sprite="s_equipGlow" animTime="3000" playOnState="Motion.Idle">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="a_idle" sprite="s_equip" isLoop="true" autoPlay="true" animTime="1000" playOnState="Motion.Idle">
        <Frame>7,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_move" sprite="s_equip" isLoop="true" autoPlay="true" animTime="200" playOnState="Motion.Move">
        <Frame>9,8</Frame>
        <Frame>10,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punch" sprite="s_equip" isLoop="true" autoPlay="true" animTime="1000" playOnState="Motion.Punch">
        <Frame>11,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchMove" sprite="s_equip" isLoop="true" autoPlay="true" animTime="200" playOnState="Motion.PunchMove">
        <Frame>12,8</Frame>
        <Frame>13,8</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Punch" />
          <State name="PunchMove" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move|Punch|PunchMove">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle|Punch|PunchMove">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="Idle|Move|PunchMove">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="PunchMove" from="Idle|Move|Punch">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_projectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
          <Select name="offset" input="punchCount">
            <Item>0, -11</Item>
            <Item>22, -11</Item>
          </Select>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectile</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_muzzle" updateStage="OnPunchStart">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Select name="offset" input="punchCount">
            <Item>10, -11</Item>
            <Item>32, -11</Item>
          </Select>
        </Emitter>
        <Particle usePlayerFacing="true" >
          <Set name="sprite">s_muzzle</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.2</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlash" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 1,1</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>
    
  </Data>

  <RenderRules>
    <RenderBackpack>
      <StopIf>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <Translate>0,-32,0</Translate>
      <SpriteRender name="s_equip" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_equipGlow" blend="PREMULTIPLIED_ALPHA" drawShadow="false" onState="Motion.Idle"/>
    </RenderBackpack>
    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_equipFront" offset="-16,-16" blend="PREMULTIPLIED_ALPHA" onState="Motion.Punch|Motion.PunchMove"/>
    </RenderInFront>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="OnGround"/>
					<State name="InAir"/>
				</States>
				<Transitions>
					<Transition to="OnGround" from="InAir">
						<Condition>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="InAir" from="OnGround">
						<Condition>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="Jump"/>
				</States>
				<Transitions>
					<Transition to="None" from="Jump">
						<Condition>
							<IsAction operatorType="NotEqual">JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="None">
						<Condition>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Sprite name="s_hat" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="0,14"/>
		<Sprite name="s_speedline" fileName="game/particles11.rttex" textureSize="32" frame="31,5"/>

		<Animations>
			<SpriteAnimation name="a_equip" sprite="s_hat" animTime="400" isLoop="true" playOnState="Motion.OnGround">
				<Frame>0,14</Frame>
				<Frame>1,14</Frame>
				<Frame>2,14</Frame>
				<Frame>3,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_jumpfall" sprite="s_hat" animTime="400" isLoop="true" playOnState="Motion.InAir">
				<Frame>4,14</Frame>
				<Frame>5,14</Frame>
				<Frame>6,14</Frame>
				<Frame>7,14</Frame>
			</SpriteAnimation>
		</Animations>
		
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="UserNameOffset">8</Set>
			</Default>
		</RenderOptions>
		
		<ParticleSystems>
			<ParticleSystem name="JumpLines" updateStage="AddClothingParticles" updateState="Action.Jump">
				<Emitter>
					<Set name="offset">0, -24</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_speedline</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1.6</KeyFrame>
						<KeyFrame>1, 1, 2.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialVelocity">0, 60</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>

	<RenderRules>
		<RenderHat>
			<SpriteRender name="s_hat" offset="0,-28" alignment="DOWN_CENTER"/>
		</RenderHat>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
	<StateMachines>
		<StateMachine name="playerState">
			<States>
				<State name="Idle"/>
				<State name="Punch"/>
				<State name="ZombiePunch"/>
			</States>
			<Transitions>
				<Transition from="ZombiePunch|Punch" to="Idle" >
					<Condition>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition from="ZombiePunch|Idle" to="Punch">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
						<IsZombified>false</IsZombified>
					</Condition>
				</Transition>
				<Transition from="Idle|Punch" to="ZombiePunch">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
						<IsZombified>true</IsZombified>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
	</StateMachines>

	<Sprite name="item_Sprite_1" fileName="game/ugc_sprites2.rttex" textureSize="128" frame="2,1"/>
	<Sprite name="SlashSprite" fileName="game/ugc_sprites2.rttex" textureSize="128" frame="6,1"/>
	<Sprite name="punch_effect" fileName="game/ugc_particles2.rttex" textureSize="64" frame="1,14"/>
	"/>

	<Animations>
		<SpriteAnimation name="wingFlexJump2" playOnAction="JUMP|FALL|IDLE|WALK" sprite="item_Sprite_1" animTime="700" autoPlay="true" isLoop="true">
			<Frame>2,1</Frame>
			<Frame>3,1</Frame>
			<Frame>4,1</Frame>
			<Frame>5,1</Frame>
		</SpriteAnimation>

		<SpriteAnimation name="slash_animation" sprite="SlashSprite" animTime="250" isLoop="true" playOnState="playerState.Punch">
        	<Frame>6,1</Frame>
        	<Frame>7,1</Frame>
        	<Frame>8,1</Frame>
        	<Frame>9,1</Frame>
      </SpriteAnimation>
    </Animations>

	<ParticleSystems>
		<ParticleSystem name="soulless_particle">
			<Emitter>
				<Set name="offset">0,-12</Set>
				<Set name="emissionInterval">0.25</Set>
				<Set name="lifeTime">0.25</Set>
				<Set name="particlesPerEmission">1</Set>
				<Set name="particlesToEmit">1</Set>
			</Emitter>
			<Particle>
				<Set name="sprite">punch_effect</Set>
				<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				<Set name="lifeTime">0.4</Set>
				<Set name="rotateWithVelocity">true</Set>
				<Set name="interpolateAlpha">false</Set>
				<Set name="initialAlpha">1</Set>
				<Set name="finalAlpha">1</Set>
				<Set name="interpolateVelocity">true</Set>
				<Curve name="initialScale">
            				<KeyFrame>0, 0.5,0.5</KeyFrame>
            				<KeyFrame>1, 1,1</KeyFrame>
          				</Curve>
				<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
			</Particle>
		</ParticleSystem>
	</ParticleSystems>

	<RenderOptions>
		<Default>
			<Set name="PunchSoundOverride">HAND</Set>
			<Set name="PlayDefaultPunchAudio">true</Set>
		</Default>
	</RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackHandItem>
	  <SpriteRender name="item_Sprite_1" rotateOffset="true" offset="15,0" alignment="CENTER"/>
    </RenderBackHandItem>

    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="SlashSprite" offset="12,-28" scale="1.25,1.25" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onState="playerState.Punch" drawShadow="false"/>
    </RenderInFront>

    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="playerState.Idle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>

    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Idle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1200</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>

	<OnPunchStart>
		<ParticleSystemUpdate name="soulless_particle"/>
	</OnPunchStart>

	<SwitchOffClothingParticles>
		<ParticleSystemOff name="soulless_particle"/>
	</SwitchOffClothingParticles>

  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_HOLIDAY_LIGHTS_SCARF">
	<Data>
		<Sprite name="s_scarf" fileName="game/particles_large14.rttex" textureSize="64" frame="7,14" />
		<Sprite name="s_scarfGlow" fileName="game/particles_large14.rttex" textureSize="64" frame="7,15" />
		<Sprite name="s_sleeve" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="24,23" />
		<Sprite name="s_sleeveGlow" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="24,24" />
		<Sprite name="s_sparkles" fileName="game/particles11.rttex" textureSize="32" frame="21,27" />
		<StateMachines>
			<StateMachine name="playerState">
				<States>
					<State name="Idle" />
					<State name="Fall" />
					<State name="Jump" />
				</States>
				<Transitions>
					<Transition from="Jump|Fall" to="Idle">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="Fall|Idle" to="Jump">
						<Condition>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition from="Jump|Idle" to="Fall">
						<Condition>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteCurveAnimation name="a_glowingSleeve" isLoop="true" autoPlay="true" sprite="s_sleeveGlow" animTime="1000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="a_glowingScarf" isLoop="true" autoPlay="true" sprite="s_scarfGlow" animTime="1000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_scarfFall" sprite="s_scarf" animTime="200" isLoop="true" playOnState="playerState.Fall">
				<Frame>14,1</Frame>
				<Frame>15,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_scarfGlowFall" sprite="s_scarfGlow" animTime="200" isLoop="true" playOnState="playerState.Fall">
				<Frame>14,2</Frame>
				<Frame>15,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_scarfGlowIdle" sprite="s_scarfGlow" animTime="800" isLoop="true" playOnState="playerState.Idle">
				<Frame>7,15</Frame>
				<Frame>8,15</Frame>
				<Frame>9,15</Frame>
				<Frame>10,15</Frame>
				<Frame>11,15</Frame>
				<Frame>12,15</Frame>
				<Frame>13,15</Frame>
				<Frame>14,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_scarfGlowJump" sprite="s_scarfGlow" animTime="800" isLoop="true" playOnState="playerState.Jump">
				<Frame>15,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_scarfIdle" sprite="s_scarf" animTime="800" isLoop="true" playOnState="playerState.Idle">
				<Frame>7,14</Frame>
				<Frame>8,14</Frame>
				<Frame>9,14</Frame>
				<Frame>10,14</Frame>
				<Frame>11,14</Frame>
				<Frame>12,14</Frame>
				<Frame>13,14</Frame>
				<Frame>14,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_scarfJump" sprite="s_scarf" animTime="800" isLoop="true" playOnState="playerState.Jump">
				<Frame>15,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sleeveFall" sprite="s_sleeve" animTime="200" isLoop="true" playOnState="playerState.Fall">
				<Frame>21,23</Frame>
				<Frame>22,23</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sleeveGlowFall" sprite="s_sleeveGlow" animTime="200" isLoop="true" playOnState="playerState.Fall">
				<Frame>21,24</Frame>
				<Frame>22,24</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sleeveGlowIdle" sprite="s_sleeveGlow" animTime="800" isLoop="true" playOnState="playerState.Idle">
				<Frame>24,24</Frame>
				<Frame>25,24</Frame>
				<Frame>26,24</Frame>
				<Frame>27,24</Frame>
				<Frame>28,24</Frame>
				<Frame>29,24</Frame>
				<Frame>30,24</Frame>
				<Frame>31,24</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sleeveGlowJump" sprite="s_sleeveGlow" animTime="800" isLoop="true" playOnState="playerState.Jump">
				<Frame>23,24</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sleeveIdle" sprite="s_sleeve" animTime="800" isLoop="true" playOnState="playerState.Idle">
				<Frame>24,23</Frame>
				<Frame>25,23</Frame>
				<Frame>26,23</Frame>
				<Frame>27,23</Frame>
				<Frame>28,23</Frame>
				<Frame>29,23</Frame>
				<Frame>30,23</Frame>
				<Frame>31,23</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sleeveJump" sprite="s_sleeve" animTime="800" isLoop="true" playOnState="playerState.Jump">
				<Frame>23,23</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_sparkles" sprite="s_sparkles">
				<Frame>21,27</Frame>
				<Frame>22,27</Frame>
				<Frame>23,27</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_Sparkles" updateStage="AddClothingParticles" renderStage="RenderChestBackItem">
				<Emitter>
					<Random name="emissionInterval" min="0.15" max="0.25" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
          <Random name="offset" min="-32, -32" max="24, -6" />
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_sparkles</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>38, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.8, 0.8</Set>
					<Random name="finalScale" min="0.3" max="0.6" />
					<Set name="lifeTime">0.85</Set>
					<Random name="initialRotationRate" min="15" max="60" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="s_sleeve" offset="-19,-13.5" />
			<SpriteRender name="s_sleeveGlow" offset="-19,-13.5" drawShadow="false" />
		</RenderChestItem>
		<RenderChestBackItem>
			<SpriteRender name="s_scarf" offset="-4,-32" />
			<SpriteRender name="s_scarfGlow" offset="-4,-32" drawShadow="false" />
		</RenderChestBackItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_HORNED_CROWN">
  <Data>
    <Sprite name="hatForegroundSprite" fileName="game/particles_large10.rttex" textureSize="64" frame="12,8"/>
    <Sprite name="hatBackgroundSprite" fileName="game/particles_large10.rttex" textureSize="64" frame="13,8"/>
    <Sprite name="lineSprite" fileName="game/particles10.rttex" textureSize="32" frame="30,29"/>
    <Sprite name="sparkSprite" fileName="game/particles10.rttex" textureSize="32" frame="31,29"/>

    <ParticleSystems>
			<ParticleSystem name="LineAura" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">lineSprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.1, 0.5</Set>
					<Random name="finalScale" min="5, 0.5" max="3, 0.5"/>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="0" max="360"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="LineMoveAura" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">lineSprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5, 0.5" max="1.5, 0.5"/>
					<Set name="lifeTime">0.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,60"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="SparksAura" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">sparkSprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5, 0.5</Set>
					<Set name="lifeTime">0.75</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="35,35"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems></Data>

  <RenderRules>
    <RenderBackHat>
      <SpriteRender name="hatBackgroundSprite" alignment="DOWN_CENTER"/>
    </RenderBackHat>
    <RenderHat>
      <SpriteRender name="hatForegroundSprite" alignment="DOWN_CENTER"/>
    </RenderHat>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_hand" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="7,3"/>
    <Sprite name="s_coin" fileName="game/particles12.rttex" textureSize="32" frame="19,14"/>
    <Sprite name="s_coinTrail" fileName="game/particles12.rttex" textureSize="32" frame="16,14"/>

    <Animations>
      <SpriteAnimation name="a_coin" sprite="s_coin" isLoop="true" animTime="1200">
        <Frame>19,14</Frame>
        <Frame>20,14</Frame>
        <Frame>21,14</Frame>
        <Frame>22,14</Frame>
        <Frame>23,14</Frame>
        <Frame>24,14</Frame>
        <Frame>25,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_luteTrail" sprite="s_coinTrail" isLoop="true" animTime="300">
        <Frame>16,14</Frame>
        <Frame>17,14</Frame>
        <Frame>18,14</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_coin">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">1.19</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">6000</Set>
            <Set name="hAmplitude">25</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">6</Set>
            <Set name="vOrbitPeriod">4000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_coin</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1.2</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_coinTrail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.04</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">6000</Set>
            <Set name="hAmplitude">25</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">6</Set>
            <Set name="vOrbitPeriod">4000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_coinTrail</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">1,1</Set>
          <Random name="finalScale" min="0.3" max="0.6" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderInFront>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="ps_coin"/>
      <ParticleSystemRender name="ps_coinTrail"/>
    </RenderInFront>
    <AddClothingParticles>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_coinTrail"/>
      <ParticleSystemUpdate name="ps_coin"/>
    </AddClothingParticles>
    <RenderHandItem>
      <SpriteRender name="s_hand" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" />
    </RenderHandItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_frontDagger" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="0,23"/>
    <Sprite name="s_backDagger" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="1,23"/>
    <Sprite name="s_aura" fileName="game/particles_large13.rttex" textureSize="64" frame="13,8"/>
    <Sprite name="s_projectile" fileName="game/particles11.rttex" textureSize="32" frame="22,26"/>
    <Sprite name="s_hitShrapnel" fileName="game/particles11.rttex" textureSize="32" frame="21,28"/>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move|Punch">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle|Punch">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="Idle|Move">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_aura" sprite="s_aura">
        <Frame>13,8</Frame>
        <Frame>14,8</Frame>
        <Frame>15,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_hitShrapnel" sprite="s_hitShrapnel">
        <Frame>21,28</Frame>
        <Frame>22,28</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_punchProjectile" updateStage="AddClothingParticles" updateState="Motion.Punch">
        <Emitter>
          <Random name="emissionInterval" min="0.01" max="0.1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">8,-16</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.3</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 0</KeyFrame>
            <KeyFrame>0.2, 1</KeyFrame>
            <KeyFrame>1, 1</KeyFrame>
          </Curve>
          <Random name="offset" min="-10, -8" max="10, 8" />
          <VectorTo name="initialVelocity" source="targetPos" offset="offset" duration="lifeTime" x="1"/>
          <Set name="rotateWithVelocity">true</Set>
          <OnFinish>
            <ParticleSystemName>ps_punchSmoke</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchSmoke">
        <Emitter>
          <Random name="emissionInterval" min="0.01" max="0.1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">2.5</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_aura</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Random name="offset" min="-8, -8" max="8, 8" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 1</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.2, 0.2</KeyFrame>
            <KeyFrame>1, 0.4, 0.6</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_frontSmoke" updateStage="AddClothingParticles" renderStage="RenderHandItem" updateState="Motion.Idle">
        <Emitter>
          <Random name="emissionInterval" min="0.5" max="1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Random name="offset" min="-2, -12" max="6, -12" />
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="inSpecificOrder">true</Set>
          <Set name="sprite">s_aura</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 1</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.2, 0.2</KeyFrame>
            <KeyFrame>1, 0.2, 0.3</KeyFrame>
          </Curve>
          <Set name="lifeTime">2</Set>
          <Random name="flipX" min="false" max="true"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_backSmoke" updateStage="AddClothingParticles" updateState="Motion.Idle">
        <Emitter>
          <Random name="emissionInterval" min="0.5" max="1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Random name="offset" min="14, -12" max="22, -12" />
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="inSpecificOrder">true</Set>
          <Set name="sprite">s_aura</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 1</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.2, 0.2</KeyFrame>
            <KeyFrame>1, 0.2, 0.3</KeyFrame>
          </Curve>
          <Set name="lifeTime">2</Set>
          <Random name="flipX" min="false" max="true"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_frontSmokeMove" updateStage="AddClothingParticles" renderStage="RenderHandItem" updateState="Motion.Move">
        <Emitter>
          <Random name="emissionInterval" min="0.01" max="0.1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">1</Set>
          <Random name="offset" min="-2, -15" max="6, -15" />
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="inSpecificOrder">true</Set>
          <Set name="sprite">s_aura</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 1</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.2, 0.2</KeyFrame>
            <KeyFrame>1, 0.4, 0.6</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Random name="flipX" min="false" max="true"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_backSmokeMove" updateStage="AddClothingParticles" updateState="Motion.Move">
        <Emitter>
          <Random name="emissionInterval" min="0.01" max="0.1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">1</Set>
          <Random name="offset" min="14, -15" max="22, -15" />
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="inSpecificOrder">true</Set>
          <Set name="sprite">s_aura</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 1</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.2, 0.2</KeyFrame>
            <KeyFrame>1, 0.4, 0.6</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Random name="flipX" min="false" max="true"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_shrapnel">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_hitShrapnel</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1.1,1.1</KeyFrame>
            <KeyFrame>1, 0,0</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="-8" max="8" />
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,100" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">false</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <ParticleSystemRender name="ps_backSmoke"/>
      <ParticleSystemRender name="ps_backSmokeMove"/>
      <SpriteRender name="s_backDagger" offset="-2,5" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackHandItem>
    <RenderHandItem>
      <SpriteRender name="s_frontDagger" offset="0,0.5" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" />
    </RenderHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">200</Set>
        <Set name="Curve">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, 360</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="animTime">200</Set>
        <Set name="Curve">
          <KeyFrame>0, 180</KeyFrame>
          <KeyFrame>1, 540</KeyFrame>
        </Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_shrapnel" />
    </OnDamagedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wings" fileName="game/particles_large18.rttex" textureSize="64" frame="10,6"/>

    <Animations>
      <SpriteAnimation name="a_equip" sprite="s_wings" animTime="1200" playOnState="Action.Equip" isLoop="true">
        <Frame>7,6</Frame>
      </SpriteAnimation>
      <SequenceAnimation name="a_BackJump" playOnState="Action.Jump">
        <SpriteAnimation name="a_BackJump1" sprite="s_wings" animTime="100">
          <Frame>10,6</Frame>
          <Frame>7,6</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_BackJump2" sprite="s_wings" animTime="200">
          <Frame>8,6</Frame>
          <Frame>9,6</Frame>
          <Frame>10,6</Frame>
          <Frame>10,6</Frame>
        </SpriteAnimation>
      </SequenceAnimation>
      <SpriteAnimation name="a_fall" sprite="s_wings" animTime="1000" playOnState="Action.Fall" isLoop="true">
        <Frame>10,6</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Equip" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Equip" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Equip|Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Equip|Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_wings" offset="-7,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_wings" offset="7,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="equip_Sprite" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="29,10"/>
    
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IsNightVision">true</Set>
        <Set name="NightVisionColour">201,15,71</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <RenderFaceItem>
      <SpriteRender name="equip_Sprite" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderFaceItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_IMMORTAL_SONIC_BUSTER_KATANA">
	<Data>
		<Sprite name="Strap" fileName="game/particles12.rttex" textureSize="32" frame="11,25"/>
		
		<Sprite name="sword_Sprite" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="7,12"/>
		<Sprite name="sword_back_Sprite" fileName="game/particles_large18.rttex" textureSize="64,64" frame="15,10"/>
		
		<Sprite name="sword_back_glowing_Sprite" fileName="game/particles_large18.rttex" textureSize="64,64" frame="13,10"/>
		<Sprite name="sword_back_glowing_front_Sprite" fileName="game/particles_large18.rttex" textureSize="64,64" frame="14,10"/>
		
		<Sprite name="sword_slash_sparkle" fileName="game/particles12.rttex" textureSize="32" frame="4,25"/>
		<Sprite name="sword_slash_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="8,25"/>
		
		<Sprite name="hit_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="0,25"/>
		<Sprite name="hit_slash_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="10,25"/>
		<Sprite name="breakStamp" fileName="game/particles12.rttex" textureSize="32" frame="3,25"/>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition from="None" to="Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Punch" to="None">
						<Condition type="or">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteCurveAnimation name="sword_glowing_Sprite_idle" isLoop="true" playOnState="Action.None" sprite="sword_back_glowing_front_Sprite" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="sword_glowing_Sprite_punch" isLoop="true" sprite="sword_back_Sprite" animTime="100" playOnState="Action.Punch">
				<Frame>15,10</Frame>
			</SpriteCurveAnimation>
			<SpriteAnimation name="sword_slash_frames" autoPlay="false" sprite="sword_slash_Sprite">
				<Frame>8,25</Frame>
				<Frame>9,25</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="sword_sparkle_frames" autoPlay="false" sprite="sword_slash_sparkle">
				<Frame>4,25</Frame>
				<Frame>5,25</Frame>
				<Frame>6,25</Frame>
				<Frame>7,25</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="hit_Sprite">
				<Frame>0,25</Frame>
				<Frame>1,25</Frame>
				<Frame>2,25</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">16</Set>
					<Set name="emissionInterval">0.035</Set>
					<Set name="checkParticleNumToEmit">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="-6, -8" max="6, 8" />
					<Set name="sprite">sword_slash_sparkle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5" max="1" />
					<Set name="lifeTime">0.3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="slash_particle" secondary="trail_particle">
				<Emitter>
					<Set name="offset">0,-22</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Random name="offset" min="0, -12" max="0, 12" />
					<Set name="sprite">sword_slash_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">2</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="gravityVector">0, 100</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialRotationRate">15</Set>
					<Set name="finalRotationRate">5</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1,1</Set>
					<Random name="finalScale" min="0.2" max="0.5"/>
					<Set name="interpolateAngle">true</Set>
					<Random name="initialAngle" min="-360" max="360"/>
					<Random name="finalAngle" min="-360" max="360"/>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="13.5,150"/>
					<Random name="posOffset" min="0, 0" max="16,16"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_hit_slash" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Random name="particlesToEmit" min="1" max="4" />
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="emissionInterval">0.05</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">hit_slash_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.75</Set>
					<Random name="initialAngle" min="0" max="360" />
					<Random name="offset" min="-10, -10" max="10,10"/>
					<Random name="initialScale" min="0.7" max="1.0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="break_particle_stamp">
				<Emitter>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Random name="initialAngle" min="-360" max="360"/>
					<Set name="sprite">breakStamp</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 1.3,1.3</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
			</Default>
		</RenderOptions>
		
	</Data>

	<RenderRules>
		<RenderHandItem value="1.23,7.3" >
			<StopIf type="or">
				<IsAction operatorType="NotEqual">PUNCH</IsAction>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="sword_Sprite"/>
		</RenderHandItem>
		<RenderInFront>
			<ParticleSystemRender name="hit_particle"/>
		</RenderInFront>
		<RenderFrontArm>
			<SpriteRender name="Strap" alignment="DOWN_CENTER" useFixedRotation="true" fixedRotation="0"/>
		</RenderFrontArm>
		<RenderBackArm value="playerCenter">
			<StopIf type="or">
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<SpriteRender name="sword_back_Sprite" offset="-0.2, -32" useFixedRotation="true" fixedRotation="0"/>
			<StopIf type="and">
				<IsAction>PUNCH</IsAction>
				<IsZombified>false</IsZombified>
			</StopIf>
			<SpriteRender name="sword_back_glowing_Sprite" offset="-0.2, -32" blend="PREMULTIPLIED_ALPHA" drawShadow="false" useFixedRotation="true" fixedRotation="0"/>
			<SpriteRender name="sword_back_glowing_front_Sprite" offset="-0.2, -32" blend="PREMULTIPLIED_ALPHA" drawShadow="false" useFixedRotation="true" fixedRotation="0"/>
		</RenderBackArm>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnPunchStart>
			<ParticleSystemUpdate name="slash_particle"/>
		</OnPunchStart>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="hit_particle"/>
			<ParticleSystemUpdate name="break_particle_stamp"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_sword" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="5,11" />
    <Sprite name="s_punchCurve" fileName="game/particles12.rttex" textureSize="32" frame="14,4" />
    <Sprite name="s_punchAura" fileName="game/particles_large18.rttex" textureSize="64" frame="0,7" />
    <Animations>
      <SpriteAnimation name="a_punchCurve" sprite="s_punchCurve" autoPlay="false" isLoop="false" >
        <Frame>14,4</Frame>
        <Frame>15,4</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchAura" sprite="s_punchAura" autoPlay="false" isLoop="true" animTime="350">
        <Frame>6,7</Frame>
        <Frame>0,7</Frame>
        <Frame>1,7</Frame>
        <Frame>2,7</Frame>
        <Frame>3,7</Frame>
        <Frame>4,7</Frame>
        <Frame>5,7</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
      </Default>
    </RenderOptions>
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="False" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="punch_aura" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">12,-16</Set>
          <Set name="lifeTime">0.35</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_punchAura</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.35</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">8,-16</Set>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_punchCurve</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.15</Set>
          <Set name="initialScale">0.75,1.5</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <RenderHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_sword" offset="0, 8" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
    </RenderHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1500</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
