</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_CONVEYOR_BLOCK">
	<Data>
		<Sprite name="s_sprite" fileName="game/tiles_page17.rttex" textureSize="32" frame="8,9" />
		
		<Animations>
			<SpriteAnimation name="a_Right" sprite="s_sprite" isLoop="true" animTime="400" playOnState="Connect.Right_FR|Connect.Right_FL">
				<Frame>12, 10</Frame>
				<Frame>13, 10</Frame>
				<Frame>14, 10</Frame>
				<Frame>15, 10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_LeftRight" sprite="s_sprite" isLoop="true" animTime="400" playOnState="Connect.LeftRight">
				<Frame>16, 10</Frame>
				<Frame>17, 10</Frame>
				<Frame>18, 10</Frame>
				<Frame>19, 10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Left" sprite="s_sprite" isLoop="true" animTime="400" playOnState="Connect.Left_FR|Connect.Left_FL">
				<Frame>20, 10</Frame>
				<Frame>21, 10</Frame>
				<Frame>22, 10</Frame>
				<Frame>23, 10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_None" sprite="s_sprite" isLoop="true" animTime="400" playOnState="Connect.None">
				<Frame>24, 10</Frame>
				<Frame>25, 10</Frame>
				<Frame>26, 10</Frame>
				<Frame>27, 10</Frame>
			</SpriteAnimation>
		</Animations>
		
		<StateMachines>
			<StateMachine name="Connect">
				<States>
					<State name="None"/>
					<State name="Left_FR"/>
					<State name="Right_FR"/>
					<State name="LeftRight"/>
					<State name="Left_FL"/>
					<State name="Right_FL"/>
				</States>
				<Transitions>
					<Transition to="None" from="Left_FR|Right_FR|LeftRight|Left_FL|Right_FL">
						<Condition type="and">
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="-1,0">false</CheckTileId>
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="1,0">false</CheckTileId>
						</Condition>
					</Transition>
					
					<Transition to="Left_FR" from="None|Right_FR|LeftRight">
						<Condition type="and">
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="-1,0">true</CheckTileId>
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="1,0">false</CheckTileId>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right_FR" from="None|Left_FR|LeftRight">
						<Condition type="and">
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="-1,0">false</CheckTileId>
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="1,0">true</CheckTileId>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="LeftRight" from="None|Left_FR|Right_FR|Left_FL|Right_FL">
						<Condition type="and">
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="-1,0">true</CheckTileId>
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="1,0">true</CheckTileId>
						</Condition>
					</Transition>
					
					<Transition to="Left_FL" from="None|Right_FL|LeftRight">
						<Condition type="and">
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="-1,0">false</CheckTileId>
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="1,0">true</CheckTileId>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right_FL" from="None|Left_FL|LeftRight">
						<Condition type="and">
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="-1,0">true</CheckTileId>
							<CheckTileId ItemId="ITEM_ID_CONVEYOR_BLOCK" Position="1,0">false</CheckTileId>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_sprite" blend="PREMULTIPLIED_ALPHA" />
		</Render>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_DIAMOND_MANNEQUIN">
  <Data>
    <Sprite name="s_sparkle" fileName="game/particles12.rttex" textureSize="32" frame="21,10"/>
    <SpriteAnimation name="a_Sparkles" sprite="s_sparkle" animTime="300" autoPlay="false">
      <Frame>21,10</Frame>
      <Frame>22,10</Frame>
    </SpriteAnimation>
    <RenderOptions>
      <Mannequin>
        <Set name="ArmSurface" TextureSize="6,10">game/player_arm4.rttex</Set>
        <Set name="HeadSurface" TextureSize="32,32">game/player_head_skin12.rttex</Set>
        <Set name="SittingLegsSurface" TextureSize="32,32">game/player_sit_custom3.rttex</Set>
        <Set name="ExtraLegSurface" TextureSize="8,1">game/player_extraleg4.rttex</Set>
        <Set name="FeetSurface" TextureSize="32,32">game/player_feet16.rttex</Set>
        <Set name="FrontFeetFrames">16,24</Set>
        <Set name="BackFeetFrames">16,25</Set>
        <Set name="HorsePantsSurface" TextureSize="16,16">game/player_horsepants_custom3.rttex</Set>
        <Set name="RenderObjectFlags">RENDER_OBJECT_FLAG_NO_FACE</Set>
        <Set name="HasBackstand">true</Set>
        <Set name="HasFrontStand">false</Set>
      </Mannequin>
    </RenderOptions>
    <ParticleSystems>
      <ParticleSystem name="ps_SparklesTrail" updateStage="RenderInWorldSpaceFront">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">1</Set>
          <Set name="particlesToEmit">5</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="infParticles">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_sparkle</Set>
          <Random name="offset" min="-12, -16" max="12.1, 16.1" />
          <Set name="lifeTime">2</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="initialRotationRate">840</Set>
          <Set name="initialVelocity">0,-25</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.8</KeyFrame>
            <KeyFrame>0.1, 0.9</KeyFrame>
            <KeyFrame>0.2, 1.2</KeyFrame>
            <KeyFrame>0.3, 0.95</KeyFrame>
            <KeyFrame>1, 0.1</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>

  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_NEPTUNES_WEATHER_MACHINE_ATLANTIS">
	<Data>
		<Sprite name="s_WeatherMachine" fileName="game/tiles_page17.rttex" textureSize="32" frame="0,6" />
		
		<StateMachines>
			<StateMachine name="Toggle">
				<States>
					<State name="Off"/>
					<State name="On"/>
				</States>
				<Transitions>
					<Transition to="Off" from="On">
						<Condition>
							<IsWeatherType operatorType="NotEqual">NEPTUNES_ATLANTIS</IsWeatherType>
						</Condition>
					</Transition>
					<Transition to="On" from="Off">
						<Condition>
							<IsWeatherType>NEPTUNES_ATLANTIS</IsWeatherType>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<Animations>
			<SpriteAnimation name="a_WeatherMachineOn" sprite="s_WeatherMachine" animTime="1600" isLoop="true" playOnState="Toggle.On">
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				<Frame>4,6</Frame>
				<Frame>5,6</Frame>
				<Frame>6,6</Frame>
				<Frame>7,6</Frame>
				<Frame>8,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_WeatherMachineOff" sprite="s_WeatherMachine" animTime="100" isLoop="true" playOnState="Toggle.Off">
				<Frame>0,6</Frame>
			</SpriteAnimation>
		</Animations>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_WeatherMachine" blend="PREMULTIPLIED_ALPHA" />
		</Render>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_OPERATING_TABLE">
	<Data>
		<Sprite name="s_bed" fileName="game/tiles_page16.rttex" textureSize="32" frame="16,31" />
		<Sprite name="s_surge" fileName="game/tiles_page16.rttex" textureSize="32" frame="18,31" />
		<Sprite name="s_bedOverlay" fileName="game/tiles_page16.rttex" textureSize="32" frame="17,31" />
		
		<StateMachines>
			<StateMachine name="State">
				<States>
					<State name="Bed"/>
					<State name="SurgE"/>
				</States>
				<Transitions>
					<Transition from="SurgE" to="Bed">
						<Condition>
              <IsVariableBool name="tile.extra.operatingTableIsABed">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition from="Bed" to="SurgE">
						<Condition>
              <IsVariableBool name="tile.extra.operatingTableIsABed">false</IsVariableBool>
          </Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="SurgEState">
				<States>
					<State name="InSurgery"/>
					<State name="NotInSurgery"/>
				</States>
				<Transitions>
					<Transition from="NotInSurgery" to="InSurgery">
						<Condition type="and">
              <IsVariableBool name="tile.extra.operatingTableIsABed">false</IsVariableBool>
              <IsVariableBool name="tile.extra.operatingTableIsInSurgery">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition from="InSurgery" to="NotInSurgery">
            <Condition type="and">
              <IsVariableBool name="tile.extra.operatingTableIsABed">false</IsVariableBool>
              <IsVariableBool name="tile.extra.operatingTableIsInSurgery">false</IsVariableBool>
          </Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
    <Animations>
      <SpriteAnimation name="InSurgery" sprite="s_surge" animTime="100" isLoop="true" playOnState="SurgEState.InSurgery">
        <Frame>19,31</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="NotInSurgery" sprite="s_surge" animTime="100" isLoop="true" playOnState="SurgEState.NotInSurgery">
        <Frame>18,31</Frame>
      </SpriteAnimation>
    </Animations>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_bed" blend="PREMULTIPLIED_ALPHA" onState="State.Bed"/>
			<SpriteRender name="s_surge" blend="PREMULTIPLIED_ALPHA" onState="State.SurgE"/>
		</Render>
    <RenderBedOverlay>
			<SpriteRender name="s_bedOverlay" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_LEFT" offset="0,-21"/>
		</RenderBedOverlay>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_PARTY_PROJECTOR">
	<Data>
		<Sprite name="s_tile_sprite" fileName="game/tiles_page17.rttex" textureSize="32" frame="0,5" />
		<Sprite name="s_tile_pattern_1" fileName="game/particles_large15.rttex" textureSize="64" frame="5,0" />
		<Sprite name="s_tile_pattern_2" fileName="game/particles_large15.rttex" textureSize="64" frame="6,0" />
		<Sprite name="s_tile_pattern_3" fileName="game/particles_large15.rttex" textureSize="64" frame="7,0" />
		<Sprite name="s_tile_pattern_4" fileName="game/particles_large15.rttex" textureSize="64" frame="8,0" />
	
		<VariableMap>
			<Set name="ProjectorSelectedPatternID" ForceFloats="false">0</Set>
			<Set name="ProjectorSpinningSpeed">150</Set>
			<Set name="ProjectorMoveSpeed">75, 75</Set>
		</VariableMap>
		<ParticleSystems>
			<ParticleSystem name="ps_pattern" updateStage="RenderInWorldSpaceBehind">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">6000</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="initialAlpha">1</Set>
					<Set name="initialRotationRate" source="ProjectorSpinningSpeed"></Set>
					<Set name="initialVelocity" source="ProjectorMoveSpeed"></Set>
					<Set name="variantId" source="ProjectorSelectedPatternID"></Set>
					<Animation class="ParticleBounceWithinBounds">
						<areaOffset>64,-16</areaOffset>
						<startOffset>96,-64</startOffset>
						<width>10</width>
						<height>5</height>
					</Animation>
					<Select name="sprite" input="variantId">
						<Item>"s_tile_pattern_1"</Item>
						<Item>"s_tile_pattern_2"</Item>
						<Item>"s_tile_pattern_3"</Item>
						<Item>"s_tile_pattern_4"</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">6000</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Render>
			<SpriteRender name="s_tile_sprite" blend="PREMULTIPLIED_ALPHA" />
		</Render>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="ps_pattern"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer itemID="ITEM_ID_PEARL_MANNEQUIN">
	<Data>
		<Sprite name="s_sparkle" fileName="game/particles12.rttex" textureSize="32" frame="25,2"/>
		<SpriteAnimation name="a_Sparkles" sprite="s_sparkle" animTime="300" autoPlay="false">
			<Frame>25,2</Frame>
			<Frame>26,2</Frame>
		</SpriteAnimation>
		<RenderOptions>
			<Mannequin>
				<Set name="ArmSurface" TextureSize="6,10">game/player_arm3.rttex</Set>
