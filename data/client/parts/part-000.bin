	</Buff>	
	<Buff Type="Health" Name="ITEM_ID_DUNGEON_ABILITY_HEALTH_POTION_RARE">
		<Set name="healthIncrease">200</Set>
		<Set name="Temporary">true</Set>
		<Set name="soulsPrice">30</Set>
