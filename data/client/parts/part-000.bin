				<Set name="armAngle">0</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderHandItem>
			<Translate>staff_offset</Translate>
			<Rotate onState="PlayerAction.Punch|PlayerAction.Idle">staff_rotation</Rotate>
			<Rotate forceValue="true" onState="PlayerAction.Move|PlayerAction.Dance">staff_rotation</Rotate>
			<SpriteRender name="StickSprite" blend="PREMULTIPLIED_ALPHA" />
			<StopIf>
				<IsZombified>true</IsZombified>
        <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>
			<Group>
				<Translate>fire_offset_right</Translate>
				<Rotate forceValue="true">fire_rotation</Rotate>
				<Group onState="PlayerAction.Idle|PlayerAction.Move|PlayerAction.Dance">
					<Translate>fire_offset_down</Translate>
					<SpriteRender name="StickFireSprite" blend="ADDITIVE" drawShadow="false"/>
				</Group>
        <StopIf>
          <IsVariableBool name="isMannequin">true</IsVariableBool>
        </StopIf>
        <ParticleSystemUpdate name="SmokeTrailRight" onState="PlayerAction.Idle|PlayerAction.Dance" />
        <ParticleSystemUpdate name="SparkleTrailRight" onState="PlayerAction.Idle|PlayerAction.Dance" />
        <ParticleSystemUpdate name="SmokeTrailRightMove" onState="PlayerAction.Move" />
        <ParticleSystemUpdate name="SparkleTrailRightMove" onState="PlayerAction.Move" />
				<ParticleSystemRender name="SmokeTrailRight" onState="PlayerAction.Idle|PlayerAction.Dance" />
        <ParticleSystemRender name="SparkleTrailRight" onState="PlayerAction.Idle|PlayerAction.Dance" />
        <ParticleSystemRender name="SmokeTrailRightMove" onState="PlayerAction.Move" />
        <ParticleSystemRender name="SparkleTrailRightMove" onState="PlayerAction.Move" />
			</Group>
      <SpriteRender name="StickPearlSprite" blend="PREMULTIPLIED_ALPHA" rotateOffset="true" offset="16,0" scale="0.8,0.8"/>
			<Group>
				<Translate>fire_offset_left</Translate>
				<Rotate forceValue="true">fire_rotation</Rotate>
				<Group onState="PlayerAction.Idle|PlayerAction.Move|PlayerAction.Dance">
					<Translate>fire_offset_down</Translate>
					<SpriteRender name="StickFireSprite" blend="ADDITIVE" drawShadow="false"/>
				</Group>
        <StopIf>
          <IsVariableBool name="isMannequin">true</IsVariableBool>
        </StopIf>
        <ParticleSystemUpdate name="SmokeTrailLeft" onState="PlayerAction.Idle|PlayerAction.Dance" />
        <ParticleSystemUpdate name="SparkleTrailLeft" onState="PlayerAction.Idle|PlayerAction.Dance" />
        <ParticleSystemUpdate name="SmokeTrailLeftMove" onState="PlayerAction.Move" />
        <ParticleSystemUpdate name="SparkleTrailLeftMove" onState="PlayerAction.Move" />
        <ParticleSystemRender name="SmokeTrailLeft" onState="PlayerAction.Idle|PlayerAction.Dance" />
        <ParticleSystemRender name="SparkleTrailLeft" onState="PlayerAction.Idle|PlayerAction.Dance" />
        <ParticleSystemRender name="SmokeTrailLeftMove" onState="PlayerAction.Move" />
        <ParticleSystemRender name="SparkleTrailLeftMove" onState="PlayerAction.Move" />
			</Group>
      <SpriteRender name="StickPearlSprite" blend="PREMULTIPLIED_ALPHA" onState="PlayerAction.Idle|PlayerAction.Move|PlayerAction.Dance" rotateOffset="true" offset="-16,0" scale="0.8,0.8"/>
		</RenderHandItem>
		<AddClothingParticles>
			<ParticleSystemUpdate name="PunchFire" onState="PlayerAction.Punch" />
		</AddClothingParticles>
		<OnDamagedTile>
			<ParticleSystemUpdate name="TileHitParticle" />
		</OnDamagedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_BUSTER_BRUSH">
  <Data>
    <StateMachines>
      <StateMachine name="playerState">
        <States>
          <State name="Equip"/>
          <State name="Fall"/>
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition from="Equip" to="Fall" >
            <Condition>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Fall" to="Equip">
            <Condition>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Equip|Fall" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Equip">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Fall">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine><StateMachine name="trailParticleState">
        <States>
          <State name="Equip"/>
          <State name="HorizontalMove"/>
          <State name="Punch"/>
          <State name="Sleep"/>
        </States>
        <Transitions>
          <Transition from="Equip|HorizontalMove|Punch" to="Sleep" >
            <Condition>
              <IsSleepingOnaBed>true</IsSleepingOnaBed>
            </Condition>
          </Transition>
          <Transition from="Equip|HorizontalMove|Sleep" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch|HorizontalMove|Sleep" to="Equip">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Punch|Equip|Sleep" to="HorizontalMove">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Sprite name="equip_sprite" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="1,5"/>
    <Sprite name="fall_sprite" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="1,6"/>
    <Sprite name="slash_sprite" fileName="game/particles_large13.rttex" textureSize="64"/>
    <Sprite name="trail_drops_sprite" fileName="game/particles11.rttex" textureSize="32" frame="23,9"/>
    <Sprite name="block_hit_sprite" fileName="game/particles11.rttex" textureSize="32" frame="25,9"/>
    <Sprite name="punch_projectile_sprite" fileName="game/particles11.rttex" textureSize="32" frame="24,9"/>

    <Animations>
      <SpriteAnimation name="slash_animation" sprite="slash_sprite" animTime="175" isLoop="true" playOnState="playerState.Punch">
        <Frame>0,4</Frame>
        <Frame>1,4</Frame>
        <Frame>2,4</Frame>
        <Frame>3,4</Frame>
        <Frame>4,4</Frame>
        <Frame>5,4</Frame>
        <Frame>6,4</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="UserNameOffset">15</Set>
      </Default>
    </RenderOptions>
    <ParticleSystems>
			<ParticleSystem name="drop_particles" updateStage="AddClothingParticles" updateState="trailParticleState.Equip" renderStage="RenderHandItem">
				<Emitter>
					<Set name="offset">-32, -34</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="forceXScaling">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true">
					<Set name="sprite">trail_drops_sprite</Set>
					<Random name="offset" min="-6, -8" max="6, 0"/>
					<Set name="inSpecificOrder">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialVelocity">-10, -40</Set>
					<Set name="gravityVector">0, 100</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="drop_particles_move" updateStage="AddClothingParticles" updateState="trailParticleState.HorizontalMove">
				<Emitter>
					<Set name="offset">-32, -34</Set>
					<Set name="emissionInterval">0.15</Set>
					<Set name="forceXScaling">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true">
					<Set name="sprite">trail_drops_sprite</Set>
					<Random name="offset" min="-16, -8" max="16, 8"/>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialVelocity">-10, -40</Set>
					<Set name="gravityVector">0, 100</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
				<Emitter>
					<Random name="offset" min="32, -48" max="32, 16"/>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_projectile_sprite</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="tile_break_particle" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="particlesPerEmission">20</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">trail_drops_sprite</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.25, 0.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,60"/>
					<Set name="gravityVector">0, 30</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="tile_hit_particle" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">block_hit_sprite</Set>
					<Random name="offset" min="-4, -4" max="4, 4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4, 0.4</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="tile_hit_splash" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">trail_drops_sprite</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.25, 0.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,60"/>
					<Set name="gravityVector">0, 30</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems></Data>

  <RenderRules>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
    </Update>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="equip_sprite" offset="17, 4" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onState="playerState.Equip|playerState.Punch"/>
      <SpriteRender name="fall_sprite" offset="17, 4" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onState="playerState.Fall"/>
    </RenderBackHandItem>
    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="slash_sprite" offset="12,-16" scale="1.25,1.25" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onState="playerState.Punch" drawShadow="false" tintOverride="255,255,255,255"/>
    </RenderInFront>
    <AddClothingParticles>
      <StopIf type="or">
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
    </AddClothingParticles>
    <OnPunchStart>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
    </OnPunchStart>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Equip|playerState.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">215</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1200</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="punch_projectile"/>
      <ParticleSystemOff name="drop_particles"/>
      <ParticleSystemOff name="drop_particles_move"/>
      <ParticleSystemOff name="tile_break_particle"/>
      <ParticleSystemOff name="tile_hit_particle"/>
      <ParticleSystemOff name="tile_hit_splash"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_CANDLEWICKS_HAIR">
	<Data>
		<Sprite name="s_Hair" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="28,20" />
		<Sprite name="s_Hair_glow" fileName="game/particles11.rttex" textureSize="32" frame="23,31" />
		<Sprite name="s_hair_back_proxy" fileName="game/particles11.rttex" textureSize="32" frame="6,31" />
		<Sprite name="s_hair_back_proxy_2" fileName="game/particles11.rttex" textureSize="32" frame="6,31" />
		<Sprite name="emberSprite" fileName="game/particles11.rttex" textureSize="32" frame="22,31" />
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="Idle" />
					<State name="Walk" />
					<State name="JumpStraight" />
					<State name="JumpDiagonal" />
					<State name="FallStraight" />
					<State name="FallDiagonal" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Walk|FallStraight|FallDiagonal">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>					
					<Transition to="Walk" from="Idle|FallDiagonal|FallStraight">
						<Condition type="and">
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">JUMP</IsAction>
							<IsAction operatorType="NotEqual">FALL</IsAction>
						</Condition>
					</Transition>
					<Transition to="JumpStraight" from="Idle|Walk|FallStraight|JumpDiagonal|FallDiagonal">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>			
					<Transition to="JumpDiagonal" from="Idle|Walk|FallStraight|JumpStraight|FallDiagonal">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="FallStraight" from="Walk|FallDiagonal|JumpStraight|JumpDiagonal|Idle">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>				
					<Transition to="FallDiagonal" from="Walk|FallStraight|JumpStraight|JumpDiagonal|Idle">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="s_Belt_back_proxy_idle" sprite="s_hair_back_proxy" playOnState="Action.Idle" animTime="800" isLoop="true">
				<Frame>6,31</Frame>
				<Frame>7,31</Frame>
				<Frame>8,31</Frame>
				<Frame>9,31</Frame>
				<Frame>10,31</Frame>
				<Frame>11,31</Frame>
				<Frame>12,31</Frame>
				<Frame>13,31</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="s_Belt_back_proxy_walk" sprite="s_hair_back_proxy" playOnState="Action.Walk|Action.FallStraight|Action.FallDiagonal|Action.JumpStraight|Action.JumpDiagonal" animTime="800" isLoop="true">
				<Frame>14,31</Frame>
				<Frame>15,31</Frame>
				<Frame>16,31</Frame>
				<Frame>17,31</Frame>
				<Frame>18,31</Frame>
				<Frame>19,31</Frame>
				<Frame>20,31</Frame>
				<Frame>21,31</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="s_Belt_back_proxy_idle_2" sprite="s_hair_back_proxy_2" playOnState="Action.Idle" animTime="800" isLoop="true">
				<Frame>7,31</Frame>
				<Frame>8,31</Frame>
				<Frame>9,31</Frame>
				<Frame>10,31</Frame>
				<Frame>11,31</Frame>
				<Frame>12,31</Frame>
				<Frame>13,31</Frame>
				<Frame>6,31</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="s_Belt_back_proxy_walk_2" sprite="s_hair_back_proxy_2" playOnState="Action.Walk|Action.FallStraight|Action.FallDiagonal|Action.JumpStraight|Action.JumpDiagonal" animTime="800" isLoop="true">
				<Frame>15,31</Frame>
				<Frame>16,31</Frame>
				<Frame>17,31</Frame>
				<Frame>18,31</Frame>
				<Frame>19,31</Frame>
				<Frame>20,31</Frame>
				<Frame>21,31</Frame>
				<Frame>14,31</Frame>
			</SpriteAnimation>				
			<InterpolationVec4Animation name="idleProxy" variableName="hair_rotation" targetValue="0, 0, 0, 1" animTime="600" playOnState="Action.Idle"/>
			<InterpolationVec4Animation name="walkProxy" variableName="hair_rotation" targetValue="-90, 0, 0, 1" animTime="400" playOnState="Action.Walk"/>
			<InterpolationVec4Animation name="fallProxyFallStraight" variableName="hair_rotation" targetValue="0, 0, 0, 1" animTime="1000" playOnState="Action.FallStraight"/>
			<InterpolationVec4Animation name="fallProxyFallDiagonal" variableName="hair_rotation" targetValue="-45, 0, 0, 1" animTime="400" playOnState="Action.FallDiagonal"/>
			<InterpolationVec4Animation name="jumpProxyJumpStraight" variableName="hair_rotation" targetValue="-180, 0, 0, 1" animTime="1000" playOnState="Action.JumpStraight"/>
			<InterpolationVec4Animation name="jumpProxyJumpDiagonal" variableName="hair_rotation" targetValue="-135, 0, 0, 1" animTime="400" playOnState="Action.JumpDiagonal"/>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="EmberLeftParticle">
				<Emitter>
					<Set name="offset">0, -28</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">emberSprite</Set>
					<Random name="offset" min="-4, -2" max="4, 2" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.85</Set>a
					<Random name="initialVelocity" min="0, -16" max="0, -30" />
					<Set name="initialRotationRate">360</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="hair_rotation">0, 0, 0, 1</Set>
			<Set name="hair_position">0, -31.75, 0</Set>
			<Set name="proxy_position_back">0, -32, 0</Set>
			<Set name="localScale">1, 1, 1</Set>
			<Set name="sittingOffset">0, 0, 0</Set>
			<Set name="portraitOffset">0,0, 0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderBackHair>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
			</StopIf>
			<ParticleSystemRender name="EmberLeftParticle"/>
			<Group>			
				<Translate>proxy_position_back</Translate>
				<Rotate>hair_rotation</Rotate>
				<SpriteRender name="s_hair_back_proxy" blend="ADDITIVE" alignment="DOWN_CENTER" drawShadow="false"/>
				<SpriteRender name="s_hair_back_proxy_2" blend="ADDITIVE" alignment="DOWN_CENTER" drawShadow="false"/>
			</Group>
		</RenderBackHair>
		<RenderHair>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
			</StopIf>
			<Translate>hair_position</Translate>
			<SpriteRender name="s_Hair_glow" blend="ADDITIVE" />
		</RenderHair>
		<AddClothingParticles>
			<ParticleSystemUpdate name="EmberLeftParticle" onState="Action.Walk|Action.FallStraight|Action.FallDiagonal|Action.JumpStraight|Action.JumpDiagonal"/>
		</AddClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_cape" fileName="game/particles_large15.rttex" textureSize="64" frame="0,13" />
    <Sprite name="s_doubleJumpDownCloud" fileName="game/particles10.rttex" textureSize="32" frame="6,8" />
    <Sprite name="s_doubleJumpLines" fileName="game/particles10.rttex" textureSize="32" frame="4,8" />
    <Sprite name="s_doubleJumpSideCloud" fileName="game/particles10.rttex" textureSize="32" frame="5,8" />
    <Sprite name="s_medal" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="5,29" />
    <Sprite name="s_medalFlipped" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="6,29" />
    <Sprite name="s_pet" fileName="game/pets/p_cb_regular.rttex" textureSize="32" frame="0,0" />
    <Sprite name="s_punch_laser" fileName="game/particles12.rttex" textureSize="32" frame="20,0" />
    <Sprite name="s_punch_plasma" fileName="game/particles12.rttex" textureSize="32" frame="22,0" />
    <Sprite name="s_tileHit" fileName="game/particles4.rttex" textureSize="32" frame="2,0" />
    <VariableMap>
      <Set name="PetFlyWalk.IsWalking">false</Set>
      <Set name="PetFlyWalk.IsFlying">false</Set>
      <Set name="PetFlyWalk.IsLanding">true</Set>
      <Set name="PetFlyWalk.IsPunching">false</Set>
      <Set name="PetFlyWalk.IsTakeoff">false</Set>
      <Set name="PunchDelay">1.0</Set>
      <Set name="DeltaTime">0.0</Set>
    </VariableMap>
    <Animations>
      <SpriteCurveAnimation name="plasma_anim" sprite="s_punch_plasma" animTime="500" isLoop="true" playOnState="Pet.IdleShoot|Pet.FlyingShoot">
        <Curve name="scale">
          <KeyFrame>0.f, 0.1f, 0.75f</KeyFrame>
          <KeyFrame>0.5f, 0.75f, 0.5f</KeyFrame>
          <KeyFrame>1.f, 1.25f, 0.75f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="a_PetFly" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.Fly">
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetFlyingShoot" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.FlyingShoot">
        <Frame>4,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetIdle" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.Idle">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetIdleShoot" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.IdleShoot">
        <Frame>0,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetLand" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.Land">
        <Frame>7,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetTakeoff" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.TakeOff">
        <Frame>6,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetWalk" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.Walk">
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_capeFall" sprite="s_cape" animTime="200" isLoop="true" playOnState="Motion.Fall">
        <Frame>2,15</Frame>
        <Frame>3,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_capeIdle" sprite="s_cape" animTime="700" isLoop="true" playOnState="Motion.Idle">
        <Frame>0,13</Frame>
        <Frame>1,13</Frame>
        <Frame>2,13</Frame>
        <Frame>3,13</Frame>
        <Frame>4,13</Frame>
        <Frame>5,13</Frame>
        <Frame>6,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_capeJump" sprite="s_cape" animTime="200" isLoop="true" playOnState="Motion.Jump">
        <Frame>0,15</Frame>
        <Frame>1,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_capeMove" sprite="s_cape" animTime="800" isLoop="true" playOnState="Motion.Move">
        <Frame>7,13</Frame>
        <Frame>8,13</Frame>
        <Frame>9,13</Frame>
        <Frame>10,13</Frame>
        <Frame>11,13</Frame>
        <Frame>12,13</Frame>
        <Frame>13,13</Frame>
        <Frame>14,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="punch_laser_Sprites" sprite="s_punch_laser" animTime="200" isLoop="true" playOnState="Pet.FlyingShoot|Pet.IdleShoot">
        <Frame>20,0</Frame>
        <Frame>21,0</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Pet">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="IdleShoot" />
          <State name="TakeOff" />
          <State name="Fly" />
          <State name="FlyingShoot" />
          <State name="Land" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|Land|FlyingShoot|IdleShoot">
            <Condition type="and">
              <CompareCustomVariable operatorType="Less" VariableNameToCompare="PunchDelay">0.0</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsWalking">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|Land">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsWalking">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="IdleShoot" from="Idle|Walk|FlyingShoot">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="FlyingShoot" from="Fly|Land|IdleShoot|TakeOff">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">true</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="TakeOff" from="Walk|Idle|Land">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsLanding">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsTakeoff">true</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Fly" from="TakeOff|FlyingShoot|IdleShoot">
            <Condition type="and">
              <CompareCustomVariable operatorType="Less" VariableNameToCompare="PunchDelay">0.0</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsLanding">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsTakeoff">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Land" from="Fly|Walk|Idle">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsLanding">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="PetPunch">
        <States>
          <State name="True" />
          <State name="False" />
        </States>
        <Transitions>
          <Transition to="True" from="False">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">true</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="False" from="True">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Move|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Jump|Fall|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_doubleJumpCoulds">
        <Emitter>
          <Set name="lifeTime">1.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">3</Set>
        </Emitter>
        <Particle>
          <Select name="sprite" input="particleIndex">
            <Item>"s_doubleJumpSideCloud"</Item>
            <Item>"s_doubleJumpSideCloud"</Item>
            <Item>"s_doubleJumpDownCloud"</Item>
          </Select>
          <Select name="offset" input="particleIndex">
            <Item>0, 0</Item>
            <Item>0, 0</Item>
            <Item>0, -10</Item>
          </Select>
          <Set name="interpolateVelocity">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 2, 2</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Select name="initialVelocity" input="particleIndex">
            <Item>-40, 0</Item>
            <Item>40, 0</Item>
            <Item>0, 40</Item>
          </Select>
          <Set name="finalVelocity">0, 0</Set>
          <Select name="flipX" input="particleIndex">
            <Item>false</Item>
            <Item>true</Item>
            <Item>false</Item>
          </Select>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_doubleJumpLines">
        <Emitter>
          <Set name="lifeTime">1.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_doubleJumpLines</Set>
          <Set name="renderAlignment">DOWN_CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1.6</KeyFrame>
            <KeyFrame>1, 1, 2.2</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialVelocity">0, 60</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tileHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <Random name="initialAngle" min="0" max="360" />
          <Set name="initialRotationRate">360</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="DefaultPunchSound">audio/laser.wav</Set>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-36,0</Set>
        <Set name="UsePetForceFaceTime">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <Update>

      <ArithmethicOperation LeftHandVariableName="PunchDelay" RightHandVariableName="DeltaTime" OperationType="Substract"/>

      <StopIf>
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsVariableBool name="isMannequin">true</IsVariableBool>
        <IsVariableBool name="isBattleLeash">true</IsVariableBool>
      </StopIf>
      <AvatarTransform class="Face" onState="PetPunch.True">
        <Set name="face">NORMAL</Set>
      </AvatarTransform>
      <AvatarTransform class="FootPosition" onState="Motion.Idle|Motion.Move">
        <Set name="foot1dy">0</Set>
        <Set name="foot2dy">0</Set>
        <Set name="foot1y">0</Set>
        <Set name="foot2y">0</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Move">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">225</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Move">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">225</Set>
      </AvatarTransform>
    </Update>
    <OnPunchStart>
      <ArithmethicOperation LeftHandVariableName="PunchDelay" RightHandVariableName="1.0" OperationType="Set"/>
    </OnPunchStart>
    <RenderFrontpack>
      <Group>
        <StopIf>
          <IsFacingLeft>false</IsFacingLeft>
        </StopIf>
        <SpriteRender name="s_medalFlipped" offset="0,0" alignment="DOWN_CENTER" />
      </Group>
      <Group>
        <StopIf>
          <IsFacingLeft>true</IsFacingLeft>
        </StopIf>
        <SpriteRender name="s_medal" offset="0,0" alignment="DOWN_CENTER" />
      </Group>
    </RenderFrontpack>
    <RenderBackpack>
      <SpriteRender name="s_cape" offset="0,-16" />
    </RenderBackpack>
    <RenderPet>
      <SpriteRender name="s_pet" offset="0,0" alignment="DOWN_CENTER" />
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="s_punch_plasma" offset="8,-9" scale="1,0.5" onState="PetPunch.True" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0" />
      <SpriteRender name="s_punch_laser" offset="8,-9" scale="1,0.5" onState="PetPunch.True" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0" />
    </RenderPet>
    <UpdatePet>
      <ContextUpdate type="SetPetFlyWalk">
        <Set name="PetFlyWalk.LandingSpeed">100</Set>
        <Set name="PetFlyWalk.WalkSpeed">400</Set>
        <Set name="PetFlyWalk.FlySpeed">3000</Set>
        <Set name="PetFlyWalk.WarpDistance">800</Set>
        <Set name="PetFlyWalk.FlightDuration">2</Set>
        <Set name="PetFlyWalk.LandingTimeStart">0.2</Set>
        <Set name="PetFlyWalk.FlightTimeStart">1.9</Set>
        <Set name="PetFlyWalk.FlyingOffset">35,0</Set>
        <Set name="PetFlyWalk.WalkOffset">35,0</Set>
      </ContextUpdate>
    </UpdatePet>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_doubleJumpCoulds" onAction="JUMPDOUBLE" />
      <ParticleSystemUpdate name="ps_doubleJumpLines" onAction="JUMPDOUBLE" />
    </AddClothingParticles>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_CAPTAIN_LAZERHAWKS_EYES">
	<Data>
		<StateMachines>
			<StateMachine name="state">
				<States>
					<State name="Equip"/>
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition from="Punch" to="Equip">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="Equip" to="Punch">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="equip_Sprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="21,13"/>
		<Sprite name="equip_glow_Sprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="22,13"/>
		<Sprite name="punch_Sprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="22,13"/>
		
		<Animations>
			<SpriteCurveAnimation name="item_glow" isLoop="true" playOnState="state.Equip" sprite="equip_glow_Sprite" animTime="3000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.286f, 0.f </KeyFrame>
					<KeyFrame>0.4286f, 1.f</KeyFrame>
					<KeyFrame>0.7142f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="item_glow_punch" isLoop="true" playOnState="state.Punch" sprite="equip_glow_Sprite" animTime="3000">
				<Curve name="alpha">
					<KeyFrame>0.f, 1.f</KeyFrame>
					<KeyFrame>1.f, 1.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
		</Animations>
		
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="IsNightVision">true</Set>
			</Default>
		</RenderOptions>
		
	</Data>

	<RenderRules>
		<RenderFaceItem>
			<SpriteRender name="equip_Sprite" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
			<SpriteRender name="equip_glow_Sprite" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderFaceItem>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_CAROUSEL_HORSE">
  <Data>
    <Sprite name="s_foot1" fileName="game/player_feet16.rttex" textureSize="32" frame="31,14"/>
    <Sprite name="s_foot2" fileName="game/player_feet16.rttex" textureSize="32" frame="31,15"/>
    <Sprite name="s_pole" fileName="game/particles_large13.rttex" textureSize="64" frame="11,8"/>

    <Animations>
      <SpriteAnimation name="a_pole" sprite="s_pole" isLoop="true" animTime="800" autoPlay="true">
        <Frame>11,8</Frame>
        <Frame>12,8</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="ClothingOffsetFromShoes">-7</Set>
        <Set name="IsToRenderPants">true</Set>
        <Set name="IsVehicle">true</Set>
        <Set name="IsRidingBird">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="UserNameOffset">24</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <RenderShoes>
      <SpriteRender name="s_foot1" offset="2,8" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT"/>
      <SpriteRender name="s_foot2" offset="2,8" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT"/>
      <StopIf>
        <IsAction>PUNCH</IsAction>
        <IsAction>BUILD</IsAction>
        <IsSitting>true</IsSitting>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
    </RenderShoes>
    <RenderBehind>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSitting>true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <SpriteRender name="s_pole" blend="PREMULTIPLIED_ALPHA" offset="0,5"/>
    </RenderBehind>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_equip" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="30,26"/>
    <Sprite name="s_projectile" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="30,26"/>
    <Sprite name="s_projectileTrail" fileName="game/particles12.rttex" textureSize="32" frame="19,0"/>

    <VariableMap>
      <Set name="context.pos">0, 0</Set>
      <Set name="target.pos">0, 0</Set>
      <Set name="calculatedPos">0, 0</Set>
      <Set name="boomerangAngle">0</Set>
      <Set name="boomerang.Offset">0, 0</Set>
    </VariableMap>

    <Animations>
      <InterpolationVec2Animation name="a_punchStart" variableName="calculatedPos" targetVariableName="target.pos" animTime="500" playOnState="PunchAnim.Start"/>
      <InterpolationVec2Animation name="a_punchContinue" variableName="calculatedPos" targetVariableName="target.pos" animTime="30" isLoop="true" playOnState="PunchAnim.Continue"/>
      <InterpolationVec2Animation name="a_punchEnd" variableName="calculatedPos" targetVariableName="context.pos" animTime="250" playOnState="PunchAnim.End"/>

      <InterpolationVec2Animation name="a_asdfStart" variableName="boomerang.Offset" targetValue="0,0" animTime="500" playOnState="PunchAnim.Start"/>
      <InterpolationVec2Animation name="a_dfyjrtEnd" variableName="boomerang.Offset" targetValue="0,-8" animTime="250" playOnState="PunchAnim.End"/>

      <CurveAnimationFloat name="a_boomerangRotationRight" playOnState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" isLoop="true" useFacing="RIGHT" animTime="250">
        <Curve name="boomerangAngle">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, 360</KeyFrame>
        </Curve>
      </CurveAnimationFloat>
      <CurveAnimationFloat name="a_boomerangRotationLeft" playOnState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" isLoop="true" useFacing="LEFT" animTime="250">
        <Curve name="boomerangAngle">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, -360</KeyFrame>
        </Curve>
      </CurveAnimationFloat>

    </Animations>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="PunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start" ExitTime="0.5" />
          <State name="Continue"/>
          <State name="End" ExitTime="0.25" />
        </States>
        <Transitions>
          <Transition from="Off" to="Start">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue"/>
          <Transition from="Continue" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off"/>
        </Transitions>
      </StateMachine>
      <StateMachine name="IdleState">
        <States>
          <State name="Idle" />
          <State name="NotIdle" />
        </States>
        <Transitions>
          <Transition from="Idle" to="NotIdle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="NotIdle" to="Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="punch_particle" secondary="punch_particle_trail">
        <Emitter>
          <Set name="lifeTime">0.02</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="emissionInterval">0.02</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectile</Set>
          <Set name="relativeToEmitter">false</Set>
          <Set name="offset" source="boomerang.Offset"/>
          <Set name="worldPos" source="calculatedPos"/>
          <Set name="initialAngle" source="boomerangAngle"/>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.04</Set>
          <Set name="initialScale">1,1</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_particle_trail">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">2</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="checkParticleNumToEmit">true</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectileTrail</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.35</Set>
          <Random name="initialScale" min="0.25" max="0.75"/>
          <Random name="initialVelocity" min="-5,-5" max="5,5" />
          <Set name="rotateWithVelocity">true</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0, 0.2</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_smoke">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectileTrail</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialRotationRate">360</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <Update>
      <AvatarTransform class="ArmAngle" onState="IdleState.Idle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">-90</Set>
      </AvatarTransform>
      <ArithmethicOperation LeftHandVariableName="calculatedPos" RightHandVariableName="context.pos" OperationType="Set" onState="PunchAnim.Off"/>
    </Update>
    <RenderHandItem>
      <SpriteRender name="s_equip" offset="4,1" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="PunchAnim.Off"/>
      <ParticleSystemUpdate name="punch_particle" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End"/>
    </RenderHandItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_CELEBRATION_CHARM">
  <Data>
    <Sprite name="s_charm" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="22,21" />
    
    <Sprite name="s_sparkBlue" fileName="game/particles11.rttex" textureSize="32" frame="24,25" />
    <Sprite name="s_sparkTrailBlue" fileName="game/particles11.rttex" textureSize="32" frame="26,25" />
    <Sprite name="s_explosionBlue" fileName="game/particles11.rttex" textureSize="32" frame="27,25" />
    
    <Sprite name="s_sparkRed" fileName="game/particles11.rttex" textureSize="32" frame="24,26" />
    <Sprite name="s_sparkTrailRed" fileName="game/particles11.rttex" textureSize="32" frame="26,26" />
    <Sprite name="s_explosionRed" fileName="game/particles11.rttex" textureSize="32" frame="27,26" />
    
    <Sprite name="s_sparkWhite" fileName="game/particles11.rttex" textureSize="32" frame="24,27" />
    <Sprite name="s_sparkTrailWhite" fileName="game/particles11.rttex" textureSize="32" frame="26,27" />
    <Sprite name="s_explosionWhite" fileName="game/particles11.rttex" textureSize="32" frame="27,27" />
    
    <Sprite name="s_sparkMulticolour" fileName="game/particles11.rttex" textureSize="32" frame="24,28" />
    <Sprite name="s_sparkTrailMulticolour" fileName="game/particles11.rttex" textureSize="32" frame="26,28" />
    <Sprite name="s_explosionMulticolour" fileName="game/particles11.rttex" textureSize="32" frame="27,28" />

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <Animations>
      <SpriteAnimation name="a_sparkBlue" sprite="s_sparkBlue">
        <Frame>24,25</Frame>
        <Frame>25,25</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_explosionBlue" sprite="s_explosionBlue" animTime="400" isLoop="false">
        <Frame>30,25</Frame>
        <Frame>27,25</Frame>
        <Frame>28,25</Frame>
        <Frame>29,25</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_sparkRed" sprite="s_sparkRed">
        <Frame>24,26</Frame>
        <Frame>25,26</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_explosionRed" sprite="s_explosionRed" animTime="400" isLoop="false">
        <Frame>30,26</Frame>
        <Frame>27,26</Frame>
        <Frame>28,26</Frame>
        <Frame>29,26</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_sparkWhite" sprite="s_sparkWhite">
        <Frame>24,27</Frame>
        <Frame>25,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_explosionWhite" sprite="s_explosionWhite" animTime="400" isLoop="false">
        <Frame>30,27</Frame>
        <Frame>27,27</Frame>
        <Frame>28,27</Frame>
        <Frame>29,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_sparkMulticolour" sprite="s_sparkMulticolour">
        <Frame>24,28</Frame>
        <Frame>25,28</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_explosionMulticolour" sprite="s_explosionMulticolour" animTime="400" isLoop="false">
        <Frame>30,28</Frame>
        <Frame>27,28</Frame>
        <Frame>28,28</Frame>
        <Frame>29,28</Frame>
      </SpriteAnimation>
    </Animations>
    <ParticleSystems>
      <ParticleSystem name="ps_sparkIdle" secondary="ps_sparkTrail" updateStage="AddClothingParticles" updateState="Motion.Idle" renderStage="RenderChestItem">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Random name="emissionInterval" min="0.5" max="1" />
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Random name="variantId" min="0" max="4" />
          <Select name="sprite" input="variantId">
            <Item>"s_sparkBlue"</Item>
            <Item>"s_sparkRed"</Item>
            <Item>"s_sparkWhite"</Item>
            <Item>"s_sparkMulticolour"</Item>
          </Select>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="isBackgroundParticle">true</Set>
          <RandomRadial name="initialVelocity" angleRange="-125,-55" radiusRange="50,50" />
          <OnFinish>
            <ParticleSystemName>ps_explosion</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_sparkMove" secondary="ps_sparkTrail" updateStage="AddClothingParticles" updateState="Motion.Moving" renderStage="RenderChestItem">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Random name="emissionInterval" min="0.1" max="0.5" />
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Random name="variantId" min="0" max="4" />
          <Select name="sprite" input="variantId">
            <Item>"s_sparkBlue"</Item>
            <Item>"s_sparkRed"</Item>
            <Item>"s_sparkWhite"</Item>
            <Item>"s_sparkMulticolour"</Item>
          </Select>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="isBackgroundParticle">true</Set>
          <RandomRadial name="initialVelocity" angleRange="-125,-55" radiusRange="50,50" />
          <OnFinish>
            <ParticleSystemName>ps_explosion</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_sparkTrail">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">80</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="offset">0,-16</Set>
        </Emitter>
        <Particle UseParentVariantId="true">
          <Select name="sprite" input="variantId">
            <Item>"s_sparkTrailBlue"</Item>
            <Item>"s_sparkTrailRed"</Item>
            <Item>"s_sparkTrailWhite"</Item>
            <Item>"s_sparkTrailMulticolour"</Item>
          </Select>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_explosion">
        <Emitter>
          <Set name="lifeTime">0.4</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0,0</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
        </Emitter>
        <Particle UseParentVariantId="true">
          <Select name="sprite" input="variantId">
            <Item>"s_explosionBlue"</Item>
            <Item>"s_explosionRed"</Item>
            <Item>"s_explosionWhite"</Item>
            <Item>"s_explosionMulticolour"</Item>
          </Select>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="isBackgroundParticle">true</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="HideParticlesOnTransform">true</Set>
        <Set name="HideParticlesOnTheaterSeat">true</Set>
		<Set name="IsToRenderParticlesWhenShrunken">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderChestItem>
      <SpriteRender name="s_charm" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
    </RenderChestItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Belt" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="10,17" />
		<Sprite name="s_Belt_back_proxy" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="4,17" />
		<Sprite name="s_Belt_front_proxy" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="4,18" />
	
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="Idle" />
					<State name="Walk" />
					<State name="JumpStraight" />
					<State name="JumpDiagonal" />
					<State name="FallStraight" />
					<State name="FallDiagonal" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Walk|FallStraight|FallDiagonal">
						<Condition>
							<IsAction>IDLE</IsAction>
						</Condition>
					</Transition>					
					<Transition to="Walk" from="Idle|FallDiagonal|FallStraight">
						<Condition type="and">
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">JUMP</IsAction>
							<IsAction operatorType="NotEqual">FALL</IsAction>
						</Condition>
					</Transition>
					<Transition to="JumpStraight" from="Idle|Walk|FallStraight|JumpDiagonal|FallDiagonal">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>			
					<Transition to="JumpDiagonal" from="Idle|Walk|FallStraight|JumpStraight|FallDiagonal">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="FallStraight" from="Walk|FallDiagonal|JumpStraight|JumpDiagonal|Idle">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>				
					<Transition to="FallDiagonal" from="Walk|FallStraight|JumpStraight|JumpDiagonal|Idle">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="s_Belt_back_proxy_idle" sprite="s_Belt_back_proxy" animTime="600" autoPlay="true" isLoop="true">
				<Frame>4,17</Frame>
				<Frame>5,17</Frame>
				<Frame>6,17</Frame>
				<Frame>7,17</Frame>
				<Frame>8,17</Frame>
				<Frame>9,17</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_Belt_front_proxy_idle" sprite="s_Belt_front_proxy" animTime="600" autoPlay="true" isLoop="true">
				<Frame>4,18</Frame>
				<Frame>5,18</Frame>
				<Frame>6,18</Frame>
				<Frame>7,18</Frame>
				<Frame>8,18</Frame>
				<Frame>9,18</Frame>
			</SpriteAnimation>
			<InterpolationVec4Animation name="idleProxy" variableName="belt_rotation" targetValue="0, 0, 0, 1" animTime="600" playOnState="Action.Idle"/>
			<InterpolationVec4Animation name="walkProxy" variableName="belt_rotation" targetValue="90, 0, 0, 1" animTime="400" playOnState="Action.Walk"/>
			<InterpolationVec4Animation name="fallProxyFallStraight" variableName="belt_rotation" targetValue="180, 0, 0, 1" animTime="1000" playOnState="Action.FallStraight"/>
			<InterpolationVec4Animation name="fallProxyFallDiagonal" variableName="belt_rotation" targetValue="135, 0, 0, 1" animTime="400" playOnState="Action.FallDiagonal"/>
			<InterpolationVec4Animation name="jumpProxyJumpStraight" variableName="belt_rotation" targetValue="0, 0, 0, 1" animTime="1000" playOnState="Action.JumpStraight"/>
			<InterpolationVec4Animation name="jumpProxyJumpDiagonal" variableName="belt_rotation" targetValue="45, 0, 0, 1" animTime="400" playOnState="Action.JumpDiagonal"/>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="ShouldHover">true</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="belt_rotation">0, 0, 0, 1</Set>
			<Set name="belt_position">0, -17, 0</Set>
			<Set name="proxy_position">-7, -10, 0</Set>
			<Set name="proxy_position_back">5.5, -10, 0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Action.Walk">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">45</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Action.Walk">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
		</Update>
		<RenderChestBackItem>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
			</StopIf>
			<Group>			
				<Translate>proxy_position_back</Translate>
				<Rotate>belt_rotation</Rotate>
				<SpriteRender name="s_Belt_back_proxy" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER"/>
			</Group>
			<Group>			
				<Translate>proxy_position</Translate>
				<Rotate>belt_rotation</Rotate>
				<SpriteRender name="s_Belt_front_proxy" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER"/>
			</Group>
		</RenderChestBackItem>
		<RenderChestItem>
			<Translate>belt_position</Translate>
			<SpriteRender name="s_Belt" blend="PREMULTIPLIED_ALPHA" />
		</RenderChestItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_PomPom" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="18,27" />
    <Animations>
      <SpriteAnimation name="a_PomPomNonPunch" sprite="s_PomPom" animTime="300" autoPlay="true" isLoop="true" playOnState="Punch.False">
        <Frame>18,27</Frame>
        <Frame>19,27</Frame>
        <Frame>20,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PomPomPunch" sprite="s_PomPom" animTime="100" isLoop="true" playOnState="Punch.True">
        <Frame>18,27</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Idle">
        <States>
          <State name="False" />
          <State name="TriggerDab" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="True" to="False">
            <Condition type="or">
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsSitting>true</IsSitting>
              <IsAction>PUNCH</IsAction>
              <IsAction>BUILD</IsAction>
              <IsZombified >true</IsZombified>
              <SubCondition type="and">
                <IsAction>IDLE</IsAction>
                <IsZombified>false</IsZombified>
              </SubCondition>
            </Condition>
          </Transition>
          <Transition from="False" to="TriggerDab">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsSitting>false</IsSitting>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">BUILD</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="TriggerDab" to="True"/>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <Update>
      <AvatarTransform class="NetAvatarAction" onState="Idle.TriggerDab">
        <Set name="action">DANCE_DAB</Set>
      </AvatarTransform>
    </Update>
    <SwitchOffClothingParticles>
      <Group onState="Idle.True">
      <AvatarTransform class="NetAvatarAction">
        <Set name="action">IDLE</Set>
      </AvatarTransform>
      </Group>
    </SwitchOffClothingParticles>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_PomPom" offset="-4,12" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="Punch.False"/>
    </RenderBackHandItem>
    <RenderHandItem>
      <SpriteRender name="s_PomPom" offset="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" />
    </RenderHandItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_headBand" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="17,17"/>
    <Sprite name="s_headBandGlow" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="18,17"/>
    
    <StateMachines>
      <StateMachine name="Move">
        <States>
          <State name="False"/>
          <State name="True"/>
        </States>
        <Transitions>
          <Transition to="False" from="True">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="True" from="False">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteCurveAnimation name="a_headBandGlow" isLoop="true" autoPlay="true" sprite="s_headBandGlow" animTime="1000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="particle_trail" updateStage="AddClothingParticles" updateState="Move.True">
        <Emitter>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="useCharacterPos">true</Set>
        </Emitter>
        <Particle>
          <Set name="rainbowShift">true</Set>
          <Set name="useAvatarShadow">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="DefaultPunchSound">audio/thousandSlash.wav</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <RenderHat>
      <SpriteRender name="s_headBand" alignment="DOWN_CENTER" offset="0,-16"/>
      <SpriteRender name="s_headBandGlow" alignment="DOWN_CENTER" offset="0,-16" drawShadow="false"/>
    </RenderHat>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Hat" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="2,23" />
		<Sprite name="s_Pet" fileName="game/particles11.rttex" textureSize="32" frame="27,11" />
		<Sprite name="s_StarTrail1" fileName="game/particles11.rttex" textureSize="32" frame="28,31" />
		<Sprite name="s_StarTrail2" fileName="game/particles11.rttex" textureSize="32" frame="30,31" />
		<Animations>
			<SpriteAnimation name="a_StarTrail1" sprite="s_StarTrail1" animTime="800">
				<Frame>28,31</Frame>
				<Frame>29,31</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_StarTrail2" sprite="s_StarTrail2" animTime="800">
				<Frame>30,31</Frame>
				<Frame>31,31</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_StarTrail1" updateStage="RenderPet">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_StarTrail1</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.2, 0.2</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.5</Set>
					<Random name="initialAngle" min="-180" max="180" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_StarTrail2" updateStage="RenderPet">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_StarTrail2</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.2, 0.2</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.5</Set>
					<Random name="initialAngle" min="-180" max="180" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderHat>
			<SpriteRender name="s_Hat" offset="0,-32" blend="PREMULTIPLIED_ALPHA" />
		</RenderHat>
		<RenderPet>
			<ParticleSystemRender name="ps_StarTrail1" />
			<ParticleSystemRender name="ps_StarTrail2" />
			<SpriteRender name="s_Pet" scale="0.7,0.7" alignment="DOWN_CENTER" />	
		</RenderPet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_KetchupBottle" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="4,1" />
		<Sprite name="s_Pet" fileName="game/pets/p_cinder.rttex" textureSize="32" frame="0,0" />
		<Animations>
			<SpriteAnimation name="a_Attack" sprite="s_Pet" animTime="200" isLoop="true" playOnState="Motion.Punch">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Fall" sprite="s_Pet" animTime="100" isLoop="true" playOnState="Motion.Down">
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Idle" sprite="s_Pet" animTime="300" isLoop="true" playOnState="Motion.None">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Jump" sprite="s_Pet" animTime="100" isLoop="true" playOnState="Motion.Up">
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Move" sprite="s_Pet" animTime="300" isLoop="true" playOnState="Motion.Horizontal">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<InterpolationVec3Animation name="FirstCinderPosOffsetAnimNone" variableName="FirstCinderPosOffset" targetVariableName="FirstCinderDesiredPos" isLoop="false" animTime="500" playOnState="Movement.Idle"/>
			<InterpolationVec3Animation name="FirstCinderPosOffsetAnimMove" variableName="FirstCinderPosOffset" targetVariableName="FirstCinderDesiredPosWalk" isLoop="false" animTime="500" playOnState="Movement.Movement"/>			
			
			<InterpolationVec3Animation name="SecondCinderPosOffsetAnimNone" variableName="SecondCinderPosOffset" targetVariableName="SecondCinderDesiredPos" isLoop="false" animTime="500" playOnState="Movement.Idle"/>
			<InterpolationVec3Animation name="SecondCinderPosOffsetAnimMove" variableName="SecondCinderPosOffset" targetVariableName="SecondCinderDesiredPosWalk" isLoop="false" animTime="500" playOnState="Movement.Movement"/>
		</Animations>
		<StateMachines>
			<StateMachine name="Movement">
				<States>
					<State name="Idle"/>
					<State name="Movement"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Movement">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Movement" from="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="GreaterOrEqual" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Motion">
				<States>
					<State name="None"/>
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal"/>
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition type="or">
							<IsVariableBool name="isMannequin">true</IsVariableBool>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-17,0</Set>
				<Set name="UsePetForceFaceTime">false</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="FirstCinderDesiredPos">0,0,0</Set>
			<Set name="FirstCinderDesiredPosWalk">-16,0,0</Set>
			<Set name="FirstCinderPosOffset">-32,0,0</Set>
			
			<Set name="SecondCinderDesiredPos">0,0,0</Set>
			<Set name="SecondCinderDesiredPosWalk">16,0,0</Set>
			<Set name="SecondCinderPosOffset">32,0,0</Set>
			
			<Set name="facingVariable">0,0,0</Set>
			<Set name="playerPositionVariable">0, 0, 0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<SpriteRender name="s_KetchupBottle" rotationPoint="0,1" alignment="UPPER_CENTER" />
		</RenderHandItem>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderPet>
			<Group>
				<Group onState="Movement.Idle">
					<ArithmethicOperation LeftHandVariableName="FirstCinderDesiredPos" RightHandVariableName="48,0,0" OperationType="Set"/>
				</Group>
				<Group onState="Movement.Movement">
					<ArithmethicOperation LeftHandVariableName="FirstCinderDesiredPosWalk" RightHandVariableName="24,0,0" OperationType="Set"/>
				</Group>

				<Translate>FirstCinderPosOffset</Translate>
				<SpriteRender name="s_Pet" offset="0,0" alignment="DOWN_CENTER" />
			</Group>
			<Group>
				<Group onState="Movement.Idle">
					<ArithmethicOperation LeftHandVariableName="SecondCinderDesiredPos" RightHandVariableName="-16,0,0" OperationType="Set"/>
				</Group>
				<Group onState="Movement.Movement">
					<ArithmethicOperation LeftHandVariableName="SecondCinderDesiredPosWalk" RightHandVariableName="-8,0,0" OperationType="Set"/>
				</Group>
				
				<Translate>SecondCinderPosOffset</Translate>
				<SpriteRender name="s_Pet" offset="0,0" alignment="DOWN_CENTER" />
			</Group>
		</RenderPet>
		<UpdatePet>
			<ContextUpdate type="SetPetWalkRunJump">
				<Set name="PetWalkRunJump.minSpeed">500</Set>
				<Set name="PetWalkRunJump.distSpeedMult">10</Set>
			</ContextUpdate>
		</UpdatePet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_CLASSY_COMICS_ACID_FLOWER">
  <Data>
    <StateMachines>
      <StateMachine name="playerState">
        <States>
          <State name="Idle"/>
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition from="Punch" to="Idle" >
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Idle" to="Punch">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Sprite name="item_Sprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="19,15"/>
    <Sprite name="acid_drop_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="31,19"/>

    <Animations>
      <SpriteAnimation name="idle_animation" sprite="item_Sprite" playOnState="playerState.Idle">
        <Frame>19,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="punch_animation" sprite="item_Sprite" playOnState="playerState.Punch">
        <Frame>20,15</Frame>
      </SpriteAnimation>
    </Animations>

  <ParticleSystems>
			<ParticleSystem name="punch_projectile" updateStage="AddClothingParticles" updateState="playerState.Punch">
				<Emitter>
					<Set name="offset">7, -13</Set>
					<Set name="emissionInterval">0.001</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle autoLifeTimeToTarget="true">
					<Set name="sprite">acid_drop_Sprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initialScale">1, 1</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<RandomRadial name="initialVelocity" angleRange="-5,5" radiusRange="200,250" baseAnglePosition="targetPos" baseOffset="0,16"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_splash">
				<Emitter attachment="targetPos">
					<Set name="lifeTime">1</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="particlesPerEmission">30</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">acid_drop_Sprite</Set>
					<Random name="offset" min="0, 0" max="0, 0"/>
					<Set name="rotateWithVelocity">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 0.25, 0.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="-90,90" radiusRange="25,75" baseAnglePosition="targetPos" baseOffset="0,16"/>
					<Set name="gravityVector">0, 45</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IsToRenderParticlesWhenShrunken">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderChestItem>
      <SpriteRender name="item_Sprite" alignment="DOWN_CENTER"/>
    </RenderChestItem>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">E_HAPPY</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="punch_splash"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="punch_splash"/>
    </OnDestroyedTile>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="punch_splash"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_capeBack" fileName="game/particles_large13.rttex" textureSize="64"/>
    <Sprite name="s_capeFront" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="16,17" />
    <Sprite name="s_capeBackTemp" fileName="game/particles_large13.rttex" textureSize="64"/>
    <Animations>
      <SpriteAnimation name="a_cape" sprite="s_capeBack" isLoop="true" animTime="800" autoPlay="false" playOnState="Motion.Idle">
        <Frame>0,11</Frame>
        <Frame>1,11</Frame>
        <Frame>2,11</Frame>
        <Frame>3,11</Frame>
        <Frame>4,11</Frame>
        <Frame>5,11</Frame>
        <Frame>6,11</Frame>
        <Frame>7,11</Frame>
      </SpriteAnimation>       
		<SpriteAnimation name="temp_a_cape" sprite="s_capeBackTemp" isLoop="true" animTime="800" autoPlay="true">
        <Frame>0,11</Frame>
        <Frame>1,11</Frame>
        <Frame>2,11</Frame>
        <Frame>3,11</Frame>
        <Frame>4,11</Frame>
        <Frame>5,11</Frame>
        <Frame>6,11</Frame>
        <Frame>7,11</Frame>
      </SpriteAnimation>      
		<SpriteAnimation name="moving" sprite="s_capeBack" isLoop="true" animTime="800" autoPlay="false" playOnState="Motion.Move">
        <Frame>0,12</Frame>
        <Frame>1,12</Frame>
        <Frame>2,12</Frame>
        <Frame>3,12</Frame>
        <Frame>4,12</Frame>
        <Frame>5,12</Frame>
        <Frame>6,12</Frame>
        <Frame>7,12</Frame>
      </SpriteAnimation>
		
	    <InterpolationVec3Animation name="fishMove" variableName="fishPositionVariable" offsetVariableName="baloonOffset" targetVariableName="playerPositionVariable" isLoop="false" animTime="15000" playOnState="Motion.Move" />
	    <InterpolationVec3Animation name="i_fishSnapped" variableName="fishPositionVariable" offsetVariableName="sittingOffset" targetVariableName="playerPositionVariable" isLoop="false" animTime="250" playOnState="Motion.Idle" />
    </Animations>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition type="or">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
	            <IsVariableBool name="isMannequin">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
	            <IsVariableBool name="isMannequin">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
	    <StateMachine name="Facing">
		    <States>
			    <State name="Left" />
			    <State name="Right" />
		    </States>
		    <Transitions>
			    <Transition to="Left" from="Right">
				    <Condition>
					    <IsFacingLeft>true</IsFacingLeft>
				    </Condition>
			    </Transition>
			    <Transition to="Right" from="Left">
				    <Condition type="or">
					    <IsVariableBool name="isMannequin">true</IsVariableBool>
					    <IsFacingLeft>false</IsFacingLeft>
				    </Condition>
			    </Transition>
		    </Transitions>
	    </StateMachine>
    </StateMachines>
	  
    <VariableMap>
	    <Set name="baloonOffsetEmpty">0, 0, 0</Set>
	    <Set name="baloonOffsetIdle">0, 0, 0</Set>
	    <Set name="baloonOffset">0, 0, 0</Set>
	    <Set name="baloonOffsetRight">-32, 0, 0</Set>
	    <Set name="baloonOffsetLeft">32, 0, 0</Set>
	    <Set name="playerPositionVariable">0, 0, 0</Set>
	    <Set name="fishPositionVariable">0, 0, 0</Set>
	    <Set name="fishPositionVariableTemp">0, 0, 0</Set>
	    <Set name="facingVariable">1, 1, 1</Set>
	    <Set name="sittingOffset">0, 0, 0</Set>
	    <Set name="localScale">1, 1, 1</Set>
    </VariableMap>
  </Data>
  <RenderRules>
	  <OnEnteredToWorld>
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariable" RightHandVariableName="playerPositionVariable" OperationType="Set" />
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp" RightHandVariableName="playerPositionVariable" OperationType="Set" />
	  </OnEnteredToWorld>		
	  <OnRespawned>
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariable" RightHandVariableName="playerPositionVariable" OperationType="Set" />
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp" RightHandVariableName="playerPositionVariable" OperationType="Set" />
	  </OnRespawned>
	  <OnItemEquipped>
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariable" RightHandVariableName="playerPositionVariable" OperationType="Set" />
		  <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp" RightHandVariableName="playerPositionVariable" OperationType="Set" />
	  </OnItemEquipped>
    <RenderBackpack>
	    <StopIf>
		    <IsVariableBool name="isMannequin">true</IsVariableBool>
	    </StopIf>
	    <StopIf type="or">
		    <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
		    <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
		    <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
	    </StopIf>
	    <Group>
		    <StopIf>
			    <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
		    </StopIf>
		    <ArithmethicOperation LeftHandVariableName="baloonOffset" RightHandVariableName="baloonOffsetRight" OperationType="Set" onState="Facing.Right" />
		    <ArithmethicOperation LeftHandVariableName="baloonOffset" RightHandVariableName="baloonOffsetLeft" OperationType="Set" onState="Facing.Left" />
			
		    <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp" RightHandVariableName="fishPositionVariable" OperationType="Set" />
		    <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp" RightHandVariableName="playerPositionVariable" OperationType="Substract" />
		    <ArithmethicOperation LeftHandVariableName="fishPositionVariableTemp" RightHandVariableName="facingVariable" OperationType="Multiply"/>
			
		    <ArithmethicOperation LeftHandVariableName="baloonOffsetIdle" RightHandVariableName="sittingOffset" OperationType="Set" />
		    <ArithmethicOperation LeftHandVariableName="baloonOffsetIdle" RightHandVariableName="-1,-1,-1" OperationType="Multiply" />
			
		    <ArithmethicOperation LeftHandVariableName="playerPositionVariable" RightHandVariableName="baloonOffsetIdle" OperationType="Substract" />

			
			<Translate>fishPositionVariableTemp</Translate>
			<Translate>baloonOffsetIdle</Translate>
		    <SpriteRender name="s_capeBack" offset="0,-1" alignment="DOWN_CENTER"/>
	    </Group>
    </RenderBackpack>
    <RenderFrontpack>
      <SpriteRender name="s_capeFront" offset="0,0" alignment="DOWN_CENTER" onState="Motion.Idle"/>
    </RenderFrontpack>
	 <RenderBehind>
		  <StopIf>
			  <IsVariableBool name="isMannequin">false</IsVariableBool>
		  </StopIf>
		  <SpriteRender name="s_capeBackTemp" offset="0,-8"/>
	 </RenderBehind>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>

<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="ClothingType">
				<States>
					<State name="NoneOnGround" />
					<State name="NoneOnHover" />
				</States>
				<Transitions>
					<Transition to="NoneOnGround" from="NoneOnHover">
						<Condition>
							<ItemHasTag operatorType="NotEqual">Hovering_Cloak</ItemHasTag>
						</Condition>
					</Transition>
					<Transition to="NoneOnHover" from="NoneOnGround">
						<Condition>
							<ItemHasTag>Hovering_Cloak</ItemHasTag>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="HoveringType">
				<States>
					<State name="NoneOnGround" />
					<State name="NoneOnHover" />
				</States>
				<Transitions>
					<Transition to="NoneOnGround" from="NoneOnHover">
						<Condition type="or">
							<ItemHasTag operatorType="NotEqual">Hovering_Cloak</ItemHasTag>
							<IsRenderObjectFlag>RENDER_OBJECT_FLAG_HOVER</IsRenderObjectFlag>
						</Condition>
					</Transition>
					<Transition to="NoneOnHover" from="NoneOnGround">
						<Condition type="and">
							<ItemHasTag>Hovering_Cloak</ItemHasTag>
							<IsRenderObjectFlag operatorType="NotEqual">RENDER_OBJECT_FLAG_HOVER</IsRenderObjectFlag>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="s_backPiece" fileName="game/particles_large18.rttex" textureSize="64" frame="7,3" />
		<Sprite name="s_backPiece_ground" fileName="game/particles_large18.rttex" textureSize="64" frame="7,3" />
		<Sprite name="s_strap" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="1,9" />
		<Sprite name="s_mist" fileName="game/particles.rttex" textureSize="32" frame="0,0" />

		<Animations>

			<SpriteAnimation name="a_wing_closed" sprite="s_backPiece_ground" animTime="1200" isLoop="true"
			                 playOnState="ClothingType.NoneOnGround">
				<Frame>7,3</Frame>
				<Frame>8,3</Frame>
				<Frame>9,3</Frame>
				<Frame>10,3</Frame>
				<Frame>11,3</Frame>
				<Frame>12,3</Frame>
				<Frame>13,3</Frame>
				<Frame>14,3</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="a_wing_open" sprite="s_backPiece" animTime="1200" isLoop="true"
			                 playOnState="ClothingType.NoneOnHover">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="a_MistParticle" sprite="s_mist">
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>

			<CurveAnimationFloat name="a_Offset" isLoop="true" animTime="1000" playOnState="HoveringType.NoneOnHover">
				<Curve name="AdditionalClothingOffset">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, -6.8</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</CurveAnimationFloat>			
			
			<CurveAnimationFloat name="a_ground_Offset" isLoop="true" animTime="700" playOnState="HoveringType.NoneOnGround">
				<Curve name="AdditionalClothingOffset">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="MistParticle">
				<Emitter>
					<Set name="offset">0, -10</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_mist</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart">0</Set>

					<Set name="orbitPeriod">3</Set>
					<Set name="initialRotationRate">200</Set>
					<Set name="applyOrbit">true</Set>

					<Set name="orbitScaleVariation">0.08</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>

					<Curve name="orbit">
						<KeyFrame>0, -24, 24</KeyFrame>
						<KeyFrame>0.25, -24, -24</KeyFrame>
						<KeyFrame>0.5, -24, 8</KeyFrame>
						<KeyFrame>1, -24, -24</KeyFrame>
					</Curve>
		

					<Random name="initialAngle" min="0" max="360" />
					<Random name="finalAngle" min="0" max="360" />
					<Random name="lifeTime" min="5.8" max="6" />
					<Random name="initialScale" min="0.15,0.15" max="0.4, 0.5" />
					<Set name="interpolateScale">true</Set>

					<Set name="initalRGB">0.486, 0.168, 0.835</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="OnEquipTag">Hovering_Cloak</Set>
				<Set name="ShouldHover">false</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="AdditionalClothingOffset">0</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="AdditionalClothingOffset">0</Set>
			<Set name="ShouldHover">false</Set>
		</VariableMap>
	</Data>

	<RenderRules>		
		<RenderInFront value="playerCenter">
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ParticleSystemRender name="MistParticle" />
		</RenderInFront>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>		
		
		<Update>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<AvatarTransform class="FootPosition" onState="ClothingType.NoneOnHover">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>

			<AvatarTransform class="ArmAngle" onState="ClothingType.NoneOnHover">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">45</Set>
			</AvatarTransform>
			<StopIf>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="ClothingType.NoneOnHover">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ParticleSystemUpdate name="MistParticle" />
		</AddClothingParticles>
		<RenderBackpack>
			<SpriteRender name="s_backPiece" scale="1,1" offset="0,16" flip="0,0" alignment="DOWN_CENTER"
			              onState="ClothingType.NoneOnHover" />
			<SpriteRender name="s_backPiece_ground" scale="1,1" offset="0,0" flip="0,0" alignment="DOWN_CENTER"
			              onState="ClothingType.NoneOnGround" />

			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
		</RenderBackpack>


		<RenderFrontpack value="playerCenter">
			<SpriteRender name="s_strap" offset="0,0" alignment="DOWN_CENTER" />

	
		</RenderFrontpack>

	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="Sprite10" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="9,6" />
        <Sprite name="Sprite16" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="10,6" />
		<Sprite name="s_punch" fileName="game/particles.rttex" textureSize="32" frame="0,6" />
        <Animations />
        <ParticleSystems>
			<ParticleSystem name="PunchParticle">
				<Emitter attachment="targetPos">
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Random name="offset" min="-16,-16" max="16,16" />
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5,0.75" max="0.5,1" />
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <VariableMap />
        <StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
        <RenderOptions>
			<Default>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="DefaultPunchSound">audio/slash.wav</Set>
			</Default>
		</RenderOptions>
    </Data>
    <RenderRules>
        <RenderHandItem>
            <Translate forceValue="false">0,16,0</Translate>
            <SpriteRender name="Sprite10" blend="NORMAL" alignment="CENTER" drawShadow="true" />
        </RenderHandItem>
        <RenderBackHandItem>
            <Translate forceValue="false">-4.5,11,0</Translate>
            <SpriteRender name="Sprite16" blend="NORMAL" alignment="CENTER" drawShadow="true" />
        </RenderBackHandItem>
        <OnPunchUpdate>
            <AvatarTransform class="ArmAngle">
                <Set name="armName">arm2Angle</Set>
                <Set name="Curve">
                    <KeyFrame>0,0</KeyFrame>
                    <KeyFrame>1,360</KeyFrame>
                </Set>
                <Set name="animTime">250</Set>
            </AvatarTransform>
            <AvatarTransform class="ArmAngle">
                <Set name="armName">arm1Angle</Set>
                <Set name="Curve">
                    <KeyFrame>0,180</KeyFrame>
                    <KeyFrame>1,540</KeyFrame>
                </Set>
                <Set name="animTime">250</Set>
            </AvatarTransform>
        </OnPunchUpdate>
		<OnPunchStart>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchStart>
		<AddClothingParticles>
		  <ParticleSystemUpdate name="PunchParticle" onState="Punch.Yes"/>
		</AddClothingParticles>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Belt" fileName="game/particles_large15.rttex" textureSize="64" frame="0,8" />
		<Sprite name="s_BeltFront" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="14,26" />
	
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="Idle" />
					<State name="JumpStraight" />
					<State name="FallStraight" />
				</States>
				<Transitions>
					<Transition to="Idle" from="FallStraight">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>					
					<Transition to="JumpStraight" from="Idle|FallStraight">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>			
					<Transition to="FallStraight" from="JumpStraight|Idle">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>				
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteCurveAnimation name="s_armor_glowing_s_Belt" isLoop="true" autoPlay="true" sprite="s_Belt" animTime="50">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.75f</KeyFrame>
					<KeyFrame>1.f, 0.75f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="s_BeltFront_alpha" isLoop="true" autoPlay="true" sprite="s_BeltFront" animTime="50">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.75f</KeyFrame>
					<KeyFrame>1.f, 0.75f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="s_Belt_idle" sprite="s_Belt" animTime="800" isLoop="true" playOnState="Action.Idle">
				<Frame>0,8</Frame>
				<Frame>1,8</Frame>
				<Frame>2,8</Frame>
				<Frame>3,8</Frame>
				<Frame>4,8</Frame>
				<Frame>5,8</Frame>
				<Frame>6,8</Frame>
				<Frame>7,8</Frame>
			</SpriteAnimation>		
			
			<SpriteAnimation name="s_Belt_fall" sprite="s_Belt" animTime="200" isLoop="true" playOnState="Action.FallStraight">
				<Frame>8,8</Frame>
				<Frame>9,8</Frame>
			</SpriteAnimation>	
			
			<SpriteAnimation name="s_Belt_jump" sprite="s_Belt" animTime="50" isLoop="false" playOnState="Action.JumpStraight">
				<Frame>10,8</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Belt_front_idle" sprite="s_BeltFront" animTime="800" isLoop="true" playOnState="Action.Idle">
				<Frame>14,26</Frame>
				<Frame>15,26</Frame>
				<Frame>16,26</Frame>
				<Frame>17,26</Frame>
				<Frame>18,26</Frame>n
				<Frame>19,26</Frame>
				<Frame>20,26</Frame>
				<Frame>21,26</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Belt_front_fall" sprite="s_BeltFront" animTime="200" isLoop="true" playOnState="Action.FallStraight">
				<Frame>22,26</Frame>
				<Frame>23,26</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Belt_front_jump" sprite="s_BeltFront" animTime="50" isLoop="true" playOnState="Action.JumpStraight">
				<Frame>24,26</Frame>
			</SpriteAnimation>
		</Animations>
	</Data>
	<RenderRules>
		<RenderChestBackItem>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_Belt" offset="-4,-33" blend="PREMULTIPLIED_ALPHA"/>
		</RenderChestBackItem>
		<RenderChestItem>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_BeltFront" offset="-19,-14" blend="PREMULTIPLIED_ALPHA"/>
		</RenderChestItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Ketchup" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="17,2" />
    <Sprite name="s_Mustard" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="18,2" />
    <Sprite name="s_ProjectileKetchup" fileName="game/particles12.rttex" textureSize="32,32" frame="28,9" />
    <Sprite name="s_ProjectileMustard" fileName="game/particles12.rttex" textureSize="32,32" frame="29,9" />

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_ketchup" updateStage="RenderHandItem" updateState="Punch.True">
        <Emitter attachment="handspotRoot">
          <Set name="lifeTime">0.072</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">7,10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileKetchup</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.2</Set>
          <Random name="targetPosOffset" min="-15, -8" max="15, 8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
          <OnFinish>
            <ParticleSystemName>ps_ketchupSplash</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_ketchupSplash" >
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="emissionInterval">0.5</Set>
          <Random name="particlesPerEmission" min="1" max="4"/>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileKetchup</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 0.25, 0.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,75" baseAnglePosition="targetPos" baseOffset="0,16"/>
          <Set name="gravityVector">0, 45</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_mustard" updateStage="RenderBackHandItem" updateState="Punch.True">
        <Emitter attachment="handspotRoot">
          <Set name="lifeTime">0.072</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">4,10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileMustard</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.2</Set>
          <Random name="targetPosOffset" min="-15, -8" max="15, 8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
          <OnFinish>
            <ParticleSystemName>ps_mustardSplash</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_mustardSplash" >
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="emissionInterval">0.5</Set>
          <Random name="particlesPerEmission" min="1" max="4"/>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileMustard</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 0.25, 0.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,75" baseAnglePosition="targetPos" baseOffset="0,16"/>
          <Set name="gravityVector">0, 45</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
        <Set name="RenderBackArmAfterItem">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderHandItem>
      <Translate forceValue="false">1,16,0</Translate>
      <SpriteRender name="s_Ketchup" blend="NORMAL" alignment="CENTER" drawShadow="true" />
    </RenderHandItem>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <Translate forceValue="false">-4,5,0</Translate>
      <SpriteRender name="s_Mustard" blend="NORMAL" alignment="CENTER" drawShadow="true" />
    </RenderBackHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_ketchupSplash"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_ketchupSplash"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wing" fileName="game/particles_large15.rttex" textureSize="64" frame="4,12"/>
    <Sprite name="s_wingGlow" fileName="game/particles_large15.rttex" textureSize="64" frame="10,12"/>

    <Animations>
      <SpriteAnimation name="a_wingIdle" isLoop="true" sprite="s_wing" playOnState="Motion.Idle" animTime="900">
        <Frame>4,12</Frame>
        <Frame>5,12</Frame>
        <Frame>6,12</Frame>
        <Frame>7,12</Frame>
        <Frame>8,12</Frame>
        <Frame>9,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_wingJump" sprite="s_wing" playOnState="Motion.Jump" animTime="200">
        <Frame>11,12</Frame>
        <Frame>12,12</Frame>
        <Frame>13,12</Frame>
        <Frame>14,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_wingFall" sprite="s_wing" playOnState="Motion.Fall" animTime="100">
        <Frame>14,12</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_wingGlow" isLoop="true" playOnState="Motion.Idle" sprite="s_wingGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_wing" isLoop="true" autoPlay="true" sprite="s_wing" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.8f</KeyFrame>
          <KeyFrame>1.f, 0.8f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Fall">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_wing" offset="0,-16"  alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      <SpriteRender name="s_wing" offset="0,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false" />
      <SpriteRender name="s_wingGlow" offset="0,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" onState="Motion.Idle" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_wingGlow" offset="0,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" drawShadow="false" onState="Motion.Idle" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="Sprite28" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="29,2" />
        <Sprite name="Sprite35" fileName="game/particles_large16.rttex" textureSize="64,64" frame="11,9" />
        <Sprite name="s_apple1" fileName="game/particles12.rttex" textureSize="32,32" frame="15,12" />
		<Sprite name="s_apple2" fileName="game/particles12.rttex" textureSize="32,32" frame="16,12" />
		<Sprite name="s_apple3" fileName="game/particles12.rttex" textureSize="32,32" frame="17,12" />
		<Sprite name="s_splat" fileName="game/particles12.rttex" textureSize="32,32" frame="14,13" />
		<Sprite name="s_chunk1" fileName="game/particles12.rttex" textureSize="32,32" frame="15,13" />
		<Sprite name="s_chunk2" fileName="game/particles12.rttex" textureSize="32,32" frame="16,13" />
		<Sprite name="s_chunk3" fileName="game/particles12.rttex" textureSize="32,32" frame="17,13" />
        <Animations>
            <SpriteAnimation name="Animation41" sprite="Sprite35" isLoop="true" autoPlay="true" playOnState="Punch.Yes" animTime="400">
                <Frame>11,9</Frame>
                <Frame>12,9</Frame>
                <Frame>13,9</Frame>
                <Frame>14,9</Frame>
            </SpriteAnimation>
        </Animations>
        <ParticleSystems>
            <ParticleSystem name="ps_apple">
                <Emitter>
					<Random name="offset" min="16, -30" max="24, -18"/>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Random name="variantId" min="0" max="3" />
					<Select name="sprite" input="variantId">
					  <Item>"s_apple1"</Item>
					  <Item>"s_apple2"</Item>
					  <Item>"s_apple3"</Item>
					</Select>
					<Set name="lifeTime">0.4</Set>
					<Random name="targetPosOffset" min="-12,-12" max="12,12"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" />
					<OnFinish>
						<ParticleSystemName>ps_splat</ParticleSystemName>
						<ParticleSystemName>ps_apple_chunk</ParticleSystemName>
					</OnFinish>
				</Particle>
            </ParticleSystem>
			<ParticleSystem name="ps_splat">
                <Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_splat</Set>
					<Set name="lifeTime">1</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Random name="gravityVector" min="0, 15" max="0, 25"/>
					<Curve name="initialScale">
						<KeyFrame>0, 0.25, 0.25</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
				</Particle>
            </ParticleSystem>
			<ParticleSystem name="ps_apple_chunk">
				<Emitter>
					<Set name="lifeTime">0.4</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">0,0</Set>
					<Set name="particlesToEmit">5</Set>
					<Set name="checkParticleNumToEmit">true</Set>
				</Emitter>
				<Particle UseParentVariantId="true">
					<Select name="sprite" input="variantId">
						<Item>"s_chunk1"</Item>
						<Item>"s_chunk2"</Item>
						<Item>"s_chunk3"</Item>
					</Select>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50"/>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="0" max="360"/>
				</Particle>
			</ParticleSystem>
        </ParticleSystems>
        <VariableMap />
        <StateMachines>
            <StateMachine name="Punch">
                <States>
                    <State name="No" />
                    <State name="Yes" />
                </States>
                <Transitions>
                    <Transition to="No" from="Yes">
                        <Condition>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Yes" from="No">
                        <Condition>
                            <IsAction>PUNCH</IsAction>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>
        <RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">CHESTITEM</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
			</Default>
		</RenderOptions>
    </Data>
    <RenderRules>
        <RenderChestItem>
            <SpriteRender name="Sprite28" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
        </RenderChestItem>
        <RenderChestBackItem>
            <SpriteRender name="Sprite35" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
        </RenderChestBackItem>
        <OnPunchStart>
            <ParticleSystemUpdate name="ps_apple" />
        </OnPunchStart>
        <OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
            <AvatarTransform class="ArmAngle">
                <Set name="armName">arm1Angle</Set>
                <Set name="armAngle">-130</Set>
            </AvatarTransform>
        </OnPunchUpdate>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_KetchupBottle" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="9,21" />
		<Sprite name="s_Pet" fileName="game/pets/p_dackula.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_Punch" fileName="game/particles_large11.rttex" textureSize="64" frame="15,2" />
		<Animations>
			<SpriteAnimation name="a_Attack" sprite="s_Pet" animTime="400" isLoop="true" playOnState="Motion.Punch">
				<Frame>0,1</Frame>
				<Frame>0,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Fall" sprite="s_Pet" animTime="100" isLoop="true" playOnState="Motion.Down">
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Idle" sprite="s_Pet" animTime="300" isLoop="true" playOnState="Motion.None">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Jump" sprite="s_Pet" animTime="100" isLoop="true" playOnState="Motion.Up">
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Move" sprite="s_Pet" animTime="300" isLoop="true" playOnState="Motion.Horizontal">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="PunchParticle">
				<Emitter>
					<Set name="offset">10, -16</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">false</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.35, 0.35</KeyFrame>
						<KeyFrame>1, 0.5, 0.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.35</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="UsePetForceFaceTime">false</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="IgnorePunchTypeCheck">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="ArmAngle" onState="Motion.Punch">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</Update>
		<RenderHandItem>
			<SpriteRender name="s_KetchupBottle" rotationPoint="0,1" alignment="UPPER_CENTER" />
		</RenderHandItem>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderPet>
			<SpriteRender name="s_Pet" offset="-16,0" alignment="DOWN_CENTER" />
		</RenderPet>
		<UpdatePet>
			<ContextUpdate type="SetPetWalkRunJump">
				<Set name="PetWalkRunJump.minSpeed">500</Set>
				<Set name="PetWalkRunJump.distSpeedMult">10</Set>
			</ContextUpdate>
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
			<ParticleSystemUpdate name="PunchParticle" onState="Motion.Punch"/>
		</UpdatePet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Cape" fileName="game/particles_large15.rttex" textureSize="64" frame="0,11" />
		<Sprite name="s_Collar" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="21,28" />
		<Sprite name="s_spark" fileName="game/particles12.rttex" textureSize="32" frame="17,0"/>

		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="Idle" />
					<State name="Walk" />
					<State name="JumpStraight" />
					<State name="FallStraight" />
				</States>
				<Transitions>
					<Transition to="Idle" from="FallStraight|Walk">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>						
					<Transition to="Walk" from="FallStraight|Idle|JumpStraight">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>					
					<Transition to="JumpStraight" from="Idle|FallStraight|Walk">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>			
					<Transition to="FallStraight" from="JumpStraight|Idle|Walk">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>				
				</Transitions>
			</StateMachine>
			<StateMachine name="Trail">
				<States>
					<State name="Idle" />
					<State name="Move" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Move">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="s_Wing_idle" sprite="s_Cape" animTime="50" isLoop="true" playOnState="Action.Idle">
				<Frame>0,11</Frame>
			</SpriteAnimation>		
			<SpriteAnimation name="s_Wing_jump" sprite="s_Cape" animTime="200" isLoop="true" playOnState="Action.JumpStraight">
				<Frame>0,12</Frame>
				<Frame>1,12</Frame>
			</SpriteAnimation>				
			<SpriteAnimation name="s_Wing_fall" sprite="s_Cape" animTime="200" isLoop="true" playOnState="Action.FallStraight">
				<Frame>2,12</Frame>
				<Frame>3,12</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="s_spark_frames" sprite="s_spark">
				<Frame>18,0</Frame>
				<Frame>18,0</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="s_Wing_walk" sprite="s_Cape" animTime="700" isLoop="true" playOnState="Action.Walk">
				<Frame>1,11</Frame>
				<Frame>2,11</Frame>				
				<Frame>3,11</Frame>
				<Frame>4,11</Frame>
				<Frame>5,11</Frame>
				<Frame>6,11</Frame>
				<Frame>7,11</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_luteTrailMove">
				<Emitter>
					<Set name="offset">0, -12</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">5</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="sprite">s_spark</Set>
					<Random name="offset" min="-11, -10" max="11, 10" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="initialScale">0.25, 0.25</Set>
					<Set name="finalScale">0.75, 0.75</Set>
					<Random name="initialVelocity" min="-20, 0" max="-30, 0" />
					<Set name="interpolateScale">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="gravityVector" min="0, 20" max="0, 30" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 30</Set>
					<Set name="lifeTime">0.75</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="initialAngle" min="-90" max="90" />
					<Random name="finalAngle" min="-90" max="90" />
					<Set name="interpolateAngle">true</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<AddClothingParticles>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemUpdate name="ps_luteTrailMove" onState="Trail.Move"/>
		</AddClothingParticles>
		<RenderBackpack>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_Cape" offset="-1,-16"/>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_luteTrailMove"/>
		</RenderBackpack>
		<RenderFrontpack>
			<SpriteRender name="s_Collar" offset="0.5,0.5" alignment="DOWN_CENTER"/>
		</RenderFrontpack>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_brain" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="18,18"/>
    <Sprite name="s_punchStart" fileName="game/particles11.rttex" textureSize="32" frame="0,23"/>
    <Sprite name="s_punchContinue" fileName="game/particles11.rttex" textureSize="32" frame="5,23"/>
    <Sprite name="s_punchEnd" fileName="game/particles11.rttex" textureSize="32" frame="4,23"/>
    <Sprite name="s_projectile" fileName="game/particles11.rttex" textureSize="32" frame="10,23"/>

    <Animations>
      <SpriteAnimation name="a_brainNonPunch" sprite="s_brain" animTime="2600" isLoop="true" playOnState="Punch.False">
        <Frame>18,18</Frame>
        <Frame>19,18</Frame>
        <Frame>20,18</Frame>
        <Frame>21,18</Frame>
        <Frame>22,18</Frame>
        <Frame>23,18</Frame>
        <Frame>24,18</Frame>
        <Frame>25,18</Frame>
        <Frame>26,18</Frame>
        <Frame>27,18</Frame>
        <Frame>28,18</Frame>
        <Frame>29,18</Frame>
        <Frame>30,18</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_brainPunch" sprite="s_brain" animTime="1300" isLoop="true" playOnState="Punch.True">
        <Frame>18,19</Frame>
        <Frame>19,19</Frame>
        <Frame>20,19</Frame>
        <Frame>21,19</Frame>
        <Frame>22,19</Frame>
        <Frame>23,19</Frame>
        <Frame>24,19</Frame>
        <Frame>25,19</Frame>
        <Frame>26,19</Frame>
        <Frame>27,19</Frame>
        <Frame>28,19</Frame>
        <Frame>29,19</Frame>
        <Frame>30,19</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchContinue" sprite="s_punchContinue" animTime="500" isLoop="true" playOnState="PunchAnim.Continue">
        <Frame>5,23</Frame>
        <Frame>6,23</Frame>
        <Frame>7,23</Frame>
        <Frame>8,23</Frame>
        <Frame>9,23</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchEnd" sprite="s_punchEnd" animTime="500" playOnState="PunchAnim.End">
        <Frame>0,23</Frame>
        <Frame>4,23</Frame>
        <Frame>3,23</Frame>
        <Frame>2,23</Frame>
        <Frame>1,23</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchStart" sprite="s_punchStart" animTime="500" playOnState="PunchAnim.Start">
        <Frame>4,23</Frame>
        <Frame>0,23</Frame>
        <Frame>1,23</Frame>
        <Frame>2,23</Frame>
        <Frame>3,23</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_projectile" sprite="s_projectile">
        <Frame>10,23</Frame>
        <Frame>11,23</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="PunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start"/>
          <State name="Continue"/>
          <State name="End"/>
        </States>
        <Transitions>
          <Transition from="Off|End" to="Start">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsAnimationFinished>a_punchStart</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="Continue|Start" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAnimationFinished>a_punchEnd</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>


    <ParticleSystems>
      <ParticleSystem name="punch_start_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-64</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchStart</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">1.5,1.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_continue_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-64</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="delayTimer">0.24</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchContinue</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="initialScale">1.5,1.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_end_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,-64</Set>
          <Set name="lifeTime">0</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchEnd</Set>
          <Set name="offset">0, 0</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">1.5,1.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchProjectile" updateStage="OnDamagedTile" updateState="Punch.True">
        <Emitter>
          <Random name="emissionInterval" min="0.1" max="0.2" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="useTargetTileColorForTint">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="initialVelocity">0,-220</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-10, -8" max="10, 8" />
          <Random name="initialRotationRate" min="50" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <Update>
      <ParticleSystemUpdate name="punch_continue_particle" />
    </Update>
    <OnPunchBegin>
      <ParticleSystemOff name="punch_continue_particle" />
      <ParticleSystemOff name="punch_end_particle" />
      <ParticleSystemUpdate name="punch_start_particle" />
    </OnPunchBegin>
    <OnPunchStop>
      <ParticleSystemOff name="punch_continue_particle" />
      <ParticleSystemOff name="punch_start_particle" />
      <ParticleSystemUpdate name="punch_end_particle" />
    </OnPunchStop>
    <RenderHair>
      <SpriteRender name="s_brain" alignment="DOWN_CENTER" offset="0,-16"/>
    </RenderHair>
    <RenderInFront>
      <ParticleSystemRender name="punch_start_particle" onState="PunchAnim.Start" />
      <ParticleSystemRender name="punch_continue_particle" onState="PunchAnim.Continue" />
      <ParticleSystemRender name="punch_end_particle" onState="PunchAnim.End" />
    </RenderInFront>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_hit" fileName="game/particles_large5.rttex" textureSize="64" frame="10,12" />
		<Sprite name="s_mist" fileName="game/particles12.rttex" textureSize="32" frame="14,0" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="13,0" />
		<Sprite name="s_staff" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="0,7" />
		<Animations>
			<CurveAnimationVec4 name="a_staff" playOnState="Action.Punch" sprite="s_staff" animTime="150" isLoop="true">
				<Curve name="staff_rotation2">
					<KeyFrame>0, 0, 0,0,1</KeyFrame>
					<KeyFrame>0.32, 0, 0,0,1</KeyFrame>
					<KeyFrame>0.33, 15, 0,0,1</KeyFrame>
					<KeyFrame>0.65, 15, 0,0,1</KeyFrame>
					<KeyFrame>0.66, -15, 0,0,1</KeyFrame>
					<KeyFrame>1, -15, 0,0,1</KeyFrame>
				</Curve>
			</CurveAnimationVec4>
			<SpriteSinPulseAnimation name="a_punch" sprite="s_punch" autoPlay="true" isLoop="true">
				<Parameter name="alpha">
					<Set name="period">300</Set>
					<Set name="scale">0.5</Set>
					<Set name="offset">0.5</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteAnimation name="a_hit" sprite="s_hit" animTime="400">
				<Frame>10,12</Frame>
				<Frame>11,12</Frame>
				<Frame>12,12</Frame>
				<Frame>13,12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_mist" sprite="s_mist" animTime="600" autoPlay="true" isLoop="true">
				<Frame>14,0</Frame>
				<Frame>15,0</Frame>
				<Frame>16,0</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="AlternatePunch">
				<States>
					<State name="Off" />
					<State name="On" />
				</States>
				<Transitions>
					<Transition from="Off" to="On">
						<Condition type="or">
							<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
							<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
						</Condition>
					</Transition>
					<Transition from="On" to="Off">
						<Condition type="and">
							<IsSitting ItemID="ITEM_ID_THEATER_SEAT">false</IsSitting>
							<IsWearing slot="SHIRT" operatorType="NotEqual">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="p_hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_pumch2" updateStage="OnPunchStart" updateState="AlternatePunch.On">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 1</KeyFrame>
						<KeyFrame>1, 2.5, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.25</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.2" angle="0" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_punch">
				<Emitter attachment="contextRotation">
					<Set name="offset">0, 4</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.7</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 1</KeyFrame>
						<KeyFrame>1, 2.5, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.25</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="staff_rotation">0, 0, 0, 1</Set>
			<Set name="staff_rotation2">0, 0, 0, 1</Set>
			<Set name="target.direction">0, 0, 0, 1</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<Update>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>BUILD</IsAction>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Action.None">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-90</Set>
			</AvatarTransform>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="animTime">300</Set>
				<Set name="Curve">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, 0</KeyFrame>
					<KeyFrame>0.51, -90</KeyFrame>
					<KeyFrame>1, -90</KeyFrame>
				</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsAction>BUILD</IsAction>
			</StopIf>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<ParticleSystemRender name="p_mist" onState="Action.None" />
			<Group onState="Action.Punch">
				<Rotate forceValue="true">target.direction</Rotate>
				<Rotate>staff_rotation2</Rotate>
				<SpriteRender name="s_staff" offset="0,4" flip="1,0" alignment="CENTER" onState="Facing.Left" />
				<SpriteRender name="s_staff" offset="0,4" alignment="CENTER" onState="Facing.Right" />
				<ParticleSystemUpdate name="p_punch" />
				<ParticleSystemRender name="p_punch" />
			</Group>
			<Group onState="Action.None">
				<Group>
					<Rotate>90, 0,0,1</Rotate>
					<SpriteRender name="s_mist" offset="3,-20" scale="1,1.2" rotationPoint="0,1" alignment="CENTER" drawShadow="false" blend="ADDITIVE"/>
				</Group>
				<SpriteRender name="s_staff" offset="-3,4" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" />
			</Group>
		</RenderBackHandItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Left" fileName="game/player_feet16.rttex" textureSize="32" frame="19,26" />
    <Sprite name="s_Right" fileName="game/player_feet16.rttex" textureSize="32" frame="19,27" />
    <Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="0,16" />
    <Sprite name="s_jumpCloudsHorizontal" fileName="game/particles12.rttex" textureSize="32" frame="1,16" />
    <Sprite name="s_jumpCloudsVertical" fileName="game/particles12.rttex" textureSize="32" frame="2,16" />
    
    <Animations>
      <SpriteAnimation name="a_LeftIdle" sprite="s_Left" animTime="1200" playOnState="Motion.Idle" isLoop="true">
        <Frame>19,26</Frame>
        <Frame>20,26</Frame>
        <Frame>21,26</Frame>
        <Frame>22,26</Frame>
        <Frame>23,26</Frame>
        <Frame>24,26</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_RightIdle" sprite="s_Right" animTime="1200" playOnState="Motion.Idle" isLoop="true">
        <Frame>19,27</Frame>
        <Frame>20,27</Frame>
        <Frame>21,27</Frame>
        <Frame>22,27</Frame>
        <Frame>23,27</Frame>
        <Frame>24,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_LeftMove" sprite="s_Left" animTime="600" playOnState="Motion.Moving" isLoop="true">
        <Frame>25,26</Frame>
        <Frame>26,26</Frame>
        <Frame>27,26</Frame>
        <Frame>28,26</Frame>
        <Frame>29,26</Frame>
        <Frame>30,26</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_RightMove" sprite="s_Right" animTime="600" playOnState="Motion.Moving" isLoop="true">
        <Frame>25,27</Frame>
        <Frame>26,27</Frame>
        <Frame>27,27</Frame>
        <Frame>28,27</Frame>
        <Frame>29,27</Frame>
        <Frame>30,27</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="ClothingOffsetFromShoes">-14</Set>
        <Set name="UserNameOffset">12</Set>
        <Set name="RenderShoesWithMermaidTail">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="IsRidingBird">true</Set>
      </Default>
    </RenderOptions>
    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">-16, 0</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle angleRelativeToPlayerSpeed="true">
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75,0.5</KeyFrame>
            <KeyFrame>1, 0.75,0.1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_jumpClouds">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,0</Set>
        </Emitter>
        <Particle>
          <Select name="sprite" input="particleIndex">
            <Item>"s_jumpCloudsHorizontal"</Item>
            <Item>"s_jumpCloudsHorizontal"</Item>
            <Item>"s_jumpCloudsVertical"</Item>
          </Select>
          <Select name="flipX" input="particleIndex">
            <Item>false</Item>
            <Item>true</Item>
            <Item>false</Item>
          </Select>
          <Select name="initialVelocity" input="particleIndex">
            <Item>-40, 0</Item>
            <Item>40, 0</Item>
            <Item>0, 40</Item>
          </Select>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <RenderShoes>
      <Group>
        <StopIf>
          <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
        </StopIf>
        <ParticleSystemRender name="ps_trail"/>
      </Group>
      
      <SpriteRender name="s_Left" offset="0,10" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
      <SpriteRender name="s_Right" offset="0,10" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />

      <Group>
        <StopIf>
          <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
        </StopIf>
        <ParticleSystemUpdate name="ps_trail" onState="Motion.Moving"/>
        <ParticleSystemUpdate name="ps_jumpClouds" onAction="JUMPSTART|JUMPDOUBLE"/>
      </Group>
    </RenderShoes>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_NecklaceDim" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="30,16" />
		<Sprite name="s_NecklaceGlow" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="31,16" />
		<Sprite name="s_Sparkle" fileName="game/particles10.rttex" textureSize="32" frame="0,28" />
		<Sprite name="s_skinHead" fileName="game/player_head_skin8.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_skinSit" fileName="game/player_sit_skins.rttex" textureSize="32" frame="3,1" />
		<Sprite name="s_skinSleep" fileName="game/player_head_sleep.rttex" textureSize="32" frame="3,1" />
		<Animations>
			<SpriteCurveAnimation name="a_NecklaceGlow" sprite="s_NecklaceGlow" isLoop="true" autoPlay="true" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.2, 0</KeyFrame>
					<KeyFrame>0.4, 1</KeyFrame>
					<KeyFrame>0.8, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_Sparkle" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Sparkle</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-8, -22" max="8, -9" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>0.3, 0.5, 0.5</KeyFrame>
						<KeyFrame>0.5, 1.5, 1.5</KeyFrame>
						<KeyFrame>1, 1.5, 1.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Select name="initialRotationRate" input="randomNumber">
						<Item>180</Item>
						<Item>-180</Item>
					</Select>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="Head.Sprite">s_skinHead</Set>
				<Set name="Head.Sprite.Sit">s_skinSit</Set>
				<Set name="Head.Sprite.Sleep">s_skinSleep</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="s_NecklaceDim" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
			<SpriteRender name="s_NecklaceGlow" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
		</RenderChestItem>
	</RenderRules>
</ItemRenderer>
