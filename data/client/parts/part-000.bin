          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="UCJUESTUDIO_20">
        <Emitter>
          <Random name="offset" min="-27, -24" max="32, -8"/>
          <Set name="particlesPerEmission">15</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">false</Set>
          <Set name="particlesToEmit">15</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">UCJUESTUDIO_6</Set> 
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="relativeToEmitter">false</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 80</Set>
          <RandomRadial name="initialVelocity" angleRange="180,360" radiusRange="100,220"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1.0, 1.0</KeyFrame> 
            <KeyFrame>1, 0.2, 0.2</KeyFrame>
          </Curve>
          <Random name="lifeTime" min="0.4" max="0.7"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="UCJUESTUDIO_21" updateStage="OnKilled" renderStage="RenderBehind">
        <Emitter>
          <Set name="lifeTime">1.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-24</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">UCJUESTUDIO_7</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">1.5, 1.5</Set>
          <Set name="lifeTime">1.2</Set>
        </Particle>
      </ParticleSystem>

    </ParticleSystems>
    
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="HideAvatarOnDeath">true</Set>
        <Set name="HideAngelOnDeath">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="UCJUESTUDIO_0" offset="0,-50" scale="0.85,0.85" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="UCJUESTUDIO_0" offset="-0,-50" scale="0.85,0.85" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
    </RenderBackpack>
    
    <RenderInFront>
      <ParticleSystemRender name="UCJUESTUDIO_17"/>
      
      <ParticleSystemRender name="UCJUESTUDIO_18"/>
      <ParticleSystemRender name="UCJUESTUDIO_19"/>
      <ParticleSystemRender name="UCJUESTUDIO_20"/>
    </RenderInFront>

    <AddClothingParticles>
      <ParticleSystemUpdate name="UCJUESTUDIO_17" onAction="WALK" drawShadow="false"/>
      
      <ParticleSystemUpdate name="UCJUESTUDIO_18" onState="UCJUESTUDIO_8.LandedTrigger" drawShadow="false"/>
      <ParticleSystemUpdate name="UCJUESTUDIO_19" onState="UCJUESTUDIO_8.LandedTrigger" drawShadow="false"/>
      <ParticleSystemUpdate name="UCJUESTUDIO_20" onState="UCJUESTUDIO_8.LandedTrigger" drawShadow="false"/>
      
      <ParticleSystemUpdate name="UCJUESTUDIO_15" onAction="JUMPDOUBLE" drawShadow="false" align="LEFT_CENTER" />
      <ParticleSystemUpdate name="UCJUESTUDIO_16" onAction="JUMPDOUBLE" drawShadow="false" align="RIGHT_CENTER" />
    </AddClothingParticles>

    <SwitchOffClothingParticles>
      <ParticleSystemOff name="UCJUESTUDIO_17" />
      <ParticleSystemOff name="UCJUESTUDIO_15" />
      <ParticleSystemOff name="UCJUESTUDIO_16" />
    </SwitchOffClothingParticles>
  
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
