				<Emitter>
					<Random name="emissionInterval" min="0.2" max="0.4" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">13.5, 3</Set>
				</Emitter>
				<Particle usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="relativeToEmitter">false</Set>
					<Set name="sprite">SmokeSprite</Set>
					<Random name="offset" min="-2, 0" max="0, 0" />
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.4, 0.8</KeyFrame>
						<KeyFrame>0.6, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 0.5, 1.5</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="40" max="60" />
					<Set name="lifeTime">2</Set>
					<RandomRadial name="initialVelocity" angleRange="-40,-80" radiusRange="1.25,1.5"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">-15</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">15</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemUpdate name="SmokeTrailLeft" onState="Motion.Idle"/>
			<ParticleSystemUpdate name="SmokeTrailRight" onState="Motion.Idle"/>
			<ParticleSystemUpdate name="SmokeTrailLeftUp" onState="Motion.Idle"/>
			<ParticleSystemUpdate name="SmokeTrailRightUp" onState="Motion.Idle"/>			
			
			<ParticleSystemUpdate name="SmokeTrailLeftTrail" onState="Motion.Moving"/>
			<ParticleSystemUpdate name="SmokeTrailRightTrail" onState="Motion.Moving"/>
			<ParticleSystemUpdate name="SmokeTrailLeftUpTrail" onState="Motion.Moving"/>
			<ParticleSystemUpdate name="SmokeTrailRightUpTrail" onState="Motion.Moving"/>
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="foot1_Sprite" offset="0,-14" drawShadow="true"/>
			<SpriteRender name="glowingFace_Sprite" offset="7,3.2" drawShadow="false"/>
		</RenderShoes>
	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="Sprite10" fileName="game/particles_large16.rttex" textureSize="64,64" frame="6,8" />
        <Animations />
        <ParticleSystems />
        <StateMachines>
            <StateMachine name="Movement">
                <States>
                    <State name="Idle" />
                    <State name="Move" />
                    <State name="Jump" />
                    <State name="Fall" />
                </States>
                <Transitions>
                    <Transition to="Idle" from="Fall|Move">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Move" from="Jump|Fall|Idle">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Jump" from="Idle|Move|Fall">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Fall" from="Jump|Idle|Move">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>
        <RenderOptions />
        <VariableMap>
            <Set name="line.start">0,0,0</Set>
            <Set name="line.1">0,0,0</Set>
            <Set name="line.2">0,0,0</Set>
            <Set name="line.3">0,0,0</Set>
            <Set name="line.4">0,0,0</Set>
            <Set name="context.pos.3f">0,0,0</Set>
            <Set name="rightFootYPos">0,0,0</Set>
            <Set name="leftFootYPos">0,0,0</Set>
            <Set name="facingVariable">0,0,0</Set>
            <Set name="localScale">1, 1, 1</Set>
            <Set name="arm.front.position">0,0,0</Set>
            <Set name="arm.back.position">0,0,0</Set>
            <Set name="move.hand.rotate">10,0,0,1</Set>
            <Set name="sittingOffset">0,0,0</Set>
            <Set name="playerPositionVariable">0,0,0</Set>
        </VariableMap>
        <Animations>
            <CurveAnimationVec4 name="anim_hand_rotate" autoPlay="true" isLoop="true" animTime="300">
                <Curve name="move.hand.rotate">
                    <KeyFrame>0.0, 8, 0, 0, 1</KeyFrame>
                    <KeyFrame>0.5, 12, 0, 0, 1</KeyFrame>
                    <KeyFrame>1.0, 8, 0, 0, 1</KeyFrame>
                </Curve>
            </CurveAnimationVec4>
        </Animations>
    </Data>
    <RenderRules>
        <RenderBackpack>
            <StopIf type="or">
                <IsSleepingOnaBed>true</IsSleepingOnaBed>
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
                <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
                <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
				<IsRenderMod>RENDER_MOD_RENDER_TARGET</IsRenderMod>
            </StopIf>
            <Group onState="Movement.Idle">
                <ArithmethicOperation LeftHandVariableName="line.1" RightHandVariableName="-19,-62,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.2" RightHandVariableName="-19,-56,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.3" RightHandVariableName="18,-62,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.4" RightHandVariableName="19,-56,0" OperationType="Set" />
            </Group>
            <Group onState="Movement.Move">
                <ArithmethicOperation LeftHandVariableName="line.1" RightHandVariableName="-20,-66,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.2" RightHandVariableName="-20,-59,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.3" RightHandVariableName="16,-59,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.4" RightHandVariableName="16,-53,0" OperationType="Set" />
            </Group>
            <Group onState="Movement.Jump">
                <ArithmethicOperation LeftHandVariableName="line.1" RightHandVariableName="-16,-59,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.2" RightHandVariableName="-14,-52,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.3" RightHandVariableName="20,-68,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.4" RightHandVariableName="22,-62,0" OperationType="Set" />
            </Group>
            <Group onState="Movement.Fall">
                <ArithmethicOperation LeftHandVariableName="line.1" RightHandVariableName="-19,-62,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.2" RightHandVariableName="-19,-56,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.3" RightHandVariableName="18,-62,0" OperationType="Set" />
                <ArithmethicOperation LeftHandVariableName="line.4" RightHandVariableName="19,-56,0" OperationType="Set" />
            </Group>
            <ArithmethicOperation LeftHandVariableName="line.1" RightHandVariableName="facingVariable" OperationType="Multiply" />
            <ArithmethicOperation LeftHandVariableName="line.2" RightHandVariableName="facingVariable" OperationType="Multiply" />
            <ArithmethicOperation LeftHandVariableName="line.3" RightHandVariableName="facingVariable" OperationType="Multiply" />
            <ArithmethicOperation LeftHandVariableName="line.4" RightHandVariableName="facingVariable" OperationType="Multiply" />
            <ArithmethicOperation LeftHandVariableName="line.1" RightHandVariableName="localScale" OperationType="Multiply" />
            <ArithmethicOperation LeftHandVariableName="line.2" RightHandVariableName="localScale" OperationType="Multiply" />
            <ArithmethicOperation LeftHandVariableName="line.3" RightHandVariableName="localScale" OperationType="Multiply" />
            <ArithmethicOperation LeftHandVariableName="line.4" RightHandVariableName="localScale" OperationType="Multiply" />
            <ArithmethicOperation LeftHandVariableName="line.1" RightHandVariableName="context.pos.3f" OperationType="Add" />
            <ArithmethicOperation LeftHandVariableName="line.2" RightHandVariableName="context.pos.3f" OperationType="Add" />
            <ArithmethicOperation LeftHandVariableName="line.3" RightHandVariableName="context.pos.3f" OperationType="Add" />
            <ArithmethicOperation LeftHandVariableName="line.4" RightHandVariableName="context.pos.3f" OperationType="Add" />
            <Translate forceValue="false">0,-72,0</Translate>
            <Group onState="Movement.Idle">
                <SpriteRender name="Sprite10" blend="NORMAL" alignment="UPPER_CENTER" drawShadow="true" />
            </Group>
            <Group onState="Movement.Move">
                <Rotate>move.hand.rotate</Rotate>
                <SpriteRender name="Sprite10" blend="NORMAL" alignment="UPPER_CENTER" drawShadow="true" />
            </Group>
            <Group onState="Movement.Jump">
                <Rotate forceValue="false">-15,0,0,1</Rotate>
                <SpriteRender name="Sprite10" blend="NORMAL" alignment="UPPER_CENTER" drawShadow="true" />
            </Group>
            <Group onState="Movement.Fall">
                <SpriteRender name="Sprite10" blend="NORMAL" alignment="UPPER_CENTER" drawShadow="true" />
            </Group>
            <LineRender color="30,30,30,255" StartPointVariableName="line.3" StartIsWorldPos="true" EndPointVariableName="arm.back.position" EndIsWorldPos="true" />
        </RenderBackpack>
        <RenderInFront>
            <StopIf type="or">
                <IsSleepingOnaBed>true</IsSleepingOnaBed>
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
                <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
                <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
				<IsRenderMod>RENDER_MOD_RENDER_TARGET</IsRenderMod>
            </StopIf>
            <LineRender color="30,30,30,255" StartPointVariableName="line.2" StartIsWorldPos="true" EndPointVariableName="arm.front.position" EndIsWorldPos="true" />
            <Group>
                <Translate>rightFootYPos</Translate>
                <Translate>9,-2,0</Translate>
                <LineRender color="30,30,30,255" StartPointVariableName="line.4" StartIsWorldPos="true" EndPointVariableName="line.start" EndIsWorldPos="false" />
            </Group>
            <Group>
                <Translate>leftFootYPos</Translate>
                <Translate>-3,-2,0</Translate>
                <LineRender color="30,30,30,255" StartPointVariableName="line.1" StartIsWorldPos="true" EndPointVariableName="line.start" EndIsWorldPos="false" />
            </Group>
        </RenderInFront>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_QAYS_AND_LAYLA">
	<Data>
		<Sprite name="front_sword" fileName="game/player_longhanditem3.rttex" textureSize="64,32" frame="6,15"/>
		<Sprite name="back_sword" fileName="game/player_longhanditem3.rttex" textureSize="64,32" frame="7,15"/>
		<Sprite name="sword_slash_Sprite" fileName="game/particles_large12.rttex" textureSize="64" frame="12,3"/>
		<Sprite name="spark_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="25,4"/>
		<Sprite name="hit_black_Sprite" fileName="game/particles_large12.rttex" textureSize="64" frame="12,4"/>
		<Sprite name="hit_red_Sprite" fileName="game/particles_large12.rttex" textureSize="64" frame="13,4"/>
		<Animations>
			<SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="spark_Sprite">
				<Frame>25,4</Frame>
				<Frame>26,4</Frame>
				<Frame>27,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="sword_slash_frames" autoPlay="false" sprite="sword_slash_Sprite">
				<Frame>12,3</Frame>
				<Frame>13,3</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="hit_black_particle_stamp">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Random name="initialAngle" min="-360" max="360"/>
					<Set name="sprite">hit_black_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4,0.4</KeyFrame>
						<KeyFrame>1, 1.3,1.3</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_red_particle_stamp">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Random name="initialAngle" min="-360" max="360"/>
					<Set name="sprite">hit_red_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4,0.4</KeyFrame>
						<KeyFrame>1, 1.3,1.3</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="slash_particle">
				<Emitter>
					<Set name="offset">9,-18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Set name="sprite">sword_slash_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">10</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">spark_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1280</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="IDLE">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-60</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="IDLE">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">60</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>

		</AddClothingParticles>
		<RenderBackHandItem>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="back_sword" offset="-3, 4" rotationPoint="0,1" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onAction="JUMP|JUMPSTART|FALL|IDLE|WALK|SWIM"/>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="back_sword" offset="-3, 4" rotationPoint="0,1" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onAction="JUMP|JUMPSTART|FALL|IDLE|WALK|PUNCH|SWIM"/>
		</RenderBackHandItem>
		<RenderHandItem>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="front_sword" offset="-0.1,8.3" rotateOffset="true" flip="1,0" blend="PREMULTIPLIED_ALPHA" onAction="IDLE|WALK|DANCE|SWIM"/>
			<SpriteRender name="front_sword" offset="-0.1,8.3" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onAction="JUMP|JUMPSTART|FALL|PUNCH"/>
		</RenderHandItem>
		<OnPunchStart>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<ParticleSystemUpdate name="slash_particle"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="animTime">1000</Set>
				<Set name="Curve">
					<KeyFrame>0.0, 0</KeyFrame>
					<KeyFrame>0.3, 0</KeyFrame>
					<KeyFrame>0.60, 350</KeyFrame>
					<KeyFrame>0.99, 720</KeyFrame>
				</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm1Angle</Set>
				<Set name="animTime">1000</Set>
				<Set name="Curve">
					<KeyFrame>0.0, 60</KeyFrame>
					<KeyFrame>0.3, 350</KeyFrame>
					<KeyFrame>0.60, 350</KeyFrame>
					<KeyFrame>0.99, 720</KeyFrame>
				</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_black_particle_stamp"/>
			<ParticleSystemUpdate name="hit_red_particle_stamp"/>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDamagedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="hit_black_particle_stamp"/>
			<ParticleSystemOff name="hit_red_particle_stamp"/>
			<ParticleSystemOff name="slash_particle"/>
			<ParticleSystemOff name="hit_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_RAIJINS_TAIKO">
	<Data>
		<Sprite name="item_Sprite" fileName="game/particles_large12.rttex" textureSize="64"/>
		<Sprite name="arrow_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="13,15"/>
		<Sprite name="HitFx_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="HitSpark_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="Break_Sprite" fileName="game/particles_large12.rttex" textureSize="64" frame="9,11"/>
		
		<Animations>
			<SpriteAnimation name="Idle_Anim" playOnAction="IDLE|WALK|JUMP|FALL" sprite="item_Sprite">
				<Frame>0, 11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="Punch_Anim" playOnAction="PUNCH" sprite="item_Sprite" animTime="800" isLoop="true">
				<Frame>1, 11</Frame>
				<Frame>2, 11</Frame>
				<Frame>3, 11</Frame>
				<Frame>4, 11</Frame>
				<Frame>5, 11</Frame>
				<Frame>6, 11</Frame>
				<Frame>7, 11</Frame>
				<Frame>8, 11</Frame>
			</SpriteAnimation>
			<SpriteSinPulseAnimation name="Float_Anim" playOnAction="IDLE|WALK|JUMP|FALL" sprite="item_Sprite">
				<Parameter name="pos.y">
					<Set name="period">2000</Set>
					<Set name="scale">2</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="ResetFloat_Anim" playOnAction="PUNCH" sprite="item_Sprite">
				<Parameter name="pos.y">
					<Set name="period">2000</Set>
					<Set name="scale">0</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteAnimation name="HitFx_Anim" autoPlay="false" sprite="HitFx_Sprite" animTime="400">
				<Frame>9, 16</Frame>
				<Frame>10, 16</Frame>
				<Frame>11, 16</Frame>
				<Frame>12, 16</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="HitSpark_Anim" autoPlay="false" sprite="HitSpark_Sprite">
				<Frame>13, 16</Frame>
				<Frame>14, 16</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="arrow_particle">
				<Emitter>
					<Set name="offset">0,-24</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Select name="offset" input="punchCount">
						<Item>24,0</Item>
						<Item>0,-24</Item>
						<Item>-24,0</Item>
						<Item>12,-18</Item>
						<Item>-12,16</Item>
						<Item>12,16</Item>
						<Item>-12,-18</Item>
					</Select>
					<Set name="sprite">arrow_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">0.1</Set>
					<Set name="finalAlpha">1</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">HitFx_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hitSpark_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">6</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">HitSpark_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.75</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,60"/>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.25, 0.25</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="posOffset" min="-2,-2" max="2,2"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="break_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">Break_Sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="-180" max="180"/>
					<Curve name="initialScale">
						<KeyFrame>0, 0.6, 0.6</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.65, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
			</Default>
		</RenderOptions>

    <TileStampData>
      <Set name="FileName">game/particles11.rttex</Set>
      <Set name="EndFrame">12,15</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>
	</Data>

	<RenderRules>
		<RenderBackpack>
			<SpriteRender name="item_Sprite" offset="0,-32" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackpack>
		<OnPunchStart>
			<ParticleSystemUpdate name="arrow_particle"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">120</Set>
				<Set name="pulseArmScale">5</Set>
				<Set name="pulseArmRate">250</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-120</Set>
				<Set name="pulseArmScale">5</Set>
				<Set name="pulseArmRate">250</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_particle"/>
			<ParticleSystemUpdate name="hitSpark_particle"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="break_particle"/>
		</OnDestroyedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="arrow_particle"/>
			<ParticleSystemOff name="hit_particle"/>
			<ParticleSystemOff name="hitSpark_particle"/>
			<ParticleSystemOff name="break_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="s_car1" fileName="game/player_feet16.rttex" textureSize="32,32" frame="0,26" />
        <Sprite name="s_car2" fileName="game/player_feet16.rttex" textureSize="32,32" frame="0,27" />
		<Sprite name="s_trail" fileName="game/particles6.rttex" textureSize="32" frame="13,11"/>
		<Animations>
			<SpriteAnimation name="s_Idle1" playOnState="Movement.Idle" sprite="s_car1">
				<Frame>0,26</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_Idle2" playOnState="Movement.Idle" sprite="s_car2">
				<Frame>0,27</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_Move1" playOnState="Movement.Move|Movement.Jump|Movement.Fall" sprite="s_car1" isLoop="true" animTime="200">
				<Frame>0,26</Frame>
				<Frame>1,26</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_Move2" playOnState="Movement.Move|Movement.Jump|Movement.Fall" sprite="s_car2" isLoop="true" animTime="200">
				<Frame>0,27</Frame>
				<Frame>1,27</Frame>
			</SpriteAnimation>
        </Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_trail">
				<Emitter>
					<Set name="offset">-30, -2</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle velocityRelativeToPlayerSpeed="true">
					<Set name="sprite">s_trail</Set>
					<Random name="offset" min="0, -4" max="0, 4"/>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1.25, 1.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialVelocity" min="-30, 0" max="-40, 0"/>
					<Random name="initialAngle" min="-45" max="45"/>
					<Set name="initialRotationRate">90</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
        <VariableMap />
        <StateMachines>
            <StateMachine name="Facing">
                <States>
                    <State name="Left" />
                    <State name="Right" />
                </States>
                <Transitions>
                    <Transition to="Left" from="Right">
                        <Condition>
                            <IsFacingLeft>true</IsFacingLeft>
                        </Condition>
                    </Transition>
                    <Transition to="Right" from="Left">
                        <Condition>
                            <IsFacingLeft>false</IsFacingLeft>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
            <StateMachine name="Movement">
                <States>
                    <State name="Idle" />
                    <State name="Move" />
                    <State name="Jump" />
                    <State name="Fall" />
                </States>
                <Transitions>
                    <Transition to="Idle" from="Fall|Move">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Move" from="Jump|Fall|Idle">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Jump" from="Idle|Move|Fall">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Fall" from="Jump|Idle|Move">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>
        <RenderOptions>
            <Default>
				<Set name="ClothingOffsetFromShoes">-3</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">false</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="IsCar">true</Set>
				<Set name="CarCastSmokeParticle">false</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="IsRidingBird">true</Set>
            </Default>
        </RenderOptions>
    </Data>
    <RenderRules>
        <RenderShoes>
            <Translate forceValue="false">0,6,0</Translate>
            <Group onState="Facing.Left">
                <SpriteRender name="s_car2" blend="NORMAL" alignment="DOWN_RIGHT" drawShadow="true" />
                <SpriteRender name="s_car1" blend="NORMAL" alignment="DOWN_LEFT" drawShadow="true" />
            </Group>
            <Group onState="Facing.Right">
                <SpriteRender name="s_car2" blend="NORMAL" alignment="DOWN_LEFT" drawShadow="true" />
                <SpriteRender name="s_car1" blend="NORMAL" alignment="DOWN_RIGHT" drawShadow="true" />
            </Group>
        </RenderShoes>
        <Update>
            <Group onState="Movement.Idle" />
            <Group onState="Movement.Move">
                <AvatarTransform class="ArmAngle">
                    <Set name="armName">arm2Angle</Set>
                    <Set name="armAngle">290</Set>
                </AvatarTransform>
            </Group>
            <Group onState="Movement.Jump" />
            <Group onState="Movement.Fall" />
        </Update>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_trail" onState="Movement.Move|Movement.Jump|Movement.Fall"/>
		</AddClothingParticles>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_REALITY_VISOR">
  <Data>
    <Sprite name="s_visor" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="0,21"/>
    <Sprite name="s_shard1" fileName="game/particles11.rttex" textureSize="32"/>
    <Sprite name="s_shard2" fileName="game/particles11.rttex" textureSize="32"/>
    <Sprite name="s_shard3" fileName="game/particles11.rttex" textureSize="32"/>
    <Sprite name="s_shard4" fileName="game/particles11.rttex" textureSize="32"/>
    <Sprite name="s_shard5" fileName="game/particles11.rttex" textureSize="32"/>

    <Animations>
      <SpriteAnimation name="a_shard1" sprite="s_shard1" animTime="900" autoPlay="true" isLoop="true" >
        <Frame>0,27</Frame>
        <Frame>1,27</Frame>
        <Frame>2,27</Frame>
        <Frame>3,27</Frame>
        <Frame>4,27</Frame>
        <Frame>5,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shard2" sprite="s_shard2" animTime="900" autoPlay="true" isLoop="true" >
        <Frame>0,28</Frame>
        <Frame>1,28</Frame>
        <Frame>2,28</Frame>
        <Frame>3,28</Frame>
        <Frame>4,28</Frame>
        <Frame>5,28</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shard3" sprite="s_shard3" animTime="900" autoPlay="true" isLoop="true" >
        <Frame>0,29</Frame>
        <Frame>1,29</Frame>
        <Frame>2,29</Frame>
        <Frame>3,29</Frame>
        <Frame>4,29</Frame>
        <Frame>5,29</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shard4" sprite="s_shard4" animTime="900" autoPlay="true" isLoop="true" >
        <Frame>0,30</Frame>
        <Frame>1,30</Frame>
        <Frame>2,30</Frame>
        <Frame>3,30</Frame>
        <Frame>4,30</Frame>
        <Frame>5,30</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shard5" sprite="s_shard5" animTime="900" autoPlay="true" isLoop="true" >
        <Frame>0,31</Frame>
        <Frame>1,31</Frame>
        <Frame>2,31</Frame>
        <Frame>3,31</Frame>
        <Frame>4,31</Frame>
        <Frame>5,31</Frame>
      </SpriteAnimation>
      <SpriteSinPulseAnimation name="floatAnim1" sprite="s_shard1" autoPlay="true">
        <Parameter name="pos.y">
          <Set name="period">2500</Set>
          <Set name="scale">1</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteSinPulseAnimation name="floatAnim2" sprite="s_shard2" autoPlay="true">
        <Parameter name="pos.y">
          <Set name="period">2000</Set>
          <Set name="scale">-2</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteSinPulseAnimation name="floatAnim3" sprite="s_shard3" autoPlay="true">
        <Parameter name="pos.y">
          <Set name="period">3000</Set>
          <Set name="scale">-1.5</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteSinPulseAnimation name="floatAnim4" sprite="s_shard4" autoPlay="true">
        <Parameter name="pos.y">
          <Set name="period">3000</Set>
          <Set name="scale">1.5</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteSinPulseAnimation name="floatAnim5" sprite="s_shard5" autoPlay="true">
        <Parameter name="pos.y">
          <Set name="period">2500</Set>
          <Set name="scale">-1</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="UserNameOffset">16</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderFaceItem>
      <SpriteRender name="s_visor" offset="0,-16" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderFaceItem>
    <RenderBehind value="playerCenter">
      <StopIf type="or">
        <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
        <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
        <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
        <IsZombified>true</IsZombified>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
      </StopIf>
      <Group>
        <StopIf>
          <IsFacingLeft>true</IsFacingLeft>
        </StopIf>
        <SpriteRender name="s_shard1" offset="18,-30" blend="PREMULTIPLIED_ALPHA"/>
        <SpriteRender name="s_shard2" offset="-4,-38" blend="PREMULTIPLIED_ALPHA"/>
        <SpriteRender name="s_shard3" offset="-18,-27.5" blend="PREMULTIPLIED_ALPHA"/>
        <SpriteRender name="s_shard4" offset="-17,-8" blend="PREMULTIPLIED_ALPHA"/>
        <SpriteRender name="s_shard5" offset="18,-10" blend="PREMULTIPLIED_ALPHA"/>
      </Group>
      <Group>
        <StopIf>
          <IsFacingLeft>false</IsFacingLeft>
        </StopIf>
        <SpriteRender name="s_shard1" offset="-18,-30" blend="PREMULTIPLIED_ALPHA" flip="1,0"/>
        <SpriteRender name="s_shard2" offset="4,-38" blend="PREMULTIPLIED_ALPHA" flip="1,0"/>
        <SpriteRender name="s_shard3" offset="18,-27.5" blend="PREMULTIPLIED_ALPHA" flip="1,0"/>
        <SpriteRender name="s_shard4" offset="17,-8" blend="PREMULTIPLIED_ALPHA" flip="1,0"/>
        <SpriteRender name="s_shard5" offset="-18, -10" blend="PREMULTIPLIED_ALPHA" flip="1,0"/>
      </Group>
    </RenderBehind>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
    <Data>
        <!-- SPRITES -->
        <Sprite name="s_Basket" fileName="game/rebanalizard_parts.rttex" textureSize="32,32" frame="0,0" />
        <Sprite name="s_Bell" fileName="game/rebanalizard_back.rttex" textureSize="128,32" frame="0,0" />
        <Sprite name="s_PunchFireSprite" fileName="game/particles11.rttex" textureSize="32" frame="26,29" />
        <Sprite name="s_snowflakes" fileName="game/particles4.rttex" textureSize="32"/>
        <Sprite name="s_smoke" fileName="game/particles9.rttex" textureSize="32" frame="20,2"/>
        <Sprite name="s_idleFlame" fileName="game/particles9.rttex" textureSize="32" frame="6,3"/>

        <!-- ANIMATIONS -->
        <Animations>

            <!-- Corrected: 4 real frames from rebanalizard_back.png -->
            <SpriteAnimation name="a_Basket" sprite="s_Basket" animTime="2000" autoPlay="true" isLoop="true">
                <Frame>0,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,0</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="a_snowflakes" sprite="s_snowflakes">
                <Frame>4,14</Frame>
                <Frame>5,14</Frame>
            </SpriteAnimation>

            <!-- Corrected: 3 real frames from rebanalizard_parts.png -->
            <SpriteAnimation name="a_Bell" sprite="s_Bell" animTime="800" autoPlay="true" isLoop="true">
                <Frame>0,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,0</Frame>
            </SpriteAnimation>

        </Animations>

        <!-- STATE MACHINES (unchanged) -->
        <StateMachines>
            <StateMachine name="Action">
                <States>
                    <State name="None" />
                    <State name="Punch" />
                </States>
                <Transitions>
                    <Transition to="None" from="Punch">
                        <Condition>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Punch" from="None">
                        <Condition>
                            <IsAction>PUNCH</IsAction>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>

            <StateMachine name="Facing">
                <States>
                    <State name="Left" />
                    <State name="Right" />
                </States>
                <Transitions>
                    <Transition to="Left" from="Right">
                        <Condition>
                            <IsFacingLeft>true</IsFacingLeft>
                        </Condition>
                    </Transition>
                    <Transition to="Right" from="Left">
                        <Condition>
                            <IsFacingLeft>false</IsFacingLeft>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>

        <!-- PARTICLES (completely untouched) -->
        <ParticleSystems>
            <ParticleSystem name="ps_shieldFlames_left" updateStage="RenderPet">
                <Emitter>
                    <Random name="offset" min="40, -127" max="45, -127" />
                    <Random name="emissionInterval" min="0.05" max="0.1" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">4</Set>
                </Emitter>
                <Particle usePlayerFacing="true">
                    <Set name="sprite">s_idleFlame</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="lifeTime">0.7</Set>
                    <Set name="initialVelocity">0,-3</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="initalRGB">0, 0.3, 0.7</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0</KeyFrame>
                        <KeyFrame>0.5, 0.4</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Random name="initialScale" min="0.4" max="0.7" />
                    <Random name="initialAngle" min="-40" max="-40" />
                </Particle>
            </ParticleSystem>

            <ParticleSystem name="ps_smoke" updateStage="RenderPet">
                <Emitter>
                    <Random name="offset" min="0, -65" max="0, -65" />
                    <Random name="emissionInterval" min="0.2" max="0.5" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">2</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">s_smoke</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">2</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="initalRGB">0, 0.3, 0.7</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0</KeyFrame>
                        <KeyFrame>0.5, 0.8</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Random name="initialVelocity" min="-30,0" max="30,0"/>
                    <Random name="initialScale" min="3" max="4" />
                </Particle>
            </ParticleSystem>

            <ParticleSystem name="ps_rain" updateStage="RenderPet">
                <Emitter>
                    <Random name="offset" min="-60, -70" max="40, -75" />
                    <Random name="emissionInterval" min="0.07" max="0.14" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle randomSpriteFrame="true">
                    <Set name="sprite">s_snowflakes</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="initalRGB">0, 0.3, 0.7</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0.8</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Random name="initialScale" min="0.50" max="2" />
                    <Set name="lifeTime">1.5</Set>
                    <Random name="initialVelocity" min="-20, 40" max="30, 60" />
                    <Random name="initialAngle" min="0" max="-360" />
                </Particle>
            </ParticleSystem>

            <ParticleSystem name="PunchParticle">
                <Emitter>
                    <Set name="offset">60, -116</Set>
                    <Random name="emissionInterval" min="0.001" max="0.005" />
                    <Set name="infParticles">true</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Particle usePlayerFacing="true"></Particle>
                    <Set name="sprite">s_PunchFireSprite</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="initalRGB">0, 0.5, 0.7</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 0.2</KeyFrame>
                        <KeyFrame>0.5, 0.7</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                    <Curve name="initialScale">
                        <KeyFrame>0, 2, 2</KeyFrame>
                        <KeyFrame>1, 5, 5</KeyFrame>
                    </Curve>
                    <Set name="lifeTime">0.35</Set>
                    <Random name="targetPosOffset" min="-12,-8" max="12,8"/>
                    <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.7" angleOutVar="projectile_angle"/>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>

        <RenderOptions>
            <Default>
                <Set name="NeedRenderPet">true</Set>
                <Set name="PetOffsetDuplication">-48,0</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="HideParticlesOnTransform">false</Set>
            </Default>
        </RenderOptions>

    </Data>

    <!-- RENDER RULES -->
    <RenderRules>
        <AddclothingParticles>
        </AddclothingParticles>

        <OnDamagedTile>
            <StopIf type="or">
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
                <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
            </StopIf>
        </OnDamagedTile>

        <OnDestroyedTile>
            <StopIf type="or">
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
                <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
            </StopIf>
        </OnDestroyedTile>

        <OnPunchUpdate>
            <AvatarTransform class="Face">
                <Set name="face">MAD</Set>
            </AvatarTransform>
        </OnPunchUpdate>

        <RenderHandItem>
            <SpriteRender name="s_Basket" offset="15.5,25" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" />
        </RenderHandItem>

        <RenderPet>
            <ParticleSystemUpdate name="PunchParticle" onState="Action.Punch"/>
            <SpriteRender name="s_Bell" alignment="DOWN_CENTER" rotateOffset="true" offset="-60,-40" />
            <ParticleSystemRender name="ps_rain" />
            <ParticleSystemRender name="ps_smoke" />
            <ParticleSystemRender name="ps_shieldFlames_left" />
        </RenderPet>

    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Pet" fileName="game/rebana_back.rttex" textureSize="128,32" frame="0,0"/>
    <Sprite name="s_PetParts" fileName="game/rebana_parts.rttex" textureSize="40,32" frame="0,0"/>
    <Sprite name="s_Hand" fileName="game/rebana_hand.rttex" textureSize="64,32" frame="0,0"/>
    <Sprite name="s_Punch" fileName="game/particles12.rttex" textureSize="32" frame="27,8" />
    <Sprite name="respawnParticle" fileName="game/particles_large16.rttex" textureSize="64" frame="8,11" />
    <Sprite name="s_feather" fileName="game/particles12.rttex" textureSize="32" frame="29,4" />
    <Sprite name="s_fog" fileName="game/particles12.rttex" textureSize="32" frame="30,4" />

    <Animations>
      <SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="800" isLoop="true" autoPlay="true" playOnState="Pet.Idle">
        <Frame>0,0</Frame>
        <Frame>0,1</Frame>
        <Frame>1,0</Frame>
      </SpriteAnimation>
      
      <SpriteAnimation name="a_PetPartsIdle" sprite="s_PetParts" animTime="800" isLoop="true" playOnState="Pet.Idle">
        <Frame>0,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetPunch" sprite="s_Pet" animTime="800" isLoop="false" playOnState="Pet.Punch">
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetPartsPunch" sprite="s_PetParts" animTime="800" isLoop="false" playOnState="Pet.Punch">
        <Frame>1,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_feather" sprite="s_feather" animTime="100" isLoop="true" playOnState="Action.Move">
        <Frame>29,4</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fog" sprite="s_fog" animTime="100" isLoop="true" playOnState="Action.Move">
        <Frame>30,4</Frame>
      </SpriteAnimation>

    </Animations>
    
    <StateMachines>
      <StateMachine name="Pet">
        <States>
          <State name="Idle" />
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition to="Punch" from="Idle">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Idle" from="Punch" >
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Move|Jump" >
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Jump|Fall|Idle" >
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall" >
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move" >
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>

    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_punch_projectile" updateStage="OnPunchStart" updateState="Pet.Punch">
        <Emitter>
          <Set name="offset">60,-15</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">100</Set>
          <Set name="infParticles">false</Set>
          <Set name="infLifeTime">false</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Punch</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">0</Set>
          <Set name="interpolateAlpha">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1.2, 0.6</KeyFrame>
            <KeyFrame>1, 9.6, 4.8</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.45</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
          <RandomRadial name="initialVelocity" angleRange="-15,15" radiusRange="50,100" />
          <Set name="rotateWithVelocity">true</Set>
          <Set name="gravityVector">0,-20</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="flipX">false</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_feather" updateStage="AddClothingParticles" updateState="Motion.Move">
        <Emitter>
          <Set name="offset">-17, -2</Set>
          <Set name="lifeTime">1</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_feather</Set>
          <Random name="offset" min="-15, -10" max="15, -5" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="initalRGB">1, 1, 1</Set>
          <Set name="finalAlpha">0</Set>
          <Set name="interpolateAlpha">true</Set>
          <Set name="useGravity">true</Set>
          <Set name="initialScale">1, 1</Set>
          <Set name="lifeTime">1.2</Set>
          <Curve name="initialVelocity">
            <KeyFrame>0.2, -20, 0</KeyFrame>
            <KeyFrame>0.4, 50, 0</KeyFrame>
            <KeyFrame>0.6, -50, 0</KeyFrame>
            <KeyFrame>0.8, 50, 0</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Curve name="initialAngle">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, -15</KeyFrame>
            <KeyFrame>0.4, 15</KeyFrame>
            <KeyFrame>0.6, -15</KeyFrame>
            <KeyFrame>0.8, 15</KeyFrame>
          </Curve>
          <Set name="gravityVector">0, 30</Set>
          <Set name="flipX">false</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_fogLocal" updateStage="AddClothingParticles" updateState="Motion.Idle">
        <Emitter>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">false</Set>
          <Set name="infLifeTime">false</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_fog</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-8, -8" max="8, -16" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.25</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="initalRGB">0.346503, 0.25668, 0.534314</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 2, 2</KeyFrame>
          </Curve>
          <Set name="lifeTime">1.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,30" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_fogWorld" updateStage="AddClothingParticles" updateState="Motion.Move">
        <Emitter>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_fog</Set>
          <Random name="offset" min="-12, 0" max="12, -24" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.25</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="initalRGB">0.303625, 0.221429, 0.47549</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1.25, 1.25</KeyFrame>
            <KeyFrame>1, 2, 2</KeyFrame>
          </Curve>
          <Set name="lifeTime">1.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,20" />
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="SpawnParticle">
        <Emitter>
          <Set name="offset">0, -500</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">respawnParticle</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 3, 3</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="SpawnParticleRabbits">
        <Emitter>
          <Set name="offset">0, -500</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Pet</Set>
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 3, 3</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="SpawnSparkle">
        <Emitter>
          <Set name="offset">0, -900</Set>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_Punch</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Random name="offset" min="-24, -16" max="24, 16" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="1" max="1.5" />
          <Increment name="finalScale" source="initialScale" multiplier="2.5,2.5"/>
          <Set name="interpolateScale">true</Set>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">0,0</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="UsePetForceFaceTime">true</Set>
      </Default>
    </RenderOptions>
  </Data>

    <RenderRules>
      <RenderPet>
        <SpriteRender name="s_Pet" alignment="DOWN_CENTER"/>
        <SpriteRender name="s_PetParts" alignment="DOWN_CENTER" offset="1,-18" onState="Pet.Idle"/>
        <SpriteRender name="s_PetParts" alignment="DOWN_CENTER" offset="-4,17" onState="Pet.Punch"/>
        <ParticleSystemUpdate name="ps_punch_projectile" offset="90,-16" scale="1,0.5" onState="Pet.Punch" blend="PREMULTIPLIED_ALPHA" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" />
      </RenderPet>
    <RenderHandItem>
      <SpriteRender name="s_Hand" offset="0,8" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
      <ParticleSystemUpdate name="ps_feather" onState="Motion.Move" />
      <ParticleSystemUpdate name="ps_fogLocal" onState="Motion.Idle" />
      <ParticleSystemUpdate name="ps_fogWorld" onState="Motion.Move" />
    </RenderHandItem>
    <OnRespawned>
      <ParticleSystemUpdate name="SpawnParticle" />
      <ParticleSystemUpdate name="SpawnParticleRabbits" />
      <ParticleSystemUpdate name="SpawnSparkle" />
    </OnRespawned>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_bow" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="8,3" />
    <Sprite name="s_ribbonLeft" fileName="game/particles12.rttex" textureSize="32" frame="10,15" />
    <Sprite name="s_ribbonRight" fileName="game/particles12.rttex" textureSize="32" frame="11,15" />
    
    <Animations>
      <SpriteAnimation name="a_ribbonLeftIdle" sprite="s_ribbonLeft" animTime="1000" isLoop="true" playOnState="Action.Idle">
        <Frame>10,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ribbonRightIdle" sprite="s_ribbonRight" animTime="1000" isLoop="true" playOnState="Action.Idle">
        <Frame>11,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ribbonLeftMove" sprite="s_ribbonLeft" animTime="600" isLoop="true" playOnState="Action.Walk|Action.JumpStraight|Action.JumpDiagonal|Action.FallStraight|Action.FallDiagonal">
        <Frame>17,15</Frame>
        <Frame>12,15</Frame>
        <Frame>13,15</Frame>
        <Frame>12,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ribbonRightFall" sprite="s_ribbonRight" animTime="600" isLoop="true" playOnState="Action.FallStraight|Action.FallDiagonal">
        <Frame>13,15</Frame>
        <Frame>12,15</Frame>
        <Frame>17,15</Frame>
        <Frame>12,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ribbonRightMove" sprite="s_ribbonRight" animTime="600" isLoop="true" playOnState="Action.Walk|Action.JumpStraight|Action.JumpDiagonal">
        <Frame>14,15</Frame>
        <Frame>15,15</Frame>
        <Frame>16,15</Frame>
        <Frame>15,15</Frame>
      </SpriteAnimation>
      <InterpolationVec4Animation name="a_idleLeftRot" variableName="belt_rotationLeft" targetValue="0, 0, 0, 1" animTime="600" playOnState="Action.Idle"/>
      <InterpolationVec4Animation name="a_walkLeftRot" variableName="belt_rotationLeft" targetValue="0, 0, 0, 1" animTime="400" playOnState="Action.Walk"/>
      <InterpolationVec4Animation name="a_fallLeftRotFallStraight" variableName="belt_rotationLeft" targetValue="15, 0, 0, 1" animTime="1000" playOnState="Action.FallStraight"/>
      <InterpolationVec4Animation name="a_fallLeftRotFallDiagonal" variableName="belt_rotationLeft" targetValue="15, 0, 0, 1" animTime="400" playOnState="Action.FallDiagonal"/>
      <InterpolationVec4Animation name="a_jumpLeftRotJumpStraight" variableName="belt_rotationLeft" targetValue="-40, 0, 0, 1" animTime="1000" playOnState="Action.JumpStraight"/>
      <InterpolationVec4Animation name="a_jumpLeftRotJumpDiagonal" variableName="belt_rotationLeft" targetValue="10, 0, 0, 1" animTime="400" playOnState="Action.JumpDiagonal"/>
      
      <InterpolationVec4Animation name="a_idleRightRot" variableName="belt_rotationRight" targetValue="0, 0, 0, 1" animTime="600" playOnState="Action.Idle"/>
      <InterpolationVec4Animation name="a_walkRightRot" variableName="belt_rotationRight" targetValue="40, 0, 0, 1" animTime="400" playOnState="Action.Walk"/>
      <InterpolationVec4Animation name="a_fallRightRotFallStraight" variableName="belt_rotationRight" targetValue="-15, 0, 0, 1" animTime="1000" playOnState="Action.FallStraight"/>
      <InterpolationVec4Animation name="a_fallRightRotFallDiagonal" variableName="belt_rotationRight" targetValue="-15, 0, 0, 1" animTime="400" playOnState="Action.FallDiagonal"/>
      <InterpolationVec4Animation name="a_jumpRightRotJumpStraight" variableName="belt_rotationRight" targetValue="40, 0, 0, 1" animTime="1000" playOnState="Action.JumpStraight"/>
      <InterpolationVec4Animation name="a_jumpRightRotJumpDiagonal" variableName="belt_rotationRight" targetValue="40, 0, 0, 1" animTime="400" playOnState="Action.JumpDiagonal"/>
    </Animations>
    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="JumpStraight" />
          <State name="JumpDiagonal" />
          <State name="FallStraight" />
          <State name="FallDiagonal" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|FallStraight|FallDiagonal">
            <Condition>
              <IsAction>IDLE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|FallDiagonal|FallStraight">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">JUMP</IsAction>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition to="JumpStraight" from="Idle|Walk|FallStraight|JumpDiagonal|FallDiagonal">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="JumpDiagonal" from="Idle|Walk|FallStraight|JumpStraight|FallDiagonal">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="FallStraight" from="Walk|FallDiagonal|JumpStraight|JumpDiagonal|Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="FallDiagonal" from="Walk|FallStraight|JumpStraight|JumpDiagonal|Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <VariableMap>
      <Set name="belt_rotationLeft">0, 0, 0, 1</Set>
      <Set name="belt_rotationRight">0, 0, 0, 1</Set>
    </VariableMap>
  </Data>
  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_bow" offset="0,-17" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="s_bow" offset="0,-17" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
      <Group>
        <Rotate>belt_rotationLeft</Rotate>
        <SpriteRender name="s_ribbonLeft" offset="-2,-15" alignmentLeft="UPPER_LEFT" alignmentRight="UPPER_RIGHT"/>
      </Group>
      <Group>
        <Rotate>belt_rotationRight</Rotate>
        <Group onState="Action.Idle">
          <SpriteRender name="s_ribbonRight" offset="2,-15" alignmentLeft="UPPER_RIGHT" alignmentRight="UPPER_LEFT"/>
        </Group>
        <Group onState="Action.Walk|Action.JumpStraight|Action.JumpDiagonal|Action.FallStraight|Action.FallDiagonal">
          <SpriteRender name="s_ribbonRight" offset="2,-15" flip="1,0" alignmentLeft="UPPER_RIGHT" alignmentRight="UPPER_LEFT"/>
        </Group>
      </Group>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Front" fileName="game/particles_large16.rttex" textureSize="64" frame="9,11" />
    <Sprite name="s_Back" fileName="game/particles_large16.rttex" textureSize="64" frame="9,12" />
 
    <Animations>
      <SpriteAnimation name="a_front" sprite="s_Front" animTime="400" autoPlay="true" isLoop="true">
        <Frame>9,11</Frame>
        <Frame>10,11</Frame>
        <Frame>11,11</Frame>
        <Frame>12,11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_back" sprite="s_Back" animTime="400" autoPlay="true" isLoop="true">
        <Frame>9,12</Frame>
        <Frame>10,12</Frame>
        <Frame>11,12</Frame>
        <Frame>12,12</Frame>
      </SpriteAnimation>
    </Animations>
    <Animations />
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="ClothingOffsetFromShoes">-16</Set>
        <Set name="UserNameOffset">16</Set>
        <Set name="RenderShoesWithMermaidTail">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IsRidingBird">true</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShouldHover">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
	  <OnPunchUpdate>
		  <AvatarTransform class="Face">
			  <Set name="face">MAD</Set>
		  </AvatarTransform>
	  </OnPunchUpdate>
	  <RenderBehind>
		  <StopIf type="or">
			  <IsZombified>true</IsZombified>
			  <IsSitting>true</IsSitting>
			  <IsSleepingOnaBed>true</IsSleepingOnaBed>
			  <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
		  </StopIf>


      <Translate>10,15,0</Translate>
			  <SpriteRender name="s_Back" blend="PREMULTIPLIED_ALPHA" drawShadow="true"/>
	  </RenderBehind>
	  <RenderInFront>
		  <StopIf type="or">
			  <IsZombified>true</IsZombified>
			  <IsSitting>true</IsSitting>
			  <IsSleepingOnaBed>true</IsSleepingOnaBed>
			  <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
		  </StopIf>
			  <Translate>9,-11,0</Translate>
			  <SpriteRender name="s_Front" blend="PREMULTIPLIED_ALPHA" drawShadow="true" />
	  </RenderInFront>
	  <Update>
		  <StopIf type="or">
			  <IsZombified>true</IsZombified>
			  <IsTrnsformed>true</IsTrnsformed>
			  <IsSitting>true</IsSitting>
			  <IsSleepingOnaBed>true</IsSleepingOnaBed>
			  <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			  <IsAction>JUMP</IsAction>
			  <IsAction>JUMPDOUBLE</IsAction>
			  <IsAction>JUMPSTART</IsAction>
			  <IsAction>FALL</IsAction>
		  </StopIf>
		  <AvatarTransform class="ArmAngle">
			  <Set name="armName">arm2Angle</Set>
			  <Set name="armAngle">-45</Set>
		  </AvatarTransform>
		  <StopIf>
			  <IsAction>PUNCH</IsAction>
			  <IsAction>BUILD</IsAction>
		  </StopIf>
		  <AvatarTransform class="ArmAngle">
			  <Set name="armName">arm1Angle</Set>
			  <Set name="armAngle">-45</Set>
		  </AvatarTransform>
	  </Update>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_PARTY_WAGON">
	<Data>
		<Sprite name="s_Trail" fileName="game/particles11.rttex" textureSize="32" frame="12,26" />
		<Sprite name="s_Truck" fileName="game/particles_large13.rttex" textureSize="64" frame="12,5" />
		<Sprite name="s_TruckLights" fileName="game/particles_large13.rttex" textureSize="64" frame="12,6" />
		<Sprite name="s_shoe1" fileName="game/player_feet16.rttex" textureSize="32" frame="29,14" />
		<Sprite name="s_shoe2" fileName="game/player_feet16.rttex" textureSize="32" frame="29,15" />
		<Animations>
			<SpriteAnimation name="a_Idle" sprite="s_Truck" playOnState="Motion.Idle">
				<Frame>12,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_IdleLights" sprite="s_TruckLights" playOnState="Motion.Idle">
				<Frame>12,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Move" sprite="s_Truck" animTime="400" isLoop="true" playOnState="Motion.Moving">
				<Frame>12,5</Frame>
				<Frame>13,5</Frame>
				<Frame>14,5</Frame>
				<Frame>15,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_MoveLights" sprite="s_TruckLights" animTime="400" isLoop="true" playOnState="Motion.Moving">
				<Frame>12,6</Frame>
				<Frame>13,6</Frame>
				<Frame>14,6</Frame>
				<Frame>15,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Trail" sprite="s_Trail" animTime="400">
				<Frame>12,26</Frame>
				<Frame>13,26</Frame>
				<Frame>14,26</Frame>
				<Frame>15,26</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="HMotion">
				<States>
					<State name="Idle" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle">
						<Condition>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Tile">
				<States>
					<State name="Light" />
					<State name="Dark" />
				</States>
				<Transitions>
					<Transition to="Light" from="Dark">
						<Condition>
							<IsDarkTile>false</IsDarkTile>
						</Condition>
					</Transition>
					<Transition to="Dark" from="Light">
						<Condition>
							<IsDarkTile>true</IsDarkTile>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-14</Set>
				<Set name="IsRv">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="UserNameOffset">10</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_TrailB" updateStage="RenderShoes" updateState="HMotion.Moving">
				<Emitter>
					<Set name="offset">38, -1</Set>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">5</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Random name="offset" min="-2, 0" max="2, 0" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initalRGB">0.877451, 0.852403, 0.0258074</Set>
					<Set name="finalRGB">0.857843, 0.537883, 0.0210256</Set>
					<Set name="interpolateRGB">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.25, 0.25</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.15" max="0.25" />
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_TrailF" updateStage="RenderShoes" updateState="HMotion.Moving">
				<Emitter>
					<Set name="offset">15, 1</Set>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Random name="offset" min="-2, 0" max="2, 0" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initalRGB">1, 0.971309, 0.0245098</Set>
					<Set name="finalRGB">0.965686, 0.601883, 0.0142013</Set>
					<Set name="interpolateRGB">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.25, 0.25</KeyFrame>
						<KeyFrame>1, 0.85, 0.85</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.15" max="0.25" />
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group onState="Motion.Moving">
				<AvatarTransform class="ArmAngle" onState="Action.None">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">-100</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Action.None">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
			</Group>
			<AvatarTransform class="Face" onState="Motion.Moving|Action.Punch">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<SpriteRender name="s_shoe2" offset="1,0" alignment="DOWN_CENTER" />
			<SpriteRender name="s_shoe1" offset="1,0" alignment="DOWN_CENTER" />
			<SpriteRender name="s_Truck" offset="14,14" alignment="DOWN_CENTER" onState="Tile.Light" />
			<SpriteRender name="s_TruckLights" offset="14,14" alignment="DOWN_CENTER" onState="Tile.Dark" />
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
		</RenderShoes>
		<RenderBehind>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_TrailB" />
		</RenderBehind>
		<RenderInFront>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_TrailF" />
		</RenderInFront>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_equip" fileName="game/particles_large14.rttex" textureSize="64" frame="7,12"/>
    <Sprite name="s_trail" fileName="game/particles9.rttex" textureSize="32" frame="15,0" />

    <Animations>
      <SpriteAnimation name="a_idle" playOnState="Motion.Idle" sprite="s_equip" isLoop="true" animTime="400">
        <Frame>7,12</Frame>
        <Frame>8,12</Frame>
        <Frame>9,12</Frame>
        <Frame>10,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_move" playOnState="Motion.Move" sprite="s_equip" isLoop="true" animTime="400">
        <Frame>11,12</Frame>
        <Frame>12,12</Frame>
        <Frame>13,12</Frame>
        <Frame>14,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump" playOnState="Motion.Jump" sprite="s_equip" isLoop="true" animTime="100">
        <Frame>15,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall" playOnState="Motion.Fall" sprite="s_equip" isLoop="true" animTime="100">
        <Frame>15,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_trail" sprite="s_trail">
        <Frame>15,0</Frame>
        <Frame>16,0</Frame>
        <Frame>17,0</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_trail" updateStage="AddClothingParticles" renderStage="RenderShoes" updateState="Motion.Move">
        <Emitter>
          <Set name="emissionInterval">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_trail</Set>
          <Random name="offset" min="-20, 0" max="20, 0" />
          <Random name="initialAngle" min="0" max="360" />
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.6</Set>
          <RandomRadial name="initialVelocity" angleRange="-80,-110" radiusRange="50,75" />
          <Set name="gravityVector">0, 300</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Move|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Jump|Fall|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <RenderOptions>
      <Default>
        <Set name="IsToRenderPants">true</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="ClothingOffsetFromShoes">-15</Set>
        <Set name="UserNameOffset">11</Set>
        <Set name="IsHorse">true</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <RenderShoes>
      <SpriteRender name="s_equip" offset="12,-16"/>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
    </RenderShoes>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_foot1" fileName="game/player_feet16.rttex" textureSize="32" frame="12,22"/>
    <Sprite name="s_foot2" fileName="game/player_feet16.rttex" textureSize="32" frame="12,23"/>
    <StateMachines>
	    <StateMachine name="Action">
		    <States>
			    <State name="Idle" />
			    <State name="Walk" />
			    <State name="Jump" />
			    <State name="Fall" />
		    </States>
		    <Transitions>
			    <Transition to="Idle" from="Fall|Walk">
				    <Condition type="and">
					    <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">true</IsVariableBool>
				    </Condition>
			    </Transition>
			    <Transition to="Walk" from="Fall|Idle|Jump">
				    <Condition type="and">
					    <IsVariableBool name="onGround">true</IsVariableBool>
					    <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
				    </Condition>
			    </Transition>
			    <Transition to="Jump" from="Idle|Fall|Walk">
				    <Condition type="and">
					    <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">false</IsVariableBool>
				    </Condition>
			    </Transition>
			    <Transition to="Fall" from="Jump|Idle|Walk">
				    <Condition type="and">
					    <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
					    <IsVariableBool name="onGround">false</IsVariableBool>
				    </Condition>
			    </Transition>
		    </Transitions>
	    </StateMachine>
    </StateMachines>
    <Animations>
	    <SpriteAnimation name="a_idle_foot_1" sprite="s_foot1" isLoop="true" animTime="1400" playOnState="Action.Idle">
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>13,22</Frame>
		    <Frame>12,22</Frame>
		    <Frame>13,22</Frame>
	    </SpriteAnimation>
	    <SpriteAnimation name="a_idle_foot_2" sprite="s_foot2" isLoop="true" animTime="1400" playOnState="Action.Idle">
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>13,23</Frame>
		    <Frame>12,23</Frame>
		    <Frame>13,23</Frame>
	    </SpriteAnimation>

		<SpriteAnimation name="a_move_foot_1" sprite="s_foot1" isLoop="true" animTime="300" playOnState="Action.Walk">
        <Frame>14,22</Frame>
        <Frame>15,22</Frame>
        <Frame>16,22</Frame>
      </SpriteAnimation>     
	  <SpriteAnimation name="a_move_foot_2" sprite="s_foot2" isLoop="true" animTime="300" playOnState="Action.Walk">
		  <Frame>14,23</Frame>
		  <Frame>15,23</Frame>
		  <Frame>16,23</Frame>
      </SpriteAnimation>

		<SpriteAnimation name="a_jump_foot_1" sprite="s_foot1" isLoop="true" animTime="100" playOnState="Action.Jump">
			<Frame>14,22</Frame>
		</SpriteAnimation>
	    <SpriteAnimation name="a_jump_foot_2" sprite="s_foot2" isLoop="true" animTime="100" playOnState="Action.Jump">
		    <Frame>14,23</Frame>
	    </SpriteAnimation>		
		
		<SpriteAnimation name="a_fall_foot_1" sprite="s_foot1" isLoop="true" animTime="100" playOnState="Action.Fall">
			<Frame>15,22</Frame>
		</SpriteAnimation>
	    <SpriteAnimation name="a_fall_foot_2" sprite="s_foot2" isLoop="true" animTime="100" playOnState="Action.Fall">
		    <Frame>15,23</Frame>
	    </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
		  <Set name="ClothingOffsetFromShoes">-1</Set>
		  <Set name="IsToRenderPants">true</Set>
		  <Set name="IncludeAllActions">true</Set>
		  <Set name="UserNameOffset">-5</Set>
	      <Set name="ShoesShouldIgnoreRaptorLegsOffset">false</Set>
	      <Set name="IsVehicle">true</Set>
		  <Set name="IsHorse">true</Set>
		  <Set name="IgnorePunchTypeCheck">true</Set>
		  <Set name="ShoesHidesBodyLegs">true</Set>
		  <Set name="RenderShoesWithMermaidTail">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderShoes>
      <SpriteRender name="s_foot1" offset="18,2" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT"/>
      <SpriteRender name="s_foot2" offset="-13,2" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT"/>
      <StopIf>
        <IsAction>PUNCH</IsAction>
        <IsAction>BUILD</IsAction>
        <IsSitting>true</IsSitting>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="Action.Walk|Action.Jump|Action.Fall">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Action.Walk|Action.Jump|Action.Fall">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Action.Idle">
	      <Set name="armName">arm2Angle</Set>
	      <Set name="armAngle">5</Set>
      </AvatarTransform>
    </RenderShoes>
  </RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
  <Data>
    <Sprite name="s_shoes" fileName="game/player_feet16.rttex" textureSize="32,32" frame="17,24" />
    <Sprite name="s_drops" fileName="game/particles12.rttex" textureSize="32,32" frame="13,13" />
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="No" />
          <State name="Yes" />
        </States>
        <Transitions>
          <Transition to="No" from="Yes">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Yes" from="No">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Mobility">
        <States>
          <State name="OnGround"/>
          <State name="InAir"/>
          <State name="Jumping"/>
          <State name="Landing"/>
        </States>
        <Transitions>
          <Transition to="Landing" from="InAir">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="OnGround" from="Landing"/>
          <Transition to="Jumping" from="OnGround">
            <Condition>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="InAir" from="Jumping"/>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_drops">
        <Emitter>
          <Random name="particlesPerEmission" min="2" max="4"/>
          <Set name="offset">0,-14</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_drops</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 0.25, 0.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Set name="inSpecificOrder">true</Set>
          <RandomRadial name="initialVelocity" angleRange="210,240" radiusRange="40,60"/>
          <Set name="gravityVector">0, 60</Set>
          <Random name="offset" min="-4, 0" max="4,0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_drops1">
        <Emitter>
          <Random name="particlesPerEmission" min="2" max="4"/>
          <Set name="offset">0,-14</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_drops</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 0.25, 0.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Set name="inSpecificOrder">true</Set>
          <RandomRadial name="initialVelocity" angleRange="300,330" radiusRange="40,60"/>
          <Set name="gravityVector">0, 60</Set>
          <Random name="offset" min="-4, 0" max="4,0"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="ClothingOffsetFromShoes">-7</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="RenderShoesWithMermaidTail">true</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="UserNameOffset">10</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <Update>
      <Group onState="Punch.No">
        <StopIf>
          <IsZombified>true</IsZombified>
          <IsTrnsformed>true</IsTrnsformed>
          <IsSitting>true</IsSitting>
          <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        </StopIf>
        <AvatarTransform class="Face" onState="Mobility.InAir|Mobility.Jumping">
          <Set name="face">NORMAL</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="armAngle">45</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm1Angle</Set>
          <Set name="armAngle">-45</Set>
        </AvatarTransform>
      </Group>
    </Update>
    <RenderShoes>
      <SpriteRender name="s_shoes" offset="1.2,7.5" alignment="DOWN_CENTER"/>
      <ParticleSystemRender name="ps_drops"/>
      <ParticleSystemRender name="ps_drops1"/>
    </RenderShoes>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_drops" onState="Mobility.Jumping|Mobility.Landing"/>
      <ParticleSystemUpdate name="ps_drops1" onState="Mobility.Jumping|Mobility.Landing"/>
    </AddClothingParticles>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_golem" fileName="game/particles_large18.rttex" textureSize="64" frame="0, 12"/>
		<Sprite name="s_trail_sprite" fileName="game/particles12.rttex" textureSize="32" frame="0, 12"/>
		<Sprite name="s_rocks" fileName="game/particles12.rttex" textureSize="32" frame="19,17"/>
		<Sprite name="s_rocksTrail" fileName="game/particles12.rttex" textureSize="32" frame="19,17"/>
		<Sprite name="s_flash" fileName="game/particles12.rttex" textureSize="32" frame="6,10" />
		<Sprite name="s_legs" fileName="game/player_sit.rttex" textureSize="32" frame="1,0" />
		<Animations>
			<SpriteAnimation name="a_golem_idle" sprite="s_golem" animTime="200" isLoop="true" playOnState="State.Idle">
				<Frame>0, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_golem_jump" sprite="s_golem" animTime="200" isLoop="true" playOnState="State.Jump">
				<Frame>8, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_golem_fall" sprite="s_golem" animTime="200" isLoop="true" playOnState="State.Fall">
				<Frame>9, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_golem_move" sprite="s_golem" animTime="700" isLoop="true" playOnState="State.Move">
				<Frame>1, 12</Frame>
				<Frame>2, 12</Frame>
				<Frame>3, 12</Frame>
				<Frame>4, 12</Frame>
				<Frame>5, 12</Frame>
				<Frame>6, 12</Frame>
				<Frame>7, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_golem_punch" sprite="s_golem" animTime="200" isLoop="true" playOnState="State.Punch">
				<Frame>10, 12</Frame>
				<Frame>11, 12</Frame>
				<Frame>12, 12</Frame>
				<Frame>13, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_rocks" sprite="s_rocks" autoPlay="false" animTime="400">
				<Frame>19,21</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_rocksTrail" sprite="s_rocksTrail" autoPlay="false" animTime="500">
				<Frame>19,21</Frame>
				<Frame>15,21</Frame>
				<Frame>15,21</Frame>
				<Frame>15,21</Frame>
				<Frame>16,21</Frame>
				<Frame>17,21</Frame>
				<Frame>18,21</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="State">
				<States>
					<State name="Idle" />
					<State name="Punch"/>
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall" >
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_Punch" secondary="ps_Trail">
				<Emitter>
					<Set name="offset">18, -10</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle autoLifeTimeToTarget="true">
					<Set name="sprite">s_rocks</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<Set name="initialAlpha">0</Set>
					<OnFinish>
						<ParticleSystemName>ps_Flash</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail">
				<Emitter>
					<Set name="lifeTime">0.4</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">16</Set>
					<Set name="emissionInterval" source="Interval"/>
				</Emitter>
				<Particle>
					<Set name="sprite">s_rocksTrail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="useGravity">true</Set>
					<Set name="initialScale">0.8,0.8</Set>
					<Set name="gravityVector">0, 200</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Flash">
				<Emitter attachment="targetPos">
					<Set name="lifeTime">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_flash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.8, 1.8</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.2</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="LifeTime">0.4</Set>
			<Set name="Interval">0.07</Set>
			<Set name="NumTiles">0</Set>
			<Set name="TileWidth">32</Set>
			<Set name="Punch.GetDistance">0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="UserNameOffset">8</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="NumTiles" RightHandVariableName="Punch.GetDistance" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="NumTiles" RightHandVariableName="TileWidth" OperationType="Divide"/>
			<ArithmethicOperation LeftHandVariableName="Interval" RightHandVariableName="LifeTime" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="Interval" RightHandVariableName="NumTiles" OperationType="Divide"/>
			<ArithmethicOperation LeftHandVariableName="Interval" RightHandVariableName="0.7" OperationType="Multiply"/>
			<ParticleSystemUpdate name="ps_Punch" onState="State.Punch"/>
		</AddClothingParticles>
		<RenderShoes>
			<SpriteRender name="s_legs" offset="1,-7" tintOverride="SKINORPANTS" />
		</RenderShoes>
		<RenderInFront>
			<ParticleSystemRender name="ps_Trail"/>
			<ParticleSystemRender name="ps_Flash"/>
		</RenderInFront>
		<RenderBehind>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
				<IsSitting>true</IsSitting>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
			<Translate>6,-8,0</Translate>
			<SpriteRender name="s_golem"/>
		</RenderBehind>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_strap" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="11,9"/>
		<Sprite name="s_robot" fileName="game/particles_large18.rttex" textureSize="64" frame="0,8"/>
		<Sprite name="s_robotPunch" fileName="game/particles_large18.rttex" textureSize="64" frame="8,9"/>
		<Sprite name="s_line" fileName="game/particles12.rttex" textureSize="32" frame="22,21"/>
		<Sprite name="s_jumpSmoke" fileName="game/mi_minbot.rttex" textureSize="64" frame="3,0"/>
		<Sprite name="s_jumpFlame" fileName="game/particles12.rttex" textureSize="32" frame="20,21"/>

		<Animations>
			<SpriteAnimation name="a_robot_idle" sprite="s_robot" isLoop="true" animTime="2600" playOnState="Movement.Idle">
				<Frame>0,8</Frame>
				<Frame>1,8</Frame>
				<Frame>2,8</Frame>
				<Frame>3,8</Frame>
				<Frame>4,8</Frame>
				<Frame>5,8</Frame>
				<Frame>6,8</Frame>
				<Frame>7,8</Frame>
				<Frame>8,8</Frame>
				<Frame>9,8</Frame>
				<Frame>10,8</Frame>
				<Frame>11,8</Frame>
				<Frame>12,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robot_move" sprite="s_robot" isLoop="true" animTime="400" playOnState="Movement.Move">
				<Frame>0,9</Frame>
				<Frame>1,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robot_jump" sprite="s_robot" isLoop="true" animTime="400" playOnState="Movement.Jump">
				<Frame>2,9</Frame>
				<Frame>3,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robot_fall" sprite="s_robot" isLoop="true" animTime="400" playOnState="Movement.Fall">
				<Frame>4,9</Frame>
				<Frame>5,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robot_slowFall" sprite="s_robot" isLoop="true" animTime="400" playOnState="Movement.SlowFall">
				<Frame>6,9</Frame>
				<Frame>7,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_robotPunch" sprite="s_robotPunch" isLoop="true" animTime="400" playOnState="Punch.Yes">
				<Frame>8,9</Frame>
				<Frame>9,9</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Movement">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="SlowFall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|SlowFall">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|SlowFall">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|SlowFall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|SlowFall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsHoldingJumpKey>false</IsHoldingJumpKey>
						</Condition>
					</Transition>
					<Transition to="SlowFall" from="Jump|Idle|Move|Fall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsHoldingJumpKey>true</IsHoldingJumpKey>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<ParticleSystems>
			<ParticleSystem name="ps_jumpSmokeL">
				<Emitter>
					<Set name="particlesPerEmission">3</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offset">-18,16</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpSmoke</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.75</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.2,0.1</Set>
					<Increment name="initialScale" source="particleIndex" multiplier="0.1,0.1"/>
					<Set name="finalScale">0.3,0.2</Set>
					<Increment name="finalScale" source="particleIndex" multiplier="0.1,0.1"/>
					<Set name="offset">0,-30</Set>
					<Increment name="worldPos" source="particleIndex" multiplier="0,8"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_jumpSmokeR">
				<Emitter>
					<Set name="particlesPerEmission">3</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offset">0,16</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpSmoke</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.75</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 50</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.2,0.1</Set>
					<Increment name="initialScale" source="particleIndex" multiplier="0.1,0.1"/>
					<Set name="finalScale">0.3,0.2</Set>
					<Increment name="finalScale" source="particleIndex" multiplier="0.1,0.1"/>
					<Set name="offset">0,-30</Set>
					<Increment name="worldPos" source="particleIndex" multiplier="0,8"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_jumpFlameR">
				<Emitter>
					<Set name="offset">0, -6</Set>
					<Random name="emissionInterval" min="0.1" max="0.2" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpFlame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.9</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">false</Set>
					<Set name="lifeTime">0.75</Set>
					<Random name="initialScale" min="0.8,0.9" max="0.9,1.1" />
					<Set name="relativeToEmitter">true</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Set name="offset" source="FacingOffset"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_jumpFlameL">
				<Emitter>
					<Set name="offset">-16, -6</Set>
					<Random name="emissionInterval" min="0.1" max="0.2" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpFlame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.9</KeyFrame>
						<KeyFrame>0.5, 0.75</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">false</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialScale" min="0.8,0.9" max="0.9,1.1" />
					<Set name="relativeToEmitter">true</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Set name="offset" source="FacingOffset"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fallFlameR">
				<Emitter>
					<Set name="offset">0, -6</Set>
					<Random name="emissionInterval" min="0.05" max="0.15" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpFlame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">false</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialScale" min="0.5,0.7" max="1,1" />
					<Set name="relativeToEmitter">true</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Set name="offset" source="FacingOffset"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fallFlameL">
				<Emitter>
					<Set name="offset">-16, -6</Set>
					<Random name="emissionInterval" min="0.05" max="0.15" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_jumpFlame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">false</Set>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialScale" min="0.5,0.7" max="1,1" />
					<Set name="relativeToEmitter">true</Set>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Set name="offset" source="FacingOffset"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<TileStampData>
			<Set name="FileName">game/particles12.rttex</Set>
			<Set name="EndFrame">27,21</Set>
			<Set name="FrameCount">4</Set>
			<Set name="Offset">0,-22</Set>
			<Set name="RenderDefaultCracks">true</Set>
		</TileStampData>

		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="IgnorePunchTypeDamagedTileCheck">true</Set>
				<Set name="IgnoreDamagedTileForPunchPos">true</Set>
			</Default>
		</RenderOptions>

		<VariableMap>
			<Set name="FacingOffset">0,0</Set>
		</VariableMap>
	</Data>

	<RenderRules>
		<RenderFrontpack>
			<SpriteRender name="s_strap" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER"/>
		</RenderFrontpack>
		<RenderBackpack>
			<Translate>1,-32,0</Translate>
			<SpriteRender name="s_robot" blend="PREMULTIPLIED_ALPHA" onState="Punch.No"/>
			<SpriteRender name="s_robotPunch" blend="PREMULTIPLIED_ALPHA" onState="Punch.Yes"/>
			<Group onState="Punch.Yes">
				<Translate>-12,-5,0</Translate>
				<SpriteRender name="s_line" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0"/>
			</Group>
		</RenderBackpack>
		<AddClothingParticles>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="FacingOffset" RightHandVariableName="-1,0" OperationType="Set" onState="Facing.Left" />
			<ArithmethicOperation LeftHandVariableName="FacingOffset" RightHandVariableName="0,0" OperationType="Set" onState="Facing.Right" />
			<ParticleSystemUpdate name="ps_jumpSmokeL" onAction="JUMPSTART|JUMPDOUBLE"/>
			<ParticleSystemUpdate name="ps_jumpSmokeR" onAction="JUMPSTART|JUMPDOUBLE"/>
			<ParticleSystemUpdate name="ps_jumpFlameL" onAction="JUMPSTART|JUMPDOUBLE"/>
			<ParticleSystemUpdate name="ps_jumpFlameR" onAction="JUMPSTART|JUMPDOUBLE"/>
			<ParticleSystemUpdate name="ps_fallFlameL" onState="Movement.SlowFall"/>
			<ParticleSystemUpdate name="ps_fallFlameR" onState="Movement.SlowFall"/>
		</AddClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_LeftL" fileName="game/player_feet16.rttex" textureSize="32" frame="26,22" />
		<Sprite name="s_LeftR" fileName="game/player_feet16.rttex" textureSize="32" frame="25,22" />
		<Sprite name="s_RightL" fileName="game/player_feet16.rttex" textureSize="32" frame="26,23" />
		<Sprite name="s_RightR" fileName="game/player_feet16.rttex" textureSize="32" frame="25,23" />
		<Sprite name="s_bubble" fileName="game/particles12.rttex" textureSize="32" frame="25,6" />
		<Sprite name="s_bubblePop" fileName="game/particles12.rttex" textureSize="32" frame="25,6" />
		<Sprite name="s_legs" fileName="game/player_sit.rttex" textureSize="32" frame="1,0" />
		<Sprite name="s_liquid" fileName="game/particles_large16.rttex" textureSize="64" frame="9,2" />
		<Animations>
			<SpriteAnimation name="a_bubble" sprite="s_bubblePop" animTime="400">
				<Frame>28,6</Frame>
				<Frame>25,6</Frame>
				<Frame>26,6</Frame>
				<Frame>27,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_liquid" sprite="s_liquid" animTime="400" autoPlay="true" isLoop="true">
				<Frame>9,2</Frame>
				<Frame>10,2</Frame>
				<Frame>11,2</Frame>
				<Frame>12,2</Frame>
			</SpriteAnimation>
		</Animations>
		<Animations />
		<ParticleSystems />
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-13</Set>
				<Set name="UserNameOffset">12</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
			</Default>
		</RenderOptions>
		<StateMachines>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Moving" />
					<State name="Other" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving|Other">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsSitting>false</IsSitting>
							<IsSleepingOnaBed>false</IsSleepingOnaBed>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle|Other">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Other" from="Idle|Moving">
						<Condition>
							<IsSitting>true</IsSitting>
							<IsSleepingOnaBed>true</IsSleepingOnaBed>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_bubbleIdle">
				<Emitter>
					<Set name="offset">0,10</Set>
					<Random name="emissionInterval" min="0.5" max="2" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_bubble</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Random name="offset" min="-20, 0" max="20, 0" />
					<Random name="initialScale" min="0.3" max="0.8" />
					<Random name="lifeTime" min="1.75" max="2.5" />
					<Random name="initialVelocity" min="-15, -20" max="15, -5" />
					<OnFinish>
						<ParticleSystemName>ps_bubblePop</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_bubbleMove">
				<Emitter>
					<Set name="offset">0,10</Set>
					<Random name="emissionInterval" min="0.25" max="0.5" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Random name="particlesPerEmission" min="2" max="5" />
				</Emitter>
				<Particle>
					<Set name="sprite">s_bubble</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Random name="offset" min="-20, 0" max="20, 0" />
					<Random name="initialScale" min="0.3" max="0.8" />
					<Random name="lifeTime" min="1.5" max="2.5" />
					<Random name="initialVelocity" min="-30, -35" max="30, -5" />
					<OnFinish>
						<ParticleSystemName>ps_bubblePop</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_bubblePop">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="infLifeTime">false</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">0</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle UseParentScale="true">
					<Set name="sprite">s_bubblePop</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 30</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<Group>
				<StopIf type="or">
					<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
					<IsRenderMod>RENDER_MOD_MANNEQUIN</IsRenderMod>
				</StopIf>
				<ParticleSystemUpdate name="ps_bubbleIdle" onState="Motion.Idle" />
				<ParticleSystemUpdate name="ps_bubbleMove" onState="Motion.Moving" />
			</Group>
			<Translate>0,13,0</Translate>
			<Group onState="Facing.Right">
				<SpriteRender name="s_LeftR" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
				<SpriteRender name="s_RightR" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />
			</Group>
			<Group onState="Facing.Left">
				<SpriteRender name="s_LeftL" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
				<SpriteRender name="s_RightL" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />
			</Group>
			<SpriteRender name="s_legs" offset="1,-20" tintOverride="SKINORPANTS" />
			
			<StopIf>
				<IsVariableBool name="onGround">false</IsVariableBool>
			</StopIf>
			<SpriteRender name="s_liquid" offset="0,0" alignment="DOWN_CENTER" />
		</RenderShoes>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_guitarIdle" fileName="game/particles12.rttex" textureSize="32" frame="18,1"/>
    <Sprite name="s_guitarPunch" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="3,7"/>
    <Sprite name="s_guitarPunchGlow" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="4,7"/>
    <Sprite name="s_strap" fileName="game/particles12.rttex" textureSize="32" frame="19,1"/>
    <Sprite name="s_shards" fileName="game/particles12.rttex" textureSize="32" frame="13,3"/>
    <Sprite name="s_mist" fileName="game/particles12.rttex" textureSize="32" frame="15,3"/>
    <Sprite name="s_mistFinish" fileName="game/particles12.rttex" textureSize="32" frame="15,3"/>
    <Sprite name="s_ember" fileName="game/particles12.rttex" textureSize="32" frame="10,3"/>
    <Sprite name="s_note" fileName="game/particles11.rttex" textureSize="32" frame="9,28"/>

    <Animations>
      <SpriteCurveAnimation name="a_guitarPunchGlow" sprite="s_guitarPunchGlow" animTime="1000" playOnState="Action.Punch|Action.Dance">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="a_strapIdle" sprite="s_strap" animTime="100" isLoop="true" playOnState="Action.None">
        <Frame>19,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_strapPunch" sprite="s_strap" animTime="100" isLoop="true" playOnState="Action.Punch">
        <Frame>20,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_strapDance" sprite="s_strap" animTime="100" isLoop="true" playOnState="Action.Dance">
        <Frame>21,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_shards" sprite="s_shards">
        <Frame>13,3</Frame>
        <Frame>14,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_mist" sprite="s_mist">
        <Frame>15,3</Frame>
        <Frame>16,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ember" sprite="s_ember">
        <Frame>10,3</Frame>
        <Frame>11,3</Frame>
        <Frame>12,3</Frame>
      </SpriteAnimation>
      <CurveAnimationFloat name="a_footExtend" isLoop="true" animTime="500" playOnState="Action.Dance">
        <Curve name="footOffset">
          <KeyFrame>0, -2</KeyFrame>
          <KeyFrame>0.5, 1</KeyFrame>
          <KeyFrame>1, -2</KeyFrame>
        </Curve>
      </CurveAnimationFloat>
      <SpriteAnimation name="a_note" sprite="s_note">
        <Frame>11,28</Frame>
        <Frame>12,28</Frame>
      </SpriteAnimation>
    </Animations>

    <VariableMap>
      <Set name="item.Rotation">340</Set>
      <Set name="footOffset">0</Set>
      <Set name="rotation">340</Set>
      <Set name="facingVariable">1,1,1</Set>
    </VariableMap>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None"/>
          <State name="Punch"/>
          <State name="Dance"/>
        </States>
        <Transitions>
          <Transition to="None" from="Punch|Dance">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">DANCE</IsAction>
              <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None|Dance">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
              <IsAction operatorType="NotEqual">DANCE</IsAction>
              <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
            </Condition>
          </Transition>
          <Transition to="Dance" from="None|Punch">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsZombified>false</IsZombified>
              <SubCondition type="or">
                <IsAction>DANCE</IsAction>
                <IsAction>DANCE_FLOSS</IsAction>
              </SubCondition>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_note" updateStage="AddClothingParticles" updateState="Action.Dance">
        <Emitter>
          <Set name="offset">0, -8</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_note</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">2.5</Set>
          <Random name="offset" min="-16, 0" max="16, 0" />
          <Random name="initialVelocity" min="0, -60" max="0, -30" />
          <Random name="initialRotationRate" min="-60" max="60" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchMist" renderStage="RenderHandItem" updateStage="AddClothingParticles" updateState="Action.Punch">
        <Emitter>
          <Set name="offset">18, -6</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle autoLifeTimeToTarget="true" randomSpriteFrame="true">
          <Set name="sprite">s_mist</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.25, 0.75</KeyFrame>
            <KeyFrame>1, 0.5</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1, 1</KeyFrame>
          </Curve>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <RandomRadial name="initialVelocity" angleRange="-5,5" radiusRange="100,150" baseAnglePosition="targetPos" baseOffset="0,16"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchShards" renderStage="RenderHandItem" updateStage="AddClothingParticles" updateState="Action.Punch">
        <Emitter>
          <Set name="offset">18, -6</Set>
          <Set name="emissionInterval">0.15</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle autoLifeTimeToTarget="true" randomSpriteFrame="true">
          <Set name="sprite">s_shards</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.5</KeyFrame>
            <KeyFrame>1, 1.5, 1</KeyFrame>
          </Curve>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <RandomRadial name="initialVelocity" angleRange="-5,5" radiusRange="100,150" baseAnglePosition="targetPos" baseOffset="0,16"/>
          <OnFinish>
            <ParticleSystemName>ps_onFinishEmber</ParticleSystemName>
            <ParticleSystemName>ps_onFinishSmoke</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchEmber" renderStage="RenderHandItem" updateStage="AddClothingParticles" updateState="Action.Punch">
        <Emitter>
          <Set name="offset">0, -6</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_ember</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="lifeTime">1</Set>
          <Random name="initialVelocity" min="-20,-20" max="20,-30"/>
          <Random name="offset" min="-5,-5" max="0,0"/>
          <Set name="gravityVector">0, 60</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_onFinishSmoke">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mistFinish</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Random name="flipX" min="true" max="false"/>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,20"/>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 10</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_onFinishEmber">
        <Emitter>
          <Set name="particlesPerEmission">5</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_ember</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,25"/>
          <Set name="gravityVector">0, 60</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <TileStampData>
      <Set name="FileName">game/particles12.rttex</Set>
      <Set name="EndFrame">19,3</Set>
      <Set name="FrameCount">3</Set>
      <Set name="RenderDefaultCracks">false</Set>
    </TileStampData>

    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="IsFacingChangeDisabled">false</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
      </Default>
      <Override overrideOnAction="DANCE">
        <Set name="IsFacingChangeDisabled">true</Set>
      </Override>
      <Override overrideOnAction="DANCE_FLOSS">
        <Set name="IsFacingChangeDisabled">true</Set>
      </Override>
    </RenderOptions>
  </Data>

  <RenderRules>
    <Update>
      <ArithmethicOperation LeftHandVariableName="rotation" RightHandVariableName="item.Rotation" OperationType="Set" />
      <ArithmethicOperation LeftHandVariableName="rotation" RightHandVariableName="facingVariable.x" OperationType="Multiply" />
      <Group onState="Action.Dance">
        <AvatarTransform class="FootPosition">
          <Set name="foot1y">footOffset</Set>
          <Set name="foot2y">footOffset</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm1Angle</Set>
          <Set name="armAngle">-90</Set>
        </AvatarTransform>
        <AvatarTransform class="ArmAngle">
          <Set name="armName">arm2Angle</Set>
          <Set name="pulseArmScale">20</Set>
          <Set name="pulseArmRate">100</Set>
          <Set name="armAngle">-40</Set>
        </AvatarTransform>
        <AvatarTransform class="Face">
          <Set name="face">MAD</Set>
        </AvatarTransform>
        <MusicSource>
          <Set name="MusicFile">audio/mp3/death_metal_radio.mp3</Set>
        </MusicSource>
      </Group>
      
    </Update>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1500</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderHandItem>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <Group onState="Action.Dance">
        <Rotate forceValue="true">rotation</Rotate>
        <SpriteRender name="s_guitarPunchGlow" offset="6,8" blend="ADDITIVE" drawShadow="false"/>
        <SpriteRender name="s_guitarPunch" offset="6,8" blend="PREMULTIPLIED_ALPHA"/>
      </Group>
      <Group onState="Action.Punch">
        <SpriteRender name="s_guitarPunchGlow" offset="4,8" blend="ADDITIVE" useFixedRotation="true" fixedRotation="0" drawShadow="false"/>
        <SpriteRender name="s_guitarPunch" offset="4,8" blend="PREMULTIPLIED_ALPHA" useFixedRotation="true" fixedRotation="0"/>
      </Group>
    </RenderHandItem>
    <RenderFrontArm>
      <SpriteRender name="s_strap" offset="1,0" alignment="DOWN_CENTER" useFixedRotation="true" fixedRotation="0"/>
    </RenderFrontArm>
    <RenderBehind value="playerCenter">
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_guitarIdle" offset="0, -16" onState="Action.None" useFixedRotation="true" fixedRotation="0"/>
      <Group>
      <StopIf>
        <IsZombified>false</IsZombified>
      </StopIf>
      <SpriteRender name="s_guitarIdle" offset="0, -16" onState="Action.None" useFixedRotation="true" fixedRotation="0" tintOverride="111,217,45,255"/>
      </Group>
      <Group>
        <StopIf>
          <IsSitting ItemID="ITEM_ID_THEATER_SEAT">false</IsSitting>
        </StopIf>
        <SpriteRender name="s_guitarIdle" offset="0, -16" onState="Action.None" useFixedRotation="true" fixedRotation="0" tintOverride="0,0,0,255"/>
      </Group>
    </RenderBehind>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
  <Data>
    <Sprite name="s_staff" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="4,10" />
    <Sprite name="s_chain" fileName="game/particles12.rttex" textureSize="32,32" frame="29,7" />
    <Sprite name="s_mist" fileName="game/particles12.rttex" textureSize="32,32" frame="28,7" />
    <Sprite name="s_punchCurve" fileName="game/particles_large16.rttex" textureSize="64" frame="15,0" />
    <Sprite name="s_hit" fileName="game/particles_large16.rttex" textureSize="64" frame="15,3" />
    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="JumpStraight" />
          <State name="JumpDiagonal" />
          <State name="FallStraight" />
          <State name="FallDiagonal" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|FallStraight|FallDiagonal|Punch">
            <Condition type="and">
              <IsAction>IDLE</IsAction>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|FallDiagonal|FallStraight|Punch">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">JUMP</IsAction>
              <IsAction operatorType="NotEqual">FALL</IsAction>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="JumpStraight" from="Idle|Walk|FallStraight|JumpDiagonal|FallDiagonal|Punch">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="JumpDiagonal" from="Idle|Walk|FallStraight|JumpStraight|FallDiagonal|Punch">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="FallStraight" from="Walk|FallDiagonal|JumpStraight|JumpDiagonal|Idle|Punch">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="FallDiagonal" from="Walk|FallStraight|JumpStraight|JumpDiagonal|Idle|Punch">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="Walk|FallStraight|JumpStraight|JumpDiagonal|Idle|FallDiagonal">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Particle">
        <States>
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="On" from="Off">
            <Condition type="and">
              <IsSitting ItemID="ITEM_ID_THEATER_SEAT">false</IsSitting>
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsVariableBool name="isMannequin">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Off" from="On">
            <Condition type="or">
              <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
              <IsSleepingOnaBed>true</IsSleepingOnaBed>
              <IsVariableBool name="isMannequin">true</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <Animations>
      <InterpolationVec4Animation name="a_idle" variableName="chain_rotation" targetValue="0, 0, 0, 1" animTime="600" playOnState="Action.Idle"/>
      <InterpolationVec4Animation name="a_walk" variableName="chain_rotation" targetValue="90, 0, 0, 1" animTime="400" playOnState="Action.Walk"/>
      <InterpolationVec4Animation name="a_fallFallStraight" variableName="chain_rotation" targetValue="180, 0, 0, 1" animTime="1000" playOnState="Action.FallStraight"/>
      <InterpolationVec4Animation name="a_fallFallDiagonal" variableName="chain_rotation" targetValue="135, 0, 0, 1" animTime="400" playOnState="Action.FallDiagonal"/>
      <InterpolationVec4Animation name="a_jumpJumpStraight" variableName="chain_rotation" targetValue="0, 0, 0, 1" animTime="1000" playOnState="Action.JumpStraight"/>
      <InterpolationVec4Animation name="a_jumpJumpDiagonal" variableName="chain_rotation" targetValue="45, 0, 0, 1" animTime="400" playOnState="Action.JumpDiagonal"/>
      <CurveAnimationVec4 name="a_punch" isLoop="true" playOnState="Action.Punch" animTime="500">
        <Curve name="chain_rotation">
          <KeyFrame>0.0, -90,0,0,1</KeyFrame>
          <KeyFrame>1, -90,0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
    </Animations>
    <VariableMap>
      <Set name="chain_rotation">0, 0, 0, 1</Set>
      <Set name="final_rotation">0, 0, 0, 1</Set>
      <Set name="Player.GetFacing">1</Set>
      <Set name="Player.BackArm.GetRotation">0, 0, 0, 1</Set>
    </VariableMap>
    <ParticleSystems>
      <ParticleSystem name="ps_maceMist" updateStage="RenderBackHandItem" updateState="Particle.On">
        <Emitter>
          <Random name="offset" min="-8,-4" max="8,8" />
          <Random name="emissionInterval" min="0.1" max="0.3" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">2.0</Set>
          <Set name="initialVelocity">0,-20</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.2" max="0.4" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
        <Emitter>
          <Set name="offset">16,-18</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="emissionInterval">0.4</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchCurve</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlash" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 1,1</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IncludeAllActions">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <Group>
        <Translate>5,3,0</Translate>
        <Rotate>180,0,0,1</Rotate>
        <SpriteRender name="s_staff" blend="NORMAL" alignment="CENTER" drawShadow="true" />
      </Group>
      <Translate>32,5,0</Translate>
      <Group onState="Action.Walk|Action.FallStraight|Action.JumpStraight|Action.JumpDiagonal|Action.Idle|Action.FallDiagonal">
        <ArithmethicOperation LeftHandVariableName="final_rotation" RightHandVariableName="chain_rotation" OperationType="Set"/>
      </Group>
      <Group onState="Action.Punch">
        <ArithmethicOperation LeftHandVariableName="final_rotation" RightHandVariableName="Player.BackArm.GetRotation" OperationType="Set"/>
        <ArithmethicOperation LeftHandVariableName="final_rotation" RightHandVariableName="chain_rotation" OperationType="Add"/>
      </Group>
      <ArithmethicOperation LeftHandVariableName="final_rotation.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
      <Rotate forceValue="true">final_rotation</Rotate>
      <SpriteRender name="s_chain" blend="NORMAL" alignment="UPPER_CENTER" drawShadow="true" />
      <Translate>0,24,0</Translate>
    </RenderBackHandItem>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="Action.Walk|Action.FallStraight|Action.JumpStraight|Action.JumpDiagonal|Action.Idle|Action.FallDiagonal">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">205</Set>
      </AvatarTransform>
    </Update>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">500</Set>
        <Set name="Curve">
          <KeyFrame>0.0, 205</KeyFrame>
          <KeyFrame>0.3, 360</KeyFrame>
          <KeyFrame>0.8, 360</KeyFrame>
          <KeyFrame>0.81, 205</KeyFrame>
          <KeyFrame>1, 205</KeyFrame>
        </Set>
      </AvatarTransform>
    </OnPunchUpdate>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_capeBack" fileName="game/particles_large14.rttex" textureSize="64"/>
    <Sprite name="s_capeFront" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="19,23" />
    <Sprite name="s_sparkle" fileName="game/particles10.rttex" textureSize="32"/>
    
    <Animations>
      <SpriteAnimation name="a_Sparkles" sprite="s_sparkle" animTime="300" autoPlay="false">
        <Frame>0,29</Frame>
        <Frame>5,29</Frame>
        <Frame>6,29</Frame>
        <Frame>4,28</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_cape" sprite="s_capeBack" animTime="1600" autoPlay="true" isLoop="true">
        <Frame>12,7</Frame>
        <Frame>13,7</Frame>
        <Frame>14,7</Frame>
        <Frame>15,7</Frame>
        <Frame>12,8</Frame>
        <Frame>13,8</Frame>
        <Frame>14,8</Frame>
        <Frame>15,8</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_SparklesTrail">
        <Emitter>
          <Set name="offset">-5,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
	      <Set name="lifeTime">0.8</Set>
          <Set name="particlesPerEmission">2</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_sparkle</Set>
          <Random name="offset" min="-8, -4" max="8, 0" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1.5</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.3" max="0.4" />
          <Select name="initialRotationRate" input="randomNumber">
	          <Item>90</Item>
	          <Item>-90</Item>
          </Select>
          <Set name="useGravity">true</Set>
          <Curve name="initialVelocity">
	          <KeyFrame>0, -30</KeyFrame>
	          <KeyFrame>0.2, -20, -30</KeyFrame>
	          <KeyFrame>0.4, 50, -30</KeyFrame>
	          <KeyFrame>0.6, -50, -30</KeyFrame>
	          <KeyFrame>0.8, 50, -30</KeyFrame>
	          <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Set name="gravityVector">0, 50</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_SparklesTrail" onState="Motion.Move"/>
    </AddClothingParticles>
    <RenderBackpack>
      <SpriteRender name="s_capeBack" offset="-16,-1" alignment="CENTER"/>
      <ParticleSystemRender name="ps_SparklesTrail"/>
    </RenderBackpack>
    <RenderFrontpack>
      <SpriteRender name="s_capeFront" offset="0,0" alignment="DOWN_CENTER"/>
    </RenderFrontpack>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="hit_Sprite_circle" fileName="game/particles_large13.rttex" textureSize="64" frame="5,9" />
		<Sprite name="hit_Sprite_spark" fileName="game/particles11.rttex" textureSize="32" frame="28,20" />
		<Sprite name="left_arm" fileName="game/particles_large13.rttex" textureSize="64" frame="3,8" />
		<Sprite name="left_arm_glow" fileName="game/particles_large13.rttex" textureSize="64" frame="3,9" />
		<Sprite name="magic_symbol" fileName="game/particles_large13.rttex" textureSize="64" frame="5,8" />
		<Sprite name="punch_continue_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="6,6" />
		<Sprite name="punch_end_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="5,6" />
		<Sprite name="punch_start_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="2,6" />
		<Sprite name="right_arm" fileName="game/particles_large13.rttex" textureSize="64" frame="4,8" />
		<Sprite name="right_arm_glow" fileName="game/particles_large13.rttex" textureSize="64" frame="4,9" />
		<Sprite name="s_armor" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="2,17" />
		<Sprite name="s_armor_glow" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="3,17" />
		<Sprite name="punch_continue_trail_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="7,6" />
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<CurveAnimationVec3 name="proxy_position_left_hover" autoPlay="t" isLoop="true" animTime="2500">
				<Curve name="proxy_position_left">
					<KeyFrame>0, -31.6, -29.15, 0</KeyFrame>
					<KeyFrame>0.5,  -31.6, -39.15, 0</KeyFrame>
					<KeyFrame>1, -31.6, -29.15, 0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationVec3 name="proxy_position_right_hover" autoPlay="t" isLoop="true" animTime="2500">
				<Curve name="proxy_position_right">
					<KeyFrame>0, 31.6, -29.15, 0</KeyFrame>
					<KeyFrame>0.5, 31.6, -39.15, 0</KeyFrame>
					<KeyFrame>1, 31.6, -29.15, 0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<SpriteCurveAnimation name="s_armor_glowing" isLoop="true" autoPlay="true" sprite="s_armor_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="left_arm_glow_anim" isLoop="true" autoPlay="true" sprite="left_arm_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="right_arm_glow_anim" isLoop="true" autoPlay="true" sprite="right_arm_glow" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="magic_symbol_rotation_anim" autoPlay="true" isLoop="true" useFacing="RIGHT" sprite="magic_symbol" animTime="5000">
				<Curve name="rotation">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 360</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="hit_Sprites" sprite="hit_Sprite_spark">
				<Frame>28,20</Frame>
				<Frame>29,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="punch_continue" sprite="punch_continue_sprite" animTime="200" isLoop="true" playOnAction="PUNCH">
				<Frame>6,6</Frame>
				<Frame>7,6</Frame>
				<Frame>6,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="punch_end" sprite="punch_end_sprite" animTime="272" playOnAction="IDLE">
				<Frame>5,6</Frame>
				<Frame>4,6</Frame>
				<Frame>3,6</Frame>
				<Frame>2,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="punch_start" sprite="punch_start_sprite" animTime="200" playOnAction="PUNCH">
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				<Frame>4,6</Frame>
				<Frame>5,6</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">false</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="armor_position">0, -14.85, 0</Set>
			<Set name="magic_position_left">-9.600, -4.150, 0</Set>
			<Set name="magic_position_right">-9.950, -4.150, 0</Set>
			<Set name="proxy_position_left">-31.6, -29.15, 0</Set>
			<Set name="proxy_position_right">31.6, -29.15, 0</Set>
			<Set name="arm_magic_left">-8.75, -12.45, 0</Set>
			<Set name="arm_magic_right">8, -12.45, 0</Set>
		</VariableMap>
		<ParticleSystems>
			<ParticleSystem name="hit_particle_circle">
				<Emitter>
					<Set name="offset">0, -8</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">10</Set>
					<Set name="delayTimer">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">hit_Sprite_circle</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="initialAlpha">0.5</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.7, 0.7</Set>
					<Set name="finalScale">1.5, 1.5</Set>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle_spark">
				<Emitter>
					<Set name="offset">0, -8</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="emissionInterval">0.6</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite_spark</Set>
					<RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="80,200"/>
					<Set name="gravityVector">0, 100</Set>
					<Set name="useGravity">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="initialRotationRate" min="5" max="15"/>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialScale">1, 1</Set>
					<Set name="finalScale">0.25, 0.25</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="posOffset" min="0, 0.1" max="16,16.1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_continue_particle">
				<Emitter attachment="targetPos">
					<Set name="offset">-4, 12</Set>
					<Set name="lifeTime">0</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.24</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_continue_sprite</Set>
					<Set name="offset">0, 0</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_continue_particle_trial">
				<Emitter attachment="targetPos">
					<Set name="offset">-4, 12</Set>
					<Set name="lifeTime">0</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">16</Set>
					<Set name="delayTimer">0.3</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_continue_trail_sprite</Set>
					<Set name="offset">0, 0</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_end_particle">
				<Emitter attachment="targetPos">
					<Set name="offset">-4, 12</Set>
					<Set name="lifeTime">0</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_end_sprite</Set>
					<Set name="offset">0, 0</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.15</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_start_particle">
				<Emitter attachment="targetPos">
					<Set name="offset">-4, 12</Set>
					<Set name="lifeTime">0</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_start_sprite</Set>
					<Set name="offset">0, 0</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.2</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<ParticleSystemUpdate name="punch_continue_particle_trial" onAction="PUNCH"/>
		</OnPunchUpdate>
		<RenderSittingInTheater>
			<Group>
				<Translate>arm_magic_right</Translate>
				<Scale>0.15,0.15,0</Scale>
				<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
			</Group>
			<Group>
				<Translate>0,5,0</Translate>
				<Translate>proxy_position_right</Translate>
				<Group>
					<Translate>magic_position_right</Translate>
					<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
				</Group>
				<SpriteRender name="right_arm" flip="-1,0" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
				<SpriteRender name="right_arm_glow" flip="-1,0" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
			</Group>
		</RenderSittingInTheater>
		<Update>
			<ParticleSystemUpdate name="punch_continue_particle" onAction="PUNCH" />
		</Update>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group>
				<Translate>arm_magic_right</Translate>
				<Scale>0.15,0.15,0</Scale>
				<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
			</Group>
			<Group>
				<Translate>proxy_position_right</Translate>
				<Group>
					<Translate>magic_position_right</Translate>
					<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
				</Group>
				<SpriteRender name="right_arm" flip="-1,0" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
				<SpriteRender name="right_arm_glow" flip="-1,0" blend="PREMULTIPLIED_ALPHA" onState="Action.None" />
			</Group>
		</RenderBehind>
		<OnPunchBegin>
			<ParticleSystemOff name="punch_continue_particle_trial" />
			<ParticleSystemOff name="punch_continue_particle" />
			<ParticleSystemOff name="punch_end_particle" />
			<ParticleSystemUpdate name="punch_start_particle" />
		</OnPunchBegin>
		<OnPunchStop>
			<ParticleSystemOff name="punch_continue_particle_trial" />
			<ParticleSystemOff name="punch_continue_particle" />
			<ParticleSystemOff name="punch_start_particle" />
			<ParticleSystemUpdate name="punch_end_particle" />
		</OnPunchStop>
		<RenderInFront>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group>
				<Translate>arm_magic_left</Translate>
				<Scale>0.15,0.15,0</Scale>
				<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
			</Group>
			<Group>
				<Translate>proxy_position_left</Translate>
				<Group>
					<Translate>magic_position_left</Translate>
					<SpriteRender name="magic_symbol" flip="-1,0" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
				</Group>
				<SpriteRender name="left_arm" flip="-1,0" blend="PREMULTIPLIED_ALPHA" />
				<SpriteRender name="left_arm_glow" flip="-1,0" blend="PREMULTIPLIED_ALPHA" />
			</Group>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="punch_start_particle" />
			<ParticleSystemRender name="punch_continue_particle_trial" onAction="PUNCH"/>
			<ParticleSystemRender name="punch_continue_particle" onAction="PUNCH"/>
			<ParticleSystemRender name="punch_end_particle" onState="Action.None" />
			<ParticleSystemRender name="hit_particle_circle" />
			<ParticleSystemRender name="hit_particle_spark" />
		</RenderInFront>
		<RenderShirt>
			<Group>
				<Translate>armor_position</Translate>
				<SpriteRender name="s_armor" blend="PREMULTIPLIED_ALPHA" />
				<SpriteRender name="s_armor_glow" blend="PREMULTIPLIED_ALPHA" />
			</Group>
		</RenderShirt>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_particle_spark" />
			<ParticleSystemUpdate name="hit_particle_circle" />
		</OnDamagedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="punch_start_particle" />
			<ParticleSystemOff name="punch_continue_particle_trial" />
			<ParticleSystemOff name="punch_continue_particle" />
			<ParticleSystemOff name="punch_end_particle" />
			<ParticleSystemOff name="hit_particle_circle" />
			<ParticleSystemOff name="hit_particle_spark" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_clouds" fileName="game/particles12.rttex" textureSize="32" frame="30,15" />
		<Sprite name="s_clouds2" fileName="game/particles12.rttex" textureSize="32" frame="31,15" />
		<Sprite name="s_pants" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="12, 8" />
		<Sprite name="s_door" fileName="game/particles_large17.rttex" textureSize="64" frame="7, 14" />
		<Sprite name="s_door_glow" fileName="game/particles_large17.rttex" textureSize="64" frame="11, 14" />

		<Sprite name="particle_slash" fileName="game/particles12.rttex" textureSize="32" frame="28,21"/>
		<Sprite name="particle_punch_trail" fileName="game/particles12.rttex" textureSize="32" frame="29,21"/>

		<Animations>
			<SpriteAnimation name="a_particle_punch_trail" sprite="particle_punch_trail">
				<Frame>29, 21</Frame>
				<Frame>30, 21</Frame>
				<Frame>31, 21</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_clouds" sprite="s_clouds" animTime="200">
				<Frame>30, 15</Frame>
				<Frame>31, 15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_clouds2" sprite="s_clouds2" animTime="200">
				<Frame>30, 15</Frame>
				<Frame>31, 15</Frame>
			</SpriteAnimation>

			<InterpolationFloatAnimation name="door_glow_punch_inter" variableName="door_alpha_var" playOnState="Punch.Start|Punch.Punching|Punch.PunchStop" targetVariableName="door_alpha_max" animTime="50"/>

			<SpriteAnimation name="s_door_on_punch_start" sprite="s_door" animTime="200" playOnState="Punch.Start">
				<Frame>12, 14</Frame>
				<Frame>13, 14</Frame>
				<Frame>14, 14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_door_on_punch_continue" sprite="s_door" animTime="50" playOnState="Punch.Punching">
				<Frame>15, 14</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_door_on_punch_end" sprite="s_door" animTime="200" playOnState="Punch.PunchStop">
				<Frame>14, 14</Frame>
				<Frame>13, 14</Frame>
				<Frame>12, 14</Frame>
			</SpriteAnimation>			
			
			<SpriteAnimation name="s_door_on_punch_idle" sprite="s_door" animTime="600" playOnState="Punch.No">
				<Frame>7, 14</Frame>
				<Frame>8, 14</Frame>
				<Frame>9, 14</Frame>
				<Frame>10, 14</Frame>
			</SpriteAnimation>

			<CurveAnimationVec3 name="door_hover" autoPlay="t" isLoop="true" animTime="1250">
				<Curve name="door_hover_position">
					<KeyFrame>0, -13, -3.5, 0</KeyFrame>
					<KeyFrame>0.5, -13, 1, 0</KeyFrame>
					<KeyFrame>1, -13, -3.5, 0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
		</Animations>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Start" ExitTime="0.21"/>
					<State name="Punching" />
					<State name="PunchStop" ExitTime="0.21"/>
				</States>
				<Transitions>
					<Transition to="No" from="PunchStop"/>
					<Transition to="Start" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punching" from="Start"/>
					<Transition to="PunchStop" from="Punching">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Glow">
				<States>
					<State name="Increase"/>
					<State name="Decrease"/>
				</States>
				<Transitions>
					<Transition to="Increase" from="Decrease">
						<Condition>
							<CompareCustomVariable operatorType="Less" VariableNameToCompare="door_alpha_var" RightHSVariableNameToCompare="door_alpha_delta">0.001</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="Decrease" from="Increase">
						<Condition>
							<CompareCustomVariable operatorType="Greater" VariableNameToCompare="door_alpha_var">1.05</CompareCustomVariable>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">16</Set>
					<Set name="emissionInterval">0.035</Set>
					<Set name="checkParticleNumToEmit">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="-4, -2" max="4, 2" />
					<Set name="sprite">particle_punch_trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5" max="1" />
					<Set name="lifeTime">0.3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="slash_particle"  secondary="trail_particle">
				<Emitter>
					<Set name="offset">-13, -18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offsetFacing">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">particle_slash</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Select name="initialAngle" input="punchCount">
						<Item>30</Item>
						<Item>0</Item>
						<Item>-30</Item>
					</Select>
					<Select name="finalAngle" input="punchCount">
						<Item>-30</Item>
						<Item>0</Item>
						<Item>30</Item>
					</Select>
					<Select name="finalAlpha" input="punchCount">
						<Item>1.05f</Item>
						<Item>1.f</Item>
						<Item>1.05f</Item>
					</Select>
					<Set name="lifeTime">0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="finalAlpha" angle="initialAngle" />
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="finalAlpha" angle="finalAngle" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_left_cloud">
				<Emitter>
					<Set name="offset">0, -24</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Random name="emissionInterval" min="2" max="5" />
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="-14, -20" max="-7, 20" />
					<Set name="sprite">s_clouds</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="lifeTime" min="2" max="4"/>
					<Random name="initialScale" min="0.75" max="1"/>
					<Random name="initialVelocity" min="-7,0" max="-5,0"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 0.9</KeyFrame>
						<KeyFrame>0.7, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_right_cloud">
				<Emitter>
					<Set name="offset">0, -24</Set>
					<Set name="enable">true</Set>
					<Set name="offsetFacing">false</Set>
					<Random name="emissionInterval" min="3" max="4" />
					<Set name="useCharacterPos">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="7, -8" max="14, 16" />
					<Set name="sprite">s_clouds2</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="lifeTime" min="2" max="4"/>
					<Random name="initialScale" min="0.75" max="1"/>
					<Random name="initialVelocity" min="5,0" max="8,0"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 0.9</KeyFrame>
						<KeyFrame>0.7, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<VariableMap>
			<Set name="DeltaTime">0</Set>
			<Set name="door_hover_position">-13, -16, 0</Set>
			<Set name="door_alpha_var">1</Set>
			<Set name="door_alpha_min">0</Set>
			<Set name="door_alpha_max">1</Set>

			<Set name="door_alpha_speed">0.333</Set>
			<Set name="door_alpha_delta">0</Set>
		</VariableMap>
	</Data>
	<RenderRules>
		<OnPunchStart>
			<Translate>door_hover_position</Translate>
			<ParticleSystemUpdate name="slash_particle"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderPants>
			<SpriteRender name="s_pants" alignment="DOWN_CENTER" />
		</RenderPants>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsZombified>true</IsZombified>
			</StopIf>
			<Translate>door_hover_position</Translate>
			<Group>
				<Alpha>door_alpha_var</Alpha>
				<SpriteRender name="s_door_glow" alignment="DOWN_CENTER" drawShadow="false"/>
			</Group>

			<SpriteRender name="s_door" alignment="DOWN_CENTER"/>

			<ParticleSystemRender name="slash_particle" />
			<ParticleSystemRender name="ps_left_cloud" />
			<ParticleSystemRender name="ps_right_cloud" />

			<Group onState="Punch.No">
        <StopIf type="or">
          <IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
          <IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
          <IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
          <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
          <IsRenderMod>RENDER_MOD_MANNEQUIN</IsRenderMod>
        </StopIf>
				<ArithmethicOperation
					LeftHandVariableName="door_alpha_delta"
					RightHandVariableName="door_alpha_speed"
					OperationType="Set" />
				<ArithmethicOperation
					LeftHandVariableName="door_alpha_delta"
					RightHandVariableName="DeltaTime"
					OperationType="Multiply" />

				<ArithmethicOperation
					LeftHandVariableName="door_alpha_var"
					RightHandVariableName="door_alpha_delta"
					OperationType="Add"
					onState="Glow.Increase" />

				<ArithmethicOperation
					LeftHandVariableName="door_alpha_var"
					RightHandVariableName="door_alpha_delta"
					OperationType="Substract"
					onState="Glow.Decrease" />
			</Group>

		</RenderBehind>

		<AddClothingParticles>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Translate>door_hover_position</Translate>
			<ParticleSystemUpdate name="ps_left_cloud"/>
			<ParticleSystemUpdate name="ps_right_cloud"/>
		</AddClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_ROYAL_AUGMENTED_WINGS">
  <Data>
    <Sprite name="s_WingFront" fileName="game/particles_large14.rttex" textureSize="64" frame="0,11"/>
    <Sprite name="s_WingFrontGlow" fileName="game/particles_large14.rttex" textureSize="64" frame="1,11"/>
    <Sprite name="s_WingBack" fileName="game/particles_large14.rttex" textureSize="64" frame="0,12"/>
    <Sprite name="s_WingBackGlow" fileName="game/particles_large14.rttex" textureSize="64" frame="1,12"/>

    <StateMachines>
      <StateMachine name="Movement">
        <States>
          <State name="Idle"/>
          <State name="Walk"/>
          <State name="Jump"/>
          <State name="Fall"/>
          <State name="FallToGround"/>
          <State name="GroundToFall"/>
        </States>
        <Transitions>
          <Transition from="Idle|Jump" to="Walk">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Walk|Jump" to="Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Walk|Idle|Fall|FallToGround" to="Jump">
            <Condition type="and">
              <IsAction>JUMP</IsAction>
            </Condition>
          </Transition>
          <Transition from="Jump|FallToGround" to="Fall">
            <Condition type="and">
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Walk|Idle" to="GroundToFall">
            <Condition type="and">
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="GroundToFall" to="Fall">
            <Condition type="and">
              <IsAction>FALL</IsAction>
              <IsAnimationFinished>a_BackGroundToFall</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="Fall" to="FallToGround">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="FallToGround" to="Walk">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsAnimationFinished>a_BackFallToGround</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="FallToGround" to="Idle">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsAnimationFinished>a_BackFallToGround</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="GroundToFall" to="FallToGround">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsAnimationFinished>a_BackGroundToFall</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_FrontWalk" sprite="s_WingFront" animTime="500" isLoop="true" playOnState="Movement.Walk">
        <Frame>2,11</Frame>
        <Frame>3,11</Frame>
        <Frame>4,11</Frame>
        <Frame>5,11</Frame>
        <Frame>6,11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_BackFall" sprite="s_WingBack" animTime="100" isLoop="true" playOnState="Movement.Fall">
        <Frame>10,11</Frame>
      </SpriteAnimation>
      <SequenceAnimation name="a_BackJump" playOnState="Movement.Jump">
        <SpriteAnimation name="a_BackJump1" sprite="s_WingBack" animTime="200">
          <Frame>7,11</Frame>
          <Frame>9,11</Frame>
          <Frame>7,11</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_BackJump2" sprite="s_WingBack" animTime="200">
          <Frame>7,11</Frame>
          <Frame>8,11</Frame>
          <Frame>9,11</Frame>
          <Frame>10,11</Frame>
        </SpriteAnimation>
      </SequenceAnimation>
      <SpriteAnimation name="a_BackFallToGround" sprite="s_WingBack" animTime="150" playOnState="Movement.FallToGround">
        <Frame>9,11</Frame>
        <Frame>8,11</Frame>
        <Frame>7,11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_BackGroundToFall" sprite="s_WingBack" animTime="150" playOnState="Movement.GroundToFall">
        <Frame>7,11</Frame>
        <Frame>8,11</Frame>
        <Frame>9,11</Frame>
        <Frame>10,11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_BackWalk" sprite="s_WingBack" animTime="500" isLoop="true" playOnState="Movement.Walk">
        <Frame>2,12</Frame>
        <Frame>3,12</Frame>
        <Frame>4,12</Frame>
        <Frame>5,12</Frame>
        <Frame>6,12</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_wingBackGlow" isLoop="true" playOnState="Movement.Idle" sprite="s_WingBackGlow" animTime="5000">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>0.2f, 0.f </KeyFrame>
          <KeyFrame>0.8f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_wingFrontGlow" isLoop="true" playOnState="Movement.Idle" sprite="s_WingFrontGlow" animTime="5000">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>0.2f, 0.f </KeyFrame>
          <KeyFrame>0.8f, 0.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>

      <SpriteAnimation name="a_backIdle" sprite="s_WingBack" animTime="100" playOnState="Movement.Idle">
        <Frame>0,12</Frame>
      </SpriteAnimation>

      <SpriteAnimation name="a_frontIdle" sprite="s_WingFront" animTime="100" playOnState="Movement.Idle">
        <Frame>0,11</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="EnableBobbingOffset">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <Update>
      <StopIf  type="or">
        <IsZombified>true</IsZombified>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <AvatarTransform class="FootPosition" onState="Movement.Walk|Movement.Idle">
        <Set name="foot1dy">0</Set>
        <Set name="foot2dy">0</Set>
        <Set name="foot1y">0</Set>
        <Set name="foot2y">0</Set>
      </AvatarTransform>
    </Update>

    <RenderBackpack>
      <StopIf>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_WingBack" offset="23,-17" blend="PREMULTIPLIED_ALPHA" onState="Movement.Walk|Movement.Idle"/>

      <SpriteRender name="s_WingBack" offset="0,-17" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"  onState="Movement.Jump|Movement.Fall|Movement.GroundToFall"/>
      <SpriteRender name="s_WingBack" offset="0,-17" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"  onState="Movement.Jump|Movement.Fall|Movement.FallToGround|Movement.GroundToFall"/>

      <SpriteRender name="s_WingBackGlow" offset="23,-17" blend="PREMULTIPLIED_ALPHA" drawShadow="false" onState="Movement.Idle"/>
    </RenderBackpack>
    <RenderInFront>
      <StopIf>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_WingFront" offset="-21,-16" blend="PREMULTIPLIED_ALPHA"  onState="Movement.Walk|Movement.Idle"/>
      <SpriteRender name="s_WingFrontGlow" offset="-21,-16" blend="PREMULTIPLIED_ALPHA" drawShadow="false"  onState="Movement.Idle"/>
      <SpriteRender name="s_WingBack" offset="0,-17" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" onState="Movement.FallToGround"/>
      <StopIf>
        <IsZombified>false</IsZombified>
      </StopIf>
      <SpriteRender name="s_WingFront" offset="-21,-16" blend="PREMULTIPLIED_ALPHA"  onState="Movement.Walk|Movement.Idle" tintOverride="111,217,45,255"/>
      <SpriteRender name="s_WingFrontGlow" offset="-21,-16" blend="PREMULTIPLIED_ALPHA"  onState="Movement.Idle" drawShadow="false" tintOverride="111,217,45,255"/>
      <SpriteRender name="s_WingBack" offset="0,-17" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" onState="Movement.FallToGround" tintOverride="111,217,45,255"/>
    </RenderInFront>
  </RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="s_front" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="17,1" />
        <Sprite name="s_back" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="18,1" />
        <Sprite name="s_exhaust" fileName="game/particles12.rttex" textureSize="32,32" frame="29,6" />
        <Animations />
        <ParticleSystems>
            <ParticleSystem name="ps_exhaust1">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0.01</Set>
                    <Set name="offset">-14,-4</Set>
                    <Set name="emissionInterval">0.08</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="renderAlignment">CENTER</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,0.5</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Set name="initialAngle">0</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="initalRGB">1,0.02,0.008</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="flipX">true</Set>
                    <Set name="flipY">false</Set>
                    <Random name="lifeTime" min="0.3" max="0.4" />
                    <Set name="relativeToEmitter">false</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Random name="initialScale" min="1.5,0.9" max="4,1.1" />
                    <Set name="sprite">s_exhaust</Set>
                    <Set name="initialVelocity" source="exhaust.vel"/>
                </Particle>
            </ParticleSystem>
			<ParticleSystem name="ps_exhaust2">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0.01</Set>
                    <Set name="offset">-6,-4</Set>
                    <Set name="emissionInterval">0.08</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="renderAlignment">CENTER</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,0.5</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Set name="initialAngle">0</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="initalRGB">1,0.02,0.008</Set>
                    <Set name="inSpecificOrder">true</Set>
                    <Set name="flipX">true</Set>
                    <Set name="flipY">false</Set>
                    <Random name="lifeTime" min="0.3" max="0.4" />
                    <Set name="relativeToEmitter">false</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Random name="initialScale" min="1.5,0.9" max="4,1.1" />
                    <Set name="sprite">s_exhaust</Set>
                    <Set name="initialVelocity" source="exhaust.vel"/>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>
		<VariableMap>
			<Set name="exhaust.vel">0, 0</Set>
		</VariableMap>
		<StateMachines>
			<StateMachine name="Idle">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
    </Data>
    <RenderRules>
        <RenderChestItem>
			<Translate>0,-1,0</Translate>
            <SpriteRender name="s_front" alignment="DOWN_CENTER" drawShadow="true" />
        </RenderChestItem>
        <RenderChestBackItem>
			<Translate>2,-1,0</Translate>
            <ParticleSystemRender name="ps_exhaust1" />
			<ParticleSystemRender name="ps_exhaust2" />
            <SpriteRender name="s_back" alignment="DOWN_CENTER" drawShadow="true" />
        </RenderChestBackItem>
        <AddClothingParticles>
			<Group onState="Idle.No">
				<ArithmethicOperation LeftHandVariableName="exhaust.vel" RightHandVariableName="-50,60" OperationType="Set"/>
				<ArithmethicOperation LeftHandVariableName="exhaust.vel.x" RightHandVariableName="-1" OperationType="Multiply" onState="Facing.Left"/>
				<ParticleSystemUpdate name="ps_exhaust1" />
				<ParticleSystemUpdate name="ps_exhaust2" />
			</Group>
        </AddClothingParticles>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_backClaw" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="1,11"/>
    <Sprite name="s_frontClaw" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="0,11"/>
    <Sprite name="s_lightning" fileName="game/particles_large18.rttex" textureSize="64" frame="0,15"/>
    <Sprite name="s_aura" fileName="game/particles_large18.rttex" textureSize="64" frame="10,15"/>
    <Sprite name="s_speed_lines" fileName="game/particles12.rttex" textureSize="32" frame="8,23"/>
    <Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32,32" frame="2,23" />
    <Sprite name="s_chunks" fileName="game/particles12.rttex" textureSize="32,32" frame="5,23" />

    <Animations>

      <SpriteAnimation name="a_lightning" autoPlay="true" sprite="s_lightning" animTime="1000" isLoop="true">
        <Frame>0,15</Frame>
        <Frame>1,15</Frame>
        <Frame>2,15</Frame>
        <Frame>3,15</Frame>
        <Frame>4,15</Frame>
        <Frame>5,15</Frame>
        <Frame>6,15</Frame>
        <Frame>7,15</Frame>
        <Frame>8,15</Frame>
        <Frame>9,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_speed_lines" autoPlay="false" sprite="s_speed_lines">
        <Frame>8,23</Frame>
        <Frame>9,23</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_slash" autoPlay="false" sprite="s_slash">
        <Frame>2,23</Frame>
        <Frame>3,23</Frame>
        <Frame>4,23</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_chunks" autoPlay="false" sprite="s_chunks">
        <Frame>5,23</Frame>
        <Frame>6,23</Frame>
        <Frame>7,23</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_Aura" updateStage="AddClothingParticles" renderStage="RenderHandItem">
        <Emitter>
          <Set name="offset">0, -12</Set>
          <Set name="emissionInterval">0.15</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_aura</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-3, 3" max="0, 0" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.4, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 1, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <Set name="initialVelocity">0, -100</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_SpeedLines" updateStage="AddClothingParticles" renderStage="RenderHandItem">
        <Emitter>
          <Set name="offset">0, -10</Set>
          <Set name="offsetFacing">false</Set>
          <Random name="emissionInterval" min="0.15" max="0.25" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle  randomSpriteFrame="true">
          <Set name="sprite">s_speed_lines</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Random name="offset" min="-8, 0" max="8, 0" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 1,2</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <Random name="initialVelocity" min="0, -50" max="0, -80" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_slash" updateStage="OnPunchUpdate">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="lifeTime">0.3</Set>
          <Set name="sprite">s_slash</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Random name="offset" min="-8,-8" max="8,8"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tile_fx">
        <Emitter>
          <Set name="lifeTime">2</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="offset">0,0</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_chunks</Set>
          <RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200"/>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <Set name="initialScale">1,1</Set>
          <Random name="finalScale" min="0.1" max="0.4"/>
          <Set name="interpolateScale">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360"/>
          <Random name="offset" min="0,0" max="16,16"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, 360</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 180</KeyFrame>
          <KeyFrame>1, 540</KeyFrame>
        </Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <Update type="or">
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <StopIf>
        <IsAction>PUNCH</IsAction>
        <IsVariableBool name="onGround">false</IsVariableBool>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">45</Set>
      </AvatarTransform>
      <StopIf type="or">
        <IsAction>BUILD</IsAction>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
    </Update>
    <RenderHandItem>
      <SpriteRender name="s_frontClaw" offset="0,1" rotateOffset="true" rotationPoint="0,1" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" drawShadow="true" />
    </RenderHandItem>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_backClaw" offset="-4,6" rotateOffset="true" rotationPoint="1,1" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" drawShadow="true" />
    </RenderBackHandItem>
    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <SpriteRender name="s_lightning" alignment="DOWN_CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA"/>
    </RenderInFront>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_tile_fx"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_tile_fx"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_cape" fileName="game/particles_large15.rttex" textureSize="64" frame="0,14" />
    <Sprite name="s_doubleJumpDownCloud" fileName="game/particles10.rttex" textureSize="32" frame="6,8" />
    <Sprite name="s_doubleJumpLines" fileName="game/particles10.rttex" textureSize="32" frame="4,8" />
    <Sprite name="s_doubleJumpSideCloud" fileName="game/particles10.rttex" textureSize="32" frame="5,8" />
    <Sprite name="s_medal" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="7,29" />
    <Sprite name="s_medalFlipped" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="8,29" />
    <Sprite name="s_pet" fileName="game/pets/p_cb_royal.rttex" textureSize="32" frame="0,0" />
    <Sprite name="s_punch_laser" fileName="game/particles12.rttex" textureSize="32" frame="20,0" />
    <Sprite name="s_punch_plasma" fileName="game/particles12.rttex" textureSize="32" frame="22,0" />
    <Sprite name="s_tileHit" fileName="game/particles4.rttex" textureSize="32" frame="2,0" />
    <VariableMap>
      <Set name="PetFlyWalk.IsWalking">false</Set>
      <Set name="PetFlyWalk.IsFlying">false</Set>
      <Set name="PetFlyWalk.IsLanding">true</Set>
      <Set name="PetFlyWalk.IsPunching">false</Set>
      <Set name="PetFlyWalk.IsTakeoff">false</Set>
      <Set name="PunchDelay">1.0</Set>
      <Set name="DeltaTime">0.0</Set>
    </VariableMap>
    <Animations>
      <SpriteCurveAnimation name="plasma_anim" sprite="s_punch_plasma" animTime="500" isLoop="true" playOnState="Pet.IdleShoot|Pet.FlyingShoot">
        <Curve name="scale">
          <KeyFrame>0.f, 0.1f, 0.75f</KeyFrame>
          <KeyFrame>0.5f, 0.75f, 0.5f</KeyFrame>
          <KeyFrame>1.f, 1.25f, 0.75f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="a_PetFly" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.Fly">
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetFlyingShoot" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.FlyingShoot">
        <Frame>4,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetIdle" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.Idle">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetIdleShoot" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.IdleShoot">
        <Frame>0,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetLand" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.Land">
        <Frame>7,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetTakeoff" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.TakeOff">
        <Frame>6,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetWalk" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.Walk">
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_capeFall" sprite="s_cape" animTime="200" isLoop="true" playOnState="Motion.Fall">
        <Frame>6,15</Frame>
        <Frame>7,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_capeIdle" sprite="s_cape" animTime="700" isLoop="true" playOnState="Motion.Idle">
        <Frame>0,14</Frame>
        <Frame>1,14</Frame>
        <Frame>2,14</Frame>
        <Frame>3,14</Frame>
        <Frame>4,14</Frame>
        <Frame>5,14</Frame>
        <Frame>6,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_capeJump" sprite="s_cape" animTime="200" isLoop="true" playOnState="Motion.Jump">
        <Frame>4,15</Frame>
        <Frame>5,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_capeMove" sprite="s_cape" animTime="800" isLoop="true" playOnState="Motion.Move">
        <Frame>7,14</Frame>
        <Frame>8,14</Frame>
        <Frame>9,14</Frame>
        <Frame>10,14</Frame>
        <Frame>11,14</Frame>
        <Frame>12,14</Frame>
        <Frame>13,14</Frame>
        <Frame>14,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="punch_laser_Sprites" sprite="s_punch_laser" animTime="200" isLoop="true" playOnState="Pet.FlyingShoot|Pet.IdleShoot">
        <Frame>20,0</Frame>
        <Frame>21,0</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Pet">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="IdleShoot" />
          <State name="TakeOff" />
          <State name="Fly" />
          <State name="FlyingShoot" />
          <State name="Land" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|Land|FlyingShoot|IdleShoot">
            <Condition type="and">
              <CompareCustomVariable operatorType="Less" VariableNameToCompare="PunchDelay">0.0</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsWalking">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|Land">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsWalking">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="IdleShoot" from="Idle|Walk|FlyingShoot">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="FlyingShoot" from="Fly|Land|IdleShoot|TakeOff">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">true</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="TakeOff" from="Walk|Idle|Land">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsLanding">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsTakeoff">true</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Fly" from="TakeOff|FlyingShoot|IdleShoot">
            <Condition type="and">
              <CompareCustomVariable operatorType="Less" VariableNameToCompare="PunchDelay">0.0</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsLanding">false</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsTakeoff">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="Land" from="Fly|Walk|Idle">
            <Condition type="and">
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsFlying">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsLanding">true</CompareCustomVariable>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="PetPunch">
        <States>
          <State name="True" />
          <State name="False" />
        </States>
        <Transitions>
          <Transition to="True" from="False">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">true</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="False" from="True">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="PetFlyWalk.IsPunching">false</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Move|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Jump|Fall|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_doubleJumpCoulds">
        <Emitter>
          <Set name="lifeTime">1.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">3</Set>
        </Emitter>
        <Particle>
          <Select name="sprite" input="particleIndex">
            <Item>"s_doubleJumpSideCloud"</Item>
            <Item>"s_doubleJumpSideCloud"</Item>
            <Item>"s_doubleJumpDownCloud"</Item>
          </Select>
          <Select name="offset" input="particleIndex">
            <Item>0, 0</Item>
            <Item>0, 0</Item>
            <Item>0, -10</Item>
          </Select>
          <Set name="interpolateVelocity">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 2, 2</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <Select name="initialVelocity" input="particleIndex">
            <Item>-40, 0</Item>
            <Item>40, 0</Item>
            <Item>0, 40</Item>
          </Select>
          <Set name="finalVelocity">0, 0</Set>
          <Select name="flipX" input="particleIndex">
            <Item>false</Item>
            <Item>true</Item>
            <Item>false</Item>
          </Select>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_doubleJumpLines">
        <Emitter>
          <Set name="lifeTime">1.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_doubleJumpLines</Set>
          <Set name="renderAlignment">DOWN_CENTER</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1.6</KeyFrame>
            <KeyFrame>1, 1, 2.2</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialVelocity">0, 60</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tileHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <Random name="initialAngle" min="0" max="360" />
          <Set name="initialRotationRate">360</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="DefaultPunchSound">audio/laser.wav</Set>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-36,0</Set>
        <Set name="UsePetForceFaceTime">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <Update>

      <ArithmethicOperation LeftHandVariableName="PunchDelay" RightHandVariableName="DeltaTime" OperationType="Substract"/>

      <StopIf>
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsVariableBool name="isMannequin">true</IsVariableBool>
        <IsVariableBool name="isBattleLeash">true</IsVariableBool>
      </StopIf>
      <AvatarTransform class="Face" onState="PetPunch.True">
        <Set name="face">NORMAL</Set>
      </AvatarTransform>
      <AvatarTransform class="FootPosition" onState="Motion.Idle|Motion.Move">
        <Set name="foot1dy">0</Set>
        <Set name="foot2dy">0</Set>
        <Set name="foot1y">0</Set>
        <Set name="foot2y">0</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Move">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">225</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Move">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">225</Set>
      </AvatarTransform>
    </Update>
    <OnPunchStart>
      <ArithmethicOperation LeftHandVariableName="PunchDelay" RightHandVariableName="1.0" OperationType="Set"/>
    </OnPunchStart>
    <RenderFrontpack>
      <Group>
        <StopIf>
          <IsFacingLeft>false</IsFacingLeft>
        </StopIf>
        <SpriteRender name="s_medalFlipped" offset="0,0" alignment="DOWN_CENTER" />
      </Group>
      <Group>
        <StopIf>
          <IsFacingLeft>true</IsFacingLeft>
        </StopIf>
        <SpriteRender name="s_medal" offset="0,0" alignment="DOWN_CENTER" />
      </Group>
    </RenderFrontpack>
    <RenderBackpack>
      <SpriteRender name="s_cape" offset="0,-16" />
    </RenderBackpack>
    <RenderPet>
      <SpriteRender name="s_pet" offset="0,0" alignment="DOWN_CENTER" />
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="s_punch_plasma" offset="13,-15" scale="1,0.5" onState="PetPunch.True" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0" />
      <SpriteRender name="s_punch_laser" offset="13,-15" scale="1,0.5" onState="PetPunch.True" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0" />
    </RenderPet>
    <UpdatePet>
      <ContextUpdate type="SetPetFlyWalk">
        <Set name="PetFlyWalk.LandingSpeed">100</Set>
        <Set name="PetFlyWalk.WalkSpeed">400</Set>
        <Set name="PetFlyWalk.FlySpeed">3000</Set>
        <Set name="PetFlyWalk.WarpDistance">800</Set>
        <Set name="PetFlyWalk.FlightDuration">2</Set>
        <Set name="PetFlyWalk.LandingTimeStart">0.2</Set>
        <Set name="PetFlyWalk.FlightTimeStart">1.9</Set>
        <Set name="PetFlyWalk.FlyingOffset">35,0</Set>
        <Set name="PetFlyWalk.WalkOffset">35,0</Set>
      </ContextUpdate>
    </UpdatePet>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_doubleJumpCoulds" onAction="JUMPDOUBLE" />
      <ParticleSystemUpdate name="ps_doubleJumpLines" onAction="JUMPDOUBLE" />
    </AddClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>

<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="ClothingType">
				<States>
					<State name="NoneOnGround" />
					<State name="NoneOnHover" />
				</States>
				<Transitions>
					<Transition to="NoneOnGround" from="NoneOnHover">
						<Condition>
							<ItemHasTag operatorType="NotEqual">Hovering_Cloak_Royal</ItemHasTag>
						</Condition>
					</Transition>
					<Transition to="NoneOnHover" from="NoneOnGround">
						<Condition>
							<ItemHasTag>Hovering_Cloak_Royal</ItemHasTag>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>			
			<StateMachine name="HoveringType">
				<States>
					<State name="NoneOnGround" />
					<State name="NoneOnHover" />
				</States>
				<Transitions>
					<Transition to="NoneOnGround" from="NoneOnHover">
						<Condition type="or">
							<ItemHasTag operatorType="NotEqual">Hovering_Cloak_Royal</ItemHasTag>
							<IsRenderObjectFlag>RENDER_OBJECT_FLAG_HOVER</IsRenderObjectFlag>
						</Condition>
					</Transition>
					<Transition to="NoneOnHover" from="NoneOnGround">
						<Condition type="and">
							<ItemHasTag>Hovering_Cloak_Royal</ItemHasTag>
							<IsRenderObjectFlag operatorType="NotEqual">RENDER_OBJECT_FLAG_HOVER</IsRenderObjectFlag>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="s_backPiece" fileName="game/particles_large18.rttex" textureSize="64" frame="7,3" />
		<Sprite name="s_backPiece_ground" fileName="game/particles_large18.rttex" textureSize="64" frame="7,4" />
		<Sprite name="s_strap" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="2,9" />
		<Sprite name="s_mist" fileName="game/particles11.rttex" textureSize="32" frame="9,17" />

		<Animations>

			<SpriteAnimation name="a_wing_closed" sprite="s_backPiece_ground" animTime="1200" isLoop="true"
			                 playOnState="ClothingType.NoneOnGround">
				<Frame>7,4</Frame>
				<Frame>8,4</Frame>
				<Frame>9,4</Frame>
				<Frame>10,4</Frame>
				<Frame>11,4</Frame>
				<Frame>12,4</Frame>
				<Frame>13,4</Frame>
				<Frame>14,4</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="a_wing_open" sprite="s_backPiece" animTime="1200" isLoop="true"
			                 playOnState="ClothingType.NoneOnHover">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="a_MistParticle" sprite="s_mist">
				<Frame>9,17</Frame>
				<Frame>9,17</Frame>
				<Frame>9,17</Frame>
				<Frame>9,17</Frame>
				<Frame>10,17</Frame>
			</SpriteAnimation>

			<CurveAnimationFloat name="a_Offset" isLoop="true" animTime="1000" playOnState="HoveringType.NoneOnHover">
				<Curve name="AdditionalClothingOffset">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, -6.8</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</CurveAnimationFloat>

			<CurveAnimationFloat name="a_ground_Offset" isLoop="true" animTime="700" playOnState="HoveringType.NoneOnGround">
				<Curve name="AdditionalClothingOffset">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</CurveAnimationFloat>

		</Animations>
		<ParticleSystems>
			<ParticleSystem name="MistParticle">
				<Emitter>
					<Set name="offset">0, -10</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_mist</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart">0</Set>

					<Set name="orbitPeriod">3</Set>
					<Set name="initialRotationRate">200</Set>
					<Set name="applyOrbit">true</Set>

					<Set name="orbitScaleVariation">0.08</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>

					<Curve name="orbit">
						<KeyFrame>0, -24, 24</KeyFrame>
						<KeyFrame>0.25, -24, -24</KeyFrame>
						<KeyFrame>0.5, -24, 8</KeyFrame>
						<KeyFrame>1, -24, -24</KeyFrame>
					</Curve>


					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>

					<Random name="initialAngle" min="0" max="360" />
					<Random name="finalAngle" min="0" max="360" />
					<Random name="lifeTime" min="5.8" max="6" />
					<Random name="initialScale" min="0.15,0.15" max="0.4, 0.5" />
					<Set name="interpolateScale">true</Set>


				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="OnEquipTag">Hovering_Cloak_Royal</Set>
				<Set name="ShouldHover">false</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="AdditionalClothingOffset">0</Set>
			</Default>
		</RenderOptions>
		<VariableMap>
			<Set name="AdditionalClothingOffset">0</Set>
			<Set name="ShouldHover">false</Set>
		</VariableMap>
	</Data>

	<RenderRules>
		<Update>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<AvatarTransform class="FootPosition" onState="ClothingType.NoneOnHover">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>

			<AvatarTransform class="ArmAngle" onState="ClothingType.NoneOnHover">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">45</Set>
			</AvatarTransform>
			<StopIf>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="ClothingType.NoneOnHover">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-45</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront value="playerCenter">
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ParticleSystemRender name="MistParticle" />
		</RenderInFront>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<AddClothingParticles>

			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<ParticleSystemUpdate name="MistParticle" />
		</AddClothingParticles>
		<RenderBackpack>
			<SpriteRender name="s_backPiece" scale="1,1" offset="0,16" flip="0,0" alignment="DOWN_CENTER"
			              onState="ClothingType.NoneOnHover" />
			<SpriteRender name="s_backPiece_ground" scale="1,1" offset="0,0" flip="0,0" alignment="DOWN_CENTER"
			              onState="ClothingType.NoneOnGround" />

			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
		</RenderBackpack>


		<RenderFrontpack value="playerCenter">
			<SpriteRender name="s_strap" offset="0,0" alignment="DOWN_CENTER" />


		</RenderFrontpack>

	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Left" fileName="game/player_feet16.rttex" textureSize="32" frame="19,24" />
    <Sprite name="s_Right" fileName="game/player_feet16.rttex" textureSize="32" frame="19,25" />
    <Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="0,15" />
    <Sprite name="s_jumpCloudsHorizontal" fileName="game/particles12.rttex" textureSize="32" frame="1,15" />
    <Sprite name="s_jumpCloudsVertical" fileName="game/particles12.rttex" textureSize="32" frame="2,15" />

    <Animations>
      <SpriteAnimation name="a_LeftIdle" sprite="s_Left" animTime="1200" playOnState="Motion.Idle" isLoop="true">
        <Frame>19,24</Frame>
        <Frame>20,24</Frame>
        <Frame>21,24</Frame>
        <Frame>22,24</Frame>
        <Frame>23,24</Frame>
        <Frame>24,24</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_RightIdle" sprite="s_Right" animTime="1200" playOnState="Motion.Idle" isLoop="true">
        <Frame>19,25</Frame>
        <Frame>20,25</Frame>
        <Frame>21,25</Frame>
        <Frame>22,25</Frame>
        <Frame>23,25</Frame>
        <Frame>24,25</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_LeftMove" sprite="s_Left" animTime="600" playOnState="Motion.Moving" isLoop="true">
        <Frame>25,24</Frame>
        <Frame>26,24</Frame>
        <Frame>27,24</Frame>
        <Frame>28,24</Frame>
        <Frame>29,24</Frame>
        <Frame>30,24</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_RightMove" sprite="s_Right" animTime="600" playOnState="Motion.Moving" isLoop="true">
        <Frame>25,25</Frame>
        <Frame>26,25</Frame>
        <Frame>27,25</Frame>
        <Frame>28,25</Frame>
        <Frame>29,25</Frame>
        <Frame>30,25</Frame>
      </SpriteAnimation>
    </Animations>
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="ClothingOffsetFromShoes">-14</Set>
        <Set name="UserNameOffset">12</Set>
        <Set name="RenderShoesWithMermaidTail">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="IsRidingBird">true</Set>
      </Default>
    </RenderOptions>
    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">-16, 0</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle angleRelativeToPlayerSpeed="true">
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75,0.5</KeyFrame>
            <KeyFrame>1, 0.75,0.1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_jumpClouds">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,0</Set>
        </Emitter>
        <Particle>
          <Select name="sprite" input="particleIndex">
            <Item>"s_jumpCloudsHorizontal"</Item>
            <Item>"s_jumpCloudsHorizontal"</Item>
            <Item>"s_jumpCloudsVertical"</Item>
          </Select>
          <Select name="flipX" input="particleIndex">
            <Item>false</Item>
            <Item>true</Item>
            <Item>false</Item>
          </Select>
          <Select name="initialVelocity" input="particleIndex">
            <Item>-40, 0</Item>
            <Item>40, 0</Item>
            <Item>0, 40</Item>
          </Select>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <RenderShoes>
      <Group>
        <StopIf>
          <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
        </StopIf>
        <ParticleSystemRender name="ps_trail"/>
      </Group>

      <SpriteRender name="s_Left" offset="0,10" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
      <SpriteRender name="s_Right" offset="0,10" blend="PREMULTIPLIED_ALPHA" drawShadow="true" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />

      <Group>
        <StopIf>
          <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
        </StopIf>
        <ParticleSystemUpdate name="ps_trail" onState="Motion.Moving"/>
        <ParticleSystemUpdate name="ps_jumpClouds" onAction="JUMPSTART|JUMPDOUBLE"/>
      </Group>
    </RenderShoes>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Blaster1" fileName="game/particles11.rttex" textureSize="32" frame="4,24" />
		<Sprite name="s_Blaster2" fileName="game/particles11.rttex" textureSize="32" frame="5,24" />
		<Sprite name="s_Hit" fileName="game/particles_large14.rttex" textureSize="64" frame="14,0" />
		<Sprite name="s_Muzzle" fileName="game/particles11.rttex" textureSize="32" frame="6,24" />
		<Sprite name="s_Projectile" fileName="game/particles11.rttex" textureSize="32" frame="7,24" />
		<Sprite name="s_Wings" fileName="game/particles_large14.rttex" textureSize="64" frame="10,0" />
		<Animations>
			<SpriteAnimation name="a_WingsIdle" sprite="s_Wings" animTime="400" isLoop="true" playOnState="Motion.Idle|Motion.Move">
				<Frame>10,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_WingsInAir" sprite="s_Wings" animTime="400" isLoop="true" playOnState="Motion.Fall|Motion.Jump">
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
				<Frame>12,0</Frame>
				<Frame>13,0</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_Hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.25, 0.25</KeyFrame>
						<KeyFrame>1, 0.75, 0.75</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_MuzzleFlash" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">5, -18</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Muzzle</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">5, -18</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Projectile</Set>
					<Select name="offset" input="punchCount">
						<Item>-8, 0</Item>
						<Item>8, 0</Item>
					</Select>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderBackpack>
			<Translate>0,-1,0</Translate>
			<SpriteRender name="s_Wings" alignment="DOWN_CENTER" />
			<SpriteRender name="s_Blaster2" alignment="DOWN_CENTER" />
		</RenderBackpack>
		<RenderFrontpack>
			<Translate>0,-1,0</Translate>
			<SpriteRender name="s_Blaster1" alignment="DOWN_CENTER" />
		</RenderFrontpack>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_Hit" />
		</OnDestroyedTile>
		<OnPunchStart>
			<AvatarTransform class="Face">
				<Set name="face">NORMAL</Set>
			</AvatarTransform>
		</OnPunchStart>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
