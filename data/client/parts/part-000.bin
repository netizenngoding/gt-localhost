<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_LACE_PARASOL">
	<Data>
		<Sprite name="closed_Sprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="30,11"/>
		<Sprite name="open_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="0,18"/>
		<Sprite name="jump_Sprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="31,11"/>
		<Sprite name="heart_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="1,18"/>
		<Sprite name="heartSparkle_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="5,18"/>
		
		<Animations>
			<SequenceAnimation name="idle_sequence" playOnAction="IDLE">
				<VisibilityAnimation sprite="open_Sprite" visibility="false"/>
				<VisibilityAnimation  sprite="closed_Sprite" visibility="true"/>
				<DelayAnimation delayTime="3000"/>
				<VisibilityAnimation sprite="closed_Sprite" visibility="false"/>
				<VisibilityAnimation sprite="open_Sprite" visibility="true"/>
				<SpriteCurveAnimation sprite="open_Sprite" animTime="2000" isLoop="true">
					<Curve name="rotation">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>1, 360</KeyFrame>
					</Curve>
				</SpriteCurveAnimation>
			</SequenceAnimation>
			<VisibilityAnimation name="show_closed" sprite="closed_Sprite" visibility="true" playOnAction="WALK|PUNCH"/>			
			<SpriteCurveAnimation name="rotate_jump_right" sprite="jump_Sprite" playOnAction="JUMP|FALL" useFacing="RIGHT" isLoop="true">
				<Curve name="rotation">
					<KeyFrame>0, 140</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>	
			<SpriteCurveAnimation name="rotate_jump_left" sprite="jump_Sprite" playOnAction="JUMP|FALL" useFacing="LEFT" isLoop="true">
				<Curve name="rotation">
					<KeyFrame>0, 220</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>	
			<SpriteAnimation name="heart_frames" sprite="heart_Sprite">
				<Frame>1,18</Frame>
				<Frame>2,18</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="heartSparkle_frames" sprite="heartSparkle_Sprite">
				<Frame>3,18</Frame>
				<Frame>4,18</Frame>
				<Frame>5,18</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="smoke_hearts">
				<Emitter>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">25</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">1.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">heart_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialScale">1,1</Set>
					<Random name="initialVelocity" min="-40,-20" max="40,20"/>
					<Random name="initialAngle" min="-30" max="30"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="fall_heartSparkle">
				<Emitter needsHandItemActive="true">
				  <Set name="infParticles">true</Set>
				  <Set name="infLifeTime">true</Set>
				  <Set name="particlesPerEmission">7</Set>
				  <Set name="particlesToEmit">1</Set>
				  <Set name="randomizeInterval">true</Set>
				  <Set name="intervalMax">0.1</Set>
				  <Set name="intervalMin">0.15</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
				  <Set name="sprite">heartSparkle_Sprite</Set>
				  <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
				  <Set name="lifeTime">0.5</Set>
				  <Set name="initialScale">1,1</Set>
				  <Set name="initialVelocity">0,250</Set>
				  <Random name="offset" min="-15,-40" max="15,-20"/>
				  <Set name="initialAlpha">1</Set>
				  <Set name="finalAlpha">0</Set>
				  <Set name="interpolateAlpha">true</Set>
				</Particle>
			</ParticleSystem>	
			<ParticleSystem name="jump_hearts">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">20</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="relativeToEmitter">false</Set>
					<Set name="sprite">heartSparkle_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="initialScale">1,1</Set>
					<Random name="offset" min="-25,-80" max="25,0"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="jump_heartSparkle">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">20</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="relativeToEmitter">true</Set>
					<Set name="sprite">heartSparkle_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialScale">1,1</Set>
					<Random name="initialVelocity" min="0,0" max="0,10"/>
					<Random name="offset" min="-25,-50" max="25,20"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>	  
	
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
			</Default>
		</RenderOptions>
		
	</Data>

	<RenderRules>
		<Update>
			<AvatarTransform class="ArmAngle" onAction="JUMP|JUMPDOUBLE|FALL">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-140</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
			<ParticleSystemUpdate name="smoke_hearts" onAction="JUMPDOUBLE"/>
			<ParticleSystemUpdate name="fall_heartSparkle" onAction="FALL"/>
			<ParticleSystemUpdate name="jump_heartSparkle" onAction="JUMPDOUBLE"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="smoke_hearts"/>
			<ParticleSystemOff name="fall_heartSparkle"/>
			<ParticleSystemOff name="jump_heartSparkle"/>
		</SwitchOffClothingParticles>
		<RenderHandItem>
			<SpriteRender name="closed_Sprite" offset="0,16" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onAction="IDLE|WALK|PUNCH"/>
			<SpriteRender name="open_Sprite" offset="-2,5" scale="0.75,0.75" rotateOffset="true" rotationPoint="0,-1.6" blend="PREMULTIPLIED_ALPHA" onAction="IDLE"/>
			<SpriteRender name="jump_Sprite" offset="5,16" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onAction="JUMP|FALL"/>
		</RenderHandItem>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Wing" fileName="game/particles12.rttex" textureSize="32" frame="12,0" />
	
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="Idle" />
					<State name="JumpStraight" />
					<State name="FallStraight" />
				</States>
				<Transitions>
					<Transition to="Idle" from="FallStraight">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>					
					<Transition to="JumpStraight" from="Idle|FallStraight">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>			
					<Transition to="FallStraight" from="JumpStraight|Idle">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>				
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="s_Wing_idle" sprite="s_Wing" animTime="50" isLoop="true" playOnState="Action.Idle">
				<Frame>12,0</Frame>
			</SpriteAnimation>		
			
			<SpriteAnimation name="s_Wing_jump" sprite="s_Wing" animTime="100" isLoop="true" playOnState="Action.JumpStraight|Action.FallStraight">
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
			</SpriteAnimation>
		</Animations>
	</Data>
	<RenderRules>
		<RenderBackpack>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_Wing" offset="-3.45,-13.6" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackpack>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_death" fileName="game/particles_large16.rttex" textureSize="64" frame="0,0" />
		<Sprite name="s_feather" fileName="game/particles12.rttex" textureSize="32" frame="29,4" />
		<Sprite name="s_fog" fileName="game/particles12.rttex" textureSize="32" frame="30,4" />
		<Sprite name="s_projectile" fileName="game/particles12.rttex" textureSize="32" frame="31,4" />
		<Sprite name="s_scythe" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="0,10" />
		<VariableMap>
			<Set name="context.pos">1.12e+03,768</Set>
			<Set name="boomerang.Offset">0,-8</Set>
			<Set name="target.pos">912,688</Set>
			<Set name="calculatedPos">1.12e+03,768</Set>
			<Set name="boomerangAngle">24.5</Set>
			<Set name="sittingOffset">0,0,0</Set>
		</VariableMap>
		<Animations>
			<InterpolationVec2Animation name="a_punchStart" variableName="calculatedPos" targetVariableName="target.pos" animTime="500" playOnState="PunchAnim.Start" />
			<InterpolationVec2Animation name="a_punchContinue" variableName="calculatedPos" targetVariableName="target.pos" animTime="30" isLoop="true" playOnState="PunchAnim.Continue" />
			<InterpolationVec2Animation name="a_punchEnd" variableName="calculatedPos" targetVariableName="context.pos" animTime="250" playOnState="PunchAnim.End" />
			<InterpolationVec2Animation name="a_asdfStart" variableName="boomerang.Offset" targetValue="0,0" animTime="500" playOnState="PunchAnim.Start" />
			<InterpolationVec2Animation name="a_dfyjrtEnd" variableName="boomerang.Offset" targetValue="0,-8" animTime="250" playOnState="PunchAnim.End" />
			<CurveAnimationFloat name="a_boomerangRotationRight" playOnState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" isLoop="true" useFacing="RIGHT" animTime="250">
				<Curve name="boomerangAngle">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 360</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
			<CurveAnimationFloat name="a_boomerangRotationLeft" playOnState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" isLoop="true" useFacing="LEFT" animTime="250">
				<Curve name="boomerangAngle">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, -360</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
			<SpriteAnimation name="a_death" sprite="s_death" animTime="800" playOnState="IsDying.True">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>15,0</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="IsDying">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PunchAnim">
				<States>
					<State name="Off" />
					<State name="Start" ExitTime="0.5" />
					<State name="Continue" />
					<State name="End" ExitTime="0.25" />
				</States>
				<Transitions>
					<Transition from="Off" to="Start">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Start" to="Continue" />
					<Transition from="Continue" to="End">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="End" to="Off" />
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="IsPetWithLight">true</Set>
			</Default>
		</RenderOptions>
		<TileStampData>
			<Set name="FileName">game/particles12.rttex</Set>
			<Set name="EndFrame">28,3</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
		<ParticleSystems>
			<ParticleSystem name="ps_feather" updateStage="AddClothingParticles" updateState="Motion.Moving">
				<Emitter>
					<Set name="offset">-17, -2</Set>
					<Set name="lifeTime">1</Set>
					<Set name="emissionInterval">0.2</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_feather</Set>
					<Random name="offset" min="-15, -10" max="15, -5" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="useGravity">true</Set>
					<Set name="initialScale">1, 1</Set>
					<Set name="lifeTime">1.2</Set>
					<Curve name="initialVelocity">
						<KeyFrame>0.2, -20, 0</KeyFrame>
						<KeyFrame>0.4, 50, 0</KeyFrame>
						<KeyFrame>0.6, -50, 0</KeyFrame>
						<KeyFrame>0.8, 50, 0</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Curve name="initialAngle">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -15</KeyFrame>
						<KeyFrame>0.4, 15</KeyFrame>
						<KeyFrame>0.6, -15</KeyFrame>
						<KeyFrame>0.8, 15</KeyFrame>
					</Curve>
					<Set name="gravityVector">0, 30</Set>
					<Set name="flipX">false</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fogLocal" updateStage="AddClothingParticles" updateState="Motion.Idle">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">false</Set>
					<Set name="infLifeTime">false</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_fog</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-8, -8" max="8, -16" />
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.25</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="initalRGB">0.346503, 0.25668, 0.534314</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 2, 2</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,30" />
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fogWorld" updateStage="AddClothingParticles" updateState="Motion.Moving">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_fog</Set>
					<Random name="offset" min="-12, 0" max="12, -24" />
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.25</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="initalRGB">0.303625, 0.221429, 0.47549</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1.25, 1.25</KeyFrame>
						<KeyFrame>1, 2, 2</KeyFrame>
					</Curve>
					<Set name="lifeTime">1.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="10,20" />
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punch_projectile">
				<Emitter>
					<Set name="lifeTime">0.02</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_projectile</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="offset" source="boomerang.Offset" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="worldPos" source="calculatedPos" />
					<Set name="initialScale">1, 1</Set>
					<Set name="lifeTime">0.04</Set>
					<Set name="initialAngle" source="boomerangAngle" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<ArithmethicOperation LeftHandVariableName="calculatedPos" RightHandVariableName="context.pos" OperationType="Set" onState="PunchAnim.Off" />
			<ArithmethicOperation LeftHandVariableName="calculatedPos.x" RightHandVariableName="sittingOffset.x" OperationType="Substract" onState="PunchAnim.Off" />
			<ArithmethicOperation LeftHandVariableName="calculatedPos.y" RightHandVariableName="sittingOffset.y" OperationType="Substract" onState="PunchAnim.Off" />
		</Update>
		<AddClothingParticles>
			<StopIf>
				<IsVariableBool name="isBattleLeash">true</IsVariableBool>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</AddClothingParticles>
		<RenderBehind>
			<SpriteRender name="s_death" alignment="CENTER" offset="0,-8" onState="IsDying.True" />
		</RenderBehind>
		<RenderHandItem>
			<Group onState="IsDying.False">
				<SpriteRender name="s_scythe" offset="0,8" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="PunchAnim.Off" />
				<ParticleSystemUpdate name="ps_punch_projectile" onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" />
			</Group>
		</RenderHandItem>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
	<Sprite name="item_Sprite_1" fileName="game/special_wings.rttex" textureSize="64" frame="0,2"/>
	<Animations>
      <SpriteAnimation name="wingFlexJump" playOnAction="JUMP" sprite="item_Sprite_1" animTime="200" autoPlay="true" isLoop="true">
		<Frame>0,2</Frame>
        <Frame>1,2</Frame>
		<Frame>2,2</Frame>
		<Frame>3,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="wingFlexJump2" playOnAction="JUMP|FALL" sprite="item_Sprite_1" animTime="200" autoPlay="true" isLoop="true">
		<Frame>0,2</Frame>
		<Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>1,2</Frame>
		<Frame>2,2</Frame>
		<Frame>2,2</Frame>
		<Frame>3,2</Frame>
		<Frame>3,2</Frame>
      </SpriteAnimation>
	  <SpriteAnimation name="be_idle2" playOnAction="IDLE|WALK" sprite="item_Sprite_1" tintOverride="0,127,236,255">
        <Frame>0,2</Frame>
      </SpriteAnimation>
    </Animations>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="item_Sprite_1" offset="0,-32" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
	  <SpriteRender name="item_Sprite_1" offset="0,-32" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_ElectricAura" fileName="game/particles_large13.rttex" textureSize="64" frame="7,4" />
		<Sprite name="s_HitEffect" fileName="game/particles_large13.rttex" textureSize="64" frame="6,8" />
		<Sprite name="s_HitSparkles" fileName="game/particles11.rttex" textureSize="32" frame="29,6" />
		<Sprite name="s_Pants" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="5,9" />
		<Sprite name="s_PunchParticle" fileName="game/particles11.rttex" textureSize="32" frame="29,7" />
		<Animations>
			<SpriteAnimation name="a_ElectricAura" sprite="s_ElectricAura" animTime="500" autoPlay="true" isLoop="true">
				<Frame>7,4</Frame>
				<Frame>8,4</Frame>
				<Frame>9,4</Frame>
				<Frame>10,4</Frame>
				<Frame>11,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_HitEffect" sprite="s_HitEffect" animTime="500">
				<Frame>10,8</Frame>
				<Frame>6,8</Frame>
				<Frame>7,8</Frame>
				<Frame>8,8</Frame>
				<Frame>9,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_HitSparkles" sprite="s_HitSparkles" animTime="200">
				<Frame>29,6</Frame>
				<Frame>30,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PunchParticle" sprite="s_PunchParticle" animTime="400" isLoop="true" playOnState="Action.Punch">
				<Frame>29,7</Frame>
				<Frame>30,7</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="IgnorePunchTypeDamagedTileCheck">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_HitEffect" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_HitEffect</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 1.5, 1.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_HitSparkles" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">15</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_HitSparkles</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="75,120" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderPants>
			<SpriteRender name="s_Pants" alignment="DOWN_CENTER" />
		</RenderPants>
		<RenderInFront>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="s_ElectricAura" alignment="DOWN_CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA" tintOverride="255,255,255,255"/>
			
			<ContextUpdate type="SetFlip">
				<Set name="flip">0,1</Set>
				<Set name="flipPeriod">true</Set>
				<Set name="period">300</Set>
			</ContextUpdate>
			<ContextUpdate type="PositionTargetOffset" onState="Action.Punch">
				<Set name="targetOffsetRange">10, 10</Set>
			</ContextUpdate>
			<SpriteRender name="s_PunchParticle" offset="0,-12" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" 
				drawShadow="false" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" tintOverride="255,255,255,255" onState="Action.Punch" />
		</RenderInFront>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_HitEffect"/>
			<ParticleSystemUpdate name="ps_HitSparkles"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Equip" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="16,11"/>
		<Sprite name="s_Slash" fileName="game/particles12.rttex" textureSize="32,32" frame="21,22" />
		<Sprite name="s_Hit" fileName="game/particles12.rttex" textureSize="32" frame="26,22" />
		<Sprite name="s_Break" fileName="game/particles_large17.rttex" textureSize="64" frame="15,8" />
		<Animations>
			<SpriteAnimation name="a_Equip" sprite="s_Equip" animTime="1200" isLoop="true" playOnState="Swing.No">
				<Frame>10,12</Frame>
				<Frame>11,12</Frame>
				<Frame>12,12</Frame>
				<Frame>13,12</Frame>
				<Frame>14,12</Frame>
				<Frame>15,12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Dance" sprite="s_Equip" animTime="400" isLoop="true" playOnState="Swing.Yes">
				<Frame>10,11</Frame>
				<Frame>11,11</Frame>
				<Frame>12,11</Frame>
				<Frame>13,11</Frame>
				<Frame>14,11</Frame>
				<Frame>15,11</Frame>
				<Frame>16,11</Frame>
				<Frame>17,11</Frame>
				<Frame>18,11</Frame>
				<Frame>19,11</Frame>
				<Frame>20,11</Frame>
				<Frame>21,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Hit" sprite="s_Hit">
				<Frame>26,22</Frame>
				<Frame>27,22</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Swing">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition from="Yes" to="No">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
						</Condition>
					</Transition>
					<Transition from="No" to="Yes">
						<Condition type="and">
							<SubCondition type="or">
								<IsAction>PUNCH</IsAction>
								<IsAction>DANCE_FLOSS</IsAction>
							</SubCondition>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Hand">
				<States>
					<State name="Front" ExitTime="1.5" />
					<State name="Back" ExitTime="1.5"/>
				</States>
				<Transitions>
					<Transition to="Front" from="Back" />
					<Transition to="Back" from="Front" />
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_slash" updateStage="OnPunchUpdate">
				<Emitter attachment="targetPos">
					<Set name="lifeTime">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="lifeTime">0.2</Set>
					<Set name="sprite">s_Slash</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Random name="offset" min="-8,-8" max="8,8"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.75,0.75</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,80"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_break" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Break</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.75</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75,0.75</KeyFrame>
						<KeyFrame>1, 1.5,1.5</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<TileStampData>
			<Set name="FileName">game/particles12.rttex</Set>
			<Set name="EndFrame">25,22</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="RenderBackArmAfterItem">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<Group onState="Swing.No">
				<SpriteRender name="s_Equip" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
			</Group>
			<Group onState="Swing.Yes">
				<SpriteRender name="s_Equip" offset="6,-3" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" onState="Hand.Front"/>
			</Group>
		</RenderHandItem>
		<RenderBackHandItem>
			<Group onState="Swing.Yes">
				<SpriteRender name="s_Equip" offset="3,-8" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" onState="Hand.Back"/>
			</Group>
		</RenderBackHandItem>
		<Update>
			<Group onState="Punch.Yes">
				<AvatarTransform class="ArmAngle" onState="Hand.Front">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">-40</Set>
					<Set name="pulseArmScale">20</Set>
					<Set name="pulseArmRate">300</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Hand.Front">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Hand.Back">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">-40</Set>
					<Set name="pulseArmScale">20</Set>
					<Set name="pulseArmRate">300</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Hand.Back">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
			</Group>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="s_flower" fileName="game/particles_large15.rttex" textureSize="64,64" frame="12,11" />
        <Sprite name="s_petals" fileName="game/particles12.rttex" textureSize="32,32" frame="11,5" />
        <Animations>
            <SpriteAnimation name="a_flower" sprite="s_flower" isLoop="true" autoPlay="true" animTime="800">
                <Frame>12,11</Frame>
                <Frame>13,11</Frame>
                <Frame>14,11</Frame>
                <Frame>15,11</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_petals" sprite="s_petals">
                <Frame>11,5</Frame>
                <Frame>12,5</Frame>
                <Frame>13,5</Frame>
                <Frame>14,5</Frame>
            </SpriteAnimation>
        </Animations>
        <StateMachines>
          <StateMachine name="Trail">
            <States>
              <State name="Off" />
              <State name="Move" />
              <State name="Sleep" />
            </States>
            <Transitions>
              <Transition to="Off" from="Move|Sleep">
                <Condition type="and">
                  <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                  <IsAction operatorType="NotEqual">SLEEP</IsAction>
                </Condition>
              </Transition>
              <Transition to="Move" from="Off|Sleep">
                <Condition type="and">
                  <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                  <IsAction operatorType="NotEqual">SLEEP</IsAction>
                </Condition>
              </Transition>
              <Transition to="Sleep" from="Off|Move">
                <Condition type="and">
                  <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                  <IsAction operatorType="Equal">SLEEP</IsAction>
                </Condition>
              </Transition>
            </Transitions>
          </StateMachine>
        </StateMachines>
        <ParticleSystems>
          <ParticleSystem name="ps_petals" updateStage="AddClothingParticles" updateState="Trail.Move" renderStage="RenderBehind">
            <Emitter>
              <Set name="offset">-20,-34</Set>
              <Set name="offsetFacing">true</Set>
              <Set name="emissionInterval">0.1</Set>
              <Set name="infParticles">true</Set>
              <Set name="lifeTime">0.8</Set>
              <Set name="particlesPerEmission">2</Set>
            </Emitter>
            <Particle randomSpriteFrame="true">
              <Set name="sprite">s_petals</Set>
              <Random name="offset" min="-12,-18" max="12,12" />
              <Set name="inSpecificOrder">true</Set>
              <Set name="lifeTime">1.5</Set>
              <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
              <Curve name="initialAlpha">
                <KeyFrame>0, 1</KeyFrame>
                <KeyFrame>0.3, 1</KeyFrame>
                <KeyFrame>1, 0</KeyFrame>
              </Curve>
              <Random name="initialScale" min="0.8" max="1" />
              <Select name="initialRotationRate" input="randomNumber">
                <Item>90</Item>
                <Item>-90</Item>
              </Select>
              <Set name="useGravity">true</Set>
              <Curve name="initialVelocity">
                <KeyFrame>0, 0</KeyFrame>
                <KeyFrame>0.2, -20, 0</KeyFrame>
                <KeyFrame>0.4, 50, 0</KeyFrame>
                <KeyFrame>0.6, -50, 0</KeyFrame>
                <KeyFrame>0.8, 50, 0</KeyFrame>
                <KeyFrame>1, 0, 0</KeyFrame>
              </Curve>
              <Set name="gravityVector">0, 50</Set>
              <Random name="initialAngle" min="0" max="360" />
            </Particle>
          </ParticleSystem>
          <ParticleSystem name="ps_petals_sleep" updateStage="AddClothingParticles" updateState="Trail.Sleep" renderStage="RenderBehind">
            <Emitter>
              <Set name="offset">-20,-34</Set>
              <Set name="offsetFacing">true</Set>
              <Random name="emissionInterval" min="1" max="2" />
              <Set name="infParticles">true</Set>
              <Set name="lifeTime">0.8</Set>
              <Set name="particlesPerEmission">1</Set>
            </Emitter>
            <Particle randomSpriteFrame="true">
              <Set name="sprite">s_petals</Set>
              <Random name="offset" min="-16,-18" max="16,12" />
              <Set name="inSpecificOrder">true</Set>
              <Set name="lifeTime">1.5</Set>
              <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
              <Curve name="initialAlpha">
                <KeyFrame>0, 1</KeyFrame>
                <KeyFrame>0.6, 1</KeyFrame>
                <KeyFrame>1, 0</KeyFrame>
              </Curve>
              <Random name="initialScale" min="0.8" max="1" />
              <Select name="initialRotationRate" input="randomNumber">
                <Item>90</Item>
                <Item>-90</Item>
              </Select>
              <Set name="useGravity">true</Set>
              <Curve name="initialVelocity">
                <KeyFrame>0, 0</KeyFrame>
                <KeyFrame>0.2, -20, 0</KeyFrame>
                <KeyFrame>0.4, 50, 0</KeyFrame>
                <KeyFrame>0.6, -50, 0</KeyFrame>
                <KeyFrame>0.8, 50, 0</KeyFrame>
                <KeyFrame>1, 0, 0</KeyFrame>
              </Curve>
              <Set name="gravityVector">0, 40</Set>
              <Random name="initialAngle" min="0" max="360" />
            </Particle>
          </ParticleSystem>
        </ParticleSystems>

        <RenderOptions>
          <Default>
            <Set name="IgnorePunchTypeCheck">true</Set>
            <Set name="UserNameOffset">20</Set>
            <Set name="DisableDefaultAncestralParticleEffects">true</Set>
            <Set name="IncludeAllActions">true</Set>
          </Default>
        </RenderOptions>
    </Data>
    <RenderRules>
        <RenderBehind>
            <SpriteRender name="s_flower" offset="-16,-8"/>
        </RenderBehind>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_punchProjectileTrail" fileName="game/particles11.rttex" textureSize="32" frame="27,29" />
    <Sprite name="s_punchProjectile" fileName="game/particles11.rttex" textureSize="32" frame="26,29" />
    <Sprite name="s_stickFire" fileName="game/particles11.rttex" textureSize="32" frame="20,29" />
    <Sprite name="s_stick" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="4,6" />
    <Sprite name="s_stickGlow" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="5,6" />
    <Sprite name="s_tileHit" fileName="game/particles_large14.rttex" textureSize="64" frame="12,9" />

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <Animations>
      <SpriteCurveAnimation name="a_stickGlow" isLoop="true" autoPlay="true" sprite="s_stickGlow" animTime="5000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.2f, 0.f </KeyFrame>
          <KeyFrame>0.4f, 1.f</KeyFrame>
          <KeyFrame>0.8f, 1.f</KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="stick_fire_animation" sprite="s_stickFire" animTime="600" autoPlay="true" isLoop="true">
        <Frame>20,29</Frame>
        <Frame>21,29</Frame>
        <Frame>22,29</Frame>
        <Frame>23,29</Frame>
        <Frame>24,29</Frame>
        <Frame>25,29</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_punchProjectileTrailScale" sprite="s_punchProjectileTrail" animTime="200" isLoop="true" playOnState="Punch.True">
        <Curve name="scale">
          <KeyFrame>0.f, 0.1f, 1f</KeyFrame>
          <KeyFrame>1.f, 1.f, 1f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_punchProjectileTrailAlpha" sprite="s_punchProjectileTrail" animTime="200" isLoop="true" playOnState="Punch.True">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>0.7f, 1.f</KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_punchProjectile" updateStage="RenderHandItem" updateState="Punch.True">
        <Emitter attachment="handspotRoot">
          <Set name="offset">34,10</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchProjectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angleOutVar="projectile_angle"/>
          <Set name="rotateWithVelocity">true</Set>
          <SetVar name="projectile_offset" source="targetPosOffset"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tileHit</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.6, 0.6</KeyFrame>
            <KeyFrame>1, 1.2, 1.2</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.65, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
      
    <VariableMap>
      <Set name="staff_offset">16.5, 8, 0</Set>
      <Set name="fire_offset_right">14, 0, 0</Set>
      <Set name="fire_rotation">0, 0, 0, 1</Set>
      <Set name="fire_offset_down">0, -7, 0</Set>
    </VariableMap>
    
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
    </RenderOptions>
  </Data>
  
  <RenderRules>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="angleOffset">90</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderHandItem>
      <Translate>staff_offset</Translate>
      <SpriteRender name="s_stick" blend="PREMULTIPLIED_ALPHA" />
      <SpriteRender name="s_stickGlow" blend="PREMULTIPLIED_ALPHA" />
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
      </StopIf>
      <Translate>fire_offset_right</Translate>
      <SpriteRender name="s_punchProjectileTrail" flip="1,0" onState="Punch.True" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false"/>
      <Rotate forceValue="true">fire_rotation</Rotate>
      <Translate>fire_offset_down</Translate>
      <SpriteRender name="s_stickFire" blend="ADDITIVE" drawShadow="false"/>
    </RenderHandItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="chestBackgroundSprite" fileName="game/particles_large13.rttex" textureSize="64" frame="10,14" />
		<Sprite name="chestForegroundSprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="22,25" />
		<Sprite name="hearthSprite" fileName="game/particles12.rttex" textureSize="32" frame="2,2" />
		<Animations>
			<SpriteAnimation name="MantleAnimation" sprite="chestBackgroundSprite" animTime="1000" autoPlay="true" isLoop="true">
				<Frame>10,14</Frame>
				<Frame>11,14</Frame>
				<Frame>12,14</Frame>
				<Frame>13,14</Frame>
				<Frame>14,14</Frame>
				<Frame>15,14</Frame>
				<Frame>12,14</Frame>
				<Frame>13,14</Frame>
				<Frame>10,14</Frame>
				<Frame>11,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="heartTrail" sprite="hearthSprite" animTime="200">
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="TrialParticle">
				<Emitter>
					<Set name="offset">0, -36</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hearthSprite</Set>
					<Random name="offset" min="-11, 0" max="11, 0" />
					<Set name="renderAlignment">CENTER</Set>
					<Random name="finalScale" min="0.1" max="0.25"/>
					<Random name="initialScale" min="0.1" max="1"/>
					<Set name="interpolateScale">true</Set>		
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, -30</Set>
					<Set name="lifeTime">0.8</Set>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="HideParticlesOnTransform">true</Set>
				<Set name="HideParticlesOnTheaterSeat">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderChestBackItem>
			<SpriteRender name="chestBackgroundSprite" drawShadow="false" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
		</RenderChestBackItem>
		<RenderChestItem>
			<SpriteRender name="chestForegroundSprite" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
			<ParticleSystemRender name="TrialParticle"/>
		</RenderChestItem>
		<AddClothingParticles>
			<ParticleSystemUpdate name="TrialParticle"/>
		</AddClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Pearl" fileName="game/particles12.rttex" textureSize="32" frame="25,18"/>
		<Sprite name="s_PearlGlow" fileName="game/particles12.rttex" textureSize="32" frame="25,19"/>
		<Sprite name="s_GodRay" fileName="game/particles_large17.rttex" textureSize="64" frame="10,6"/>
		<Sprite name="s_Trail" fileName="game/particles9.rttex" textureSize="32" frame="28,23"/>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
			</Default>
		</RenderOptions>
		<Animations>
			<SpriteAnimation name="a_GodRay" sprite="s_GodRay">
				<Frame>10, 6</Frame>
				<Frame>11, 6</Frame>
				<Frame>12, 6</Frame>
				<Frame>13, 6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Trail" sprite="s_Trail">
				<Frame>28, 23</Frame>
				<Frame>29, 23</Frame>
				<Frame>30, 23</Frame>
			</SpriteAnimation>
			<SpriteCurveAnimation name="a_pearlGlow" isLoop="true" autoPlay="true" sprite="s_PearlGlow" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.35f, 1.f</KeyFrame>
					<KeyFrame>0.65f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<InterpolationVec2Animation name="a_punchStart" variableName="movingPos" targetVariableName="target.pos" animTime="1500" playOnState="PunchAnim.Start"/>
			<InterpolationVec2Animation name="a_punchContinue" variableName="movingPos" targetVariableName="target.pos" animTime="30" isLoop="true" playOnState="PunchAnim.Continue"/>
			<InterpolationVec2Animation name="a_punchEnd" variableName="movingPos" targetVariableName="initialPos" animTime="1000" playOnState="PunchAnim.End"/>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_GodRay" updateStage="RenderHandItem" updateState="Punch.True" renderStage="RenderHandItem">
				<Emitter  attachment="handspotRoot">
					<Set name="offset">-1,9</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_GodRay</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="relativeToEmitter">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5,0.5</KeyFrame>
						<KeyFrame>1, 2.6,2.6</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="flipX" source="flipX" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail1">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">0,0</Set>
					<Random name="offset" min="-4,-4" max="4,4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Random name="initialAngle" min="0" max="180"/>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail2">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">0,0</Set>
					<Random name="offset" min="-4,-4" max="4,4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Random name="initialAngle" min="0" max="180"/>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail3">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">0,0</Set>
					<Random name="offset" min="-4,-4" max="4,4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Random name="initialAngle" min="0" max="180"/>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Hit">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,90"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="True"/>
					<State name="False"/>
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PunchAnim">
				<States>
					<State name="Off"/>
					<State name="Start" ExitTime="0.5" />
					<State name="Continue"/>
					<State name="End" ExitTime="0.25" />
				</States>
				<Transitions>
					<Transition from="Off" to="Start">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Start" to="Continue"/>
					<Transition from="Continue" to="End">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="End" to="Off"/>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition type="or">
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="pearlRotation">0, 0, 0, 1</Set>
			<Set name="pearlRotationInc">0</Set>
			<Set name="pearlRotation2">0, 0, 0, 1</Set>
			<Set name="pearlRotationInc2">0</Set>
			<Set name="DeltaTime">0</Set>
			<Set name="context.pos">0, 0</Set>
			<Set name="target.pos">0, 0</Set>
			<Set name="initialPos">0, 0</Set>
			<Set name="handOffsetPos">20, -10</Set>
			<Set name="handOffsetPosFacing">0,0</Set>
			<Set name="movingPos">0, 0</Set>
			<Set name="pearlContextOffset">0, 0, 0</Set>
			<Set name="Player.GetFacing">0</Set>
			<Set name="flipX">false</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			
			<ArithmethicOperation LeftHandVariableName="initialPos" RightHandVariableName="context.pos" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="handOffsetPosFacing" RightHandVariableName="handOffsetPos" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="handOffsetPosFacing.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="initialPos" RightHandVariableName="handOffsetPosFacing" OperationType="Add"/>
			
			<ArithmethicOperation LeftHandVariableName="movingPos" RightHandVariableName="initialPos" OperationType="Set" onState="PunchAnim.Off"/>
			<ArithmethicOperation LeftHandVariableName="pearlContextOffset" RightHandVariableName="context.pos" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="pearlContextOffset" RightHandVariableName="movingPos" OperationType="Substract" />
			<ArithmethicOperation LeftHandVariableName="pearlContextOffset" RightHandVariableName="-1,-1,1" OperationType="Multiply" />

			<ArithmethicOperation LeftHandVariableName="pearlContextOffset.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply" />

			<ArithmethicOperation LeftHandVariableName="flipX" RightHandVariableName="false" OperationType="Set" onState="Facing.Right" />
			<ArithmethicOperation LeftHandVariableName="flipX" RightHandVariableName="true" OperationType="Set" onState="Facing.Left" />

			<StopIf type="or">
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<SubCondition type="and">
					<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
					<IsInState name="PunchAnim.Off">true</IsInState>
				</SubCondition>
			</StopIf>
			
			<Translate>pearlContextOffset</Translate>
			<Rotate>pearlRotation</Rotate>
			
			<Group>
				<Translate>0,6,0</Translate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">0,2,0</Translate>
				<Rotate>pearlRotation2</Rotate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">0,4,0</Translate>
				<ParticleSystemUpdate name="ps_Trail1" onState="PunchAnim.Start|PunchAnim.End"/>
				<ParticleSystemRender name="ps_Trail1" />
				<SpriteRender name="s_Pearl"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
				<SpriteRender name="s_PearlGlow"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
			</Group>
			<Group>
				<Translate>-8,0,0</Translate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">-2,0,0</Translate>
				<Rotate>pearlRotation2</Rotate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">4,0,0</Translate>
				<ParticleSystemUpdate name="ps_Trail2" onState="PunchAnim.Start|PunchAnim.End"/>
				<ParticleSystemRender name="ps_Trail2" />
				<SpriteRender name="s_Pearl"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
				<SpriteRender name="s_PearlGlow"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
			</Group>
			<Group>
				<Translate>0,-6,0</Translate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">0,-2,0</Translate>
				<Rotate>pearlRotation2</Rotate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">0,-4,0</Translate>
				<ParticleSystemUpdate name="ps_Trail3" onState="PunchAnim.Start|PunchAnim.End"/>
				<ParticleSystemRender name="ps_Trail3" />
				<SpriteRender name="s_Pearl"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
				<SpriteRender name="s_PearlGlow"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
			</Group>
		</RenderInFront>
		<Update>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsRenderMod>RENDER_MOD_MANNEQUIN</IsRenderMod>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-90</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Punch.True">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<ArithmethicOperation LeftHandVariableName="pearlRotationInc" RightHandVariableName="90" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="pearlRotationInc" RightHandVariableName="DeltaTime" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="pearlRotation.x" RightHandVariableName="pearlRotationInc" OperationType="Add"/>

			<ArithmethicOperation LeftHandVariableName="pearlRotationInc2" RightHandVariableName="600" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="pearlRotationInc2" RightHandVariableName="DeltaTime" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="pearlRotation2.x" RightHandVariableName="pearlRotationInc2" OperationType="Add"/>
		</Update>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_Hit"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_Hit"/>
		</OnDestroyedTile>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_MANIACAL_MOBILE_SUIT_WINGS">
  <Data>
    <Sprite name="item_Sprite" fileName="game/particles_large10.rttex" textureSize="64" frame="14,8"/>
    <Sprite name="item_glow_Sprite" fileName="game/particles_large10.rttex" textureSize="64" frame="15,8"/>
    <Sprite name="sparkle_sprite" fileName="game/particles11.rttex" textureSize="32" frame="31,26"/>
    <Sprite name="jump_trail_sprite" fileName="game/particles11.rttex" textureSize="32" frame="31,25"/>
    <Sprite name="jump_sparkle_sprite" fileName="game/particles11.rttex" textureSize="32" frame="31,28"/>
    <Sprite name="jump_heart_sprite" fileName="game/particles11.rttex" textureSize="32" frame="31,27"/>

    <Animations>
      <SpriteCurveAnimation name="wing_glow" autoPlay="true" isLoop="true" sprite="item_glow_Sprite" animTime="4000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.2f, 0.f </KeyFrame>
          <KeyFrame>0.4f, 1.f</KeyFrame>
          <KeyFrame>0.8f, 1.f</KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>
    <ParticleSystems>
      <ParticleSystem name="sparklesLeft">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">-18.5,-13</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">0.5,0.5</Set>
          <Random name="initialVelocity" min="-20,10" max="20,20"/>
          <Random name="offset" min="-2, 0" max="2,0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="sparklesRight">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">18.5,-13</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">0.5,0.5</Set>
          <Random name="initialVelocity" min="-20,10" max="20,20"/>
          <Random name="offset" min="-2, 0" max="2,0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpTrailLeft">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.025</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">-18,0</Set>
        </Emitter>
        <Particle angleRelativeToPlayerSpeed="true">
          <Set name="sprite">jump_trail_sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.75,0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 250</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpTrailRight">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.025</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">18,0</Set>
        </Emitter>
        <Particle angleRelativeToPlayerSpeed="true">
          <Set name="sprite">jump_trail_sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.75,0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 250</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpSparkleLeft">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.025</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">-18,8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.5,0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-5,0" max="5,5"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpSparkleRight">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.025</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">18,8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.5,0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-5,0" max="5,5"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpHeartsLeft">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">-18,8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_heart_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 50</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.4,0.2</Set>
          <Increment name="initialScale" source="particleIndex" multiplier="0.2,0.1"/>
          <Set name="finalScale">1.2,0.6</Set>
          <Increment name="finalScale" source="particleIndex" multiplier="0.4,0.2"/>
          <Set name="offset">0,-30</Set>
          <Increment name="worldPos" source="particleIndex" multiplier="0,12"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpHeartsRight">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">18,8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_heart_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 50</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.4,0.2</Set>
          <Increment name="initialScale" source="particleIndex" multiplier="0.2,0.1"/>
          <Set name="finalScale">1.2,0.6</Set>
          <Increment name="finalScale" source="particleIndex" multiplier="0.4,0.2"/>
          <Set name="offset">0,-30</Set>
          <Increment name="worldPos" source="particleIndex" multiplier="0,12"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="randomWingSparklesLeft">
        <Emitter>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="randomizeInterval">true</Set>
          <Set name="intervalMin">0.2</Set>
          <Set name="intervalMax">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="lifeTime">1</Set>
          <Select name="initialRotationRate" input="randomNumber">
            <Item>-180</Item>
            <Item>180</Item>
          </Select>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-32,-32" max="-16,0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="randomWingSparklesRight">
        <Emitter>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="randomizeInterval">true</Set>
          <Set name="intervalMin">0.2</Set>
          <Set name="intervalMax">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="lifeTime">1</Set>
          <Select name="initialRotationRate" input="randomNumber">
            <Item>-180</Item>
            <Item>180</Item>
          </Select>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="16,0" max="32,-32"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="HideParticlesOnTransform">true</Set>
        <Set name="HideParticlesOnTheaterSeat">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="item_Sprite" offset="-4,-32" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="item_Sprite" offset="4,-32" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
      <SpriteRender name="item_glow_Sprite" offset="-4,-32" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      <SpriteRender name="item_glow_Sprite" offset="4,-32" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
    </RenderBackpack>
    <AddClothingParticles>
      <ParticleSystemUpdate name="sparklesLeft" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="jumpTrailLeft" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpSparkleLeft" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpHeartsLeft" onAction="JUMPSTART|JUMPDOUBLE"/>
      <ParticleSystemUpdate name="sparklesRight" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="jumpTrailRight" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpSparkleRight" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpHeartsRight" onAction="JUMPSTART|JUMPDOUBLE"/>
      <ParticleSystemUpdate name="randomWingSparklesLeft"/>
      <ParticleSystemUpdate name="randomWingSparklesRight"/>
    </AddClothingParticles>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="sparklesLeft"/>
      <ParticleSystemOff name="jumpTrailLeft"/>
      <ParticleSystemOff name="jumpSparkleLeft"/>
      <ParticleSystemOff name="jumpHeartsLeft"/>
      <ParticleSystemOff name="sparklesRight"/>
      <ParticleSystemOff name="jumpTrailRight"/>
      <ParticleSystemOff name="jumpSparkleRight"/>
      <ParticleSystemOff name="jumpHeartsRight"/>
      <ParticleSystemOff name="randomWingSparklesLeft"/>
      <ParticleSystemOff name="randomWingSparklesRight"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_back" fileName="game/particles_large18.rttex" textureSize="64" frame="7,13" />
    <Sprite name="s_front" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="30,10" />
    <Sprite name="s_popcorn" fileName="game/particles12.rttex" textureSize="32" frame="10,22" />
    <Sprite name="s_flash" fileName="game/particles12.rttex" textureSize="32" frame="12,22" />
    
    <Animations>
      <SpriteAnimation name="a_back" sprite="s_back" animTime="800" autoPlay="true" isLoop="true">
        <Frame>7,13</Frame>
        <Frame>8,13</Frame>
        <Frame>9,13</Frame>
        <Frame>10,13</Frame>
        <Frame>11,13</Frame>
        <Frame>12,13</Frame>
        <Frame>13,13</Frame>
        <Frame>14,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_popcorn" sprite="s_popcorn" animTime="200">
        <Frame>10,22</Frame>
        <Frame>11,22</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <ParticleSystems>
      <ParticleSystem name="ps_flash" updateStage="AddClothingParticles" renderStage="RenderChestBackItem" updateState="Action.Punch">
        <Emitter>
          <Set name="offset">0, -32</Set>
          <Set name="enable">true</Set>
          <Set name="offsetFacing">false</Set>
          <Set name="emissionInterval">0.4</Set>
          <Set name="useCharacterPos">false</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_flash</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="lifeTime">0.1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-16,-8" max="16,0"/>
          <OnFinish>
            <ParticleSystemName>ps_popcorn</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_popcorn">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0,0</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_popcorn</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="useGravity">true</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="-180" max="180"/>
          <Random name="initialScale" min="0.5" max="1"/>
          <RandomRadial name="initialVelocity" angleRange="225,315" radiusRange="60,100"/>
          <Set name="gravityVector">0, 90</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="UserNameOffset">8</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderChestBackItem>
      <SpriteRender name="s_back" drawShadow="false" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
    </RenderChestBackItem>
    <RenderChestItem>
      <SpriteRender name="s_front" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
    </RenderChestItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_BaseMantle" fileName="game/particles_large17.rttex" textureSize="64" frame="7,13" />
		<Sprite name="s_Shoulderpiece" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="19,9" />
		<Sprite name="s_Rainbow" fileName="game/particles12.rttex" textureSize="32" frame="27,12" />
		<Sprite name="s_LensFlare" fileName="game/particles_large17.rttex" textureSize="64" frame="8,13" />
		<ParticleSystems>
			<ParticleSystem name="ps_Rainbow">
				<Emitter>
					<Set name="offset">-2,-32</Set>
					<Set name="emissionInterval">1.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Rainbow</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="initialScale">1,1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">2</Set>
					<Set name="inSpecificOrder">true</Set>
					<Random name="initialRotationRate" min="30" max="45"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_LensFlare">
				<Emitter>
					<Set name="particlesPerEmission">3</Set>
					<Set name="offset">8,-22</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_LensFlare</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-10,-10" max="10,10" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5,0.5</KeyFrame>
						<KeyFrame>1, 2.6,2.6</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="0" max="360"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<AddClothingParticles>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
				<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemUpdate name="ps_Rainbow"/>
			<ParticleSystemUpdate name="ps_LensFlare" onAction="JUMPDOUBLE"/>
		</AddClothingParticles>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<SpriteRender name="s_BaseMantle" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_Rainbow" />
			<ParticleSystemRender name="ps_LensFlare"/>
		</RenderBehind>
		<RenderChestItem>
			<SpriteRender name="s_Shoulderpiece" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
		</RenderChestItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="mario_idle" fileName="game/nintendo/mario_idle.rttex" textureSize="256"/>
		<Sprite name="mario_punch" fileName="game/nintendo/mario_punch.rttex" textureSize="256"/>
		<Sprite name="mario_walk" fileName="game/nintendo/mario_walk.rttex" textureSize="256"/>
		<Sprite name="mario_jump" fileName="game/nintendo/mario_jump_fall.rttex" textureSize="256"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>			
			<SpriteAnimation name="mario_Idle_Animation" playOnState="Motion.Idle" sprite="mario_idle" animTime="1020" isLoop="true">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame><Frame>4,0</Frame><Frame>5,0</Frame><Frame>6,0</Frame><Frame>7,0</Frame>		
				<Frame>0,1</Frame><Frame>1,1</Frame><Frame>2,1</Frame><Frame>3,1</Frame><Frame>4,1</Frame><Frame>5,1</Frame><Frame>6,1</Frame><Frame>7,1</Frame>				
				<Frame>0,2</Frame><Frame>1,2</Frame><Frame>2,2</Frame><Frame>3,2</Frame><Frame>4,2</Frame><Frame>5,2</Frame><Frame>6,2</Frame><Frame>7,2</Frame>	
				<Frame>0,3</Frame><Frame>1,3</Frame><Frame>2,3</Frame><Frame>3,3</Frame><Frame>4,3</Frame><Frame>5,3</Frame><Frame>6,3</Frame><Frame>7,3</Frame>		
				<Frame>0,4</Frame><Frame>1,4</Frame><Frame>2,4</Frame><Frame>3,4</Frame><Frame>4,4</Frame><Frame>5,4</Frame><Frame>6,4</Frame><Frame>7,4</Frame>		
				<Frame>0,5</Frame><Frame>1,5</Frame><Frame>2,5</Frame><Frame>3,5</Frame><Frame>4,5</Frame><Frame>5,5</Frame><Frame>6,5</Frame><Frame>7,5</Frame>			
				<Frame>0,6</Frame><Frame>1,6</Frame><Frame>2,6</Frame><Frame>3,6</Frame><Frame>4,6</Frame><Frame>5,6</Frame><Frame>6,6</Frame><Frame>7,6</Frame>			
				<Frame>0,7</Frame><Frame>1,7</Frame><Frame>2,7</Frame><Frame>3,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="mario_Punch_Animation" playOnState="Motion.Punch" sprite="mario_punch" animTime="400" isLoop="true">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame><Frame>4,0</Frame><Frame>5,0</Frame><Frame>6,0</Frame><Frame>7,0</Frame>		
				<Frame>0,1</Frame><Frame>1,1</Frame><Frame>2,1</Frame><Frame>3,1</Frame><Frame>4,1</Frame><Frame>5,1</Frame><Frame>6,1</Frame><Frame>7,1</Frame>				
				<Frame>0,2</Frame><Frame>1,2</Frame><Frame>2,2</Frame><Frame>3,2</Frame><Frame>4,2</Frame><Frame>5,2</Frame><Frame>6,2</Frame><Frame>7,2</Frame>	
				<Frame>0,3</Frame><Frame>1,3</Frame><Frame>2,3</Frame><Frame>3,3</Frame><Frame>4,3</Frame><Frame>5,3</Frame><Frame>6,3</Frame><Frame>7,3</Frame>		
				<Frame>0,4</Frame><Frame>1,4</Frame><Frame>2,4</Frame><Frame>3,4</Frame><Frame>4,4</Frame><Frame>5,4</Frame><Frame>6,4</Frame><Frame>7,4</Frame>		
				<Frame>0,5</Frame><Frame>1,5</Frame><Frame>2,5</Frame><Frame>3,5</Frame><Frame>4,5</Frame><Frame>5,5</Frame><Frame>6,5</Frame><Frame>7,5</Frame>			
				<Frame>0,6</Frame><Frame>1,6</Frame><Frame>2,6</Frame><Frame>3,6</Frame><Frame>4,6</Frame><Frame>5,6</Frame><Frame>6,6</Frame><Frame>7,6</Frame>			
				<Frame>0,7</Frame><Frame>1,7</Frame><Frame>2,7</Frame><Frame>3,7</Frame><Frame>4,7</Frame><Frame>5,7</Frame><Frame>6,7</Frame><Frame>7,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="mario_Jump_Animation" playOnState="Motion.Jump" sprite="mario_jump" animTime="400">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame><Frame>4,0</Frame><Frame>5,0</Frame><Frame>6,0</Frame><Frame>7,0</Frame><Frame>8,0</Frame><Frame>9,0</Frame><Frame>10,0</Frame>
				<Frame>0,1</Frame><Frame>1,1</Frame><Frame>2,1</Frame><Frame>3,1</Frame><Frame>4,1</Frame><Frame>5,1</Frame><Frame>6,1</Frame><Frame>7,1</Frame><Frame>8,1</Frame><Frame>9,1</Frame><Frame>10,1</Frame>
				<Frame>0,2</Frame><Frame>1,2</Frame><Frame>2,2</Frame><Frame>3,2</Frame><Frame>4,2</Frame><Frame>5,2</Frame><Frame>6,2</Frame><Frame>7,2</Frame><Frame>8,2</Frame><Frame>9,2</Frame><Frame>10,2</Frame>
				<Frame>0,3</Frame><Frame>1,3</Frame><Frame>2,3</Frame><Frame>3,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="mario_Fall_Animation" playOnState="Motion.Fall" sprite="mario_jump" animTime="400">
				<Frame>5,3</Frame><Frame>6,3</Frame><Frame>7,3</Frame><Frame>8,3</Frame><Frame>9,3</Frame><Frame>10,3</Frame>
				<Frame>0,4</Frame><Frame>1,4</Frame><Frame>2,4</Frame><Frame>3,4</Frame><Frame>4,4</Frame><Frame>5,4</Frame><Frame>6,4</Frame><Frame>7,4</Frame><Frame>8,4</Frame><Frame>9,4</Frame><Frame>10,4</Frame>
				<Frame>0,5</Frame><Frame>1,5</Frame><Frame>2,5</Frame><Frame>3,5</Frame><Frame>4,5</Frame><Frame>5,5</Frame><Frame>6,5</Frame><Frame>7,5</Frame><Frame>8,5</Frame><Frame>9,5</Frame><Frame>10,5</Frame>
				<Frame>0,6</Frame><Frame>1,6</Frame><Frame>2,6</Frame><Frame>3,6</Frame><Frame>4,6</Frame><Frame>5,6</Frame><Frame>6,6</Frame><Frame>7,6</Frame><Frame>8,6</Frame><Frame>9,6</Frame><Frame>10,6</Frame>
				<Frame>0,7</Frame><Frame>1,7</Frame><Frame>2,7</Frame><Frame>3,7</Frame><Frame>4,7</Frame><Frame>5,7</Frame><Frame>6,7</Frame><Frame>7,7</Frame><Frame>8,7</Frame><Frame>9,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="mario_Walk_Animation" playOnState="Motion.Move" sprite="mario_walk" animTime="400" isLoop="true">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame><Frame>4,0</Frame><Frame>5,0</Frame><Frame>6,0</Frame><Frame>7,0</Frame>		
				<Frame>0,1</Frame><Frame>1,1</Frame><Frame>2,1</Frame><Frame>3,1</Frame><Frame>4,1</Frame><Frame>5,1</Frame><Frame>6,1</Frame><Frame>7,1</Frame>				
				<Frame>0,2</Frame><Frame>1,2</Frame><Frame>2,2</Frame><Frame>3,2</Frame><Frame>4,2</Frame><Frame>5,2</Frame><Frame>6,2</Frame><Frame>7,2</Frame>	
				<Frame>0,3</Frame><Frame>1,3</Frame><Frame>2,3</Frame><Frame>3,3</Frame><Frame>4,3</Frame><Frame>5,3</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">30</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="mario_idle" offset="0,-10040" drawShadow="true" onState="Motion.Idle" scale="0.4,0.4"/>
			<SpriteRender name="mario_punch" offset="0,-10040" drawShadow="true" onState="Motion.Punch" scale="0.4,0.4"/>
			<SpriteRender name="mario_walk" offset="0,-10040" drawShadow="true" onState="Motion.Move" scale="0.4,0.4"/>
			<SpriteRender name="mario_jump" offset="0,-10040" drawShadow="true" onState="Motion.Jump" scale="0.4,0.4"/>
            <SpriteRender name="mario_jump" offset="0,-10040" drawShadow="true" onState="Motion.Fall" scale="0.4,0.4"/>
			
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Projectile" fileName="game/particles12.rttex" textureSize="32" frame="18,12" />
		<Sprite name="s_ProjectileHit" fileName="game/particles12.rttex" textureSize="32" frame="20,12" />
		<Sprite name="s_Shirt" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="17,4" />
		<Sprite name="s_ShirtGlow" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="16,4" />
		<Sprite name="s_ShirtPunch" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="18,4" />
		<Sprite name="s_Transform" fileName="game/tf_page4.rttex" textureSize="64" frame="0,9" />
		<Sprite name="s_flash" fileName="game/tf_page4.rttex" textureSize="64" frame="15,9" />
		<Sprite name="s_shard" fileName="game/particles7.rttex" textureSize="32" frame="10,14" />
		<VariableMap>
			<Set name="projectileOffset">0,-16</Set>
			<Set name="DeltaTime">0</Set>
			<Set name="AirTimer">5</Set>
		</VariableMap>
		<Animations>
			<SpriteCurveAnimation name="a_ShirtGlow" sprite="s_ShirtGlow" isLoop="true" autoPlay="true" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_Projectile" sprite="s_Projectile" animTime="400">
				<Frame>19,12</Frame>
				<Frame>18,12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_AirPunch" sprite="s_Transform" animTime="400" isLoop="true" playOnState="Main.AirPunch">
				<Frame>4,10</Frame>
				<Frame>5,10</Frame>
				<Frame>6,10</Frame>
				<Frame>7,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_LandIdle" sprite="s_Transform" animTime="1600" isLoop="true" playOnState="Main.LandIdle">
				<Frame>0,9</Frame>
				<Frame>1,9</Frame>
				<Frame>2,9</Frame>
				<Frame>3,9</Frame>
				<Frame>4,9</Frame>
				<Frame>5,9</Frame>
				<Frame>6,9</Frame>
				<Frame>7,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_LandMove" sprite="s_Transform" animTime="600" isLoop="true" playOnState="Main.LandMove">
				<Frame>8,9</Frame>
				<Frame>9,9</Frame>
				<Frame>10,9</Frame>
				<Frame>11,9</Frame>
				<Frame>12,9</Frame>
				<Frame>13,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_LandPunch" sprite="s_Transform" animTime="100" isLoop="true" playOnState="Main.LandPunch">
				<Frame>14,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_ToAir" sprite="s_Transform" animTime="600" playOnState="Main.TransformToAir">
				<Frame>10,10</Frame>
				<Frame>9,10</Frame>
				<Frame>8,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_Air" sprite="s_Transform" animTime="400" isLoop="true" playOnState="Main.Air|Main.AirUp">
				<Frame>0,10</Frame>
				<Frame>1,10</Frame>
				<Frame>2,10</Frame>
				<Frame>3,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Transform_ToGround" sprite="s_Transform" animTime="600" playOnState="Main.TransformToLand">
				<Frame>8,10</Frame>
				<Frame>9,10</Frame>
				<Frame>11,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_shards" sprite="s_shard" animTime="200">
				<Frame>10,14</Frame>
				<Frame>11,14</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_Projectile1">
				<Emitter>
					<Set name="offset" source="projectileOffset" />
					<Set name="lifeTime">0</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="infLifeTime">false</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">0</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Projectile</Set>
					<Set name="offset">8, 0</Set>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Random name="targetPosOffset" min="-8, -8" max="8, 8" />
					<Select name="finalAlpha" input="punchCount">
						<Item>1.4</Item>
						<Item>1</Item>
						<Item>1.4</Item>
					</Select>
					<Set name="lifeTime">0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="finalAlpha" angle="initialAngle" />
					<VectorTo name="finalVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="finalAlpha" angle="finalAngle" />
					<Select name="initialAngle" input="punchCount">
						<Item>45</Item>
						<Item>0</Item>
						<Item>-45</Item>
					</Select>
					<Select name="finalAngle" input="punchCount">
						<Item>-45</Item>
						<Item>0</Item>
						<Item>45</Item>
					</Select>
					<OnFinish>
						<ParticleSystemName>ps_ProjectileHit</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Projectile2">
				<Emitter>
					<Set name="offset" source="projectileOffset" />
					<Set name="lifeTime">0</Set>
					<Set name="emissionInterval">0</Set>
					<Set name="infParticles">false</Set>
					<Set name="infLifeTime">false</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">0</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Projectile</Set>
					<Set name="offset">-8, 0</Set>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Random name="targetPosOffset" min="-8, -8" max="8, 8" />
					<Select name="finalAlpha" input="punchCount">
						<Item>1</Item>
						<Item>1.4</Item>
						<Item>1.4</Item>
					</Select>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="finalAlpha" angle="initialAngle" />
					<VectorTo name="finalVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="finalAlpha" angle="finalAngle" />
					<Select name="initialAngle" input="punchCount">
						<Item>0</Item>
						<Item>-45</Item>
						<Item>45</Item>
					</Select>
					<Select name="finalAngle" input="punchCount">
						<Item>0</Item>
						<Item>45</Item>
						<Item>-45</Item>
					</Select>
					<OnFinish>
						<ParticleSystemName>ps_ProjectileHit</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_ProjectileHit">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_ProjectileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="360" />
					<Select name="initialRotationRate" input="randomNumber">
						<Item>-720</Item>
						<Item>720</Item>
					</Select>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_flash" updateStage="AddClothingParticles" updateState="IsTransformed.Changing">
				<Emitter>
					<Set name="offset">0, -24</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true" usePlayerFacing="true">
					<Set name="sprite">s_flash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1.25, 1.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_flashShards" updateStage="AddClothingParticles" updateState="IsTransformed.Changing">
				<Emitter>
					<Set name="offset">0, -32</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">16</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" usePlayerFacing="true" usePlayerFacing="true">
					<Set name="sprite">s_shard</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.8, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5, 0.5</Set>
					<Set name="lifeTime">0.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="120,170" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="IsTransformed">
				<States>
					<State name="No" />
					<State name="Yes" />
					<State name="Changing" />
				</States>
				<Transitions>
					<Transition to="Yes" from="Changing">
						<Condition>
							<IsItemTransformed>true</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="No" from="Changing">
						<Condition>
							<IsItemTransformed>false</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="Changing" from="Yes">
						<Condition>
							<IsItemTransformed>false</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="Changing" from="No">
						<Condition>
							<IsItemTransformed>true</IsItemTransformed>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Main">
				<States>
					<State name="LandIdle" />
					<State name="LandMove" />
					<State name="TransformToAir" ExitTime="0.6" />
					<State name="Air"/>
					<State name="AirUp"/>
					<State name="TransformToLand" ExitTime="0.6" />
					<State name="LandPunch" />
					<State name="AirPunch" />
				</States>
				<Transitions>
					<Transition to="LandMove" from="LandIdle|LandPunch|TransformToLand">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="LandIdle" from="LandMove|LandPunch|TransformToLand">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="LandPunch" from="LandIdle|LandMove|AirPunch|TransformToLand">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<CompareCustomVariable operatorType="Less" VariableNameToCompare="AirTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="TransformToAir" from="LandIdle|LandMove">
						<Condition>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Air" from="TransformToAir|AirPunch|AirUp">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<CompareCustomVariable operatorType="Greater" VariableNameToCompare="AirTimer">0</CompareCustomVariable>
							<IsVariableFloat name="speed.y" operator="Greater">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="AirUp" from="Air">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="TransformToLand" from="Air|AirUp">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<CompareCustomVariable operatorType="Less" VariableNameToCompare="AirTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
					<Transition to="AirPunch" from="Air|AirUp|LandPunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<CompareCustomVariable operatorType="Greater" VariableNameToCompare="AirTimer">0</CompareCustomVariable>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions />
	</Data>
	<RenderRules>
		<Update>
			<Group onState="IsTransformed.Yes">
				<StopIf type="or">
					<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				</StopIf>
				<ArithmethicOperation LeftHandVariableName="AirTimer" RightHandVariableName="5" OperationType="Set" onState="Main.TransformToAir|Main.AirUp" />
				<ArithmethicOperation LeftHandVariableName="AirTimer" RightHandVariableName="DeltaTime" OperationType="Substract" onState="Main.Air" />
			</Group>
		</Update>
		<OnPunchStart>
			<Group onState="IsTransformed.Yes">
				<ArithmethicOperation LeftHandVariableName="projectileOffset" RightHandVariableName="8,-26" OperationType="Set" onState="Main.LandPunch" />
				<ArithmethicOperation LeftHandVariableName="projectileOffset" RightHandVariableName="8,-24" OperationType="Set" onState="Main.AirPunch" />
			</Group>
			<Group onState="IsTransformed.No">
				<ArithmethicOperation LeftHandVariableName="projectileOffset" RightHandVariableName="8,-18" OperationType="Set" />
			</Group>
			<ParticleSystemUpdate name="ps_Projectile2" />
			<ParticleSystemUpdate name="ps_Projectile1" />
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">60</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-60</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderTransform>
			<Translate>0,-8,0</Translate>
			<SpriteRender name="s_Transform" blend="NORMAL" alignment="CENTER" drawShadow="true" />
		</RenderTransform>
		<RenderShirt>
			<Group onState="Punch.No">
				<SpriteRender name="s_Shirt" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
				<SpriteRender name="s_ShirtGlow" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
			</Group>
			<Group onState="Punch.Yes">
				<SpriteRender name="s_ShirtPunch" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
			</Group>
		</RenderShirt>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_chest" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="24,3"/>
    <Sprite name="s_glow" fileName="game/particles_large17.rttex" textureSize="64" frame="9,3"/>
    <Sprite name="s_snowflake" fileName="game/particles12.rttex" textureSize="32" frame="23,11"/>
    <Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="24,11"/>
    <Sprite name="s_flash" fileName="game/particles12.rttex" textureSize="32" frame="26,11"/>
    <Sprite name="s_outline" fileName="game/particles_large17.rttex" textureSize="64" frame="8,3"/>
    <Sprite name="s_death" fileName="game/particles_large17.rttex" textureSize="64" frame="8,2" />

    <Animations>
      <SpriteAnimation name="a_trail" sprite="s_trail" isLoop="true" animTime="300">
        <Frame>24,11</Frame>
        <Frame>25,11</Frame>
      </SpriteAnimation>
      <CurveAnimationFloat name="snowflake_angle_rotation" autoPlay="true" isLoop="true" animTime="4000">
        <Curve name="snowflake_angle">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, 360</KeyFrame>
        </Curve>
      </CurveAnimationFloat>
      <SpriteAnimation name="a_death" sprite="s_death" animTime="1200">
        <Frame>15,2</Frame>
        <Frame>8,2</Frame>
        <Frame>9,2</Frame>
        <Frame>10,2</Frame>
        <Frame>11,2</Frame>
        <Frame>12,2</Frame>
        <Frame>13,2</Frame>
        <Frame>14,2</Frame>
		<Frame>15,2</Frame>
		<Frame>14,2</Frame>
		<Frame>15,2</Frame>
		<Frame>14,2</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="IsDying">
        <States>
          <State name="False" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>DIE</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">DIE</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <VariableMap>
      <Set name="snowflake_angle">0</Set>
    </VariableMap>

    <ParticleSystems>
      <ParticleSystem name="ps_snowflake">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_snowflake</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.05</Set>
          <Set name="initialAngle" source="snowflake_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_snowflake1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.01</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_snowflake</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.05</Set>
          <Set name="initialAngle" source="snowflake_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_trail1">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">5000</Set>
            <Set name="hAmplitude">18</Set>
            <Set name="hTimeOffset">2500</Set>
            <Set name="vAmplitude">10</Set>
            <Set name="vOrbitPeriod">5000</Set>
            <Set name="vTimeOffset">2500</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">0.6,0.6</Set>
          <Random name="finalScale" min="0.1" max="0.3" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_flash">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_flash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="relativeToEmitter">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.4, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 2, 2</KeyFrame>
            <KeyFrame>1, 2.5, 2.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_flashOutline" renderStage="RenderChestItem">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_outline</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="relativeToEmitter">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.4, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_deathSplash" updateStage="OnKilled" renderStage="RenderBehind">
        <Emitter>
          <Set name="lifeTime">1.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-24</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_death</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
		  <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">1.2</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="HideAvatarOnDeath">true</Set>
        <Set name="HideAngelOnDeath">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderInFront>
        <StopIf>
          <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
        </StopIf>
        <ParticleSystemRender name="ps_snowflake" onState="IsDying.False"/>
        <ParticleSystemRender name="ps_trail" onState="IsDying.False"/>
        <ParticleSystemRender name="ps_snowflake1" onState="IsDying.False"/>
        <ParticleSystemRender name="ps_trail1" onState="IsDying.False"/>
    </RenderInFront>
    <AddClothingParticles>
        <StopIf>
          <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
        </StopIf>
        <ParticleSystemUpdate name="ps_trail" onState="IsDying.False"/>
        <ParticleSystemUpdate name="ps_snowflake" onState="IsDying.False"/>
        <ParticleSystemUpdate name="ps_trail1" onState="IsDying.False"/>
        <ParticleSystemUpdate name="ps_snowflake1" onState="IsDying.False"/>
        <ParticleSystemUpdate name="ps_flash" onAction="JUMPDOUBLE" onState="IsDying.False"/>
        <ParticleSystemUpdate name="ps_flashOutline" onAction="JUMPDOUBLE" onState="IsDying.False"/>
    </AddClothingParticles>
    <RenderChestItem>
      <SpriteRender name="s_chest" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
    </RenderChestItem>
    <RenderChestBackItem>
      <SpriteRender name="s_glow" blend="PREMULTIPLIED_ALPHA" offset="0,-16" drawShadow="false" onState="IsDying.False" />
    </RenderChestBackItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_MECHA_SHARKJIRA">
  <Data>
    <StateMachines>
      <StateMachine name="playerState">
        <States>
          <State name="Idle"/>
          <State name="Move"/>
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition from="Idle|Punch" to="Move" >
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Move|Punch" to="Idle" >
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Idle|Move" to="Punch">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="trailParticleState">
        <States>
          <State name="Idle"/>
          <State name="Move"/>
        </States>
        <Transitions>
          <Transition from="Idle" to="Move" >
            <Condition>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Move" to="Idle" >
            <Condition>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Sprite name="foot1_sprite" fileName="game/player_feet_large1.rttex" textureSize="64"/>
    <Sprite name="foot2_sprite" fileName="game/player_feet_large1.rttex" textureSize="64"/>
    <Sprite name="trail_sprite" fileName="game/particles11.rttex" textureSize="32"/>
    <Sprite name="punch_laser_sprite" fileName="game/particles11.rttex" textureSize="32" frame="23,17"/>
    <Sprite name="plasma_sprite" fileName="game/particles11.rttex" textureSize="32" frame="25,17"/>
    <Sprite name="break_sprite" fileName="game/particles11.rttex" textureSize="32"/>
    <Sprite name="Hit_fx_Sprite" fileName="game/particles_large12.rttex" textureSize="64"/>

    <Animations>
      <SpriteCurveAnimation name="plasma_anim" sprite="plasma_sprite" animTime="500" isLoop="true" playOnState="playerState.Punch">
        <Curve name="scale">
          <KeyFrame>0.f, 0.1f, 0.75f</KeyFrame>
          <KeyFrame>0.5f, 0.75f, 0.5f</KeyFrame>
          <KeyFrame>1.f, 1.25f, 0.75f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="foot1_idle_anim" sprite="foot1_sprite" animTime="1500" isLoop="true" playOnState="playerState.Idle">
        <Frame>0, 6</Frame>
        <Frame>1, 6</Frame>
        <Frame>2, 6</Frame>
        <Frame>3, 6</Frame>
        <Frame>4, 6</Frame>
        <Frame>5, 6</Frame>
        <Frame>6, 6</Frame>
        <Frame>7, 6</Frame>
        <Frame>8, 6</Frame>
        <Frame>9, 6</Frame>
        <Frame>10, 6</Frame>
        <Frame>11, 6</Frame>
        <Frame>12, 6</Frame>
        <Frame>13, 6</Frame>
        <Frame>14, 6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="foot2_idle_anim" sprite="foot2_sprite" animTime="1500" isLoop="true" playOnState="playerState.Idle">
        <Frame>0, 7</Frame>
        <Frame>1, 7</Frame>
        <Frame>2, 7</Frame>
        <Frame>3, 7</Frame>
        <Frame>4, 7</Frame>
        <Frame>5, 7</Frame>
        <Frame>6, 7</Frame>
        <Frame>7, 7</Frame>
        <Frame>8, 7</Frame>
        <Frame>9, 7</Frame>
        <Frame>10, 7</Frame>
        <Frame>11, 7</Frame>
        <Frame>12, 7</Frame>
        <Frame>13, 7</Frame>
        <Frame>14, 7</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="foot1_move_anim" sprite="foot1_sprite" animTime="1500" isLoop="true" playOnState="playerState.Move">
        <Frame>0, 8</Frame>
        <Frame>1, 8</Frame>
        <Frame>2, 8</Frame>
        <Frame>3, 8</Frame>
        <Frame>4, 8</Frame>
        <Frame>5, 8</Frame>
        <Frame>6, 8</Frame>
        <Frame>7, 8</Frame>
        <Frame>8, 8</Frame>
        <Frame>9, 8</Frame>
        <Frame>10, 8</Frame>
        <Frame>11, 8</Frame>
        <Frame>12, 8</Frame>
        <Frame>13, 8</Frame>
        <Frame>14, 8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="foot2_move_anim" sprite="foot2_sprite" animTime="1500" isLoop="true" playOnState="playerState.Move">
        <Frame>0, 9</Frame>
        <Frame>1, 9</Frame>
        <Frame>2, 9</Frame>
        <Frame>3, 9</Frame>
        <Frame>4, 9</Frame>
        <Frame>5, 9</Frame>
        <Frame>6, 9</Frame>
        <Frame>7, 9</Frame>
        <Frame>8, 9</Frame>
        <Frame>9, 9</Frame>
        <Frame>10, 9</Frame>
        <Frame>11, 9</Frame>
        <Frame>12, 9</Frame>
        <Frame>13, 9</Frame>
        <Frame>14, 9</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="foot1_punch_anim" sprite="foot1_sprite" animTime="400" isLoop="true" playOnState="playerState.Punch">
        <Frame>0, 10</Frame>
        <Frame>1, 10</Frame>
        <Frame>2, 10</Frame>
        <Frame>3, 10</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="foot2_punch_anim" sprite="foot2_sprite" animTime="400" isLoop="true" playOnState="playerState.Punch">
        <Frame>0, 11</Frame>
        <Frame>1, 11</Frame>
        <Frame>2, 11</Frame>
        <Frame>3, 11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="trail_Sprites" autoPlay="false" sprite="trail_sprite">
        <Frame>26,17</Frame>
        <Frame>27,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="punch_laser_Sprites" autoPlay="false" sprite="punch_laser_sprite" animTime="200" isLoop="true" playOnState="playerState.Punch">
        <Frame>23,17</Frame>
        <Frame>24,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="hit_fx_Sprites" autoPlay="false" sprite="Hit_fx_Sprite">
        <Frame>14,4</Frame>
        <Frame>15,4</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="break_fx" autoPlay="false" animTime="500" sprite="break_sprite">
        <Frame>9,17</Frame>
        <Frame>10,17</Frame>
        <Frame>11,17</Frame>
        <Frame>12,17</Frame>
        <Frame>13,17</Frame>
        <Frame>14,17</Frame>
        <Frame>15,17</Frame>
        <Frame>16,17</Frame>
        <Frame>17,17</Frame>
        <Frame>18,17</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="trail_particle">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">10</Set>
          <Set name="emissionInterval">0.035</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="offset">-28,-20</Set>
          <Select name="rgbTint" input="intervalMS">
            <InputConfig>
              <Set name="timeMS">50</Set>
            </InputConfig>
            <Item>1,1,1</Item>
            <Item>0,1,0</Item>
          </Select>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">trail_sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialVelocity">0,0</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75,0.75</KeyFrame>
            <KeyFrame>1, 2,2</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="hit_particle">
        <Emitter>
          <Set name="lifeTime">0.3</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">Hit_fx_Sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1</Set>
          <Random name="initialAngle" min="-75" max="75"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75,0.75</KeyFrame>
            <KeyFrame>0.5, 1.25,1.25</KeyFrame>
            <KeyFrame>1, 1.25,1.25</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="break_particle">
        <Emitter>
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">break_sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Set name="initialRotationRate">360</Set>
          <Set name="initialScale">2,2</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">SHOES</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IsSurfboard">true</Set>
        <Set name="IsVehicle">true</Set>
        <Set name="IsRidingBird">true</Set>
        <Set name="ClothingOffsetFromShoes">-28</Set>
        <Set name="UserNameOffset">32</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
        <Set name="AllowChangePunchType">true</Set>
      </Default>
    </RenderOptions>

    <TileStampData>
      <Set name="FileName">game/particles11.rttex</Set>
      <Set name="EndFrame">22,17</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>
  </Data>

  <RenderRules>
    <RenderShoes>
      <SpriteRender name="foot1_sprite" offset="-3,-4" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="foot2_sprite" offset="-3,-4" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>

      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>

      <ParticleSystemUpdate name="trail_particle" onState="trailParticleState.Move"/>
      <SpriteRender name="plasma_sprite" offset="30,4" onState="playerState.Punch" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0"/>
      <SpriteRender name="punch_laser_sprite" offset="30,4" onState="playerState.Punch" blend="PREMULTIPLIED_ALPHA" stretchToTarget="true" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" flip="1,0"/>
    </RenderShoes>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="trail_particle"/>
    </SwitchOffClothingParticles>
    <Update>
      <StopIf type="or">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
        <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
    </Update>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="hit_particle"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="break_particle"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_tankFoot1" fileName="game/player_feet16.rttex" textureSize="32" frame="2,28"/>
		<Sprite name="s_tankFoot2" fileName="game/player_feet16.rttex" textureSize="32" frame="2,29"/>
		<Sprite name="s_mechBody" fileName="game/particles_large19.rttex" textureSize="64" frame="5,1"/>
		<Sprite name="s_tankGun" fileName="game/particles12.rttex" textureSize="32" frame="17,24"/>
		<Sprite name="s_mechGun" fileName="game/particles12.rttex" textureSize="32" frame="17,23"/>
		<Sprite name="s_flash" fileName="game/particles10.rttex" textureSize="32" frame="31,10"/>

		<Sprite name="s_MuzzleFlash" fileName="game/particles10.rttex" textureSize="32" frame="31,10"/>
		<Sprite name="s_Projectile" fileName="game/particles12.rttex" textureSize="32" frame="25,23"/>
		<Sprite name="s_ProjectileHit" fileName="game/particles12.rttex" textureSize="32" frame="26,23"/>
		<Animations>
			<SpriteAnimation name="a_mechBody_move" sprite="s_mechBody" animTime="600" isLoop="true" playOnState="Movement.Move">
				<Frame>7,1</Frame>
				<Frame>8,1</Frame>
				<Frame>9,1</Frame>
				<Frame>10,1</Frame>
				<Frame>11,1</Frame>
				<Frame>12,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_mechBody_jump" sprite="s_mechBody" animTime="600" isLoop="true" playOnState="Movement.Jump">
				<Frame>14,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_mechBody_fall" sprite="s_mechBody" animTime="600" isLoop="true" playOnState="Movement.Fall">
				<Frame>13,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_mechBody_idle" sprite="s_mechBody" animTime="600" isLoop="true" playOnState="Movement.Idle">
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_tankFoot1_move" sprite="s_tankFoot1" animTime="600" isLoop="true" playOnState="Movement.Move">
				<Frame>2,28</Frame>
				<Frame>3,28</Frame>
				<Frame>4,28</Frame>
				<Frame>5,28</Frame>
				<Frame>6,28</Frame>
				<Frame>7,28</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_tankFoot2_move" sprite="s_tankFoot2" animTime="600" isLoop="true" playOnState="Movement.Move">
				<Frame>2,29</Frame>
				<Frame>3,29</Frame>
				<Frame>4,29</Frame>
				<Frame>5,29</Frame>
				<Frame>6,29</Frame>
				<Frame>7,29</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_mechGun_punch" sprite="s_mechGun" animTime="400" isLoop="true" playOnState="Action.Punch">
				<Frame>17,23</Frame>
				<Frame>18,23</Frame>
				<Frame>19,23</Frame>
				<Frame>20,23</Frame>
				<Frame>21,23</Frame>
				<Frame>22,23</Frame>
				<Frame>23,23</Frame>
				<Frame>24,23</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_mechGun_idle" sprite="s_mechGun" animTime="400" isLoop="true" playOnState="Action.None">
				<Frame>17,23</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_tankGun_punch" sprite="s_tankGun" animTime="400" isLoop="true" playOnState="Action.Punch">
				<Frame>17,24</Frame>
				<Frame>18,24</Frame>
				<Frame>19,24</Frame>
				<Frame>20,24</Frame>
				<Frame>21,24</Frame>
				<Frame>22,24</Frame>
				<Frame>23,24</Frame>
				<Frame>24,24</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_tankGun_idle" sprite="s_tankGun" animTime="400" isLoop="true" playOnState="Action.None">
				<Frame>17,24</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Mode">
				<States>
					<State name="Mech"/>
					<State name="Tank"/>
				</States>
				<Transitions>
					<Transition to="Tank" from="Mech">
						<Condition type="or">
							<ItemHasTag>TANK_MODE</ItemHasTag>
							<IsVariableBool name="isMannequin">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Mech" from="Tank">
						<Condition type="and">
							<ItemHasTag operatorType="NotEqual">TANK_MODE</ItemHasTag>
							<IsVariableBool name="isMannequin">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Movement">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_punchMech" secondary="ps_punchHit">
				<Emitter attachment="contextRotation">
					<Set name="lifeTime">0.072</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="0, -8" max="0, 8"/>
					<Set name="sprite">s_Projectile</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.2</Set>
					<Random name="targetPosOffset" min="-15, -8" max="15, 8"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchTank" secondary="ps_punchHit">
				<Emitter attachment="contextRotation">
					<Set name="lifeTime">0.072</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">2</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="0, -8" max="0, 8"/>
					<Set name="sprite">s_Projectile</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.2</Set>
					<Random name="targetPosOffset" min="-15, -8" max="15, 8"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchHit">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_ProjectileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.1</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Select name="initialRotationRate" input="randomNumber">
						<Item>-720</Item>
						<Item>720</Item>
					</Select>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchFlash1">
				<Emitter attachment="contextRotation">
					<Set name="offset">0, 0</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_flash</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.075</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchFlash2">
				<Emitter attachment="contextRotation">
					<Set name="offset">0, 0</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_flash</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.075</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="target.angle">0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="UserNameOffset">8</Set>
				<Set name="ClothingOffsetFromShoes">-15</Set>
				<Set name="RenderShoesWithMermaidTail">false</Set>
				<Set name="OnEquipTag">TANK_MODE</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="PunchSoundOverride">SHOES</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
			</Default>
			<Override overrideOnState="Mode.Tank">
				<Set name="UserNameOffset">0</Set>
				<Set name="ClothingOffsetFromShoes">-12</Set>
				<Set name="ShoesHidesBodyLegs">false</Set>
				<Set name="IsToRenderPants">true</Set>
			</Override>
		</RenderOptions>
	</Data>

	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<Group onState="Mode.Tank">
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
			</Group>
			<Group onState="Mode.Mech">
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">-50</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">-50</Set>
				</AvatarTransform>
			</Group>
		</Update>
		<RenderShoes>
			<Group onState="Mode.Tank">
				<SpriteRender name="s_tankFoot1" offset="0,12" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT" />
				<SpriteRender name="s_tankFoot2" offset="0,12" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT" />
				<Group>
					<Translate>16,-5,0</Translate>
					<SpriteRender name="s_tankGun" drawShadow="false"/>
					<Group onState="Action.Punch">
						<StopIf>
							<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
						</StopIf>
						<Group onState="Facing.Right">
							<Translate>3,4,0</Translate>
							<ParticleSystemUpdate name="ps_punchFlash1"/>
							<Translate>0,-10,0</Translate>
							<ParticleSystemUpdate name="ps_punchFlash2"/>
						</Group>
						<Group onState="Facing.Left">
							<Translate>3,3,0</Translate>
							<Rotate>180,0,0,1</Rotate>
							<ParticleSystemUpdate name="ps_punchFlash1"/>
						
							<Translate>0,10,0</Translate>
							<ParticleSystemUpdate name="ps_punchFlash2"/>
						</Group>
						<Translate>12,0, 0</Translate>
						<ParticleSystemUpdate name="ps_punchTank"/>
					</Group>
				</Group>
			</Group>
		</RenderShoes>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Group onState="Mode.Mech">
				<Group>
					<Translate>12,-9,0</Translate>
					<Group onState="Action.None">
						<Rotate onState="Movement.Idle">90,0,0,1</Rotate>
						<SpriteRender name="s_mechGun" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" />
					</Group>
					<Group onState="Action.Punch">
						<Rotate forceValue="true">target.angle</Rotate>
						<Rotate onState="Facing.Left">180,0,0,1</Rotate>
						<SpriteRender name="s_mechGun" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" />
						<StopIf>
							<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
						</StopIf>
						<Group onState="Facing.Right">
							<Translate>10,5, 0</Translate>
							<ParticleSystemUpdate name="ps_punchFlash1"/>
							<Translate>0,-10, 0</Translate>
							<ParticleSystemUpdate name="ps_punchFlash2"/>
						</Group>
						<Group onState="Facing.Left">
							<Translate>12,4,0</Translate>
							<Rotate>180,0,0,1</Rotate>
							<ParticleSystemUpdate name="ps_punchFlash1"/>
							<Translate>0,9,0</Translate>
							<ParticleSystemUpdate name="ps_punchFlash2"/>
						</Group>
						<Translate>15,0, 0</Translate>
						<ParticleSystemUpdate name="ps_punchMech"/>
					</Group>
				</Group>
				<SpriteRender name="s_mechBody" offset="0,15" alignment="DOWN_CENTER" />
			</Group>
		</RenderBehind>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_goggles" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="23,29" />
		<Sprite name="s_gun" fileName="game/pets/p_mechasaurus_rex.rttex" textureSize="32" frame="2,1" />
		<Sprite name="s_muzzleFlash" fileName="game/particles12.rttex" textureSize="32" frame="29,2" />
		<Sprite name="s_pet" fileName="game/pets/p_mechasaurus_rex.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="28,2" />
		<Sprite name="s_target" fileName="game/particles12.rttex" textureSize="32" frame="27,2" />
		<VariableMap>
			<Set name="target.angle">0</Set>
			<Set name="target.origin.offset">-16,-12,0</Set>
			<Set name="t0">-12,-12,0</Set>
			<Set name="t1">-4,0,0</Set>
		</VariableMap>
		<Animations>
			<SpriteAnimation name="a_gun" sprite="s_gun" animTime="300" isLoop="true" playOnState="Pet.Punch">
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_petFall" sprite="s_pet" animTime="100" playOnState="Pet.Down">
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_petIdle" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.None">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_petJump" sprite="s_pet" animTime="100" playOnState="Pet.Up">
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_petMove" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.Horizontal">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_petPunch" sprite="s_pet" animTime="100" playOnState="Pet.Punch">
				<Frame>1,1</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="None" />
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch|Up|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="Punch|None|Down|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="Punch|None|Up|Horizontal">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Punch|None|Down|Up">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None|Up|Down|Horizontal">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsVariableBool name="pet.facingLeft">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsVariableBool name="pet.facingLeft">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_muzzleFlash" updateState="Pet.Punch" renderStage="RenderPet">
				<Emitter attachment="contextRotation">
					<Set name="lifeTime">0.15</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_muzzleFlash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 0.7</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Set name="lifeTime">0.1</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punch" updateState="Pet.Punch" renderStage="RenderPet">
				<Emitter attachment="contextRotation">
					<Random name="offset" min="-4, -4" max="4, 4" />
					<Set name="lifeTime">0.1</Set>
					<Random name="emissionInterval" min="0.05" max="0.1" />
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Random name="targetPosOffset" min="-8, -8" max="8, 8" />
					<Set name="inSpecificOrder">true</Set>
					<Set name="lifeTime">0.2</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
					<OnFinish>
						<ParticleSystemName>ps_target</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_target">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_target</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.1</Set>
					<Random name="initialAngle" min="0" max="360" />
					<Select name="initialRotationRate" input="randomNumber">
						<Item>-720</Item>
						<Item>720</Item>
					</Select>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="DefaultPunchSound">audio/machinegun.wav</Set>
				<Set name="PetUpdatesFacing">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderHat>
			<Translate>0,-16,0</Translate>
			<SpriteRender name="s_goggles" alignment="DOWN_CENTER" />
		</RenderHat>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<UpdatePet>
			<ContextUpdate type="SetPetWalkRunJump">
				<Set name="PetWalkRunJump.minSpeed">500</Set>
				<Set name="PetWalkRunJump.distSpeedMult">20</Set>
			</ContextUpdate>
		</UpdatePet>
		<RenderPet>
			<SpriteRender name="s_pet" alignment="DOWN_CENTER" />
			<Group onState="Pet.Punch">
				<Translate>-10,-13,0</Translate>
				<Translate onState="Facing.Left">4,2,0</Translate>
				<Rotate forceValue="true">target.angle</Rotate>
				
				<Group onState="Facing.Right">
					<SpriteRender name="s_gun" alignment="LEFT_CENTER" />
					<Translate>12,2,0</Translate>
					<ParticleSystemUpdate name="ps_muzzleFlash" />
					<ParticleSystemUpdate name="ps_punch" />
				</Group>
				<Group onState="Facing.Left">
					<SpriteRender name="s_gun" flip="1,0" alignment="LEFT_CENTER" />
					<Translate>-17,2,0</Translate>
					<ParticleSystemUpdate name="ps_muzzleFlash" />
					<ParticleSystemUpdate name="ps_punch" />
				</Group>
			</Group>
		</RenderPet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_MERROWS_TAIL">
  <Data>
    <Sprite name="item_sprite" fileName="game/particles_large12.rttex" textureSize="64" frame="8,12"/>
    <Sprite name="aura_sprite" fileName="game/particles_large12.rttex" textureSize="64" frame="8,15"/>

    <Animations>
      <SpriteAnimation name="equip_anim" sprite="item_sprite" animTime="800" isLoop="true" playOnAction="IDLE">
        <Frame>8, 12</Frame>
        <Frame>9, 12</Frame>
        <Frame>10, 12</Frame>
        <Frame>11, 12</Frame>
        <Frame>12, 12</Frame>
        <Frame>13, 12</Frame>
        <Frame>14, 12</Frame>
        <Frame>15, 12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="punch_anim" sprite="item_sprite" animTime="400" isLoop="true" playOnAction="PUNCH">
        <Frame>8, 12</Frame>
        <Frame>9, 12</Frame>
        <Frame>10, 12</Frame>
        <Frame>11, 12</Frame>
        <Frame>12, 12</Frame>
        <Frame>13, 12</Frame>
        <Frame>14, 12</Frame>
        <Frame>15, 12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="move_anim" sprite="item_sprite" animTime="400" isLoop="true" playOnAction="WALK|JUMP|FALL">
        <Frame>11, 11</Frame>
        <Frame>12, 11</Frame>
        <Frame>13, 11</Frame>
        <Frame>14, 11</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="aura_anim" sprite="aura_sprite" animTime="800" isLoop="true" playOnAction="PUNCH">
        <Frame>8, 15</Frame>
        <Frame>9, 15</Frame>
        <Frame>10, 15</Frame>
        <Frame>11, 15</Frame>
        <Frame>12, 15</Frame>
        <Frame>13, 15</Frame>
        <Frame>14, 15</Frame>
        <Frame>15, 15</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">SHOES</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IsSurfboard">true</Set>
        <Set name="ClothingOffsetFromShoes">-7</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="UserNameOffset">8</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderShoes>
      <SpriteRender name="item_sprite" offset="0,-9" tintOverride="PANTS"/>
    </RenderShoes>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">JUMP_UP</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">120</Set>
        <Set name="pulseArmScale">5</Set>
        <Set name="pulseArmRate">250</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-120</Set>
        <Set name="pulseArmScale">5</Set>
        <Set name="pulseArmRate">250</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderBehind value="playerCenter">
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="aura_sprite" offset="0,-20" onAction="PUNCH"/>
    </RenderBehind>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
		  <IsSitting>true</IsSitting>
      </StopIf>
      <AvatarTransform class="ArmAngle" onAction="IDLE">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">45</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onAction="IDLE">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">310</Set>
      </AvatarTransform>
    </Update>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Glove" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="15,22" />
		<Sprite name="s_Pet" fileName="game/pets/p_leag.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_PetPunch" fileName="game/pets/p_leag.rttex" textureSize="32" frame="0,0" />
		<Animations>
			<SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="600" isLoop="true" playOnState="Pet.Idle">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PetMoving" sprite="s_Pet" animTime="600" isLoop="true" playOnState="Pet.Moving">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PetPunch" sprite="s_PetPunch" animTime="600" isLoop="true" playOnState="Player.Punch">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Pet">
				<States>
					<State name="Idle" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving">
						<Condition>
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle">
						<Condition>
							<IsVariableFloat name="pet.velocity.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Player">
				<States>
					<State name="Idle"/>
					<State name="Sleep"/>
					<State name="Punch"/>
					<State name="Dance"/>
					<State name="Move"/>
				</States>
				<Transitions>
					<Transition to="Sleep" from="Idle|Punch|Dance|Move">
						<Condition type="or">
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Idle" from="Punch|Sleep|Dance|Move">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Sleep|Dance|Move">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Idle|Sleep|Punch|Move">
						<Condition>
							<IsAction>DANCE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|Sleep|Punch|Dance">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-20,0</Set>
				<Set name="UsePetForceFaceTime">false</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<SpriteRender flip="0,0" name="s_Glove" offset="0,16" rotateOffset="true" rotationPoint="0,1"/>
		</RenderHandItem>
		<RenderPet>
			<SpriteRender name="s_Pet" offset="0,-6" onState="Player.Idle|Player.Sleep|Player.Dance|Player.Move"/>
			<SpriteRender name="s_PetPunch" offset="0,-6" onState="Player.Punch"/>
		</RenderPet>
		<Update>
			<AvatarTransform class="ArmAngle" onState="Player.Idle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">90</Set>
			</AvatarTransform>
		</Update>
		<UpdatePet>
			<ContextUpdate type="SetPetFlySit">
				<Set name="PetFlySit.speed">100</Set>
				<Set name="PetFlySit.offset">-12,-14</Set>
				<Set name="PetFlySit.flyTime">2</Set>
			</ContextUpdate>
		</UpdatePet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<RenderRules>
		<RenderInFront>
			<SpriteRender name="p_item" offset="2,-9996" scale="0.2,0.2" alignment="DOWN_CENTER"
				onState="Action1.Punch" />
			<StopIf type="and">
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<SpriteRender name="s_item" offset="2,-9996" scale="0.2,0.2" alignment="DOWN_CENTER" />
		</RenderInFront>
		
    	<OnPunchStart><!--DEAD-->   
	    	<ParticleSystemUpdate name="punch_particle"/><!--DEAD-->   
    	</OnPunchStart>        

		<AddClothingParticles>
    </AddClothingParticles>
	</RenderRules>

	<Data>
		<Sprite name="s_item" fileName="game/miketyson_motion.rttex" textureSize="400,512" />
		<Sprite name="p_item" fileName="game/miketyson_punch.rttex" textureSize="450,512" frame="0,0" />

		<Sprite name="s_punch" fileName="game/particles_miketyson.rttex" textureSize="96" frame="12,9" />
		<Sprite name="s_death" fileName="game/particles_miketyson.rttex" textureSize="96" frame="10,9" />

		<Animations>
			<SpriteAnimation name="idle" isLoop="true" playOnState="Motion.Idle" sprite="s_item"
				animTime="1100">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="walk" isLoop="true" playOnState="Motion.Move" sprite="s_item"
				animTime="600">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="jump" isLoop="false" sprite="s_item" playOnState="Motion.Jump">
				<Frame>0,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="fall" isLoop="false" sprite="s_item" playOnState="Motion.Fall">
				<Frame>1,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="punch" isLoop="true" playOnState="Action1.Punch" sprite="p_item"
				animTime="600">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punch" sprite="s_punch" animTime="250" isLoop="true"
				playOnState="Action1.Punch">
				<Frame>12,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="shadow" isLoop="true" sprite="s_shadow" animTime="600">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>						
			<ParticleSystem name="punch_particle">
				<Emitter>
					<Set name="offset">28,-10028</Set>
					<Set name="emissionInterval">4</Set>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="finalScale">0.8,0.8</Set>
                    <Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="0.8" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="particle_shadowright" updateState="Facing.Right">
				<Emitter usePlayerFacing="true">
					<Set name="offset">-3,-5018</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_shadow</Set>
					<Random name="offset" min="-8,-5020" max="8,-5020" />
					<Set name="lifeTime">0.7</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="useGravity">false</Set>
					<Set name="gravityVector">0,25</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.2, 0.2</KeyFrame>
						<KeyFrame>1, 0.2, 0.2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="particle_shadowleft" updateState="Facing.Left">
				<Emitter usePlayerFacing="true">
					<Set name="offset">-3,-5018</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_shadow</Set>
					<Random name="offset" min="-8,-5020" max="8,-5020" />
					<Set name="lifeTime">0.7</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="useGravity">false</Set>
					<Set name="gravityVector">0,25</Set>
					<Set name="flipX">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.2, 0.2</KeyFrame>
						<KeyFrame>1, 0.2, 0.2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="particle_death" updateStage="OnKilled">
				<Emitter>
					<Set name="offset">0, -0</Set>
					<Random name="emissionInterval" min="0.2" max="0.4" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">6</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_death</Set>
					<Random name="offset" min="0, -0" max="3, -0" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 0.6</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.5, 1</KeyFrame>
						<KeyFrame>0.5, 1, 3</KeyFrame>
						<KeyFrame>1, 0, 4.5</KeyFrame>
					</Curve>
					<Random name="lifeTime" min="0.8" max="1" />
					<Set name="initialVelocity">0, -50</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="UserNameOffset">30</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="PunchSoundOverride">SHOES</Set>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action1">
				<States>
					<State name="Idle" />
					<State name="Punch" />
					<State name="ZombiePunch" />
				</States>
				<Transitions>
					<Transition from="ZombiePunch|Punch" to="Idle">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="ZombiePunch|Idle" to="Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Idle|Punch" to="ZombiePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
	</Data>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_medal" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="17,9" />
    <Sprite name="s_pet" fileName="game/pets/p_missiletoad.rttex" textureSize="32" frame="0,0" />
    <Sprite name="s_missileRed" fileName="game/particles11.rttex" textureSize="32" frame="21,11" />
    <Sprite name="s_missileGreen" fileName="game/particles11.rttex" textureSize="32" frame="22,11" />
    <Sprite name="s_missileWhite" fileName="game/particles11.rttex" textureSize="32" frame="23,11" />
    <Sprite name="s_shrapnelRed" fileName="game/particles11.rttex" textureSize="32" frame="24,11" />
    <Sprite name="s_shrapnelGreen" fileName="game/particles11.rttex" textureSize="32" frame="25,11" />
    <Sprite name="s_shrapnelWhite" fileName="game/particles11.rttex" textureSize="32" frame="26,11" />
    <Sprite name="s_muzzleFlash" fileName="game/particles6.rttex" textureSize="32" frame="14,1" />
    
    <Animations>
      <SpriteAnimation name="a_Attack" sprite="s_pet" animTime="100" isLoop="true" playOnState="Motion.Punch">
        <Frame>4,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Fall" sprite="s_pet" animTime="100" isLoop="true" playOnState="Motion.Down">
        <Frame>3,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Idle" sprite="s_pet" animTime="400" isLoop="true" playOnState="Motion.None">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Jump" sprite="s_pet" animTime="100" isLoop="true" playOnState="Motion.Up">
        <Frame>2,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Move" sprite="s_pet" animTime="600" isLoop="true" playOnState="Motion.Horizontal">
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
        <Frame>7,0</Frame>
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
    </Animations>
    
    <ParticleSystems>
      <ParticleSystem name="ps_rockets">
        <Emitter>
          <Set name="offset">10,-26</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="emissionInterval">0.04</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Random name="variantId" min="0" max="3" />
          <Select name="sprite" input="variantId">
            <Item>"s_missileRed"</Item>
            <Item>"s_missileGreen"</Item>
            <Item>"s_missileWhite"</Item>
          </Select>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>1, 1</KeyFrame>
          </Curve>
          <Set name="interpolateVelocity">true</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1.15" angle="30"/>
          <Random name="targetPosOffset" min="-12,-11" max="12,11" />
          <VectorTo name="finalVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1.15" angle="-30"/>
          <OnFinish>
            <ParticleSystemName>ps_shrapnel</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_shrapnel">
        <Emitter>
          <Set name="particlesPerEmission">7</Set>
        </Emitter>
        <Particle UseParentVariantId="true">
          <Select name="sprite" input="variantId">
            <Item>"s_shrapnelRed"</Item>
            <Item>"s_shrapnelGreen"</Item>
            <Item>"s_shrapnelWhite"</Item>
          </Select>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="rotateWithVelocity">true</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_muzzleFlash">
        <Emitter>
          <Set name="offset">14,-20</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_muzzleFlash</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="initialScale">1.5,1.5</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="None" />
          <State name="Up" />
          <State name="Down" />
          <State name="Horizontal" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch|Up|Down|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Up" from="Punch|None|Down|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Down" from="Punch|None|Up|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Horizontal" from="Punch|None|Down|Up">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None|Up|Down|Horizontal">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">CHESTITEM</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-36,0</Set>
        <Set name="UsePetForceFaceTime">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnorePunchTypeCheck">false</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderChestItem>
      <SpriteRender name="s_medal" offset="0,0" alignment="DOWN_CENTER" />
    </RenderChestItem>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Punch">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderPet>
      <SpriteRender name="s_pet" offset="0,0" alignment="DOWN_CENTER" />
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
      </StopIf>
      <ParticleSystemUpdate name="ps_muzzleFlash" onState="Motion.Punch"/>
      <ParticleSystemUpdate name="ps_rockets" onState="Motion.Punch"/>
    </RenderPet>
    <UpdatePet>
      <ContextUpdate type="SetPetWalkRunJump">
        <Set name="PetWalkRunJump.minSpeed">500</Set>
        <Set name="PetWalkRunJump.distSpeedMult">20</Set>
      </ContextUpdate>
    </UpdatePet>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_leash" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="21,21" />
    <Sprite name="s_pet" fileName="game/pets/p_hugo.rttex" textureSize="32" frame="0,0" />
    <Sprite name="s_transform" fileName="game/pets/p_hugo.rttex" textureSize="32" frame="0,0" />
    <Sprite name="s_punch" fileName="game/particles.rttex" textureSize="32" frame="0,6" />

    <StateMachines>
      <StateMachine name="Pet">
        <States>
          <State name="None" />
          <State name="Up" />
          <State name="Down" />
          <State name="Horizontal" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch|Up|Down|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Up" from="Punch|None|Down|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Down" from="Punch|None|Up|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Horizontal" from="Punch|None|Down|Up">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None|Up|Down|Horizontal">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Transform">
        <States>
          <State name="Idle" />
          <State name="Walk" />
          <State name="Jump" />
          <State name="Fall" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Walk|Fall|Punch|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|Fall|Punch|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Walk|Fall|Punch">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Walk|Punch">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="Idle|Walk|Jump|Fall">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="IsTransformed">
        <States>
          <State name="No" />
          <State name="Yes" />
        </States>
        <Transitions>
          <Transition to="Yes" from="No">
            <Condition>
              <IsItemTransformed>true</IsItemTransformed>
            </Condition>
          </Transition>
          <Transition to="No" from="Yes">
            <Condition>
              <IsItemTransformed>false</IsItemTransformed>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <Animations>
      <SpriteAnimation name="a_idle" sprite="s_transform" animTime="300" isLoop="true" playOnState="Transform.Idle">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_walk" sprite="s_transform" animTime="300" isLoop="true" playOnState="Transform.Walk">
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump" sprite="s_transform" animTime="100" isLoop="true" playOnState="Transform.Jump">
        <Frame>6,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall" sprite="s_transform" animTime="100" isLoop="true" playOnState="Transform.Fall">
        <Frame>7,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punch" sprite="s_transform" animTime="400" isLoop="true" playOnState="Transform.Punch">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Attack" sprite="s_pet" animTime="400" isLoop="true" playOnState="Pet.Punch">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Fall" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.Down">
        <Frame>7,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Idle" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.None">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Jump" sprite="s_pet" animTime="100" isLoop="true" playOnState="Pet.Up">
        <Frame>6,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Move" sprite="s_pet" animTime="300" isLoop="true" playOnState="Pet.Horizontal">
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
    </Animations>
    
    <ParticleSystems>
      <ParticleSystem name="PunchParticle">
        <Emitter attachment="targetPos">
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Random name="offset" min="-16,-16" max="16,16" />
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5,0.75" max="0.5,1" />
          <Set name="lifeTime">0.2</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-32,0</Set>
        <Set name="UsePetForceFaceTime">false</Set>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="DefaultPunchSound">audio/chorizobark.wav</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderHandItem>
      <SpriteRender name="s_leash" rotationPoint="0,1" alignment="UPPER_CENTER" />
    </RenderHandItem>
    <AddClothingParticles>
      <ParticleSystemUpdate name="PunchParticle" onState="Pet.Punch|Transform.Punch"/>
    </AddClothingParticles>
    <OnPunchUpdate>
      <StopIf>
        <IsItemTransformed>true</IsItemTransformed>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderPet>
      <StopIf>
        <IsItemTransformed>true</IsItemTransformed>
      </StopIf>
      <SpriteRender name="s_pet" offset="-16,0" alignment="DOWN_CENTER" />
    </RenderPet>
    <UpdatePet>
      <StopIf>
        <IsItemTransformed>true</IsItemTransformed>
      </StopIf>
      <ContextUpdate type="SetPetWalkRunJump">
        <Set name="PetWalkRunJump.minSpeed">500</Set>
        <Set name="PetWalkRunJump.distSpeedMult">10</Set>
      </ContextUpdate>
    </UpdatePet>
    <RenderTransform>
      <SpriteRender name="s_transform" blend="PREMULTIPLIED_ALPHA" offset="0,8" />
    </RenderTransform>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="s_fruit" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="s_fruit1" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="s_fruit2" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="s_splash" fileName="game/particles11.rttex" textureSize="32"/>
		<Sprite name="s_chunks" fileName="game/particles11.rttex" textureSize="32"/>

		<Sprite name="s_Pineapple" fileName="game/particles11.rttex" textureSize="32" frame="3,20"/>
		<Sprite name="s_Kiwi" fileName="game/particles11.rttex" textureSize="32" frame="4,20"/>
		<Sprite name="s_Dragonfruit" fileName="game/particles11.rttex" textureSize="32" frame="5,20"/>
		<Sprite name="s_Watermelon" fileName="game/particles11.rttex" textureSize="32" frame="6,20"/>
		<Sprite name="s_Papaya" fileName="game/particles11.rttex" textureSize="32" frame="7,20"/>

		<Animations>
			<SpriteAnimation name="a_fruit1" sprite="s_fruit1">
				<Frame>5,20</Frame>
				<Frame>6,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_fruit2" sprite="s_fruit2">
				<Frame>3,20</Frame>
				<Frame>4,20</Frame>
				<Frame>7,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_fruit" sprite="s_fruit">
				<Frame>7,20</Frame>
				<Frame>6,20</Frame>
				<Frame>5,20</Frame>
				<Frame>3,20</Frame>
				<Frame>4,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_splash" sprite="s_splash">
				<Frame>7,21</Frame>
				<Frame>6,21</Frame>
				<Frame>5,21</Frame>
				<Frame>3,21</Frame>
				<Frame>4,21</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_chunks" sprite="s_chunks">
				<Frame>7,22</Frame>
				<Frame>6,22</Frame>
				<Frame>5,22</Frame>
				<Frame>3,22</Frame>
				<Frame>4,22</Frame>
			</SpriteAnimation>
			<SpriteSinPulseAnimation name="a_Pineapple" sprite="s_Pineapple" autoPlay="true">
				<Parameter name="pos">
					<Set name="period">1000</Set>
					<Set name="scale">1</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_Kiwi" sprite="s_Kiwi" autoPlay="true">
				<Parameter name="pos">
					<Set name="period">1000</Set>
					<Set name="scale">1</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_Dragonfruit" sprite="s_Dragonfruit" autoPlay="true">
				<Parameter name="pos">
					<Set name="period">1000</Set>
					<Set name="scale">-1</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_Watermelon" sprite="s_Watermelon" autoPlay="true">
				<Parameter name="pos">
					<Set name="period">1000</Set>
					<Set name="scale">-1</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_Papaya" sprite="s_Papaya" autoPlay="true">
				<Parameter name="pos">
					<Set name="period">1000</Set>
					<Set name="scale">1</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="Arc1" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle particleIndexSpriteFrame="true">
					<Set name="sprite">s_fruit1</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart">0.75</Set>
					<Set name="initialScale">0.2, 0.2</Set>
					<Set name="lifeTime">6</Set>
					<Set name="orbitPeriod">6</Set>
					<Set name="initialRotationRate">180</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="orbit">-24, 3</Set>
					<Set name="orbitScaleVariation">0.08</Set>
					<Set name="orbitSkew">-3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Arc2" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle particleIndexSpriteFrame="true">
					<Set name="sprite">s_fruit2</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart">0.75</Set>
					<Set name="initialScale">0.2, 0.2</Set>
					<Set name="lifeTime">6</Set>
					<Set name="orbitPeriod">6</Set>
					<Set name="initialRotationRate">180</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="orbit">-24, 3</Set>
					<Set name="orbitScaleVariation">0.08</Set>
					<Set name="orbitSkew">3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Chunks" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="particlesPerEmission">20</Set>
				</Emitter>
				<Particle particleIndexSpriteFrame="true">
					<Set name="sprite">s_chunks</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0.25, 0.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100"/>
					<Set name="gravityVector">0, 30</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Punch" updateStage="AddClothingParticles" updateState="Action.Punch" secondary="Splash">
				<Emitter>
					<Set name="offset">10, -12</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.015</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">5</Set>
				</Emitter>
				<Particle particleIndexSpriteFrame="true">
					<Set name="sprite">s_fruit</Set>
					<Select name="targetPosOffset" input="particleCounter">
						<Item>-10, 10</Item>
						<Item>10, 10</Item>
						<Item>0, 0</Item>
						<Item>-10, -10</Item>
						<Item>10, -10</Item>
					</Select>
					<Set name="initialScale">0.25, 0.25</Set>
					<Set name="lifeTime">0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="Splash">
				<Emitter>
					<Set name="offset">10, -12</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.5</Set>
				</Emitter>
				<Particle particleIndexSpriteFrame="true">
					<Set name="sprite">s_splash</Set>
					<Random name="offset" min="-4, -4" max="4, 4"/>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.25, 0.25</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="gravityVector" min="0, 15" max="0, 25"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="IsToRenderParticlesWhenShrunken">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<AddClothingParticles>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
			</StopIf>
		</AddClothingParticles>
		<OnPunchUpdate>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm1Angle</Set>
				<Set name="animTime">500</Set>
				<Set name="Curve">
					<KeyFrame>0.0, 0</KeyFrame>
					<KeyFrame>1, -360</KeyFrame>
				</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="animTime">500</Set>
				<Set name="Curve">
					<KeyFrame>0.0, -180</KeyFrame>
					<KeyFrame>1, -540</KeyFrame>
				</Set>
			</AvatarTransform>
			<AvatarTransform class="Face">
				<Set name="face">JUMP_DOWN</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">false</IsVariableBool>
			</StopIf>
			<SpriteRender name="s_Watermelon" offset="-18,-24" scale="0.2,0.2"/>
			<SpriteRender name="s_Dragonfruit" offset="-6,-20" scale="0.25,0.25"/>
			<SpriteRender name="s_Watermelon" offset="3,-14" scale="0.25,0.25"/>
			<SpriteRender name="s_Dragonfruit" offset="15,-10" scale="0.25,0.25"/>
			<SpriteRender name="s_Watermelon" offset="24,-6" scale="0.2,0.2"/>
			<SpriteRender name="s_Pineapple" offset="-18,-8" scale="0.2,0.2"/>
			<SpriteRender name="s_Papaya" offset="-6,-11" scale="0.25,0.25"/>
			<SpriteRender name="s_Kiwi" offset="5,-14" scale="0.25,0.25"/>
			<SpriteRender name="s_Pineapple" offset="15,-18" scale="0.25,0.25"/>
			<SpriteRender name="s_Papaya" offset="24,-24" scale="0.2,0.2"/>
		</RenderInFront>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Wing" fileName="game/particles_large15.rttex" textureSize="64" frame="8,9" />
		<Sprite name="s_strap" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="27,28"/>
		<Sprite name="double_jump_particle_Sprite" fileName="game/particles10.rttex" textureSize="32"/>
		<StateMachines>
			<StateMachine name="Mobility">
				<States>
					<State name="OnGround"/>
					<State name="InAir"/>
				</States>
				<Transitions>
					<Transition to="OnGround" from="InAir">
						<Condition>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="InAir" from="OnGround">
						<Condition>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action">
				<States>
					<State name="Idle" />
					<State name="JumpStraight" />
					<State name="FallStraight" />
				</States>
				<Transitions>
					<Transition to="Idle" from="FallStraight">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="JumpStraight" from="Idle|FallStraight">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="FallStraight" from="JumpStraight|Idle">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="double_jump_particle">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="lifeTime">0.75</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">4</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">double_jump_particle_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="initalRGB">1, 1, 1</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.75</Set>
					<Random name="initialScale" min="0.5" max="1"/>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<Animations>

			<SpriteAnimation name="double_jump_particle_Sprite_frames"  autoPlay="false" isLoop="false" sprite="double_jump_particle_Sprite"  animTime="100">
				<Frame>6,25</Frame>
				<Frame>6,23</Frame>
				<Frame>6,26</Frame>
				<Frame>6,27</Frame>
				<Frame>6,24</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Wing_idle" sprite="s_Wing" animTime="100" isLoop="true" playOnState="Action.Idle">
				<Frame>8,9</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="s_Wing_jump" sprite="s_Wing" animTime="200" isLoop="true" playOnState="Action.JumpStraight|Action.FallStraight">
				<Frame>9,9</Frame>
				<Frame>10,9</Frame>
				<Frame>11,9</Frame>
				<Frame>12,9</Frame>
			</SpriteAnimation>
		</Animations>

		<RenderOptions>
			<Default>
				<Set name="ShouldHover">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="FootPosition" onState="Mobility.OnGround">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
		</Update>
		<RenderFrontpack>
			<SpriteRender name="s_strap" offset="0,0" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderFrontpack>
		<RenderBackpack>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="s_Wing" offset="0,-13.6" blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackpack>
		<AddClothingParticles>
			<ParticleSystemUpdate name="double_jump_particle" onAction="JUMP"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="double_jump_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_MOBILE_SUIT_WINGS">
  <Data>
    <Sprite name="item_Sprite" fileName="game/particles_large12.rttex" textureSize="64" frame="7,12"/>
    <Sprite name="thruster_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="25,12"/>
    <Sprite name="sparkle_sprite" fileName="game/particles11.rttex" textureSize="32" frame="27,12"/>
    <Sprite name="jump_trail_sprite" fileName="game/particles11.rttex" textureSize="32" frame="26,12"/>
    <Sprite name="jump_sparkle_sprite" fileName="game/particles11.rttex" textureSize="32" frame="29,12"/>
    <Sprite name="jump_heart_sprite" fileName="game/particles11.rttex" textureSize="32" frame="28,12"/>

    <ParticleSystems>
      <ParticleSystem name="thrusterLeft">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">-18,-2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">thruster_Sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5" max="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="thrusterRight">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">18,-2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">thruster_Sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="renderAlignment">UPPER_CENTER</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5" max="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="sparklesLeft">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">-18,-3</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">0.5,0.5</Set>
          <Random name="initialVelocity" min="-20,10" max="20,20"/>
          <Random name="offset" min="-2, 0" max="2,0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="sparklesRight">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">18,-3</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">0.5,0.5</Set>
          <Random name="initialVelocity" min="-20,10" max="20,20"/>
          <Random name="offset" min="-2, 0" max="2,0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpTrailLeft">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.025</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">-18,8</Set>
        </Emitter>
        <Particle angleRelativeToPlayerSpeed="true">
          <Set name="sprite">jump_trail_sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.75,0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 250</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpTrailRight">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.025</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">18,8</Set>
        </Emitter>
        <Particle angleRelativeToPlayerSpeed="true">
          <Set name="sprite">jump_trail_sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.75,0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 250</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpSparkleLeft">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.025</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">-18,8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.5,0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-5,0" max="5,5"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpSparkleRight">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.025</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">18,8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_sparkle_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">0.5,0.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-5,0" max="5,5"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpHeartsLeft">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">-18,8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_heart_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 50</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.4,0.2</Set>
          <Increment name="initialScale" source="particleIndex" multiplier="0.2,0.1"/>
          <Set name="finalScale">1.2,0.6</Set>
          <Increment name="finalScale" source="particleIndex" multiplier="0.4,0.2"/>
          <Set name="offset">0,-30</Set>
          <Increment name="worldPos" source="particleIndex" multiplier="0,12"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="jumpHeartsRight">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">18,8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">jump_heart_sprite</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 50</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.4,0.2</Set>
          <Increment name="initialScale" source="particleIndex" multiplier="0.2,0.1"/>
          <Set name="finalScale">1.2,0.6</Set>
          <Increment name="finalScale" source="particleIndex" multiplier="0.4,0.2"/>
          <Set name="offset">0,-30</Set>
          <Increment name="worldPos" source="particleIndex" multiplier="0,12"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="HideParticlesOnTransform">true</Set>
        <Set name="HideParticlesOnTheaterSeat">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="item_Sprite" offset="0,-32" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER"/>
      <SpriteRender name="item_Sprite" offset="0,-32" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER"/>
    </RenderBackpack>
    <AddClothingParticles>
      <ParticleSystemUpdate name="thrusterLeft" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="sparklesLeft" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="jumpTrailLeft" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpSparkleLeft" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpHeartsLeft" onAction="JUMPSTART|JUMPDOUBLE"/>
      <ParticleSystemUpdate name="thrusterRight" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="sparklesRight" onAction="IDLE|FALL|WALK|PUNCH"/>
      <ParticleSystemUpdate name="jumpTrailRight" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpSparkleRight" onAction="JUMP"/>
      <ParticleSystemUpdate name="jumpHeartsRight" onAction="JUMPSTART|JUMPDOUBLE"/>
    </AddClothingParticles>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="thrusterLeft"/>
      <ParticleSystemOff name="sparklesLeft"/>
      <ParticleSystemOff name="jumpTrailLeft"/>
      <ParticleSystemOff name="jumpSparkleLeft"/>
      <ParticleSystemOff name="jumpHeartsLeft"/>
      <ParticleSystemOff name="thrusterRight"/>
      <ParticleSystemOff name="sparklesRight"/>
      <ParticleSystemOff name="jumpTrailRight"/>
      <ParticleSystemOff name="jumpSparkleRight"/>
      <ParticleSystemOff name="jumpHeartsRight"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_MOON_GREATSWORD">
	<Data>
		<Sprite name="s_mist" fileName="game/particles11.rttex" textureSize="32" frame="17,28" />
		<Sprite name="s_snowflakes" fileName="game/particles11.rttex" textureSize="32" frame="13,28" />
		<Sprite name="s_snowflakesHit" fileName="game/particles11.rttex" textureSize="32" frame="13,28" />
		<Sprite name="s_sword" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="3,5" />
		<Sprite name="s_swordGlow" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="4,5" />
		<Sprite name="s_punchCurve" fileName="game/particles_large10.rttex" textureSize="64" frame="15,9" />
		<Sprite name="s_punchStraight" fileName="game/particles11.rttex" textureSize="32" frame="16,28" />
		<Animations>
			<SpriteCurveAnimation name="a_glow" isLoop="true" sprite="s_swordGlow" animTime="3000" autoPlay="true">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_snowflakes" sprite="s_snowflakes">
				<Frame>13,28</Frame>
				<Frame>14,28</Frame>
				<Frame>15,28</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_snowflakesHit" sprite="s_snowflakesHit">
				<Frame>13,28</Frame>
				<Frame>14,28</Frame>
				<Frame>15,28</Frame>
			</SpriteAnimation>
		</Animations>
    <TileStampData>
      <Set name="RenderObjectName">MoonGreatswordTileStamp</Set>
      <Set name="RenderDefaultCracks">true</Set>
    </TileStampData>
		<RenderOptions>
			<Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="UserNameOffset">15</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
			</Default>
		</RenderOptions>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
      <ParticleSystem name="ps_swordMist" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="Punch.False">
        <Emitter>
          <Random name="offset" min="-24, -38" max="-6, -34" />
          <Random name="emissionInterval" min="0.28" max="0.56" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1.0</Set>
          <Set name="initialVelocity">0,-3</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.4" max="0.8" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_snowflakesHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_breakSparkles">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_snowflakesHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="0" max="16" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="40,100" />
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_breakMist">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">24</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_mist</Set>
          <Random name="offset" min="-30, -20" max="30, 20" />
          <Set name="renderAlignment">CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 0.25, 0.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
        </Particle>
      </ParticleSystem>
			<ParticleSystem name="ps_frontHandMist" updateStage="AddClothingParticles" renderStage="RenderHandItem">
				<Emitter attachment="handspotRoot">
					<Set name="offset">0, 8</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_mist</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
          <Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_frontHandSnow" updateStage="AddClothingParticles" renderStage="RenderHandItem">
				<Emitter attachment="handspotRoot">
					<Set name="offset">0, 8</Set>
					<Random name="emissionInterval" min="0.07" max="0.14" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakes</Set>
					<Random name="offset" min="-4, -2" max="4, 2" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.35" max="0.75" />
					<Set name="lifeTime">1</Set>
					<Random name="initialVelocity" min="0, -30" max="0, -20" />
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_backHandSnow" updateStage="AddClothingParticles" renderStage="RenderBackHandItem" updateState="Punch.False">
				<Emitter>
          <Random name="offset" min="-24, -42" max="4, -32" />
					<Random name="emissionInterval" min="0.07" max="0.14" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_snowflakes</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.35" max="0.75" />
					<Set name="lifeTime">1</Set>
					<Random name="initialVelocity" min="0, -30" max="0, -20" />
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>

      <ParticleSystem name="ps_punchCurved" updateStage="OnPunchStart">
        <Emitter onPunchCount="odd">
          <Set name="offset">0,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchCurve</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">2,2</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchStraight" updateStage="OnPunchStart">
        <Emitter onPunchCount="even">
          <Set name="offset">0,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchStraight</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">1.25,1.25</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.False">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">215</Set>
			</AvatarTransform>
		</Update>
		<RenderBackHandItem>
			<StopIf type="and">
				<IsZombified>true</IsZombified>
				<IsAction>PUNCH</IsAction>
			</StopIf>
			<SpriteRender name="s_sword" offset="13, 2" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
			<SpriteRender name="s_swordGlow" offset="13,2" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" />
		</RenderBackHandItem>
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="animTime">700</Set>
				<Set name="Curve">
					<KeyFrame>0.0, 215</KeyFrame>
					<KeyFrame>0.3, 360</KeyFrame>
					<KeyFrame>0.8, 360</KeyFrame>
          <KeyFrame>0.81, 215</KeyFrame>
					<KeyFrame>1, 215</KeyFrame>
				</Set>
			</AvatarTransform>
		</OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitSparkles" />
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_breakSparkles"/>
      <ParticleSystemUpdate name="ps_breakMist"/>
    </OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_whiteFoot1" fileName="game/player_feet16.rttex" textureSize="32" frame="7,26"/>
		<Sprite name="s_whiteFoot2" fileName="game/player_feet16.rttex" textureSize="32" frame="7,27"/>
		<Sprite name="s_blackFoot1" fileName="game/player_feet16.rttex" textureSize="32" frame="8,26"/>
		<Sprite name="s_blackFoot2" fileName="game/player_feet16.rttex" textureSize="32" frame="8,27"/>
		<Sprite name="s_death" fileName="game/particles_large18.rttex" textureSize="64" frame="8,1"/>
		<Sprite name="s_backLayer" fileName="game/particles_large18.rttex" textureSize="64" frame="0,2"/>
		<Sprite name="s_frontLayer" fileName="game/particles_large18.rttex" textureSize="64" frame="0,0"/>
		<Sprite name="s_pet1" fileName="game/pets/p_mcaspiro1.rttex" textureSize="32" frame="3,0"/>
		<Sprite name="s_pet2" fileName="game/pets/p_mcaspiro2.rttex" textureSize="32" frame="3,0"/>
		<Animations>
			<SpriteAnimation name="a_backLayer" sprite="s_backLayer" animTime="2000" isLoop="true" autoPlay="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
				<Frame>9,2</Frame>
				<Frame>10,2</Frame>
				<Frame>11,2</Frame>
				<Frame>12,2</Frame>
				<Frame>13,2</Frame>
				<Frame>14,2</Frame>
				<Frame>15,2</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer" sprite="s_frontLayer" animTime="2000" isLoop="true" autoPlay="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>8,0</Frame>
				<Frame>9,0</Frame>
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
				<Frame>12,0</Frame>
				<Frame>13,0</Frame>
				<Frame>14,0</Frame>
				<Frame>15,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet1_move" sprite="s_pet1" animTime="300" isLoop="true" playOnState="PetMotion.Horizontal">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet1_up" sprite="s_pet1" animTime="300" isLoop="true" playOnState="PetMotion.Up">
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet1_down" sprite="s_pet1" animTime="300" isLoop="true" playOnState="PetMotion.Down">
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet1_idle" sprite="s_pet1" animTime="300" isLoop="true" playOnState="PetMotion.None">
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet2_move" sprite="s_pet2" animTime="300" isLoop="true" playOnState="PetMotion.Horizontal">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet2_up" sprite="s_pet2" animTime="300" isLoop="true" playOnState="PetMotion.Up">
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet2_down" sprite="s_pet2" animTime="300" isLoop="true" playOnState="PetMotion.Down">
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet2_idle" sprite="s_pet2" animTime="300" isLoop="true" playOnState="PetMotion.None">
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_death" sprite="s_death" animTime="800" isLoop="false" playOnState="PlayerDead.Yes">
				<Frame>15, 1</Frame>
				<Frame>8, 1</Frame>
				<Frame>9, 1</Frame>
				<Frame>10, 1</Frame>
				<Frame>11, 1</Frame>
				<Frame>12, 1</Frame>
				<Frame>13, 1</Frame>
				<Frame>14, 1</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="PlayerMoving">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="DrawRealPet">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition type="and">
							<IsVariableFloat name="distanceToPet" operator="Less" abs="true">32</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsVariableFloat name="distanceToPet" operator="Greater" abs="true">32</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PetMotion">
				<States>
					<State name="None" />
					<State name="Pre" ExitTime="0.15"/>
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
				</States>
				<Transitions>
					<Transition to="None" from="Pre|Horizontal|Up|Down">
						<Condition type="or">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="None">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="None">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Pre" from="None">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Pre">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Shoes">
				<States>
					<State name="White"/>
					<State name="Black"/>
				</States>
				<Transitions>
					<Transition to="Black" from="White">
						<Condition>
							<ItemHasTag>BLACK_SHOES</ItemHasTag>
						</Condition>
					</Transition>
					<Transition to="White" from="Black">
						<Condition>
							<ItemHasTag operatorType="NotEqual">BLACK_SHOES</ItemHasTag>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PlayerDead">
				<States>
					<State name="No"/>
					<State name="Yes" ExitTime="3.5"/>
				</States>
				<Transitions>
					<Transition from="No" to="Yes" >
						<Condition>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>
					<Transition from="Yes" to="No" />
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="p_DeathParticle">
				<Emitter>
					<Set name="offset">0,26</Set>
					<Set name="lifeTime">2</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_death</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="leftFootYPos">0,0,0</Set>
			<Set name="rightFootYPos">0,0,0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="RenderShoesWithMermaidTail">false</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="UsePetForceFaceTime">false</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="IncludeAllActions">true</Set>
        <Set name="OnEquipTag">BLACK_SHOES</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderShoes>
			<Group>
				<Translate>rightFootYPos</Translate>
				<SpriteRender name="s_whiteFoot2" alignment="DOWN_CENTER" onState="Shoes.White"/>
				<SpriteRender name="s_blackFoot2" alignment="DOWN_CENTER" onState="Shoes.Black"/>
			</Group>
			<Group>
				<Translate>leftFootYPos</Translate>
				<SpriteRender name="s_whiteFoot1" alignment="DOWN_CENTER" onState="Shoes.White"/>
				<SpriteRender name="s_blackFoot1" alignment="DOWN_CENTER" onState="Shoes.Black"/>
			</Group>
		</RenderShoes>
		<RenderInFront>
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
      <StopIf type="and">
        <IsVariableBool name="isInPetBattle">true</IsVariableBool>
        <IsVariableBool name="isBattleLeash">true</IsVariableBool>
      </StopIf>
			<ContextUpdate type="SetFlip">
				<Set name="flip">0,0</Set>
			</ContextUpdate>
			<Group onState="PlayerDead.No">
				<Group onState="DrawRealPet.No">
					<Translate>0,2,0</Translate>
					<SpriteRender name="s_frontLayer" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" tintOverride="255,255,255,255"/>
				</Group>
			</Group>
		</RenderInFront>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
      <StopIf type="and">
        <IsVariableBool name="isInPetBattle">true</IsVariableBool>
        <IsVariableBool name="isBattleLeash">true</IsVariableBool>
      </StopIf>
			<ContextUpdate type="SetFlip">
				<Set name="flip">0,0</Set>
			</ContextUpdate>
			<Group onState="PlayerDead.No">
				<Group onState="DrawRealPet.No">
					<Translate>0,2,0</Translate>
					<SpriteRender name="s_backLayer" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" tintOverride="255,255,255,255"/>
				</Group>
			</Group>
		</RenderBehind>
		<OnKilled>
			<ParticleSystemUpdate name="p_DeathParticle"/>
		</OnKilled>
		<RenderPet>
			<Group onState="PlayerDead.No">	
				<Group onState="DrawRealPet.Yes">
					<Translate>16,0,0</Translate>
					<SpriteRender name="s_pet1" alignment="DOWN_CENTER"/>
					<Translate>-24,0,0</Translate>
					<SpriteRender name="s_pet2" alignment="DOWN_CENTER"/>
				</Group>
			</Group>
		</RenderPet>
		<UpdatePet>
			<ContextUpdate type="SetPetWalkRunJump">
				<Set name="PetWalkRunJump.minSpeed">500</Set>
				<Set name="PetWalkRunJump.distSpeedMult">10</Set>
			</ContextUpdate>
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
		</UpdatePet>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_MUSCLE_MINIGUN">
  <Data>
    <Sprite name="s_FrontArm" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="9,20"/>
    <Sprite name="s_Minigun" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="4,20"/>
    <Sprite name="s_MuzzleFlash" fileName="game/particles10.rttex" textureSize="32" frame="31,10"/>
    <Sprite name="s_Projectile" fileName="game/particles11.rttex" textureSize="32" frame="17,26"/>
    <Sprite name="s_ProjectileHit" fileName="game/particles11.rttex" textureSize="32" frame="18,26"/>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_PunchGun" sprite="s_Minigun" animTime="250" isLoop="true" playOnState="Punch.True">
        <Frame>4,20</Frame>
        <Frame>5,20</Frame>
        <Frame>6,20</Frame>
        <Frame>7,20</Frame>
        <Frame>8,20</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_NonPunchGun" sprite="s_Minigun" animTime="100" isLoop="true" playOnState="Punch.False">
        <Frame>4,20</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
      </Default>
    </RenderOptions>

    <ParticleSystems>
      <ParticleSystem name="MuzzleFlash" updateStage="RenderHandItem" updateState="Punch.True">
        <Emitter attachment="handspotRoot">
          <Set name="offset">18, 12</Set>
          <Set name="lifeTime">0.072</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_MuzzleFlash</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.15</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="Punch" updateStage="RenderHandItem" updateState="Punch.True" secondary="BulletHit">
        <Emitter attachment="handspotRoot">
          <Random name="offset" min="18, 8" max="18, 16"/>
          <Set name="lifeTime">0.072</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.2</Set>
          <Random name="targetPosOffset" min="-15, -8" max="15, 8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="BulletHit">
        <Emitter>
          <Set name="offset">0, 0</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="delayTimer">0.2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.1</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Select name="initialRotationRate" input="randomNumber">
            <Item>-720</Item>
            <Item>720</Item>
          </Select>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>

  <RenderRules>
    <RenderHandItem>
      <SpriteRender name="s_FrontArm" offset="0,-1" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" tintOverride="SKIN"/>
      <SpriteRender name="s_Minigun" offset="0,0" rotateOffset="true" rotationPoint="0,1" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="angleOffset">90</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>

    <RenderFrontArm>
      <ContextUpdate type="PositionSinPulse" onState="Punch.True">
        <Set name="period">100</Set>
        <Set name="scale">-0.5</Set>
        <Set name="clamp">true</Set>
      </ContextUpdate>
    </RenderFrontArm>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Punch" fileName="game/particles11.rttex" textureSize="32" frame="9,26" />
		<Sprite name="s_Turntable" fileName="game/particles_large13.rttex" textureSize="64" frame="6,15" />
		<Animations>
			<SpriteCurveAnimation name="a_TurntablePos1" isLoop="true" autoPlay="true" sprite="s_Turntable" animTime="4000">
				<Curve name="pos">
					<KeyFrame>0, 0, 0</KeyFrame>
					<KeyFrame>0.2856, 0, 1</KeyFrame>
					<KeyFrame>0.7854, 0, -1</KeyFrame>
					<KeyFrame>1, 0, 0</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_Turntable" sprite="s_Turntable" isLoop="true" playOnState="Motion.Idle">
				<Frame>6,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_TurntablePulse" sprite="s_Turntable" animTime="400" isLoop="true" playOnState="Motion.Dance|Motion.Punch">
				<Frame>6,15</Frame>
				<Frame>7,15</Frame>
				<Frame>8,15</Frame>
				<Frame>9,15</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Punch" />
					<State name="Dance" />
					<State name="Sleep" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Punch|Dance|Sleep">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsDancing>false</IsDancing>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Dance|Sleep">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Idle|Punch|Sleep">
						<Condition>
							<IsDancing>true</IsDancing>
						</Condition>
					</Transition>
					<Transition to="Sleep" from="Idle|Punch|Dance">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_Dance">
				<Emitter>
					<Set name="offset">4, -6</Set>
					<Set name="emissionInterval">0.15</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,100" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">4, -6</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angle="0" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<MusicSource onState="Motion.Dance|Motion.Punch">
				<Set name="ItemID">ITEM_ID_MUSICAL_MAESTRO</Set>
				<Set name="FadeOutTimeMs">500</Set>
			</MusicSource>
			<AvatarTransform class="ActionUpdate" onState="Motion.Sleep|Motion.Idle|Motion.Punch">
				<Set name="action">CLEAR</Set>
			</AvatarTransform>
			<StopIf>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance">
				<Set name="action">NOD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Dance|Motion.Punch">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-80</Set>
				<Set name="pulseArmScale">10</Set>
				<Set name="pulseArmRate">500</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Dance|Motion.Punch">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">180</Set>
				<Set name="pulseArmScale">10</Set>
				<Set name="pulseArmRate">500</Set>
			</AvatarTransform>
		</Update>
		<SwitchOffClothingParticles>
			<AvatarTransform class="ActionUpdate">
				<Set name="action">CLEAR</Set>
			</AvatarTransform>
		</SwitchOffClothingParticles>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_Dance" onState="Motion.Dance"/>
		</AddClothingParticles>
		<RenderInFront value="playerCenter">
			<StopIf>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<SpriteRender name="s_Turntable" offset="0,0" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
		</RenderInFront>
		<OnPunchUpdate>
			<StopIf>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Emotion">
				<Set name="emotion">ECSTATIC</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_chest" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="18,24" />
		<Sprite name="s_chestGlow" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="19,24" />
		<Sprite name="s_punchAura" fileName="game/particles_large9.rttex" textureSize="64" frame="11,15" />
		<Sprite name="s_punchFlash" fileName="game/particles_large9.rttex" textureSize="64" frame="12,15" />
		<Animations>
			<SpriteCurveAnimation name="a_chestGlow" isLoop="true" playOnState="Punch.Off" sprite="s_chestGlow" animTime="2500">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f </KeyFrame>
					<KeyFrame>0.8f, 1.f </KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="a_chestGlowPunch" isLoop="true" playOnState="Punch.Start|Punch.Update" sprite="s_chestGlow" animTime="2500">
				<Curve name="alpha">
					<KeyFrame>0.f, 1.f</KeyFrame>
					<KeyFrame>1.f, 1.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="Off" />
					<State name="Start" />
					<State name="Update" />
				</States>
				<Transitions>
					<Transition from="Off" to="Start">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="Start" to="Update">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="Update" to="Off">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_punchAura" updateStage="AddClothingParticles" updateState="Punch.Update">
				<Emitter>
					<Set name="offset">0, -12</Set>
					<Set name="lifeTime">1.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">s_punchAura</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.2</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>0.5, 0.65, 0.65</KeyFrame>
						<KeyFrame>1, 0.8, 0.8</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchAuraBehind" updateStage="AddClothingParticles" renderStage="RenderBehind" updateState="Punch.Update">
				<Emitter>
					<Set name="offset">0, -12</Set>
					<Set name="lifeTime">1.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">s_punchAura</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.2</KeyFrame>
						<KeyFrame>0.5, 0.6</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>0.5, 1, 1</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchFlash" updateStage="AddClothingParticles" updateState="Punch.Start">
				<Emitter>
					<Set name="offset">0, -12</Set>
					<Set name="lifeTime">1.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">s_punchFlash</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.6, 1.6</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.25</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="s_chest" alignment="DOWN_CENTER" />
			<SpriteRender name="s_chestGlow" alignment="DOWN_CENTER" drawShadow="false" />
		</RenderChestItem>
    <AddClothingParticles>
      <StopIf  type="or">
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
    </AddClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_strap" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="9,10"/>
		<Sprite name="s_strapGlow" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="10,10"/>
		<Sprite name="s_mantle" fileName="game/particles_large18.rttex" textureSize="64" frame="7,7"/>
		<Sprite name="s_cloud" fileName="game/particles12.rttex" textureSize="32" frame="5,20"/>
		<Sprite name="s_waterDrop" fileName="game/particles12.rttex" textureSize="32" frame="5,19"/>
		<Sprite name="s_waterSplash" fileName="game/particles.rttex" textureSize="32" frame="4,14"/>

		<Animations>
			<SpriteAnimation name="a_mantle_idle" sprite="s_mantle" isLoop="true" animTime="800" playOnState="Punch.No">
				<Frame>7,7</Frame>
				<Frame>8,7</Frame>
				<Frame>9,7</Frame>
				<Frame>10,7</Frame>
				<Frame>11,7</Frame>
				<Frame>12,7</Frame>
				<Frame>13,7</Frame>
				<Frame>14,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_mantle_punch" sprite="s_mantle" isLoop="true" animTime="200" playOnState="Punch.Yes">
				<Frame>13,8</Frame>
				<Frame>14,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_cloud" sprite="s_cloud" animTime="200">
				<Frame>5,20</Frame>
				<Frame>6,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_waterDrop" sprite="s_waterDrop" animTime="200">
				<Frame>5,19</Frame>
				<Frame>6,19</Frame>
			</SpriteAnimation>
			<SpriteCurveAnimation name="a_strapGlow" isLoop="true" autoPlay="true" sprite="s_strapGlow" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0.f, 1.f</KeyFrame>
					<KeyFrame>0.5f, 0.f </KeyFrame>
					<KeyFrame>1.f, 1.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="ps_cloud">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="lifeTime">0.2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_cloud</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="offset" min="-1, -4" max="1, 4"/>
					<Set name="worldPos" source="Cloud.Position"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="1.5" max="2"/>
					<Random name="finalScale" min="2" max="3"/>
					<Set name="interpolateScale">true</Set>
					<Random name="initialVelocity" min="-10, -1" max="10, 1"/>
					<Set name="lifeTime">2</Set>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_rain">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_waterDrop</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="offset" min="-6, 12" max="6, 14"/>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="initialScale" min="0.75" max="1"/>
					<Set name="gravityVector">0, 120</Set>
					<Set name="worldPos" source="Cloud.Position"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<OnFinish>
						<ParticleSystemName>ps_waterSplash</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_waterSplash" >
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="emissionInterval">0.5</Set>
					<Random name="particlesPerEmission" min="2" max="6"/>
				</Emitter>
				<Particle>
					<Set name="sprite">s_waterSplash</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.5, 0.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,75" baseAnglePosition="targetPos" baseOffset="0,16"/>
					<Set name="gravityVector">0, 45</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PunchAnim">
				<States>
					<State name="Off"/>
					<State name="Start" ExitTime="0.01" />
					<State name="Continue"/>
				</States>
				<Transitions>
					<Transition from="Off" to="Start">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Start" to="Continue"/>
					<Transition from="Continue" to="Off">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>

		<VariableMap>
			<Set name="Punch.GetPosition">0,0,0</Set>
			<Set name="Context.GetPosition">0,0,0</Set>
			<Set name="Cloud.Position">0,0</Set>
		</VariableMap>
	</Data>

	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="s_strap" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER"/>
			<SpriteRender name="s_strapGlow" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER"/>
		</RenderChestItem>
		<RenderChestBackItem>
			<SpriteRender name="s_mantle" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" drawShadow="true" />
		</RenderChestBackItem>
		<RenderInFront>
			<ParticleSystemRender name="ps_rain" />
			<ParticleSystemRender name="ps_cloud" />
		</RenderInFront>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<Update>
			<ArithmethicOperation LeftHandVariableName="Cloud.Position.x" RightHandVariableName="Punch.GetPosition.x" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="Cloud.Position.y" RightHandVariableName="Punch.GetPosition.y" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="Cloud.Position.y" RightHandVariableName="-70" OperationType="Add"/>
			<ParticleSystemUpdate name="ps_cloud" onState="PunchAnim.Continue"/>
			<ParticleSystemUpdate name="ps_rain" onState="PunchAnim.Continue"/>
		</Update>
	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="s_back" fileName="game/particles_large16.rttex" textureSize="64,64" frame="9,1" />
        <Sprite name="s_front" fileName="game/particles_large16.rttex" textureSize="64,64" frame="13,1" />
        <Sprite name="s_cannon" fileName="game/particles12.rttex" textureSize="32,32" frame="26,4" />
        <Sprite name="s_splash" fileName="game/particles12.rttex" textureSize="32,32" frame="27,4" />
        <Animations>
            <SpriteAnimation name="a_back_idle" sprite="s_back" isLoop="true" animTime="400" playOnState="Motion.Idle">
                <Frame>9,1</Frame>
                <Frame>10,1</Frame>
                <Frame>11,1</Frame>
                <Frame>12,1</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_front_idle" sprite="s_front" isLoop="true" animTime="800" playOnState="Motion.Idle">
                <Frame>8,6</Frame>
                <Frame>9,6</Frame>
                <Frame>10,6</Frame>
                <Frame>11,6</Frame>
                <Frame>12,6</Frame>
                <Frame>13,6</Frame>
                <Frame>14,6</Frame>
                <Frame>15,6</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_back_move" sprite="s_back" isLoop="true" animTime="800" playOnState="Motion.Move">
                <Frame>8,5</Frame>
                <Frame>9,5</Frame>
                <Frame>10,5</Frame>
                <Frame>11,5</Frame>
                <Frame>12,5</Frame>
                <Frame>13,5</Frame>
                <Frame>14,5</Frame>
                <Frame>15,5</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_front_move" sprite="s_front" isLoop="true" animTime="800" playOnState="Motion.Move">
                <Frame>8,6</Frame>
                <Frame>9,6</Frame>
                <Frame>10,6</Frame>
                <Frame>11,6</Frame>
                <Frame>12,6</Frame>
                <Frame>13,6</Frame>
                <Frame>14,6</Frame>
                <Frame>15,6</Frame>
            </SpriteAnimation>
			<SpriteAnimation name="a_back_jump" sprite="s_back" isLoop="false" animTime="200" playOnState="Motion.Jump">
                <Frame>14,1</Frame>
                <Frame>15,1</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_front_jump" sprite="s_front" isLoop="false" animTime="200" playOnState="Motion.Jump">
                <Frame>14,2</Frame>
                <Frame>15,2</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_back_fall" sprite="s_back" isLoop="false" animTime="200" playOnState="Motion.Fall">
                <Frame>12,3</Frame>
                <Frame>13,3</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_front_fall" sprite="s_front" isLoop="false" animTime="200" playOnState="Motion.Fall">
                <Frame>12,4</Frame>
                <Frame>13,4</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_back_punch" sprite="s_back" isLoop="true" animTime="800" playOnState="Motion.Punch">
                <Frame>8,7</Frame>
                <Frame>9,7</Frame>
                <Frame>10,7</Frame>
                <Frame>11,7</Frame>
                <Frame>12,7</Frame>
                <Frame>13,7</Frame>
                <Frame>14,7</Frame>
                <Frame>15,7</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="a_front_punch" sprite="s_front" isLoop="true" animTime="800" playOnState="Motion.Punch">
                <Frame>8,6</Frame>
                <Frame>9,6</Frame>
                <Frame>10,6</Frame>
                <Frame>11,6</Frame>
                <Frame>12,6</Frame>
                <Frame>13,6</Frame>
                <Frame>14,6</Frame>
                <Frame>15,6</Frame>
            </SpriteAnimation>
        </Animations>
		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="AllowChangePunchType">true</Set>
				<Set name="NeedRenderBareFeetWithShoesItem">false</Set>
				<Set name="ClothingOffsetFromShoes">-4</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Fall|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Fall|Jump|Idle|Move">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
        <ParticleSystems>
			<ParticleSystem name="ps_cannon">
				<Emitter>
					<Set name="emissionInterval">0.2</Set>
					<Set name="offset">22, -20</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_cannon</Set>
					<Set name="renderAlignment">LEFT_CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>0.71, 0</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
					<Random name="initialScale" min="0.5, 0.75" max="0.75, 1.25"/>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<OnFinish>
						<ParticleSystemName>ps_splash</ParticleSystemName>
						<ParticleSystemName>ps_drops</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_splash">
				<Emitter>
					<Set name="offset">0, 0</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_splash</Set>
					<Random name="offset" min="-4, -4" max="4, 4"/>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.5, 1.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Set name="gravityVector">0, 20</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_drops">
				<Emitter>
					<Set name="particlesPerEmission">14</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_cannon</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="offset" min="-4, -4" max="4, 4"/>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="initialScale" min="0.25" max="0.4"/>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,40"/>
					<Set name="gravityVector">0, 40</Set>
				</Particle>
			</ParticleSystem>
        </ParticleSystems>
    </Data>
    <RenderRules>
        <RenderBehind>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Translate>0,-4,0</Translate>
            <SpriteRender name="s_back" blend="PREMULTIPLIED_ALPHA" drawShadow="true" />
        </RenderBehind>
        <RenderShoes>
			<Translate>4,4,0</Translate>
            <SpriteRender name="s_front" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" drawShadow="true" />
        </RenderShoes>
		<OnPunchStart>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-90</Set>
			</AvatarTransform>
			<ParticleSystemUpdate name="ps_cannon"/>
		</OnPunchStart>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_equip" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="0,27"/>
    <Sprite name="s_flower" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="5,27"/>
    <Sprite name="s_punchBranch" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="1,27"/>
    <Sprite name="HitSpark_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="30,18"/>

    <Animations>
      <SpriteAnimation name="HitSpark_Anim" autoPlay="false" isLoop="false" sprite="HitSpark_Sprite"  animTime="200">
        <Frame>30, 18</Frame>
        <Frame>30, 19</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flowerIdle" sprite="s_flower" animTime="100" isLoop="true" playOnState="FlowerPunchAnim.Off">
        <Frame>5,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flowerPunchStart" sprite="s_flower" animTime="400" playOnState="FlowerPunchAnim.Start">
        <Frame>6,27</Frame>
        <Frame>7,27</Frame>
        <Frame>8,27</Frame>
        <Frame>9,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flowerPunchContinue" sprite="s_flower" animTime="100" isLoop="true" playOnState="FlowerPunchAnim.Continue">
        <Frame>9,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_flowerPunchEnd" sprite="s_flower" animTime="400" playOnState="FlowerPunchAnim.End">
        <Frame>9,27</Frame>
        <Frame>8,27</Frame>
        <Frame>7,27</Frame>
        <Frame>6,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_branchPunchStart" sprite="s_punchBranch" animTime="400" playOnState="BranchPunchAnim.Start">
        <Frame>1,27</Frame>
        <Frame>2,27</Frame>
        <Frame>3,27</Frame>
        <Frame>4,27</Frame>
        <Frame>4,27</Frame>
        <Frame>4,27</Frame>
        <Frame>4,27</Frame>
        <Frame>4,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_branchPunchContinue" sprite="s_punchBranch" animTime="100" isLoop="true" playOnState="BranchPunchAnim.Continue">
        <Frame>4,27</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_branchPunchEnd" sprite="s_punchBranch" animTime="400" playOnState="BranchPunchAnim.End">
        <Frame>4,27</Frame>
        <Frame>3,27</Frame>
        <Frame>2,27</Frame>
        <Frame>1,27</Frame>
        <Frame>1,27</Frame>
        <Frame>1,27</Frame>
        <Frame>1,27</Frame>
        <Frame>1,27</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="FlowerPunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start"/>
          <State name="Continue"/>
          <State name="End"/>
        </States>
        <Transitions>
          <Transition from="Off|End" to="Start">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsAnimationFinished>a_flowerPunchStart</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="Continue|Start" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAnimationFinished>a_flowerPunchEnd</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="BranchPunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start"/>
          <State name="Continue"/>
          <State name="End"/>
        </States>
        <Transitions>
          <Transition from="Off|End" to="Start">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsAnimationFinished>a_branchPunchStart</IsAnimationFinished>
            </Condition>
          </Transition>
          <Transition from="Continue|Start" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAnimationFinished>a_branchPunchEnd</IsAnimationFinished>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <TileStampData>
      <Set name="FileName">game/particles12.rttex</Set>
      <Set name="EndFrame">12,1</Set>
      <Set name="FrameCount">4</Set>
    </TileStampData>

    <RenderOptions>
      <Default>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
      </Default>
    </RenderOptions>

    <ParticleSystems>
      <ParticleSystem name="hitSpark_particle">
        <Emitter attachment="targetPos">
          <Set name="offset">0,0</Set>
          <Set name="offsetFacing">true</Set>
          <Set name="emissionInterval">0.3</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="rgbTint">0.22, 0.62, 0.32, 1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">HitSpark_Sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="useGravity">true</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.5,0.5</Set>
          <Random name="finalScale" min="0.1" max="0.4"/>
          <Set name="lifeTime">0.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="80,100"/>
          <Set name="gravityVector">0, 100</Set>
          <Random name="initialRotationRate" min="-300" max="300"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>

    <RenderChestItem>
      <SpriteRender name="s_equip" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
      <SpriteRender name="s_flower" blend="PREMULTIPLIED_ALPHA" offset =" 0,-3" alignment="DOWN_CENTER" />
      <SpriteRender name="s_punchBranch" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" onState="BranchPunchAnim.Start|BranchPunchAnim.Continue|BranchPunchAnim.End"/>
      <ParticleSystemUpdate name="hitSpark_particle" onAction="PUNCH"/>
    </RenderChestItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_item" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="19,22"/>
    <Sprite name="s_notes" fileName="game/particles11.rttex" textureSize="32" frame="9,28"/>

    <Animations>
      <SpriteAnimation name="a_notes" sprite="s_notes">
        <Frame>9,28</Frame>
        <Frame>10,28</Frame>
        <Frame>11,28</Frame>
        <Frame>12,28</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Dance">
        <States>
          <State name="False" />
          <State name="True" />
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsDancing>true</IsDancing>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsDancing>false</IsDancing>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_note" updateStage="AddClothingParticles" updateState="Dance.True">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Random name="emissionInterval" min="0.1" max="0.5" />
          <Set name="particlesPerEmission">1</Set>
          <Random name="offset" min="-20,-25" max="20,-25" />
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_notes</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">2</Set>
          <Random name="initialVelocity" min="-10,-20" max="10,-20" />
          <Random name="finalVelocity" min="-10,-30" max="10,-30" />
          <Set name="interpolateVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="-45" max="45"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>

  <RenderRules>
    <RenderFaceItem>
      <SpriteRender name="s_item" offset="1,-1.8" alignment="DOWN_CENTER"/>
    </RenderFaceItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_gaunlet" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="3,9" />
		<Sprite name="s_necklace" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="4,9" />
		
		<Sprite name="s_water" fileName="game/particles4.rttex" textureSize="32" frame="8,15" />
		<Sprite name="s_waterhit" fileName="game/particles12.rttex" textureSize="32" frame="0,19" />
		<Sprite name="s_waterdrop" fileName="game/particles.rttex" textureSize="32" frame="4,14" />

		<Sprite name="s_whale" fileName="game/fish_page1.rttex" textureSize="32" frame="8,1" />
		<Sprite name="s_goldfish" fileName="game/fish_page1.rttex" textureSize="32" frame="0,0" />
		<Sprite name="s_catfish" fileName="game/fish_page1.rttex" textureSize="32" frame="8,0" />
		<Sprite name="s_dogfish" fileName="game/fish_page1.rttex" textureSize="32" frame="4,1" />
		<Sprite name="s_sandshark" fileName="game/fish_page1.rttex" textureSize="32" frame="12,1" />
		<Sprite name="s_stonefish" fileName="game/fish_page1.rttex" textureSize="32" frame="0,2" />
		<Sprite name="s_gar" fileName="game/fish_page1.rttex" textureSize="32" frame="0,3" />

		<Animations>
			<SpriteAnimation name="a_water" sprite="s_water" animTime="400">
				<Frame>11, 15</Frame>
				<Frame>8, 15</Frame>
				<Frame>9, 15</Frame>
				<Frame>10, 15</Frame>
				
			</SpriteAnimation>
		</Animations>

		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="PunchL"/>
					<State name="PunchR"/>
				</States>
				<Transitions>
					<Transition to="None" from="PunchL|PunchR">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="PunchL" from="None">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="PunchR" from="None">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="Player.GetSittingOffset">0,0,0</Set>
			<Set name="Player.GetFacing">0</Set>
			<Set name="offset_fish">-60,-10</Set>
			<Set name="offset_water">-52,-24</Set>
			<Set name="ps_offset_fish">0,0</Set>
			<Set name="ps_offset_water">0,0</Set>
		</VariableMap>
		<ParticleSystems>
			<ParticleSystem name="ps_fishR" updateStage="AddClothingParticles" updateState="Action.PunchR">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Random name="emissionInterval" min="0.2" max="0.5" />
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset" source="ps_offset_fish"/>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="variantId" min="0" max="7" />
					<Select name="sprite" input="variantId">
						<Item>"s_whale"</Item>
						<Item>"s_goldfish"</Item>
						<Item>"s_catfish"</Item>
						<Item>"s_dogfish"</Item>
						<Item>"s_sandshark"</Item>
						<Item>"s_stonefish"</Item>
						<Item>"s_gar"</Item>
					</Select>
					<Select name="initialScale" input="variantId">
						<Item>1,1</Item>
						<Item>0.4,0.4</Item>
						<Item>0.6,0.6</Item>
						<Item>0.6,0.6</Item>
						<Item>0.75,0.75</Item>
						<Item>0.75,0.75</Item>
						<Item>0.75,0.75</Item>
					</Select>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="30"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="-30"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fishL" updateStage="AddClothingParticles" updateState="Action.PunchL">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Random name="emissionInterval" min="0.2" max="0.5" />
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset" source="ps_offset_fish"/>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="variantId" min="0" max="7" />
					<Select name="sprite" input="variantId">
						<Item>"s_whale"</Item>
						<Item>"s_goldfish"</Item>
						<Item>"s_catfish"</Item>
						<Item>"s_dogfish"</Item>
						<Item>"s_sandshark"</Item>
						<Item>"s_stonefish"</Item>
						<Item>"s_gar"</Item>
					</Select>
					<Select name="initialScale" input="variantId">
						<Item>1,1</Item>
						<Item>0.4,0.4</Item>
						<Item>0.6,0.6</Item>
						<Item>0.6,0.6</Item>
						<Item>0.75,0.75</Item>
						<Item>0.75,0.75</Item>
						<Item>0.75,0.75</Item>
					</Select>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="30"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="-30"/>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_WaterR" updateStage="AddClothingParticles" updateState="Action.PunchR">
				<Emitter>
					<Set name="offset" source="ps_offset_water"/>
					<Set name="lifeTime">0.4</Set>
					<Set name="emissionInterval">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_water</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.42</Set>
					<Set name="initialScale">1.5,1.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_WaterL" updateStage="AddClothingParticles" updateState="Action.PunchL">
				<Emitter>
					<Set name="offset" source="ps_offset_water"/>
					<Set name="lifeTime">0.4</Set>
					<Set name="emissionInterval">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_water</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.42</Set>
					<Set name="initialScale">1.5,1.5</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_WaterHitImpact" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0.4</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">0,0</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_waterhit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75,0.75</KeyFrame>
						<KeyFrame>1, 1.75,1.75</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_WaterHitSpray" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="emissionInterval">0.5</Set>
					<Random name="particlesPerEmission" min="6" max="10"/>
				</Emitter>
				<Particle>
					<Set name="sprite">s_waterdrop</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.5, 0.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,75" baseAnglePosition="targetPos" baseOffset="0,16"/>
					<Set name="gravityVector">0, 45</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="IsToRenderParticlesWhenShrunken">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="HideParticlesOnTransform">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<ArithmethicOperation LeftHandVariableName="ps_offset_fish" RightHandVariableName="offset_fish" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="ps_offset_fish.y" RightHandVariableName="Player.GetSittingOffset.y" OperationType="Add"/>
			<ArithmethicOperation LeftHandVariableName="ps_offset_water" RightHandVariableName="offset_water" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="ps_offset_water.y" RightHandVariableName="Player.GetSittingOffset.y" OperationType="Add"/>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderHandItem>
			<SpriteRender name="s_gaunlet" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" rotateOffset="true" />
		</RenderHandItem>
		<RenderFrontArm>
			<SpriteRender name="s_necklace" alignment="DOWN_CENTER" useFixedRotation="true" fixedRotation="0"/>
		</RenderFrontArm>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_bg" fileName="game/particles_large14.rttex" textureSize="64" frame="10,2" />
		<Sprite name="s_bubble" fileName="game/particles12.rttex" textureSize="32" frame="23,3" />
		<Sprite name="s_fish" fileName="game/particles12.rttex" textureSize="32" frame="20,3" />
		<Sprite name="s_pendant" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="25,29" />
		<VariableMap>
			<Set name="target.pos">0, 0</Set>
			<Set name="target.pos.3f">0, 0, 0</Set>
			<Set name="context.pos">0, 0</Set>
			<Set name="punch.transform">0, 0, 0</Set>
			<Set name="punchFacing">0,0,0</Set>
		</VariableMap>
		<Animations>
			<SpriteCurveAnimation name="a_bg_alpha" isLoop="true" autoPlay="true" sprite="s_bg" animTime="3000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.3f</KeyFrame>
					<KeyFrame>0.5f, 0.7f</KeyFrame>
					<KeyFrame>1.f, 0.3f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteSinPulseAnimation name="a_bg_stretchX" isLoop="true" autoPlay="true" sprite="s_bg" animTime="1000">
				<Parameter name="scale.x">
					<Set name="offset">1</Set>
					<Set name="period">2000</Set>
					<Set name="scale">0.05</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_bg_stretchY" isLoop="true" autoPlay="true" sprite="s_bg" animTime="1000">
				<Parameter name="scale.y">
					<Set name="offset">1</Set>
					<Set name="period">5000</Set>
					<Set name="scale">0.03</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_bg_rotate" isLoop="true" autoPlay="true" sprite="s_bg" animTime="1000">
				<Parameter name="rotation">
					<Set name="offset">0</Set>
					<Set name="period">700</Set>
					<Set name="scale">0.2</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteAnimation name="a_fish" sprite="s_fish" animTime="300">
				<Frame>20,3</Frame>
				<Frame>21,3</Frame>
				<Frame>22,3</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Sit">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsSitting>false</IsSitting>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsSitting>true</IsSitting>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_bubble" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -4</Set>
					<Random name="emissionInterval" min="0.1" max="1.4" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_bubble</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-22, -4" max="22, 4" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">2</Set>
					<Curve name="initialVelocity">
						<KeyFrame>0, 0, -30</KeyFrame>
						<KeyFrame>0.25, 10, -30</KeyFrame>
						<KeyFrame>0.5, 0, -30</KeyFrame>
						<KeyFrame>0.75, -5, -30</KeyFrame>
						<KeyFrame>1, 0, -30</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fish_backLR" updateStage="AddClothingParticles" updateState="Punch.No">
				<Emitter>
					<Set name="offset">-32, -5</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">2.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_fish</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="0, -32" max="0, 0" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">0.6, 0.7, 0.9</Set>
					<Set name="initialScale">0.8, 0.8</Set>
					<Set name="lifeTime">1.5</Set>
					<Set name="initialVelocity">40, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fish_backRL" updateStage="AddClothingParticles" updateState="Punch.No">
				<Emitter>
					<Set name="offset">32, -5</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">2.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_fish</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="0, -32" max="0, 0" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<Set name="initalRGB">0.6, 0.7, 0.9</Set>
					<Set name="initialScale">0.8, 0.8</Set>
					<Set name="lifeTime">1.5</Set>
					<Set name="initialVelocity">-40, 0</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fish_frontLR" updateStage="AddClothingParticles" updateState="Punch.No">
				<Emitter>
					<Set name="offset">-32, -5</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">1.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_fish</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="0, -32" max="0, 0" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1.2, 1.2</Set>
					<Set name="lifeTime">1.5</Set>
					<Set name="initialVelocity">40, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_fish_frontRL" updateStage="AddClothingParticles" updateState="Punch.No">
				<Emitter>
					<Set name="offset">32, -10</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">1.9</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_fish</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="0, -22" max="0, 10" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.25, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1.2, 1.2</Set>
					<Set name="lifeTime">1.5</Set>
					<Set name="initialVelocity">-40, 0</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punch_fish_frontRL">
				<Emitter>
					<Set name="offset">20, 0</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">0.75</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_fish</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="0, -16" max="0, 16" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1.2, 1.2</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">-50, 0</Set>
					<Set name="flipX">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punch_fish_frontLR">
				<Emitter>
					<Set name="offset">-20, 2</Set>
					<Set name="offsetFacing">false</Set>
					<Set name="emissionInterval">0.55</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_fish</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="0, -14" max="0, 14" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1.2, 1.2</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">50, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hit_bubble" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_bubble</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<Random name="offset" min="-16, 16" max="16, 12" />
					<Curve name="initialVelocity">
						<KeyFrame>0, 0, -30</KeyFrame>
						<KeyFrame>0.25, 10, -30</KeyFrame>
						<KeyFrame>0.5, 0, -30</KeyFrame>
						<KeyFrame>0.75, -5, -30</KeyFrame>
						<KeyFrame>1, 0, -30</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="IgnorePunchTypeDamagedTileCheck">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<AddClothingParticles>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<Group>
				<ArithmethicOperation LeftHandVariableName="punch.transform" RightHandVariableName="target.pos" OperationType="Set" />
				<ArithmethicOperation LeftHandVariableName="punch.transform" RightHandVariableName="context.pos" OperationType="Substract" />
				<Group onState="Sit.No">
					<ArithmethicOperation LeftHandVariableName="punch.transform" RightHandVariableName="punchFacing" OperationType="Multiply" />
				</Group>
				<Translate>punch.transform</Translate>
				<ParticleSystemUpdate name="ps_punch_fish_frontRL" onState="Punch.Yes"/>
				<ParticleSystemUpdate name="ps_punch_fish_frontLR" onState="Punch.Yes"/>
			</Group>
		</AddClothingParticles>
		<RenderChestItem>
			<SpriteRender name="s_pendant" alignment="DOWN_CENTER" />
		</RenderChestItem>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsZombified>true</IsZombified>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
			</StopIf>
			<Group>
				<ContextUpdate type="SetFlip">
					<Set name="flip">0,0</Set>
				</ContextUpdate>
				<SpriteRender name="s_bg" alignment="CENTER" drawShadow="false" offset="0,-32" blend="PREMULTIPLIED_ALPHAd" />
			</Group>
			<ParticleSystemRender name="ps_fish_backRL" />
			<ParticleSystemRender name="ps_fish_backLR" />
		</RenderBehind>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_woolFront" fileName="game/particles12.rttex" textureSize="32" frame="14,8" />
    <Sprite name="s_woolBack" fileName="game/particles12.rttex" textureSize="32" frame="15,8" />
    <Sprite name="s_backNeedle" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="1,10" />
    <Sprite name="s_thread" fileName="game/particles12.rttex" textureSize="32" frame="12,8" />
    <Sprite name="s_smoke" fileName="game/particles12.rttex" textureSize="32" frame="14,7" />

    <Animations>
      <SpriteAnimation name="a_thread" sprite="s_thread">
        <Frame>12,8</Frame>
        <Frame>13,8</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_smoke" sprite="s_smoke" animTime="500">
        <Frame>23,7</Frame>
        <Frame>14,7</Frame>
        <Frame>15,7</Frame>
        <Frame>16,7</Frame>
        <Frame>17,7</Frame>
        <Frame>18,7</Frame>
        <Frame>19,7</Frame>
        <Frame>20,7</Frame>
        <Frame>21,7</Frame>
        <Frame>22,7</Frame>
      </SpriteAnimation>
    </Animations>
    
    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="No" />
          <State name="Yes" />
        </States>
        <Transitions>
          <Transition to="No" from="Yes">
            <Condition type="or">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsZombified>true</IsZombified>
            </Condition>
          </Transition>
          <Transition to="Yes" from="No">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_punchProjectile" updateStage="RenderChestItem" updateState="Punch.Yes">
        <Emitter attachment="handspotRoot">
          <Set name="lifeTime">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_thread</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.1</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Random name="flipX" min="false" max="true"/>
          <Set name="isBeamParticle">true</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_explosion" updateStage="OnPunchStart">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.5</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="emissionInterval">0.15</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_smoke</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Set name="initialRotationRate">360</Set>
          <Set name="initialScale">2,2</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>


    <RenderOptions>
      <Default>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
      </Default>
    </RenderOptions>

  </Data>
  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1500</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderChestItem>
      <SpriteRender name="s_woolFront" offset="-15,-15.5" />
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
    </RenderChestItem>
    <RenderChestBackItem>
      <SpriteRender name="s_woolBack" offset="6,-16" />
      <Rotate>22,0,0,1</Rotate>
      <SpriteRender name="s_backNeedle" offset="5,-12" onState="Punch.No"/>
    </RenderChestBackItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="s_wheel1" fileName="game/player_feet16.rttex" textureSize="32,32" frame="31,24" />
        <Sprite name="s_wheel2" fileName="game/player_feet16.rttex" textureSize="32,32" frame="31,25" />
        <Sprite name="s_wheelShadow" fileName="game/particles12.rttex" textureSize="32,32" frame="21,13" />
        <Sprite name="s_flame" fileName="game/particles12.rttex" textureSize="32,32" frame="22,13" />
		<Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32,32" frame="23,13" />
        <Animations>
			<CurveAnimationVec4 name="a_wheel.rotation1" isLoop="true" autoPlay="true" animTime="1700">
				<Curve name="wheel.rotation1">
					<KeyFrame>0, 0, 0,0,1</KeyFrame>
					<KeyFrame>1, 360, 0,0,1</KeyFrame>
				</Curve>
			</CurveAnimationVec4>
			<CurveAnimationVec4 name="a_wheel.rotation2" isLoop="true" autoPlay="true" animTime="1700">
				<Curve name="wheel.rotation2">
					<KeyFrame>0, 180, 0,0,1</KeyFrame>
					<KeyFrame>1, 540, 0,0,1</KeyFrame>
				</Curve>
			</CurveAnimationVec4>
		</Animations>
        <ParticleSystems>
			<ParticleSystem name="PS_TrailB1">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,-1</Set>
                    <Set name="emissionInterval">0.02</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="false" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Set name="renderAlignment">CENTER</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Set name="initialAngle">0</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="flipX">false</Set>
                    <Set name="flipY">false</Set>
                    <Set name="lifeTime">0.5</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Set name="sprite">s_flame</Set>
					<Random name="initialVelocity" min="-2,2" max="-2,2" />
					<Set name="initialScale">0.5,0.5</Set>
                </Particle>
            </ParticleSystem>
			<ParticleSystem name="PS_TrailB2">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,-1</Set>
                    <Set name="emissionInterval">0.02</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="false" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Set name="renderAlignment">CENTER</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Set name="initialAngle">0</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="flipX">false</Set>
                    <Set name="flipY">false</Set>
                    <Set name="lifeTime">0.5</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Set name="sprite">s_flame</Set>
					<Random name="initialVelocity" min="-2,2" max="-2,2" />
					<Set name="initialScale">0.5,0.5</Set>
                </Particle>
            </ParticleSystem>
			<ParticleSystem name="PS_TrailF1">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,-1</Set>
                    <Set name="emissionInterval">0.02</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="false" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Set name="renderAlignment">CENTER</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Set name="initialAngle">0</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="flipX">false</Set>
                    <Set name="flipY">false</Set>
                    <Set name="lifeTime">0.5</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Set name="sprite">s_flame</Set>
					<Random name="initialVelocity" min="-2,2" max="-2,2" />
					<Set name="initialScale">0.5,0.5</Set>
                </Particle>
            </ParticleSystem>
			<ParticleSystem name="PS_TrailF2">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,-1</Set>
                    <Set name="emissionInterval">0.02</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="false" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Set name="renderAlignment">CENTER</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,1</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Set name="initialAngle">0</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="flipX">false</Set>
                    <Set name="flipY">false</Set>
                    <Set name="lifeTime">0.5</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Set name="sprite">s_flame</Set>
					<Random name="initialVelocity" min="-2,2" max="-2,2" />
					<Set name="initialScale">0.5,0.5</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="PS_Flame1">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">-7,-8</Set>
                    <Set name="emissionInterval">0.15</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">2</Set>
					<Set name="useCharacterPos">true</Set>
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="false" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Set name="renderAlignment">CENTER</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,0.7</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Set name="initialAngle">0</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="flipX">false</Set>
                    <Set name="flipY">false</Set>
                    <Set name="lifeTime">0.35</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Random name="initialScale" min="0.39,0.75" max="0.78,0.975" />
                    <Set name="sprite">s_flame</Set>
                    <Random name="initialVelocity" min="-12,8" max="12,-10" />
					<Set name="inSpecificOrder">true</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="PS_Flame2">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">7,-8</Set>
                    <Set name="emissionInterval">0.15</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">2</Set>
					<Set name="useCharacterPos">true</Set>
                </Emitter>
                <Particle alternateSpriteFrameWithPunch="false" angleRelativeToPlayerSpeed="false" autoLifeTimeToTarget="false" particleIndexSpriteFrame="false" randomSpriteFrame="false" UseParentEmitterAngle="false" UseParentScale="false" UseParentVariantId="false" usePlayerFacing="false" velocityRelativeToPlayerSpeed="false">
                    <Set name="renderAlignment">CENTER</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0,0.7</KeyFrame>
                        <KeyFrame>1,0</KeyFrame>
                    </Curve>
                    <Set name="initialAngle">0</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="inSpecificOrder">false</Set>
                    <Set name="flipX">false</Set>
                    <Set name="flipY">false</Set>
                    <Set name="lifeTime">0.35</Set>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="rotateWithVelocity">false</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Random name="initialScale" min="0.39,0.75" max="0.78,0.975" />
                    <Set name="sprite">s_flame</Set>
                    <Random name="initialVelocity" min="-12,8" max="12,-10" />
					<Set name="inSpecificOrder">true</Set>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>
        <VariableMap>
            <Set name="wheel.rotation1">0,0,0,0</Set>
			<Set name="wheel.rotation2">0,0,0,0</Set>
			<Set name="wheel.offset1">0,-5,0</Set>
			<Set name="wheel.offset2">-0.5,-5.5,0</Set>
        </VariableMap>
        <StateMachines>
			<StateMachine name="Moving">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
        <RenderOptions>
            <Default>
                <Set name="AdditionalClothingOffset">0</Set>
                <Set name="AllowChangePunchType">false</Set>
                <Set name="ClothingOffsetFromShoes">-13</Set>
                <Set name="DefaultPunchSound" />
                <Set name="DefaultRenderMannequinHandItem">true</Set>
                <Set name="DisableDefaultAncestralParticleEffects">false</Set>
                <Set name="DisableWalkAnimation">true</Set>
                <Set name="EnableBobbingOffset">false</Set>
                <Set name="HasDeathParticles">false</Set>
                <Set name="Head.Sprite" />
                <Set name="Head.Sprite.Sit" />
                <Set name="Head.Sprite.Sleep" />
                <Set name="HideAngelOnDeath">false</Set>
                <Set name="HideAvatarOnDeath">false</Set>
                <Set name="HideParticlesOnSleepingInBed">false</Set>
                <Set name="HideParticlesOnTheaterSeat">false</Set>
                <Set name="HideParticlesOnTransform">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">false</Set>
                <Set name="IgnoreDefaultDestroyedTileEffect">false</Set>
                <Set name="IgnoreParticlesInShadowMods">true</Set>
                <Set name="IgnorePunchTypeCheck">false</Set>
                <Set name="IgnorePunchTypeCheckForNormalPunchOnly">false</Set>
                <Set name="IgnorePunchTypeDamagedTileCheck">false</Set>
                <Set name="IncludeAllActions">false</Set>
                <Set name="IsBed">false</Set>
                <Set name="IsCar">false</Set>
                <Set name="IsFacingChangeDisabled">false</Set>
                <Set name="IsHorse">false</Set>
                <Set name="IsNightVision">false</Set>
                <Set name="IsPetWithLight">false</Set>
                <Set name="IsPulseShoes">false</Set>
                <Set name="IsRidingBird">false</Set>
                <Set name="IsRv">false</Set>
                <Set name="IsSkateboard">false</Set>
                <Set name="IsSurfboard">false</Set>
                <Set name="IsToRenderPants">true</Set>
                <Set name="IsToRenderParticlesWhenShrunken">false</Set>
                <Set name="IsVehicle">false</Set>
                <Set name="JumpEndStateRange">0</Set>
                <Set name="NeedRenderBareFeetWithShoesItem">true</Set>
                <Set name="NeedRenderPet">false</Set>
                <Set name="PetOffsetDuplication">32,0</Set>
                <Set name="PlayDefaultPunchAudio">true</Set>
                <Set name="PunchSoundOverride" />
                <Set name="RenderBackArmAfterItem">false</Set>
                <Set name="RenderBackArmBuild">true</Set>
                <Set name="RenderBackArmInTheFront">false</Set>
                <Set name="RenderBackArmInfected">false</Set>
                <Set name="RenderFrontArmInTheFront">false</Set>
                <Set name="RenderFrontArmInfected">false</Set>
                <Set name="RenderShoesWithMermaidTail">true</Set>
                <Set name="RenderWhenZombie">true</Set>
                <Set name="ShoesHidesBodyLegs">false</Set>
                <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
                <Set name="ShouldHover">false</Set>
                <Set name="SleepHidesPlayer">false</Set>
                <Set name="UseActionsWithStates">false</Set>
                <Set name="UsePetForceFaceTime">true</Set>
                <Set name="UseRecoilAnim">false</Set>
                <Set name="UserNameOffset">0</Set>
            </Default>
        </RenderOptions>
    </Data>
    <RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="FootPosition">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
		</Update>
        <RenderShoes>
            <Translate forceValue="false">-5,7,0</Translate>
            <Group>
                <Translate forceValue="false">11,0,0</Translate>
                <Rotate forceValue="false" incrementRotate="true">wheel.rotation1</Rotate>
                <SpriteRender name="s_wheel1" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" drawShadow="true" rotateOffset="true" rotationPoint="-0.5,-0.5" />
            </Group>
			<Group>
				<Translate forceValue="false" incrementRotate="true">9,-10.5,0</Translate>
				<SpriteRender name="s_wheelShadow" blend="NORMAL" alignment="CENTER" drawShadow="false"/>
			</Group>
			<Group>
                <Rotate forceValue="false" incrementRotate="true">wheel.rotation2</Rotate>
                <SpriteRender name="s_wheel2" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" drawShadow="true" rotateOffset="true" rotationPoint="-0.5,-0.5"/>
            </Group>
			<ParticleSystemRender name="PS_Flame2" />
			<ParticleSystemRender name="PS_Flame1" />
        </RenderShoes>
		<AddClothingParticles>
			<StopIf type="or">
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<Translate forceValue="false">-5,5.5,0</Translate>
			<Group>
				<ParticleSystemUpdate name="PS_Flame2" />
				<Group>
					<Rotate forceValue="false">wheel.rotation2</Rotate>
					<Translate forceValue="false">0,-5,0</Translate>
					<ParticleSystemUpdate name="PS_TrailF1" onState="Moving.Yes"/>
				</Group>
				<Group>
					<Rotate forceValue="false">wheel.rotation2</Rotate>
					<Translate forceValue="false">0,5,0</Translate>
					<ParticleSystemUpdate name="PS_TrailF2" onState="Moving.Yes"/>
				</Group>
            </Group>
            <Group>
				<ParticleSystemUpdate name="PS_Flame1" />
				<Translate forceValue="false">11,0,0</Translate>
				<Group>
					<Rotate forceValue="false">wheel.rotation1</Rotate>
					<Translate forceValue="false">0,-5,0</Translate>
					<ParticleSystemUpdate name="PS_TrailB1" onState="Moving.Yes"/>
				</Group>
				<Group>
					<Rotate forceValue="false">wheel.rotation1</Rotate>
					<Translate forceValue="false">0,5,0</Translate>
					<ParticleSystemUpdate name="PS_TrailB2" onState="Moving.Yes"/>
				</Group>
            </Group>
		</AddClothingParticles>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_flash" fileName="game/tf_page4.rttex" textureSize="64" frame="14,2" />
		<Sprite name="s_hit" fileName="game/particles_large14.rttex" textureSize="64" frame="0,15" />
		<Sprite name="s_pendant" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="28,25" />
		<Sprite name="s_shard" fileName="game/particles10.rttex" textureSize="32" frame="30,6" />
		<Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32" frame="5,0" />
		<Sprite name="s_transform" fileName="game/tf_page4.rttex" textureSize="64" frame="0,2" />
		<StateMachines>
			<StateMachine name="Main">
				<States>
					<State name="Idle" />
					<State name="Walk" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="PunchOnGround" />
					<State name="PunchInAir" />
				</States>
        <Transitions>
          <Transition to="Idle" from="Walk|Fall|PunchOnGround|Jump|PunchInAir">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Walk" from="Idle|Fall|PunchOnGround|PunchInAir|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Walk|Fall|PunchInAir|PunchOnGround">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Walk|PunchInAir|PunchOnGround">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operator="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="PunchOnGround" from="Idle|Walk|PunchInAir|Jump|Fall">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="PunchInAir" from="Idle|Walk|Jump|Fall|PunchOnGround">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
			</StateMachine>
			<StateMachine name="IsTransformed">
				<States>
					<State name="No" />
					<State name="Yes" />
					<State name="Changing" />
				</States>
				<Transitions>
					<Transition to="Yes" from="Changing">
						<Condition>
							<IsItemTransformed>true</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="No" from="Changing">
						<Condition>
							<IsItemTransformed>false</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="Changing" from="Yes">
						<Condition>
							<IsItemTransformed>false</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="Changing" from="No">
						<Condition>
							<IsItemTransformed>true</IsItemTransformed>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="AllowChangePunchType">true</Set>
			</Default>
      <Override overrideOnState="IsTransformed.Yes">
        <Set name="UserNameOffset">16</Set>
      </Override>
		</RenderOptions>
		<Animations>
			<SpriteAnimation name="a_hit" sprite="s_hit" animTime="600">
				<Frame>3,15</Frame>
				<Frame>0,15</Frame>
				<Frame>1,15</Frame>
				<Frame>2,15</Frame>
				<Frame>3,15</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_idle" sprite="s_transform" animTime="900" isLoop="true" playOnState="Main.Fall|Main.Idle|Main.Jump|Main.Walk">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punch" sprite="s_transform" animTime="500" isLoop="true" playOnState="Main.PunchInAir|Main.PunchOnGround">
				<Frame>9,2</Frame>
				<Frame>10,2</Frame>
				<Frame>11,2</Frame>
				<Frame>12,2</Frame>
				<Frame>13,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_shards" sprite="s_shard" animTime="200">
				<Frame>30,6</Frame>
				<Frame>31,6</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="p_flash" updateStage="AddClothingParticles" updateState="IsTransformed.Changing">
				<Emitter>
					<Set name="offset">0, -32</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true" usePlayerFacing="true">
					<Set name="sprite">s_flash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1.25, 1.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_flashShards" updateStage="AddClothingParticles" updateState="IsTransformed.Changing">
				<Emitter>
					<Set name="offset">0, -32</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">16</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" usePlayerFacing="true" usePlayerFacing="true">
					<Set name="sprite">s_shard</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.8, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="120,170" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">10, -26</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true" autoLifeTimeToTarget="true" >
					<Set name="sprite">s_slash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initialScale">2, 2</Set>
					<RandomRadial name="initialVelocity" angleRange="0" radiusRange="160,160" baseAnglePosition="targetPos" baseOffset="0,16"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="s_pendant" alignment="DOWN_CENTER" />
		</RenderChestItem>
		<RenderTransform>
			<SpriteRender name="s_transform" offset="0,-8" />
		</RenderTransform>
		<OnDamagedTile>
			<StopIf>
				<IsItemTransformed>false</IsItemTransformed>
			</StopIf>
		</OnDamagedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Pet" fileName="game/particles_large18.rttex" textureSize="64" frame="0,5" />
    <Sprite name="s_punchLines" fileName="game/particles12.rttex" textureSize="32" frame="11,20" />
    <Sprite name="s_curvedFeather" fileName="game/particles12.rttex" textureSize="32" frame="13,20" />
    <Sprite name="s_death" fileName="game/particles_large18.rttex" textureSize="64" frame="0,6" />
    <Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="14,20" />
    <Animations>
      <SpriteAnimation name="a_trail" sprite="s_trail" animTime="1200">
        <Frame>19,20</Frame>
        <Frame>14,20</Frame>
        <Frame>15,20</Frame>
        <Frame>16,20</Frame>
        <Frame>17,20</Frame>
        <Frame>18,20</Frame>
        <Frame>19,20</Frame>
        <Frame>19,20</Frame>
        <Frame>19,20</Frame>
        <Frame>19,20</Frame>
        <Frame>19,20</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_death" sprite="s_death" animTime="1000">
        <Frame>6,6</Frame>
        <Frame>0,6</Frame>
        <Frame>1,6</Frame>
        <Frame>2,6</Frame>
        <Frame>3,6</Frame>
        <Frame>4,6</Frame>
        <Frame>5,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="700" isLoop="true" playOnState="Action.None">
        <Frame>0,5</Frame>
        <Frame>1,5</Frame>
        <Frame>2,5</Frame>
        <Frame>3,5</Frame>
        <Frame>4,5</Frame>
        <Frame>5,5</Frame>
        <Frame>6,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetPunch" sprite="s_Pet" animTime="600" isLoop="true" playOnState="Action.Punch">
        <Frame>7,5</Frame>
        <Frame>8,5</Frame>
        <Frame>9,5</Frame>
        <Frame>10,5</Frame>
        <Frame>11,5</Frame>
        <Frame>12,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_curvedFeather" sprite="s_curvedFeather">
        <Frame>13,20</Frame>
        <Frame>14,20</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchLines" sprite="s_punchLines">
        <Frame>11,20</Frame>
        <Frame>12,20</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Spawn" />
          <State name="None" />
          <State name="Punch" />
          <State name="Dying" IsTemporary="true"/>
        </States>
        <Transitions>
          <Transition to="None" from="Punch|Spawn">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">DIE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None|Spawn">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsAction operatorType="NotEqual">DIE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Dying" from="None|Punch">
            <Condition>
              <IsAction>DIE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Spawn" from="Dying"/>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">100</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsVariableFloat name="pet.velocity.length" operator="Greater" abs="true">100</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_punchFeathers">
        <Emitter>
          <Set name="offset">8, -24</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">3</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_curvedFeather</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Random name="initialScale" min="0.25" max="0.5"/>
          <Random name="targetPosOffset" min="-8,-8" max="8,8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
          <Random name="initialRotationRate" min="-360" max="360"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchLines">
        <Emitter>
          <Set name="offset">8, -24</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_punchLines</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 2, 1</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_destroyFeathers">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">10</Set>
          <Set name="emissionInterval">0.035</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="offset">0,0</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_curvedFeather</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1.5</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 50</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,100"/>
          <Random name="initialRotationRate" min="-360" max="360"/>
          <Curve name="initialScale">
            <KeyFrame>0, 0.65, 0.65</KeyFrame>
            <KeyFrame>1, 0.15, 0.15</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="offset">-20,-8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_trail</Set>
          <Random name="offset" min="-8,-32" max="8,-16" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="initialScale">0.4, 0.4</Set>
          <Set name="lifeTime">1.2</Set>
          <RandomRadial name="initialVelocity" angleRange="230,310" radiusRange="5,25" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.7, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="gravityVector" min="0, 45" max="0, 60" />
          <Random name="initialRotationRate" min="-60" max="60" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_death">
        <Emitter>
          <Set name="lifeTime">1.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,-32</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_death</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1.0</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-48,0</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="HasDeathParticles">true</Set>
        <Set name="IncludeAllActions">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_destroyFeathers" />
    </OnDestroyedTile>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderPet>
      <SpriteRender name="s_Pet" alignment="DOWN_CENTER" onState="Action.None|Action.Punch"/>
      <ParticleSystemUpdate name="ps_death" onState="Action.Dying"/>
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
      </StopIf>
      <ParticleSystemUpdate name="ps_punchLines" onState="Action.Punch"/>
      <ParticleSystemUpdate name="ps_punchFeathers" onState="Action.Punch"/>

      <Group onState="Action.None|Action.Punch">
        <ParticleSystemUpdate name="ps_trail" onState="Motion.Moving"/>
      </Group>
    </RenderPet>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_waves" fileName="game/particles_large14.rttex" textureSize="64" frame="12,13" />
    <Sprite name="s_wings" fileName="game/particles_large14.rttex" textureSize="64" frame="13,9" />
    <Sprite name="s_droplet" fileName="game/particles12.rttex" textureSize="32" frame="24,3" />

    <Animations>
      <SpriteAnimation name="a_equip" sprite="s_wings" playOnState="Action.Idle" isLoop="true" animTime="300">
        <Frame>13,9</Frame>
        <Frame>14,9</Frame>
        <Frame>15,9</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump" sprite="s_wings" animTime="400" playOnState="Action.Jump">
        <Frame>11,2</Frame>
        <Frame>12,2</Frame>
        <Frame>13,2</Frame>
        <Frame>12,2</Frame>
        <Frame>13,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall" sprite="s_wings" animTime="300" isLoop="true" playOnState="Action.Fall">
        <Frame>13,2</Frame>
        <Frame>12,2</Frame>
        <Frame>11,2</Frame>
        <Frame>12,2</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_waves" sprite="s_waves" autoPlay="true" isLoop="true" animTime="300">
        <Frame>12,13</Frame>
        <Frame>13,13</Frame>
        <Frame>14,13</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Idle" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Fall">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_doubleJump">
        <Emitter>
          <Set name="offset">0, -24</Set>
          <Set name="lifeTime">0.75</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">8</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="delayTimer">0</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_droplet</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.75</Set>
          <Random name="initialScale" min="0.5" max="1"/>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="100,150"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="drop_particles_left" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="offset">-20,-32</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle velocityRelativeToPlayerSpeed="true">
          <Set name="sprite">s_droplet</Set>
          <Random name="offset" min="-6, -8" max="6, 8"/>
          <Set name="inSpecificOrder">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.8</Set>
          <Set name="initialVelocity">-10, -40</Set>
          <Set name="gravityVector">0, 100</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="drop_particles_right" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="offset">20,-32</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle velocityRelativeToPlayerSpeed="true">
          <Set name="sprite">s_droplet</Set>
          <Random name="offset" min="-6, -8" max="6, 8"/>
          <Set name="inSpecificOrder">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.8, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.8</Set>
          <Set name="initialVelocity">-10, -40</Set>
          <Set name="gravityVector">0, 100</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="HideParticlesOnTransform">true</Set>
        <Set name="HideParticlesOnTheaterSeat">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>

    <RenderInFront value="playerGround">
      <StopIf type="or">
        <IsTrnsformed>true</IsTrnsformed>
        <IsVariableBool name="isInvisible">true</IsVariableBool>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="s_waves" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" drawShadow="false" onState="Action.Idle"/>
    </RenderInFront>

    <RenderBackpack>
      <SpriteRender name="s_wings" offset="-7,-13" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA" />
      <SpriteRender name="s_wings" offset="7,-13" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA" />
    </RenderBackpack>

    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_doubleJump" onAction="JUMPDOUBLE"/>
    </AddClothingParticles>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_brain" fileName="game/particles_large14.rttex" textureSize="64" frame="10,9"/>
    <Sprite name="s_brainGlow" fileName="game/particles_large14.rttex" textureSize="64" frame="11,9"/>
    <Sprite name="lineSprite" fileName="game/particles11.rttex" textureSize="32" frame="19,29"/>
    <Sprite name="sparkSprite" fileName="game/particles11.rttex" textureSize="32" frame="18,29"/>

    <Animations>
      <SpriteCurveAnimation name="a_brainGlow" isLoop="true" playOnState="Punch.False" sprite="s_brainGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_brainGlowPunch" isLoop="true" playOnState="Punch.True" sprite="s_brainGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 1.f</KeyFrame>
          <KeyFrame>1.f, 1.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="LineAura" updateStage="RenderHat" updateState="Punch.True">
        <Emitter>
          <Set name="offset">0, -24</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">lineSprite</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.1, 0.5</Set>
          <Random name="finalScale" min="5, 0.5" max="3, 0.5"/>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="LineMoveAura" updateStage="RenderHat" updateState="Punch.True">
        <Emitter>
          <Set name="offset">0, -24</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">3</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">lineSprite</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.5, 0.5" max="1.5, 0.5"/>
          <Set name="lifeTime">0.5</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,60"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="SparksAura" updateStage="RenderHat" updateState="Punch.True">
        <Emitter>
          <Set name="offset">0, -24</Set>
          <Set name="emissionInterval">0.5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">3</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">sparkSprite</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialScale">0.5, 0.5</Set>
          <Set name="lifeTime">0.75</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="35,35"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <RenderHat>
      <SpriteRender name="s_brain" alignment="DOWN_CENTER" offset="-1,0"/>
      <SpriteRender name="s_brainGlow" alignment="DOWN_CENTER" offset="-1,0" drawShadow="false"/>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
    </RenderHat>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_staff" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="3,16" />
    <Sprite name="s_pet" fileName="game/pets/p_ancientlitch.rttex" textureSize="64" frame="0,0" />
    <Sprite name="s_projectile" fileName="game/particles11.rttex" textureSize="32" frame="31,6" />

    <Animations>
      <SpriteAnimation name="a_Attack" sprite="s_pet" animTime="100" isLoop="true" playOnState="Motion.PunchRight|Motion.PunchLeft">
        <Frame>8,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Fall" sprite="s_pet" animTime="100" isLoop="true" playOnState="Motion.Down">
        <Frame>7,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Idle" sprite="s_pet" animTime="900" isLoop="true" playOnState="Motion.None">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Jump" sprite="s_pet" animTime="100" isLoop="true" playOnState="Motion.Up">
        <Frame>6,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_Move" sprite="s_pet" animTime="300" isLoop="true" playOnState="Motion.Horizontal">
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_projectile" sprite="s_projectile" animTime="200" isLoop="true">
        <Frame>31,6</Frame>
        <Frame>31,7</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="None" />
          <State name="Up" />
          <State name="Down" />
          <State name="Horizontal" />
          <State name="PunchLeft" />
          <State name="PunchRight" />
        </States>
        <Transitions>
          <Transition to="None" from="PunchRight|PunchLeft|Up|Down|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Up" from="PunchRight|PunchLeft|None|Down|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Down" from="PunchRight|PunchLeft|None|Up|Horizontal">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Horizontal" from="PunchRight|PunchLeft|None|Down|Up">
            <Condition type="and">
              <IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="PunchLeft" from="None|Up|Down|Horizontal|PunchRight">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="pet.facingLeft">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="PunchRight" from="None|Up|Down|Horizontal|PunchLeft">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsVariableBool name="pet.facingLeft">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <VariableMap>
      <Set name="context.pos">0, 0</Set>
    </VariableMap>

    <ParticleSystems>
      <ParticleSystem name="ps_punchProjectileRight">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="targetPos" source="context.pos"/>
          <Set name="targetPosOffset">-32,-16</Set>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
          <Curve name="initialScale">
            <KeyFrame>0, 1.5,1.5</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchProjectileLeft">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="targetPos" source="context.pos"/>
          <Set name="targetPosOffset">32,-16</Set>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
          <Curve name="initialScale">
            <KeyFrame>0, 1.5,1.5</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <RenderOptions>
      <Default>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-36,0</Set>
        <Set name="UsePetForceFaceTime">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnorePunchTypeCheck">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
      <Override overrideOnState="Motion.PunchRight|Motion.PunchLeft">
        <Set name="RenderFrontArmInTheFront">false</Set>
      </Override>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderHandItem>
      <SpriteRender name="s_staff" rotationPoint="0,1" offset="0,8" rotateOffset="true" flip="1,0" onState="Motion.None|Motion.Up|Motion.Down|Motion.Horizontal"/>
      <SpriteRender name="s_staff" rotationPoint="0,1" offset="-3.5,8" rotateOffset="true" flip="0,1" onState="Motion.PunchRight|Motion.PunchLeft"/>
    </RenderHandItem>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.PunchRight|Motion.PunchLeft">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">270</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.PunchRight|Motion.PunchLeft">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">90</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderPet>
      <SpriteRender name="s_pet" offset="-32,0" alignment="DOWN_CENTER" />
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
      </StopIf>
      <ParticleSystemUpdate name="ps_punchProjectileRight" onState="Motion.PunchRight"/>
      <ParticleSystemUpdate name="ps_punchProjectileLeft" onState="Motion.PunchLeft"/>
    </RenderPet>
    <UpdatePet>
      <ContextUpdate type="SetPetWalkRunJump">
        <Set name="PetWalkRunJump.minSpeed">500</Set>
        <Set name="PetWalkRunJump.distSpeedMult">20</Set>
      </ContextUpdate>
    </UpdatePet>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_pendant" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="22,7" />
		<Sprite name="s_transform" fileName="game/tf_page5.rttex" textureSize="64" frame="0,0" />
		<Sprite name="s_flash" fileName="game/tf_page5.rttex" textureSize="64" frame="3,1" />
		<Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32" frame="27,13" />
		<Sprite name="s_shard" fileName="game/particles12.rttex" textureSize="32" frame="28,13" />
		<Sprite name="s_shard2" fileName="game/particles12.rttex" textureSize="32" frame="30,13" />
		<Sprite name="s_hit" fileName="game/tf_page5.rttex" textureSize="64" frame="15,1" />

		<StateMachines>
			<StateMachine name="Main">
				<States>
					<State name="Idle" />
					<State name="Walk" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="PunchOnGround" />
					<State name="PunchInAir" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Walk|Fall|PunchOnGround|Jump|PunchInAir">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operator="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Walk" from="Idle|Fall|PunchOnGround|PunchInAir|Jump">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operator="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Walk|Fall|PunchInAir|PunchOnGround">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operator="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Walk|PunchInAir|PunchOnGround">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operator="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="PunchOnGround" from="Idle|Walk|PunchInAir|Jump|Fall">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="PunchInAir" from="Idle|Walk|Jump|Fall|PunchOnGround">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="IsTransformed">
				<States>
					<State name="No" />
					<State name="Transition" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="Yes" from="Transition">
						<Condition>
							<IsItemTransformed>true</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="No" from="Transition">
						<Condition>
							<IsItemTransformed>false</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="Transition" from="No">
						<Condition>
							<IsItemTransformed>true</IsItemTransformed>
						</Condition>
					</Transition>
					<Transition to="Transition" from="Yes">
						<Condition>
							<IsItemTransformed>false</IsItemTransformed>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="AllowChangePunchType">true</Set>
			</Default>
			<Override overrideOnState="IsTransformed.Yes">
				<Set name="UserNameOffset">16</Set>
			</Override>
		</RenderOptions>
		<Animations>
			<SpriteAnimation name="a_idle" sprite="s_transform" animTime="800" isLoop="true" playOnState="Main.Idle">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_walk" sprite="s_transform" animTime="600" isLoop="true" playOnState="Main.Walk">
				<Frame>8,0</Frame>
				<Frame>9,0</Frame>
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
				<Frame>12,0</Frame>
				<Frame>13,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_jump" sprite="s_transform" animTime="100" isLoop="true" playOnState="Main.Jump">
				<Frame>14,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_fall" sprite="s_transform" animTime="200" isLoop="true" playOnState="Main.Fall">
				<Frame>15,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punch" sprite="s_transform" animTime="1100" isLoop="true" playOnState="Main.PunchOnGround">
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
				<Frame>8,1</Frame>
				<Frame>9,1</Frame>
				<Frame>10,1</Frame>
				<Frame>11,1</Frame>
				<Frame>12,1</Frame>
				<Frame>13,1</Frame>
				<Frame>14,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_punchFallJump" sprite="s_transform" animTime="300" isLoop="true" playOnState="Main.PunchInAir">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_shards" sprite="s_shard">
				<Frame>28,13</Frame>
				<Frame>29,13</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_shards2" sprite="s_shard2">
				<Frame>30,13</Frame>
				<Frame>31,13</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="p_flash" updateStage="AddClothingParticles" updateState="IsTransformed.Transition">
				<Emitter>
					<Set name="offset">0, -32</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">s_flash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1.25, 1.25</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_flashShards" updateStage="AddClothingParticles" updateState="IsTransformed.Transition">
				<Emitter>
					<Set name="offset">0, -32</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">16</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" usePlayerFacing="true">
					<Set name="sprite">s_shard</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.8, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="120,170" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="delayTimer">0.1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8,0.8</KeyFrame>
						<KeyFrame>1, 1.2, 1.2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialAngle" min="0" max="360" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">10, -26</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true" autoLifeTimeToTarget="true" >
					<Set name="sprite">s_slash</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="initialScale">2, 2</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0" radiusRange="160,160" baseAnglePosition="targetPos" baseOffset="0,16"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hitEmbers" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_shard</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Random name="offset" min="-4,-3" max="4,3" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="80,200" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_destroyEmbers" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_shard2</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15" />
					<Random name="offset" min="-4,-3" max="4,3" />
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="80,200" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="s_pendant" alignment="DOWN_CENTER" />
		</RenderChestItem>
		<RenderTransform>
			<SpriteRender name="s_transform" blend="PREMULTIPLIED_ALPHA" offset="0,-8" />
		</RenderTransform>
		<OnDamagedTile>
			<StopIf>
				<IsItemTransformed>false</IsItemTransformed>
			</StopIf>
		</OnDamagedTile>
		<OnDestroyedTile>
			<StopIf>
				<IsItemTransformed>false</IsItemTransformed>
			</StopIf>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_flipper" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="6,7"/>
		<Sprite name="s_punchFlipper" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="11,7"/>
		<Sprite name="s_punchPancake" fileName="game/particles12.rttex" textureSize="32" frame="24,13"/>
		<Sprite name="s_punchHit" fileName="game/particles12.rttex" textureSize="32" frame="25,13"/>

		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>
		<Animations>
			<SpriteAnimation name="s_Idle" sprite="s_flipper" animTime="100" autoPlay="false" isLoop="true" playOnState="Flip.No">
				<Frame>6, 7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_Flip" sprite="s_flipper" animTime="500" autoPlay="false" isLoop="false" playOnState="Flip.Yes">
				<Frame>6, 7</Frame>
				<Frame>7, 7</Frame>
				<Frame>8, 7</Frame>
				<Frame>9, 7</Frame>
				<Frame>10, 7</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Flip">
				<States>
					<State name="No" ExitTime="3"/>
					<State name="Yes" ExitTime="0.5"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition type="or">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAnimationFinished>s_Flip</IsAnimationFinished>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_punchProjectile">
				<Emitter attachment="handspotRoot">
					<Set name="offset">7, 0</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punchPancake</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Random name="targetPosOffset" min="-12,-12" max="12,12"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<SetVar name="projectile_offset" source="targetPosOffset"/>
					<Random name="initialRotationRate" min="-300" max="-450" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hit">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punchHit</Set>
					<Random name="offset" min="-4, -4" max="4, 4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4, 0.4</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<Translate>-1,13,0</Translate>
			<SpriteRender name="s_flipper" rotateOffset="true" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="Punch.No"/>
			<SpriteRender name="s_punchFlipper" rotateOffset="true" alignment="CENTER" blend="PREMULTIPLIED_ALPHA" onState="Punch.Yes"/>
		</RenderHandItem>
		<Update>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<AvatarTransform class="ArmAngle" onState="Punch.No">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
		</Update>
		<OnPunchStart>
			<ParticleSystemUpdate name="ps_punchProjectile"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="animTime">400</Set>
				<Set name="Curve">
					<KeyFrame>0.0, 30</KeyFrame>
					<KeyFrame>0.3, -90</KeyFrame>
					<KeyFrame>1, 30</KeyFrame>
				</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_hit"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_hit"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Minigun" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="17,29"/>
    <Sprite name="s_MuzzleFlash" fileName="game/particles12.rttex" textureSize="32" frame="22,2"/>
    <Sprite name="s_Projectile" fileName="game/particles12.rttex" textureSize="32" frame="23,2"/>
    <Sprite name="s_ProjectileHit" fileName="game/particles12.rttex" textureSize="32" frame="24,2"/>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_PunchGun" sprite="s_Minigun" animTime="250" isLoop="true" playOnState="Punch.True">
        <Frame>17,29</Frame>
        <Frame>18,29</Frame>
        <Frame>19,29</Frame>
        <Frame>20,29</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_NonPunchGun" sprite="s_Minigun" animTime="100" isLoop="true" playOnState="Punch.False">
        <Frame>16,29</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
      </Default>
    </RenderOptions>

    <ParticleSystems>
	    <ParticleSystem name="ps_muzzleFlash"  updateStage="RenderHandItem" updateState="Punch.True">
		    <Emitter attachment="handspotRoot">
			    <Set name="offset">0, 17</Set>
				<Set name="lifeTime">0.072</Set>
			    <Set name="emissionInterval">0.05</Set>
			    <Set name="infParticles">true</Set>
			    <Set name="checkParticleNumToEmit">true</Set>
			    <Set name="particlesPerEmission">1</Set>
			    <Set name="particlesToEmit">1</Set>
		    </Emitter>
		    <Particle>
			    <Set name="relativeToEmitter">true</Set>
			    <Set name="sprite">s_MuzzleFlash</Set>
			    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
			    <Curve name="initialAlpha">
				    <KeyFrame>0, 1</KeyFrame>
				    <KeyFrame>1, 0</KeyFrame>
			    </Curve>
			    <Set name="lifeTime">0.15</Set>
			    <Set name="initialAngle">90</Set>
		    </Particle>
	    </ParticleSystem>
      <ParticleSystem name="Punch" updateStage="RenderHandItem" updateState="Punch.True" secondary="BulletHit">
        <Emitter attachment="handspotRoot">
          <Random name="offset" min="-2, 8" max="2, 8"/>
          <Set name="lifeTime">0.072</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_Projectile</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="lifeTime">0.2</Set>
          <Random name="targetPosOffset" min="-15, -8" max="15, 8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="BulletHit">
        <Emitter>
          <Set name="offset">0, 0</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="delayTimer">0.2</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_ProjectileHit</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.1</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Select name="initialRotationRate" input="randomNumber">
            <Item>-720</Item>
            <Item>720</Item>
          </Select>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>

  <RenderRules>
    <RenderHandItem>
      <SpriteRender name="s_Minigun" offset="0,0" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderHandItem>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="angleOffset">0</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>

    <RenderFrontArm>
      <ContextUpdate type="PositionSinPulse" onState="Punch.True">
        <Set name="period">100</Set>
        <Set name="scale">-0.5</Set>
        <Set name="clamp">true</Set>
      </ContextUpdate>
    </RenderFrontArm>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_podFront" fileName="game/player_feet16.rttex" textureSize="32" frame="10,27"/>
    <Sprite name="s_podBack" fileName="game/player_feet16.rttex" textureSize="32" frame="10,26"/>
    <Sprite name="s_turbine" fileName="game/particles12.rttex" textureSize="32" frame="25,20"/>
    <Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="24,17"/>
    
    <RenderOptions>
      <Default>
        <Set name="PlayDefaultPunchAudio">true</Set>
        <Set name="ClothingOffsetFromShoes">-6</Set>
        <Set name="UserNameOffset">11</Set>
        <Set name="RenderShoesWithMermaidTail">true</Set>
        <Set name="ShoesHidesBodyLegs">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="IsToRenderPants">false</Set>
        <Set name="IsRidingBird">true</Set>
        <Set name="IsVehicle">true</Set>
        <Set name="ShouldHover">true</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>

    <Animations>
      <InterpolationVec3Animation name="a_jump" variableName="FinalOffset" targetVariableName="JumpTargetOffset" isLoop="false" animTime="1000" playOnState="Motion.Jump"/>
      <InterpolationVec3Animation name="a_fall" variableName="FinalOffset" targetVariableName="FallTargetOffset" isLoop="false" animTime="1000" playOnState="Motion.Fall"/>
      <InterpolationVec3Animation name="a_idle" variableName="FinalOffset" targetVariableName="IdleTargetOffset" isLoop="false" animTime="500" playOnState="Motion.Idle"/>
      <SpriteAnimation name="a_trail" autoPlay="false" sprite="s_trail">
        <Frame>24,17</Frame>
        <Frame>25,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_turbine" autoPlay="true" isLoop="true" animTime="300" sprite="s_turbine">
        <Frame>25,20</Frame>
        <Frame>26,20</Frame>
        <Frame>27,20</Frame>
      </SpriteAnimation>
    </Animations>
    
    <VariableMap>
      <Set name="FinalOffset">0,0,0</Set>
      <Set name="JumpTargetOffset">0,-10,0</Set>
      <Set name="FallTargetOffset">0,10,0</Set>
      <Set name="IdleTargetOffset">0,0,0</Set>
      <Set name="RopeStartFront">20,5,0</Set>
      <Set name="RopeEndFront">50,0,0</Set>
      <Set name="RopeStartBack">22,-1,0</Set>
      <Set name="RopeEndBack">50,0,0</Set>
    </VariableMap>
    
    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Fall">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="ArmState">
        <States>
          <State name="Idle" />
          <State name="InAir" />
          <State name="GroundMove" />
        </States>
        <Transitions>
          <Transition to="Idle" from="InAir|GroundMove">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="InAir" from="Idle|GroundMove">
            <Condition>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="GroundMove" from="Idle|InAir">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="trailParticleState">
        <States>
          <State name="Equip"/>
          <State name="HorizontalMove"/>
        </States>
        <Transitions>
          <Transition from="HorizontalMove" to="Equip">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Equip" to="HorizontalMove">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_trail" updateStage="AddClothingParticles" updateState="trailParticleState.HorizontalMove">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="emissionInterval">0.035</Set>
          <Set name="offset">-28,-7</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true" usePlayerFacing="true">
          <Set name="sprite">s_trail</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.2</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>
  <RenderRules>
    <Update>

    </Update>
    <RenderShoes value="playerCenter">
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSitting>true</IsSitting>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <ParticleSystemRender name="ps_trail"/>
      <Translate>0,-9,0</Translate>
      <Group>
        <Translate>16,0,0</Translate>
        <SpriteRender name="s_podFront" blend="PREMULTIPLIED_ALPHA"/>
      </Group>
      <Group>
        <Translate>-16,0,0</Translate>
        <SpriteRender name="s_podBack" blend="PREMULTIPLIED_ALPHA"/>
      </Group>

      <Group>
        <Group>
          <Translate>50,-5,0</Translate>
          <Translate>FinalOffset</Translate>
          <SpriteRender name="s_turbine" blend="PREMULTIPLIED_ALPHA"/>
          <SpriteRender name="s_turbine" blend="PREMULTIPLIED_ALPHA" tintOverride="100,110,18,128" drawShadow="false"/>
        </Group>
        <Group>
          <ArithmethicOperation LeftHandVariableName="RopeEndBack" RightHandVariableName="36,-5.5,0" OperationType="Set" />
          <ArithmethicOperation LeftHandVariableName="RopeEndBack" RightHandVariableName="FinalOffset" OperationType="Add" />
          <LineRender color="30, 110, 80,255" StartPointVariableName="RopeStartBack" EndPointVariableName="RopeEndBack"  LineWidth="4"/>
        </Group>
      </Group>
      
      <Group>
        <Group>
          <Translate>50,5,0</Translate>
          <Translate>FinalOffset</Translate>
          <SpriteRender name="s_turbine" blend="PREMULTIPLIED_ALPHA"/>
        </Group>
        <Group>
          <ArithmethicOperation LeftHandVariableName="RopeEndFront" RightHandVariableName="36,4.5,0" OperationType="Set" />
          <ArithmethicOperation LeftHandVariableName="RopeEndFront" RightHandVariableName="FinalOffset" OperationType="Add" />
          <LineRender color="30, 110, 80,255" StartPointVariableName="RopeStartFront" EndPointVariableName="RopeEndFront" LineWidth="4"/>
        </Group>
      </Group>
      
    <Group onState="ArmState.GroundMove">
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
      <StopIf>
        <IsAction>PUNCH</IsAction>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform></Group>

    </RenderShoes>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_PAPAYA_SURFBOARD">
  <Data>
    <Sprite name="handItemSprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="31,14"/>
    <Sprite name="foot1_Sprite" fileName="game/player_feet16.rttex" textureSize="32" frame="11,20"/>
    <Sprite name="foot2_Sprite" fileName="game/player_feet16.rttex" textureSize="32" frame="11,21"/>

    <RenderOptions>
      <Default>
        <Set name="IsSurfboard">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderHandItem>
      <StopIf>
        <IsVariableBool name="isSurfing">true</IsVariableBool>
      </StopIf>
      <SpriteRender name="handItemSprite" alignment="UPPER_CENTER"/>
    </RenderHandItem>
    <RenderShoes>
      <StopIf>
        <IsVariableBool name="isSurfing">false</IsVariableBool>
      </StopIf>
      <SpriteRender name="foot1_Sprite" offset="1,5" alignment="DOWN_CENTER"/>
      <SpriteRender name="foot2_Sprite" offset="1,5" alignment="DOWN_CENTER"/>
    </RenderShoes>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_PARADE_FLOAT">
	<Data>
		<StateMachines>
			<StateMachine name="playerState">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Fall"/>
					<State name="Jump"/>
					<State name="SpiritGuide"/>
				</States>
				<Transitions>
					<Transition from="SpiritGuide|Jump|Fall|Move" to="Idle" >
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Jump|Fall|Idle" to="Move">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>WALK</IsAction>
						</Condition>
					</Transition>				
					<Transition from="Move|Jump|Fall|Idle" to="SpiritGuide">
						<Condition type="and">
							<IsWearing slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0</IsVariableFloat>
							<IsAction operatorType="NotEqual">FALL</IsAction>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Fall|Move|Idle" to="Jump">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Jump|Idle|Move" to="Fall">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater" abs="false">0.01</IsVariableFloat>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Sprite name="foot_front_Sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="9,2"/>
		<Sprite name="foot_back_Sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="9,2"/>
		<Sprite name="trail_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="31,4"/>
w
		<Animations>
			<SpriteAnimation name="foot1_Idle" playOnState="playerState.Idle|playerState.Jump|playerState.SpiritGuide" sprite="foot_front_Sprite" isLoop="true" animTime="100">
				<Frame>9,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Fall" playOnState="playerState.Fall" sprite="foot_front_Sprite" isLoop="true" animTime="100">
				<Frame>11,2</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="foot1_Move" playOnState="playerState.Move" sprite="foot_front_Sprite" isLoop="true" animTime="100">
				<Frame>9,2</Frame>
				<Frame>10,2</Frame>
			</SpriteAnimation>
			
			<SpriteAnimation name="foot2_Idle" playOnState="playerState.Idle|playerState.Jump|playerState.SpiritGuide" sprite="foot_back_Sprite" isLoop="true" animTime="100">
				<Frame>9,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Fall" playOnState="playerState.Fall" sprite="foot_back_Sprite" isLoop="true" animTime="100">
				<Frame>11,3</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="foot2_Move" playOnState="playerState.Move" sprite="foot_back_Sprite" isLoop="true" animTime="100">
				<Frame>10,3</Frame>
				<Frame>9,3</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">10</Set>
					<Set name="emissionInterval">0.035</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="offset">-17,-2</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="-15,-10" max="15,-5"/>
					<Set name="sprite">trail_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 30</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Random name="flipX" min="false" max="true"/>
					<Curve name="initialAngle">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -15</KeyFrame>
						<KeyFrame>0.4, 15</KeyFrame>
						<KeyFrame>0.6, -15</KeyFrame>
						<KeyFrame>0.8, 15</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Curve name="initialVelocity">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -20, 0</KeyFrame>
						<KeyFrame>0.4, 50, 0</KeyFrame>
						<KeyFrame>0.6, -50, 0</KeyFrame>
						<KeyFrame>0.8, 50, 0</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="ClothingOffsetFromShoes">-5.4</Set>
				<Set name="UserNameOffset">11</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderShoes>
			<SpriteRender name="foot_back_Sprite" offset="0,-24"/>
			<SpriteRender name="foot_front_Sprite" offset="0,-24"/>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
		</RenderShoes>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<AddClothingParticles>
			<ParticleSystemUpdate name="trail_particle" onState="playerState.Move|playerState.Fall|playerState.Jump|playerState.SpiritGuide"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="trail_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_CapeBack" fileName="game/particles_large19.rttex" textureSize="64" frame="4,3" />
    <Sprite name="s_CapeFront" fileName="game/particles_large19.rttex" textureSize="64" frame="4,2" />
    <Sprite name="s_Hood" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="19,12" />

    <StateMachines>
      <StateMachine name="ShowHood">
        <States>
          <State name="Yes"/>
          <State name="No"/>
        </States>
        <Transitions>
          <Transition to="Yes" from="No">
            <Condition type="or">
              <ItemHasTag>SHOW_HOOD</ItemHasTag>
              <IsVariableBool name="isMannequin">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="No" from="Yes">
            <Condition type="and">
              <ItemHasTag operatorType="NotEqual">SHOW_HOOD</ItemHasTag>
              <IsVariableBool name="isMannequin">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Zombie">
        <States start="Off">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <IsZombified>true</IsZombified>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_CapeBack" sprite="s_CapeBack" animTime="1000" isLoop="true" autoPlay="true">
        <Frame>4,3</Frame>
        <Frame>5,3</Frame>
        <Frame>6,3</Frame>
        <Frame>7,3</Frame>
        <Frame>8,3</Frame>
        <Frame>9,3</Frame>
        <Frame>10,3</Frame>
        <Frame>11,3</Frame>
        <Frame>12,3</Frame>
        <Frame>13,3</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeFront" sprite="s_CapeFront" animTime="1000" isLoop="true" autoPlay="true">
        <Frame>4,2</Frame>
        <Frame>5,2</Frame>
        <Frame>6,2</Frame>
        <Frame>7,2</Frame>
        <Frame>8,2</Frame>
        <Frame>9,2</Frame>
        <Frame>10,2</Frame>
        <Frame>11,2</Frame>
        <Frame>12,2</Frame>
        <Frame>13,2</Frame>
      </SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="OnEquipTag">SHOW_HOOD</Set>
      </Default>
    </RenderOptions>

  </Data>
  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_CapeBack" offset="-1,-32" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackpack>
    <RenderInFront>
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>

      <ContextUpdate type="SetTint" onState="Zombie.On">
        <Set name="tint">111,217,45</Set>
        <Set name="forceTint">true</Set>
      </ContextUpdate>

      <SpriteRender name="s_Hood" offset="0,-32" blend="PREMULTIPLIED_ALPHA" onState="ShowHood.Yes"/>
      <SpriteRender name="s_CapeFront" offset="-1,-32" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>

    </RenderInFront>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_frontStick" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="24,21"/>
    <Sprite name="s_backStick" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="24,21"/>
    <Sprite name="s_punchFlash" fileName="game/particles_large14.rttex" textureSize="64" frame="11,10"/>
    <Sprite name="s_punchRing1" fileName="game/particles_large14.rttex" textureSize="64" frame="4,10"/>
    <Sprite name="s_cymbalLeft" fileName="game/particles11.rttex" textureSize="32" frame="17,30"/>
    <Sprite name="s_cymbalRight" fileName="game/particles11.rttex" textureSize="32" frame="17,30"/>
    <Sprite name="s_drumLeft" fileName="game/particles11.rttex" textureSize="32" frame="16,30"/>
    <Sprite name="s_drumRight" fileName="game/particles11.rttex" textureSize="32" frame="16,30"/>
    <Sprite name="s_punchSlash" fileName="game/particles11.rttex" textureSize="32" frame="17,29"/>
    <Sprite name="s_hitFlash" fileName="game/particles11.rttex" textureSize="32" frame="15,30" />
    <Sprite name="s_hitSparks" fileName="game/particles11.rttex" textureSize="32" frame="16,29" />

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="JumpFall" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Move|Punch|JumpFall">
            <Condition type="and">
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Move" from="Idle|Punch|JumpFall">
            <Condition type="and">
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="Idle|Move|JumpFall">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="JumpFall" from="Idle|Move|Punch">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater" abs="true">0.1</IsVariableFloat>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <Animations>
      <CurveAnimationVec4 name="staff_rotation_anim_right" isLoop="true" useFacing="RIGHT" playOnState="Motion.Idle|Motion.Move" sprite="StickSprite" animTime="500">
        <Curve name="stick_rotation">
          <KeyFrame>0, 0, 0,0,1</KeyFrame>
          <KeyFrame>1, -360, 0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
      <CurveAnimationVec4 name="staff_rotation_anim_left" isLoop="true" useFacing="LEFT" playOnState="Motion.Idle|Motion.Move" sprite="StickSprite" animTime="500">
        <Curve name="stick_rotation">
          <KeyFrame>0, 0, 0,0,1</KeyFrame>
          <KeyFrame>1, 360, 0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
      <CurveAnimationVec4 name="staff_fixed_rotation" playOnState="Motion.Punch|Motion.JumpFall" sprite="StickSprite" animTime="1">
        <Curve name="stick_rotation">
          <KeyFrame>0, 0, 0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
      <SpriteAnimation name="a_punchRing1" playOnState="Motion.Punch" sprite="s_punchRing1" isLoop="true" animTime="700">
        <Frame>4,10</Frame>
        <Frame>5,10</Frame>
        <Frame>6,10</Frame>
        <Frame>7,10</Frame>
        <Frame>8,10</Frame>
        <Frame>9,10</Frame>
        <Frame>10,10</Frame>
      </SpriteAnimation>
      <SpriteCurveAnimation name="a_cymbalLeft" isLoop="true" playOnState="Motion.Punch" sprite="s_cymbalLeft" animTime="1000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.5f</KeyFrame>
          <KeyFrame>0.375f, 0.5f</KeyFrame>
          <KeyFrame>0.375f, 1.f</KeyFrame>
          <KeyFrame>0.425f, 1.f</KeyFrame>
          <KeyFrame>0.425f, 0.5f</KeyFrame>
          <KeyFrame>1.f, 0.5f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_cymbalRight" isLoop="true" playOnState="Motion.Punch" sprite="s_cymbalRight" animTime="1000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.5f</KeyFrame>
          <KeyFrame>0.675f, 0.5f</KeyFrame>
          <KeyFrame>0.675f, 1.f</KeyFrame>
          <KeyFrame>0.725f, 1.f</KeyFrame>
          <KeyFrame>0.725f, 0.5f</KeyFrame>
          <KeyFrame>1.f, 0.5f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_drumLeft" isLoop="true" playOnState="Motion.Punch" sprite="s_drumLeft" animTime="1000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.5f</KeyFrame>
          <KeyFrame>0.875f, 0.5f</KeyFrame>
          <KeyFrame>0.875f, 1.f</KeyFrame>
          <KeyFrame>0.925f, 1.f</KeyFrame>
          <KeyFrame>0.925f, 0.5f</KeyFrame>
          <KeyFrame>1.f, 0.5f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteCurveAnimation name="a_drumRight" isLoop="true" playOnState="Motion.Punch" sprite="s_drumRight" animTime="1000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.5f</KeyFrame>
          <KeyFrame>0.075f, 0.5f</KeyFrame>
          <KeyFrame>0.075f, 1.f</KeyFrame>
          <KeyFrame>0.125f, 1.f</KeyFrame>
          <KeyFrame>0.125f, 0.5f</KeyFrame>
          <KeyFrame>1.f, 0.5f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
    </Animations>

    <VariableMap>
      <Set name="stick_rotation">0, 0, 0, 1</Set>
      <Set name="stick_offset">-4.5, 3, 0</Set>
      <Set name="stick_post_rotation_offset">4,-1,0</Set>
    </VariableMap>

    <ParticleSystems>
      <ParticleSystem name="ps_punchFlash" updateStage="OnPunchBegin" renderStage="RenderInFront">
        <Emitter>
          <Set name="offset">0,-16</Set>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchFlash</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 1.5,1.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_rightDrumImpactFlash">
        <Emitter>
          <Set name="offset">20,-6</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">1.0</Set>
          <Set name="delayTimer">0.1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchFlash</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.15,0.15</KeyFrame>
            <KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.2</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_leftCymbalImpactFlash">
        <Emitter>
          <Set name="offset">-20,-24</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">1.0</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="delayTimer">0.4</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchFlash</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.15,0.15</KeyFrame>
            <KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.2</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_rightCymbalImpactFlash">
        <Emitter>
          <Set name="offset">20,-24</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">1.0</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="delayTimer">0.7</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchFlash</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.15,0.15</KeyFrame>
            <KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.2</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_leftDrumImpactFlash">
        <Emitter>
          <Set name="offset">-20,-6</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="emissionInterval">1.0</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="delayTimer">0.9</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchFlash</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.15,0.15</KeyFrame>
            <KeyFrame>1, 0.5,0.5</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.2</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchSlash">
        <Emitter>
          <Set name="offset">10,-16</Set>
          <Set name="emissionInterval">0.2</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">10</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchSlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 0</KeyFrame>
            <KeyFrame>0.1, 0, 0</KeyFrame>
            <KeyFrame>0.1, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 1.5, 1.5</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.15</KeyFrame>
            <KeyFrame>0.5, 0.15</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.6</Set>
          <Set name="rotateWithVelocity">true</Set>
          <VectorTo name="initialVelocity" source="targetPos"  duration="lifeTime" x="1"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitFlash">
        <Emitter>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hitFlash</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 1.3, 1.3</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.5</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitSparks">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_hitSparks</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.25, 0.25</KeyFrame>
            <KeyFrame>0.5, 0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0.5, 0.5</KeyFrame>
          </Curve>
          <Random name="offset" min="-16,-15" max="16,15" />
          <Select name="initalRGB" input="randomNumber">
            <Item>1.00, 0.72, 0.96</Item>
            <Item>1.00, 0.73, 0.36</Item>
            <Item>0.57, 0.70, 1.00</Item>
            <Item>0.89, 0.89, 0.36</Item>
            <Item>0.53, 0.91, 0.60</Item>
            <Item>0.43, 0.85, 0.95</Item>
            <Item>1.00, 0.58, 0.55</Item>
            <Item>0.31, 0.86, 0.55</Item>
          </Select>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderBackArmInTheFront">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
      </Default>
      <Override overrideOnState="Motion.Punch">
        <Set name="RenderBackArmInTheFront">True</Set>
      </Override>
    </RenderOptions>
  </Data>

  <RenderRules>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_punchSlash" onState="Motion.Punch"/>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <ParticleSystemUpdate name="ps_leftDrumImpactFlash" onState="Motion.Punch"/>
      <ParticleSystemUpdate name="ps_rightDrumImpactFlash" onState="Motion.Punch"/>
      <ParticleSystemUpdate name="ps_leftCymbalImpactFlash" onState="Motion.Punch"/>
      <ParticleSystemUpdate name="ps_rightCymbalImpactFlash" onState="Motion.Punch"/>
    </AddClothingParticles>
    <Update>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <AvatarTransform class="ArmAngle" onState="Motion.Idle|Motion.Move">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">700</Set>
        <Set name="Curve">
          <KeyFrame>0.0, 270</KeyFrame>
          <KeyFrame>0.5, 330</KeyFrame>
          <KeyFrame>1, 270</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Punch">
        <Set name="armName">arm2Angle</Set>
        <Set name="animTime">1000</Set>
        <Set name="Curve">
          <KeyFrame>0.0, 60</KeyFrame>
          <KeyFrame>0.2, 60</KeyFrame>
          <KeyFrame>0.3, 120</KeyFrame>
          <KeyFrame>0.4, 90</KeyFrame>
          <KeyFrame>0.5, 60</KeyFrame>
          <KeyFrame>0.8, 60</KeyFrame>
          <KeyFrame>0.9, 0</KeyFrame>
          <KeyFrame>1.0, 60</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="Motion.Punch">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">1000</Set>
        <Set name="Curve">
          <KeyFrame>0.0, 300</KeyFrame>
          <KeyFrame>0.1, 360</KeyFrame>
          <KeyFrame>0.2, 300</KeyFrame>
          <KeyFrame>0.5, 300</KeyFrame>
          <KeyFrame>0.6, 240</KeyFrame>
          <KeyFrame>0.7, 270</KeyFrame>
          <KeyFrame>0.8, 300</KeyFrame>
          <KeyFrame>1.0, 300</KeyFrame>
        </Set>
      </AvatarTransform>
    </Update>
    <OnPunchUpdate>
      <AvatarTransform class="Emotion">
        <Set name="emotion">HAPPY</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <Translate>stick_offset</Translate>
      <Group>
        <StopIf>
          <IsZombified>true</IsZombified>
        </StopIf>
        <Rotate>stick_rotation</Rotate>
        <Translate>stick_post_rotation_offset</Translate>
        <SpriteRender name="s_backStick" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
      </Group>
      <Group>
        <StopIf>
          <IsZombified>false</IsZombified>
        </StopIf>
        <Rotate>0,0,0,1</Rotate>
        <Translate>stick_post_rotation_offset</Translate>
        <SpriteRender name="s_backStick" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
      </Group>
    </RenderBackHandItem>
    <RenderHandItem>
      <SpriteRender name="s_frontStick" offset="4,7" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="Motion.Idle|Motion.Move|Motion.JumpFall"/>
      <SpriteRender name="s_frontStick" offset="-4,7" flip="1,0" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="Motion.Punch"/>
    </RenderHandItem>
    <RenderBehind value="playerCenter">
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_punchRing1" offset="0,-16" blend="PREMULTIPLIED_ALPHA" onState="Motion.Punch" drawShadow="false"/>
    </RenderBehind>
    <RenderInFront>
      <MusicSource onState="Motion.Punch">
        <Set name="MusicFile">audio/drumloop.wav</Set>
        <Set name="FadeOutTimeMs">100</Set>
      </MusicSource>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_cymbalLeft" useFixedRotation="true" offset="-25,-22" blend="PREMULTIPLIED_ALPHA" onState="Motion.Punch" drawShadow="false"/>
      <SpriteRender name="s_cymbalRight" useFixedRotation="true" offset="25,-22" blend="PREMULTIPLIED_ALPHA" onState="Motion.Punch" drawShadow="false" flip="1,0"/>
      <SpriteRender name="s_drumLeft" useFixedRotation="true" offset="-25,-4" blend="PREMULTIPLIED_ALPHA" onState="Motion.Punch" drawShadow="false"/>
      <SpriteRender name="s_drumRight" useFixedRotation="true" offset="25,-4" blend="PREMULTIPLIED_ALPHA" onState="Motion.Punch" drawShadow="false" flip="1,0"/>
    </RenderInFront>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hitFlash"/>
      <ParticleSystemUpdate name="ps_hitSparks"/>
    </OnDamagedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_PARTY_WAGON">
	<Data>
		<Sprite name="foot1_Sprite" fileName="game/player_feet16.rttex" textureSize="32"/>
		<Sprite name="foot2_Sprite" fileName="game/player_feet16.rttex" textureSize="32"/>
		<Sprite name="rocket_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="19,12"/>
		<Sprite name="trail_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="16,13"/>
		<Sprite name="hit_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="16,12"/>
		
		<Animations>
			<SpriteAnimation name="foot1_Idle" playOnAction="IDLE|JUMP" sprite="foot1_Sprite">
				<Frame>0,16</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Idle" playOnAction="IDLE|JUMP" sprite="foot2_Sprite">
				<Frame>0,17</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Move" playOnAction="WALK|FALL" sprite="foot1_Sprite" isLoop="true" animTime="200">
				<Frame>0,16</Frame>
				<Frame>1,16</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_Move" playOnAction="WALK|FALL" sprite="foot2_Sprite" isLoop="true" animTime="200">
				<Frame>0,17</Frame>
				<Frame>1,17</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_IdlePunch" playOnAction="PUNCH" sprite="foot1_Sprite">
				<Frame>2,16</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot2_IdlePunch" playOnAction="PUNCH" sprite="foot2_Sprite">
				<Frame>2,17</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="trail_Sprites" autoPlay="false" sprite="trail_Sprite">
				<Frame>16,13</Frame>
				<Frame>17,13</Frame>
				<Frame>18,13</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="hit_Sprite">
				<Frame>16,12</Frame>
				<Frame>17,12</Frame>
				<Frame>18,12</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="rocket_particle" secondary="trail_particle">
				<Emitter>
					<Set name="offset">-18,-22</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">rocket_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">0.1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="30"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="-30"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">0.4</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">10</Set>
					<Set name="emissionInterval">0.035</Set>
					<Set name="checkParticleNumToEmit">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">trail_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="initialVelocity">0,0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">30</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-6</Set>
				<Set name="IsRv">true</Set>
				<Set name="IsCar">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>
		
	</Data>

	<RenderRules>
		<RenderShoes>
			<SpriteRender name="foot1_Sprite" offset="0,6" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT"/>
			<SpriteRender name="foot2_Sprite" offset="0,6" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT"/>
		</RenderShoes>
		<OnPunchStart>
			<ParticleSystemUpdate name="rocket_particle"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDestroyedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="hit_particle"/>
			<ParticleSystemOff name="rocket_particle"/>
			<ParticleSystemOff name="trail_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_PEARL_TREASURED_OCTOPUS">
	<Data>
		<Sprite name="EquipSprite" fileName="game/particles_large13.rttex" textureSize="64" frame="0,13" />
		<Sprite name="LegsSprite" fileName="game/player_sit.rttex" textureSize="32" frame="1,0" />
		<Sprite name="TrailSprite" fileName="game/particles11.rttex" textureSize="32" frame="12,20" />
		<StateMachines>
			<StateMachine name="Mobility">
				<States>
					<State name="Idle" />
					<State name="GroundMove" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition from="Idle|Jump|Fall" to="GroundMove">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="Idle|GroundMove|Fall" to="Jump">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="Idle|GroundMove|Jump" to="Fall">
						<Condition>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="GroundMove|Jump|Fall" to="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="FallAnim" sprite="EquipSprite" animTime="600" isLoop="true" playOnState="Mobility.Fall">
				<Frame>4,14</Frame>
				<Frame>5,14</Frame>
				<Frame>6,14</Frame>
				<Frame>7,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="IdleAnim" sprite="EquipSprite" animTime="600" autoPlay="true" isLoop="true" playOnState="Mobility.Idle">
				<Frame>0,13</Frame>
				<Frame>1,13</Frame>
				<Frame>2,13</Frame>
				<Frame>3,13</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="JumpAnim" sprite="EquipSprite" animTime="600" isLoop="true" playOnState="Mobility.Jump">
				<Frame>0,14</Frame>
				<Frame>1,14</Frame>
				<Frame>2,14</Frame>
				<Frame>3,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="TrailAnim" sprite="TrailSprite">
				<Frame>12,20</Frame>
				<Frame>13,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="WalkAnim" sprite="EquipSprite" animTime="800" isLoop="true" playOnState="Mobility.GroundMove">
				<Frame>4,13</Frame>
				<Frame>5,13</Frame>
				<Frame>6,13</Frame>
				<Frame>7,13</Frame>
				<Frame>8,13</Frame>
				<Frame>9,13</Frame>
				<Frame>10,13</Frame>
				<Frame>11,13</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="ClothingOffsetFromShoes">-19</Set>
				<Set name="UserNameOffset">14</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
			</Default>
			<Override overrideOnState="Mobility.Idle">
				<Set name="ClothingOffsetFromShoes">-14</Set>
			</Override>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="TrailParticle">
				<Emitter>
					<Set name="emissionInterval">1</Set>
					<Set name="useCharacterPos">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">TrailSprite</Set>
					<Random name="offset" min="-20, 0" max="20, 0" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
					<RandomRadial name="initialVelocity" angleRange="-80,-110" radiusRange="50,75" />
					<Set name="gravityVector">0, 300</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<AvatarTransform class="ArmAngle" onAction="WALK">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">330</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="WALK">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">300</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<SpriteRender name="EquipSprite" offset="2,-10"/>
			<SpriteRender name="LegsSprite" offset="1,-7" tintOverride="SKINORPANTS" />
		</RenderShoes>
		<AddClothingParticles>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
			</StopIf>
			<ParticleSystemUpdate name="TrailParticle" onState="Mobility.GroundMove" />
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="TrailParticle" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_cape" fileName="game/particles_large15.rttex" textureSize="64" frame="0,9" />
		<Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="1,0" />
		<Animations>
			<SpriteAnimation name="a_cape" sprite="s_cape" animTime="700" autoPlay="true" isLoop="true">
				<Frame>0,9</Frame>
				<Frame>1,9</Frame>
				<Frame>2,9</Frame>
				<Frame>3,9</Frame>
				<Frame>4,9</Frame>
				<Frame>5,9</Frame>
				<Frame>6,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_trail" sprite="s_trail" animTime="200">
				<Frame>1,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="ShouldHover">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_trail" updateStage="AddClothingParticles" updateState="Motion.Moving">
				<Emitter>
					<Set name="offset">0, -8</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_trail</Set>
					<Random name="offset" min="-20, 0" max="20, 20" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="lifeTime">1.5</Set>
					<RandomRadial name="initialVelocity" angleRange="230,310" radiusRange="5,25" />
					<Random name="initialAngle" min="0" max="360" />
					<Random name="gravityVector" min="0, 15" max="0, 30" />
					<Random name="initialRotationRate" min="-60" max="60" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="s_cape" offset="0,-16" alignment="CENTER" />
		</RenderChestItem>
		<AddClothingParticles>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
		</AddClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer item="ITEM_ID_PHOENIX_MANTLE">
	<Data>
		<Sprite name="chestBackgroundSprite" fileName="game/particles_large13.rttex" textureSize="64" frame="0,5" />
		<Sprite name="chestForegroundSprite" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="17,16" />
		<Sprite name="emberSprite" fileName="game/particles11.rttex" textureSize="32" frame="8,22" />
		<Sprite name="flameSprite" fileName="game/particles11.rttex" textureSize="32" frame="12,22" />
		<Sprite name="speedLinesSprite" fileName="game/particles11.rttex" textureSize="32" frame="10,22" />
		<StateMachines>
			<StateMachine name="IsPunching">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="IsDying">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="MantleAnimation" sprite="chestBackgroundSprite" animTime="1200" autoPlay="true" isLoop="true">
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
				<Frame>10,5</Frame>
				<Frame>11,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="emberAnimation" sprite="emberSprite" animTime="200">
				<Frame>8,22</Frame>
				<Frame>9,22</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="speedLinesAnimation" sprite="speedLinesSprite" animTime="200">
				<Frame>10,22</Frame>
				<Frame>11,22</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="DeathParticle">
				<Emitter>
					<Set name="lifeTime">1.5</Set>
					<Set name="emissionInterval">0.3</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">6</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">flameSprite</Set>
					<Random name="offset" min="-30, -31" max="30, 31" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 2, 2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.4</Set>
					<Random name="initialVelocity" min="-25, -75" max="25, 20" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="EmberLeftParticle">
				<Emitter>
					<Set name="offset">-20, -26</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">emberSprite</Set>
					<Random name="offset" min="-8, -10" max="8, 12" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.85</Set>
					<Random name="initialVelocity" min="0, -16" max="0, -30" />
					<Set name="initialRotationRate">360</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="EmberRightParticle">
				<Emitter>
					<Set name="offset">20, -26</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">emberSprite</Set>
					<Random name="offset" min="-8, -10" max="8, 12" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.3, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.85</Set>
					<Random name="initialVelocity" min="0, -16" max="0, -30" />
					<Set name="initialRotationRate">360</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="PunchParticle">
				<Emitter>
					<Set name="offset">0, -10</Set>
					<Random name="emissionInterval" min="0.15" max="0.25" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">speedLinesSprite</Set>
					<Set name="relativeToEmitter">true</Set>
					<Random name="offset" min="-8, 0" max="8, 0" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1, 2</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialVelocity" min="0, -50" max="0, -80" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="SpawnParticle">
				<Emitter>
					<Set name="offset">160, -320</Set>
					<Set name="lifeTime">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">24</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">flameSprite</Set>
					<Random name="offset" min="-30, -20" max="30, 20" />
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 2, 2</KeyFrame>
						<KeyFrame>1, 3, 3</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,50" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="HideParticlesOnTransform">true</Set>
				<Set name="HideParticlesOnTheaterSeat">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderChestBackItem>
			<SpriteRender name="chestBackgroundSprite" drawShadow="false" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
		</RenderChestBackItem>
		<RenderChestItem>
			<SpriteRender name="chestForegroundSprite" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
		</RenderChestItem>
		<AddClothingParticles>
			<ParticleSystemUpdate name="PunchParticle" onState="IsPunching.True" />
			<ParticleSystemUpdate name="EmberLeftParticle" onState="IsDying.False" />
			<ParticleSystemUpdate name="EmberRightParticle" onState="IsDying.False" />
		</AddClothingParticles>
		<OnRespawned>
			<ParticleSystemUpdate name="SpawnParticle" />
		</OnRespawned>
		<OnKilled>
			<ParticleSystemUpdate name="DeathParticle" />
		</OnKilled>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="SpawnParticle" />
			<ParticleSystemOff name="DeathParticle" />
			<ParticleSystemOff name="PunchParticle" />
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_paraglider" fileName="game/particles_large16.rttex" textureSize="64,64" frame="8,0"/>
		<Sprite name="s_strap" fileName="game/player_cosmetics3.rttex" textureSize="32,32" frame="26,29"/>
		<Animations>
			<SpriteAnimation name="a_paraglider1" sprite="s_paraglider" isLoop="false" animTime="200" playOnState="Motion.Takeoff">
				<Frame>9,0</Frame>
				<Frame>10,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_paraglider2" sprite="s_paraglider" isLoop="false" animTime="100" playOnState="Motion.Ground">
				<Frame>8,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_paraglider3" sprite="s_paraglider" isLoop="true" animTime="400" playOnState="Motion.Air">
				<Frame>11,0</Frame>
				<Frame>12,0</Frame>
				<Frame>13,0</Frame>
				<Frame>14,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_paraglider4" sprite="s_paraglider" isLoop="false" animTime="200" playOnState="Motion.Landing">
				<Frame>10,0</Frame>
				<Frame>9,0</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="True"/>
					<State name="False"/>
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Motion">
				<States>
					<State name="Ground" />
					<State name="Takeoff"  ExitTime="0.2"/>
					<State name="Air"/>
					<State name="Landing"  ExitTime="0.2"/>
				</States>
				<Transitions>
					<Transition to="Landing" from="Air">
						<Condition>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Ground" from="Takeoff|Air|Landing">
						<Condition>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Takeoff" from="Ground|Landing">
						<Condition type="or">
							<IsAction>JUMP</IsAction>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
					<Transition to="Air" from="Takeoff">
						<Condition>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<Group onState="Punch.False">
				<AvatarTransform class="ArmAngle" onState="Motion.Takeoff">
				  <Set name="armName">arm1Angle</Set>
				  <Set name="animTime">200</Set>
				  <Set name="Curve">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, -145</KeyFrame>
				  </Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Motion.Air">
				  <Set name="armName">arm1Angle</Set>
				  <Set name="armAngle">-145</Set>
				</AvatarTransform>
			</Group>
			<AvatarTransform class="ArmAngle" onState="Motion.Takeoff">
			  <Set name="armName">arm2Angle</Set>
			  <Set name="animTime">200</Set>
			  <Set name="Curve">
				<KeyFrame>0, 0</KeyFrame>
				<KeyFrame>1, 145</KeyFrame>
			  </Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Motion.Air">
			  <Set name="armName">arm2Angle</Set>
			  <Set name="armAngle">145</Set>
			</AvatarTransform>
		</Update>
		<RenderFrontArm>
			<SpriteRender name="s_strap" offset="0,-16" useFixedRotation="true" fixedRotation="0"/>
		</RenderFrontArm>
		<RenderBackArm value="playerCenter">
			<StopIf type="or">
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<SpriteRender name="s_paraglider" offset="1,-32" useFixedRotation="true" fixedRotation="0"/>
		</RenderBackArm>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_item" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="26,28" />
		<Sprite name="s_note" fileName="game/particles.rttex" textureSize="32" frame="11,1" />
		<VariableMap>
			<Set name="item.Rotation">-25</Set>
			<Set name="footOffset">0</Set>
			<Set name="rotation">-25</Set>
			<Set name="facingVariable">1,1,1</Set>
			<Set name="item.Translation">8,-1,0</Set>
		</VariableMap>
		<Animations>
			<CurveAnimationFloat name="a_footExtend" isLoop="true" animTime="600" playOnState="Dance.Yes">
				<Curve name="footOffset">
					<KeyFrame>0, -2</KeyFrame>
					<KeyFrame>0.5, 1</KeyFrame>
					<KeyFrame>1, -2</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
			<SpriteAnimation name="a_note" sprite="s_note" animTime="200">
				<Frame>10,1</Frame>
				<Frame>11,1</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Dance">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition type="and">
							<IsAction operatorType="NotEqual">DANCE</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="or">
							<IsAction>DANCE</IsAction>
							<IsAction>DANCE_FLOSS</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_note" updateStage="AddClothingParticles" updateState="Dance.Yes">
				<Emitter>
					<Set name="offset">0, -26</Set>
					<Set name="emissionInterval">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_note</Set>
					<Set name="offset">5, 0</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">2.5</Set>
					<Random name="initialVelocity" min="-20, -15" max="20, -25" />
					<Random name="initialRotationRate" min="-60" max="60" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IsFacingChangeDisabled">false</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
			</Default>
			<Override overrideOnAction="DANCE">
				<Set name="IsFacingChangeDisabled">true</Set>
			</Override>
			<Override overrideOnAction="DANCE_FLOSS">
				<Set name="IsFacingChangeDisabled">true</Set>
			</Override>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<ArithmethicOperation LeftHandVariableName="rotation" RightHandVariableName="item.Rotation" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="rotation" RightHandVariableName="facingVariable.x" OperationType="Multiply" />
			<Group onState="Dance.Yes">
				<AvatarTransform class="FootPosition">
					<Set name="foot1y">footOffset</Set>
					<Set name="foot2y">footOffset</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">-90</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle">
					<Set name="armName">arm2Angle</Set>
					<Set name="pulseArmScale">12</Set>
					<Set name="pulseArmRate">500</Set>
					<Set name="armAngle">-40</Set>
				</AvatarTransform>
				<AvatarTransform class="Emotion">
					<Set name="emotion">CHILLED|CHILLED2</Set>
					<Set name="interval">1000</Set>
				</AvatarTransform>
				<MusicSource>
					<Set name="MusicFile">audio/mp3/hula.mp3</Set>
				</MusicSource>
			</Group>
		</Update>
		<RenderHandItem>
			<Group onState="Dance.Yes">
				<Rotate forceValue="true">rotation</Rotate>
				<Translate>item.Translation</Translate>
				<SpriteRender name="s_item" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" />
			</Group>
			<Group onState="Dance.No">
				<Translate>9,-1,0</Translate>
				<SpriteRender name="s_item" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" />
			</Group>
		</RenderHandItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_chest" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="18,23"/>
    <Sprite name="s_lute" fileName="game/particles11.rttex" textureSize="32" frame="23,30"/>
    <Sprite name="s_luteTrail" fileName="game/particles11.rttex" textureSize="32" frame="20,30"/>
    <Sprite name="s_luteTrailMusic" fileName="game/particles11.rttex" textureSize="32" frame="18,30"/>

    <Animations>
      <SpriteAnimation name="a_luteTrail" sprite="s_luteTrail" isLoop="true" animTime="300">
        <Frame>20,30</Frame>
        <Frame>21,30</Frame>
        <Frame>22,30</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_luteTrailMusic" sprite="s_luteTrailMusic">
        <Frame>18,30</Frame>
        <Frame>19,30</Frame>
      </SpriteAnimation>
      <CurveAnimationFloat name="lute_angle_rotation" autoPlay="true" isLoop="true" animTime="5000">
        <Curve name="lute_angle">
          <KeyFrame>0, -45</KeyFrame>
          <KeyFrame>0.5, 45</KeyFrame>
          <KeyFrame>1, -45</KeyFrame>
        </Curve>
      </CurveAnimationFloat>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None"/>
          <State name="Punch"/>
          <State name="Dance"/>
        </States>
        <Transitions>
          <Transition from="None|Dance" to="Punch">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsDancing>false</IsDancing>
            </Condition>
          </Transition>
          <Transition from="Punch|None" to="Dance">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsDancing>true</IsDancing>
            </Condition>
          </Transition>
          <Transition from="Punch|Dance" to="None">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsDancing>false</IsDancing>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <VariableMap>
      <Set name="lute_angle">0</Set>
    </VariableMap>
    
    <ParticleSystems>
      <ParticleSystem name="ps_lute">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.04</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">6000</Set>
            <Set name="hAmplitude">25</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">6</Set>
            <Set name="vOrbitPeriod">4000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_lute</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.06</Set>
          <Set name="initialAngle" source="lute_angle"/>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_luteTrail">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.04</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">6000</Set>
            <Set name="hAmplitude">25</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">6</Set>
            <Set name="vOrbitPeriod">4000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">s_luteTrail</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="finalAngle" min="0" max="360" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">1,1</Set>
          <Random name="finalScale" min="0.3" max="0.6" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>

      <ParticleSystem name="ps_luteTrailMusic">
        <Emitter>
          <Set name="offset">0, -16</Set>
          <Set name="emissionInterval">0.5</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">0.7f</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">6000</Set>
            <Set name="hAmplitude">25</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">6</Set>
            <Set name="vOrbitPeriod">4000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.4</Set>
          </OrbitOffset>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_luteTrailMusic</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="-45" max="45" />
          <Random name="finalAngle" min="-45" max="45" />
          <Set name="interpolateAngle">true</Set>
          <Set name="initialScale">1,1</Set>
          <Random name="finalScale" min="0.3" max="0.6" />
          <Set name="interpolateScale">true</Set>
          <Random name="offset" min="-2,-3" max="2,3" />
          <Random name="initialVelocity" min="0,-5" max="0,-20" />
          <Set name="lifeTime">1</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
	  <Update>
		  <MusicSource onState="Action.Punch">
          <Set name="MusicFile">audio/aibellharp.wav</Set>
          <Set name="FadeOutTimeMs">100</Set>
        </MusicSource>
        <MusicSource onState="Action.Dance">
          <Set name="MusicFile">audio/mp3/panflutemelody.mp3</Set>
          <Set name="FadeOutTimeMs">100</Set>
        </MusicSource>
	  </Update>
    <RenderInFront>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemRender name="ps_lute"/>
      <ParticleSystemRender name="ps_luteTrail"/>
      <ParticleSystemRender name="ps_luteTrailMusic" onState="Action.Dance"/>
    </RenderInFront>
    <AddClothingParticles>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_luteTrail"/>
      <ParticleSystemUpdate name="ps_luteTrailMusic" onState="Action.Dance"/>
      <ParticleSystemUpdate name="ps_lute"/>
    </AddClothingParticles>
    <RenderChestItem>
      <AvatarTransform class="Face" onState="Action.Punch">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <SpriteRender name="s_chest" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
    </RenderChestItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_pogoFoot" fileName="game/player_feet16.rttex" textureSize="32" frame="10,22" />
		<Sprite name="s_pogoStick" fileName="game/player_feet16.rttex" textureSize="32" frame="11,22" />
		<Animations>
			<CurveAnimationFloat name="a_Offset" isLoop="true" animTime="700" playOnState="MotionY.No">
				<Curve name="ClothingOffsetFromShoes">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>0.07, 0</KeyFrame>
					<KeyFrame>0.25, -15</KeyFrame>
					<KeyFrame>0.5, -18</KeyFrame>
					<KeyFrame>0.75, -15</KeyFrame>
					<KeyFrame>0.93, 0</KeyFrame>
					<KeyFrame>1, 0</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
			<CurveAnimationVec3 name="a_PoleOffset" isLoop="true" animTime="700" playOnState="MotionY.No">
				<Curve name="poleOffset">
					<KeyFrame>0, 0,-4.5,0</KeyFrame>
					<KeyFrame>0.05, 0,-4,0</KeyFrame>
					<KeyFrame>0.25, 0,1,0</KeyFrame>
					<KeyFrame>0.5, 0,1.5,0</KeyFrame>
					<KeyFrame>0.75, 0,1,0</KeyFrame>
					<KeyFrame>0.95, 0,-4,0</KeyFrame>
					<KeyFrame>1, 0,-4.5,0</KeyFrame>
				</Curve>
			</CurveAnimationVec3>
			<CurveAnimationFloat name="a_OffsetAir" isLoop="true" animTime="700" playOnState="MotionY.Yes">
				<Curve name="ClothingOffsetFromShoes">
					<KeyFrame>0, 0</KeyFrame>
				</Curve>
			</CurveAnimationFloat>
		</Animations>
		<StateMachines>
			<StateMachine name="MotionY">
				<States>
					<State name="No" />
					<State name="Yes" />
					<State name="Mannequin" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isMannequin">false</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isMannequin">false</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Mannequin" from="No|Yes">
						<Condition>
							<IsVariableBool name="isMannequin">true</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="ClothingOffsetFromShoes">0</Set>
			<Set name="poleScale">1,0.3,1</Set>
			<Set name="poleOffset">0,0,0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="ClothingOffsetFromShoes">-5</Set>
				<Set name="UserNameOffset">14</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="RenderBackArmInTheFront">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="FootPosition">
			  <Set name="foot1dy">0</Set>
			  <Set name="foot2dy">0</Set>
			  <Set name="foot1y">0</Set>
			  <Set name="foot2y">0</Set>
			</AvatarTransform>
		</Update>
		<RenderShoes>
			<Group>
				<Translate onState="MotionY.No">poleOffset</Translate>
				<Scale>poleScale</Scale>
				<SpriteRender name="s_pogoStick" alignment="UPPER_CENTER" />
			</Group>
			<SpriteRender name="s_pogoFoot" offset="1,-8" alignment="UPPER_CENTER" />
			<StopIf>
				<IsAction>PUNCH</IsAction>
				<IsAction>BUILD</IsAction>
				<IsSitting>true</IsSitting>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-20</Set>
			</AvatarTransform>
		</RenderShoes>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_equipBack" fileName="game/player_feet16.rttex" textureSize="32" frame="5,24"/>
    <Sprite name="s_equipFront" fileName="game/player_feet16.rttex" textureSize="32" frame="5,25"/>
    <Sprite name="s_jump" fileName="game/particles12.rttex" textureSize="32" frame="23,8"/>

    <Animations>
      <SpriteAnimation name="a_idleBack" playOnState="Motion.Idle" sprite="s_equipBack" isLoop="true" animTime="400">
        <Frame>5,24</Frame>
        <Frame>6,24</Frame>
        <Frame>7,24</Frame>
        <Frame>8,24</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_moveBack" playOnState="Motion.Move" sprite="s_equipBack" isLoop="true" animTime="400">
        <Frame>9,24</Frame>
        <Frame>10,24</Frame>
        <Frame>11,24</Frame>
        <Frame>12,24</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jumpBack" playOnState="Motion.Jump" sprite="s_equipBack" isLoop="true" animTime="100">
        <Frame>13,24</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fallBack" playOnState="Motion.Fall" sprite="s_equipBack" isLoop="true" animTime="100">
        <Frame>14,24</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_idleFront" playOnState="Motion.Idle" sprite="s_equipFront" isLoop="true" animTime="400">
        <Frame>5,25</Frame>
        <Frame>6,25</Frame>
        <Frame>7,25</Frame>
        <Frame>8,25</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_moveFront" playOnState="Motion.Move" sprite="s_equipFront" isLoop="true" animTime="400">
        <Frame>9,25</Frame>
        <Frame>10,25</Frame>
        <Frame>11,25</Frame>
        <Frame>12,25</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jumpFront" playOnState="Motion.Jump" sprite="s_equipFront" isLoop="true" animTime="100">
        <Frame>13,25</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fallFront" playOnState="Motion.Fall" sprite="s_equipFront" isLoop="true" animTime="100">
        <Frame>14,25</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Move" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Move|Jump">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Move" from="Jump|Fall|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Move|Fall">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle|Move">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_jumpParticlesRight">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">16,16</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_jump</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 1,1</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_jumpParticlesLeft">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">-6,16</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_jump</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0.5,0.5</KeyFrame>
            <KeyFrame>1, 1,1</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IsToRenderPants">true</Set>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
        <Set name="ClothingOffsetFromShoes">-7</Set>
        <Set name="UserNameOffset">11</Set>
        <Set name="IsHorse">true</Set>
      </Default>
    </RenderOptions>

  </Data>

  <RenderRules>
    <RenderShoes>
      <SpriteRender name="s_equipBack" offset="2,8" alignmentLeft="DOWN_LEFT" alignmentRight="DOWN_RIGHT"/>
      <SpriteRender name="s_equipFront" offset="2,8" alignmentLeft="DOWN_RIGHT" alignmentRight="DOWN_LEFT"/>
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
      <ParticleSystemUpdate name="ps_jumpParticlesLeft" onAction="JUMPSTART|JUMPDOUBLE"/>
      <ParticleSystemUpdate name="ps_jumpParticlesRight" onAction="JUMPSTART|JUMPDOUBLE"/>
    </RenderShoes>
  </RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="Sprite172" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="0,2" />
        <Sprite name="Sprite286" fileName="game/particles12.rttex" textureSize="32,32" frame="4,10" />
        <Sprite name="Sprite365" fileName="game/particles12.rttex" textureSize="32,32" frame="4,10" />
        <Sprite name="Sprite478" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="0,2" />
        <Sprite name="Sprite489" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="1,2" />
        <Sprite name="Sprite495" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="2,2" />
        <Sprite name="Sprite501" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="3,2" />
        <Sprite name="Sprite507" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="4,2" />
        <Sprite name="Sprite513" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="5,2" />
        <Animations>
            <SpriteAnimation name="Animation173" sprite="Sprite172" isLoop="false" autoPlay="false" animTime="3200">
                <Frame>7,2</Frame>
                <Frame>6,2</Frame>
                <Frame>5,2</Frame>
                <Frame>4,2</Frame>
                <Frame>3,2</Frame>
                <Frame>2,2</Frame>
                <Frame>1,2</Frame>
                <Frame>0,2</Frame>
            </SpriteAnimation>
            <SpriteSinPulseAnimation name="Animation691" sprite="Sprite478" autoPlay="true">
                <Parameter name="pos">
                    <Set name="offset">0</Set>
                    <Set name="period">1000</Set>
                    <Set name="scale">-1</Set>
                </Parameter>
            </SpriteSinPulseAnimation>
            <SpriteSinPulseAnimation name="Animation701" sprite="Sprite489" autoPlay="true">
                <Parameter name="pos">
                    <Set name="offset">0</Set>
                    <Set name="period">1000</Set>
                    <Set name="scale">-1</Set>
                </Parameter>
            </SpriteSinPulseAnimation>
            <SpriteSinPulseAnimation name="Animation711" sprite="Sprite495" autoPlay="true">
                <Parameter name="pos">
                    <Set name="offset">0</Set>
                    <Set name="period">1000</Set>
                    <Set name="scale">-1</Set>
                </Parameter>
            </SpriteSinPulseAnimation>
            <SpriteSinPulseAnimation name="Animation721" sprite="Sprite501" autoPlay="true">
                <Parameter name="pos">
                    <Set name="offset">0</Set>
                    <Set name="period">1000</Set>
                    <Set name="scale">-1</Set>
                </Parameter>
            </SpriteSinPulseAnimation>
            <SpriteSinPulseAnimation name="Animation731" sprite="Sprite507" autoPlay="true">
                <Parameter name="pos">
                    <Set name="offset">0</Set>
                    <Set name="period">1000</Set>
                    <Set name="scale">-1</Set>
                </Parameter>
            </SpriteSinPulseAnimation>
            <SpriteSinPulseAnimation name="Animation741" sprite="Sprite513" autoPlay="true">
                <Parameter name="pos">
                    <Set name="offset">0</Set>
                    <Set name="period">1000</Set>
                    <Set name="scale">-1</Set>
                </Parameter>
            </SpriteSinPulseAnimation>
        </Animations>
        <ParticleSystems>
            <ParticleSystem name="PS151">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0</Set>
                    <Set name="infLifeTime">true</Set>
                    <Set name="infParticles">true</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,-16</Set>
                    <Set name="emissionInterval">0.75</Set>
                    <Set name="particlesToEmit">0</Set>
                    <Set name="checkParticleNumToEmit">false</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="relativeToEmitter">true</Set>
                    <Set name="orbitStart">-0.2</Set>
                    <Set name="initialScale">1,1</Set>
                    <Set name="lifeTime">3.9</Set>
                    <Set name="orbitPeriod">3.8</Set>
                    <Set name="initialRotationRate">0</Set>
                    <Set name="applyOrbit">true</Set>
                    <Set name="orbit">-24, 3</Set>
                    <Set name="orbitScaleVariation">0.08</Set>
                    <Set name="orbitSkew">4</Set>
                    <Set name="sprite">Sprite172</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="PS252">
                <Emitter>
                    <Set name="lifeTime">0</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="offset">0,-16</Set>
                </Emitter>
                <Particle>
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="lifeTime">0.3</Set>
                    <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angleOutVar="projectile_angle" />
                    <SetVar name="projectile_offset" source="targetPosOffset" />
                    <Random name="targetPosOffset" min="-12,-12" max="12,12" />
                    <Set name="sprite">Sprite286</Set>
                </Particle>
            </ParticleSystem>
            <ParticleSystem name="PS333">
                <Emitter needsHandItemActive="false">
                    <Set name="delayTimer">0.3</Set>
                    <Set name="infLifeTime">false</Set>
                    <Set name="infParticles">false</Set>
                    <Set name="lifeTime">0</Set>
                    <Set name="offset">0,0</Set>
                    <Set name="emissionInterval">0</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="checkParticleNumToEmit">true</Set>
                    <Set name="particlesPerEmission">1</Set>
                </Emitter>
                <Particle>
                    <Set name="initialScale">1,1</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1</Set>
                    <Set name="offset" source="projectile_offset" />
                    <Set name="initialAngle" source="projectile_angle" />
                    <Set name="sprite">Sprite365</Set>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>
        <StateMachines />
        <RenderOptions>
            <Default>
                <Set name="AdditionalClothingOffset">0</Set>
                <Set name="AllowChangePunchType">false</Set>
                <Set name="ClothingOffsetFromShoes">0</Set>
                <Set name="DefaultPunchSound" />
                <Set name="DefaultRenderMannequinHandItem">false</Set>
                <Set name="DisableDefaultAncestralParticleEffects">false</Set>
                <Set name="DisableWalkAnimation">false</Set>
                <Set name="EnableBobbingOffset">false</Set>
                <Set name="HasDeathParticles">false</Set>
                <Set name="Head.Sprite" />
                <Set name="Head.Sprite.Sit" />
                <Set name="Head.Sprite.Sleep" />
                <Set name="HideAngelOnDeath">false</Set>
                <Set name="HideAvatarOnDeath">false</Set>
                <Set name="HideParticlesOnSleepingInBed">false</Set>
                <Set name="HideParticlesOnTheaterSeat">false</Set>
                <Set name="HideParticlesOnTransform">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="IgnoreDefaultDestroyedTileEffect">false</Set>
                <Set name="IgnoreParticlesInShadowMods">true</Set>
                <Set name="IgnorePunchTypeCheck">false</Set>
                <Set name="IgnorePunchTypeCheckForNormalPunchOnly">false</Set>
                <Set name="IgnorePunchTypeDamagedTileCheck">false</Set>
                <Set name="IncludeAllActions">false</Set>
                <Set name="IsBed">false</Set>
                <Set name="IsCar">false</Set>
                <Set name="IsFacingChangeDisabled">false</Set>
                <Set name="IsHorse">false</Set>
                <Set name="IsNightVision">false</Set>
                <Set name="IsPetWithLight">false</Set>
                <Set name="IsPulseShoes">false</Set>
                <Set name="IsRidingBird">false</Set>
                <Set name="IsRv">false</Set>
                <Set name="IsSkateboard">false</Set>
                <Set name="IsSurfboard">false</Set>
                <Set name="IsToRenderPants">true</Set>
                <Set name="IsToRenderParticlesWhenShrunken">false</Set>
                <Set name="IsVehicle">false</Set>
                <Set name="JumpEndStateRange">0</Set>
                <Set name="NeedRenderBareFeetWithShoesItem">false</Set>
                <Set name="NeedRenderPet">false</Set>
                <Set name="PetOffsetDuplication">32,0</Set>
                <Set name="PlayDefaultPunchAudio">true</Set>
                <Set name="PunchSoundOverride" />
                <Set name="RenderBackArmAfterItem">false</Set>
                <Set name="RenderBackArmBuild">true</Set>
                <Set name="RenderBackArmInTheFront">false</Set>
                <Set name="RenderBackArmInfected">false</Set>
                <Set name="RenderFrontArmInTheFront">false</Set>
                <Set name="RenderFrontArmInfected">false</Set>
                <Set name="RenderShoesWithMermaidTail">true</Set>
                <Set name="RenderWhenZombie">true</Set>
                <Set name="ShoesHidesBodyLegs">false</Set>
                <Set name="ShoesShouldIgnoreRaptorLegsOffset">false</Set>
                <Set name="ShouldHover">false</Set>
                <Set name="SleepHidesPlayer">false</Set>
                <Set name="UseActionsWithStates">false</Set>
                <Set name="UsePetForceFaceTime">true</Set>
                <Set name="UseRecoilAnim">false</Set>
                <Set name="UserNameOffset">0</Set>
            </Default>
        </RenderOptions>
        <VariableMap>
            <Set name="projectile_offset">0, 0</Set>
            <Set name="projectile_angle">0</Set>
        </VariableMap>
    </Data>
    <RenderRules>
        <AddClothingParticles>
            <ParticleSystemUpdate name="PS151" />
        </AddClothingParticles>
        <OnPunchStart>
            <ParticleSystemUpdate name="PS252" />
        </OnPunchStart>
        <OnPunchUpdate>
            <AvatarTransform class="ArmAngle">
                <Set name="armName">arm2Angle</Set>
                <Set name="Curve">
                    <KeyFrame>0,0</KeyFrame>
                    <KeyFrame>1,360</KeyFrame>
                </Set>
                <Set name="animTime">300</Set>
            </AvatarTransform>
            <AvatarTransform class="ArmAngle">
                <Set name="armName">arm1Angle</Set>
                <Set name="Curve">
                    <KeyFrame>0,180</KeyFrame>
                    <KeyFrame>1,540</KeyFrame>
                </Set>
                <Set name="animTime">300</Set>
            </AvatarTransform>
            <AvatarTransform class="Face">
                <Set name="face">MAD</Set>
            </AvatarTransform>
        </OnPunchUpdate>
        <OnDamagedTile>
            <ParticleSystemUpdate name="PS333" />
        </OnDamagedTile>
        <RenderInFront>
            <StopIf>
                <IsVariableBool name="isMannequin">false</IsVariableBool>
            </StopIf>
            <Group>
                <Translate forceValue="false">21,-32,0</Translate>
                <SpriteRender name="Sprite478" blend="NORMAL" alignment="CENTER" drawShadow="true" />
            </Group>
            <Group>
                <Translate forceValue="false">20,-20,0</Translate>
                <SpriteRender name="Sprite489" blend="NORMAL" alignment="CENTER" drawShadow="true" />
            </Group>
            <Group>
                <Translate forceValue="false">12,-10,0</Translate>
                <SpriteRender name="Sprite495" blend="NORMAL" alignment="CENTER" drawShadow="true" />
            </Group>
            <Group>
                <Translate forceValue="false">-3,-5,0</Translate>
                <SpriteRender name="Sprite501" blend="NORMAL" alignment="CENTER" drawShadow="true" />
            </Group>
            <Group>
                <Translate forceValue="false">-18,-5,0</Translate>
                <SpriteRender name="Sprite507" blend="NORMAL" alignment="CENTER" drawShadow="true" />
            </Group>
            <Group>
                <Translate forceValue="false">-18,-16,0</Translate>
                <SpriteRender name="Sprite513" blend="NORMAL" alignment="CENTER" drawShadow="true" />
            </Group>
        </RenderInFront>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_hit" fileName="game/particles_large17.rttex" textureSize="64" frame="11,15" />
    <Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="2,19" />
    <Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32" frame="3,19" />
    <Sprite name="s_staff" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="5,12" />
    <Sprite name="s_staffGlow" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="6,12" />
    
    <Animations>
      <SpriteAnimation name="a_slash" sprite="s_slash" isLoop="true" autoPlay="true" animTime="400">
        <Frame>3,19</Frame>
        <Frame>4,19</Frame>
      </SpriteAnimation>
      <CurveAnimationVec4 name="a_staff" playOnState="Action.Punch" sprite="s_staff" animTime="150" isLoop="true">
        <Curve name="staff_rotation2">
          <KeyFrame>0, 0, 0,0,1</KeyFrame>
          <KeyFrame>0.32, 0, 0,0,1</KeyFrame>
          <KeyFrame>0.33, 15, 0,0,1</KeyFrame>
          <KeyFrame>0.65, 15, 0,0,1</KeyFrame>
          <KeyFrame>0.66, -15, 0,0,1</KeyFrame>
          <KeyFrame>1, -15, 0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
      <SpriteCurveAnimation name="a_staffGlow" isLoop="true" autoPlay="true" sprite="s_staffGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteSinPulseAnimation name="a_punch" sprite="s_punch" autoPlay="true" isLoop="true">
        <Parameter name="alpha">
          <Set name="period">300</Set>
          <Set name="scale">0.5</Set>
          <Set name="offset">0.5</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteAnimation name="a_hit" sprite="s_hit" animTime="400">
        <Frame>14,15</Frame>
        <Frame>11,15</Frame>
        <Frame>12,15</Frame>
        <Frame>13,15</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Facing">
        <States>
          <State name="Left" />
          <State name="Right" />
        </States>
        <Transitions>
          <Transition to="Left" from="Right">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition to="Right" from="Left">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="IncludeAllActions">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
      </Default>
    </RenderOptions>
    <ParticleSystems>
      <ParticleSystem name="p_hit" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_pumch2">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 1</KeyFrame>
            <KeyFrame>1, 2.5, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.25</Set>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.2" angle="0" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_punch">
        <Emitter attachment="contextRotation">
          <Set name="offset">0, 4</Set>
          <Set name="lifeTime">0.15</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.7</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 1</KeyFrame>
            <KeyFrame>1, 2.5, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.25</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_pumch2Left">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 1</KeyFrame>
            <KeyFrame>1, 2.5, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.25</Set>
          <Set name="flipY">true</Set>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.2" angle="0" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_punchLeft">
        <Emitter attachment="contextRotation">
          <Set name="offset">0, 4</Set>
          <Set name="lifeTime">0.15</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.7</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="flipY">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 1</KeyFrame>
            <KeyFrame>1, 2.5, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.25</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchSlash">
        <Emitter>
          <Set name="offset">0,-10</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="sprite">s_slash</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <VariableMap>
      <Set name="staff_rotation">0, 0, 0, 1</Set>
      <Set name="staff_rotation2">0, 0, 0, 1</Set>
      <Set name="target.direction">0, 0, 0, 1</Set>
    </VariableMap>
  </Data>
  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>0.5, 0</KeyFrame>
          <KeyFrame>0.51, -90</KeyFrame>
          <KeyFrame>1, -90</KeyFrame>
        </Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnPunchStart>
      <ParticleSystemUpdate name="ps_punchSlash"/>
    </OnPunchStart>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <Group onState="Action.Punch">
        <Rotate forceValue="true">target.direction</Rotate>
        <Rotate>staff_rotation2</Rotate>
        <SpriteRender name="s_staff" offset="3,4" flip="1,1" alignment="CENTER" onState="Facing.Left" />
        <SpriteRender name="s_staff" offset="3,4" alignment="CENTER" onState="Facing.Right" />
        <SpriteRender name="s_staffGlow" offset="3,4" flip="1,1" alignment="CENTER" onState="Facing.Left" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
        <SpriteRender name="s_staffGlow" offset="3,4" alignment="CENTER" onState="Facing.Right" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
        <Group onState="Facing.Right">
          <ParticleSystemUpdate name="p_punch" />
          <ParticleSystemRender name="p_punch" />
        </Group>
        <Group onState="Facing.Left">
          <ParticleSystemUpdate name="p_punchLeft" />
          <ParticleSystemRender name="p_punchLeft" />
        </Group>
      </Group>
      <Group onState="Action.None">
        <SpriteRender name="s_staff" offset="0,3" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" />
        <SpriteRender name="s_staffGlow" offset="0,3" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      </Group>
    </RenderBackHandItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" ?>
<ItemRenderer>
  <Data>
    <Sprite name="s_straps" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="27,5" />
    <Sprite name="s_speaker" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="23,5" />
    <Sprite name="s_jumpRing" fileName="game/particles9.rttex" textureSize="32" frame="12,5" />

    <Animations>
      <SpriteAnimation name="a_speaker" sprite="s_speaker" isLoop="true" animTime="1000" autoPlay="false" playOnState="PlayerAction.Idle">
        <Frame>23,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_speakerPunch" sprite="s_speaker" isLoop="true" animTime="1200" autoPlay="false" playOnState="PlayerAction.Punch|PlayerAction.Dance">
        <Frame>23,5</Frame>
        <Frame>24,5</Frame>
        <Frame>25,5</Frame>
        <Frame>26,5</Frame>
        <Frame>24,5</Frame>
        <Frame>25,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_speakerJump" sprite="s_speaker" isLoop="false" animTime="1200" autoPlay="false" playOnState="PlayerAction.Jump|PlayerAction.DJump">
        <Frame>23,5</Frame>
        <Frame>24,5</Frame>
        <Frame>25,5</Frame>
        <Frame>26,5</Frame>
        <Frame>24,5</Frame>
        <Frame>25,5</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="PlayerAction">
        <States>
          <State name="Idle" />
          <State name="Punch" />
          <State name="Dance" />
          <State name="Jump" />
          <State name="DJump" />
        </States>
        <Transitions>
          <Transition from="Punch|Dance|Jump|DJump" to="Idle">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableBool name="onGround">true</IsVariableBool>
              <IsDancing>false</IsDancing>
            </Condition>
          </Transition>
          <Transition from="Idle|Dance|Jump|DJump" to="Punch">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Idle|Punch|Jump|DJump" to="Dance">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsDancing>true</IsDancing>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Idle|Punch|Dance" to="Jump">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction>JUMPSTART</IsAction>
            </Condition>
          </Transition>
          <Transition from="Jump" to="DJump">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction>JUMPDOUBLE</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_jumpHeartsLeft" renderStage="RenderChestItem">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">-18,30</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_jumpRing</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 50</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.4,0.2</Set>
          <Increment name="initialScale" source="particleIndex" multiplier="0.2,0.1"/>
          <Set name="finalScale">1.2,0.6</Set>
          <Increment name="finalScale" source="particleIndex" multiplier="0.4,0.2"/>
          <Set name="offset">0,-25</Set>
          <Increment name="worldPos" source="particleIndex" multiplier="0,12"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_jumpHeartsRight" renderStage="RenderChestItem">
        <Emitter>
          <Set name="particlesPerEmission">3</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">18,30</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_jumpRing</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.75</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 50</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.4,0.2</Set>
          <Increment name="initialScale" source="particleIndex" multiplier="0.2,0.1"/>
          <Set name="finalScale">1.2,0.6</Set>
          <Increment name="finalScale" source="particleIndex" multiplier="0.4,0.2"/>
          <Set name="offset">0,-25</Set>
          <Increment name="worldPos" source="particleIndex" multiplier="0,12"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
      </Default>
    </RenderOptions>
    
  </Data>
  <RenderRules>
    <Update>
      <MusicSource onState="PlayerAction.Punch|PlayerAction.Dance">
        <Set name="ItemID">ITEM_ID_PORTABLE_PARTY</Set>
        <Set name="FadeOutTimeMs">500</Set>
      </MusicSource>
    </Update>
    <RenderChestItem>
      <SpriteRender name="s_straps" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
    </RenderChestItem>
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_jumpHeartsLeft" onAction="JUMPSTART|JUMPDOUBLE"/>
      <ParticleSystemUpdate name="ps_jumpHeartsRight" onAction="JUMPSTART|JUMPDOUBLE"/>
    </AddClothingParticles>
    <RenderChestBackItem>
      <SpriteRender name="s_speaker" blend="NORMAL" offset="-16,0" alignment="DOWN_CENTER" drawShadow="true" />
      <SpriteRender name="s_speaker" blend="NORMAL" offset="16,0" alignment="DOWN_CENTER" drawShadow="true" />
    </RenderChestBackItem>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_PRIMAL_BOW">
  <Data>
    <Sprite name="s_bow" fileName="game/particles_large12.rttex" textureSize="64" frame="15,13"/>
    <Sprite name="s_glove" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="27,20"/>
    <Sprite name="s_quiver" fileName="game/player_cosmetics3.rttex" textureSize="32"/>
    <Sprite name="s_strap" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="26,20"/>
    <Sprite name="s_arrow" fileName="game/particles11.rttex" textureSize="32"/>
    <Sprite name="s_tileArrow" fileName="game/particles11.rttex" textureSize="32"/>
    <Sprite name="s_ember" fileName="game/particles11.rttex" textureSize="32"/>

    <StateMachines>
      <StateMachine name="Punch">
        <States>
          <State name="True"/>
          <State name="False"/>
        </States>
        <Transitions>
          <Transition from="False" to="True">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="True" to="False">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <SpriteAnimation name="a_arrow" sprite="s_arrow">
        <Frame>7,26</Frame>
        <Frame>8,26</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_ember" sprite="s_ember">
        <Frame>5,26</Frame>
        <Frame>6,26</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_quiverIdle" sprite="s_quiver" animTime="100" playOnState="Punch.False" isLoop="true">
        <Frame>25,20</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_quiverPunch" sprite="s_quiver" animTime="1000" playOnState="Punch.True" isLoop="true">
        <Frame>25,21</Frame>
        <Frame>26,21</Frame>
        <Frame>27,21</Frame>
        <Frame>28,21</Frame>
        <Frame>29,21</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_tileArrow" sprite="s_tileArrow" animTime="1100">
        <Frame>17,27</Frame>
        <Frame>7,27</Frame>
        <Frame>8,27</Frame>
        <Frame>9,27</Frame>
        <Frame>10,27</Frame>
        <Frame>11,27</Frame>
        <Frame>12,27</Frame>
        <Frame>13,27</Frame>
        <Frame>14,27</Frame>
        <Frame>15,27</Frame>
        <Frame>16,27</Frame>
      </SpriteAnimation>
    </Animations>

    <VariableMap>
      <Set name="projectile_offset">0, 0</Set>
      <Set name="projectile_angle">0</Set>
    </VariableMap>

    <ParticleSystems>
      <ParticleSystem name="ps_punchProjectile" updateStage="RenderBackHandItem" updateState="Punch.True">
        <Emitter attachment="handspotRoot">
          <Set name="offset">-3, 0</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_arrow</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.2</Set>
          <Random name="targetPosOffset" min="-12,-11" max="12,11"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angleOutVar="projectile_angle"/>
          <Set name="rotateWithVelocity">true</Set>
          <SetVar name="projectile_offset" source="targetPosOffset"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tileArrow">
        <Emitter>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_tileArrow</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1.1</Set>
          <Set name="renderAlignment">RIGHT_CENTER</Set>
          <Set name="offset" source="projectile_offset"/>
          <Set name="initialAngle" source="projectile_angle"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_hitEmbers">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_ember</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="-4,-3" max="4,3" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="80,200" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_destroyEmbers">
        <Emitter>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">16</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_ember</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 0.25,0.25</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="5" max="15" />
          <Random name="offset" min="-4,-3" max="4,3" />
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="80,200" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="HideParticlesOnTransform">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackArm>
      <SpriteRender name="s_quiver" offset="0.5, -16" useFixedRotation="true" fixedRotation="0"/>
    </RenderBackArm>
    <RenderFrontArm value="playerCenter">
      <SpriteRender name="s_strap" offset="0, -16" useFixedRotation="true" fixedRotation="0"/>
    </RenderFrontArm>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_bow" offset="-4,-1" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_glove" offset="-3,11" rotateOffset="true" rotationPoint="0,1" alignment="CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackHandItem>
    <RenderHandItem>
      <SpriteRender name="s_glove" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderHandItem>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1500</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <StopIf type="or">
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
      </StopIf>
      <ParticleSystemUpdate name="ps_tileArrow" />
      <ParticleSystemUpdate name="ps_hitEmbers" />
    </OnDamagedTile>
    <OnDestroyedTile>
      <StopIf type="or">
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
      </StopIf>
      <ParticleSystemUpdate name="ps_destroyEmbers" />
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_animal" fileName="game/particles_large14.rttex" textureSize="64" frame="0,6" />
		<Sprite name="s_animal_punch" fileName="game/particles_large14.rttex" textureSize="64" frame="0,7" />
		<Sprite name="s_back_cloud" fileName="game/particles_large14.rttex" textureSize="64" frame="0,5" />
		<Sprite name="s_front_cloud" fileName="game/particles_large14.rttex" textureSize="64" frame="0,5" />
		<Sprite name="s_front_cloud_punch" fileName="game/particles_large14.rttex" textureSize="64" frame="0,4" />
		<Sprite name="s_god_rays" fileName="game/particles_large14.rttex" textureSize="64" frame="2,10" />
		<Sprite name="s_necklace" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="2,16" />
		<StateMachines>
			<StateMachine name="Action1">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteCurveAnimation name="a_back_cloud_spin" isLoop="true" autoPlay="true" sprite="s_back_cloud" animTime="15000">
				<Curve name="rotation">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 360</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteSinPulseAnimation name="a_animal_Stretch" sprite="s_animal" autoPlay="true" isLoop="true">
				<Parameter name="scale.x">
					<Set name="offset">1</Set>
					<Set name="period">3000</Set>
					<Set name="scale">0.1</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteSinPulseAnimation name="a_animal_Stretchy" sprite="s_animal" autoPlay="true" isLoop="true">
				<Parameter name="scale.y">
					<Set name="offset">1</Set>
					<Set name="period">4500</Set>
					<Set name="scale">0.1</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
			<SpriteAnimation name="a_animal" sprite="s_animal" animTime="1000" autoPlay="true" isLoop="true">
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
				<Frame>3,6</Frame>
				<Frame>4,6</Frame>
				<Frame>5,6</Frame>
				<Frame>6,6</Frame>
				<Frame>7,6</Frame>
				<Frame>8,6</Frame>
				<Frame>9,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_back_cloud" sprite="s_back_cloud" animTime="1000" autoPlay="true" isLoop="true">
				<Frame>0,9</Frame>
				<Frame>1,9</Frame>
				<Frame>2,9</Frame>
				<Frame>3,9</Frame>
				<Frame>4,9</Frame>
				<Frame>5,9</Frame>
				<Frame>6,9</Frame>
				<Frame>7,9</Frame>
				<Frame>8,9</Frame>
				<Frame>9,9</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_front_cloud" sprite="s_front_cloud" animTime="1000" autoPlay="true" isLoop="true">
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
				<Frame>5,5</Frame>
				<Frame>6,5</Frame>
				<Frame>7,5</Frame>
				<Frame>8,5</Frame>
				<Frame>9,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_front_cloud_punch" sprite="s_front_cloud_punch" animTime="1000">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
				<Frame>5,4</Frame>
				<Frame>6,4</Frame>
				<Frame>7,4</Frame>
				<Frame>8,4</Frame>
				<Frame>9,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_god_rays" sprite="s_god_rays" animTime="200" autoPlay="true" isLoop="true">
				<Frame>2,10</Frame>
				<Frame>3,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="s_animal_punch" sprite="s_animal_punch" animTime="500" isLoop="true" playOnState="Action1.Punch">
				<Frame>3,7</Frame>
				<Frame>4,7</Frame>
				<Frame>5,7</Frame>
				<Frame>6,7</Frame>
				<Frame>7,7</Frame>
			</SpriteAnimation>
		</Animations>
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="UserNameOffset">30</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="ps_front_cloud" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="emissionInterval">3</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_front_cloud</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0.6</KeyFrame>
						<KeyFrame>0.9, 0.6</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0.8, 0.8</KeyFrame>
					</Curve>
					<Set name="lifeTime">10</Set>
					<Curve name="initialRotationRate">
						<KeyFrame>0, 6</KeyFrame>
						<KeyFrame>1, 12</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_front_cloud_punch" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="emissionInterval">3</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_front_cloud_punch</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.1, 0.6</KeyFrame>
						<KeyFrame>0.9, 0.6</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>0.9, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0.8, 0.8</KeyFrame>
					</Curve>
					<Set name="lifeTime">10</Set>
					<Curve name="initialRotationRate">
						<KeyFrame>0, 6</KeyFrame>
						<KeyFrame>1, 12</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_god_rays" updateStage="AddClothingParticles">
				<Emitter>
					<Set name="offset">0, -54</Set>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_god_rays</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.3</KeyFrame>
						<KeyFrame>0.5, 0.3</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.75</Set>
					<Random name="initialAngle" min="-75" max="75" />
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
	</Data>
	<RenderRules>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="s_back_cloud" scale="0.6,0.6" offset="0,-52" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
			<SpriteRender name="s_animal" scale="0.3,0.3" offset="-1,-48" drawShadow="false" blend="ADDITIVE" onState="Action1.None" />
			<SpriteRender name="s_animal_punch" scale="0.3,0.3" offset="-1,-48" drawShadow="false" blend="ADDITIVE" onState="Action1.Punch" />
			<StopIf>
				<IsRenderMod>RENDER_MOD_PLAYER_SHADOW</IsRenderMod>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_front_cloud" onState="Action1.None" />
			<ParticleSystemRender name="ps_front_cloud_punch" onState="Action1.Punch" />
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ParticleSystemRender name="ps_god_rays" />
			<StopIf>
				<IsVariableBool name="isMannequin">false</IsVariableBool>
			</StopIf>
			<SpriteRender name="s_front_cloud" scale="0.6,0.6" offset="0,-52" drawShadow="false" blend="PREMULTIPLIED_ALPHA" />
		</RenderBehind>
		<RenderChestItem>
			<SpriteRender name="s_necklace" offset="0,0" alignment="DOWN_CENTER" />
		</RenderChestItem>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_discBack" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="24,8"/>
    <Sprite name="s_discFront" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="23,8"/>
    <Sprite name="s_projectile" fileName="game/particles12.rttex" textureSize="32" frame="22,16"/>
    <Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="21,16"/>

    <VariableMap>
      <Set name="context.pos.3f">0, 0, 0</Set>
      <Set name="target.pos.3f">0, 0, 0</Set>
      <Set name="calculatedPos3f">0, 0, 0</Set>
      <Set name="finalPos3f">0, 0, 0</Set>
      <Set name="chakramAngle4f">0,0,0,1</Set>
      <Set name="chakramAngle">0</Set>
      <Set name="chakramAngle1">0</Set>
      <Set name="Player.GetFacing">0</Set>
      <Set name="chakram.Offset">0, 0, 0</Set>
      <Set name="chakram.velocity.original">50, 50</Set>
      <Set name="chakram.velocity.final">50, 50</Set>
    </VariableMap>

    <Animations>
      
      <InterpolationVec3Animation name="a_punchStart3f" variableName="calculatedPos3f" targetVariableName="target.pos.3f" animTime="500" playOnState="PunchAnim.Start"/>
      <InterpolationVec3Animation name="a_punchContinue3f" variableName="calculatedPos3f" targetVariableName="target.pos.3f" animTime="30" isLoop="true" playOnState="PunchAnim.Continue"/>
      <InterpolationVec3Animation name="a_punchEnd3f" variableName="calculatedPos3f" targetVariableName="context.pos.3f" animTime="250" playOnState="PunchAnim.End"/>

      <InterpolationVec3Animation name="a_asdfStart" variableName="chakram.Offset" targetValue="0,0,0" animTime="500" playOnState="PunchAnim.Start"/>
      <InterpolationVec3Animation name="a_dfyjrtEnd" variableName="chakram.Offset" targetValue="0,-8,0" animTime="250" playOnState="PunchAnim.End"/>

      <CurveAnimationVec4 name="a_chakramRotationRight4f" playOnState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" isLoop="true" useFacing="RIGHT" animTime="250">
        <Curve name="chakramAngle4f">
          <KeyFrame>0, 0,0,0,1</KeyFrame>
          <KeyFrame>1, 360,0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
      <CurveAnimationVec4 name="a_chakramRotationLeft4f" playOnState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End" isLoop="true" useFacing="LEFT" animTime="250">
        <Curve name="chakramAngle4f">
          <KeyFrame>0, 0,0,0,1</KeyFrame>
          <KeyFrame>1, -360,0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
    </Animations>

    <StateMachines>
      <StateMachine name="PunchAnim">
        <States>
          <State name="Off"/>
          <State name="Start" ExitTime="0.5" />
          <State name="Continue"/>
          <State name="End" ExitTime="0.25" />
        </States>
        <Transitions>
          <Transition from="Off" to="Start">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition from="Start" to="Continue"/>
          <Transition from="Continue" to="End">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="End" to="Off"/>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="punch_particle" renderStage="RenderHandItem">
        <Emitter>
          <Set name="lifeTime">0.02</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="emissionInterval">0.02</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_projectile</Set>
          <Set name="relativeToEmitter">false</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.04</Set>
          <Set name="initialScale">1,1</Set>
          <Set name="initialAngle" source="chakramAngle"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_particle1" renderStage="RenderHandItem">
        <Emitter>
          <Set name="lifeTime">0.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">100</Set>
          <Set name="emissionInterval">0.01</Set>
        </Emitter>
        <Particle VelocityRelativeToParticleAngle="true">
          <Set name="sprite">s_trail</Set>
          <Set name="relativeToEmitter">false</Set>
          <Set name="angRelativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">1,1</Set>
          <Set name="initialAngle" source="chakramAngle"/>
          <Set name="initialVelocity" source="chakram.velocity.final"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="punch_particle2" renderStage="RenderHandItem">
        <Emitter>
          <Set name="lifeTime">0.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">100</Set>
          <Set name="emissionInterval">0.01</Set>
        </Emitter>
        <Particle VelocityRelativeToParticleAngle="true">
          <Set name="sprite">s_trail</Set>
          <Set name="angRelativeToEmitter">true</Set>
          <Set name="relativeToEmitter">false</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initialScale">1,1</Set>
          <Set name="initialAngle" source="chakramAngle1"/>
          <Set name="initialVelocity" source="chakram.velocity.final"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="RenderFrontArmInTheFront">true</Set>
        <Set name="RenderBackArmAfterItem">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">0</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <Update>
      <ArithmethicOperation LeftHandVariableName="calculatedPos3f" RightHandVariableName="context.pos.3f" OperationType="Set" onState="PunchAnim.Off"/>

      <Group onState="PunchAnim.Start|PunchAnim.Continue|PunchAnim.End">
        <ArithmethicOperation LeftHandVariableName="finalPos3f" RightHandVariableName="calculatedPos3f" OperationType="Set"/>
        <ArithmethicOperation LeftHandVariableName="chakramAngle" RightHandVariableName="chakramAngle4f.x" OperationType="Set"/>
        <ArithmethicOperation LeftHandVariableName="finalPos3f" RightHandVariableName="context.pos.3f" OperationType="Substract"/>
        <ArithmethicOperation LeftHandVariableName="finalPos3f.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
        <Translate>finalPos3f</Translate>
        <Translate>chakram.Offset</Translate>
        <Rotate>chakramAngle4f</Rotate>
        <ArithmethicOperation LeftHandVariableName="chakramAngle1" RightHandVariableName="chakramAngle" OperationType="Set"/>
        <ArithmethicOperation LeftHandVariableName="chakramAngle1" RightHandVariableName="180" OperationType="Add"/>
        <ArithmethicOperation LeftHandVariableName="chakramAngle" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
        <ArithmethicOperation LeftHandVariableName="chakramAngle1" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
        <ArithmethicOperation LeftHandVariableName="chakram.velocity.final" RightHandVariableName="chakram.velocity.original" OperationType="Set"/>
        <ArithmethicOperation LeftHandVariableName="chakram.velocity.final" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
        <ParticleSystemUpdate name="punch_particle"/>
        <Translate>8, 0, 0</Translate>
        <ParticleSystemUpdate name="punch_particle1"/>
        <Translate>-16, 0, 0</Translate>
        <ParticleSystemUpdate name="punch_particle2"/>
      </Group>
    </Update>
    <RenderHandItem>
      <SpriteRender name="s_discFront" offset="0.3,16.3" rotateOffset="true" rotationPoint="0,1" blend="NORMAL" alignment="CENTER" drawShadow="true" onState="PunchAnim.Off"/>
    </RenderHandItem>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_discBack" offset="-2.8,11.3" rotateOffset="true" rotationPoint="1,1" blend="NORMAL" alignment="CENTER" drawShadow="true" onState="PunchAnim.Off"/>
    </RenderBackHandItem>
  </RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_PUMPKIN_CARRIAGE">
	<Data>
		<Sprite name="foot1_Sprite" fileName="game/particles_large13.rttex" textureSize="64"/>
		<Sprite name="glowingFace_Sprite" fileName="game/particles11.rttex" textureSize="32" frame="6,28"/>
		<Sprite name="SmokeSprite" fileName="game/particles11.rttex" textureSize="32"/>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="None" />
					<State name="Idle" />
					<State name="Moving" />
				</States>
				<Transitions>
					<Transition to="None" from="Idle|Moving">
						<Condition type="or">
							<IsSitting>true</IsSitting>
							<IsSleepingOnaBed>true</IsSleepingOnaBed>
							<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
						</Condition>
					</Transition>					
					<Transition to="Idle" from="None|Moving">
						<Condition type="and">
							<IsSitting>false</IsSitting>
							<IsSleepingOnaBed>false</IsSleepingOnaBed>
							<IsWearing operatorType="NotEqual" slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="None|Idle">
						<Condition type="and">
							<IsSitting>false</IsSitting>
							<IsSleepingOnaBed>false</IsSleepingOnaBed>
							<IsWearing operatorType="NotEqual" slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="smokeAnim" sprite="SmokeSprite" animTime="100">
				<Frame>7,28</Frame>
				<Frame>8,28</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="foot1_Idle" playOnState="Motion.Idle" sprite="foot1_Sprite" animTime="100" isLoop="true">
				<Frame>14,10</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="foot1_Walk" playOnState="Motion.Moving" sprite="foot1_Sprite" animTime="200" isLoop="true">
				<Frame>14,10</Frame>
				<Frame>15,10</Frame>
			</SpriteAnimation>
			<SpriteCurveAnimation name="hat" isLoop="true" autoPlay="true" sprite="glowingFace_Sprite" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.4f</KeyFrame>
					<KeyFrame>0.2f, 0.6f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.4f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>	
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="SmokeTrailLeftTrail">
				<Emitter>
					<Random name="emissionInterval" min="0.05" max="0.1" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">0, 10</Set>
				</Emitter>
				<Particle usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="sprite">SmokeSprite</Set>
					<Random name="offset" min="0, 0" max="2, 0" />
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.2, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75, 0.75</KeyFrame>
						<KeyFrame>1, 0.5, 1.5</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="-60" max="-90" />
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="SmokeTrailRightTrail">
				<Emitter>
					<Random name="emissionInterval" min="0.05" max="0.1" />
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offset">13.5, 12</Set>
				</Emitter>
				<Particle usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="sprite">SmokeSprite</Set>
					<Random name="offset" min="0, 0" max="6, 0" />
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
