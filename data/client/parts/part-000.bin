        <Frame>2,20</Frame>
        <Frame>2,21</Frame>
      </SpriteAnimation>
    </Animations>
    <ParticleSystems>
      <ParticleSystem name="dirtOrbit1" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0, -10</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">1</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">-1000</Set>
            <Set name="hAmplitude">20</Set>
            <Set name="hTimeOffset">0</Set>
            <Set name="vAmplitude">4</Set>
            <Set name="vOrbitPeriod">1000</Set>
            <Set name="vTimeOffset">0</Set>
            <Set name="minScale">0.3</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">dirtSprite1</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="lifeTime">0.1</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="dirtOrbit2" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0, -23</Set>
          <Set name="emissionInterval">0.0625</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">1</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">-1250</Set>
            <Set name="hAmplitude">26</Set>
            <Set name="hTimeOffset">-500</Set>
            <Set name="vAmplitude">-3</Set>
            <Set name="vOrbitPeriod">1250</Set>
            <Set name="vTimeOffset">-500</Set>
            <Set name="minScale">0.3</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">dirtSprite2</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="lifeTime">0.125</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="dirtOrbit3" updateStage="AddClothingParticles">
        <Emitter>
          <Set name="offset">0, -36</Set>
          <Set name="emissionInterval">0.075</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <OrbitOffset>
            <Set name="maxScale">1</Set>
            <Set name="hasOrbit">true</Set>
            <Set name="hOrbitPeriod">-1500</Set>
            <Set name="hAmplitude">30</Set>
            <Set name="hTimeOffset">-1000</Set>
            <Set name="vAmplitude">7</Set>
            <Set name="vOrbitPeriod">1500</Set>
            <Set name="vTimeOffset">-1000</Set>
            <Set name="minScale">0.3</Set>
          </OrbitOffset>
        </Emitter>
        <Particle>
          <Set name="sprite">dirtSprite3</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">false</Set>
          <Set name="lifeTime">0.15</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="UserNameOffset">25</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <AddClothingParticles />
    <RenderBehind value="playerCenter">
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsRenderMod>RENDER_MOD_PORTRAIT</IsRenderMod>
      </StopIf>
      <ContextUpdate type="SetFlip">
        <Set name="flip">1,0</Set>
      </ContextUpdate>
      <SpriteRender name="s_backWind" alignment="DOWN_CENTER" offset="0,6" drawShadow="false" blend="PREMULTIPLIED_ALPHA" tintOverride="255,255,255,255" />
    </RenderBehind>
    <RenderInFront>
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <ParticleSystemRender name="dirtOrbit1" />
      <ParticleSystemRender name="dirtOrbit2" />
      <ParticleSystemRender name="dirtOrbit3" />
      <ContextUpdate type="SetFlip">
        <Set name="flip">0,0</Set>
      </ContextUpdate>
      <SpriteRender name="s_frontWind" alignment="DOWN_CENTER" offset="0,6" drawShadow="false" blend="PREMULTIPLIED_ALPHA" tintOverride="255,255,255,120" />
    </RenderInFront>
    <RenderHat>
      <Group>
        <ContextUpdate type="SetFlip">
          <Set name="flip">0,0</Set>
        </ContextUpdate>
        <SpriteRender name="s_backWind" alignment="DOWN_CENTER" scale ="0.5,0.5" offset="0,-35" drawShadow="false" blend="PREMULTIPLIED_ALPHA" tintOverride="255,255,255,255"/>
        <SpriteRender name="s_backWind" alignment="DOWN_CENTER" scale ="0.5,0.5" offset="0,-35" drawShadow="false" blend="PREMULTIPLIED_ALPHA" tintOverride="255,255,255,255"/>
        <ContextUpdate type="SetFlip">
          <Set name="flip">-1,0</Set>
        </ContextUpdate>
        <SpriteRender name="s_lightning2" alignment="DOWN_CENTER" offset="0,-32" drawShadow="false" blend="ADDITIVE" tintOverride="255,255,255,120" scale="0.8,0.8"/>
        <SpriteRender name="s_lightning2" alignment="DOWN_CENTER" offset="0,-32" drawShadow="false" blend="ADDITIVE" tintOverride="120,200,255,120" scale="0.8,0.8"/>
        <SpriteRender name="s_frontWind" alignment="DOWN_CENTER" scale ="0.5,0.5" offset="0,-35" drawShadow="false" blend="PREMULTIPLIED_ALPHA" tintOverride="255,255,255,120" />
        <SpriteRender name="s_lightning" alignment="DOWN_CENTER" offset="0,-32" drawShadow="false" blend="PREMULTIPLIED_ALPHA" scale="0.8,0.8" tintOverride="255,255,255,180"/>
      </Group>
      <SpriteRender name="s_crown" alignment="DOWN_CENTER" offset="0,-16" blend="PREMULTIPLIED_ALPHA" />
    </RenderHat>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_STUDENT_HERO_GLOVES">
	<Data>
		<Sprite name="Glove" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="20,11"/>
		<Sprite name="Lightning" fileName="game/particles_large12.rttex" textureSize="64" frame="4,9"/>
		<Sprite name="Trail" fileName="game/particles11.rttex" textureSize="32" frame="20,16"/>
		<Sprite name="Punch" fileName="game/particles11.rttex" textureSize="32" frame="19,16"/>
		<Sprite name="PunchParticle" fileName="game/particles_large12.rttex" textureSize="64" frame="10,4"/>
		<Sprite name="PunchParticleTrail" fileName="game/particles11.rttex" textureSize="32" frame="18,16"/>
		<Sprite name="Hit" fileName="game/particles_large12.rttex" textureSize="64" frame="11,4"/>
		<Sprite name="HitParticle" fileName="game/particles11.rttex" textureSize="32" frame="15,16"/>
		<Sprite name="Muzzle" fileName="game/particles11.rttex" textureSize="32" frame="19,16"/>
		
		<Animations>
			<SpriteAnimation name="Lightning_Anim" playOnAction="IDLE" sprite="Lightning" animTime="910" isLoop="true">
				<Frame>4, 9</Frame>
				<Frame>5, 9</Frame>
				<Frame>6, 9</Frame>
				<Frame>7, 9</Frame>
				<Frame>8, 9</Frame>
				<Frame>9, 9</Frame>
				<Frame>10, 9</Frame>
				<Frame>11, 9</Frame>
				<Frame>12, 9</Frame>
				<Frame>13, 9</Frame>
				<Frame>14, 9</Frame>
				<Frame>15, 9</Frame>
				<Frame>8, 8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="Trail_Anim" sprite="Trail" animTime="800">
				<Frame>20, 16</Frame>
				<Frame>21, 16</Frame>
				<Frame>22, 16</Frame>
				<Frame>23, 16</Frame>
				<Frame>24, 16</Frame>
				<Frame>25, 16</Frame>
				<Frame>26, 16</Frame>
				<Frame>27, 16</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<ParticleSystem name="punch_particleTrail">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="offset">-5,-15</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">PunchParticleTrail</Set>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 5, 1</KeyFrame>
					</Curve>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="punch_particle">
				<Emitter>
					<Set name="offset">0,-14</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">PunchParticle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="particle_trail">
				<Emitter>
					<Set name="offset">0,-16</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="emissionInterval">.15</Set>
				</Emitter>
				<Particle angleRelativeToPlayerSpeed="true">
					<Set name="sprite">Trail</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 1</KeyFrame>
						<KeyFrame>1, 2, 1</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hitPieces_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">HitParticle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.3, 0.3</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="80,150"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">Hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="muzzle_particle">
				<Emitter attachment="handspotRoot">
					<Set name="offset">-2,8</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="infParticles">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">Muzzle</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 2, 2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<AddClothingParticles>
			<ParticleSystemUpdate name="particle_trail" onAction="WALK|JUMP|FALL"/>
		</AddClothingParticles>
		<RenderInFront>
			<StopIf>
				<IsZombified>true</IsZombified>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
			<SpriteRender name="Lightning" alignment="DOWN_CENTER" onAction="IDLE" drawShadow="false"/>
		</RenderInFront>
		<RenderBehind>
			<ParticleSystemRender name="particle_trail"/>
		</RenderBehind>
		<RenderHandItem>
			<SpriteRender name="Glove" alignment="UPPER_CENTER"/>
			<ParticleSystemUpdate name="muzzle_particle" onAction="PUNCH"/>
		</RenderHandItem>
		<OnPunchStart>
			<ParticleSystemUpdate name="punch_particleTrail"/>
			<ParticleSystemUpdate name="punch_particle"/>
		</OnPunchStart>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hitPieces_particle"/>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="hitPieces_particle"/>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDestroyedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="punch_particle"/>
			<ParticleSystemOff name="punch_particleTrail"/>
			<ParticleSystemOff name="particle_trail"/>
			<ParticleSystemOff name="hit_particle"/>
			<ParticleSystemOff name="hitPieces_particle"/>
			<ParticleSystemOff name="muzzle_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Pet" fileName="game/bb_page1.rttex" textureSize="128,128" frame="0,0" />
		<Sprite name="s_Chest" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="23,21" />
		<Sprite name="s_Punch" fileName="game/particles10.rttex" textureSize="32" frame="8,6" />
		<Sprite name="s_tileFeather" fileName="game/particles11.rttex" textureSize="32" frame="11,26" />
		<Sprite name="s_curvedFeather" fileName="game/particles10.rttex" textureSize="32" frame="10,6"/>
		<Animations>
			<SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="400" isLoop="true" playOnState="Action.None">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_PetPunch" sprite="s_Pet" animTime="300" isLoop="true" playOnState="Action.Punch">
				<Frame>0,2</Frame>
				<Frame>6,0</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="PunchParticle">
				<Emitter>
					<Set name="offset">0, -14</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Punch</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Random name="targetPosOffset" min="-8.1,-8.3" max="8.2,8.8"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" angleOutVar="projectile_angle"/>
					<Set name="rotateWithVelocity">true</Set>
					<SetVar name="projectile_offset" source="targetPosOffset"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_tileFeather" secondary="ps_destroyFeatherSingle">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileFeather</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.55</Set>
					<Set name="initialScale">0.75,0.75</Set>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="offset" source="projectile_offset"/>
					<Set name="initialAngle" source="projectile_angle"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_destroyFeathers">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">10</Set>
					<Set name="emissionInterval">0.035</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="offset">0,0</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="-20,-21" max="20,0"/>
					<Set name="sprite">s_curvedFeather</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.5</Set>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 30</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Random name="flipX" min="false" max="true"/>
					<Set name="renderAlignment">UPPER_CENTER</Set>
					<Curve name="initialAngle">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -15</KeyFrame>
						<KeyFrame>0.4, 15</KeyFrame>
						<KeyFrame>0.6, -15</KeyFrame>
						<KeyFrame>0.8, 15</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Curve name="initialVelocity">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -20, 0</KeyFrame>
						<KeyFrame>0.4, 50, 0</KeyFrame>
						<KeyFrame>0.6, -50, 0</KeyFrame>
						<KeyFrame>0.8, 50, 0</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_destroyFeatherSingle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.035</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="delayTimer">0.55</Set>
				</Emitter>
				<Particle UseParentEmitterAngle="true">
					<Set name="sprite">s_curvedFeather</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.5</Set>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 30</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="finalAngle">0,0</Set>
					<Set name="renderAlignment">RIGHT_CENTER</Set>
					<Set name="interpolateAngle">true</Set>
					<Curve name="initialVelocity">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, -20, 0</KeyFrame>
						<KeyFrame>0.4, 50, 0</KeyFrame>
						<KeyFrame>0.6, -50, 0</KeyFrame>
						<KeyFrame>0.8, 50, 0</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="projectile_offset">0, 0</Set>
			<Set name="projectile_angle">0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-48,0</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HideParticlesOnTransform">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<OnDamagedTile>
			<StopIf type="or">
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
			</StopIf>
			<ParticleSystemUpdate name="ps_tileFeather" />
		</OnDamagedTile>
		<OnDestroyedTile>
			<StopIf type="or">
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
			</StopIf>
			<ParticleSystemUpdate name="ps_destroyFeathers" />
		</OnDestroyedTile>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderChestItem>
			<SpriteRender name="s_Chest" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
		</RenderChestItem>
		<RenderPet>
			<SpriteRender name="s_Pet" scale="0.35,0.35" alignment="DOWN_CENTER"/>
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
			<ParticleSystemUpdate name="PunchParticle" onState="Action.Punch"/>
		</RenderPet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_stingerBack" fileName="game/particles_large19.rttex" textureSize="64" frame="4,1" />
    <Sprite name="s_stingerFront" fileName="game/particles_large19.rttex" textureSize="64" frame="0,1" />
    <Sprite name="s_hit" fileName="game/particles12.rttex" textureSize="32" frame="28,22"/>
    <Sprite name="s_punchParticle" fileName="game/particles12.rttex" textureSize="32" frame="29,22"/>
    
    <Animations>
      <SpriteAnimation name="a_stingerBack_equip" isLoop="true" sprite="s_stingerBack"  animTime="1000" playOnState="Action.None">
        <Frame>4,1</Frame>
      </SpriteAnimation>

      <SpriteAnimation name="a_stingerBack_punch" isLoop="true" sprite="s_stingerBack"  animTime="400" playOnState="Action.Punch">
        <Frame>0,2</Frame>
        <Frame>1,2</Frame>
        <Frame>2,2</Frame>
        <Frame>3,2</Frame>
      </SpriteAnimation>

      <SpriteAnimation name="a_stingerFront_punch" isLoop="true" sprite="s_stingerFront"  animTime="400" playOnState="Action.Punch">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Facing">
        <States>
          <State name="Left"/>
          <State name="Right"/>
        </States>
        <Transitions>
          <Transition to="Left" from="Right">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition to="Right" from="Left">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Zombie">
        <States start="Off">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <IsZombified>true</IsZombified>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <ParticleSystems>
			<ParticleSystem name="ps_punchRight" updateStage="OnPunchStart" updateState="Facing.Right">
				<Emitter>
					<Set name="offset">0,-18</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="lifeTime">0.1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punchParticle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="initialScale">1,0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <Select name="offset" input="punchCount">
            <Item>-16,10</Item>
            <Item>10,-16</Item>
            <Item>-10,-24</Item>
            <Item>14,10</Item>
          </Select>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_punchLeft" updateStage="OnPunchStart" updateState="Facing.Left">
				<Emitter>
					<Set name="offset">0,-18</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="lifeTime">0.1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_punchParticle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="initialScale">1,0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <Select name="offset" input="punchCount">
            <Item>16,10</Item>
            <Item>-10,-16</Item>
            <Item>10,-24</Item>
            <Item>-14,10</Item>
          </Select>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hit">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">5</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
    
    <RenderOptions>
      <Default>
        <Set name="UserNameOffset">8</Set>
      </Default>
    </RenderOptions>

  </Data>
  <RenderRules>
    <RenderBackpack>
      <StopIf>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
      <SpriteRender name="s_stingerBack" offset="0,0" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" />
    </RenderBackpack>

    <RenderInFront value="playerCenter">
      <StopIf>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsTrnsformed>true</IsTrnsformed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>

      <ContextUpdate type="SetTint" onState="Zombie.On">
        <Set name="tint">111,217,45</Set>
        <Set name="forceTint">true</Set>
      </ContextUpdate>
      
      <SpriteRender name="s_stingerFront" offset="0,0" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" onState="Action.Punch"/>
    </RenderInFront>
    
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
  
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_hit"/>
    </OnDamagedTile>
    
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_hit"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Motion1">
				<States>
					<State name="OnGround"/>
					<State name="InAir"/>
				</States>
				<Transitions>
					<Transition to="OnGround" from="InAir">
						<Condition>
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="InAir" from="OnGround">
						<Condition>
							<IsVariableBool name="onGround">false</IsVariableBool>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Motion2">
				<States>
					<State name="Idle"/>
					<State name="Moving"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Moving">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Moving" from="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Motion3">
				<States>
					<State name="Idle"/>
					<State name="Walk"/>
					<State name="Jump"/>
					<State name="Fall"/>
					<State name="Sleep"/>
					<State name="Dance"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Walk|Fall|Sleep|Dance">
						<Condition type="and">
							<IsAction>IDLE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Walk" from="Idle|Fall|Sleep|Dance">
						<Condition>
							<IsAction>WALK</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Walk">
						<Condition>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Walk|Idle">
						<Condition>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
					<Transition to="Sleep" from="Idle|Dance">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Idle|Sleep">
						<Condition>
							<IsAction>DANCE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action1">
				<States>
					<State name="None"/>
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<!-- <Sprite name="s_ballons" fileName="game/player_cosmetics3.rttex" textureSize="32" frame="23,13"/>
		<Sprite name="s_ballons_pop" fileName="game/particles_large12.rttex" textureSize="64"/>
		
		<Animations>
			<SpriteAnimation name="a_ballons_pop" sprite="s_ballons_pop" animTime="600">
				<Frame>0,13</Frame>
				<Frame>1,13</Frame>
				<Frame>2,13</Frame>
				<Frame>3,13</Frame>
				<Frame>4,13</Frame>
				<Frame>5,13</Frame>
			</SpriteAnimation>
		</Animations> -->
		
		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
		
		<ParticleSystems>
		</ParticleSystems>
	</Data>

	<RenderRules>
		<!-- <RenderChestItem>
			<SpriteRender name="s_ballons" offset="0,-42" alignment="DOWN_CENTER"/>
		</RenderChestItem> -->
	</RenderRules>
</ItemRenderer><?xml version="1.0" ?>
<ItemRenderer>
    <Data>
        <Sprite name="Sprite6" fileName="game/player_cosmetics4.rttex" textureSize="32,32" frame="29,7" />
        <Sprite name="Sprite12" fileName="game/particles_large17.rttex" textureSize="64,64" frame="0,11" />
        <Animations>
            <SpriteAnimation name="Animation13" sprite="Sprite12" isLoop="true" autoPlay="false" playOnState="Punch.No" animTime="1000">
                <Frame>0,11</Frame>
                <Frame>1,11</Frame>
                <Frame>2,11</Frame>
                <Frame>3,11</Frame>
                <Frame>4,11</Frame>
                <Frame>5,11</Frame>
                <Frame>6,11</Frame>
                <Frame>7,11</Frame>
                <Frame>8,11</Frame>
                <Frame>9,11</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="Animation22" sprite="Sprite12" isLoop="true" autoPlay="false" playOnState="Punch.Yes" animTime="250">
                <Frame>10,11</Frame>
                <Frame>11,11</Frame>
                <Frame>12,11</Frame>
                <Frame>13,11</Frame>
                <Frame>14,11</Frame>
            </SpriteAnimation>
			<InterpolationVec4Animation name="idleProxy" variableName="belt_rotation" targetValue="0, 0, 0, 1" animTime="600" playOnState="Movement.Idle"/>
			<InterpolationVec4Animation name="fallProxy" variableName="belt_rotation" targetValue="55, 0, 0, 1" animTime="1200" playOnState="Movement.Fall"/>
			<InterpolationVec4Animation name="jumpProxy" variableName="belt_rotation" targetValue="-25, 0, 0, 1" animTime="600" playOnState="Movement.Jump"/>
        </Animations>
        <ParticleSystems />
        <VariableMap>
			<Set name="belt_rotation">0, 0, 0, 1</Set>
		</VariableMap>
        <StateMachines>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
            <StateMachine name="Punch">
                <States>
                    <State name="No" />
                    <State name="Yes" />
                </States>
                <Transitions>
                    <Transition to="No" from="Yes">
                        <Condition>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Yes" from="No">
                        <Condition>
                            <IsAction>PUNCH</IsAction>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
			<StateMachine name="Movement">
				<States>
					<State name="Idle" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Jump">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Fall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
        </StateMachines>
        <RenderOptions>
            <Default>
                <Set name="AdditionalClothingOffset">0</Set>
                <Set name="AllowChangePunchType">false</Set>
                <Set name="CarCastSmokeParticle">true</Set>
                <Set name="ClothingOffsetFromShoes">0</Set>
                <Set name="DefaultPunchSound" />
                <Set name="DefaultRenderMannequinHandItem">true</Set>
                <Set name="DisableDefaultAncestralParticleEffects">false</Set>
                <Set name="DisableWalkAnimation">false</Set>
                <Set name="EnableBobbingOffset">false</Set>
                <Set name="HasDeathParticles">false</Set>
                <Set name="Head.Sprite" />
                <Set name="Head.Sprite.Sit" />
                <Set name="Head.Sprite.Sleep" />
                <Set name="HideAngelOnDeath">false</Set>
                <Set name="HideAvatarOnDeath">false</Set>
                <Set name="HideParticlesOnSleepingInBed">false</Set>
                <Set name="HideParticlesOnTheaterSeat">false</Set>
                <Set name="HideParticlesOnTransform">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">false</Set>
                <Set name="IgnoreDefaultDestroyedTileEffect">false</Set>
                <Set name="IgnoreParticlesInShadowMods">true</Set>
                <Set name="IgnorePunchTypeCheck">true</Set>
                <Set name="IgnorePunchTypeCheckForNormalPunchOnly">false</Set>
                <Set name="IgnorePunchTypeDamagedTileCheck">false</Set>
                <Set name="IncludeAllActions">false</Set>
                <Set name="IsBed">false</Set>
                <Set name="IsCar">false</Set>
                <Set name="IsFacingChangeDisabled">false</Set>
                <Set name="IsHorse">false</Set>
                <Set name="IsNightVision">false</Set>
                <Set name="IsPetWithLight">false</Set>
                <Set name="IsPulseShoes">false</Set>
                <Set name="IsRidingBird">false</Set>
                <Set name="IsRv">false</Set>
                <Set name="IsSkateboard">false</Set>
                <Set name="IsSurfboard">false</Set>
                <Set name="IsToRenderPants">true</Set>
                <Set name="IsToRenderParticlesWhenShrunken">false</Set>
                <Set name="IsVehicle">false</Set>
                <Set name="JumpEndStateRange">0</Set>
                <Set name="NeedRenderBareFeetWithShoesItem">false</Set>
                <Set name="NeedRenderPet">false</Set>
                <Set name="PetOffsetDuplication">32,0</Set>
                <Set name="PlayDefaultPunchAudio">true</Set>
                <Set name="PunchSoundOverride" />
                <Set name="RenderBackArmAfterItem">false</Set>
                <Set name="RenderBackArmBuild">true</Set>
                <Set name="RenderBackArmInTheFront">false</Set>
                <Set name="RenderBackArmInfected">false</Set>
                <Set name="RenderFrontArmInTheFront">false</Set>
                <Set name="RenderFrontArmInfected">false</Set>
                <Set name="RenderShoesWithMermaidTail">true</Set>
                <Set name="RenderWhenZombie">true</Set>
                <Set name="ShoesHidesBodyLegs">false</Set>
                <Set name="ShoesShouldIgnoreRaptorLegsOffset">false</Set>
                <Set name="ShouldHover">false</Set>
                <Set name="SleepHidesPlayer">false</Set>
                <Set name="UseActionsWithStates">false</Set>
                <Set name="UsePetForceFaceTime">true</Set>
                <Set name="UseRecoilAnim">false</Set>
                <Set name="UserNameOffset">0</Set>
            </Default>
        </RenderOptions>
    </Data>
    <RenderRules>
        <RenderChestItem>
            <SpriteRender name="Sprite6" blend="NORMAL" alignment="DOWN_CENTER" drawShadow="true" />
        </RenderChestItem>
        <RenderChestBackItem>
			<Translate>-4,-10,0</Translate>
			<Rotate>belt_rotation</Rotate>
			<Group onState="Facing.Right">
                <SpriteRender name="Sprite12" blend="NORMAL" alignment="RIGHT_CENTER" drawShadow="true" />
			</Group>
			<Group onState="Facing.Left">
				<SpriteRender name="Sprite12" blend="NORMAL" alignment="LEFT_CENTER" drawShadow="true" />
			</Group>
        </RenderChestBackItem>
    </RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="jnaut_idle" fileName="game/therock_motion.rttex" textureSize="360"/>
		<Sprite name="jnaut_punch" fileName="game/therock_motion.rttex" textureSize="360"/>
		<Sprite name="jnaut_walk" fileName="game/therock_motion.rttex" textureSize="360"/>
		<Sprite name="jnaut_jump" fileName="game/therock_motion.rttex" textureSize="360"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
				<State name="Respawn"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>			
			<SpriteAnimation name="jnaut_Idle_Animation" playOnState="Motion.Idle" sprite="jnaut_idle" animTime="530" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>3,0</Frame>
				<Frame>2,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="jnaut_Idle_Animation" playOnState="Motion.Punch" sprite="jnaut_punch" animTime="450" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>1,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="jnaut_Jump_Animation" playOnState="Motion.Jump" sprite="jnaut_jump" animTime="300">
				<Frame>0,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="jnaut_Fall_Animation" playOnState="Motion.Fall" sprite="jnaut_jump" animTime="300">
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="jnaut_Walk_Animation" playOnState="Motion.Move" sprite="jnaut_walk" animTime="300" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">30</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="jnaut_idle" offset="0,-10048" drawShadow="true" onState="Motion.Idle" scale="0.8,0.8"/>
			<SpriteRender name="jnaut_punch" offset="0,-10048" drawShadow="true" onState="Motion.Punch" scale="0.8,0.8"/>
			<SpriteRender name="jnaut_walk" offset="10,-10048" drawShadow="true" onState="Motion.Move" scale="0.8,0.8"/>
			<SpriteRender name="jnaut_jump" offset="4,-10048" drawShadow="true" onState="Motion.Jump" scale="0.8,0.8"/>
            <SpriteRender name="jnaut_jump" offset="0,-10048" drawShadow="true" onState="Motion.Fall" scale="0.8,0.8"/>
			
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
	</RenderRules>
</ItemRenderer><?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="Sprite26_front" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="11,3" />
		<Sprite name="Sprite26_front_electric" fileName="game/particles12.rttex" textureSize="32" frame="17,9" />
		<Sprite name="Sprite26_back" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="13,3" />
		<Sprite name="Sprite26_GLOW_front" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="12,3" />
		<Sprite name="s_muzzle" fileName="game/particles12.rttex" textureSize="32" frame="12,9" />
		<Sprite name="s_punch" fileName="game/particles_large16.rttex" textureSize="64" frame="8,10" />
		<Sprite name="s_punch_back" fileName="game/particles_large16.rttex" textureSize="64" frame="9,10" />
		<Sprite name="s_punch_ghost" fileName="game/particles_large16.rttex" textureSize="64" frame="10,10" />
		<Sprite name="s_hitFlash" fileName="game/particles12.rttex" textureSize="32" frame="24,9" />
		<Animations>
			<SpriteCurveAnimation name="Sprite26_GLOWAnim" isLoop="true" sprite="Sprite26_GLOW_front" animTime="2000" autoPlay="true">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f</KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteAnimation name="a_hitFlash" sprite="s_hitFlash" animTime="400" autoPlay="true">
				<Frame>24,9</Frame>
				<Frame>25,9</Frame>
				<Frame>26,9</Frame>
				<Frame>27,9</Frame>
			</SpriteAnimation>			
			
			<SpriteAnimation name="a_Sprite26_front_electric" sprite="Sprite26_front_electric" isLoop="false" animTime="700" autoPlay="true">
				<Frame>17,9</Frame>
				<Frame>18,9</Frame>
				<Frame>19,9</Frame>
				<Frame>20,9</Frame>
				<Frame>21,9</Frame>
				<Frame>22,9</Frame>
				<Frame>23,9</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ElectricParticle" updateStage="RenderHandItem" updateState="Action.None">
				<Emitter attachment="handspotRoot">
					<Set name="offset">0, 0</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">Sprite26_front_electric</Set>
					<Random name="offset" min="-4, 0" max="4, 5" />
					<Random name="initialAngle" min="0" max="360" />
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="lifeTime">0.71</Set>
					<Set name="initialScale">0.75,0.75</Set>
				</Particle>
			</ParticleSystem>
