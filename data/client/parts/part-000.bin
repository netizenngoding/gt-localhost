		<Sprite name="vowIniitu" fileName="game/UGCSpritesheet99v2.rttex" textureSize="256"/>
		<Sprite name="vowituIni" fileName="game/UGCSpritesheet99v2.rttex" textureSize="256"/>
		<Sprite name="duar" fileName="game/UGCSpritesheet99v2.rttex" textureSize="256"/>
