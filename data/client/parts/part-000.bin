      <ParticleSystemOff name="UCJUESTUDIO_18"/>
      <ParticleSystemOff name="UCJUESTUDIO_19"/>
      <ParticleSystemOff name="UCJUESTUDIO_20"/>
    </SwitchOffClothingParticles>

  </RenderRules>
</ItemRenderer>
<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Move|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Idle|Punch">
						<Condition type="and">
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Sprite name="UCJUESTUDIO_0" fileName="game/UGCSpritesheet112v0.rttex" textureSize="64" frame="1,0" />
		<Sprite name="UCJUESTUDIO_1" fileName="game/UGCSpritesheet112v0.rttex" textureSize="64" frame="0,0" />
		<Sprite name="UCJUESTUDIO_2" fileName="game/UGCSpritesheet112v0.rttex" textureSize="64" frame="1,1" />
		<Sprite name="UCJUESTUDIO_3" fileName="game/UGCSpritesheet112v0.rttex" textureSize="64" frame="0,1" />
		<Sprite name="UCJUESTUDIO_4" fileName="game/UGCSpritesheet112v0.rttex" textureSize="64" frame="0,2" />
		<Sprite name="UCJUESTUDIO_5" fileName="game/UGCSpritesheet112v1.rttex" textureSize="32" frame="3,0" />
		<Sprite name="UCJUESTUDIO_6" fileName="game/particles10.rttex" textureSize="32,32" frame="12,20" />
		<Sprite name="UCJUESTUDIO_18" fileName="game/UGCSpritesheet112v0.rttex" textureSize="64" frame="1,2" />
		<Sprite name="UCJUESTUDIO_21" fileName="game/UGCSpritesheet112v1.rttex" textureSize="32" frame="0,0" />
		<Animations>
			<SpriteAnimation name="UCJUESTUDIO_8" sprite="UCJUESTUDIO_2" animTime="1000" isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>1,1</Frame>
				<Frame>3,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="UCJUESTUDIO_9" sprite="UCJUESTUDIO_3" animTime="1000" isLoop="true" playOnAction="PUNCH" autoPlay="true">
				<Frame>0,1</Frame>
				<Frame>2,1</Frame>
				<Frame>4,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="UCJUESTUDIO_10" sprite="UCJUESTUDIO_0" animTime="1000" isLoop="true" playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>1,0</Frame>
				<Frame>3,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="UCJUESTUDIO_11" sprite="UCJUESTUDIO_1" animTime="1000" isLoop="true" playOnAction="IDLE|WALK|JUMP|JUMPSTART|FALL" autoPlay="true">
				<Frame>0,0</Frame>
				<Frame>2,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="UCJUESTUDIO_19" sprite="UCJUESTUDIO_18" animTime="1200">
				<Frame>8,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>
		</Animations>
		<TileStampData>
			<Set name="FileName">game/particles10.rttex</Set>
			<Set name="EndFrame">5,22</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
		<ParticleSystems>
			<ParticleSystem name="UCJUESTUDIO_13" updateStage="RenderPet" updateState="Motion.Punch">
				<Emitter usePlayerFacing="true">
					<Random name="emissionInterval" min="0.002" max="0.004" />
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
					<Set name="offset">0, -37.5</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UCJUESTUDIO_5</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="initialScale">2,2</Set>
					<Set name="finalScale">4,4</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Random name="targetPosOffset" min="-4, -50" max="4, 50" />
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1" />
					<Set name="rotateWithVelocity">true</Set>
					<OnFinish>
						<ParticleSystemName>UCJUESTUDIO_14</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="UCJUESTUDIO_14">
				<Emitter>
					<Set name="emissionInterval">0.01</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="delay">-0.25</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UCJUESTUDIO_5</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="offset" min="-16, -16" max="16, 16" />
					<Set name="initialAngle">360</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.5, 1.5</KeyFrame>
						<KeyFrame>1, 0.1, 0.1</KeyFrame>
					</Curve>
					<Set name="rotateWithVelocity">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,80" />
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="UCJUESTUDIO_15" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">1.5</Set>
					<Set name="particlesPerEmission">16</Set>
					<Set name="delayTimer">0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">UCJUESTUDIO_6</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1.25</Set>
					<Set name="initialRGB">1,1,1</Set>
					<Set name="initialScale">0,2.25</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.0, 1.0</KeyFrame>
						<KeyFrame>1, 1.6, 1.6</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="65,90" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="UCJUESTUDIO_16" updateStage="OnDestroyedTile" secondary="UCJUESTUDIO_17">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">UCJUESTUDIO_6</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">2,2</Set>
					<Random name="finalScale" min="0.1, 0.1" max="0.4, 0.4" />
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200" />
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300" />
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="UCJUESTUDIO_17">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">20</Set>
					<Set name="emissionInterval">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UCJUESTUDIO_6</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="initialRotationRate">150</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 0</KeyFrame>
						<KeyFrame>0.4, 1, 1</KeyFrame>
						<KeyFrame>0.8, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0, 0</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.75</KeyFrame>
						<KeyFrame>0.8, 0.6</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialVelocity">0,0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="UCJUESTUDIO_20" updateStage="OnKilled" renderStage="RenderBehind">
				<Emitter>
					<Set name="lifeTime">1.3</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="useCharacterPos">true</Set>
					<Set name="offset">0,-24</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UCJUESTUDIO_18</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">1.5, 1.5</Set>
					<Set name="lifeTime">1.2</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="UCJUESTUDIO_22" updateStage="RenderPet">
				<Emitter>
					<Set name="useCharacterPos">true</Set>
					<Set name="offset">0, -24</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<OrbitOffset>
						<Set name="hasOrbit">true</Set>
						<Set name="hOrbitPeriod">5000</Set>
						<Set name="hAmplitude">18</Set>
						<Set name="hTimeOffset">0</Set>
						<Set name="vOrbitPeriod">5000</Set>
						<Set name="vAmplitude">10</Set>
						<Set name="vTimeOffset">0</Set>
						<Set name="minScale">0.4</Set>
						<Set name="maxScale">0.2</Set>
					</OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">UCJUESTUDIO_21</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialRotationRate">
						<KeyFrame>0, 15</KeyFrame>
						<KeyFrame>1, 5</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="0" max="360" />
					<Random name="finalAngle" min="0" max="360" />
					<Set name="interpolateAngle">true</Set>
					<Set name="initialScale">1.2, 1.2</Set>
					<Random name="finalScale" min="0.1" max="0.3" />
					<Set name="interpolateScale">true</Set>
					<Random name="offset" min="-16, -24" max="16, 24" />
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="UCJUESTUDIO_23" updateStage="RenderPet">
				<Emitter>
					<Set name="useCharacterPos">true</Set>
					<Set name="offset">0, -24</Set>
					<Set name="emissionInterval">0.1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<OrbitOffset>
						<Set name="hasOrbit">true</Set>
						<Set name="hOrbitPeriod">5000</Set>
						<Set name="hAmplitude">18</Set>
						<Set name="hTimeOffset">2500</Set>
						<Set name="vOrbitPeriod">5000</Set>
						<Set name="vAmplitude">10</Set>
						<Set name="vTimeOffset">2500</Set>
						<Set name="minScale">0.4</Set>
						<Set name="maxScale">0.2</Set>
					</OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">UCJUESTUDIO_21</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialRotationRate">
						<KeyFrame>0, 15</KeyFrame>
						<KeyFrame>1, 5</KeyFrame>
					</Curve>
					<Random name="initialAngle" min="0" max="360" />
					<Random name="finalAngle" min="0" max="360" />
					<Set name="interpolateAngle">true</Set>
					<Set name="initialScale">1.2, 1.2</Set>
					<Random name="finalScale" min="0.1" max="0.3" />
					<Set name="interpolateScale">true</Set>
					<Random name="offset" min="-16, -24" max="16, 24" />
					<Set name="lifeTime">1</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="UCJUESTUDIO_24" updateStage="RenderPet" updateState="Motion.Move">
				<Emitter>
					<Set name="useCharacterPos">true</Set>
					<Set name="offset">0, -24</Set>
					<Set name="emissionInterval">0.06</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.25</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">UCJUESTUDIO_21</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.6, 0.6</Set>
					<Random name="finalScale" min="0.1" max="0.2" />
					<Random name="initialAngle" min="0" max="360" />
					<Random name="initialRotationRate" min="-90" max="90" />
					<Random name="offset" min="-10, -18" max="10, 18" />
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="4,14" />
					<Set name="lifeTime">0.9</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="projectile_offset">0, 0</Set>
			<Set name="projectile_angle">0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">true</Set>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderBackArmInfected">true</Set>
				<Set name="RenderBackArmBuild">true</Set>
				<Set name="DefaultPunchSound">audio/droar.wav</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<SpriteRender name="UCJUESTUDIO_4" rotateOffset="true" offset="14,36" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" />
		</RenderHandItem>
		<Update>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1700</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<RenderPet>
			<SpriteRender name="UCJUESTUDIO_2" alignment="DOWN_CENTER" onAction="PUNCH" offset="0,10" scale="1.5, 1.5" />
			<SpriteRender name="UCJUESTUDIO_3" alignment="DOWN_CENTER" onAction="PUNCH" offset="-95.25,10" scale="1.5, 1.5" />
			<SpriteRender name="UCJUESTUDIO_0" alignment="DOWN_CENTER" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="0,10" scale="1.5, 1.5" />
			<SpriteRender name="UCJUESTUDIO_1" alignment="DOWN_CENTER" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL" offset="-95.25,10" scale="1.5, 1.5" />
		</RenderPet>
	</RenderRules>
</ItemRenderer>
<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="kurama_idle" fileName="game/UGCSpritesheet12v0.rttex" textureSize="400,300"/>
		<Sprite name="kurama_punch" fileName="game/UGCSpritesheet12v0.rttex" textureSize="400,300"/>
		<Sprite name="kurama_walk" fileName="game/UGCSpritesheet12v0.rttex" textureSize="400,300"/>
		<Sprite name="kurama_jump" fileName="game/UGCSpritesheet12v0.rttex" textureSize="400,300"/>
		<Sprite name="kurama_fall" fileName="game/UGCSpritesheet12v0.rttex" textureSize="400,300"/>
		<StateMachines>
		<StateMachine name="Motion">
			<States>
				<State name="Idle" />
				<State name="Move" />
				<State name="Jump" />
				<State name="Fall" />
				<State name="Punch"/>
			</States>
			<Transitions>
				<Transition to="Idle" from="Fall|Move|Jump|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						<IsVariableBool name="isAttacking">false</IsVariableBool>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Move" from="Jump|Fall|Idle|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">true</IsVariableBool>
						<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Jump" from="Idle|Move|Fall|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Fall" from="Jump|Idle|Move|Punch" >
					<Condition type="and">
						<IsVariableBool name="onGround">false</IsVariableBool>
						<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						<IsAction operatorType="NotEqual">PUNCH</IsAction>
					</Condition>
				</Transition>
				<Transition to="Punch" from="Idle|Move|Jump|Fall">
					<Condition type="and">
						<IsAction>PUNCH</IsAction>
					</Condition>
				</Transition>
			</Transitions>
		</StateMachine>
		</StateMachines>
		<Animations>			
			<SpriteAnimation name="kurama_Idle_Animation" playOnState="Motion.Idle" sprite="kurama_idle" animTime="1200" isLoop="true">
				<Frame>3,1</Frame> <Frame>4,1</Frame> <Frame>0,4</Frame> <Frame>1,4</Frame> <Frame>2,4</Frame> <Frame>0,2</Frame> <Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kurama_Punch_Animation" playOnState="Motion.Punch" sprite="kurama_punch" animTime="350" isLoop="true">
				<Frame>0,2</Frame> <Frame>1,2</Frame> <Frame>2,2</Frame> <Frame>3,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kurama_Jump_Animation" playOnState="Motion.Jump" sprite="kurama_jump" animTime="400" isLoop="true">
				<Frame>1,3</Frame> <Frame>2,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kurama_Fall_Animation" playOnState="Motion.Fall" sprite="kurama_fall" animTime="400" isLoop="true">
				<Frame>0,1</Frame> <Frame>1,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kurama_Walk_Animation" playOnState="Motion.Move" sprite="kurama_walk" animTime="400" isLoop="true">
				<Frame>0,0</Frame> <Frame>1,0</Frame> <Frame>2,0</Frame> <Frame>3,0</Frame> <Frame>4,0</Frame> <Frame>0,3</Frame> <Frame>1,3</Frame> <Frame>2,3</Frame> <Frame>0,1</Frame> <Frame>1,1</Frame> <Frame>2,1</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">50</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="kurama_idle" offset="0,-10070" drawShadow="true" onState="Motion.Idle" scale="0.8,0.8"/>
			<SpriteRender name="kurama_punch" offset="0,-10070" drawShadow="true" onState="Motion.Punch" scale="0.8,0.8"/>
			<SpriteRender name="kurama_walk" offset="0,-10070" drawShadow="true" onState="Motion.Move" scale="0.8,0.8"/>
			<SpriteRender name="kurama_jump" offset="0,-10070" drawShadow="true" onState="Motion.Jump" scale="0.8,0.8"/>
            <SpriteRender name="kurama_fall" offset="0,-10070" drawShadow="true" onState="Motion.Fall" scale="0.8,0.8"/>
			
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
	</RenderRules>
</ItemRenderer><?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="gogeta_sprite" fileName="game/UGCSpritesheet13v0.rttex" textureSize="128"/>
		<Sprite name="gogeta_sprite_2" fileName="game/UGCSpritesheet13v1.rttex" textureSize="128"/>
		<Sprite name="gogeta_sprite_3" fileName="game/UGCSpritesheet13v2.rttex" textureSize="256"/>
		<Sprite name="gogeta_respawn" fileName="game/UGCSpritesheet13v0.rttex" textureSize="128"/>

		<Sprite name="gogeta_bubble_ssj" fileName="game/UGCSpritesheet13v3.rttex" textureSize="64" frame="1,0"/>
		<Sprite name="gogeta_tilehit_ssj" fileName="game/UGCSpritesheet13v3.rttex" textureSize="64"/>
		<Sprite name="gogeta_bubble_ssjb" fileName="game/UGCSpritesheet13v3.rttex" textureSize="64" frame="0,0"/>
		<Sprite name="gogeta_tilehit_ssjb" fileName="game/UGCSpritesheet13v2.rttex" textureSize="256"/>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="TransformGate"/>
					<State name="Transform"/>
					<State name="Idle"/>
					<State name="IdleLoop"/>
					<State name="MoveRight"/>
					<State name="MoveLeft"/>
					<State name="Jump"/>
					<State name="Fall"/>
					<State name="Punch"/>
					<State name="Sleep"/>
					<State name="SleepLoop"/>
					<State name="Dance"/>
					<State name="Respawn"/>
					<State name="PostRespawn"/>
					<State name="SSJTransform"/>
					<State name="SSJIdleGate"/>
					<State name="SSJIdleIntro"/>
					<State name="SSJIdleLoop"/>
					<State name="SSJSleep"/>
					<State name="SSJSleepLoop"/>
					<State name="SSJMoveRight"/>
					<State name="SSJMoveLeft"/>
					<State name="SSJJump"/>
					<State name="SSJFall"/>
					<State name="SSJPunch"/>
					<State name="SSJDance"/>
					<State name="SSJBTransform"/>
					<State name="SSJBIdleLoop"/>
					<State name="SSJBPunch"/>
					<State name="SSJBMoveRight"/>
					<State name="SSJBMoveLeft"/>
					<State name="SSJBJump"/>
					<State name="SSJBFall"/>
					<State name="SSJBSleep"/>
					<State name="SSJBSleepLoop"/>
					<State name="SSJBDance"/>
					<State name="SSJBDanceLoop"/>
				</States>

				<Transitions>
					<Transition to="Respawn" from="TransformGate|Transform|Idle|IdleLoop|MoveRight|MoveLeft|Jump|Fall|Punch|Sleep|SleepLoop|Dance|SSJTransform|SSJIdleGate|SSJIdleIntro|SSJIdleLoop|SSJMoveRight|SSJMoveLeft|SSJJump|SSJFall|SSJPunch|SSJSleep|SSJSleepLoop|SSJDance|SSJBTransform|SSJBIdleLoop|SSJBPunch|SSJBMoveRight|SSJBMoveLeft|SSJBJump|SSJBFall|SSJBSleep|SSJBSleepLoop|SSJBDance|SSJBDanceLoop">
						<Condition>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>

					<Transition to="Transform" from="TransformGate">
						<Condition>
							<IsAnimationFinished>gogeta_TransformGate_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="Idle" from="Transform">
						<Condition>
							<IsAnimationFinished>gogeta_Transform_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="IdleLoop" from="Idle">
						<Condition>
							<IsAnimationFinished>gogeta_Idle_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="SleepLoop" from="Sleep">
						<Condition>
							<IsAnimationFinished>gogeta_Sleep_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="SSJTransform" from="Idle|IdleLoop|MoveRight|MoveLeft|Jump|Fall|Punch|Sleep|SleepLoop">
						<Condition>
							<IsAction>FURIOUS</IsAction>
						</Condition>
					</Transition>

					<Transition to="Punch" from="Idle|IdleLoop|MoveRight|MoveLeft|Jump|Fall|Sleep|SleepLoop">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>

					<Transition to="Sleep" from="Idle|IdleLoop|MoveRight|MoveLeft|Jump|Fall|Punch">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>

					<Transition to="Dance" from="Idle|IdleLoop|MoveRight|MoveLeft|Jump|Fall|Punch|Sleep|SleepLoop">
						<Condition>
							<IsAction>DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="Idle" from="Dance">
						<Condition>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="Jump" from="Idle|IdleLoop|MoveRight|MoveLeft|Fall|Punch|Sleep|SleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="Fall" from="Idle|IdleLoop|MoveRight|MoveLeft|Jump|Punch|Sleep|SleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="MoveRight" from="Idle|IdleLoop|Jump|Fall|Punch|Sleep|SleepLoop|MoveLeft">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsFacingLeft>false</IsFacingLeft>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="MoveLeft" from="Idle|IdleLoop|Jump|Fall|Punch|Sleep|SleepLoop|MoveRight">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsFacingLeft>true</IsFacingLeft>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="Idle" from="MoveRight|MoveLeft|Jump|Fall|Punch|Sleep|SleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="PostRespawn" from="Respawn">
						<Condition>
							<IsAnimationFinished>gogeta_Respawn_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="TransformGate" from="PostRespawn">
						<Condition>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJIdleGate" from="SSJTransform">
						<Condition>
							<IsAnimationFinished>gogeta_SSJTransform_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="SSJIdleIntro" from="SSJIdleGate">
						<Condition>
							<IsAnimationFinished>gogeta_SSJIdleGate_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="SSJIdleLoop" from="SSJIdleIntro">
						<Condition>
							<IsAnimationFinished>gogeta_SSJIdleIntro_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="SSJSleep" from="SSJIdleGate|SSJIdleIntro|SSJIdleLoop">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJSleepLoop" from="SSJSleep">
						<Condition>
							<IsAnimationFinished>gogeta_SSJSleep_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="SSJIdleLoop" from="SSJSleep|SSJSleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJDance" from="SSJIdleGate|SSJIdleIntro|SSJIdleLoop|SSJMoveRight|SSJMoveLeft|SSJJump|SSJFall|SSJPunch|SSJSleep|SSJSleepLoop">
						<Condition>
							<IsAction>DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJIdleLoop" from="SSJDance">
						<Condition>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJJump" from="SSJIdleGate|SSJIdleIntro|SSJIdleLoop|SSJMoveRight|SSJMoveLeft|SSJFall|SSJPunch|SSJSleep|SSJSleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJFall" from="SSJIdleGate|SSJIdleIntro|SSJIdleLoop|SSJMoveRight|SSJMoveLeft|SSJJump|SSJPunch|SSJSleep|SSJSleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJMoveRight" from="SSJIdleGate|SSJIdleIntro|SSJIdleLoop|SSJJump|SSJFall|SSJPunch|SSJSleep|SSJSleepLoop|SSJMoveLeft">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsFacingLeft>false</IsFacingLeft>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJMoveLeft" from="SSJIdleGate|SSJIdleIntro|SSJIdleLoop|SSJJump|SSJFall|SSJPunch|SSJSleep|SSJSleepLoop|SSJMoveRight">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsFacingLeft>true</IsFacingLeft>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJIdleLoop" from="SSJMoveRight|SSJMoveLeft|SSJJump|SSJFall|SSJPunch|SSJSleep|SSJSleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJPunch" from="SSJIdleGate|SSJIdleIntro|SSJIdleLoop|SSJMoveRight|SSJMoveLeft|SSJJump|SSJFall|SSJSleep|SSJSleepLoop">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBTransform" from="SSJIdleGate|SSJIdleIntro|SSJIdleLoop">
						<Condition>
							<IsAction>FURIOUS</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBIdleLoop" from="SSJBTransform">
						<Condition>
							<IsAnimationFinished>gogeta_SSJBTransform_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="SSJBPunch" from="SSJBIdleLoop|SSJBMoveRight|SSJBMoveLeft|SSJBJump|SSJBFall|SSJBSleep|SSJBSleepLoop">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBSleep" from="SSJBIdleLoop|SSJBMoveRight|SSJBMoveLeft|SSJBJump|SSJBFall|SSJBPunch">
						<Condition>
							<IsAction>SLEEP</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBSleepLoop" from="SSJBSleep">
						<Condition>
							<IsAnimationFinished>gogeta_SSJBSleep_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="SSJBDance" from="SSJBIdleLoop|SSJBMoveRight|SSJBMoveLeft|SSJBJump|SSJBFall|SSJBPunch|SSJBSleep|SSJBSleepLoop">
						<Condition>
							<IsAction>DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBDanceLoop" from="SSJBDance">
						<Condition>
							<IsAnimationFinished>gogeta_SSJBDance_Animation</IsAnimationFinished>
						</Condition>
					</Transition>

					<Transition to="SSJBDance" from="SSJBDanceLoop">
						<Condition type="and">
							<IsAnimationFinished>gogeta_SSJBDanceLoop_Animation</IsAnimationFinished>
							<IsAction>DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBIdleLoop" from="SSJBDanceLoop">
						<Condition type="and">
							<IsAnimationFinished>gogeta_SSJBDanceLoop_Animation</IsAnimationFinished>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBJump" from="SSJBIdleLoop|SSJBMoveRight|SSJBMoveLeft|SSJBFall|SSJBPunch|SSJBSleep|SSJBSleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBFall" from="SSJBIdleLoop|SSJBMoveRight|SSJBMoveLeft|SSJBJump|SSJBPunch|SSJBSleep|SSJBSleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBMoveRight" from="SSJBIdleLoop|SSJBJump|SSJBFall|SSJBPunch|SSJBSleep|SSJBSleepLoop|SSJBMoveLeft">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsFacingLeft>false</IsFacingLeft>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBMoveLeft" from="SSJBIdleLoop|SSJBJump|SSJBFall|SSJBPunch|SSJBSleep|SSJBSleepLoop|SSJBMoveRight">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsFacingLeft>true</IsFacingLeft>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>

					<Transition to="SSJBIdleLoop" from="SSJBMoveRight|SSJBMoveLeft|SSJBJump|SSJBFall|SSJBPunch|SSJBSleep|SSJBSleepLoop">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAction operatorType="NotEqual">FURIOUS</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

			<StateMachine name="Facing">
				<States>
					<State name="Right"/>
					<State name="Left"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition><IsFacingLeft>true</IsFacingLeft></Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition><IsFacingLeft>false</IsFacingLeft></Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

